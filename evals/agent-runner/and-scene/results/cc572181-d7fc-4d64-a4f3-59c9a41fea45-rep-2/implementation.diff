+      {presentations.length === 0 ? <p data-presentation-empty="">No presentations yet.</p> : <ul>
+        {presentations.map(({ slug, title }) => <li key={slug}><a href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${slug}`} data-presentation-link="">{title}</a></li>)}
+      </ul>}
+    </section>
