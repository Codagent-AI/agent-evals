+    <button type="button" className="presentation-mode-toggle" data-presentation-mode-toggle="" onClick={onToggleMode} aria-label={`Switch to ${mode === 'browse' ? 'present' : 'browse'} mode`}>{mode === 'browse' ? 'Present' : 'Browse'}</button>
