+import type { StepMeta } from '../types'
+export function Footer({ steps, index, mode, onJump, onNext, onPrev, attribution }: { steps: readonly StepMeta[]; index: number; mode: 'browse'|'present'; onJump: (index:number)=>void; onNext:()=>void; onPrev:()=>void; attribution?: false|string }) {
+ return <footer data-presentation-footer data-step-count={steps.length} data-step-index={index} style={{ position: 'absolute', inset: 'auto 0 0', zIndex: 2 }}>{mode === 'browse' ? <><h2 data-presentation-step-title>{steps[index]?.title}</h2><p data-presentation-caption>{steps[index]?.caption}</p><div data-presentation-progress>{steps.map((step, i) => <button key={step.id} type="button" data-presentation-progress-indicator data-presentation-step-index={i} data-active={i === index ? 'true':'false'} aria-current={i === index ? 'step':undefined} aria-label={`Go to step ${i+1}`} onClick={() => onJump(i)} />)}</div><button data-presentation-prev type="button" onClick={onPrev}>Previous</button><button data-presentation-next type="button" onClick={onNext}>Next</button></> : <p data-presentation-title>{steps[index]?.title}</p>}{attribution !== false && <a data-presentation-attribution href={typeof attribution === 'string' ? attribution : 'https://github.com/and-scene/and-scene'} style={{ position: 'absolute', right: 0, bottom: 0 }}>made by and-scene</a>}</footer>
+}
