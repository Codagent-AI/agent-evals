+[data-presentation-prev], [data-presentation-next], [data-presentation-mode-toggle] { border: 1px solid #c8d3cc; border-radius: 999px; color: var(--ink); background: #fffdf2; font: 700 11px Inter, ui-sans-serif, system-ui, sans-serif; padding: 8px 14px; cursor: pointer; }
