diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4e061b8d020ca48d2b892539de160109c74e221e
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,16 @@
+import { Stage } from './Stage'
+import { Header } from './chrome/Header'
+import { Footer } from './chrome/Footer'
+import { usePresentationNav } from './usePresentationNav'
+import type { Attribution, PresentationMode, Step } from './types'
+
+const DEFAULT_ATTRIBUTION: Attribution = { href: 'https://github.com/and-scene/and-scene', label: 'made by and-scene' }
+export function Presentation<T>({ steps, title, initialMode = 'browse', attribution = DEFAULT_ATTRIBUTION, brand }: { steps: readonly Step<T>[]; title: string; initialMode?: PresentationMode; attribution?: Attribution | false; brand?: React.ReactNode }) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  return <main data-presentation-chrome data-step-count={steps.length} data-step-index={nav.index} data-presentation-mode={nav.mode} style={{ position: 'fixed', inset: 0, overflow: 'hidden' }} onTouchStart={nav.touchStart} onTouchEnd={nav.touchEnd}>
+    <Header title={title} stepTitle={steps[nav.index]?.title} mode={nav.mode} index={nav.index} total={steps.length} brand={brand} />
+    <Stage steps={steps} index={nav.index} mode={nav.mode} />
+    <Footer steps={steps} index={nav.index} mode={nav.mode} goTo={nav.goTo} next={nav.next} prev={nav.prev} attribution={attribution} />
+    <button type="button" data-presentation-mode-toggle aria-label="Toggle presentation mode" onClick={nav.toggleMode}>{nav.mode === 'browse' ? 'Present' : 'Browse'}</button>
+  </main>
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c5f6b93f0b7cf9f3f399db5041ffbdcb2abf0725
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,26 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { useFitScale } from './useFitScale'
+import { DESIGN_H, DESIGN_W, ENTER_DELAY, ENTER_T, STAGE_LAYOUT } from './constants'
+import { sceneTransitionKey } from './navigation'
+import type { PresentationMode, Step } from './types'
+
+export function Stage<T>({ steps, index, mode }: { steps: readonly Step<T>[]; index: number; mode: PresentationMode }) {
+  const { scale, overflowing } = useFitScale(mode)
+  const step = steps[index]
+  if (!step) return null
+  const transitionKey = sceneTransitionKey(steps, index)
+  const SceneComponent = step.Scene
+  const geometry = STAGE_LAYOUT[mode]
+  return <div
+    data-presentation-stage
+    data-presentation-stage-overflowing={overflowing ? 'true' : undefined}
+    aria-label={overflowing ? 'Diagram viewport. Scroll to view the entire diagram.' : 'Diagram viewport'}
+    style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', minWidth: 0, minHeight: 0, display: 'grid', gridTemplateColumns: 'minmax(0, 1fr)', placeItems: overflowing ? 'start' : 'center', overflow: overflowing ? 'auto' : 'hidden', paddingTop: geometry.top, paddingBottom: geometry.bottom, boxSizing: 'border-box' }}
+  >
+    <div style={{ width: DESIGN_W * scale, height: DESIGN_H * scale, position: 'relative', flex: 'none' }}>
+      <LayoutGroup key={mode} id={`presentation-${mode}`}>
+        <div style={{ width: DESIGN_W, height: DESIGN_H, position: 'absolute', left: 0, top: 0, transform: `scale(${scale})`, transformOrigin: 'top left' }}><AnimatePresence mode="sync" initial={false}><motion.div key={transitionKey} data-step-id={step.id} initial={{ opacity: 0 }} animate={{ opacity: 1, transition: { duration: ENTER_T, delay: ENTER_DELAY } }} exit={{ opacity: 0, transition: { duration: ENTER_T } }}><SceneComponent payload={step.payload} step={step} index={index} total={steps.length} /></motion.div></AnimatePresence></div>
+      </LayoutGroup>
+    </div>
+  </div>
+}
