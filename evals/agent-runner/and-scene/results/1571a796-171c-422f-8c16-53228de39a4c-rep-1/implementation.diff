@@ -0,0 +1,22 @@
+import { useEffect, useState } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT } from './constants'
+import type { PresentationMode } from './types'
+
+export function computeFitScaleState(width: number, height: number, mode: PresentationMode, designWidth = DESIGN_W, designHeight = DESIGN_H) {
+  const geometry = STAGE_LAYOUT[mode]
+  const availableScale = Math.min((width - geometry.horizontal * 2) / designWidth, (height - geometry.top - geometry.bottom) / designHeight)
+  return { scale: Math.max(MIN_SCALE, availableScale), overflowing: availableScale < MIN_SCALE }
+}
+export function computeFitScale(width: number, height: number, mode: PresentationMode, designWidth = DESIGN_W, designHeight = DESIGN_H): number {
+  return computeFitScaleState(width, height, mode, designWidth, designHeight).scale
+}
+export function useFitScale(mode: PresentationMode) {
+  const [fit, setFit] = useState(() => typeof window === 'undefined' ? { scale: 1, overflowing: false } : computeFitScaleState(window.innerWidth, window.innerHeight, mode))
+  useEffect(() => {
+    const update = () => setFit(computeFitScaleState(window.innerWidth, window.innerHeight, mode))
+    update()
+    window.addEventListener('resize', update)
+    return () => window.removeEventListener('resize', update)
+  }, [mode])
+  return fit
+}
diff --git a/src/presentation-kit/usePresentationNav.ts b/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ef10656f54989116acef1acbee2789f96d1b4c59
--- /dev/null
+++ b/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,34 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { clampIndex, keyToAction, touchToAction } from './navigation'
+import type { PresentationMode } from './types'
+
+export function usePresentationNav(total: number, initialMode: PresentationMode = 'browse') {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState<PresentationMode>(initialMode)
+  const touchX = useRef<number | null>(null)
+  const goTo = useCallback((next: number) => setIndex(clampIndex(next, total)), [total])
+  const next = useCallback(() => goTo(index + 1), [goTo, index])
+  const prev = useCallback(() => goTo(index - 1), [goTo, index])
+  const toggleMode = useCallback(() => setMode((current) => current === 'browse' ? 'present' : 'browse'), [])
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      const action = keyToAction(event.key, event.target, event)
+      if (!action) return
+      event.preventDefault()
+      if (action === 'next') setIndex((value) => clampIndex(value + 1, total))
+      if (action === 'prev') setIndex((value) => clampIndex(value - 1, total))
+      if (action === 'toggle-mode') toggleMode()
+    }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [total, toggleMode])
+  const touchStart = useCallback((event: React.TouchEvent) => { touchX.current = event.touches[0]?.clientX ?? null }, [])
+  const touchEnd = useCallback((event: React.TouchEvent) => {
+    const start = touchX.current
+    touchX.current = null
+    const action = touchToAction(start, event.changedTouches[0]?.clientX)
+    if (action === 'next') next()
+    if (action === 'prev') prev()
+  }, [next, prev])
+  return { index, mode, setMode, next, prev, goTo, toggleMode, touchStart, touchEnd }
+}
