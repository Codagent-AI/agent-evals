diff --git a/skills/presentation/templates/bootstrap/src/presentations/starter/entities.ts b/skills/presentation/templates/bootstrap/src/presentations/starter/entities.ts
new file mode 100644
index 0000000000000000000000000000000000000000..61949d73976889a3684c684532158c08f070f5a6
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentations/starter/entities.ts
@@ -0,0 +1,21 @@
+/**
+ * Starter presentation — the `layoutId` namespace. Every entity has a stable id and the step (1-based) that
+ * introduces it. Entities persist across steps: add new ones, move or relabel existing ones in
+ * place, and drop one only when a beat truly removes it.
