+    for (const info of [null, { ...good, fontSizePx: 8 }, { ...good, height: 9 }, { ...good, color: 'rgb(0, 0, 238)' }]) {
+      expect(inspect.attributionWarning(info)).toContain('[data-presentation-attribution]')
