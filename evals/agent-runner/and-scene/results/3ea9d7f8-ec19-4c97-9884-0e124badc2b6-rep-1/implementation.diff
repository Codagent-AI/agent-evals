@@ -0,0 +1,51 @@
+import type { CSSProperties, ReactNode } from 'react'
+import { motion } from 'motion/react'
+import { EXIT_TRANSITION, LAYOUT_TRANSITION, enterProps, geometry } from './motion'
+
+/** Props every scene primitive accepts: stable identity, optional geometry, and style hooks. */
+export interface NodeProps {
+  /** Stable entity identity; doubles as the Motion `layoutId`. */
+  id: string
+  /** Canvas coordinates. When `x` or `y` is given the node is absolutely positioned. */
+  x?: number
+  y?: number
+  width?: number
+  height?: number
+  className?: string
+  /** Author-owned style; wins over kit geometry. */
+  style?: CSSProperties
+  children?: ReactNode
+  /** Extra `data-*` hooks for presentation CSS, e.g. `{ 'data-variant': 'ghost' }`. */
+  hooks?: Record<`data-${string}`, string | undefined>
+  /** True only in the step that introduces the entity: it fades in once the morph has settled. */
+  enter?: boolean
+}
+
+/** Shared shell: a Motion element whose `layoutId` makes persisting entities morph in place. */
+export function NodeShell({
+  kind,
+  props,
+  children,
+}: {
+  kind: string
+  props: NodeProps
+  children?: ReactNode
+}) {
+  const { id, className, style, hooks } = props
+  return (
+    <motion.div
+      layout
+      layoutId={id}
+      {...enterProps(props.enter)}
+      transition={{ layout: LAYOUT_TRANSITION }}
+      exit={{ opacity: 0, transition: EXIT_TRANSITION }}
+      className={className}
+      style={{ ...geometry(props), ...style }}
+      data-presentation-node={kind}
+      data-presentation-entity={id}
+      {...hooks}
+    >
+      {children}
+    </motion.div>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/steps.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/steps.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fbbe48caa3d786a7254c4307f80665a10e378382
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/steps.ts
@@ -0,0 +1,30 @@
+import type { AnyStep, Era } from './types'
+
+/** Distinct era labels in order of first appearance, each with its first step index. */
+export function deriveEras(steps: readonly AnyStep[]): Era[] {
+  const eras: Era[] = []
+  steps.forEach((step, firstIndex) => {
+    if (!eras.some((era) => era.label === step.era)) eras.push({ label: step.era, firstIndex })
+  })
+  return eras
+}
+
+/** On-screen step number: derived from position, never stored. */
+export function stepNumber(index: number): string {
+  return String(index + 1).padStart(2, '0')
+}
+
+const sceneIds = new WeakMap<object, number>()
+let nextSceneId = 0
+
+/** Identity of the mounted scene instance: same key means the instance persists. */
+export function sceneKey(step: AnyStep): string {
+  let id = sceneIds.get(step.Scene)
+  if (id === undefined) {
+    id = nextSceneId++
+    sceneIds.set(step.Scene, id)
+  }
+  // Namespaced so a group key can never collide with an ungrouped step's id.
+  const identity = step.groupKey === undefined ? `step:${step.id}` : `group:${step.groupKey}`
+  return `${identity}#${id}`
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/types.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/types.ts
