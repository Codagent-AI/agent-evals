@@ -0,0 +1,15 @@
+import { createElement, Suspense } from 'react'
+import { Landing } from './Landing'
+import type { PresentationEntry } from './presentations'
+import { findEntry, lazyFor } from './routes'
+
+/** `/` and unknown paths show the Landing page; `/<slug>` lazy-loads that presentation. */
+export function Router({ pathname, registry }: { pathname: string; registry: readonly PresentationEntry[] }) {
+  const entry = findEntry(pathname, registry)
+  if (!entry) return <Landing registry={registry} />
+  return (
+    <Suspense fallback={<p data-route-loading="">Loading…</p>}>
+      {createElement(lazyFor(entry))}
+    </Suspense>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/routes.ts b/skills/presentation/templates/bootstrap/src/routes.ts
new file mode 100644
index 0000000000000000000000000000000000000000..25eeaf80e7f39a086ccce2d987508d71d63fb77f
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/routes.ts
@@ -0,0 +1,26 @@
+import { lazy, type ComponentType, type LazyExoticComponent } from 'react'
+import type { PresentationEntry } from './presentations'
+
+/** Registry entry for a pathname; `/` and unknown paths match nothing. */
+export function findEntry(pathname: string, registry: readonly PresentationEntry[]) {
+  let path = pathname
+  try {
+    path = decodeURIComponent(pathname)
+  } catch {
+    // Malformed percent-encoding cannot name a registered slug: treat it as an unknown path.
+  }
+  const slug = path.replace(/^\/+|\/+$/g, '')
+  return slug ? registry.find((entry) => entry.slug === slug) : undefined
+}
+
+const lazyEntries = new WeakMap<PresentationEntry, LazyExoticComponent<ComponentType>>()
+
+/** One lazy component per entry, so re-renders never recreate it. */
+export function lazyFor(entry: PresentationEntry) {
+  let component = lazyEntries.get(entry)
+  if (!component) {
+    component = lazy(entry.load)
+    lazyEntries.set(entry, component)
+  }
+  return component
+}
