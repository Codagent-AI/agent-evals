diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0625841b4c32f81dc2919ec15a8636e5fbb93483
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,62 @@
+import type { ReactNode } from 'react'
+import { Attribution, type AttributionOptions } from './chrome/Attribution'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { WIDE_BREAKPOINT, type Mode } from './constants'
+import { Stage } from './Stage'
+import { deriveEras } from './steps'
+import type { AnyStep } from './types'
+import { useViewport } from './useFitScale'
+import { usePresentationNav } from './usePresentationNav'
+
+export interface PresentationProps {
+  steps: readonly AnyStep[]
+  title: string
+  initialMode?: Mode
+  /** Host-provided top-left branding; none by default. */
+  brand?: ReactNode
+  /** Override the default bottom-right attribution, or pass `false` to omit it. */
+  attribution?: AttributionOptions | false
+  className?: string
+}
+
+/** One scene moving through named steps, with present/browse chrome and navigation. */
+export function Presentation({
+  steps,
+  title,
+  initialMode = 'browse',
+  brand,
+  attribution,
+  className,
+}: PresentationProps) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const { width } = useViewport()
+  const step = steps[nav.index]
+  const browse = nav.mode === 'browse'
+  return (
+    <div
+      className={className}
+      data-presentation-root=""
+      data-presentation-title-text={title}
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      style={{ height: '100vh', display: 'flex', flexDirection: 'column', overflow: 'hidden' }}
+    >
+      <Header step={step} index={nav.index} mode={nav.mode} brand={brand} onToggleMode={nav.toggleMode} />
+      <Stage step={step} mode={nav.mode} />
+      {browse && (
+        <Footer
+          steps={steps}
+          index={nav.index}
+          eras={deriveEras(steps)}
+          showToc={width >= WIDE_BREAKPOINT}
+          onPrev={nav.prev}
+          onNext={nav.next}
+          onJump={nav.goTo}
+        />
+      )}
+      {attribution !== false && <Attribution {...attribution} />}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..6a5c03de0d5205d9533248086242ddcbe9fb510d
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,58 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, EASE, EXIT_T, type Mode } from './constants'
+import { sceneKey } from './steps'
+import type { AnyStep } from './types'
+import { useFitScale } from './useFitScale'
+
+/**
+ * Fixed design canvas scaled uniformly to fit. Steps that share a scene key keep one mounted
+ * Scene (only `payload` changes); otherwise scenes cross-fade and shared `layoutId`s morph.
+ */
+export function Stage({ step, mode }: { step: AnyStep; mode: Mode }) {
+  const scale = useFitScale(mode)
+  const { Scene, payload } = step
+  return (
+    <div
+      data-presentation-stage=""
+      style={{
+        flex: '1 1 0',
+        minHeight: 0,
+        display: 'flex',
+        alignItems: 'center',
+        justifyContent: 'center',
+      }}
+    >
+      <div style={{ width: DESIGN_W * scale, height: DESIGN_H * scale, position: 'relative' }}>
+        <motion.div
+          data-presentation-canvas=""
+          data-presentation-scale={scale.toFixed(4)}
+          style={{
+            width: DESIGN_W,
+            height: DESIGN_H,
+            position: 'absolute',
+            left: 0,
+            top: 0,
+            originX: 0,
+            originY: 0,
+            scale,
+          }}
+        >
+          <LayoutGroup>
+            <AnimatePresence initial={false}>
+              <motion.div
+                key={sceneKey(step)}
+                data-presentation-scene=""
+                initial={{ opacity: 0 }}
+                animate={{ opacity: 1, transition: { duration: EXIT_T, ease: EASE } }}
+                exit={{ opacity: 0, transition: { duration: EXIT_T, ease: EASE } }}
+                style={{ position: 'absolute', inset: 0 }}
+              >
+                <Scene payload={payload} />
+              </motion.div>
+            </AnimatePresence>
+          </LayoutGroup>
+        </motion.div>
+      </div>
+    </div>
