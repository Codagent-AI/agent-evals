@@ -0,0 +1,316 @@
+/* Look of "How to Use This Skill to Make a Presentation". Owned by this presentation, not the kit. */
+.hmp {
+  --ink: #f4efe4;
+  --muted: #b3aa98;
+  --line: #4a4437;
+  --gold: #e8c76a;
+  --panel: #1b1915;
+  --ok: #7bd389;
+  color: var(--ink);
+  background: radial-gradient(circle at 20% 0%, #231f17 0%, #0f0e0c 60%);
+  font-size: 16px;
+}
+
+.hmp h1,
+.hmp p,
+.hmp ol {
+  margin: 0;
+  padding: 0;
+}
+
+/* chrome */
+.hmp [data-presentation-chrome='header'] {
+  gap: 1rem;
+  padding: 0 1.5rem;
+}
+
+.hmp [data-presentation-marker] {
+  display: flex;
+  gap: 0.6rem;
+  align-items: baseline;
+  color: var(--gold);
+  font-size: 0.8rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  white-space: nowrap;
+}
+
+.hmp [data-presentation-marker-number] {
+  font-weight: 700;
+}
+
+.hmp [data-presentation-title] {
+  font-size: 1.35rem;
+  font-weight: 600;
+  letter-spacing: -0.01em;
+}
+
+.hmp button {
+  color: var(--ink);
+  background: transparent;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  padding: 0.25rem 0.9rem;
+  cursor: pointer;
+}
+
+.hmp button:disabled {
+  opacity: 0.35;
+  cursor: default;
+}
+
+.hmp button:focus-visible,
+.hmp a:focus-visible {
+  outline: 2px solid var(--gold);
+  outline-offset: 2px;
+}
+
+.hmp [data-presentation-chrome='footer'] {
+  padding: 0.5rem 1.5rem 2.5rem;
+  display: grid;
+  gap: 0.75rem;
+  justify-items: center;
+  text-align: center;
+}
+
+.hmp [data-presentation-caption] {
+  max-width: 44rem;
+  color: var(--muted);
+  font-size: 1.05rem;
+}
+
+.hmp [data-presentation-chrome='toc'] ol {
+  gap: 0.5rem;
+}
+
+.hmp [data-presentation-toc-item] {
+  font-size: 0.8rem;
+  color: var(--muted);
+}
+
+.hmp [data-presentation-toc-item][data-presentation-active] {
+  color: #17140e;
+  background: var(--gold);
+  border-color: var(--gold);
+  font-weight: 700;
+}
+
+.hmp [data-presentation-chrome='controls'] {
+  gap: 1rem;
+}
+
+.hmp [data-presentation-progress] {
+  gap: 0.5rem;
+}
+
+.hmp [data-presentation-progress-item] {
+  width: 12px;
+  height: 12px;
+  padding: 0;
+  background: var(--line);
+  border-color: var(--line);
+}
+
+.hmp [data-presentation-progress-item][data-presentation-active] {
+  width: 30px;
+  background: var(--gold);
+  border-color: var(--gold);
+}
+
+.hmp [data-presentation-attribution-slot] {
+  padding: 0.5rem 0.9rem;
+}
+
+.hmp [data-presentation-attribution] {
+  color: var(--gold);
+  font-size: 0.85rem;
+  font-weight: 600;
+  letter-spacing: 0.02em;
+  text-decoration: none;
+}
+
+.hmp [data-presentation-attribution]:hover {
+  text-decoration: underline;
+}
+
+/* scene entities */
+.hmp [data-presentation-node='box'] {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
