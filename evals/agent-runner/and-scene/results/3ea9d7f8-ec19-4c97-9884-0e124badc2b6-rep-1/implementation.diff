+  })
+  it('lets a flag or the environment override the settle interval', () => {
+    expect(inspect.parseArgs(['s']).settleMs).toBe(inspect.DEFAULT_SETTLE_MS)
+    expect(inspect.parseArgs(['s', '--settle', '123']).settleMs).toBe(123)
