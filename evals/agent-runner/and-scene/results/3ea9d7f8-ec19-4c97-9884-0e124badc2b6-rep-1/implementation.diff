@@ -0,0 +1,37 @@
+import type { ComponentType } from 'react'
+
+/** Narration and identity carried by every step. */
+export interface StepMeta {
+  /** Stable identity; survives reordering. */
+  id: string
+  /** Section/era label, used by the table of contents. */
+  era: string
+  /** Presenter title (one-liner). */
+  title: string
+  /** Browse caption (paragraph). */
+  caption: string
+}
+
+export interface SceneProps<TPayload = undefined> {
+  payload: TPayload
+}
+
+/**
+ * One state of the scene. Adjacent steps that share a `groupKey` and `Scene` keep a single
+ * mounted Scene instance; only `payload` changes between them.
+ */
+export interface Step<TPayload = undefined> extends StepMeta {
+  Scene: ComponentType<SceneProps<TPayload>>
+  payload: TPayload
+  groupKey?: string
+}
+
+// Steps with different payload types may share one deck; each is still checked against its own Scene.
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export type AnyStep = Step<any>
+
+export interface Era {
+  label: string
+  /** Index of the first step carrying this era label. */
+  firstIndex: number
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d652954ce6e6eaeb004d1cff6a25339fa677daa2
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,25 @@
+import { useEffect, useState } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT, type Mode } from './constants'
+
+export function computeFitScale(viewportW: number, viewportH: number, mode: Mode): number {
+  const { top, bottom, side } = STAGE_LAYOUT[mode]
+  const availW = viewportW - side * 2
+  const availH = viewportH - top - bottom
+  return Math.max(MIN_SCALE, Math.min(availW / DESIGN_W, availH / DESIGN_H))
+}
+
+export function useViewport(): { width: number; height: number } {
+  const [size, setSize] = useState(() => ({ width: window.innerWidth, height: window.innerHeight }))
+  useEffect(() => {
+    const onResize = () => setSize({ width: window.innerWidth, height: window.innerHeight })
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return size
+}
+
+/** Uniform scale for the active mode's stage geometry. Constant within a mode and viewport. */
+export function useFitScale(mode: Mode): number {
+  const { width, height } = useViewport()
+  return computeFitScale(width, height, mode)
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ead0c2866b37aff4b97cb0bb1ecbe91355308b1b
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,73 @@
+import { useCallback, useEffect, useState } from 'react'
+import { SWIPE_MIN_PX, type Mode } from './constants'
+import { isInteractive } from './interactive'
+
+const NEXT_KEYS = new Set(['ArrowRight', ' ', 'PageDown'])
+const PREV_KEYS = new Set(['ArrowLeft', 'PageUp'])
+
+export interface PresentationNav {
+  index: number
+  mode: Mode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  toggleMode: () => void
+}
+
+/** Keyboard, touch and programmatic navigation. Clamps at both ends; never wraps. */
+export function usePresentationNav(count: number, initialMode: Mode = 'browse'): PresentationNav {
+  const [rawIndex, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const last = Math.max(0, count - 1)
+  // The step list can shrink under a mounted deck; never point past its end.
+  const index = Math.min(rawIndex, last)
+
+  const goTo = useCallback((i: number) => setIndex(Math.min(last, Math.max(0, i))), [last])
+  // Step from the displayed index, which is clamped when the step list has shrunk.
+  const next = useCallback(() => setIndex((i) => Math.min(last, Math.min(i, last) + 1)), [last])
+  const prev = useCallback(() => setIndex((i) => Math.max(0, Math.min(i, last) - 1)), [last])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'browse' ? 'present' : 'browse')), [])
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.ctrlKey || e.metaKey || e.altKey) return
+      if (isInteractive(e.target as Element | null) || isInteractive(document.activeElement)) return
+      if (NEXT_KEYS.has(e.key)) next()
+      else if (PREV_KEYS.has(e.key)) prev()
+      else if (e.key === 'p' || e.key === 'P') toggleMode()
+      else return
+      e.preventDefault()
+    }
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (e: TouchEvent) => {
+      const t = e.touches[0]
+      start = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onTouchEnd = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      const from = start
+      start = null
+      if (!from || !t) return
+      const dx = t.clientX - from.x
+      const dy = t.clientY - from.y
+      if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) <= Math.abs(dy)) return
+      if (dx < 0) next()
+      else prev()
+    }
+    const onTouchCancel = () => {
+      start = null
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart, { passive: true })
+    window.addEventListener('touchend', onTouchEnd, { passive: true })
+    window.addEventListener('touchcancel', onTouchCancel, { passive: true })
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+      window.removeEventListener('touchcancel', onTouchCancel)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, next, prev, goTo, toggleMode }
+}
