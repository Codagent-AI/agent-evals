@@ -0,0 +1,33 @@
+import type { ReactNode } from 'react'
+import type { HTMLMotionProps, MotionStyle } from 'motion/react'
+
+/** Position and size on the design canvas, in design pixels. */
+export interface Rect {
+  x: number
+  y: number
+  w?: number
+  h?: number
+}
+
+export type NodeProps = Omit<HTMLMotionProps<'div'>, 'id' | 'layoutId' | 'children'> & {
+  children?: ReactNode
+  /** Stable entity identity; also the motion layoutId so the entity morphs across steps. */
+  id: string
+  at?: Rect
+  /** Marks a subtree whose overlaps are intentional and readable. */
+  allowOverlap?: boolean
+}
+
+/** Geometry only; the kit never sets visual style. */
+export function placement(at: Rect | undefined, style: MotionStyle | undefined): MotionStyle {
+  if (!at) return { ...style }
+  return { position: 'absolute', left: at.x, top: at.y, width: at.w, height: at.h, ...style }
+}
+
+export function nodeAttrs(kind: string, id: string, allowOverlap?: boolean) {
+  return {
+    'data-presentation-node': kind,
+    'data-presentation-entity': id,
+    'data-presentation-allow-overlap': allowOverlap ? '' : undefined,
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/outline.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/outline.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3acb7b83c679787b2fa7229958cee19c569db0ba
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/outline.ts
@@ -0,0 +1,16 @@
+import type { AnyStep, Era, OutlineEntry } from './types.ts'
+
+/** Numbers and era grouping are derived from order, never stored on steps. */
+export function buildOutline(steps: readonly AnyStep[]): { entries: OutlineEntry[]; eras: Era[] } {
+  const eras: Era[] = []
+  const entries = steps.map((step, index) => {
+    let era = eras[eras.length - 1]
+    if (!era || era.label !== step.era) {
+      era = { label: step.era, firstIndex: index, indices: [] }
+      eras.push(era)
+    }
+    era.indices.push(index)
+    return { step, index, number: index + 1, eraIndex: eras.length - 1 }
+  })
+  return { entries, eras }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c7db84550f3ac93891d4c763f406361eacc2fc0e
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
@@ -0,0 +1,17 @@
+import type { AnyStep } from './types.ts'
+
+const sceneIds = new WeakMap<object, number>()
+let nextId = 1
+function sceneId(Scene: object): number {
+  let id = sceneIds.get(Scene)
+  if (id === undefined) {
+    id = nextId++
+    sceneIds.set(Scene, id)
+  }
+  return id
+}
+
+/** Steps sharing a groupKey and Scene share a key, so the scene instance persists. */
+export function sceneKey(step: AnyStep): string {
+  return step.groupKey ? `group:${step.groupKey}:${sceneId(step.Scene)}` : `step:${step.id}`
+}
