+import type { ComponentType } from 'react'
+
+export interface PresentationEntry {
+  slug: string
+  title: string
+  load: () => Promise<{ default: ComponentType }>
+}
+
+// Explicit registry: adding a presentation is a new folder plus one line here.
+export const presentations: PresentationEntry[] = [
+  {
+    slug: 'how-to-make-a-presentation',
+    title: 'How to Use This Skill to Make a Presentation',
+    load: () => import('./how-to-make-a-presentation/Talk.tsx'),
+  },
+]
+
+export function findPresentation(slug: string): PresentationEntry | undefined {
+  return presentations.find((p) => p.slug === slug)
+}
diff --git a/src/route.ts b/src/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..753b7f48330fab856f4ba7fa0c505c11e56e31d0
--- /dev/null
+++ b/src/route.ts
@@ -0,0 +1,10 @@
+import { findPresentation, type PresentationEntry } from './presentations/index.ts'
+
+export type Route = { kind: 'landing' } | { kind: 'presentation'; entry: PresentationEntry }
+
+/** "/" and unknown paths show the landing page; "/<slug>" shows that presentation. */
+export function resolveRoute(pathname: string): Route {
+  const slug = pathname.replace(/^\/+|\/+$/g, '')
+  const entry = slug ? findPresentation(slug) : undefined
+  return entry ? { kind: 'presentation', entry } : { kind: 'landing' }
+}
