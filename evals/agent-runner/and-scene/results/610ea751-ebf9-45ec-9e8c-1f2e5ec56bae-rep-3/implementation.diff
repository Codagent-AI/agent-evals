+/* Look for "How to Use This Skill to Make a Presentation". The scene kit ships no styles. */
+[data-presentation-root] {
+  --ink: #f4efe3;
+  --muted: #b3ab98;
+  --line: #5b5446;
+  --paper: #1c1a16;
+  --card: #2a2620;
+  --accent: #f0b429;
+  --pass: #62c370;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
+  color: var(--ink);
+  background: var(--paper);
+  padding: 0 20px;
+  box-sizing: border-box;
+}
+
+[data-presentation-header] {
+  padding: 14px 0 6px;
+  font-size: 13px;
+  letter-spacing: 0.04em;
+  color: var(--muted);
+}
+[data-presentation-number] { color: var(--accent); font-weight: 700; }
+[data-presentation-era] { text-transform: uppercase; margin-left: 8px; }
+[data-presentation-title] { font-weight: 600; color: var(--ink); }
+
+[data-presentation-footer] { padding: 8px 0; max-width: 960px; width: 100%; margin: 0 auto; }
+[data-presentation-step-title] { margin: 0 0 6px; font-size: 26px; line-height: 1.2; }
+[data-presentation-root][data-mode='present'] [data-presentation-step-title] { font-size: 34px; text-align: center; }
+[data-presentation-caption] { margin: 0 0 12px; font-size: 16px; line-height: 1.5; color: var(--muted); min-height: 3em; }
+
+[data-presentation-controls] { gap: 16px; }
+[data-presentation-prev],
+[data-presentation-next] {
+  font: inherit;
+  font-size: 14px;
+  color: var(--ink);
+  background: transparent;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  padding: 6px 16px;
+  cursor: pointer;
+}
+[data-presentation-prev]:disabled,
+[data-presentation-next]:disabled { opacity: 0.35; cursor: default; }
+[data-presentation-prev]:focus-visible,
+[data-presentation-next]:focus-visible,
+[data-presentation-progress-dot]:focus-visible,
+[data-presentation-toc-entry]:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+
+[data-presentation-progress] { gap: 10px; }
+[data-presentation-progress-dot] {
+  width: 12px;
+  height: 12px;
+  padding: 0;
+  border-radius: 50%;
+  border: 1px solid var(--muted);
+  background: transparent;
+  cursor: pointer;
+}
+[data-presentation-progress-dot][data-active='true'] {
+  background: var(--accent);
+  border-color: var(--accent);
+  transform: scale(1.35);
+}
+
+[data-presentation-toc] { width: 170px; padding: 8px 12px 8px 0; }
+[data-presentation-toc-entry] {
+  display: block;
+  width: 100%;
+  text-align: left;
+  font: inherit;
+  font-size: 13px;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  color: var(--muted);
+  background: transparent;
+  border: 0;
+  border-left: 3px solid transparent;
+  padding: 8px 10px;
+  cursor: pointer;
+}
+[data-presentation-toc-entry][data-active='true'] {
+  color: var(--ink);
+  font-weight: 700;
+  border-left-color: var(--accent);
+  background: var(--card);
+}
+
+[data-presentation-attribution-row] { padding: 2px 0 10px; }
+[data-presentation-attribution] {
+  font-size: 13px;
+  color: var(--muted);
+  text-decoration: underline;
+  text-underline-offset: 3px;
+  padding: 2px 4px;
+}
+[data-presentation-attribution]:hover { color: var(--accent); }
+
+/* Diagram */
+.sample-scene { font-size: 13px; }
+.sample-scene .node,
+.sample-scene .card,
+.sample-scene .bubble,
+.sample-scene .socket {
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  background: var(--card);
+  border: 2px solid var(--line);
+  border-radius: 10px;
+  color: var(--ink);
+  text-align: center;
+}
+.sample-scene .node { font-size: 16px; font-weight: 600; }
+.sample-scene .node svg { width: 20px; height: 20px; color: var(--accent); }
+.sample-scene .bubble { font-size: 13px; border-radius: 16px; color: var(--muted); }
+.sample-scene .tray {
+  box-sizing: border-box;
+  background: rgba(255, 255, 255, 0.04);
+  border: 2px solid var(--line);
+  border-radius: 14px;
+}
+.sample-scene .card { align-items: stretch; padding: 8px; font-size: 11px; justify-content: space-between; }
+.sample-scene .card [data-part='title'] { font-weight: 700; color: var(--accent); }
+.sample-scene .card [data-part='caption'] { color: var(--muted); }
+.sample-scene .card [data-part='visual'] { height: 22px; border-radius: 4px; background: var(--line); }
+.sample-scene .ghost { border-style: dashed; background: transparent; color: var(--muted); font-size: 22px; justify-content: center; align-items: center; }
+.sample-scene .socket { font-size: 12px; border-color: var(--accent); border-radius: 6px 6px 14px 14px; }
+.sample-scene .chip {
+  box-sizing: border-box;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  font-size: 12px;
+  color: var(--ink);
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-radius: 999px;
+}
+.sample-scene .chip svg { width: 14px; height: 14px; flex: none; }
+.sample-scene .chip.morph { border: 0; background: transparent; color: var(--accent); }
+.sample-scene .chip[data-tone='pass'] { background: var(--pass); border-color: var(--pass); color: var(--paper); }
+.sample-scene .chip[data-tone='edited'] { background: var(--accent); border-color: var(--accent); color: var(--paper); }
+.sample-scene .ring { box-sizing: border-box; border: 2px solid var(--accent); border-radius: 12px; }
+.sample-scene .frame { box-sizing: border-box; border: 2px dashed var(--accent); border-radius: 18px; }
+.sample-scene .frame-label { font-size: 14px; font-weight: 600; color: var(--accent); }
+.sample-scene .arrow { color: var(--muted); }
+.sample-scene .arrow path { stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
+.sample-scene .arrow[data-kind='modify'] { color: var(--accent); }
