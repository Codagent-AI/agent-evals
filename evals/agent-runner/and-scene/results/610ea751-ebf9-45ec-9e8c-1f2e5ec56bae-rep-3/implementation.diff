diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e0d22539b03688cd4dced6bc58b3107501b789e2
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,146 @@
+#!/usr/bin/env node
+// Captures settled per-step screenshots from a production preview and prints advisory warnings.
+// Usage: node scripts/inspect-presentation.mjs <slug> [--out dir] [--settle ms] [--viewport WxH] [--skip-build]
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { chromium } from 'playwright'
+import { attributionIssues, findOverlaps, isActiveDistinct } from './inspection-checks.mjs'
+import { run, SETTLE_MS, startPreview } from './preview.mjs'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const STEP_TIMEOUT_MS = 4000
+
+function parseArgs(argv) {
+  const opts = { slug: undefined, out: undefined, settle: SETTLE_MS, viewport: '1440x900', build: true }
+  for (let i = 0; i < argv.length; i++) {
+    const a = argv[i]
+    if (a === '--out') opts.out = argv[++i]
+    else if (a === '--settle') opts.settle = Number(argv[++i])
+    else if (a === '--viewport') opts.viewport = argv[++i]
+    else if (a === '--skip-build') opts.build = false
+    else if (!a.startsWith('--') && !opts.slug) opts.slug = a
+    else throw new Error(`unknown argument: ${a}`)
+  }
+  if (!opts.slug) throw new Error('usage: inspect-presentation <slug> [--out dir] [--settle ms] [--viewport WxH] [--skip-build]')
+  const m = /^(\d+)x(\d+)$/.exec(opts.viewport)
+  if (!m || !(opts.settle >= 0)) throw new Error('invalid --viewport or --settle')
+  opts.size = { width: Number(m[1]), height: Number(m[2]) }
+  opts.out = path.resolve(root, opts.out ?? path.join('inspection', opts.slug))
+  return opts
+}
+
+// Runs in the page: plain data only, so the checks stay in inspection-checks.mjs.
+function collectPage() {
+  const rectOf = (r) => ({ x: r.left, y: r.top, w: r.width, h: r.height })
+  const visible = (el) => {
+    const cs = getComputedStyle(el)
+    return cs.visibility !== 'hidden' && cs.display !== 'none' && Number(cs.opacity) > 0.05
+  }
+  const describe = (el) => {
+    const hook = [...el.attributes].find((a) => a.name.startsWith('data-presentation-') && a.name !== 'data-presentation-allow-overlap')
+    const text = (el.textContent ?? '').trim().replace(/\s+/g, ' ').slice(0, 30)
+    return `${el.tagName.toLowerCase()}${hook ? `[${hook.name}]` : ''} "${text}"`
+  }
+  const items = []
+  const els = []
+  // Visible text, plus text-less controls and icons (progress dots, icon buttons, glyphs) that text must not cover.
+  const CONTROL = 'button, a[href], [data-presentation-glyph], [data-presentation-progress-dot]'
+  for (const el of document.querySelectorAll('[data-presentation-root] *')) {
+    const own = [...el.childNodes].filter((n) => n.nodeType === 3 && n.textContent.trim())
+    if (!visible(el) || (!own.length && !el.matches(CONTROL))) continue
+    let rect
+    let rects
+    if (own.length) {
+      const range = document.createRange()
+      range.selectNodeContents(el)
+      rect = rectOf(range.getBoundingClientRect())
+      // Wrapped text has one box per line; the union rect also covers the gaps between lines.
+      rects = [...range.getClientRects()].map(rectOf).filter((r) => r.w > 0 && r.h > 0)
+    } else rect = rectOf(el.getBoundingClientRect())
+    if (rect.w === 0 || rect.h === 0) continue
+    els.push(el)
+    items.push({ label: describe(el), rect, rects, allowed: el.closest('[data-presentation-allow-overlap]') !== null, ancestors: [] })
+  }
+  items.forEach((item, i) => {
+    els.forEach((other, j) => {
+      if (i !== j && other.contains(els[i])) item.ancestors.push(j)
+    })
+  })
+
+  const style = (el) => {
+    const cs = getComputedStyle(el)
+    const props = Object.fromEntries(
+      ['backgroundColor', 'color', 'borderTopColor', 'borderTopWidth', 'fontWeight', 'opacity', 'transform', 'boxShadow', 'outlineStyle', 'textDecorationLine'].map((p) => [p, cs[p]]),
+    )
+    return { ...props, size: el.textContent.trim() ? '' : `${cs.width} ${cs.height}` }
+  }
+  const chrome = []
+  for (const [name, selector] of [
+    ['progress indicator', '[data-presentation-progress-dot]'],
+    ['table-of-contents entry', '[data-presentation-toc-entry]'],
+  ]) {
+    const all = [...document.querySelectorAll(selector)]
+    const active = all.find((e) => e.getAttribute('aria-current') === 'step')
+    const inactive = all.find((e) => e !== active)
+    if (active && inactive) chrome.push({ name, active: style(active), inactive: style(inactive) })
+  }
+  const attr = document.querySelector('[data-presentation-attribution]')
+  let attribution = null
+  if (attr) {
+    const cs = getComputedStyle(attr)
+    attribution = { fontSize: parseFloat(cs.fontSize), color: cs.color, fontFamily: cs.fontFamily, rect: rectOf(attr.getBoundingClientRect()) }
+  }
+  return { items, chrome, attribution }
+}
+
+async function main() {
+  const opts = parseArgs(process.argv.slice(2))
+  if (opts.build) {
+    const { code, output } = await run('npm', ['run', 'build'], root)
+    if (code !== 0) throw new Error(`build failed\n${output.slice(-2000)}`)
+  }
+  fs.rmSync(opts.out, { recursive: true, force: true })
+  fs.mkdirSync(opts.out, { recursive: true })
+  const preview = await startPreview(root)
+  const browser = await chromium.launch()
+  const warnings = []
+  const manifest = []
+  try {
+    const page = await (await browser.newContext({ viewport: opts.size })).newPage()
+    await page.goto(`${preview.url}/${opts.slug}`, { waitUntil: 'load' })
+    await page.waitForSelector('[data-presentation-root]', { timeout: STEP_TIMEOUT_MS })
+    const root$ = page.locator('[data-presentation-root]')
+    const count = Number(await root$.getAttribute('data-step-count'))
+    for (let i = 0; i < count; i++) {
+      const navigatedAt = Date.now()
+      await page.waitForTimeout(opts.settle)
+      const file = path.join(opts.out, `step-${String(i + 1).padStart(2, '0')}.png`)
+      await page.screenshot({ path: file })
+      manifest.push({ step: i + 1, file: path.relative(root, file), navigatedAt, capturedAt: Date.now(), settleMs: opts.settle })
+      const data = await page.evaluate(collectPage)
+      const step = i + 1
+      for (const [a, b] of findOverlaps(data.items)) warnings.push(`step ${step}: overlap between ${a} and ${b} (mark intentional overlap with data-presentation-allow-overlap)`)
+      for (const c of data.chrome) {
+        if (!isActiveDistinct(c.active, c.inactive)) warnings.push(`step ${step}: active ${c.name} is indistinct from inactive ones (style [aria-current="step"] / [data-active="true"])`)
+      }
+      for (const issue of attributionIssues(data.attribution)) warnings.push(`step ${step}: attribution ${issue} (style [data-presentation-attribution])`)
+      if (i < count - 1) {
+        await page.keyboard.press('ArrowRight')
+        await page.waitForFunction((n) => document.querySelector('[data-presentation-root]')?.getAttribute('data-step-index') === String(n), i + 1, { timeout: STEP_TIMEOUT_MS })
+      }
+    }
+  } finally {
+    await browser.close().catch(() => {})
+    preview.stop()
+  }
+  fs.writeFileSync(path.join(opts.out, 'manifest.json'), JSON.stringify({ slug: opts.slug, viewport: opts.size, steps: manifest, warnings }, null, 2))
+  console.log(`[inspect] ${manifest.length} screenshots written to ${path.relative(root, opts.out)}/`)
+  for (const w of warnings) console.log(`[inspect] WARN ${w}`)
+  console.log(`[inspect] ${warnings.length} advisory warning(s)`)
+}
+
+main().catch((err) => {
+  console.error(`[inspect] ERROR ${err.message}`)
+  process.exit(1)
+})
diff --git a/scripts/inspection-checks.mjs b/scripts/inspection-checks.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..59217f16ca0a148dcdfecdeeffc7e06f4568d4ae
--- /dev/null
+++ b/scripts/inspection-checks.mjs
@@ -0,0 +1,72 @@
+// Pure visual-quality checks over plain data collected from the page. Advisory only.
+
+const DEFAULT_LINK_COLORS = new Set(['rgb(0, 0, 238)', 'rgb(85, 26, 139)', 'rgb(0, 0, 255)'])
+const MIN_ATTRIBUTION_FONT_PX = 11
+const MIN_OVERLAP_PX = 3
+
+export function intersection(a, b) {
+  const w = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x)
+  const h = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y)
+  return w > 0 && h > 0 ? { w, h } : null
+}
+
+/**
+ * items: [{ label, rect: {x,y,w,h}, rects?: {x,y,w,h}[], allowed: boolean, ancestors: number[] }]
+ * `rects` are an item's per-line boxes (wrapped text); they are compared instead of the one union
+ * `rect`, whose bounding box spans the blank space around wrapped lines. Items inside an allow-overlap subtree never produce warnings; `ancestors`
+ * lists item indexes that contain the item so containment is not a collision.
+ */
+const boxesOf = (item) => (item.rects?.length ? item.rects : [item.rect])
+
+export function findOverlaps(items) {
+  const found = []
+  for (let i = 0; i < items.length; i++) {
+    for (let j = i + 1; j < items.length; j++) {
+      const a = items[i]
+      const b = items[j]
+      if (a.allowed || b.allowed) continue
+      if (a.ancestors?.includes(j) || b.ancestors?.includes(i)) continue
+      const collides = boxesOf(a).some((ra) =>
+        boxesOf(b).some((rb) => {
+          const hit = intersection(ra, rb)
+          return hit && hit.w >= MIN_OVERLAP_PX && hit.h >= MIN_OVERLAP_PX
+        }),
+      )
+      if (collides) found.push([a.label, b.label])
+    }
+  }
+  return found
+}
+
+const DISTINCT_PROPS = [
+  'backgroundColor',
+  'color',
+  'borderTopColor',
+  'borderTopWidth',
+  'fontWeight',
+  'opacity',
+  'transform',
+  'boxShadow',
+  'outlineStyle',
+  'textDecorationLine',
+  'size',
+]
+
+/**
+ * Active chrome must differ from an inactive sibling in at least one visible property.
+ * `size` is only set for text-less controls (dots), where text length cannot change the box.
+ */
+export function isActiveDistinct(active, inactive) {
+  return DISTINCT_PROPS.some((p) => active[p] !== inactive[p])
+}
+
+/** Reasons the attribution looks unpolished; empty when it is fine. */
+export function attributionIssues(attr) {
+  if (!attr) return ['attribution link is missing']
+  const issues = []
+  if (attr.fontSize < MIN_ATTRIBUTION_FONT_PX) issues.push(`font size ${attr.fontSize}px is too small`)
+  if (DEFAULT_LINK_COLORS.has(attr.color)) issues.push('uses the browser-default link color')
+  if (/^"?times/i.test(attr.fontFamily)) issues.push('uses the browser-default font')
+  if (attr.rect.w < 24 || attr.rect.h < 8) issues.push('rendered size is too small')
+  return issues
+}
diff --git a/scripts/inspection-checks.test.mjs b/scripts/inspection-checks.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..2bde3f92ad57cc566db8f7362078bbb8d22002c1
--- /dev/null
+++ b/scripts/inspection-checks.test.mjs
@@ -0,0 +1,81 @@
+import { describe, expect, it } from 'vitest'
+import { attributionIssues, findOverlaps, intersection, isActiveDistinct } from './inspection-checks.mjs'
+
+const item = (label, x, y, w, h, extra = {}) => ({ label, rect: { x, y, w, h }, allowed: false, ancestors: [], ...extra })
+
+describe('findOverlaps', () => {
+  it('reports unmarked overlapping text boxes', () => {
+    expect(findOverlaps([item('a', 0, 0, 50, 20), item('b', 40, 5, 50, 20)])).toEqual([['a', 'b']])
+  })
+
+  it('ignores boxes that only touch or are apart', () => {
+    expect(findOverlaps([item('a', 0, 0, 50, 20), item('b', 50, 0, 50, 20), item('c', 0, 100, 5, 5)])).toEqual([])
+  })
+
+  it('ignores overlaps involving an item inside an allow-overlap subtree', () => {
+    expect(findOverlaps([item('a', 0, 0, 50, 20, { allowed: true }), item('b', 40, 5, 50, 20)])).toEqual([])
+    expect(findOverlaps([item('a', 0, 0, 50, 20), item('b', 40, 5, 50, 20, { allowed: true })])).toEqual([])
+  })
+
+  it('does not treat a contained element as a collision with its ancestor', () => {
+    expect(findOverlaps([item('parent', 0, 0, 100, 100), item('child', 10, 10, 20, 20, { ancestors: [0] })])).toEqual([])
+  })
+
+  it('compares wrapped text line by line, not by its union box', () => {
+    // "1 / 9" sits beside the first line of a heading that wraps below it: the union box covers
+    // the number, the lines do not.
+    const number = item('number', 0, 0, 30, 14)
+    const wrapped = item('era', 40, 0, 60, 30, {
+      rects: [
+        { x: 40, y: 0, w: 30, h: 14 },
+        { x: 0, y: 16, w: 40, h: 14 },
+      ],
+    })
+    expect(findOverlaps([number, wrapped])).toEqual([])
+  })
+
+  it('still reports a wrapped line that really overlaps', () => {
+    const number = item('number', 0, 0, 30, 14)
+    const wrapped = item('era', 0, 0, 60, 30, { rects: [{ x: 20, y: 0, w: 40, h: 14 }, { x: 0, y: 16, w: 40, h: 14 }] })
+    expect(findOverlaps([number, wrapped])).toEqual([['number', 'era']])
+  })
+
+  it('ignores slivers smaller than the threshold', () => {
+    expect(findOverlaps([item('a', 0, 0, 50, 20), item('b', 49, 0, 50, 20)])).toEqual([])
+  })
+})
+
+describe('intersection', () => {
+  it('returns null for disjoint rects', () => {
+    expect(intersection({ x: 0, y: 0, w: 1, h: 1 }, { x: 5, y: 5, w: 1, h: 1 })).toBeNull()
+  })
+})
+
+describe('isActiveDistinct', () => {
+  const base = { backgroundColor: 'rgb(0, 0, 0)', color: 'rgb(1, 1, 1)', size: '10px 10px', opacity: '1' }
+  it('is false when active and inactive look identical', () => {
+    expect(isActiveDistinct({ ...base }, { ...base })).toBe(false)
+  })
+  it('is true when any visual property differs', () => {
+    expect(isActiveDistinct({ ...base, backgroundColor: 'rgb(9, 9, 9)' }, base)).toBe(true)
+    expect(isActiveDistinct({ ...base, size: '14px 14px' }, base)).toBe(true)
+  })
+})
+
+describe('attributionIssues', () => {
+  const good = { fontSize: 13, color: 'rgb(180, 170, 150)', fontFamily: 'Inter, sans-serif', rect: { x: 0, y: 0, w: 100, h: 16 } }
+  it('is empty for a polished link', () => {
+    expect(attributionIssues(good)).toEqual([])
+  })
+  it('flags a missing link', () => {
+    expect(attributionIssues(null)).toEqual(['attribution link is missing'])
+  })
+  it('flags a small font, default link color, and default font', () => {
+    expect(attributionIssues({ ...good, fontSize: 9 })).toHaveLength(1)
+    expect(attributionIssues({ ...good, color: 'rgb(0, 0, 238)' })).toEqual(['uses the browser-default link color'])
+    expect(attributionIssues({ ...good, fontFamily: '"Times New Roman"' })).toEqual(['uses the browser-default font'])
+  })
+  it('flags a tiny rendered size', () => {
+    expect(attributionIssues({ ...good, rect: { x: 0, y: 0, w: 10, h: 4 } })).toEqual(['rendered size is too small'])
+  })
+})
diff --git a/scripts/preview.mjs b/scripts/preview.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4e1cf665f93fdaf04ad8412f9879d8c2d749b1a6
--- /dev/null
+++ b/scripts/preview.mjs
@@ -0,0 +1,77 @@
+// Shared helpers: run commands and a production preview bound to 127.0.0.1.
+import { spawn } from 'node:child_process'
+import net from 'node:net'
+import path from 'node:path'
+
+export const HOST = '127.0.0.1'
+/** Time for a step transition to finish: the kit's newcomer delay plus its fade, with margin (ms). */
+export const SETTLE_MS = 1300
+
+export function freePort() {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer()
+    server.once('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+}
+
+/** Runs a command to completion, returning its exit code and combined output. */
+export function run(command, args, cwd) {
+  return new Promise((resolve) => {
+    const child = spawn(command, args, { cwd, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (d) => (output += d))
+    child.stderr.on('data', (d) => (output += d))
+    child.on('error', (err) => resolve({ code: 1, output: String(err) }))
+    child.on('close', (code) => resolve({ code: code ?? 1, output }))
+  })
+}
+
+async function waitReady(url, child, timeoutMs) {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    if (child.exitCode !== null) throw new Error(`preview server exited with code ${child.exitCode}`)
+    try {
+      const res = await fetch(url)
+      if (res.ok) return
+    } catch {
+      // not listening yet
+    }
+    await new Promise((r) => setTimeout(r, 100))
+  }
+  throw new Error(`preview server not ready at ${url} after ${timeoutMs}ms`)
+}
+
+/** Starts `vite preview` on the IPv4 loopback; stop() kills the whole process group. */
+export async function startPreview(root) {
+  const port = await freePort()
+  const vite = path.join(root, 'node_modules', 'vite', 'bin', 'vite.js')
+  const child = spawn(process.execPath, [vite, 'preview', '--host', HOST, '--port', String(port), '--strictPort'], {
+    cwd: root,
+    stdio: ['ignore', 'pipe', 'pipe'],
+    detached: true,
+  })
+  let log = ''
+  child.stdout.on('data', (d) => (log += d))
+  child.stderr.on('data', (d) => (log += d))
+  const stop = () => {
+    if (child.exitCode !== null || child.pid === undefined) return
+    try {
+      process.kill(-child.pid, 'SIGTERM')
+    } catch {
+      child.kill('SIGTERM')
+    }
+  }
+  process.once('exit', stop)
+  const url = `http://${HOST}:${port}`
+  try {
+    await waitReady(`${url}/`, child, 30_000)
+  } catch (err) {
+    stop()
+    throw new Error(`${err.message}\n${log}`, { cause: err })
+  }
+  return { url, stop }
+}
