+import type { ComponentType } from 'react'
+
+export type PresentationMode = 'present' | 'browse'
+
+/** Props every scene component receives: the active step's diagram state. */
+export interface SceneProps<TPayload> {
+  payload: TPayload
+}
+
+/**
+ * One named state of the evolving scene. Adjacent steps that share both
+ * `groupKey` and `Scene` keep a single scene instance; only `payload` changes.
+ * The on-screen step number is derived from array position and never stored.
+ */
+export interface Step<TPayload> {
+  id: string
+  /** Section/era label; consecutive steps with equal labels form one ToC entry. */
+  era: string
+  /** One-line presenter title. */
+  title: string
+  /** Paragraph shown in browse mode. */
+  caption: string
+  Scene: ComponentType<SceneProps<TPayload>>
+  groupKey?: string
+  payload: TPayload
+}
+
+export interface AttributionOptions {
+  label?: string
+  href?: string
+}
diff --git a/src/presentation-kit/useFitScale.ts b/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f84315821e27462bf62b33d6d1b074c41451b7cf
--- /dev/null
+++ b/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,21 @@
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT, TOC_W, WIDE_VIEWPORT } from './constants'
+import type { PresentationMode } from './types'
+import { useViewportSize } from './useViewportSize'
+
+/** Region (px) the canvas may occupy: the gap between the mode's header and footer. */
+export function availableStage(width: number, height: number, mode: PresentationMode) {
+  const { header, footer, side } = STAGE_LAYOUT[mode]
+  const tocW = mode === 'browse' && width >= WIDE_VIEWPORT ? TOC_W : 0
+  return { width: width - tocW - 2 * side, height: height - header - footer, left: tocW }
+}
+
+/** One uniform scale for both axes, floored at MIN_SCALE and never capped above. */
+export function computeFitScale(width: number, height: number, mode: PresentationMode): number {
+  const avail = availableStage(width, height, mode)
+  return Math.max(MIN_SCALE, Math.min(avail.width / DESIGN_W, avail.height / DESIGN_H))
+}
+
+export function useFitScale(mode: PresentationMode): number {
+  const { width, height } = useViewportSize()
+  return computeFitScale(width, height, mode)
+}
diff --git a/src/presentation-kit/usePresentationNav.ts b/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..326490ee1d6f2f31efeb308d6900a4900676eecb
--- /dev/null
+++ b/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,99 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import type { PresentationMode } from './types'
+
+export const SWIPE_MIN_PX = 40
+
+const CONTROL_SELECTOR = [
+  'button',
+  'a[href]',
+  'input',
+  'select',
+  'textarea',
+  'summary',
+  '[contenteditable]:not([contenteditable="false"])',
+  '[role="button"]',
+  '[role="link"]',
+  '[role="textbox"]',
+].join(',')
+
+/** True when keys on this element belong to the element, not to the deck. */
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(CONTROL_SELECTOR) !== null
+}
+
+/** Direction of a horizontal swipe (+1 next, -1 previous) or 0 when it does not qualify. */
+export function swipeDirection(dx: number, dy: number): -1 | 0 | 1 {
+  if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) <= Math.abs(dy)) return 0
+  return dx < 0 ? 1 : -1
+}
+
+const NEXT_KEYS = new Set(['ArrowRight', ' ', 'PageDown'])
+const PREV_KEYS = new Set(['ArrowLeft', 'PageUp'])
+
+export interface PresentationNav {
+  index: number
+  mode: PresentationMode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  setMode: (mode: PresentationMode) => void
+  toggleMode: () => void
+}
+
+export function usePresentationNav(count: number, initialMode: PresentationMode = 'browse'): PresentationNav {
+  const [rawIndex, setIndex] = useState(0)
+  const [mode, setMode] = useState<PresentationMode>(initialMode)
+  const last = Math.max(0, count - 1)
+  const index = Math.min(rawIndex, last)
+
+  const goTo = useCallback((i: number) => setIndex(Math.min(Math.max(0, i), last)), [last])
+  const next = useCallback(() => setIndex((i) => Math.min(i + 1, last)), [last])
+  const prev = useCallback(() => setIndex((i) => Math.max(i - 1, 0)), [])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'browse' ? 'present' : 'browse')), [])
+
+  const touchStart = useRef<{ x: number; y: number } | null>(null)
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.ctrlKey || e.metaKey || e.altKey) return
+      if (isInteractiveTarget(e.target)) return
+      if (NEXT_KEYS.has(e.key)) {
+        e.preventDefault()
+        next()
+      } else if (PREV_KEYS.has(e.key)) {
+        e.preventDefault()
+        prev()
+      } else if (e.key === 'p' || e.key === 'P') {
+        toggleMode()
+      }
+    }
+    const onTouchStart = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      touchStart.current = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onTouchEnd = (e: TouchEvent) => {
+      const start = touchStart.current
+      touchStart.current = null
+      const t = e.changedTouches[0]
+      if (!start || !t) return
+      const dir = swipeDirection(t.clientX - start.x, t.clientY - start.y)
+      if (dir === 1) next()
+      else if (dir === -1) prev()
+    }
+    const onTouchCancel = () => {
+      touchStart.current = null
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart)
+    window.addEventListener('touchend', onTouchEnd)
+    window.addEventListener('touchcancel', onTouchCancel)
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+      window.removeEventListener('touchcancel', onTouchCancel)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, next, prev, goTo, setMode, toggleMode }
+}
diff --git a/src/presentation-kit/useViewportSize.ts b/src/presentation-kit/useViewportSize.ts
new file mode 100644
index 0000000000000000000000000000000000000000..63c7f68987296e60cd4608ab0dbd4878a33da50e
--- /dev/null
+++ b/src/presentation-kit/useViewportSize.ts
@@ -0,0 +1,19 @@
+import { useEffect, useState } from 'react'
+
+export interface ViewportSize {
+  width: number
+  height: number
+}
+
+export function useViewportSize(): ViewportSize {
+  const [size, setSize] = useState<ViewportSize>(() => ({
+    width: window.innerWidth,
+    height: window.innerHeight,
+  }))
+  useEffect(() => {
+    const onResize = () => setSize({ width: window.innerWidth, height: window.innerHeight })
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return size
+}
diff --git a/src/presentations/how-to-make-a-presentation/Scene.tsx b/src/presentations/how-to-make-a-presentation/Scene.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a5deb0bd02182cdfb555a9508a9bce8a41fd8e18
--- /dev/null
+++ b/src/presentations/how-to-make-a-presentation/Scene.tsx
@@ -0,0 +1,147 @@
+import type { ReactNode } from 'react'
+import { Check, MessageCircleQuestion, Pencil, Puzzle, User, Wand2 } from 'lucide-react'
+import { Appear, Arrow, Box, Emphasis, Frame, Label, SceneLayer, SymbolChip, type SceneProps } from '../../presentation-kit'
+import { ARROWS, ENTITIES } from './entities'
+import type { SamplePayload } from './types'
+
+/**
+ * Entities introduced after the first step enter through `Appear`; it keeps wrapping
+ * them for as long as they stay on screen, so they never remount, and it only plays
+ * its fade when the entity mounts. The opening entities are rendered bare.
+ */
+const enters = (since: number) => since > 1
+
+function CardParts() {
+  return (
+    <>
+      <span data-part="title">title</span>
+      <span data-part="caption">caption</span>
+      <span data-part="visual">visual</span>
+    </>
+  )
+}
+
+export function Scene({ payload }: SceneProps<SamplePayload>) {
+  const step = payload.step
+  const on = (since: number) => step >= since
+  const wrap = (key: string, since: number, node: ReactNode) =>
+    enters(since) ? <Appear key={`appear:${key}`}>{node}</Appear> : node
+  const E = ENTITIES
+
+  return (
+    <SceneLayer>
+        {on(E.you.since) &&
+          wrap('you', E.you.since, (
+            <Box key="you" id={E.you.id} at={E.you.at} Icon={User}>
+              you
+            </Box>
+          ))}
+        {on(E.prompt.since) &&
+          wrap('prompt', E.prompt.since, (
+            <Label key="prompt" id={E.prompt.id} at={E.prompt.at}>
+              prompt
+            </Label>
+          ))}
+        {on(E.skill.since) &&
+          wrap('skill', E.skill.since, (
+            <Box key="skill" id={E.skill.id} at={E.skill.at} Icon={Wand2}>
+              skill
+            </Box>
+          ))}
+        {on(ARROWS.talk.since) &&
+          wrap('talk', ARROWS.talk.since, (
+            <Arrow key="talk" id={ARROWS.talk.id} from={[...ARROWS.talk.from]} to={[...ARROWS.talk.to]} twoWay />
+          ))}
+        {on(E.question.since) &&
+          wrap('question', E.question.since, (
+            <SymbolChip key="question" id={E.question.id} at={E.question.at} Icon={MessageCircleQuestion} />
+          ))}
+        {on(E.tray.since) &&
+          wrap('tray', E.tray.since, (
+            <Label key="tray" id={E.tray.id} at={E.tray.at} data-presentation-variant="tray">
+              step cards
+            </Label>
+          ))}
+        {on(E.card1.since) &&
+          wrap('card1', E.card1.since, (
+            <Box key="card1" id={E.card1.id} at={E.card1.at} data-presentation-variant="step-card">
+              <CardParts />
+            </Box>
+          ))}
+        {on(E.card2.since) &&
+          wrap('card2', E.card2.since, (
+            <Box key="card2" id={E.card2.id} at={E.card2.at} data-presentation-variant="step-card">
+              <CardParts />
+            </Box>
+          ))}
+        {on(E.card3.since) &&
+          wrap('card3', E.card3.since, (
+            <Box key="card3" id={E.card3.id} at={E.card3.at} data-presentation-variant="step-card">
+              <CardParts />
+            </Box>
+          ))}
+        {on(ARROWS.link1.since) &&
+          wrap('links', ARROWS.link1.since, (
+            [
+              <Arrow key="link1" id={ARROWS.link1.id} from={[...ARROWS.link1.from]} to={[...ARROWS.link1.to]} />,
+              <Arrow key="link2" id={ARROWS.link2.id} from={[...ARROWS.link2.from]} to={[...ARROWS.link2.to]} />,
+              <SymbolChip key="morph1" id={E.morph1.id} at={E.morph1.at} symbol="~" />,
+              <SymbolChip key="morph2" id={E.morph2.id} at={E.morph2.at} symbol="~" />,
+            ]
+          ))}
+        {on(E.ghost.since) &&
+          wrap('ghost', E.ghost.since, (
+            <Box key="ghost" id={E.ghost.id} at={E.ghost.at} data-presentation-variant="ghost-card">
+              <span>unspecified</span>
+            </Box>
+          ))}
+        {on(E.depth.since) &&
+          wrap('depth', E.depth.since, (
+            <Emphasis key="depth" id={E.depth.id} at={E.depth.at} on>
+              partial ↔ full
+            </Emphasis>
+          ))}
+        {on(E.kit.since) &&
+          wrap('kit', E.kit.since, (
+            <Box key="kit" id={E.kit.id} at={E.kit.at} Icon={Puzzle} data-presentation-variant="socket">
+              scene kit
+            </Box>
+          ))}
+        {on(E.verify.since) &&
+          wrap('verify', E.verify.since, (
+            [
+              <Arrow key="chain" id={ARROWS.chain.id} from={[...ARROWS.chain.from]} to={[...ARROWS.chain.to]} />,
+              <Box key="verify" id={E.verify.id} at={E.verify.at} data-presentation-variant="verify">
+                <span>build + render</span>
+              </Box>,
+              <SymbolChip key="pass" id={E.pass.id} at={E.pass.at} Icon={Check} data-presentation-variant="pass" />,
+            ]
+          ))}
+        {on(E.route.since) &&
+          wrap('route', E.route.since, (
+            [
+              <Label key="route" id={E.route.id} at={E.route.at}>
+                /how-to-make-a-presentation
+              </Label>,
+              <Arrow
+                key="modify"
+                id={ARROWS.modify.id}
+                from={[...ARROWS.modify.from]}
+                to={[...ARROWS.modify.to]}
+                bend={[...ARROWS.modify.bend]}
+              />,
+              <SymbolChip key="edited" id={E.edited.id} at={E.edited.at} Icon={Pencil} symbol="edited" />,
+            ]
+          ))}
+        {on(E.reveal.since) &&
+          wrap('reveal', E.reveal.since, (
+            [
+              <Frame key="reveal" id={E.reveal.id} at={E.reveal.at} data-presentation-allow-overlap="" />,
+              <Label key="reveal-label" id={E.revealLabel.id} at={E.revealLabel.at}>
+                built with this skill
+              </Label>,
+            ]
+          ))}
+    </SceneLayer>
+  )
+}
