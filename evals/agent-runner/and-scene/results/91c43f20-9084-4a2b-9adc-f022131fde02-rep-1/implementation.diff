+  gap: 4px;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  background: var(--card);
+  font-size: 12px;
+}
+
+.htmp [data-presentation-node='symbol-chip'] svg {
+  width: 14px;
+  height: 14px;
+}
+
+.htmp [data-presentation-variant='pass'] {
+  border-color: #6fbf73;
+  color: #6fbf73;
+}
+
+.htmp [data-presentation-node='emphasis'] {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid var(--accent);
+  border-radius: 6px;
+  color: var(--accent);
+  font-size: 12px;
+}
+
+.htmp [data-presentation-node='arrow'] {
+  color: var(--muted);
+  stroke-width: 1.6;
+  pointer-events: none;
+}
+
+.htmp [data-presentation-id='htmp:modify'] {
+  color: var(--accent);
+}
+
+.htmp [data-presentation-node='frame'][data-presentation-allow-overlap] {
+  border: 2px solid var(--accent);
+  border-radius: 18px;
+  background: transparent;
+  pointer-events: none;
+}
