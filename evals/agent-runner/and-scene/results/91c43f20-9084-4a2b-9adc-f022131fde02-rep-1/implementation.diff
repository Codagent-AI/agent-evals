+export const DEFAULT_ATTRIBUTION = {
+  label: 'made by and-scene',
+  href: 'https://github.com/Codagent-AI/and-scene',
+}
+
+export const MOTION_LAYOUT = { duration: LAYOUT_T, ease: EASE }
