+import { atStyle, entityMotion, type At, type NativeProps, type NodeHooks } from './shared'
+
+export interface BoxProps extends NodeHooks, NativeProps<HTMLDivElement> {
+  at?: At
+  /** Optional glyph rendered as a component, e.g. a lucide-react icon. */
+  Icon?: LucideIcon
+  children?: ReactNode
+}
+
+export function Box({ id, at, Icon, className, style, children, ...rest }: BoxProps) {
+  return (
+    <motion.div
+      {...rest}
+      {...entityMotion}
+      layoutId={id}
+      data-presentation-node="box"
+      data-presentation-id={id}
+      className={className}
+      style={atStyle(at, style)}
+    >
