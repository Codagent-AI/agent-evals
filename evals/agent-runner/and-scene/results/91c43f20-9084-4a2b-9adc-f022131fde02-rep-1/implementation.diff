+  color: var(--ink);
+}
+
+.htmp [data-presentation-variant='step-card'] {
+  align-items: stretch;
+  padding: 10px 12px;
+  font-size: 12px;
+  text-align: left;
+}
+
+.htmp [data-presentation-variant='step-card'] [data-part='title'] {
+  font-weight: 700;
+}
+
+.htmp [data-presentation-variant='step-card'] [data-part='caption'] {
+  color: var(--muted);
