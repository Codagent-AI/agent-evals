+
+describe('bootstrap manifest', () => {
+  const pkg = JSON.parse(read(`${BOOTSTRAP}/package.json`))
+  const lock = JSON.parse(read(`${BOOTSTRAP}/package-lock.json`))
+  const all = { ...pkg.dependencies, ...pkg.devDependencies }
