@@ -0,0 +1,34 @@
+import type { CSSProperties, HTMLAttributes } from 'react'
+import { EXIT_T, MOTION_LAYOUT } from '../constants'
+
+/** Literal canvas coordinates in design-canvas pixels. */
+export interface At {
+  x: number
+  y: number
+  w?: number
+  h?: number
+}
+
+export interface NodeHooks {
+  /** Stable entity identity; becomes the motion `layoutId`. */
+  id: string
+  className?: string
+  style?: CSSProperties
+}
+
+export function atStyle(at: At | undefined, style: CSSProperties | undefined): CSSProperties {
+  if (!at) return { ...style }
+  return { position: 'absolute', left: at.x, top: at.y, width: at.w, height: at.h, ...style }
+}
+
+export const entityMotion = {
+  layout: true,
+  transition: { layout: MOTION_LAYOUT },
+  exit: { opacity: 0, transition: { duration: EXIT_T } },
+} as const
+
+/** Native element props for a primitive, minus those the kit owns or motion redefines. */
+export type NativeProps<T extends HTMLElement> = Omit<
+  HTMLAttributes<T>,
+  'id' | 'style' | 'className' | 'onDrag' | 'onDragStart' | 'onDragEnd' | 'onAnimationStart'
+>
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
new file mode 100644
index 0000000000000000000000000000000000000000..446c9f81365578e2f79da654620451c4481e6b0a
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
@@ -0,0 +1,21 @@
+import type { ComponentType } from 'react'
+import type { Step } from './types'
+
+const sceneIds = new WeakMap<ComponentType<never>, number>()
+let nextSceneId = 0
+
+function sceneId(Scene: ComponentType<never>): number {
+  let id = sceneIds.get(Scene)
+  if (id === undefined) {
+    id = nextSceneId++
+    sceneIds.set(Scene, id)
+  }
+  return id
+}
+
+/** Steps with equal keys keep one scene instance; any other change swaps scenes. */
+export function sceneKey<TPayload>(step: Step<TPayload>): string {
+  // The leading tag keeps a group key from ever colliding with an ungrouped step's id.
+  const owner = step.groupKey === undefined ? `step:${step.id}` : `group:${step.groupKey}`
+  return `${owner}#${sceneId(step.Scene as ComponentType<never>)}`
+}
