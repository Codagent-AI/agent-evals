diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f84315821e27462bf62b33d6d1b074c41451b7cf
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,21 @@
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT, TOC_W, WIDE_VIEWPORT } from './constants'
+import type { PresentationMode } from './types'
+import { useViewportSize } from './useViewportSize'
+
+/** Region (px) the canvas may occupy: the gap between the mode's header and footer. */
+export function availableStage(width: number, height: number, mode: PresentationMode) {
+  const { header, footer, side } = STAGE_LAYOUT[mode]
+  const tocW = mode === 'browse' && width >= WIDE_VIEWPORT ? TOC_W : 0
+  return { width: width - tocW - 2 * side, height: height - header - footer, left: tocW }
+}
+
+/** One uniform scale for both axes, floored at MIN_SCALE and never capped above. */
+export function computeFitScale(width: number, height: number, mode: PresentationMode): number {
+  const avail = availableStage(width, height, mode)
+  return Math.max(MIN_SCALE, Math.min(avail.width / DESIGN_W, avail.height / DESIGN_H))
+}
+
+export function useFitScale(mode: PresentationMode): number {
+  const { width, height } = useViewportSize()
+  return computeFitScale(width, height, mode)
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..326490ee1d6f2f31efeb308d6900a4900676eecb
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,99 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import type { PresentationMode } from './types'
+
+export const SWIPE_MIN_PX = 40
+
+const CONTROL_SELECTOR = [
+  'button',
+  'a[href]',
+  'input',
+  'select',
+  'textarea',
+  'summary',
+  '[contenteditable]:not([contenteditable="false"])',
+  '[role="button"]',
+  '[role="link"]',
+  '[role="textbox"]',
+].join(',')
+
+/** True when keys on this element belong to the element, not to the deck. */
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(CONTROL_SELECTOR) !== null
+}
+
+/** Direction of a horizontal swipe (+1 next, -1 previous) or 0 when it does not qualify. */
+export function swipeDirection(dx: number, dy: number): -1 | 0 | 1 {
+  if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) <= Math.abs(dy)) return 0
+  return dx < 0 ? 1 : -1
+}
+
+const NEXT_KEYS = new Set(['ArrowRight', ' ', 'PageDown'])
+const PREV_KEYS = new Set(['ArrowLeft', 'PageUp'])
+
+export interface PresentationNav {
+  index: number
+  mode: PresentationMode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  setMode: (mode: PresentationMode) => void
+  toggleMode: () => void
+}
+
+export function usePresentationNav(count: number, initialMode: PresentationMode = 'browse'): PresentationNav {
+  const [rawIndex, setIndex] = useState(0)
+  const [mode, setMode] = useState<PresentationMode>(initialMode)
+  const last = Math.max(0, count - 1)
+  const index = Math.min(rawIndex, last)
+
+  const goTo = useCallback((i: number) => setIndex(Math.min(Math.max(0, i), last)), [last])
+  const next = useCallback(() => setIndex((i) => Math.min(i + 1, last)), [last])
+  const prev = useCallback(() => setIndex((i) => Math.max(i - 1, 0)), [])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'browse' ? 'present' : 'browse')), [])
+
+  const touchStart = useRef<{ x: number; y: number } | null>(null)
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.ctrlKey || e.metaKey || e.altKey) return
+      if (isInteractiveTarget(e.target)) return
+      if (NEXT_KEYS.has(e.key)) {
+        e.preventDefault()
+        next()
+      } else if (PREV_KEYS.has(e.key)) {
+        e.preventDefault()
+        prev()
+      } else if (e.key === 'p' || e.key === 'P') {
+        toggleMode()
+      }
+    }
+    const onTouchStart = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      touchStart.current = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onTouchEnd = (e: TouchEvent) => {
+      const start = touchStart.current
+      touchStart.current = null
+      const t = e.changedTouches[0]
+      if (!start || !t) return
+      const dir = swipeDirection(t.clientX - start.x, t.clientY - start.y)
+      if (dir === 1) next()
+      else if (dir === -1) prev()
+    }
+    const onTouchCancel = () => {
+      touchStart.current = null
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart)
+    window.addEventListener('touchend', onTouchEnd)
+    window.addEventListener('touchcancel', onTouchCancel)
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+      window.removeEventListener('touchcancel', onTouchCancel)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, next, prev, goTo, setMode, toggleMode }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useViewportSize.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useViewportSize.ts
new file mode 100644
index 0000000000000000000000000000000000000000..63c7f68987296e60cd4608ab0dbd4878a33da50e
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useViewportSize.ts
@@ -0,0 +1,19 @@
+import { useEffect, useState } from 'react'
+
+export interface ViewportSize {
+  width: number
+  height: number
+}
+
+export function useViewportSize(): ViewportSize {
+  const [size, setSize] = useState<ViewportSize>(() => ({
+    width: window.innerWidth,
+    height: window.innerHeight,
+  }))
+  useEffect(() => {
+    const onResize = () => setSize({ width: window.innerWidth, height: window.innerHeight })
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return size
+}
