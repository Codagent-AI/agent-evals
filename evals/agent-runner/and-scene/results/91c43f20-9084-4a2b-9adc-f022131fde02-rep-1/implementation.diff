diff --git a/skills/presentation/templates/bootstrap/src/router.tsx b/skills/presentation/templates/bootstrap/src/router.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..33fc5f5430f39f633c69d7ab713c90c077182290
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/router.tsx
@@ -0,0 +1,27 @@
+import { createElement, lazy, Suspense, type ComponentType, type LazyExoticComponent } from 'react'
+import { Landing } from './Landing'
+import type { PresentationEntry } from './presentations'
+import { resolveEntry } from './routing'
+
+// One lazy component per loader, so re-rendering never recreates (and remounts) a presentation.
+const lazyByLoader = new WeakMap<PresentationEntry['load'], LazyExoticComponent<ComponentType>>()
+
+function lazyPresentation(load: PresentationEntry['load']): LazyExoticComponent<ComponentType> {
+  let component = lazyByLoader.get(load)
+  if (!component) {
+    component = lazy(load)
+    lazyByLoader.set(load, component)
+  }
+  return component
+}
+
+export interface RouterProps {
+  pathname: string
+  registry: readonly PresentationEntry[]
+}
+
+export function Router({ pathname, registry }: RouterProps) {
+  const entry = resolveEntry(pathname, registry)
+  if (!entry) return <Landing registry={registry} />
+  return <Suspense fallback={null}>{createElement(lazyPresentation(entry.load))}</Suspense>
+}
diff --git a/skills/presentation/templates/bootstrap/src/routing.ts b/skills/presentation/templates/bootstrap/src/routing.ts
new file mode 100644
index 0000000000000000000000000000000000000000..22eef0a2887ee754ee09724df6c204d6f61d0e17
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/routing.ts
@@ -0,0 +1,17 @@
+import type { PresentationEntry } from './presentations'
+
+/** Slug for a `/<slug>` pathname, or null for the landing page and unknown shapes. */
+export function slugFromPathname(pathname: string): string | null {
+  const slug = pathname.replace(/^\/+|\/+$/g, '')
+  if (slug === '' || slug.includes('/')) return null
+  try {
+    return decodeURIComponent(slug)
+  } catch {
+    return null // malformed escapes such as "%" are unknown paths, not crashes
+  }
+}
+
+export function resolveEntry(pathname: string, registry: readonly PresentationEntry[]): PresentationEntry | null {
+  const slug = slugFromPathname(pathname)
+  return registry.find((e) => e.slug === slug) ?? null
+}
