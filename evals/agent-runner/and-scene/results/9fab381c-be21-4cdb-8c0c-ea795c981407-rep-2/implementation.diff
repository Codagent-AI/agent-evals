--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
@@ -0,0 +1,14 @@
+const sceneIds = new WeakMap<object, number>()
+let nextSceneId = 0
+function sceneId(scene: object): number {
+  let id = sceneIds.get(scene)
+  if (id === undefined) sceneIds.set(scene, (id = nextSceneId++))
+  return id
+}
+
+/** Steps share one mounted scene only with the same group key and Scene component. */
+export function sceneKey(step: { id: string; groupKey?: string; Scene: object }): string {
+  return step.groupKey === undefined
+    ? `step:${step.id}`
+    : `group:${step.groupKey}:${sceneId(step.Scene)}`
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/steps.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/steps.ts
new file mode 100644
index 0000000000000000000000000000000000000000..11bf495b6b79d75ca4cc09fde5bfecc3fa5f92f3
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/steps.ts
@@ -0,0 +1,43 @@
+import type { Step } from './types.ts'
+
+/** Throws when the step list cannot drive a presentation. */
+export function validateSteps(
+  steps: readonly (Pick<Step, 'id' | 'era' | 'title' | 'caption'> & { Scene?: unknown })[],
+): void {
+  if (steps.length === 0) throw new Error('A presentation needs at least one step')
+  const seen = new Set<string>()
+  steps.forEach((step, i) => {
+    for (const field of ['id', 'era', 'title', 'caption'] as const) {
+      if (typeof step[field] !== 'string' || step[field].trim() === '') {
+        throw new Error(`Step ${i} is missing required field "${field}"`)
+      }
+    }
+    if (typeof step.Scene !== 'function' && typeof step.Scene !== 'object') {
+      throw new Error(`Step "${step.id}" is missing its Scene`)
+    }
+    if (seen.has(step.id)) throw new Error(`Duplicate step id "${step.id}"`)
+    seen.add(step.id)
+  })
+}
+
+export interface Era {
+  label: string
+  firstIndex: number
+  indices: number[]
+}
+
+/** Groups consecutive steps that share an era label, in step order. */
+export function computeEras(steps: readonly { era: string }[]): Era[] {
+  const eras: Era[] = []
+  steps.forEach((step, index) => {
+    const last = eras[eras.length - 1]
+    if (last && last.label === step.era) last.indices.push(index)
+    else eras.push({ label: step.era, firstIndex: index, indices: [index] })
+  })
+  return eras
+}
+
+/** On-screen marker derived from position, never stored. */
+export function stepMarker(index: number): string {
+  return String(index + 1).padStart(2, '0')
+}
