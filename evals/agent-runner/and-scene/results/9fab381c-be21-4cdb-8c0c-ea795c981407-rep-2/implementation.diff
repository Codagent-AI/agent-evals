diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c6c3f8c01168a02e86124cef5b8ca4fafdd3da37
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,64 @@
+import { useMemo, type ReactNode } from 'react'
+import { Attribution } from './chrome/Attribution.tsx'
+import { Footer } from './chrome/Footer.tsx'
+import { Header } from './chrome/Header.tsx'
+import { Toc } from './chrome/Toc.tsx'
+import { Stage } from './Stage.tsx'
+import { computeEras, validateSteps } from './steps.ts'
+import { isWideViewport, useViewport } from './useFitScale.ts'
+import { usePresentationNav } from './usePresentationNav.ts'
+import type { AttributionOptions, DesignSize, Mode, Step, StepMeta } from './types.ts'
+
+export interface PresentationProps<P> {
+  steps: readonly Step<P>[]
+  title: string
+  initialMode?: Mode
+  /** Host-provided header brand; the kit renders none by default. */
+  brand?: ReactNode
+  /** Override the attribution link, or pass `false` to omit it. */
+  attribution?: AttributionOptions | false
+  design?: DesignSize
+}
+
+/** Stage + chrome + navigation for an ordered list of scene steps. */
+export function Presentation<P>({
+  steps,
+  title,
+  initialMode = 'browse',
+  brand,
+  attribution,
+  design,
+}: PresentationProps<P>) {
+  validateSteps(steps)
+  const { index, mode, next, prev, goTo } = usePresentationNav(steps.length, initialMode)
+  const { width } = useViewport()
+  const eras = useMemo(() => computeEras(steps), [steps])
+  const titles = useMemo(() => steps.map((s) => s.title), [steps])
+  const step = steps[index]
+  const meta: StepMeta = {
+    id: step.id,
+    index,
+    count: steps.length,
+    era: step.era,
+    title: step.title,
+    caption: step.caption,
+  }
+  return (
+    <div
+      data-presentation-root=""
+      data-presentation-title-text={title}
+      data-presentation-mode={mode}
+      data-step-count={steps.length}
+      data-step-index={index}
+      style={{ position: 'fixed', left: 0, top: 0, right: 0, bottom: 0, overflow: 'hidden' }}
+    >
+      <Header meta={meta} mode={mode} brand={brand} />
+      {mode === 'browse' && isWideViewport(width) ? (
+        <Toc eras={eras} activeIndex={index} onJump={goTo} />
+      ) : null}
+      <Stage step={step} meta={meta} mode={mode} design={design} />
+      <Footer meta={meta} mode={mode} titles={titles} onPrev={prev} onNext={next} onJump={goTo} />
+      {attribution === false ? null : <Attribution {...attribution} />}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c63375f575e2a392a4ad95339473597aa2230527
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,74 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { useState, type ComponentType } from 'react'
+import { sceneKey } from './sceneKey.ts'
+import { DESIGN_H, DESIGN_W, ENTER_T, STAGE_LAYOUT } from './constants.ts'
+import { reservedSide, useFitScale, useViewport } from './useFitScale.ts'
+import type { DesignSize, Mode, SceneProps, Step, StepMeta } from './types.ts'
+
+const DEFAULT_DESIGN: DesignSize = { width: DESIGN_W, height: DESIGN_H }
+
+interface StageProps<P> {
+  step: Step<P>
+  meta: StepMeta
+  mode: Mode
+  design?: DesignSize
+}
+
+/** Fixed design canvas scaled to fit, hosting the active step's scene. */
+export function Stage<P>({ step, meta, mode, design = DEFAULT_DESIGN }: StageProps<P>) {
+  const scale = useFitScale(mode, design)
+  const { width: viewportWidth } = useViewport()
+  const { top, bottom } = STAGE_LAYOUT[mode]
+  const Scene = step.Scene as ComponentType<SceneProps<P>>
+  const key = sceneKey(step)
+  // Remember the step shown before this one while the same scene instance continues.
+  const [track, setTrack] = useState({ id: step.id, key, payload: step.payload, previous: undefined as P | undefined })
+  if (track.id !== step.id) {
+    setTrack({ id: step.id, key, payload: step.payload, previous: track.key === key ? track.payload : undefined })
+  }
+  const previous = track.id === step.id ? track.previous : track.key === key ? track.payload : undefined
+  return (
+    <div
+      data-presentation-stage=""
+      style={{
+        position: 'absolute',
+        top,
+        bottom,
+        left: reservedSide(mode, viewportWidth),
+        right: 0,
+        overflow: 'hidden',
+      }}
+    >
+      <motion.div
+        data-presentation-canvas=""
+        layoutRoot
+        style={{
+          position: 'absolute',
+          // Centre with calc() offsets: a percentage `x`/`y` translate here makes layout
+          // projection mis-measure every morph inside the scaled canvas.
+          left: `calc(50% - ${design.width / 2}px)`,
+          top: `calc(50% - ${design.height / 2}px)`,
+          width: design.width,
+          height: design.height,
+          scale,
+        }}
+      >
+        <LayoutGroup>
+          <AnimatePresence initial={false}>
+            <motion.div
+              key={key}
+              data-presentation-scene=""
+              initial={{ opacity: 0 }}
+              animate={{ opacity: 1 }}
+              exit={{ opacity: 0 }}
+              transition={{ duration: ENTER_T }}
+              style={{ position: 'absolute', left: 0, top: 0, width: '100%', height: '100%' }}
+            >
+              <Scene payload={step.payload} previous={previous} step={meta} />
+            </motion.div>
+          </AnimatePresence>
+        </LayoutGroup>
+      </motion.div>
+    </div>
+  )
+}
diff --git a/src/presentation-kit/chrome/Attribution.tsx b/src/presentation-kit/chrome/Attribution.tsx
