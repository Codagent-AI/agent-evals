--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/config.mjs
@@ -0,0 +1,58 @@
+import fs from 'node:fs'
+import path from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { VerifyError } from './verify-core.mjs'
+
+export const CONFIG_FILE = 'presentation.config.json'
+
+/**
+ * `referenceSample` is either `null` (the project explicitly has no reference
+ * sample) or `{ slug, outline, stepsModule }`. A missing config or a missing
+ * `referenceSample` key is an error, so the outline check can never be dropped
+ * silently.
+ */
+export function loadConfig(root) {
+  const file = path.join(root, CONFIG_FILE)
+  if (!fs.existsSync(file)) throw new VerifyError('config', `${CONFIG_FILE} is missing`)
+  let config
+  try {
+    config = JSON.parse(fs.readFileSync(file, 'utf8'))
+  } catch (error) {
+    throw new VerifyError('config', `${CONFIG_FILE} is not valid JSON: ${error.message}`)
+  }
+  if (!('referenceSample' in config)) {
+    throw new VerifyError('config', `${CONFIG_FILE} must declare "referenceSample" (use null for none)`)
+  }
+  return config
+}
+
+export async function loadRegistry(root) {
+  const file = path.join(root, 'src', 'presentations', 'index.ts')
+  if (!fs.existsSync(file)) throw new VerifyError('sample-outline', 'src/presentations/index.ts is missing')
+  try {
+    const mod = await import(`${pathToFileURL(file).href}?t=${Date.now()}`)
+    return mod.presentations
+  } catch (error) {
+    throw new VerifyError('sample-outline', `cannot read the presentation registry: ${error.message}`)
+  }
+}
+
+export async function loadActualOutline(root, reference) {
+  const file = path.join(root, reference.stepsModule)
+  try {
+    const mod = await import(`${pathToFileURL(file).href}?t=${Date.now()}`)
+    return { title: mod.TITLE, steps: mod.OUTLINE }
+  } catch (error) {
+    throw new VerifyError('sample-outline', `cannot read sample steps from ${reference.stepsModule}: ${error.message}`)
+  }
+}
+
+export function loadReferenceOutline(root, reference) {
+  const file = path.join(root, reference.outline)
+  if (!fs.existsSync(file)) throw new VerifyError('sample-outline', `reference outline ${reference.outline} is missing`)
+  try {
+    return JSON.parse(fs.readFileSync(file, 'utf8'))
+  } catch (error) {
+    throw new VerifyError('sample-outline', `reference outline ${reference.outline} is malformed: ${error.message}`)
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/diagnostics.mjs b/skills/presentation/templates/bootstrap/scripts/lib/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3144c28a035290b661605ca93bcbc260eb4d9aee
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/diagnostics.mjs
@@ -0,0 +1,110 @@
+// Pure helpers behind the screenshot helper's advisory warnings.
+import fs from 'node:fs'
+import path from 'node:path'
+
+export const MIN_OVERLAP_AREA = 4 // px², intersections at or below this are ignored
+export const MIN_ATTRIBUTION_FONT_PX = 11
+export const BROWSER_DEFAULT_LINK_COLOR = 'rgb(0, 0, 238)'
+export const DEFAULT_SETTLE_MS = 1200
+
+export function intersectionArea(a, b) {
+  const w = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x)
+  const h = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y)
+  return w > 0 && h > 0 ? w * h : 0
+}
+
+/**
+ * `items`: visible text/chrome elements as `{ id, rect, allowed }`, where `rect` is the
+ * element's own text range. An item that paints a background or border also has `cover`,
+ * its box, `within`, the indices of items that contain it, and `above`, the indices of
+ * items whose text it is painted over. `allowed` is true inside a
+ * `data-presentation-allow-overlap` subtree. Only the explicit marker exempts a pair:
+ * nested elements are measured by their own text ranges, so a nested collision is as
+ * suspicious as any other. A painted box hiding another item's text is a collision too,
+ * except for text inside that box, which it contains by construction, and text painted
+ * on top of the box.
+ */
+function coverArea(a, b) {
+  if (!a.cover || (b.within ?? []).includes(a.index) || !(a.above ?? []).includes(b.index)) return 0
+  return intersectionArea(a.cover, b.rect)
+}
+
+export function overlapWarnings(items, step) {
+  const warnings = []
+  for (let i = 0; i < items.length; i++) {
+    for (let j = i + 1; j < items.length; j++) {
+      const a = items[i]
+      const b = items[j]
+      if (a.allowed || b.allowed) continue
+      const direct = intersectionArea(a.rect, b.rect)
+      const covered = Math.max(coverArea(a, b), coverArea(b, a))
+      const area = Math.max(direct, covered)
+      if (area > MIN_OVERLAP_AREA) {
+        const verb = direct > MIN_OVERLAP_AREA ? 'overlaps' : 'covers or is covered by'
+        warnings.push({ step, kind: 'overlap', message: `${a.id} ${verb} ${b.id} (${Math.round(area)}px²); fix it or mark an intentional overlap with data-presentation-allow-overlap` })
+      }
+    }
+  }
+  return warnings
+}
+
+const ACTIVE_FIELDS = ['color', 'backgroundColor', 'borderColor', 'borderWidth', 'opacity', 'width', 'height', 'fontWeight']
+
+/** True when the active control differs from an inactive one in any compared style. */
+export function activeIsDistinct(active, inactive) {
+  return ACTIVE_FIELDS.some((field) => active[field] !== inactive[field])
+}
+
+/** `chrome`: `[{ name, active, inactive }]` style snapshots; `inactive` may be null. */
+export function activeChromeWarnings(chrome, step) {
+  return chrome
+    .filter((c) => c.active && c.inactive && !activeIsDistinct(c.active, c.inactive))
+    .map((c) => ({
+      step,
+      kind: 'active-chrome',
+      message: `active ${c.name} looks identical to inactive ones; style [data-presentation-active="true"]`,
+    }))
+}
+
+export function attributionWarnings(attribution, step) {
+  const hook = 'data-presentation-attribution'
+  if (!attribution) {
+    return [{ step, kind: 'attribution', message: `attribution link is missing; the kit renders [${hook}]` }]
+  }
+  const warnings = []
+  if (attribution.fontSizePx < MIN_ATTRIBUTION_FONT_PX) {
+    warnings.push({ step, kind: 'attribution', message: `attribution text is ${attribution.fontSizePx}px, under ${MIN_ATTRIBUTION_FONT_PX}px; style [${hook}]` })
+  }
+  if (attribution.color === BROWSER_DEFAULT_LINK_COLOR && /underline/.test(attribution.textDecoration)) {
+    warnings.push({ step, kind: 'attribution', message: `attribution still has the browser-default link look; style [${hook}]` })
+  }
+  return warnings
+}
+
+const SLUG = /^[a-z0-9]+(-[a-z0-9]+)*$/
+
+/** Output directory for a slug; refuses anything that could leave `<root>/inspection`. */
+export function inspectionDir(root, slug, narrow = false) {
+  if (!SLUG.test(slug)) throw new Error(`invalid presentation slug "${slug}": use lowercase words joined by hyphens`)
+  const base = path.resolve(root, 'inspection')
+  const dir = path.resolve(base, slug + (narrow ? '-narrow' : ''))
+  if (!dir.startsWith(base + path.sep)) throw new Error(`refusing to write outside ${base}`)
+  // A symlinked inspection/ would make the recursive delete follow it out of the project.
+  if (fs.existsSync(base) && fs.lstatSync(base).isSymbolicLink()) {
+    throw new Error(`refusing to use ${base}: it is a symlink`)
+  }
+  return dir
+}
+
+export function stepFileName(index) {
+  return `step-${String(index + 1).padStart(2, '0')}.png`
+}
+
+export function formatWarning(w) {
+  return `WARN step ${String(w.step + 1).padStart(2, '0')} ${w.kind}: ${w.message}`
+}
+
+/** Warnings are advisory: only operational failures change the exit status. */
+export function inspectExitCode({ failure }) {
+  return failure ? 1 : 0
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/loopback.mjs b/skills/presentation/templates/bootstrap/scripts/lib/loopback.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5d74a3c43e18c65d9d11538bf8d011219780d5f1
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/loopback.mjs
@@ -0,0 +1,19 @@
+import net from 'node:net'
+
+/** Verification and inspection never rely on how `localhost` resolves. */
+export const HOST = '127.0.0.1'
+
+export function previewUrl(port, pathname = '/') {
+  return `http://${HOST}:${port}${pathname}`
+}
+
+export function freePort() {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer()
+    server.once('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/page-snapshot.mjs b/skills/presentation/templates/bootstrap/scripts/lib/page-snapshot.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..07017eb9e4b571b4bfda3c79d319416103b66cf4
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/page-snapshot.mjs
@@ -0,0 +1,129 @@
+/**
+ * Runs inside the page (serialized by Playwright), so it must be self-contained.
+ * Collects the visible text/chrome boxes and the style snapshots the pure
+ * diagnostics compare.
+ */
+export function snapshotPage() {
+  const CHROME =
+    '[data-presentation-dot],[data-presentation-toc-entry],[data-presentation-prev],[data-presentation-next],[data-presentation-attribution],[data-presentation-marker]'
+  const visible = (el) => {
+    const s = getComputedStyle(el)
+    return s.display !== 'none' && s.visibility !== 'hidden' && Number(s.opacity) > 0.01
+  }
+  const label = (el) => {
+    const hook = [...el.attributes].find((a) => a.name.startsWith('data-role') || a.name.startsWith('data-presentation-'))
+    const text = (el.textContent ?? '').trim().replace(/\s+/g, ' ').slice(0, 30)
+    return `<${el.tagName.toLowerCase()}${hook ? ` ${hook.name}${hook.value ? `="${hook.value}"` : ''}` : ''}>${text ? ` "${text}"` : ''}`
+  }
+  const ownTextRect = (el) => {
+    const range = document.createRange()
+    let box = null
+    for (const node of el.childNodes) {
+      if (node.nodeType !== Node.TEXT_NODE || !node.textContent.trim()) continue
+      range.selectNodeContents(node)
+      for (const r of range.getClientRects()) {
+        if (r.width === 0 || r.height === 0) continue
+        box = box
+          ? { x1: Math.min(box.x1, r.left), y1: Math.min(box.y1, r.top), x2: Math.max(box.x2, r.right), y2: Math.max(box.y2, r.bottom) }
+          : { x1: r.left, y1: r.top, x2: r.right, y2: r.bottom }
+      }
+    }
+    return box && { x: box.x1, y: box.y1, w: box.x2 - box.x1, h: box.y2 - box.y1 }
+  }
+  const candidates = new Map()
+  for (const el of document.body.querySelectorAll('*')) {
+    if (!visible(el)) continue
+    const rect = ownTextRect(el)
+    if (rect) candidates.set(el, rect)
+  }
+  for (const el of document.querySelectorAll(CHROME)) {
+    if (!visible(el) || candidates.has(el)) continue
+    const r = el.getBoundingClientRect()
+    if (r.width > 0 && r.height > 0) candidates.set(el, { x: r.left, y: r.top, w: r.width, h: r.height })
+  }
+  // An element that paints a background or border also hides whatever lies under its box,
+  // even where its own text does not reach.
+  const paintsBox = (el) => {
+    const s = getComputedStyle(el)
+    const bg = /^rgba?\(([^)]*)\)$/.exec(s.backgroundColor)
+    const alpha = bg ? (bg[1].split(/[,/]/).length > 3 ? Number(bg[1].split(/[,/]/)[3]) : 1) : 0
+    return alpha > 0.05 || (parseFloat(s.borderTopWidth) > 0 && s.borderTopStyle !== 'none')
+  }
+  const entries = [...candidates]
+  const items = entries.map(([el, rect], index) => {
+    const box = el.getBoundingClientRect()
+    return {
+      id: label(el),
+      index,
+      rect,
+      cover: paintsBox(el) && box.width > 0 && box.height > 0 ? { x: box.left, y: box.top, w: box.width, h: box.height } : null,
+      within: entries.flatMap(([other], i) => (other !== el && other.contains(el) ? [i] : [])),
+      above: [],
+      allowed: el.closest('[data-presentation-allow-overlap]') !== null,
+    }
+  })
+  // A box only hides text painted beneath it. Hit-testing decides when it can; it skips
+  // `pointer-events: none` elements and off-screen points, so fall back to z-index, then
+  // document order (later siblings paint on top).
+  const zIndex = (el) => Number.parseInt(getComputedStyle(el).zIndex, 10) || 0
+  const paintedAbove = (boxEl, textEl, stack) => {
+    const top = stack.indexOf(boxEl)
+    const under = stack.indexOf(textEl)
+    if (top >= 0 && under >= 0) return top < under
+    if (top >= 0) return true
+    if (zIndex(boxEl) !== zIndex(textEl)) return zIndex(boxEl) > zIndex(textEl)
+    return (textEl.compareDocumentPosition(boxEl) & Node.DOCUMENT_POSITION_FOLLOWING) !== 0
+  }
+  for (const a of items) {
+    if (!a.cover) continue
+    for (const b of items) {
+      if (b === a || b.within.includes(a.index)) continue
+      const x1 = Math.max(a.cover.x, b.rect.x)
+      const y1 = Math.max(a.cover.y, b.rect.y)
+      const x2 = Math.min(a.cover.x + a.cover.w, b.rect.x + b.rect.w)
+      const y2 = Math.min(a.cover.y + a.cover.h, b.rect.y + b.rect.h)
+      if (x2 <= x1 || y2 <= y1) continue
+      const stack = document.elementsFromPoint((x1 + x2) / 2, (y1 + y2) / 2)
+      if (paintedAbove(entries[a.index][0], entries[b.index][0], stack)) a.above.push(b.index)
+    }
+  }
+
+  // Text entries size to their label, so their box size says nothing about styling.
+  const style = (el, includeSize) => {
+    const s = getComputedStyle(el)
+    return {
+      color: s.color,
+      backgroundColor: s.backgroundColor,
+      borderColor: s.borderTopColor,
+      borderWidth: s.borderTopWidth,
+      opacity: s.opacity,
+      width: includeSize ? s.width : '',
+      height: includeSize ? s.height : '',
+      fontWeight: s.fontWeight,
+    }
+  }
+  const chromeKinds = [
+    ['progress indicator', '[data-presentation-dot]', true],
+    ['table-of-contents entry', '[data-presentation-toc-entry]', false],
+  ]
+  const chrome = chromeKinds.map(([name, selector, includeSize]) => {
+    const all = [...document.querySelectorAll(selector)]
+    const active = all.find((e) => e.getAttribute('data-presentation-active') === 'true')
+    const inactive = all.find((e) => e !== active)
+    return { name, active: active ? style(active, includeSize) : null, inactive: inactive ? style(inactive, includeSize) : null }
+  })
+  const a = document.querySelector('[data-presentation-attribution]')
+  const attribution = a
+    ? (() => {
+        const s = getComputedStyle(a)
+        return { fontSizePx: parseFloat(s.fontSize), color: s.color, textDecoration: s.textDecorationLine }
+      })()
+    : null
+  const root = document.querySelector('[data-step-count]')
+  return {
+    count: root ? Number(root.getAttribute('data-step-count')) : 0,
+    items,
+    chrome,
+    attribution,
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/preview.mjs b/skills/presentation/templates/bootstrap/scripts/lib/preview.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9981d00c92157813aa226848167828e958807bca
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/preview.mjs
@@ -0,0 +1,51 @@
+import { spawn } from 'node:child_process'
+import path from 'node:path'
+import { HOST, freePort, previewUrl } from './loopback.mjs'
+
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
+
+async function waitReady(url, child, timeoutMs) {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    if (child.exitCode !== null) throw new Error(`preview server exited with code ${child.exitCode}`)
+    try {
+      const res = await fetch(url)
+      if (res.ok) return
+    } catch {
+      /* not listening yet */
+    }
+    await sleep(100)
+  }
+  throw new Error(`preview server did not become ready at ${url}`)
+}
+
+/** Starts `vite preview` on the IPv4 loopback address. Always call `stop()`. */
+export async function startPreview(root, { readyTimeoutMs = 20000 } = {}) {
+  const port = await freePort()
+  const vite = path.join(root, 'node_modules', 'vite', 'bin', 'vite.js')
+  const child = spawn(process.execPath, [vite, 'preview', '--host', HOST, '--port', String(port), '--strictPort'], {
+    cwd: root,
+    detached: true,
+    stdio: 'ignore',
+  })
+  const exited = new Promise((resolve) => child.once('exit', resolve))
+  const stop = async () => {
+    // The launcher may exit while its server lives on, so always signal the group.
+    for (const signal of ['SIGTERM', 'SIGKILL']) {
+      try {
+        process.kill(process.platform === 'win32' ? child.pid : -child.pid, signal)
+      } catch (error) {
+        if (error.code !== 'ESRCH') throw error
+        return
+      }
+      if ((await Promise.race([exited.then(() => true), sleep(2000).then(() => false)]))) return
+    }
+  }
+  try {
+    await waitReady(previewUrl(port), child, readyTimeoutMs)
+  } catch (error) {
+    await stop()
+    throw error
+  }
+  return { port, pid: child.pid, url: (pathname) => previewUrl(port, pathname), stop }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/render.mjs b/skills/presentation/templates/bootstrap/scripts/lib/render.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9e244ce215e3c55331d870d325d06e8960584b22
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/render.mjs
@@ -0,0 +1,91 @@
+import { VerifyError, normalize } from './verify-core.mjs'
+
+// Longer than an entrance: ENTER_DELAY (0.65s) + ENTER_T (0.4s) in the scene kit.
+const SETTLE_MS = 1300
+
+/** Records console errors and uncaught page errors; install before navigating. */
+export function collectBrowserErrors(page) {
+  const errors = []
+  page.on('console', (msg) => {
+    if (msg.type() === 'error') errors.push(`console error: ${msg.text()}`)
+  })
+  page.on('pageerror', (error) => errors.push(`uncaught page error: ${error.message}`))
+  return errors
+}
+
+async function readState(page) {
+  return page.evaluate(() => {
+    const root = document.querySelector('[data-step-count]')
+    if (!root) return null
+    const text = (sel) => document.querySelector(sel)?.textContent ?? ''
+    const mode = root.getAttribute('data-presentation-mode')
+    return {
+      count: Number(root.getAttribute('data-step-count')),
+      index: Number(root.getAttribute('data-step-index')),
+      title: text(mode === 'present' ? '[data-presentation-title]' : '[data-presentation-header-title]'),
+      caption: text('[data-presentation-caption]'),
+      mode,
+    }
+  })
+}
+
+/** Polls the public step hooks until `data-step-index` equals `expected`. */
+async function waitForIndex(page, expected, timeoutMs, errors, onTimeout) {
+  const deadline = Date.now() + timeoutMs
+  let state = null
+  while (Date.now() < deadline) {
+    state = await readState(page)
+    if (state && state.index === expected) return state
+    // A thrown render error is the cause of a step that never appears: report it, not the symptom.
+    if (errors.length > 0) throw new VerifyError('render', errors[0], { step: expected })
+    await page.waitForTimeout(50)
+  }
+  throw new VerifyError('render', errors[0] ?? onTimeout(state), { step: expected })
+}
+
+/**
+ * Opens one route and steps through it. Error listeners are installed by the
+ * caller before navigation and stay attached for the whole run; `errors` is
+ * the shared list they append to.
+ */
+export async function renderRoute({ page, url, allSteps, reference, errors, timeoutMs, log }) {
+  const check = (step) => {
+    if (errors.length > 0) throw new VerifyError('render', errors[0], { step })
+  }
+  // `errors` is never cleared: anything that arrived since the last check, even
+  // after the previous route returned, fails the run instead of being discarded.
+  await page.goto(url, { waitUntil: 'load' })
+  const first = await waitForIndex(page, 0, timeoutMs, errors, (s) =>
+    s ? `step hooks report index ${s.index}, expected 0` : 'no [data-step-count] hook rendered (the route did not render a presentation)',
+  )
+  const count = first.count
+  if (!(count >= 1)) throw new VerifyError('render', `data-step-count is ${count}`, { step: 0 })
+  if (reference && count !== reference.steps.length) {
+    throw new VerifyError('render', `renders ${count} steps, reference has ${reference.steps.length}`, { step: 0 })
+  }
+  const last = allSteps ? count - 1 : 0
+  for (let i = 0; i <= last; i++) {
+    const state =
+      i === 0
+        ? first
+        : await (async () => {
+            await page.keyboard.press('ArrowRight')
+            return waitForIndex(page, i, timeoutMs, errors, (s) =>
+              `transition did not advance: data-step-index is ${s ? s.index : 'missing'}, expected ${i} within ${timeoutMs}ms`,
+            )
+          })()
+    if (reference) {
+      const want = reference.steps[i]
+      if (normalize(state.title) !== normalize(want.title)) {
+        throw new VerifyError('render', `rendered title "${state.title}", expected "${want.title}"`, { step: i })
+      }
+      if (state.mode === 'browse' && normalize(state.caption) !== normalize(want.caption)) {
+        throw new VerifyError('render', `rendered caption "${state.caption}", expected "${want.caption}"`, { step: i })
+      }
+    }
+    await page.waitForTimeout(SETTLE_MS)
+    check(i)
+    log(`  step index ${i} ok (${i + 1}/${count})`)
+  }
+  return { count, rendered: last + 1 }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/verify-core.mjs b/skills/presentation/templates/bootstrap/scripts/lib/verify-core.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..271b5129f46fb09b4cc87c2725055c0751d4560d
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/verify-core.mjs
@@ -0,0 +1,66 @@
+/** A verification failure that names the failed phase and, for browser faults, the step. */
+export class VerifyError extends Error {
+  constructor(phase, message, { step } = {}) {
+    super(message)
+    this.phase = phase
+    this.step = step
+  }
+}
+
+export const DEFAULT_STEP_TIMEOUT_MS = 5000
+
+export function parseArgs(argv, env = {}) {
+  const args = { slug: undefined, timeoutMs: Number(env.VERIFY_STEP_TIMEOUT_MS) || DEFAULT_STEP_TIMEOUT_MS }
+  for (const arg of argv) {
+    if (arg.startsWith('--timeout=')) args.timeoutMs = Number(arg.slice('--timeout='.length))
+    else if (arg.startsWith('-')) throw new VerifyError('arguments', `unknown option ${arg}`)
+    else args.slug = arg
+  }
+  return args
+}
+
+const normalize = (text) => String(text).replace(/\s+/g, ' ').trim()
+export { normalize }
+
+/** Compares sample step data with the reference outline; returns every mismatch. */
+export function compareOutline(actual, expected) {
+  const errors = []
+  if (normalize(actual.title ?? '') !== normalize(expected.title)) {
+    errors.push(`sample title is "${actual.title}", expected "${expected.title}"`)
+  }
+  const steps = actual.steps ?? []
+  if (steps.length !== expected.steps.length) {
+    errors.push(`sample has ${steps.length} steps, expected ${expected.steps.length}`)
+  }
+  expected.steps.forEach((want, i) => {
+    const got = steps[i]
+    if (!got) return
+    for (const field of ['era', 'title', 'caption']) {
+      if (normalize(got[field] ?? '') !== normalize(want[field])) {
+        errors.push(`step ${i + 1} ${field} is "${got[field]}", expected "${want[field]}"`)
+      }
+    }
+  })
+  return errors
+}
+
+/**
+ * Which routes to render. The sample runs through every step; any other
+ * registered presentation renders its first step. A slug limits the run to it.
+ */
+/** @param {{ registry: { slug: string }[], sampleSlug?: string, only?: string }} options */
+export function selectRoutes({ registry, sampleSlug, only }) {
+  const entries = only ? registry.filter((e) => e.slug === only) : registry
+  if (only && entries.length === 0) {
+    throw new VerifyError('render', `no registered presentation has slug "${only}"`)
+  }
+  return entries.map((e) => ({ slug: e.slug, allSteps: e.slug === sampleSlug }))
+}
+
+export function formatFailure(error) {
+  if (error instanceof VerifyError) {
+    const step = error.step === undefined ? '' : ` (step index ${error.step}, step ${error.step + 1})`
+    return `VERIFY FAILED: ${error.phase}${step}: ${error.message}`
+  }
+  return `VERIFY FAILED: internal: ${error instanceof Error ? error.message : String(error)}`
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/verify.mjs b/skills/presentation/templates/bootstrap/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5647eb325413c1194007101cf18dc5364aa683ba
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/verify.mjs
@@ -0,0 +1,85 @@
+#!/usr/bin/env node
+// Build the whole app, check the reference sample's outline, then render the
+// registered presentations in Chromium against a production preview.
+import { spawnSync } from 'node:child_process'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { chromium } from 'playwright'
+import {
+  loadActualOutline,
+  loadConfig,
+  loadReferenceOutline,
+  loadRegistry,
+} from './lib/config.mjs'
+import { startPreview } from './lib/preview.mjs'
+import { collectBrowserErrors, renderRoute } from './lib/render.mjs'
+import { compareOutline, formatFailure, parseArgs, selectRoutes, VerifyError } from './lib/verify-core.mjs'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const log = (line) => console.log(line)
+
+function build() {
+  log('[build] npm run build')
+  const result = spawnSync('npm', ['run', 'build'], { cwd: root, encoding: 'utf8', shell: process.platform === 'win32' })
+  if (result.status !== 0) {
+    process.stdout.write(`${result.stdout ?? ''}${result.stderr ?? ''}`)
+    throw new VerifyError('build', `npm run build failed with exit code ${result.status}`)
+  }
+}
+
+async function checkOutline(config, registry) {
+  const reference = config.referenceSample
+  if (reference === null) {
+    log('[sample-outline] skipped: presentation.config.json declares no reference sample')
+    return null
+  }
+  const expected = loadReferenceOutline(root, reference)
+  const entry = registry.find((e) => e.slug === reference.slug)
+  if (!entry) throw new VerifyError('sample-outline', `reference sample "${reference.slug}" is not registered`)
+  const errors = compareOutline({ ...(await loadActualOutline(root, reference)), title: entry.title }, expected)
+  if (errors.length > 0) throw new VerifyError('sample-outline', errors.join('; '))
+  log(`[sample-outline] ${expected.steps.length} steps match the reference outline`)
+  return expected
+}
+
+async function render({ config, registry, reference, args }) {
+  const routes = selectRoutes({ registry, sampleSlug: config.referenceSample?.slug, only: args.slug })
+  const preview = await startPreview(root)
+  log(`[render] preview ${preview.url('/')} pid=${preview.pid}`)
+  let browser
+  try {
+    browser = await chromium.launch()
+    const page = await browser.newPage()
+    const errors = collectBrowserErrors(page)
+    for (const route of routes) {
+      log(`[render] /${route.slug} (${route.allSteps ? 'all steps' : 'first step'})`)
+      await renderRoute({
+        page,
+        url: preview.url(`/${route.slug}`),
+        allSteps: route.allSteps,
+        reference: route.allSteps ? reference : null,
+        errors,
+        timeoutMs: args.timeoutMs,
+        log,
+      })
+    }
+    await page.waitForTimeout(300)
+    if (errors.length > 0) throw new VerifyError('render', errors[0], { step: 0 })
+  } finally {
+    await browser?.close().catch(() => {})
+    await preview.stop()
+  }
+}
+
+try {
+  const args = parseArgs(process.argv.slice(2), process.env)
+  const config = loadConfig(root)
+  build()
+  const registry = await loadRegistry(root)
+  const reference = await checkOutline(config, registry)
+  await render({ config, registry, reference, args })
+  log('VERIFY PASSED')
+} catch (error) {
+  console.error(formatFailure(error))
+  process.exitCode = 1
+}
