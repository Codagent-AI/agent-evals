+import type { Mode } from './types.ts'
+
+/** Default fixed design canvas. Entities are composed in these coordinates. */
+export const DESIGN_W = 880
+export const DESIGN_H = 380
+
+/** Lowest fit scale; keeps the canvas finite and positive on tiny viewports. */
+export const MIN_SCALE = 0.25
+
+export const EASE = [0.22, 1, 0.36, 1] as const
+
+/** Seconds a persisting entity takes to move to its new layout. */
+export const LAYOUT_T = 0.6
+/** Seconds a newcomer takes to fade in. */
+export const ENTER_T = 0.4
+/** Transition applied to entity layout moves; its duration is `LAYOUT_T`. */
+export const LAYOUT_TRANSITION = { layout: { duration: LAYOUT_T, ease: EASE } } as const
+/** Newcomers wait this long so persisting entities settle first. */
+export const ENTER_DELAY = 0.65
+
+/** Viewport width (px) from which the table of contents is shown. */
+export const WIDE_VIEWPORT_MIN = 900
+/** Minimum horizontal travel (px) of a swipe. */
+export const SWIPE_MIN_PX = 50
+
+/**
+ * Per-mode geometry reserved around the canvas, in px. `top`/`bottom` hold the
+ * header and footer; `side` holds the table of contents on wide viewports.
+ */
+export const STAGE_LAYOUT: Record<Mode, { top: number; bottom: number; side: number }> = {
+  browse: { top: 56, bottom: 196, side: 220 },
+  present: { top: 56, bottom: 88, side: 0 },
+}
+
+export const DEFAULT_ATTRIBUTION = {
+  label: 'made by and-scene',
+  href: 'https://github.com/Codagent-AI/and-scene',
+} as const
diff --git a/src/presentation-kit/geometry.ts b/src/presentation-kit/geometry.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7dcffbcf0c2728cd39b61a3ec92a3498e75203fc
--- /dev/null
+++ b/src/presentation-kit/geometry.ts
@@ -0,0 +1,49 @@
+import type { CSSProperties } from 'react'
+import type { Point, Rect } from './types.ts'
+
+/** Absolute placement inside the design canvas. Geometry only, no look. */
+export function rectStyle(rect?: Rect): CSSProperties {
+  if (!rect) return {}
+  return { position: 'absolute', left: rect.x, top: rect.y, width: rect.w, height: rect.h }
+}
+
+export interface ArrowGeometry {
+  path: string
+  /** Triangle points at `to`, pointing along the final tangent. */
+  head: string
+  /** Triangle points at `from`, pointing backwards; present for two-way arrows. */
+  tail: string | null
+}
+
+const HEAD_LEN = 10
+const HEAD_HALF = 5
+
+function triangle(tip: Point, toward: Point): string {
+  const dx = tip.x - toward.x
+  const dy = tip.y - toward.y
+  const len = Math.hypot(dx, dy) || 1
+  const ux = dx / len
+  const uy = dy / len
+  const bx = tip.x - ux * HEAD_LEN
+  const by = tip.y - uy * HEAD_LEN
+  const l = `${bx - uy * HEAD_HALF},${by + ux * HEAD_HALF}`
+  const r = `${bx + uy * HEAD_HALF},${by - ux * HEAD_HALF}`
+  return `${tip.x},${tip.y} ${l} ${r}`
+}
+
+/** Straight (or quadratic when `via` is given) arrow path with head triangles. */
+export function arrowGeometry(
+  from: Point,
+  to: Point,
+  via?: Point,
+  bidirectional = false,
+): ArrowGeometry {
+  const path = via
+    ? `M ${from.x} ${from.y} Q ${via.x} ${via.y} ${to.x} ${to.y}`
+    : `M ${from.x} ${from.y} L ${to.x} ${to.y}`
+  return {
+    path,
+    head: triangle(to, via ?? from),
+    tail: bidirectional ? triangle(from, via ?? to) : null,
+  }
+}
