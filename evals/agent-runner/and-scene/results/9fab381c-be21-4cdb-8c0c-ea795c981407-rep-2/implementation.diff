diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e0c574ec30a4e1a2d7d26aa10686963a7b82b757
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,42 @@
+import { useEffect, useState } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT, WIDE_VIEWPORT_MIN } from './constants.ts'
+import type { DesignSize, Mode } from './types.ts'
+
+export function isWideViewport(width: number): boolean {
+  return width >= WIDE_VIEWPORT_MIN
+}
+
+/** Horizontal space the table of contents reserves, in px. */
+export function reservedSide(mode: Mode, viewportWidth: number): number {
+  return mode === 'browse' && isWideViewport(viewportWidth) ? STAGE_LAYOUT.browse.side : 0
+}
+
+/** Uniform scale that fits the design canvas into the space the chrome leaves. */
+export function computeFitScale(
+  viewportWidth: number,
+  viewportHeight: number,
+  mode: Mode,
+  design: DesignSize = { width: DESIGN_W, height: DESIGN_H },
+): number {
+  const { top, bottom } = STAGE_LAYOUT[mode]
+  const availW = Math.max(viewportWidth - reservedSide(mode, viewportWidth), 0)
+  const availH = Math.max(viewportHeight - top - bottom, 0)
+  const scale = Math.min(availW / design.width, availH / design.height)
+  return Number.isFinite(scale) ? Math.max(scale, MIN_SCALE) : MIN_SCALE
+}
+
+export function useViewport() {
+  const read = () => ({ width: window.innerWidth, height: window.innerHeight })
+  const [size, setSize] = useState(read)
+  useEffect(() => {
+    const onResize = () => setSize(read())
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return size
+}
+
+export function useFitScale(mode: Mode, design?: DesignSize) {
+  const { width, height } = useViewport()
+  return computeFitScale(width, height, mode, design)
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..99347f9f57973b780ab0e2bdb59d09359b9cc745
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,53 @@
+import { useCallback, useEffect, useState } from 'react'
+import { clampIndex, isInteractiveTarget, keyAction, swipeAction } from './nav.ts'
+import type { Mode } from './types.ts'
+
+/** Step index and mode state plus keyboard and touch navigation. */
+export function usePresentationNav(count: number, initialMode: Mode = 'browse', initialIndex = 0) {
+  const [rawIndex, setIndex] = useState(() => clampIndex(initialIndex, count))
+  const [mode, setMode] = useState<Mode>(initialMode)
+  // Steps may shrink while mounted; never point past the end.
+  const index = clampIndex(rawIndex, count)
+
+  const next = useCallback(() => setIndex((i) => clampIndex(clampIndex(i, count) + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(clampIndex(i, count) - 1, count)), [count])
+  const goTo = useCallback((i: number) => setIndex(clampIndex(i, count)), [count])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'browse' ? 'present' : 'browse')), [])
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey) return
+      if (isInteractiveTarget(e.target)) return
+      const action = keyAction(e.key)
+      if (!action) return
+      e.preventDefault()
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else toggleMode()
+    }
+    let start: { x: number; y: number } | null = null
+    const onStart = (e: TouchEvent) => {
+      const t = e.touches.length === 1 ? e.touches[0] : null
+      start = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onEnd = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      const from = start
+      start = null
+      if (!from || !t) return
+      const action = swipeAction(t.clientX - from.x, t.clientY - from.y)
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onStart, { passive: true })
+    window.addEventListener('touchend', onEnd, { passive: true })
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onStart)
+      window.removeEventListener('touchend', onEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, next, prev, goTo, setMode, toggleMode }
+}
