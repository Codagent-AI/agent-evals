diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/nav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/nav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ef24f260b5f039d3f10359fd1f587b50bfeb758e
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/nav.ts
@@ -0,0 +1,42 @@
+import { SWIPE_MIN_PX } from './constants.ts'
+
+const INTERACTIVE =
+  'button, a[href], input, select, textarea, summary, [contenteditable]:not([contenteditable="false"]), [role="button"]'
+
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE) !== null
+}
+
+export function clampIndex(index: number, count: number): number {
+  return Math.max(0, Math.min(index, count - 1))
+}
+
+export type NavAction = 'next' | 'prev' | 'toggle-mode'
+
+export function keyAction(key: string): NavAction | null {
+  switch (key) {
+    case 'ArrowRight':
+    case ' ':
+    case 'PageDown':
+      return 'next'
+    case 'ArrowLeft':
+    case 'PageUp':
+      return 'prev'
+    case 'p':
+    case 'P':
+      return 'toggle-mode'
+    default:
+      return null
+  }
+}
+
+/** Swipe left is next, swipe right is previous; short or vertical drags are ignored. */
+export function swipeAction(dx: number, dy: number): 'next' | 'prev' | null {
+  if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) <= Math.abs(dy)) return null
+  return dx < 0 ? 'next' : 'prev'
+}
+
+/** A pointer click leaves focus on the control, which would then keep the arrow keys. */
+export function releaseFocusAfterPointer(e: { detail: number; currentTarget: HTMLElement }): void {
+  if (e.detail > 0) e.currentTarget.blur()
+}
