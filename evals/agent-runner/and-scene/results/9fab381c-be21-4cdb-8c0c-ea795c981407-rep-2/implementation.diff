+  const page = Object.assign(emitter, {
+    goto: vi.fn(async () => {}),
+    evaluate: vi.fn(async () => states[Math.min(i, states.length - 1)]),
+    keyboard: {
+      press: vi.fn(async (k: string) => {
+        presses.push(k)
+        i++
+      }),
+    },
+    waitForTimeout: vi.fn(async (ms: number) => {
+      await new Promise((r) => setTimeout(r, Math.min(ms, 1)))
+    }),
+  })
