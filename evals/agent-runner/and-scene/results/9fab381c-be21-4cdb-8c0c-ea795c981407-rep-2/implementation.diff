+++ b/tests/unit/helpers/motionMock.tsx
@@ -0,0 +1,38 @@
+import { createElement, Fragment, type ReactNode } from 'react'
+
+const MOTION_PROPS = ['initial', 'animate', 'exit', 'transition', 'layout', 'layoutId', 'layoutRoot'] as const
+
+type AnyProps = Record<string, unknown>
+
+function motionElement(tag: string) {
+  return function MotionElement(props: AnyProps) {
+    const dom: AnyProps = { ...props }
+    const motion: AnyProps = {}
+    for (const key of MOTION_PROPS) {
+      if (key in dom) {
+        motion[key] = dom[key]
+        delete dom[key]
+      }
+    }
+    return createElement(tag, {
+      ...dom,
+      'data-layout-id': motion.layoutId as string | undefined,
+      'data-motion': JSON.stringify(motion),
+    })
+  }
+}
+
+/** Replaces `motion/react` so tests can read the motion props a component passes. */
+export const motionModule = {
+  motion: new Proxy({} as Record<string, ReturnType<typeof motionElement>>, {
+    get: (cache, tag: string) => (cache[tag] ??= motionElement(tag)),
+  }),
+  AnimatePresence: ({ children, ...rest }: { children?: ReactNode } & AnyProps) =>
+    createElement('div', { 'data-mock-presence': JSON.stringify(rest) }, children),
+  LayoutGroup: ({ children }: { children?: ReactNode }) =>
+    createElement(Fragment, null, createElement('div', { 'data-mock-layout-group': '' }, children)),
+}
+
+export function motionOf(el: Element): Record<string, unknown> {
+  return JSON.parse(el.getAttribute('data-motion') ?? '{}')
+}
diff --git a/tests/unit/helpers/styleScan.ts b/tests/unit/helpers/styleScan.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5ebcf2b01d6f70fcaecd1e8a523d5adfa1d5ebb7
--- /dev/null
+++ b/tests/unit/helpers/styleScan.ts
@@ -0,0 +1,49 @@
+import { readdirSync, readFileSync, statSync } from 'node:fs'
+import path from 'node:path'
+
+export function walk(dir: string, filter: (file: string) => boolean = () => true): string[] {
+  const out: string[] = []
+  for (const name of readdirSync(dir)) {
+    if (name === 'node_modules' || name === 'dist') continue
+    const full = path.join(dir, name)
+    if (statSync(full).isDirectory()) out.push(...walk(full, filter))
+    else if (filter(full)) out.push(full)
+  }
+  return out
+}
+
+/** Declarations whose value supplies no look are allowed anywhere. */
+const NEUTRAL_DECLARATION = /[\w-]+\s*:\s*(?:currentColor|inherit|none|transparent|0)\s*(?=[;,}\n]|$)/g
+
+const FORBIDDEN_PROPERTY =
+  /(^|[^\w-])(color|background(?:-?[cC]olor|-?[iI]mage)?|font(?:-?[fF]amily|-?[sS]ize|-?[wW]eight|-?[sS]tyle)?|border(?:-?[a-zA-Z]+)?|outline(?:-?[a-zA-Z]+)?|box-?[sS]hadow|text-?[sS]hadow|text-?[dD]ecoration|filter|backdrop-?[fF]ilter|padding(?:-?[a-zA-Z]+)?|margin(?:-?[a-zA-Z]+)?|gap|row-?[gG]ap|column-?[gG]ap|line-?[hH]eight|letter-?[sS]pacing|fill|stroke(?:-?[wW]idth)?|cursor)\s*:/g
+
+const THEME_TOKEN = /--[a-zA-Z][\w-]*\s*:/g
+const FRAMEWORK = /tailwind|@apply|styled-components|@emotion|class-variance|unocss|bootstrap/i
+
+export interface Finding {
+  file: string
+  match: string
+}
+
+/** Strips comments and neutral values, then reports look-supplying declarations. */
+export function scanSource(file: string, source: string): Finding[] {
+  const cleaned = source
+    .replace(/\/\*[\s\S]*?\*\//g, '')
+    .replace(/(^|[^:])\/\/.*$/gm, '$1')
+    .replace(NEUTRAL_DECLARATION, '')
+  const findings: Finding[] = []
+  // Motion sets opacity from code; a stylesheet must not.
+  if (file.endsWith('.css') && /opacity\s*:/.test(cleaned)) findings.push({ file, match: 'opacity:' })
+  for (const re of [FORBIDDEN_PROPERTY, THEME_TOKEN]) {
+    for (const m of cleaned.matchAll(re)) findings.push({ file, match: m[0].trim() })
+  }
+  if (FRAMEWORK.test(source)) findings.push({ file, match: 'styling framework reference' })
+  return findings
+}
+
+/** Scans look-bearing sources; tooling scripts that merely read computed styles are skipped. */
+export function scanDir(dir: string): Finding[] {
+  const files = walk(dir, (f) => /\.(css|ts|tsx|js|jsx)$/.test(f))
+  return files.flatMap((f) => scanSource(f, readFileSync(f, 'utf8')))
+}
