--- /dev/null
+++ b/src/presentation-kit/chrome/Attribution.tsx
@@ -0,0 +1,17 @@
+import { DEFAULT_ATTRIBUTION } from '../constants.ts'
+import type { AttributionOptions } from '../types.ts'
+
+/** Toolkit disclosure link, anchored bottom-right in every mode. */
+export function Attribution({ label = DEFAULT_ATTRIBUTION.label, href = DEFAULT_ATTRIBUTION.href }: AttributionOptions) {
+  return (
+    <a
+      data-presentation-attribution=""
+      href={href}
+      target="_blank"
+      rel="noopener noreferrer"
+      style={{ position: 'fixed', right: 0, bottom: 0 }}
+    >
+      {label}
+    </a>
+  )
+}
diff --git a/src/presentation-kit/chrome/Footer.tsx b/src/presentation-kit/chrome/Footer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..307829b60b36dc0bc18aca947417933e1bba34f2
--- /dev/null
+++ b/src/presentation-kit/chrome/Footer.tsx
@@ -0,0 +1,72 @@
+import { STAGE_LAYOUT } from '../constants.ts'
+import { releaseFocusAfterPointer } from '../nav.ts'
+import type { Mode, StepMeta } from '../types.ts'
+
+interface FooterProps {
+  meta: StepMeta
+  mode: Mode
+  titles: readonly string[]
+  onPrev: () => void
+  onNext: () => void
+  onJump: (index: number) => void
+}
+
+/** Present mode: the one-line title. Browse mode: caption, progress dots, prev/next. */
+export function Footer({ meta, mode, titles, onPrev, onNext, onJump }: FooterProps) {
+  const style = { position: 'absolute', left: 0, right: 0, bottom: 0, height: STAGE_LAYOUT[mode].bottom } as const
+  if (mode === 'present') {
+    return (
+      <footer data-presentation-footer="" style={style}>
+        <p data-presentation-title="">{meta.title}</p>
+      </footer>
+    )
+  }
+  return (
+    <footer data-presentation-footer="" style={style}>
+      <p data-presentation-caption="">{meta.caption}</p>
+      <nav data-presentation-progress="" aria-label="Progress">
+        {titles.map((title, i) => {
+          const active = i === meta.index
+          return (
+            <button
+              key={i}
+              type="button"
+              data-presentation-dot=""
+              data-presentation-active={active ? 'true' : undefined}
+              aria-current={active ? 'step' : undefined}
+              aria-label={`Step ${i + 1}: ${title}`}
+              onClick={(e) => {
+                onJump(i)
+                releaseFocusAfterPointer(e)
+              }}
+            />
+          )
+        })}
+      </nav>
+      <div data-presentation-controls="">
+        <button
+          type="button"
+          data-presentation-prev=""
+          aria-label="Previous step"
+          onClick={(e) => {
+            onPrev()
+            releaseFocusAfterPointer(e)
+          }}
+        >
+          Previous
+        </button>
+        <button
+          type="button"
+          data-presentation-next=""
+          aria-label="Next step"
+          onClick={(e) => {
+            onNext()
+            releaseFocusAfterPointer(e)
+          }}
+        >
+          Next
+        </button>
+      </div>
+    </footer>
+  )
+}
diff --git a/src/presentation-kit/chrome/Header.tsx b/src/presentation-kit/chrome/Header.tsx
