+++ b/src/presentation-kit/chrome/Header.tsx
@@ -0,0 +1,19 @@
+import type { ReactNode } from 'react'
+import { STAGE_LAYOUT } from '../constants.ts'
+import { stepMarker } from '../steps.ts'
+import type { Mode, StepMeta } from '../types.ts'
+
+/** Marker row; host branding is opt-in and the title shows in browse mode only. */
+export function Header({ meta, mode, brand }: { meta: StepMeta; mode: Mode; brand?: ReactNode }) {
+  return (
+    <header
+      data-presentation-header=""
+      style={{ position: 'absolute', top: 0, left: 0, right: 0, height: STAGE_LAYOUT[mode].top }}
+    >
+      {brand ? <div data-presentation-brand="">{brand}</div> : null}
+      <span data-presentation-marker="">{stepMarker(meta.index)}</span>
+      <span data-presentation-era="">{meta.era}</span>
+      {mode === 'browse' ? <h1 data-presentation-header-title="">{meta.title}</h1> : null}
+    </header>
+  )
+}
diff --git a/src/presentation-kit/chrome/Toc.tsx b/src/presentation-kit/chrome/Toc.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c2fb4ce3dd1a209e2911211cef2d517857bf10ba
--- /dev/null
+++ b/src/presentation-kit/chrome/Toc.tsx
@@ -0,0 +1,42 @@
+import { STAGE_LAYOUT } from '../constants.ts'
+import { releaseFocusAfterPointer } from '../nav.ts'
+import type { Era } from '../steps.ts'
+
+/** Era-based table of contents; an entry jumps to the first step of its era. */
+export function Toc({ eras, activeIndex, onJump }: { eras: readonly Era[]; activeIndex: number; onJump: (index: number) => void }) {
+  return (
+    <nav
+      data-presentation-toc=""
+      aria-label="Contents"
+      style={{
+        position: 'absolute',
+        left: 0,
+        top: STAGE_LAYOUT.browse.top,
+        bottom: STAGE_LAYOUT.browse.bottom,
+        width: STAGE_LAYOUT.browse.side,
+      }}
+    >
+      <ol>
+        {eras.map((era) => {
+          const active = era.indices.includes(activeIndex)
+          return (
+            <li key={era.firstIndex}>
+              <button
+                type="button"
+                data-presentation-toc-entry=""
+                data-presentation-active={active ? 'true' : undefined}
+                aria-current={active ? 'true' : undefined}
+                onClick={(e) => {
+                  onJump(era.firstIndex)
+                  releaseFocusAfterPointer(e)
+                }}
+              >
+                {era.label}
+              </button>
+            </li>
+          )
+        })}
+      </ol>
+    </nav>
+  )
+}
