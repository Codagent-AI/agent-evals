--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,35 @@
+import { useLayoutEffect, useState, type RefObject } from 'react'
+import { STAGE_LAYOUT } from './constants'
+import { computeFit, type Fit } from './fit'
+import type { Mode } from './types'
+
+/** Measures the stage region and fits the design canvas into it for the given mode. */
+export function useFitScale(
+  regionRef: RefObject<HTMLElement | null>,
+  mode: Mode,
+  tocVisible: boolean,
+): Fit {
+  const [fit, setFit] = useState<Fit>({ scale: 1, x: 0, y: 0 })
+
+  useLayoutEffect(() => {
+    const el = regionRef.current
+    if (!el) return
+    const measure = () => {
+      const { width, height } = el.getBoundingClientRect()
+      const next = computeFit(width, height, STAGE_LAYOUT[mode], tocVisible)
+      setFit((prev) =>
+        prev.scale === next.scale && prev.x === next.x && prev.y === next.y ? prev : next,
+      )
+    }
+    measure()
+    if (typeof ResizeObserver !== 'undefined') {
+      const ro = new ResizeObserver(measure)
+      ro.observe(el)
+      return () => ro.disconnect()
+    }
+    window.addEventListener('resize', measure)
+    return () => window.removeEventListener('resize', measure)
+  }, [regionRef, mode, tocVisible])
+
+  return fit
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1029413713df1562a7d5e70557aaed2164007bf2
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,65 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { clampIndex, isInteractiveTarget, keyAction, swipeAction } from './nav'
+import type { Mode } from './types'
+
+export interface PresentationNav {
+  index: number
+  mode: Mode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  toggleMode: () => void
+}
+
+export function usePresentationNav(count: number, initialMode: Mode): PresentationNav {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const last = Math.max(count - 1, 0)
+
+  const goTo = useCallback((i: number) => setIndex(clampIndex(i, last + 1)), [last])
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, last + 1)), [last])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, last + 1)), [last])
+  const toggleMode = useCallback(
+    () => setMode((m) => (m === 'present' ? 'browse' : 'present')),
+    [],
+  )
+
+  const handlers = useRef({ next, prev, toggleMode })
+  useEffect(() => {
+    handlers.current = { next, prev, toggleMode }
+  })
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.ctrlKey || e.metaKey || e.altKey || isInteractiveTarget(e.target)) return
+      const action = keyAction(e.key)
+      if (!action) return
+      e.preventDefault()
+      if (action === 'next') handlers.current.next()
+      else if (action === 'prev') handlers.current.prev()
+      else handlers.current.toggleMode()
+    }
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      start = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onTouchEnd = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      if (!start || !t) return
+      const action = swipeAction(t.clientX - start.x, t.clientY - start.y)
+      start = null
+      if (action) handlers.current[action]()
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart)
+    window.addEventListener('touchend', onTouchEnd)
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [])
+
+  return { index: clampIndex(index, last + 1), mode, next, prev, goTo, toggleMode }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useViewportWide.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useViewportWide.ts
