index 0000000000000000000000000000000000000000..e09366435004e979b3f039a701744334065cca65
--- /dev/null
+++ b/src/Landing.tsx
@@ -0,0 +1,16 @@
+import type { PresentationEntry } from './presentations/types'
+
+export function Landing({ presentations }: { presentations: readonly PresentationEntry[] }) {
+  return (
+    <main className="landing">
+      <h1>and-scene</h1>
+      <ul>
+        {presentations.map((p) => (
+          <li key={p.slug}>
+            <a href={`/${p.slug}`}>{p.title}</a>
+          </li>
+        ))}
+      </ul>
+    </main>
+  )
+}
diff --git a/src/Router.tsx b/src/Router.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..088f41b93963c71a5cdcd67f0bcd144006030d7f
--- /dev/null
+++ b/src/Router.tsx
@@ -0,0 +1,17 @@
+import { Suspense, lazy } from 'react'
+import { Landing } from './Landing'
+import { presentations } from './presentations'
+import { resolveRoute } from './router'
+
+const lazyRoutes = Object.fromEntries(presentations.map((entry) => [entry.slug, lazy(entry.load)]))
+
+export function Router({ pathname = window.location.pathname }: { pathname?: string }) {
+  const route = resolveRoute(pathname, presentations)
+  if (route.kind === 'landing') return <Landing presentations={presentations} />
+  const Presentation = lazyRoutes[route.entry.slug]
+  return (
+    <Suspense fallback={null}>
+      <Presentation />
+    </Suspense>
+  )
+}
