+import { motion } from 'motion/react'
+import type { ReactNode } from 'react'
+import { ENTER_DELAY, ENTER_T, EASE, EXIT_T } from '../constants'
+
+interface AppearProps {
+  children: ReactNode
+  /** Seconds to wait before entering; defaults to after persisting entities settle. */
+  delay?: number
+}
+
+/**
+ * Wraps an entity that joins the scene. It fades in only after persisting entities
+ * have finished their layout morph, and fades out when removed from a parent
+ * `SceneLayer`. The fade runs once on mount: keeping the same keyed `Appear` mounted
+ * across steps leaves the entity untouched, so it morphs by layout projection alone.
+ */
+export function Appear({ children, delay = ENTER_DELAY }: AppearProps) {
+  return (
+    <motion.div
+      data-presentation-appear=""
+      initial={{ opacity: 0 }}
+      animate={{ opacity: 1, transition: { duration: ENTER_T, delay, ease: EASE } }}
+      exit={{ opacity: 0, transition: { duration: EXIT_T, ease: EASE } }}
+      style={{ position: 'absolute', left: 0, top: 0, right: 0, bottom: 0, pointerEvents: 'none' }}
+    >
+      {children}
+    </motion.div>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/nodes/Arrow.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/nodes/Arrow.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f3a5c1c5d0ade3aad74b6268b965943f20b3fe8a
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/nodes/Arrow.tsx
@@ -0,0 +1,51 @@
+import { motion } from 'motion/react'
+import { geometry } from './geometry'
+import type { NodeProps } from './Node'
+
+interface Point {
+  x: number
+  y: number
+}
+
+interface ArrowProps extends Omit<NodeProps, 'at' | 'children' | 'Icon'> {
+  from: Point
+  to: Point
+  /** Draw a head at both ends. */
+  both?: boolean
+}
+
+const PAD = 8
+const HEAD = 7
+
+function head(tip: Point, from: Point): string {
+  const angle = Math.atan2(tip.y - from.y, tip.x - from.x)
+  const p = (da: number, len: number) =>
+    `${tip.x - len * Math.cos(angle + da)},${tip.y - len * Math.sin(angle + da)}`
+  return `${tip.x},${tip.y} ${p(0.5, HEAD)} ${p(-0.5, HEAD)}`
+}
+
+/** A straight arrow between two canvas points; its colors come from presentation CSS. */
+export function Arrow({ id, from, to, both, z, style, ...rest }: ArrowProps) {
+  const x = Math.min(from.x, to.x) - PAD
+  const y = Math.min(from.y, to.y) - PAD
+  const w = Math.abs(to.x - from.x) + PAD * 2
+  const h = Math.abs(to.y - from.y) + PAD * 2
+  const a = { x: from.x - x, y: from.y - y }
+  const b = { x: to.x - x, y: to.y - y }
+  return (
+    <motion.div
+      layout
+      layoutId={id}
+      data-presentation-node="arrow"
+      data-presentation-entity={id}
+      {...rest}
+      style={{ ...geometry({ x, y, w, h }, z), ...style }}
+    >
+      <svg width={w} height={h} viewBox={`0 0 ${w} ${h}`} aria-hidden="true">
+        <line data-presentation-arrow-line="" x1={a.x} y1={a.y} x2={b.x} y2={b.y} />
+        <polygon data-presentation-arrow-head="" points={head(b, a)} />
+        {both && <polygon data-presentation-arrow-head="" points={head(a, b)} />}
+      </svg>
+    </motion.div>
+  )
+}
