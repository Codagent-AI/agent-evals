+    expect(progress).toHaveLength(3)
+    expect(progress.every((l) => l.includes('progress item'))).toBe(true)
+    const toc = stdoutWarnings(results.get('fx-no-toc-style')!).filter((l) => l.includes('[active-chrome]'))
