+    'This presentation was built exactly this way. Thanks for watching.',
+  ],
+] as const
+
+const IDS = [
+  'you-have-a-topic',
+  'the-skill-interviews-you',
+  'answers-become-steps',
+  'the-deck-grows',
+  'you-set-the-depth',
+  'it-assembles-the-scene',
+  'it-checks-its-own-work',
+  'changed-your-mind',
+  'looking-at-one',
+]
+
+/** All nine beats share one group and one Scene: the diagram evolves, it is never redrawn. */
+export const STEPS: Step<ScenePayload>[] = TABLE.map(([era, title, caption], i) => ({
+  id: IDS[i],
+  era,
+  title,
+  caption,
+  groupKey: 'scene',
