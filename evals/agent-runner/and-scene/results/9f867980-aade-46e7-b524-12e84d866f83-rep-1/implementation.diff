+/* Presentation-owned look for "How to Use This Skill to Make a Presentation". */
+.htmp {
+  --ink: #f4efe3;
+  --muted: #b8b0a0;
+  --line: #5c5546;
+  --accent: #e6c76b;
+  --ok: #7fd68b;
+  background: #14120f;
+  color: var(--ink);
+  font-size: 15px;
+}
+
+.htmp [data-presentation-header] {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 20px;
+  padding: 18px 28px;
+}
+
+.htmp [data-presentation-brand]:empty {
+  display: none;
+}
+
+.htmp [data-presentation-marker] {
+  display: flex;
+  gap: 10px;
+  align-items: baseline;
+  color: var(--muted);
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  font-size: 13px;
+}
+
+.htmp [data-presentation-marker-number] {
+  color: var(--accent);
+  font-weight: 700;
+  font-size: 18px;
+}
+
+.htmp [data-presentation-header] h2 {
+  margin: 0;
+  font-size: 22px;
+}
+
+.htmp [data-presentation-mode-toggle],
+.htmp [data-presentation-controls] button {
+  margin-left: auto;
+  background: transparent;
+  color: var(--ink);
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  padding: 6px 14px;
+  cursor: pointer;
+}
+
+.htmp [data-presentation-footer] {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 12px 16px;
+  padding: 0 28px 48px;
+}
+
+.htmp [data-presentation-footer] h2 {
+  flex: 1 1 100%;
+  margin: 0;
+  font-size: 34px;
+  text-align: center;
+}
+
+.htmp [data-presentation-caption] {
+  flex: 1 1 100%;
+  margin: 0;
+  max-width: 62ch;
+  line-height: 1.5;
+  color: var(--muted);
+}
+
