@@ -0,0 +1,15 @@
+import type { StepMeta } from './types'
+
+export interface Era {
+  label: string
+  first: number
+}
+
+/** Eras in order of first appearance, each pointing at its first step. */
+export function eraEntries(steps: readonly StepMeta[]): Era[] {
+  const eras: Era[] = []
+  steps.forEach((s, i) => {
+    if (!eras.some((e) => e.label === s.era)) eras.push({ label: s.era, first: i })
+  })
+  return eras
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/fit.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/fit.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b0728515ac27ba837d577540c28d08d602ceadad
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/fit.ts
@@ -0,0 +1,27 @@
+import { DESIGN_H, DESIGN_W, MIN_SCALE, type StageGeometry } from './constants'
+
+export interface Fit {
+  scale: number
+  x: number
+  y: number
+}
+
+/** Uniform scale of the design canvas into the space left by the chrome, centered. */
+export function computeFit(
+  width: number,
+  height: number,
+  geometry: StageGeometry,
+  tocVisible: boolean,
+  designW = DESIGN_W,
+  designH = DESIGN_H,
+): Fit {
+  const left = geometry.left + (tocVisible ? geometry.tocWidth : 0)
+  const availW = Math.max(width - left - geometry.right, 0)
+  const availH = Math.max(height - geometry.top - geometry.bottom, 0)
+  const scale = Math.max(MIN_SCALE, Math.min(availW / designW, availH / designH))
+  return {
+    scale,
+    x: left + (availW - designW * scale) / 2,
+    y: geometry.top + (availH - designH * scale) / 2,
+  }
+}
