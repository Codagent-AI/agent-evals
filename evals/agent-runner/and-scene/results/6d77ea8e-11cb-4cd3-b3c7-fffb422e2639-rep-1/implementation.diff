+import type { ComponentType } from 'react'
+
+/** Props every scene component receives. `payload` is the active step's diagram state. */
+export interface SceneProps<TPayload = undefined> {
+  payload: TPayload
+  /** Zero-based index of the active step. */
+  stepIndex: number
+}
+
+export type Scene<TPayload = undefined> = ComponentType<SceneProps<TPayload>>
+
+/** Narration and identity for one step. */
+export interface StepMeta {
+  /** Stable identity; survives reordering. */
+  id: string
+  /** Section / era label used by the table of contents. */
+  era: string
+  /** One-line presenter title. */
+  title: string
+  /** Browse-mode paragraph. */
+  caption: string
+}
+
+/**
+ * One step: narration plus the diagram state shown while it is active.
+ * Adjacent steps with the same `groupKey` and the same `scene` share one
+ * mounted scene instance; only `payload` changes.
+ */
+export interface Step<TPayload = undefined> extends StepMeta {
+  scene: Scene<TPayload>
+  payload: TPayload
+  groupKey?: string
+}
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export type AnyStep = Step<any>
+
+export type PresentationMode = 'present' | 'browse'
diff --git a/src/presentation-kit/useFitScale.ts b/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6285a3ba77c478a109ea60579073ddae634458f0
--- /dev/null
+++ b/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,51 @@
+import { useEffect, useState } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT, WIDE_VIEWPORT } from './constants'
+import type { StageGeometry } from './constants'
+import type { PresentationMode } from './types'
+
+/** Largest uniform scale that fits the design canvas into the available box. */
+export function computeFitScale(
+  availW: number,
+  availH: number,
+  designW = DESIGN_W,
+  designH = DESIGN_H,
+  minScale = MIN_SCALE,
+): number {
+  const scale = Math.min(availW / designW, availH / designH)
+  return Number.isFinite(scale) ? Math.max(scale, minScale) : minScale
+}
+
+export function stageInsets(mode: PresentationMode, viewportW: number): StageGeometry & { left: number } {
+  const g = STAGE_LAYOUT[mode]
+  const showToc = mode === 'browse' && viewportW >= WIDE_VIEWPORT
+  return { ...g, left: g.side + (showToc ? g.toc : 0) }
+}
+
+export function fitScaleFor(
+  mode: PresentationMode,
+  viewportW: number,
+  viewportH: number,
+  designW = DESIGN_W,
+  designH = DESIGN_H,
+): number {
+  const g = stageInsets(mode, viewportW)
+  return computeFitScale(
+    viewportW - g.left - g.side,
+    viewportH - g.top - g.bottom,
+    designW,
+    designH,
+  )
+}
+
+export function useFitScale(mode: PresentationMode, designW = DESIGN_W, designH = DESIGN_H) {
+  const [size, setSize] = useState(() => ({ w: window.innerWidth, h: window.innerHeight }))
+  useEffect(() => {
+    const onResize = () => setSize({ w: window.innerWidth, h: window.innerHeight })
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return {
+    scale: fitScaleFor(mode, size.w, size.h, designW, designH),
+    viewportW: size.w,
+  }
+}
diff --git a/src/presentation-kit/usePresentationNav.ts b/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..89fce5228bbf38bb3dc64c6b9b28f6a0ea68b9c6
--- /dev/null
+++ b/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,61 @@
+import { useCallback, useEffect, useState } from 'react'
+import { clampIndex, isInteractiveTarget, keyAction, otherMode, swipeAction } from './nav'
+import type { PresentationMode } from './types'
+
+export interface PresentationNav {
+  index: number
+  mode: PresentationMode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  toggleMode: () => void
+}
+
+export function usePresentationNav(
+  count: number,
+  initialMode: PresentationMode = 'present',
+): PresentationNav {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState<PresentationMode>(initialMode)
+
+  const goTo = useCallback((i: number) => setIndex(clampIndex(i, count)), [count])
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, count)), [count])
+  const toggleMode = useCallback(() => setMode(otherMode), [])
+
+  useEffect(() => {
+    const onKeyDown = (e: KeyboardEvent) => {
+      if (e.ctrlKey || e.metaKey || e.altKey) return
+      if (isInteractiveTarget(e.target)) return
+      const action = keyAction(e)
+      if (!action) return
+      e.preventDefault()
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else toggleMode()
+    }
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      start = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onTouchEnd = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      if (!start || !t) return
+      const action = swipeAction(t.clientX - start.x, t.clientY - start.y)
+      start = null
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+    }
+    window.addEventListener('keydown', onKeyDown)
+    window.addEventListener('touchstart', onTouchStart, { passive: true })
+    window.addEventListener('touchend', onTouchEnd, { passive: true })
+    return () => {
+      window.removeEventListener('keydown', onKeyDown)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index: clampIndex(index, count), mode, next, prev, goTo, toggleMode }
+}
