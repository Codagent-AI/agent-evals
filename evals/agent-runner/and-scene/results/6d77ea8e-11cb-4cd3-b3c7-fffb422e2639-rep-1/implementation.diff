+[data-presentation-marker] { font-size: 13px; color: #a79f8e; margin-bottom: 6px; }
+[data-presentation-footer] [data-presentation-title] { margin: 0; font-size: 36px; text-align: center; }
+[data-presentation-caption] { margin: 0 0 14px; font-size: 18px; line-height: 1.45; min-height: 3em; }
+[data-presentation-prev], [data-presentation-next] {
+  display: grid; place-items: center; width: 40px; height: 40px;
+  color: #f8f3e6; background: #1c1a17; border: 1px solid #4a443a; border-radius: 50%; cursor: pointer;
+}
+[data-presentation-prev]:disabled, [data-presentation-next]:disabled { opacity: 0.35; cursor: default; }
+[data-presentation-progress] { gap: 10px; }
+[data-presentation-progress-item] {
+  width: 12px; height: 12px; padding: 0; border-radius: 50%; cursor: pointer;
+  background: #3a352d; border: 1px solid #6b6455; transition: all 0.2s;
+}
+[data-presentation-progress-item][data-presentation-active='true'] {
+  width: 30px; border-radius: 6px; background: #e8b04a; border-color: #e8b04a;
+}
+[data-presentation-toc] { display: flex; flex-direction: column; gap: 4px; padding: 0 16px; }
