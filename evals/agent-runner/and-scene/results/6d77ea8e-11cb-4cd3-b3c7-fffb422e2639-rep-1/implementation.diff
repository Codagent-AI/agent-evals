diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..99f50252275bbcfbb4336c4ae4bdf77704262c01
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,85 @@
+import type { ReactNode } from 'react'
+import { DEFAULT_ATTRIBUTION, DESIGN_H, DESIGN_W, WIDE_VIEWPORT } from './constants'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { Toc } from './chrome/Toc'
+import { Stage } from './Stage'
+import { usePresentationNav } from './usePresentationNav'
+import { useFitScale } from './useFitScale'
+import type { AnyStep, PresentationMode } from './types'
+
+export interface AttributionOptions {
+  label?: string
+  href?: string
+}
+
+export interface PresentationProps {
+  steps: readonly AnyStep[]
+  title: string
+  initialMode?: PresentationMode
+  /** `false` removes the attribution; an object overrides label/href. */
+  attribution?: false | AttributionOptions
+  /** Host-provided header brand (top-left). Nothing is rendered by default. */
+  brand?: ReactNode
+  designWidth?: number
+  designHeight?: number
+}
+
+export function Presentation({
+  steps,
+  title,
+  initialMode = 'present',
+  attribution,
+  brand,
+  designWidth = DESIGN_W,
+  designHeight = DESIGN_H,
+}: PresentationProps) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const { scale, viewportW } = useFitScale(nav.mode, designWidth, designHeight)
+  if (steps.length === 0) return null
+  const step = steps[nav.index]
+  const attr = attribution === false ? null : { ...DEFAULT_ATTRIBUTION, ...attribution }
+  return (
+    <div
+      data-presentation-chrome=""
+      data-presentation-mode={nav.mode}
+      data-presentation-name={title}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      style={{ position: 'fixed', inset: 0, overflow: 'hidden' }}
+    >
+      <Header step={step} mode={nav.mode} brand={brand} />
+      <Stage
+        step={step}
+        stepIndex={nav.index}
+        mode={nav.mode}
+        scale={scale}
+        viewportW={viewportW}
+        designW={designWidth}
+        designH={designHeight}
+      />
+      {nav.mode === 'browse' && viewportW >= WIDE_VIEWPORT && (
+        <Toc steps={steps} index={nav.index} onGoTo={nav.goTo} />
+      )}
+      <Footer
+        steps={steps}
+        index={nav.index}
+        mode={nav.mode}
+        onGoTo={nav.goTo}
+        onPrev={nav.prev}
+        onNext={nav.next}
+      />
+      {attr && (
+        <a
+          data-presentation-attribution=""
+          href={attr.href}
+          target="_blank"
+          rel="noreferrer"
+          style={{ position: 'absolute', right: 0, bottom: 0 }}
+        >
+          {attr.label}
+        </a>
+      )}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..8c666d0a7e7360062fec20147b19fc155d1a0726
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,56 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, ENTER_T } from './constants'
+import { sceneKey } from './nav'
+import { stageInsets } from './useFitScale'
+import type { AnyStep, PresentationMode } from './types'
+
+export interface StageProps {
+  step: AnyStep
+  stepIndex: number
+  mode: PresentationMode
+  scale: number
+  viewportW: number
+  designW?: number
+  designH?: number
+}
+
+export function Stage({ step, stepIndex, mode, scale, viewportW, designW = DESIGN_W, designH = DESIGN_H }: StageProps) {
+  const g = stageInsets(mode, viewportW)
+  const Scene = step.scene
+  return (
+    <div
+      data-presentation-stage-area=""
+      style={{ position: 'absolute', top: g.top, bottom: g.bottom, left: g.left, right: g.side }}
+    >
+      <div
+        data-presentation-stage=""
+        data-presentation-scale={scale.toFixed(4)}
+        style={{
+          position: 'absolute',
+          left: '50%',
+          top: '50%',
+          width: designW,
+          height: designH,
+          transform: `translate(-50%, -50%) scale(${scale})`,
+          transformOrigin: 'center center',
+        }}
+      >
+        <LayoutGroup>
+          <AnimatePresence initial={false}>
+            <motion.div
+              key={sceneKey(step)}
+              data-presentation-scene=""
+              initial={{ opacity: 0 }}
+              animate={{ opacity: 1 }}
+              exit={{ opacity: 0 }}
+              transition={{ duration: ENTER_T }}
+              style={{ position: 'absolute', inset: 0 }}
+            >
+              <Scene payload={step.payload} stepIndex={stepIndex} />
+            </motion.div>
+          </AnimatePresence>
+        </LayoutGroup>
+      </div>
+    </div>
+  )
+}
diff --git a/src/presentation-kit/chrome/Footer.tsx b/src/presentation-kit/chrome/Footer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..445f9e79bfc7602bbfabf78464899457a47c0b47
--- /dev/null
+++ b/src/presentation-kit/chrome/Footer.tsx
@@ -0,0 +1,56 @@
+import { ChevronLeft, ChevronRight } from 'lucide-react'
+import { stepMarker } from '../nav'
+import type { AnyStep, PresentationMode } from '../types'
+
+export interface FooterProps {
+  steps: readonly AnyStep[]
+  index: number
+  mode: PresentationMode
+  onGoTo: (index: number) => void
+  onPrev: () => void
+  onNext: () => void
+}
+
+export function Footer({ steps, index, mode, onGoTo, onPrev, onNext }: FooterProps) {
+  const step = steps[index]
+  const marker = stepMarker(index, steps.length)
+  return (
+    <footer
+      data-presentation-footer=""
+      style={{ position: 'absolute', left: 0, right: 0, bottom: 32 }}
+    >
+      <div data-presentation-marker="">{marker}</div>
+      {mode === 'present' ? (
+        <h1 data-presentation-title="">{step.title}</h1>
+      ) : (
+        <>
+          <p data-presentation-caption="">{step.caption}</p>
+          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
+            <button type="button" data-presentation-prev="" aria-label="Previous step" disabled={index === 0} onClick={onPrev}>
+              <ChevronLeft aria-hidden="true" />
+            </button>
+            <div data-presentation-progress="" style={{ display: 'flex', alignItems: 'center' }}>
+              {steps.map((s, i) => {
+                const active = i === index
+                return (
+                  <button
+                    key={`${i}:${s.id}`}
+                    type="button"
+                    data-presentation-progress-item={i}
+                    data-presentation-active={active ? 'true' : undefined}
+                    aria-current={active ? 'step' : undefined}
+                    aria-label={`Step ${i + 1}: ${s.title}`}
+                    onClick={() => onGoTo(i)}
+                  />
+                )
+              })}
+            </div>
+            <button type="button" data-presentation-next="" aria-label="Next step" disabled={index === steps.length - 1} onClick={onNext}>
+              <ChevronRight aria-hidden="true" />
+            </button>
+          </div>
+        </>
+      )}
+    </footer>
+  )
+}
diff --git a/src/presentation-kit/chrome/Header.tsx b/src/presentation-kit/chrome/Header.tsx
