diff --git a/skills/presentation/templates/bootstrap/src/routes.ts b/skills/presentation/templates/bootstrap/src/routes.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4cad2cd980f6968c1feddfb889fef316b6cedd0e
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/routes.ts
@@ -0,0 +1,19 @@
+import type { PresentationEntry } from './presentations'
+
+export type Route =
+  | { kind: 'landing' }
+  | { kind: 'presentation'; entry: PresentationEntry }
+
+/** "/" and unknown paths resolve to the landing page; "/<slug>" to its registry entry. */
+export function resolveRoute(pathname: string, registry: readonly PresentationEntry[]): Route {
+  const slug = pathname.replace(/^\/+|\/+$/g, '')
+  if (slug === '') return { kind: 'landing' }
+  let decoded = slug
+  try {
+    decoded = decodeURIComponent(slug)
+  } catch {
+    return { kind: 'landing' }
+  }
+  const entry = registry.find((e) => e.slug === decoded)
+  return entry ? { kind: 'presentation', entry } : { kind: 'landing' }
+}
