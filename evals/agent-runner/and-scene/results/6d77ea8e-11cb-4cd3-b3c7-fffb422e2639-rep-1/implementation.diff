+
+export function Toc({ steps, index, onGoTo }: TocProps) {
+  const activeEra = steps[index].era
+  return (
+    <nav
+      data-presentation-toc=""
+      aria-label="Table of contents"
+      style={{
+        position: 'absolute',
+        left: 0,
+        top: STAGE_LAYOUT.browse.top,
+        width: STAGE_LAYOUT.browse.toc,
+      }}
