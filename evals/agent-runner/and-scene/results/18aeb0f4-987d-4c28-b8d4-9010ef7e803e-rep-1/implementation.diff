+++ b/skills/presentation/templates/bootstrap/scripts/browser.mjs
@@ -0,0 +1,59 @@
+import { spawn } from 'node:child_process'
+import { createServer } from 'node:net'
+import { once } from 'node:events'
+import { resolve } from 'node:path'
+import { chromium } from 'playwright'
+export const HOST = '127.0.0.1'
+export const SETTLE_MS = 850
+export async function build(cwd) {
+  const child = spawn('npm', ['run', 'build'], { cwd, stdio: 'inherit' })
+  const [code] = await once(child, 'exit')
+  if (code !== 0) throw new Error(`build: npm run build exited ${code}`)
+}
+export async function withPreview(cwd, action) {
+  const socket = createServer()
+  socket.listen(0, HOST)
+  await once(socket, 'listening')
+  const port = socket.address().port
+  await new Promise(resolve => socket.close(resolve))
+  const server = spawn(process.execPath, [resolve(cwd, 'node_modules/vite/bin/vite.js'), 'preview', '--host', HOST, '--port', String(port), '--strictPort'], { cwd, stdio: ['ignore', 'pipe', 'pipe'] })
+  let output = '', spawnError
+  server.on('error', error => { spawnError = error })
+  server.stdout.on('data', data => { output += data })
+  server.stderr.on('data', data => { output += data })
+  const base = `http://${HOST}:${port}`
+  let browser
+  try {
+    let ready = false
+    for (let i = 0; i < 100; i++) {
+      if (spawnError || server.exitCode !== null) throw new Error(`preview: ${spawnError?.message ?? output}`)
+      try { ready = (await fetch(base, { signal: AbortSignal.timeout(500) })).ok } catch { /* startup */ }
+      if (ready) break
+      await new Promise(resolve => setTimeout(resolve, 100))
+    }
+    if (!ready) throw new Error(`preview readiness timeout: ${base}; ${output}`)
+    console.log(`PREVIEW ${base} PID ${server.pid}; readiness ${base}`)
+    browser = await chromium.launch({ headless: true })
+    return await action(browser, base)
+  } finally {
+    if (browser) await browser.close()
+    const exited = once(server, 'exit')
+    if (server.exitCode === null) {
+      server.kill('SIGTERM')
+      const force = setTimeout(() => server.kill('SIGKILL'), 3000)
+      await exited
+      clearTimeout(force)
+    }
+    console.log(`CLEANUP preview PID ${server.pid}`)
+  }
+}
+export function collectErrors(page) {
+  const errors = []
+  page.on('console', message => { if (message.type() === 'error') errors.push(message.text()) })
+  page.on('pageerror', error => errors.push(error.message))
+  return () => { if (errors.length) throw new Error(errors.join('; ')) }
+}
+export async function settle(page, ms = SETTLE_MS) { await page.waitForTimeout(ms) }
+export async function assertIndex(page, index) {
+  await page.waitForFunction(i => document.querySelector('[data-step-index]')?.getAttribute('data-step-index') === String(i), index, { timeout: 4000 })
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/diagnostics.mjs b/skills/presentation/templates/bootstrap/scripts/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..54082a86b8e6d292ad61370f9b5533f088949c63
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/diagnostics.mjs
@@ -0,0 +1,47 @@
+// Executed in the page: keep this function self-contained for Playwright serialization.
+export function inspectDocument() {
+  const root = document.querySelector('[data-presentation]')
+  const index = root?.getAttribute('data-step-index') ?? '?'
+  const warnings = []
+  const warn = message => warnings.push(`step ${index}: ${message}`)
+  const visible = el => {
+    const box = el.getBoundingClientRect(), css = getComputedStyle(el)
+    if (box.width <= 0 || box.height <= 0 || css.visibility === 'hidden' || css.display === 'none') return false
+    for (let node = el; node; node = node.parentElement) if (parseFloat(getComputedStyle(node).opacity) === 0) return false
+    return true
+  }
+  const describe = el => `${el.tagName.toLowerCase()}[${el.getAttribute('data-story-name') ?? el.getAttribute('data-presentation-entity') ?? el.textContent?.trim().slice(0, 55)}]`
+  const boxChrome = 'button, [data-presentation-attribution], [data-presentation-marker]'
+  const textChrome = '[data-presentation-title], [data-presentation-caption]'
+  const chrome = `${boxChrome}, ${textChrome}`
+  const nodes = [...root.querySelectorAll('*')].filter(el => visible(el) && !el.closest('[data-presentation-allow-overlap]') && (el.matches(chrome) || [...el.childNodes].some(n => n.nodeType === Node.TEXT_NODE && n.textContent.trim())))
+  // Text ranges ignore decorative frames and unused block width; controls occupy their entire box.
+  const rangeRects = node => {
+    const range = document.createRange(); range.selectNodeContents(node)
+    return [...range.getClientRects()]
+  }
+  const rects = el => el.matches(boxChrome) ? [el.getBoundingClientRect()] : el.matches(textChrome) ? rangeRects(el) : [...el.childNodes].filter(n => n.nodeType === Node.TEXT_NODE && n.textContent.trim()).flatMap(rangeRects)
+  for (let i = 0; i < nodes.length; i++) for (let j = i + 1; j < nodes.length; j++) {
+    const a = nodes[i], b = nodes[j]
+    if (a.contains(b) || b.contains(a)) continue
+    if (rects(a).some(x => rects(b).some(y => Math.min(x.right, y.right) - Math.max(x.left, y.left) > 1 && Math.min(x.bottom, y.bottom) - Math.max(x.top, y.top) > 1))) warn(`overlap ${describe(a)} / ${describe(b)}`)
+  }
+  const signature = el => {
+    const css = getComputedStyle(el)
+    return ['color', 'backgroundColor', 'borderColor', 'fontWeight', 'boxShadow', 'textDecorationLine', 'outlineStyle', 'opacity', 'transform'].map(k => css[k]).join('|')
+  }
+  for (const hook of ['data-presentation-progress-step', 'data-presentation-toc-entry']) {
+    const controls = [...root.querySelectorAll(`[${hook}]`)].filter(visible)
+    const active = controls.find(el => el.getAttribute('data-presentation-active') === 'true')
+    const inactive = controls.find(el => el.getAttribute('data-presentation-active') !== 'true')
+    if (active && inactive && signature(active) === signature(inactive)) warn(`indistinct active chrome ${hook}`)
+  }
+  const attribution = root.querySelector('[data-presentation-attribution]')
+  if (!attribution || !visible(attribution)) warn('missing attribution; style [data-presentation-attribution]')
+  else {
+    const css = getComputedStyle(attribution)
+    const defaultLink = ['rgb(0, 0, 238)', 'rgb(85, 26, 139)'].includes(css.color) && css.textDecorationLine.includes('underline')
+    if (parseFloat(css.fontSize) < 11 || defaultLink) warn('unpolished attribution; style [data-presentation-attribution] (undersized or browser-default)')
+  }
+  return warnings
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
