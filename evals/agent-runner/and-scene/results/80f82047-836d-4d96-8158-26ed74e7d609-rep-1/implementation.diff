+
+export interface SceneLayerProps {
+  children?: ReactNode
+  className?: string
+  style?: CSSProperties
+}
+
+/**
+ * Absolutely positioned diagram layer, so mounting one layer never reflows another.
+ * Keyed children that leave the tree animate out.
