+import type { ReactNode } from 'react'
+import { Attribution, type AttributionOptions } from './chrome/Attribution.tsx'
+import { Footer } from './chrome/Footer.tsx'
+import { Header } from './chrome/Header.tsx'
+import { Toc } from './chrome/Toc.tsx'
+import { DEFAULT_DESIGN } from './constants.ts'
+import { Stage } from './Stage.tsx'
+import type { DesignSize, Mode, Step } from './types.ts'
+import { isWide } from './useFitScale.ts'
+import { usePresentationNav } from './usePresentationNav.ts'
+import { useViewport } from './useViewport.ts'
+
+export interface PresentationProps<P> {
+  steps: readonly Step<P>[]
+  title?: string
+  initialMode?: Mode
+  /** Host-provided brand for the top-left slot; empty by default. */
+  brand?: ReactNode
+  /** Override the default attribution link, or pass `false` to omit it. */
+  attribution?: AttributionOptions | false
+  design?: DesignSize
+  className?: string
+}
+
+export function Presentation<P>({
+  steps,
+  title,
+  initialMode = 'present',
+  brand,
+  attribution,
+  design = DEFAULT_DESIGN,
+  className,
+}: PresentationProps<P>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const viewport = useViewport()
+  if (steps.length === 0) return null
+  const { index, mode } = nav
+  const tocVisible = mode === 'browse' && isWide(viewport)
+
+  return (
+    <div
+      data-presentation-root=""
+      data-presentation-title-text={title}
+      data-presentation-mode={mode}
+      data-step-count={steps.length}
+      data-step-index={index}
+      className={className}
+      style={{ position: 'fixed', inset: 0, overflow: 'hidden' }}
+    >
+      <Header brand={brand} step={steps[index]} index={index} mode={mode} onToggleMode={nav.toggleMode} />
+      {tocVisible && <Toc steps={steps} index={index} onJump={nav.goTo} />}
+      <Stage steps={steps} index={index} mode={mode} design={design} tocVisible={tocVisible} />
+      <Footer steps={steps} index={index} mode={mode} onJump={nav.goTo} onPrev={nav.prev} onNext={nav.next} />
+      {attribution !== false && <Attribution {...attribution} />}
+    </div>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b4e9d1d06afc470db449899c1e3afd287705782c
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
@@ -0,0 +1,65 @@
+import { AnimatePresence, LayoutGroup, MotionConfig, motion } from 'motion/react'
+import { useCallback, useRef } from 'react'
+import { pageToCanvas, type Point } from './canvasPoint.ts'
+import { ENTER_T } from './constants.ts'
+import type { DesignSize, Mode, Step } from './types.ts'
+import { stageRegion, useFitScale } from './useFitScale.ts'
+
+export interface StageProps<P> {
+  steps: readonly Step<P>[]
+  index: number
+  mode: Mode
+  design: DesignSize
+  tocVisible: boolean
+}
+
+/**
+ * Fixed design canvas scaled uniformly to fit. Steps sharing a `groupKey` keep one scene
+ * instance; other steps cross-fade and shared `layoutId`s morph.
+ */
+export function Stage<P>({ steps, index, mode, design, tocVisible }: StageProps<P>) {
+  const scale = useFitScale(mode, design, tocVisible)
+  const region = stageRegion(mode, tocVisible)
+  const step = steps[index]
+  const canvasRef = useRef<HTMLDivElement>(null)
+  const transformPagePoint = useCallback((point: Point) => pageToCanvas(canvasRef.current, point), [])
+  const { Scene } = step
+  return (
+    <div data-presentation-stage="" style={{ position: 'absolute', ...region, overflow: 'hidden' }}>
+      <div
+        ref={canvasRef}
+        data-presentation-canvas=""
+        data-presentation-scale={scale.toFixed(4)}
+        style={{
+          position: 'absolute',
+          left: '50%',
+          top: '50%',
+          width: design.width,
+          height: design.height,
+          transform: `translate(-50%, -50%) scale(${scale})`,
+          transformOrigin: 'center center',
+        }}
+      >
+        {/* Layout deltas are measured in canvas coordinates so they stay correct under the fit scale. */}
+        <MotionConfig transformPagePoint={transformPagePoint}>
+          {/* Keyed by mode: a mode switch re-renders the scene instead of morphing it. */}
+          <LayoutGroup key={mode}>
+            <AnimatePresence initial={false}>
+              <motion.div
+                key={step.groupKey ?? step.id}
+                data-presentation-step={step.id}
+                initial={{ opacity: 0 }}
+                animate={{ opacity: 1 }}
+                exit={{ opacity: 0 }}
+                transition={{ duration: ENTER_T }}
+                style={{ position: 'absolute', inset: 0 }}
+              >
+                <Scene payload={step.payload as P} step={step} index={index} />
+              </motion.div>
+            </AnimatePresence>
+          </LayoutGroup>
+        </MotionConfig>
+      </div>
+    </div>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/canvasPoint.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/canvasPoint.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ba9132f250d352279631612d8c4c4802cf7ceeb1
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/canvasPoint.ts
@@ -0,0 +1,21 @@
+export interface Point {
+  x: number
+  y: number
+}
+
+/** Rendered scale of the fixed canvas, read from the DOM so it is exact at the moment of measurement. */
+export function renderedScale(canvas: HTMLElement | null): number {
+  if (!canvas || canvas.offsetWidth === 0) return 1
+  const scale = canvas.getBoundingClientRect().width / canvas.offsetWidth
+  return Number.isFinite(scale) && scale > 0 ? scale : 1
+}
+
+/**
+ * Motion measures layouts in screen space, but entities live inside the scaled canvas, so a
+ * screen-space delta would be scaled a second time. Dividing measured points by the canvas scale
+ * keeps the measurements, and therefore the layout deltas, in canvas coordinates.
+ */
+export function pageToCanvas(canvas: HTMLElement | null, point: Point): Point {
+  const scale = renderedScale(canvas)
+  return scale === 1 ? point : { x: point.x / scale, y: point.y / scale }
+}
