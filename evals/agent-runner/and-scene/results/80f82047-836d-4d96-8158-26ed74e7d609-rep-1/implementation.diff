@@ -0,0 +1,21 @@
+import type { CSSProperties, HTMLAttributes } from 'react'
+
+export interface Rect {
+  x: number
+  y: number
+  w: number
+  h: number
+}
+
+/** Hooks shared by every primitive: identity, optional canvas rect, and author class/style/data passthrough. */
+export type NodeProps = Omit<HTMLAttributes<HTMLElement>, 'onDrag' | 'onDragStart' | 'onDragEnd' | 'onAnimationStart'> & {
+  /** Stable entity identity; becomes the Motion `layoutId`. */
+  id: string
+  /** Canvas-coordinate placement. Geometry only. */
+  rect?: Rect
+} & { [attr: `data-${string}`]: string | number | boolean | undefined }
+
+export function rectStyle(rect: Rect | undefined, style: CSSProperties | undefined): CSSProperties | undefined {
+  if (!rect) return style
+  return { position: 'absolute', left: rect.x, top: rect.y, width: rect.w, height: rect.h, ...style }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/types.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/types.ts
new file mode 100644
index 0000000000000000000000000000000000000000..79950f32d10215be06c049b7274614cb8c54766d
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/types.ts
@@ -0,0 +1,37 @@
+import type { ComponentType } from 'react'
+
+export type Mode = 'present' | 'browse'
+
+/** Narration and identity shared by every step. */
+export interface StepMeta {
+  /** Stable identity; survives insertion, removal and reordering. */
+  id: string
+  /** Section/era label used by the table of contents. */
+  era: string
+  /** One-line presenter title. */
+  title: string
+  /** Paragraph shown in browse mode. */
+  caption: string
+}
+
+export interface SceneProps<P = undefined> {
+  payload: P
+  step: StepMeta
+  index: number
+}
+
+type PayloadField<P> = undefined extends P ? { payload?: P } : { payload: P }
+
+/**
+ * One named state of the evolving scene. Adjacent steps with the same
+ * `groupKey` and `Scene` keep one mounted scene instance; only `payload` changes.
+ */
+export type Step<P = undefined> = StepMeta & {
+  groupKey?: string
+  Scene: ComponentType<SceneProps<P>>
+} & PayloadField<P>
+
+export interface DesignSize {
+  width: number
+  height: number
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..507a526486fe2f18e6fc08f7c4cfa830e8c1f2f4
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,25 @@
+import { MIN_SCALE, STAGE_LAYOUT, WIDE_VIEWPORT } from './constants.ts'
+import type { DesignSize, Mode } from './types.ts'
+import { useViewport, type Viewport } from './useViewport.ts'
+
+export function isWide(viewport: Viewport): boolean {
+  return viewport.width >= WIDE_VIEWPORT
+}
+
+/** Region (px offsets from the viewport edges) the canvas is fitted into. */
+export function stageRegion(mode: Mode, tocVisible: boolean) {
+  const { top, bottom, side, toc } = STAGE_LAYOUT[mode]
+  return { top, bottom, left: side + (tocVisible ? toc : 0), right: side }
+}
+
+/** One uniform factor that fits the design canvas into the stage region. */
+export function fitScale(viewport: Viewport, mode: Mode, design: DesignSize, tocVisible: boolean): number {
+  const region = stageRegion(mode, tocVisible)
+  const availableWidth = viewport.width - region.left - region.right
+  const availableHeight = viewport.height - region.top - region.bottom
+  return Math.max(MIN_SCALE, Math.min(availableWidth / design.width, availableHeight / design.height))
+}
+
+export function useFitScale(mode: Mode, design: DesignSize, tocVisible: boolean): number {
+  return fitScale(useViewport(), mode, design, tocVisible)
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c57b9aa915e7f5a3125209b4f27058c97be7637f
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,91 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { SWIPE_MIN } from './constants.ts'
+import type { Mode } from './types.ts'
+
+const INTERACTIVE = [
+  'button',
+  'a',
+  'input',
+  'select',
+  'textarea',
+  'summary',
+  '[contenteditable]:not([contenteditable="false"])',
+  ...[
+    'button', 'link', 'checkbox', 'radio', 'switch', 'tab', 'menuitem', 'menuitemcheckbox', 'menuitemradio', 'option',
+    'slider', 'spinbutton', 'textbox', 'searchbox', 'combobox', 'listbox', 'menu', 'menubar', 'tablist', 'tree',
+    'treegrid', 'grid', 'gridcell', 'treeitem', 'scrollbar',
+  ].map(
+    (role) => `[role="${role}"]`,
+  ),
+].join(',')
+
+function isInteractive(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE) !== null
+}
+
+const NEXT_KEYS = new Set(['ArrowRight', ' ', 'PageDown'])
+const PREV_KEYS = new Set(['ArrowLeft', 'PageUp'])
+
+export interface PresentationNav {
+  index: number
+  mode: Mode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  toggleMode: () => void
+}
+
+export function usePresentationNav(count: number, initialMode: Mode = 'present'): PresentationNav {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const last = Math.max(0, count - 1)
+
+  const goTo = useCallback((i: number) => setIndex(Math.min(last, Math.max(0, i))), [last])
+  // A stored index past the end (the step list shrank) counts as the last step.
+  const next = useCallback(() => setIndex((i) => Math.min(last, Math.min(i, last) + 1)), [last])
+  const prev = useCallback(() => setIndex((i) => Math.max(0, Math.min(i, last) - 1)), [last])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'present' ? 'browse' : 'present')), [])
+
+  // Keep the position valid when the step list shrinks.
+  const clamped = Math.min(index, last)
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.ctrlKey || e.metaKey || e.altKey || isInteractive(e.target)) return
+      if (NEXT_KEYS.has(e.key)) next()
+      else if (PREV_KEYS.has(e.key)) prev()
+      else if (e.key === 'p' || e.key === 'P') toggleMode()
+      else return
+      e.preventDefault()
+    }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [next, prev, toggleMode])
+
+  const touchStart = useRef<{ x: number; y: number } | null>(null)
+  useEffect(() => {
+    const onStart = (e: TouchEvent) => {
+      const t = e.touches[0]
+      touchStart.current = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onEnd = (e: TouchEvent) => {
+      const start = touchStart.current
+      const t = e.changedTouches[0]
+      touchStart.current = null
+      if (!start || !t) return
+      const dx = t.clientX - start.x
+      const dy = t.clientY - start.y
+      if (Math.abs(dx) < SWIPE_MIN || Math.abs(dx) <= Math.abs(dy)) return
+      if (dx < 0) next()
+      else prev()
+    }
+    window.addEventListener('touchstart', onStart, { passive: true })
+    window.addEventListener('touchend', onEnd, { passive: true })
+    return () => {
+      window.removeEventListener('touchstart', onStart)
+      window.removeEventListener('touchend', onEnd)
+    }
+  }, [next, prev])
+
+  return { index: clamped, mode, next, prev, goTo, toggleMode }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useViewport.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useViewport.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4da016da2e2a5c84df1efb5ce141a4e77c8859ae
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useViewport.ts
@@ -0,0 +1,18 @@
+import { useEffect, useState } from 'react'
+
+export interface Viewport {
+  width: number
+  height: number
+}
+
+const read = (): Viewport => ({ width: window.innerWidth, height: window.innerHeight })
+
+export function useViewport(): Viewport {
+  const [viewport, setViewport] = useState(read)
+  useEffect(() => {
+    const onResize = () => setViewport(read())
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return viewport
+}
