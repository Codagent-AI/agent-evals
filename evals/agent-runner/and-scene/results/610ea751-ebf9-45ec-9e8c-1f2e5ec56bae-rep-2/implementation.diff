+/* Presentation-owned look: warm paper, ink, one orange accent, one green for "pass". */
+[data-presentation-root] {
+  --paper: #f6f1e7;
+  --ink: #1d1b16;
+  --muted: #6d665a;
+  --line: #cfc5b0;
+  --accent: #c8501e;
+  --pass: #2f7d4f;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
+  line-height: 1.4;
+}
+
+[data-presentation-root] h1,
+[data-presentation-root] h2,
+[data-presentation-root] p {
+  margin: 0;
+}
+
+/* Chrome */
+[data-presentation-title] {
+  font-size: 15px;
+  font-weight: 600;
+  letter-spacing: 0.01em;
+}
+
+[data-presentation-marker] {
+  font-family: ui-monospace, 'SF Mono', Menlo, monospace;
+  font-size: 12px;
+  color: var(--accent);
+  font-weight: 700;
+}
+
+[data-presentation-step-title] {
+  font-size: 22px;
+  font-weight: 700;
+}
+
+[data-presentation-step-caption] {
+  font-size: 15px;
+  max-width: 62ch;
+  color: var(--muted);
+}
+
+[data-presentation-mode-toggle],
+[data-presentation-nav-button] {
+  font-size: 13px;
+  padding: 4px 12px;
+  border: 1px solid var(--ink);
+  border-radius: 999px;
+  background: transparent;
+  color: var(--ink);
+  cursor: pointer;
+}
+
+[data-presentation-nav-button]:disabled {
+  opacity: 0.35;
+  cursor: default;
+}
+
+[data-presentation-progress-item] {
+  width: 10px;
+  height: 10px;
+  padding: 0;
+  border: 1.5px solid var(--ink);
+  border-radius: 50%;
