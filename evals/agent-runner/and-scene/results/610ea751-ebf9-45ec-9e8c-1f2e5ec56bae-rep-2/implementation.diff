+    steps.add = await run(process.execPath, [SCAFFOLD, 'add', app, 'smoke', 'Smoke Test'], { cwd: outside })
+    steps.addQuoted = await run(process.execPath, [SCAFFOLD, 'add', app, 'quoted', `Say "hi" \\ {x} <b> it's`], { cwd: outside })
