+import { STAGE_LAYOUT } from '../constants.ts'
+import type { Section } from './sections.ts'
+
+export interface TocProps {
+  sections: readonly Section[]
+  activeIndex: number
+  onJump: (index: number) => void
+}
+
+export function Toc({ sections, activeIndex, onJump }: TocProps) {
+  return (
+    <nav
+      data-presentation-toc=""
+      aria-label="Table of contents"
+      style={{
+        position: 'absolute',
+        left: STAGE_LAYOUT.browse.side,
+        top: STAGE_LAYOUT.browse.top,
+        bottom: STAGE_LAYOUT.browse.bottom,
+        width: STAGE_LAYOUT.browse.tocWidth - STAGE_LAYOUT.browse.side,
+        overflow: 'auto',
+      }}
+    >
+      <ol style={{ listStyle: 'none', margin: 0, padding: 0 }}>
+        {sections.map((s) => {
+          const active = activeIndex >= s.first && activeIndex <= s.last
+          return (
+            <li key={`${s.era}:${s.first}`}>
+              <button
+                type="button"
+                data-presentation-toc-item=""
+                data-active={active ? 'true' : 'false'}
+                aria-current={active ? 'step' : undefined}
+                onClick={(e) => {
+                  onJump(s.first)
+                  if (e.detail > 0) e.currentTarget.blur()
+                }}
+              >
+                {s.era}
+              </button>
+            </li>
+          )
+        })}
+      </ol>
+    </nav>
+  )
+}
diff --git a/src/presentation-kit/chrome/sections.ts b/src/presentation-kit/chrome/sections.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c562abfd5d49cf8decca26d9d9acaf4db3e09dd2
--- /dev/null
+++ b/src/presentation-kit/chrome/sections.ts
@@ -0,0 +1,25 @@
+import type { StepMeta } from '../types.ts'
+
+export interface Section {
+  era: string
+  /** Index of the section's first step. */
+  first: number
+  /** Index of the section's last step. */
+  last: number
+}
+
+/** Groups consecutive steps sharing an era label into sections. */
+export function sectionsOf(steps: readonly StepMeta[]): Section[] {
+  const out: Section[] = []
+  steps.forEach((s, i) => {
+    const prev = out[out.length - 1]
+    if (prev && prev.era === s.era) prev.last = i
+    else out.push({ era: s.era, first: i, last: i })
+  })
+  return out
+}
+
+/** Step numbers are derived from position, never stored. */
+export function stepNumber(index: number): number {
+  return index + 1
+}
