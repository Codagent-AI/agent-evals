+import type { CSSProperties } from 'react'
+
+/** Canvas-space placement (design-canvas pixels); layout plumbing, not styling. */
+export interface Placement {
+  x: number
+  y: number
+  w?: number
+  h?: number
+}
+
+export interface NodeHooks {
+  /** Stable entity id; doubles as the shared `layoutId` so it morphs across steps. */
+  id: string
+  at?: Placement
+  className?: string
+  style?: CSSProperties
+  /** Free-form variant hook exposed as `data-presentation-variant`. */
+  variant?: string
+}
+
+export function placementStyle(at: Placement | undefined, style?: CSSProperties): CSSProperties {
+  if (!at) return { ...style }
+  return {
+    position: 'absolute',
+    left: at.x,
+    top: at.y,
+    width: at.w,
+    height: at.h,
+    boxSizing: 'border-box',
+    ...style,
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6fcf0ecfe5c6bf5b23806fa7fca6635161f8f874
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
@@ -0,0 +1,20 @@
+import type { Step } from './types.ts'
+
+const componentIds = new WeakMap<object, number>()
+let nextComponentId = 1
+
+function componentId(component: object): number {
+  let id = componentIds.get(component)
+  if (id === undefined) {
+    id = nextComponentId++
+    componentIds.set(component, id)
+  }
+  return id
+}
+
+/** Steps with the same group key and Scene component share one mounted instance. */
+export function sceneKey<TPayload>(step: Step<TPayload>): string {
+  return step.groupKey
+    ? `group:${step.groupKey}:${componentId(step.Scene)}`
+    : `step:${step.id}`
+}
