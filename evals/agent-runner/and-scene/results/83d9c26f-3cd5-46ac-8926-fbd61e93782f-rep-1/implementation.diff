+    expect(existsSync(path.join(tmp, 'src'))).toBe(false)
+    expect(read('README.md')).toBe(before)
+    expect(detect(tmp).missing).toEqual([])
+  })
+
+  it('reuses an existing presentations/ app in a monorepo (I-39)', () => {
