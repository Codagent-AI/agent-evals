+++ b/scripts/lib/outline.mjs
@@ -0,0 +1,29 @@
+// Normative nine-step outline of the committed reference presentation.
+export const REFERENCE_SLUG = 'how-to-make-a-presentation'
+
+export const REFERENCE_OUTLINE = [
+  ['You have a topic', 'It starts with you, a topic, and mild overconfidence.'],
+  ['The skill interviews you', 'One question at a time: the topic, the look, then each beat of the story.'],
+  ['Answers become steps', 'Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next.'],
+  ['The deck grows', 'Same shapes, new beats. Every answer extends the story without redrawing it.'],
+  ['You set the depth', 'Spell out every step, or sketch a few and see how it looks. You hold the gate.'],
+  ['It assembles the scene', 'Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph.'],
+  ['It checks its own work', 'Before saying done, it builds and renders every step — and fixes what breaks.'],
+  ['Changed your mind? Loop it.', 'Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch.'],
+  ["You're looking at one", 'This presentation was built exactly this way. Thanks for watching.'],
+].map(([title, caption]) => ({ title, caption }))
+
+/** Returns a description of the first mismatch against the outline, or null. */
+export function compareOutline(observed, expected = REFERENCE_OUTLINE) {
+  if (observed.length !== expected.length) {
+    return `expected ${expected.length} steps, found ${observed.length}`
+  }
+  for (let i = 0; i < expected.length; i++) {
+    for (const field of ['title', 'caption']) {
+      if (observed[i]?.[field] !== expected[i][field]) {
+        return `step ${i + 1} ${field}: expected ${JSON.stringify(expected[i][field])}, got ${JSON.stringify(observed[i]?.[field])}`
+      }
+    }
+  }
+  return null
+}
diff --git a/scripts/lib/runtime.mjs b/scripts/lib/runtime.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ef197dd99fad3be8c406121f5380d103e8ac6748
--- /dev/null
+++ b/scripts/lib/runtime.mjs
@@ -0,0 +1,130 @@
+// Shared plumbing for verify.mjs and inspect-presentation.mjs: registry parsing,
+// production preview on 127.0.0.1, and browser launch.
+import { spawn } from 'node:child_process'
+import { existsSync, readFileSync } from 'node:fs'
+import { createRequire } from 'node:module'
+import net from 'node:net'
+import path from 'node:path'
+import { pathToFileURL } from 'node:url'
+
+export const HOST = '127.0.0.1'
+
+/** Reads `{ slug, ..., import('./dir/Talk') }` entries from src/presentations/index.ts. */
+export function parseRegistry(text) {
+  const entries = []
+  const re = /slug:\s*(['"])(.+?)\1[\s\S]*?import\(\s*(['"])\.\/(.+?)\/Talk\3\s*\)/g
+  for (const m of text.matchAll(re)) entries.push({ slug: m[2], dir: m[4] })
+  return entries
+}
+
+export function readRegistry(root) {
+  const file = ['index.ts', 'index.tsx']
+    .map((f) => path.join(root, 'src', 'presentations', f))
+    .find((f) => existsSync(f))
+  return file ? parseRegistry(readFileSync(file, 'utf8')) : []
+}
+
+/**
+ * Directory of an installed dependency as the project at `root` resolves it, so a
+ * workspace host that hoists dependencies still works; falls back to `root/node_modules`.
+ */
+export function packageDir(root, name) {
+  try {
+    return path.dirname(createRequire(path.join(root, 'package.json')).resolve(`${name}/package.json`))
+  } catch {
+    return path.join(root, 'node_modules', name)
+  }
+}
+
+export function freePort() {
+  return new Promise((resolve, reject) => {
+    const srv = net.createServer()
+    srv.once('error', reject)
+    srv.listen(0, HOST, () => {
+      const { port } = srv.address()
+      srv.close(() => resolve(port))
+    })
+  })
+}
+
+export function run(command, args, { cwd, label }) {
+  return new Promise((resolve) => {
+    const child = spawn(command, args, { cwd, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (d) => (output += d))
+    child.stderr.on('data', (d) => (output += d))
+    child.on('error', (e) => resolve({ code: 1, output: `${label}: ${e.message}` }))
+    child.on('close', (code) => resolve({ code: code ?? 1, output }))
+  })
+}
+
+/** Starts `vite preview` bound to 127.0.0.1 and waits until it answers on that address. */
+export async function startPreview(root) {
+  const vite = path.join(packageDir(root, 'vite'), 'bin', 'vite.js')
+  const port = await freePort()
+  const child = spawn(
+    process.execPath,
+    [vite, 'preview', '--host', HOST, '--port', String(port), '--strictPort'],
+    { cwd: root, stdio: ['ignore', 'pipe', 'pipe'] },
+  )
+  let log = ''
+  child.stdout.on('data', (d) => (log += d))
+  child.stderr.on('data', (d) => (log += d))
+  let exited = false
+  child.on('exit', () => (exited = true))
+
+  const origin = `http://${HOST}:${port}`
+  const stop = () =>
+    new Promise((resolve) => {
+      if (exited) return resolve()
+      child.once('exit', resolve)
+      child.kill('SIGTERM')
+      setTimeout(() => child.kill('SIGKILL'), 3000).unref()
+    })
+
+  const deadline = Date.now() + 30_000
+  while (Date.now() < deadline) {
+    if (exited) throw new Error(`preview exited early:\n${log}`)
+    try {
+      const res = await fetch(`${origin}/`, { signal: AbortSignal.timeout(2000) })
+      if (res.ok) return { origin, stop }
+    } catch {
+      /* not ready yet */
+    }
+    await new Promise((r) => setTimeout(r, 150))
+  }
+  await stop()
+  throw new Error(`preview did not become ready at ${origin}:\n${log}`)
+}
+
+export async function launchBrowser(root) {
+  const { chromium } = await import(
+    pathToFileURL(path.join(packageDir(root, 'playwright'), 'index.mjs'))
+  )
+  return chromium.launch({
+    executablePath: process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH || undefined,
+  })
+}
+
+export const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
+
+const rootSel = '[data-presentation-root]'
+export const readHooks = (page) =>
+  page.evaluate((sel) => {
+    const el = document.querySelector(sel)
+    if (!el) return null
+    return {
+      count: Number(el.getAttribute('data-step-count')),
+      index: Number(el.getAttribute('data-step-index')),
+      mode: el.getAttribute('data-presentation-mode'),
+    }
+  }, rootSel)
+
+/** Waits until the chrome reports the given step index. */
+export const waitForIndex = (page, index, timeout = 4000) =>
+  page.waitForFunction(
+    ([sel, i]) =>
+      document.querySelector(sel)?.getAttribute('data-step-index') === String(i),
+    [rootSel, index],
+    { timeout },
+  )
