+    expect(v.out).toMatch(/preview at http:\/\/127\.0\.0\.1:\d+/)
+  })
+})
diff --git a/tests/integration/inspect.test.ts b/tests/integration/inspect.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..35518b4a5dc0c44f6df6ee36fff7886bd1006dfe
