diff --git a/skills/presentation/templates/bootstrap/src/router.ts b/skills/presentation/templates/bootstrap/src/router.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8cafa42d61a99561a42e337f2a82f81dadc086a5
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/router.ts
@@ -0,0 +1,15 @@
+import type { PresentationEntry } from './presentations'
+
+export type Route =
+  | { kind: 'landing' }
+  | { kind: 'presentation'; entry: PresentationEntry }
+
+/** "/" and unknown paths show the landing page; "/<slug>" opens that presentation. */
+export function resolveRoute(
+  pathname: string,
+  registry: readonly PresentationEntry[],
+): Route {
+  const slug = pathname.replace(/^\/+|\/+$/g, '')
+  const entry = slug ? registry.find((p) => p.slug === slug) : undefined
+  return entry ? { kind: 'presentation', entry } : { kind: 'landing' }
+}
