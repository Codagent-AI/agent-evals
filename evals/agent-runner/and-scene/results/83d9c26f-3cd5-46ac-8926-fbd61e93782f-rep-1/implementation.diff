index 0000000000000000000000000000000000000000..5677606c2c19084401b913853daddf90cdcfd9aa
--- /dev/null
+++ b/src/Landing.tsx
@@ -0,0 +1,17 @@
+import { presentations } from './presentations'
+
+export default function Landing() {
+  return (
+    <main className="landing">
+      <h1>and-scene</h1>
+      <p>Presentations as one evolving scene.</p>
+      <ul>
+        {presentations.map((p) => (
+          <li key={p.slug}>
+            <a href={`/${p.slug}`}>{p.title}</a>
+          </li>
+        ))}
+      </ul>
+    </main>
+  )
+}
diff --git a/src/Root.tsx b/src/Root.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..bb7a76b97d205933cf7689e0ff3c39de37018b79
--- /dev/null
+++ b/src/Root.tsx
@@ -0,0 +1,15 @@
+import { Suspense, lazy } from 'react'
+import Landing from './Landing.tsx'
+import { presentations } from './presentations'
+import { resolveRoute } from './router.ts'
+
+const route = resolveRoute(window.location.pathname, presentations)
+const Page = route.kind === 'presentation' ? lazy(route.entry.load) : Landing
+
+export default function Root() {
+  return (
+    <Suspense fallback={null}>
+      <Page />
+    </Suspense>
+  )
+}
