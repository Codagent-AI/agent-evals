@@ -0,0 +1,72 @@
+import type { Step } from '../../../presentation-kit'
+import { SampleScene, type SamplePayload } from './Scene'
+
+type Beat = { id: string; era: string; title: string; caption: string }
+
+/** Normative outline: titles and captions are fixed by the verification spec. */
+const BEATS: readonly Beat[] = [
+  {
+    id: 'topic',
+    era: 'the ask',
+    title: 'You have a topic',
+    caption: 'It starts with you, a topic, and mild overconfidence.',
+  },
+  {
+    id: 'interview',
+    era: 'the ask',
+    title: 'The skill interviews you',
+    caption: 'One question at a time: the topic, the look, then each beat of the story.',
+  },
+  {
+    id: 'answers',
+    era: 'the gathering',
+    title: 'Answers become steps',
+    caption:
+      'Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next.',
+  },
+  {
+    id: 'grows',
+    era: 'the gathering',
+    title: 'The deck grows',
+    caption: 'Same shapes, new beats. Every answer extends the story without redrawing it.',
+  },
+  {
+    id: 'depth',
+    era: 'the gathering',
+    title: 'You set the depth',
+    caption: 'Spell out every step, or sketch a few and see how it looks. You hold the gate.',
+  },
+  {
+    id: 'assemble',
+    era: 'the build',
+    title: 'It assembles the scene',
+    caption:
+      'Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph.',
+  },
+  {
+    id: 'check',
+    era: 'the build',
+    title: 'It checks its own work',
+    caption: 'Before saying done, it builds and renders every step — and fixes what breaks.',
+  },
+  {
+    id: 'loop',
+    era: 'the loop',
+    title: 'Changed your mind? Loop it.',
+    caption:
+      'Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch.',
+  },
+  {
+    id: 'reveal',
+    era: 'the reveal',
+    title: "You're looking at one",
+    caption: 'This presentation was built exactly this way. Thanks for watching.',
+  },
+]
+
+export const STEPS: readonly Step<SamplePayload>[] = BEATS.map((beat, i) => ({
+  ...beat,
+  Scene: SampleScene,
+  groupKey: 'how-to-make-a-presentation',
+  payload: { stage: i + 1 },
+}))
diff --git a/src/presentations/how-to-make-a-presentation/talk.css b/src/presentations/how-to-make-a-presentation/talk.css
new file mode 100644
index 0000000000000000000000000000000000000000..160bcb0a7d5983ca88caae6d437d959bf07304a8
--- /dev/null
+++ b/src/presentations/how-to-make-a-presentation/talk.css
@@ -0,0 +1,135 @@
+/* Presentation-owned look for "How to Use This Skill to Make a Presentation". */
+[data-presentation-root] {
+  --bg: #12161c;
+  --ink: #eef2f6;
+  --muted: #9aa7b5;
+  --line: #3a4656;
+  --accent: #ffb454;
+  --ok: #6fd08c;
+  background: var(--bg);
+  color: var(--ink);
+  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
+}
+
+[data-presentation-header] {
+  padding: 0 24px;
+  font-size: 14px;
+  color: var(--muted);
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  box-sizing: border-box;
+}
+[data-presentation-marker-number] { color: var(--accent); font-weight: 600; }
+[data-presentation-title] { text-transform: none; letter-spacing: 0; }
+
+[data-presentation-footer] {
+  padding: 0 24px;
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  text-align: center;
+  gap: 6px;
+}
+[data-presentation-step-title] { margin: 8px 0 0; font-size: 28px; font-weight: 650; }
+[data-presentation-caption] { margin: 0; max-width: 46rem; font-size: 17px; line-height: 1.45; color: var(--muted); }
+
+[data-presentation-progress] { display: flex; gap: 8px; margin-top: 6px; }
+[data-presentation-dot] {
+  width: 10px;
+  height: 10px;
+  padding: 0;
+  border-radius: 50%;
+  border: 1px solid var(--line);
+  background: transparent;
+  cursor: pointer;
+}
+[data-presentation-dot][data-presentation-active] {
+  width: 22px;
+  border-radius: 6px;
+  background: var(--accent);
+  border-color: var(--accent);
+}
+
+[data-presentation-controls] { display: flex; gap: 12px; }
+[data-presentation-controls] button {
+  font: inherit;
+  font-size: 14px;
+  padding: 4px 14px;
+  color: var(--ink);
+  background: transparent;
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  cursor: pointer;
+}
+[data-presentation-controls] button:disabled { opacity: 0.35; cursor: default; }
+
+[data-presentation-toc] { padding: 0 0 0 24px; box-sizing: border-box; }
+[data-presentation-toc] ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
+[data-presentation-toc-item] {
+  font: inherit;
+  font-size: 14px;
+  width: 100%;
+  text-align: left;
+  padding: 6px 10px;
+  color: var(--muted);
+  background: transparent;
+  border: 0;
+  border-left: 3px solid transparent;
+  cursor: pointer;
+}
+[data-presentation-toc-item][data-presentation-active] {
+  color: var(--ink);
+  font-weight: 650;
+  border-left-color: var(--accent);
+  background: rgba(255, 180, 84, 0.12);
+}
+
+[data-presentation-attribution] {
+  font-size: 12px;
+  color: var(--muted);
+  text-decoration: none;
+  padding: 2px 6px;
+  border-radius: 4px;
+  background: rgba(18, 22, 28, 0.85);
+}
+[data-presentation-attribution]:hover { color: var(--accent); }
+
+/* Scene entities */
+[data-presentation-node] { box-sizing: border-box; font-size: 15px; }
+[data-presentation-node='box'] {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  border: 2px solid var(--line);
+  border-radius: 10px;
+  background: #1b222b;
+}
+[data-presentation-node='box'] [data-presentation-glyph] { width: 18px; height: 18px; color: var(--accent); }
+[data-presentation-variant='card'] { font-size: 16px; color: var(--muted); }
+[data-presentation-variant='part'] { font-size: 18px; color: var(--ink); }
+[data-presentation-variant='ghost'] { border-style: dashed; color: var(--muted); background: transparent; }
+[data-presentation-variant='socket'] { border-color: var(--accent); flex-direction: row; justify-content: center; }
+[data-presentation-variant='bubble'] {
+  display: flex; align-items: center; justify-content: center;
+  border-radius: 14px; background: #263140; font-size: 16px;
+}
+[data-presentation-variant='caption'] { white-space: nowrap; font-size: 16px; color: var(--muted); }
+[data-presentation-node='chip'] {
+  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
+  border-radius: 999px; background: #263140; font-size: 15px; white-space: nowrap;
+}
+[data-presentation-node='chip'] [data-presentation-glyph] { width: 14px; height: 14px; }
+[data-presentation-variant='pass'] { background: rgba(111, 208, 140, 0.18); color: var(--ok); }
+[data-presentation-variant='flag'] { background: rgba(255, 180, 84, 0.18); color: var(--accent); }
+[data-presentation-node='arrow'] { color: var(--muted); }
