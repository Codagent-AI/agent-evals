+import { useFitScale } from './useFitScale'
+import type { Mode, Step } from './types'
+export function Stage<T>({ step, mode }: { step: Step<T>; mode: Mode }) {
+  const scale = useFitScale(mode)
+  const Scene = step.Scene
+  return <div data-presentation-stage style={{ width: DESIGN_W * scale, height: DESIGN_H * scale, position: 'relative', margin: 'auto' }}><div style={{ width: DESIGN_W, height: DESIGN_H, transform: `scale(${scale})`, transformOrigin: 'top left', position: 'relative' }}><LayoutGroup><AnimatePresence mode="sync"><motion.div key={step.groupKey ?? step.id} style={{ position: 'absolute', inset: 0 }} initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}><Scene payload={step.payload} /></motion.div></AnimatePresence></LayoutGroup></div></div>
+}
