+// @vitest-environment jsdom
+import { createElement } from 'react'
+import { expect, it, vi } from 'vitest'
+import { render, cleanup } from '@testing-library/react'
+const received = vi.hoisted(() => [] as Record<string, unknown>[])
+vi.mock('motion/react', () => ({ motion: { div: (props: Record<string, unknown>) => { received.push(props); return createElement('div', null, props.children as React.ReactNode) } } }))
+import { Box, Appear } from '../src/presentation-kit/nodes'
+import { ENTER_DELAY, ENTER_T, LAYOUT_T } from '../src/presentation-kit/constants'
+it('keeps layout identity, delays entry until layout settles, and defines exit',()=>{ render(<><Box id="stable">A</Box><Appear>B</Appear></>); const box=received.find(x=>x.layoutId==='stable')!; expect(box.initial).toEqual({opacity:0}); expect(box.animate).toEqual({opacity:1}); expect(box.exit).toEqual({opacity:0}); expect(box.transition).toEqual({layout:{duration:LAYOUT_T},opacity:{delay:ENTER_DELAY,duration:ENTER_T}}); expect(ENTER_DELAY).toBeGreaterThanOrEqual(LAYOUT_T); cleanup() })
diff --git a/tests/presentation.test.tsx b/tests/presentation.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..651b2c7477e7e81ea389209d663705c7286c7110
--- /dev/null
+++ b/tests/presentation.test.tsx
@@ -0,0 +1,30 @@
+// @vitest-environment jsdom
+import { afterEach, describe, expect, it } from 'vitest'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { Presentation } from '../src/presentation-kit/Presentation'
+import type { SceneProps, Step } from '../src/presentation-kit/types'
+let mounts = 0
+import { useEffect } from 'react'
+function Scene({ payload }: SceneProps<number>) { useEffect(() => { mounts++ }, []); return <div>Scene {payload}</div> }
+const steps: Step<number>[] = [
+ { id:'a', era:'first', title:'Alpha', caption:'A caption', Scene, payload:0, groupKey:'group' },
+ { id:'b', era:'first', title:'Beta', caption:'B caption', Scene, payload:1, groupKey:'group' },
+ { id:'c', era:'second', title:'Gamma', caption:'C caption', Scene, payload:2, groupKey:'group' },
+]
+afterEach(cleanup)
+describe('presentation controls', () => {
+ it('preserves grouped scene instance and updates its payload', () => { mounts=0; render(<Presentation steps={steps} title="Demo" />); fireEvent.keyDown(window,{key:'ArrowRight'}); expect(screen.getByText('Scene 1')).toBeTruthy(); expect(mounts).toBe(1) })
+ it('navigates by keys, controls and eras and preserves mode position', () => { const {container}=render(<Presentation steps={steps} title="Demo" />); const root=container.querySelector('[data-presentation]')!; fireEvent.keyDown(window,{key:'PageDown'}); expect(root.getAttribute('data-step-index')).toBe('1'); fireEvent.click(screen.getByText('second')); expect(root.getAttribute('data-step-index')).toBe('2'); fireEvent.click(screen.getByLabelText('Toggle presentation mode')); expect(root.getAttribute('data-mode')).toBe('present'); expect(screen.queryByText('C caption')).toBeNull(); expect(root.getAttribute('data-step-index')).toBe('2'); fireEvent.click(screen.getByLabelText('Toggle presentation mode')); expect(screen.getByText('C caption')).toBeTruthy(); expect(container.querySelector('[data-presentation-progress-item][aria-current="step"]')?.getAttribute('aria-label')).toContain('Step 3') })
+ it('does not hijack focused controls and clamps at ends', () => { const {container}=render(<Presentation steps={steps} title="Demo" />); const root=container.querySelector('[data-presentation]')!; fireEvent.keyDown(window,{key:'ArrowLeft'}); expect(root.getAttribute('data-step-index')).toBe('0'); const next=screen.getByText('Next'); next.focus(); fireEvent.keyDown(next,{key:'ArrowRight'}); expect(root.getAttribute('data-step-index')).toBe('0'); fireEvent.click(next); expect(root.getAttribute('data-step-index')).toBe('1') })
+})
+describe('navigation methods', () => {
+ it('handles each navigation key and both swipes', () => { const {container}=render(<Presentation steps={steps} title="Demo" />); const root=container.querySelector('[data-presentation]')!; const index=()=>root.getAttribute('data-step-index'); for(const key of ['ArrowRight',' ','PageDown']) { fireEvent.keyDown(document.body,{key}); expect(index()).not.toBe('0'); fireEvent.click(screen.getByLabelText('Step 1: Alpha')) } for(const key of ['ArrowLeft','PageUp']) { fireEvent.click(screen.getByLabelText('Step 3: Gamma')); fireEvent.keyDown(document.body,{key}); expect(index()).toBe('1') } fireEvent.click(screen.getByLabelText('Step 1: Alpha')); fireEvent.touchStart(root,{touches:[{clientX:200}]}); fireEvent.touchEnd(root,{changedTouches:[{clientX:100}]}); expect(index()).toBe('1'); fireEvent.touchStart(root,{touches:[{clientX:100}]}); fireEvent.touchEnd(root,{changedTouches:[{clientX:200}]}); expect(index()).toBe('0') })
+ it('marks the current era and step, and shows default attribution without default brand', () => { const {container}=render(<Presentation steps={steps} title="Demo" />); fireEvent.click(screen.getByLabelText('Step 3: Gamma')); expect(screen.getByText('second').getAttribute('aria-current')).toBe('step'); const link=screen.getByText('made by and-scene'); expect(link.getAttribute('href')).toBe('https://github.com/Codagent-AI/and-scene'); expect(container.querySelector('[data-presentation-header] a')).toBeNull() })
+})
+describe('step contract and modes', () => {
+ it('derives numbering from current order and displays active narration', () => { const reordered=[steps[2],steps[0],steps[1]]; const {container}=render(<Presentation steps={reordered} title="Demo" />); expect(container.querySelector('[data-presentation-marker]')?.textContent).toBe('01'); expect(screen.getByText('Gamma')).toBeTruthy(); expect(screen.getByText('C caption')).toBeTruthy(); fireEvent.click(screen.getByLabelText('Step 2: Alpha')); expect(container.querySelector('[data-presentation-marker]')?.textContent).toBe('02'); expect(screen.getByText('A caption')).toBeTruthy() })
+ it('honors initial present mode and restores browse chrome without moving', () => { const {container}=render(<Presentation steps={steps} title="Demo" initialMode="present" />); const root=container.querySelector('[data-presentation]')!; expect(root.getAttribute('data-mode')).toBe('present'); expect(screen.queryByText('A caption')).toBeNull(); expect(container.querySelector('[data-presentation-toc]')).toBeNull(); expect(container.querySelector('[data-presentation-controls]')).toBeNull(); expect(screen.getByText('Alpha')).toBeTruthy(); expect((container.querySelector('[data-presentation-header-title]') as HTMLElement).style.whiteSpace).toBe('nowrap'); fireEvent.click(screen.getByLabelText('Toggle presentation mode')); expect(screen.getByText('A caption')).toBeTruthy(); expect(root.getAttribute('data-step-index')).toBe('0') })
+})
+it('shows the table of contents only on wide screens', () => { const original=window.innerWidth; Object.defineProperty(window,'innerWidth',{value:500,writable:true,configurable:true}); const {container}=render(<Presentation steps={steps} title="Demo" />); const toc=container.querySelector('[data-presentation-toc]')!; expect(toc.hasAttribute('hidden')).toBe(true); window.innerWidth=1000; fireEvent(window,new Event('resize')); expect(toc.hasAttribute('hidden')).toBe(false); window.innerWidth=original })
+it('renumbers steps after insertion and removal', () => { const {container,rerender}=render(<Presentation steps={steps} title="Demo" />); fireEvent.click(screen.getByLabelText('Step 2: Beta')); rerender(<Presentation steps={[{...steps[2],id:'inserted'},...steps]} title="Demo" />); expect(container.querySelector('[data-presentation-marker]')?.textContent).toBe('02'); expect(screen.getByText('Alpha')).toBeTruthy(); rerender(<Presentation steps={[steps[2],steps[1]]} title="Demo" />); expect(container.querySelector('[data-presentation-marker]')?.textContent).toBe('02'); expect(screen.getByText('Beta')).toBeTruthy() })
+it('leaves navigation keys to custom focusable controls', () => { const {container}=render(<><Presentation steps={steps} title="Demo" /><div role="slider" tabIndex={0}>Custom slider</div></>); const slider=screen.getByRole('slider'); slider.focus(); fireEvent.keyDown(slider,{key:'ArrowRight'}); expect(container.querySelector('[data-presentation]')?.getAttribute('data-step-index')).toBe('0') })
