+:root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color:#182c39; background:#f6f3eb; }
+* { box-sizing:border-box }
+body { margin:0 }
+[data-presentation] { min-height:100vh; display:flex; flex-direction:column; padding:24px 5vw 50px; gap:18px }
+[data-presentation-header] { display:flex; align-items:center; gap:16px; font-size:14px; font-weight:650; letter-spacing:.03em; }
+[data-presentation-marker] { background:#153f49; color:#fff; border-radius:50%; padding:10px; font-size:11px }
+button { font:inherit; cursor:pointer }
+[data-presentation-mode] { margin-left:auto; background:transparent; border:1px solid #899b99; border-radius:40px; padding:8px 18px; color:#24434a }
+[data-presentation-toc] { display:flex; justify-content:center; gap:24px }
+[data-presentation-toc-item] { border:0; padding:8px 2px; color:#72827e; background:none; font-size:12px; text-transform:uppercase; letter-spacing:.12em }
+[data-presentation-toc-item][data-active=true] { color:#bd572f; border-bottom:2px solid #bd572f; font-weight:750 }
+[data-presentation-stage] { flex:none; margin:auto !important }
+[data-presentation-footer] { display:flex; align-items:end; justify-content:space-between; gap:24px; max-width:1050px; width:100%; margin:0 auto }
+[data-presentation-footer] h1 { font-size:clamp(23px,3vw,37px); margin:0 0 8px; letter-spacing:-.04em }
+[data-presentation-footer] p { max-width:560px; line-height:1.5; margin:0; color:#59706e }
+[data-presentation-controls] { display:flex; gap:14px; align-items:center }
+[data-presentation-controls]>button { background:#173f48; color:white; border:0; border-radius:30px; padding:10px 16px }
+[data-presentation-controls]>button:disabled { opacity:.35 }
+[data-presentation-progress] { display:flex; gap:7px }
+[data-presentation-progress-item] { border:0; padding:0; border-radius:50%; width:8px; height:8px; background:#bdc7be }
+[data-presentation-progress-item][data-active=true] { background:#c65b32; transform:scale(1.5) }
+[data-presentation-attribution] { font-size:12px; color:#526e69; text-decoration:none; font-weight:600 }
+.diagram { position:absolute; inset:0; }
+.scene-item { position:absolute; }
+.person { width:190px; height:74px; padding:12px 16px; background:#173f48; color:white; border-radius:12px; box-shadow:0 6px 18px #163a4220 }
+.person small,.card small { display:block; font-size:9px; letter-spacing:.14em; opacity:.68; margin-bottom:8px }
+.person strong { font-size:20px }.skill { background:#dc754d }
+.bubble { background:white; border:1px solid #d8e1d8; border-radius:22px; padding:9px 14px; font-size:12px; color:#58746f }
+.question,.depth,.eyebrow,.loop,.edit { font-size:10px; letter-spacing:.12em; font-weight:750; color:#ae593d }
+.eyebrow { color:#708983 }.depth { color:#577771 }.loop { color:#ce704f }.edit { color:#c45a37 }
+.tray { width:810px; height:131px; border-radius:12px; background:#e9eee5 }
+.card { width:143px; height:104px; border:1px solid #c6d3c9; background:#fffdf8; border-radius:10px; padding:14px; box-shadow:0 5px 14px #274e4610 }
