+function tree(dir, skip = () => false) {
+  if (!fs.existsSync(dir)) return []
+  return fs
+    .readdirSync(dir, { recursive: true, encoding: 'utf8' })
+    .filter((f) => fs.statSync(path.join(dir, f)).isFile() && !skip(f))
+    .sort()
+}
+const isTest = (f) => /(^|[\\/])__tests__[\\/]|\.test\.[tj]sx?$/.test(f)
