+    expect(el.getAttribute('data-extra')).toBe('1')
+    expect(el.style.zIndex).toBe('3')
+  })
+})
+
+describe('Arrow morph', () => {
+  it('keeps one node and animates its path geometry to the new endpoints', async () => {
