--- /dev/null
+++ b/scripts/lib/build.mjs
@@ -0,0 +1,10 @@
+import { spawnSync } from 'node:child_process'
+
+/** Runs `npm run build` in `root`; returns the exit status and the last lines of output. */
+export function buildApp(root) {
+  const result = spawnSync('npm', ['run', 'build'], { cwd: root, encoding: 'utf8' })
+  const text = `${result.stdout ?? ''}${result.stderr ?? ''}`.trim().split('\n').slice(-40).join('\n')
+  // A launch failure or timeout leaves no output; report why instead.
+  const output = text || String(result.error?.message ?? result.signal ?? '')
+  return { status: result.status, output }
+}
diff --git a/scripts/lib/diagnostics.mjs b/scripts/lib/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..29d4e5afbb04f3e8511386267d9f496dde45cc30
--- /dev/null
+++ b/scripts/lib/diagnostics.mjs
@@ -0,0 +1,118 @@
+// Pure analysers for the screenshot helper. The helper collects plain facts from the
+// page; everything that decides what is suspicious lives here so it can be tested
+// without a browser. Warnings are advisory and never change the exit code.
+
+export const MIN_ATTRIBUTION_FONT_PX = 11
+export const BROWSER_DEFAULT_LINK_COLOR = 'rgb(0, 0, 238)'
+export const COLOR_TOLERANCE = 8
+export const NUMBER_TOLERANCE = 0.5
+export const OVERLAP_TOLERANCE_PX = 1
+export const ATTRIBUTION_HOOK = 'data-presentation-attribution'
+
+const intersect = (a, b, tolerance) =>
+  Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x) > tolerance &&
+  Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y) > tolerance
+
+/**
+ * @param elements `{ id, label, rect: {x,y,w,h}, visible, allowed, ancestors: string[] }`.
+ *   `allowed` means the element sits inside an allow-overlap subtree; `ancestors` are ids of
+ *   containing collected elements (a container is not "overlapping" what it contains).
+ */
+export function findOverlaps(elements, tolerance = OVERLAP_TOLERANCE_PX) {
+  const shown = elements.filter((e) => e.visible && e.rect.w > 0 && e.rect.h > 0)
+  const found = []
+  for (let i = 0; i < shown.length; i += 1) {
+    for (let j = i + 1; j < shown.length; j += 1) {
+      const a = shown[i]
+      const b = shown[j]
+      if (a.allowed || b.allowed) continue
+      if (a.ancestors?.includes(b.id) || b.ancestors?.includes(a.id)) continue
+      if (intersect(a.rect, b.rect, tolerance)) found.push([a.label, b.label])
+    }
+  }
+  return found
+}
+
+function parseColor(value) {
+  const match = /^rgba?\(([^)]+)\)$/.exec(String(value).trim())
+  if (!match) return null
+  const [r, g, b, a = 1] = match[1].split(/[ ,/]+/).filter(Boolean).map(Number)
+  return [r, g, b, a]
+}
+
+function sameValue(prop, a, b) {
+  const colorA = parseColor(a)
+  const colorB = parseColor(b)
+  if (colorA && colorB) {
+    return colorA.every((channel, i) => Math.abs(channel - colorB[i]) <= (i === 3 ? 0.05 : COLOR_TOLERANCE))
+  }
+  const numA = Number.parseFloat(a)
+  const numB = Number.parseFloat(b)
+  if (['opacity', 'fontWeight', 'width', 'height'].includes(prop) && !Number.isNaN(numA) && !Number.isNaN(numB)) {
+    return Math.abs(numA - numB) <= (prop === 'opacity' ? 0.05 : NUMBER_TOLERANCE)
+  }
+  return a === b
+}
+
+export const ACTIVE_STYLE_PROPS = [
+  'backgroundColor',
+  'color',
+  'borderColor',
+  'opacity',
+  'fontWeight',
+  'outline',
+  'boxShadow',
+  'transform',
+  'width',
+  'height',
+]
+
+/** Which computed-style properties differ between an active element and an inactive sibling. */
+export function differingProps(active, inactive) {
+  return ACTIVE_STYLE_PROPS.filter((prop) => !sameValue(prop, active[prop], inactive[prop]))
+}
+
+export const isIndistinct = (active, inactive) => differingProps(active, inactive).length === 0
+
+/** @returns 'missing' | 'small' | 'browser-default' | null for a legible, deliberate attribution. */
+export function classifyAttribution(info) {
+  if (!info) return 'missing'
+  if (info.fontSizePx < MIN_ATTRIBUTION_FONT_PX) return 'small'
+  const defaultLink =
+    sameValue('color', info.color, BROWSER_DEFAULT_LINK_COLOR) &&
+    String(info.textDecorationLine).includes('underline') &&
+    info.fontFamily === info.parentFontFamily
+  return defaultLink ? 'browser-default' : null
+}
+
+const pad = (n) => String(n).padStart(2, '0')
+
+export const screenshotName = (index) => `step-${pad(index)}.png`
+
+export function formatWarning(index, kind, message) {
+  return `WARN step ${index} ${kind}: ${message}`
+}
+
+/** Turns the facts gathered at one step into advisory warning lines. */
+export function warningsForStep(index, facts) {
+  const lines = []
+  for (const [a, b] of findOverlaps(facts.elements)) {
+    lines.push(formatWarning(index, 'overlap', `${a} overlaps ${b} (mark an intentional readable overlap with data-presentation-allow-overlap)`))
+  }
+  for (const chrome of facts.activeChrome) {
+    if (chrome.inactive && isIndistinct(chrome.active, chrome.inactive)) {
+      lines.push(
+        formatWarning(index, 'active-chrome', `active ${chrome.name} looks the same as inactive ones; style [data-presentation-active="true"] / [aria-current]`),
+      )
+    }
+  }
+  const attribution = classifyAttribution(facts.attribution)
+  if (attribution === 'missing') {
+    lines.push(formatWarning(index, 'attribution', `no [${ATTRIBUTION_HOOK}] link found; render the kit attribution and style [${ATTRIBUTION_HOOK}]`))
+  } else if (attribution === 'small') {
+    lines.push(formatWarning(index, 'attribution', `attribution text is under ${MIN_ATTRIBUTION_FONT_PX}px; style [${ATTRIBUTION_HOOK}]`))
+  } else if (attribution === 'browser-default') {
+    lines.push(formatWarning(index, 'attribution', `attribution has the browser-default link look; style [${ATTRIBUTION_HOOK}]`))
+  }
+  return lines
+}
diff --git a/scripts/lib/inspect.mjs b/scripts/lib/inspect.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..380d06aa9dcae2ba606b5828fcbe4b66adb8fff3
--- /dev/null
+++ b/scripts/lib/inspect.mjs
@@ -0,0 +1,50 @@
+import path from 'node:path'
+import { parseArgs } from 'node:util'
+import { screenshotName, warningsForStep } from './diagnostics.mjs'
+
+export const DEFAULTS = { out: 'inspection', viewport: '1440x900', settleMs: 1200 }
+
+export function parseViewport(text) {
+  const match = /^(\d+)x(\d+)$/.exec(text)
+  if (!match) throw new Error(`invalid --viewport "${text}"; expected WIDTHxHEIGHT such as 1440x900`)
+  return { width: Number(match[1]), height: Number(match[2]) }
+}
+
+/** `inspect-presentation.mjs <slug> [--out DIR] [--viewport WxH] [--settle-ms N] [--no-build]` */
+export function parseInspectArgs(argv) {
+  const { values, positionals } = parseArgs({
+    args: argv,
+    allowPositionals: true,
+    options: {
+      out: { type: 'string', default: DEFAULTS.out },
+      viewport: { type: 'string', default: DEFAULTS.viewport },
+      'settle-ms': { type: 'string', default: String(DEFAULTS.settleMs) },
+      'no-build': { type: 'boolean', default: false },
+    },
+  })
+  const [slug] = positionals
+  if (!slug) throw new Error('usage: inspect-presentation.mjs <slug> [--out DIR] [--viewport WxH] [--settle-ms N] [--no-build]')
+  const settleMs = Number(values['settle-ms'])
+  if (!Number.isFinite(settleMs) || settleMs < 0) throw new Error(`invalid --settle-ms "${values['settle-ms']}"`)
+  return { slug, out: values.out, viewport: parseViewport(values.viewport), settleMs, build: !values['no-build'] }
+}
+
+export const screenshotPath = (out, slug, index) => path.join(out, slug, screenshotName(index))
+
+/**
+ * Walks every step: advance, wait for the step to be active, wait out the settle
+ * interval, then capture and diagnose. The adapters keep this testable without a browser.
+ */
+export async function captureSteps({ count, settleMs, advance, waitForStep, sleep, screenshot, collect, warn }) {
+  const written = []
+  for (let index = 0; index < count; index += 1) {
+    if (index > 0) {
+      await advance()
+      await waitForStep(index)
+    }
+    await sleep(settleMs)
+    written.push(await screenshot(index))
+    for (const line of warningsForStep(index, await collect(index))) warn(line)
+  }
+  return written
+}
diff --git a/scripts/lib/outline.mjs b/scripts/lib/outline.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..af47c329f68485f6fba99c9b98eb857ad990c41c
--- /dev/null
+++ b/scripts/lib/outline.mjs
@@ -0,0 +1,58 @@
+// The normative outline of the committed reference sample, and checks against it.
+
+export const SAMPLE_SLUG = 'how-to-make-a-presentation'
+
+export const SAMPLE_OUTLINE = [
+  { era: 'the ask', title: 'You have a topic', caption: 'It starts with you, a topic, and mild overconfidence.' },
+  { era: 'the ask', title: 'The skill interviews you', caption: 'One question at a time: the topic, the look, then each beat of the story.' },
+  { era: 'the gathering', title: 'Answers become steps', caption: 'Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next.' },
+  { era: 'the gathering', title: 'The deck grows', caption: 'Same shapes, new beats. Every answer extends the story without redrawing it.' },
+  { era: 'the gathering', title: 'You set the depth', caption: 'Spell out every step, or sketch a few and see how it looks. You hold the gate.' },
+  { era: 'the build', title: 'It assembles the scene', caption: 'Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph.' },
+  { era: 'the build', title: 'It checks its own work', caption: 'Before saying done, it builds and renders every step — and fixes what breaks.' },
+  { era: 'the loop', title: 'Changed your mind? Loop it.', caption: 'Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch.' },
+  { era: 'the reveal', title: "You're looking at one", caption: 'This presentation was built exactly this way. Thanks for watching.' },
+]
+
+/** Slugs declared in the source of `src/presentations/index.ts`. */
+export function registeredSlugs(indexSource) {
+  return [...indexSource.matchAll(/\bslug:\s*(['"`])([^'"`]+)\1/g)].map((m) => m[2])
+}
+
+/**
+ * Checks that the reference sample is registered with a loader that imports
+ * its own folder, and that the folder exists. Returns a list of problems.
+ */
+export function checkSampleRegistration(indexSource, { folderExists }) {
+  const problems = []
+  if (!folderExists) problems.push(`sample folder src/presentations/${SAMPLE_SLUG}/ is missing`)
+  const entry = indexSource
+    .split(/\n\s*\{/)
+    .find((chunk) => new RegExp(`slug:\\s*['"\`]${SAMPLE_SLUG}['"\`]`).test(chunk))
+  if (!entry) {
+    problems.push(`sample "${SAMPLE_SLUG}" is not registered in src/presentations/index.ts`)
+    return problems
+  }
+  if (!new RegExp(`load:\\s*\\(\\)\\s*=>\\s*import\\(\\s*['"\`]\\./${SAMPLE_SLUG}/[^'"\`]+['"\`]\\s*\\)`).test(entry)) {
+    problems.push(`sample "${SAMPLE_SLUG}" has no loader importing ./${SAMPLE_SLUG}/…`)
+  }
+  return problems
+}
+
+/** Compares observed `{ era, title, caption }` steps with the outline, in order. */
+export function compareOutline(observed, expected = SAMPLE_OUTLINE) {
+  const problems = []
+  if (observed.length !== expected.length) {
+    problems.push(`expected ${expected.length} steps, found ${observed.length}`)
+  }
+  expected.forEach((want, index) => {
+    const got = observed[index]
+    if (!got) return
+    for (const field of ['era', 'title', 'caption']) {
+      if (got[field] !== want[field]) {
+        problems.push(`step ${index}: ${field} is ${JSON.stringify(got[field])}, expected ${JSON.stringify(want[field])}`)
+      }
+    }
+  })
+  return problems
+}
diff --git a/scripts/lib/preview.mjs b/scripts/lib/preview.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..bed467411abd54b5a9ae447e285fc4f4f4c249d6
--- /dev/null
+++ b/scripts/lib/preview.mjs
@@ -0,0 +1,90 @@
+import { spawn, spawnSync } from 'node:child_process'
+import { createRequire } from 'node:module'
+import net from 'node:net'
+import path from 'node:path'
+
+/** Every preview, probe, and browser URL uses this IPv4 loopback address. */
+export const HOST = '127.0.0.1'
+
+export function freePort() {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer()
+    server.once('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+}
+
+export const urlFor = (port, pathname = '/') => `http://${HOST}:${port}${pathname}`
+
+async function waitUntilReady(port, child, timeoutMs) {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    if (child.exitCode !== null) throw new Error(`preview exited early with code ${child.exitCode}`)
+    try {
+      const response = await fetch(urlFor(port))
+      if (response.ok) return
+    } catch {
+      // not listening yet
+    }
+    await new Promise((resolve) => setTimeout(resolve, 100))
+  }
+  throw new Error(`preview did not become ready on ${urlFor(port)} within ${timeoutMs}ms`)
+}
+
+/** Closes the browser, then always stops the preview, even when closing the browser rejects. */
+export async function teardown({ browser, preview }) {
+  try {
+    await browser?.close()
+  } finally {
+    await preview?.stop()
+  }
+}
+
+/** Starts `vite preview` for the built app in `root`; `stop()` kills its whole process group. */
+export async function startPreview(root, { port, timeoutMs = 30000 } = {}) {
+  const chosen = port ?? (await freePort())
+  const vitePackage = createRequire(path.join(root, 'package.json')).resolve('vite/package.json')
+  const viteBin = path.join(path.dirname(vitePackage), 'bin', 'vite.js')
+  const child = spawn(process.execPath, [viteBin, 'preview', '--host', HOST, '--port', String(chosen), '--strictPort'], {
+    cwd: root,
+    detached: true,
+    stdio: 'ignore',
+  })
+  const signalGroup = (signal) => {
+    if (process.platform === 'win32') {
+      // Windows has no process groups to signal; kill the tree instead.
+      spawnSync('taskkill', ['/pid', String(child.pid), '/T', '/F'], { stdio: 'ignore' })
+      return
+    }
+    try {
+      process.kill(-child.pid, signal)
+    } catch (error) {
+      if (error.code !== 'ESRCH') throw error
+    }
+  }
+  /** SIGTERM the preview's process group, then SIGKILL it if it has not exited shortly after. */
+  const stop = async () => {
+    if (child.pid === undefined || child.exitCode !== null) return
+    const exited = new Promise((resolve) => child.once('exit', resolve))
+    signalGroup('SIGTERM')
+    let timer
+    const timeout = new Promise((resolve) => {
+      timer = setTimeout(resolve, 2000, 'timeout')
+    })
+    try {
+      if ((await Promise.race([exited, timeout])) === 'timeout') signalGroup('SIGKILL')
+    } finally {
+      clearTimeout(timer)
+    }
+  }
+  try {
+    await waitUntilReady(chosen, child, timeoutMs)
+  } catch (error) {
+    await stop()
+    throw error
+  }
+  return { port: chosen, url: (pathname) => urlFor(chosen, pathname), stop }
+}
