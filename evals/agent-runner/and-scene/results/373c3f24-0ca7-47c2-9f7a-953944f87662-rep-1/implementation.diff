@@ -0,0 +1,15 @@
+import { lazy } from 'react'
+import type { ComponentType, LazyExoticComponent } from 'react'
+import type { PresentationEntry } from './registry.ts'
+
+const cache = new WeakMap<PresentationEntry, LazyExoticComponent<ComponentType>>()
+
+/** One lazy component per registry entry, so re-rendering never re-imports or remounts. */
+export function lazyPresentation(entry: PresentationEntry): LazyExoticComponent<ComponentType> {
+  let component = cache.get(entry)
+  if (!component) {
+    component = lazy(entry.load)
+    cache.set(entry, component)
+  }
+  return component
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentations/registry.ts b/skills/presentation/templates/bootstrap/src/presentations/registry.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f18fb120eca2c1b4d4c5b882b4debd27cfa6b963
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentations/registry.ts
@@ -0,0 +1,34 @@
+import type { ComponentType } from 'react'
+
+export interface PresentationEntry {
+  slug: string
+  title: string
+  load: () => Promise<{ default: ComponentType }>
+}
+
+const SLUG = /^[a-z0-9]+(?:-[a-z0-9]+)*$/
+
+/** Returns human-readable problems; an empty list means the registry is sound. */
+export function validateRegistry(entries: readonly Partial<PresentationEntry>[]): string[] {
+  const problems: string[] = []
+  const seen = new Set<string>()
+  entries.forEach((entry, index) => {
+    const { slug, title, load } = entry
+    if (typeof slug !== 'string' || !SLUG.test(slug)) problems.push(`entry ${index}: invalid slug "${String(slug)}"`)
+    else if (seen.has(slug)) problems.push(`entry ${index}: duplicate slug "${slug}"`)
+    else seen.add(slug)
+    if (typeof title !== 'string' || title.trim() === '') problems.push(`entry ${index}: missing title`)
+    if (typeof load !== 'function') problems.push(`entry ${index}: missing loader`)
+  })
+  return problems
+}
+
+/** Route lookup: `/` and unknown paths resolve to the landing page. */
+export function resolveRoute(
+  pathname: string,
+  registry: readonly PresentationEntry[],
+): { kind: 'landing' } | { kind: 'presentation'; entry: PresentationEntry } {
+  const slug = pathname.replace(/^\/+|\/+$/g, '')
+  const entry = slug === '' ? undefined : registry.find((e) => e.slug === slug)
+  return entry ? { kind: 'presentation', entry } : { kind: 'landing' }
+}
