diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..8be70540a22394debb6ae07f674279c71b074efb
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,51 @@
+import { useEffect } from 'react'
+import { Stage } from './Stage.tsx'
+import { Attribution } from './chrome/Attribution.tsx'
+import { Footer } from './chrome/Footer.tsx'
+import { Header } from './chrome/Header.tsx'
+import { Toc } from './chrome/Toc.tsx'
+import { stepNumber } from './steps.ts'
+import type { PresentationProps } from './types.ts'
+import { usePresentationNav } from './usePresentationNav.ts'
+import { isWideViewport, useViewport } from './useFitScale.ts'
+
+/** One evolving scene stepped through `steps`, with present and browse modes. */
+export function Presentation<TPayload = undefined>({
+  steps,
+  title,
+  initialMode = 'present',
+  brand,
+  attribution = true,
+}: PresentationProps<TPayload>) {
+  const nav = usePresentationNav({ count: steps.length, initialMode })
+  const { width } = useViewport()
+  useEffect(() => {
+    document.title = title
+  }, [title])
+  const step = steps[nav.index]
+  if (!step) return null
+  const showToc = nav.mode === 'browse' && isWideViewport(width)
+
+  return (
+    <div
+      data-presentation-root=""
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      style={{ position: 'fixed', left: 0, top: 0, right: 0, bottom: 0, overflow: 'hidden' }}
+    >
+      <Header mode={nav.mode} number={stepNumber(nav.index)} era={step.era} title={step.title} brand={brand} />
+      {showToc ? <Toc steps={steps} index={nav.index} onJump={nav.goTo} /> : null}
+      <Stage step={step} stepIndex={nav.index} mode={nav.mode} showToc={showToc} />
+      <Footer
+        mode={nav.mode}
+        steps={steps}
+        index={nav.index}
+        onPrev={nav.prev}
+        onNext={nav.next}
+        onJump={nav.goTo}
+      />
+      {attribution ? <Attribution /> : null}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..683ba2697378e5821607ca4d08dd43f90799bb41
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,64 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, EXIT_T, STAGE_LAYOUT } from './constants.ts'
+import { sceneKey } from './sceneKey.ts'
+import { LayoutDependencyContext } from './nodes/entity.ts'
+import type { Mode, Step } from './types.ts'
+import { useFitScale } from './useFitScale.ts'
+
+export interface StageProps<TPayload> {
+  step: Step<TPayload>
+  stepIndex: number
+  mode: Mode
+  showToc: boolean
+}
+
+/** Fixed design canvas, scaled uniformly to the space left by the chrome. */
+export function Stage<TPayload>({ step, stepIndex, mode, showToc }: StageProps<TPayload>) {
+  const scale = useFitScale(mode, showToc)
+  const g = STAGE_LAYOUT[mode]
+  const { Scene } = step
+  return (
+    <div
+      data-presentation-stage=""
+      style={{
+        position: 'absolute',
+        top: g.top,
+        bottom: g.bottom,
+        left: g.side + (showToc ? g.tocWidth : 0),
+        right: g.side,
+      }}
+    >
+      <motion.div
+        data-presentation-canvas=""
+        data-presentation-scale={scale}
+        style={{
+          position: 'absolute',
+          left: '50%',
+          top: '50%',
+          width: DESIGN_W,
+          height: DESIGN_H,
+          // Centred with margins, not a percentage translate: motion re-measures a scaled ancestor
+          // that has one, which makes every persisting entity lurch on each step change.
+          marginLeft: -DESIGN_W / 2,
+          marginTop: -DESIGN_H / 2,
+          scale,
+        }}
+      >
+        <LayoutDependencyContext.Provider value={stepIndex}>
+          <LayoutGroup>
+            <AnimatePresence>
+              <motion.div
+                key={sceneKey(step)}
+                data-presentation-scene=""
+                style={{ position: 'absolute', left: 0, top: 0, right: 0, bottom: 0 }}
+                exit={{ opacity: 0, transition: { duration: EXIT_T } }}
+              >
+                <Scene payload={step.payload} stepIndex={stepIndex} />
+              </motion.div>
+            </AnimatePresence>
+          </LayoutGroup>
+        </LayoutDependencyContext.Provider>
+      </motion.div>
+    </div>
+  )
+}
