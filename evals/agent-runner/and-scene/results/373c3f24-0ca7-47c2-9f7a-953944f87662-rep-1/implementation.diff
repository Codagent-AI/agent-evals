+                data-presentation-toc-entry=""
+                data-presentation-active={active ? 'true' : undefined}
+                aria-current={active ? 'true' : undefined}
+                onClick={press(() => onJump(entry.firstIndex))}
+              >
+                {entry.era}
+              </button>
+            </li>
+          )
+        })}
+      </ol>
