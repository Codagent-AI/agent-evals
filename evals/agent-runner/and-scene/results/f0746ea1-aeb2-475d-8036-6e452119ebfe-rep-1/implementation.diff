diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..504237a36c01a495ed370847ea4a43336addcd7b
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,38 @@
+import type { ReactNode } from 'react'
+import { DEFAULT_ATTRIBUTION_URL, WIDE_VIEWPORT } from './constants'
+import { useFitScale } from './useFitScale'
+import { usePresentationNav } from './usePresentationNav'
+import { Stage } from './Stage'
+import { Header } from './chrome/Header'
+import { Footer } from './chrome/Footer'
+import { Toc } from './chrome/Toc'
+import type { Mode, Step } from './types'
+
+export interface PresentationProps<T> {
+  steps: readonly Step<T>[]
+  title: string
+  initialMode?: Mode
+  brand?: ReactNode
+  attribution?: false | { label?: string; href?: string }
+  className?: string
+  designWidth?: number
+  designHeight?: number
+}
+export function Presentation<T>(props: PresentationProps<T>) {
+  if (!props.steps.length) throw new Error('Presentation requires at least one step')
+  return <PresentationHost {...props} />
+}
+function PresentationHost<T>({ steps, title, initialMode = 'browse', brand, attribution, className, designWidth, designHeight }: PresentationProps<T>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const fit = useFitScale(nav.mode)
+  const wide = fit.width + fit.left + 24 >= WIDE_VIEWPORT
+  const step = steps[nav.index]
+  return <main aria-label={title} className={className} data-presentation="" data-presentation-mode={nav.mode} data-step-count={steps.length} data-step-index={nav.index} data-presentation-step-id={step.id} data-presentation-step-caption={step.caption} style={{ position: 'relative', width: '100%', height: '100dvh', overflow: 'hidden' }}>
+    <Header mode={nav.mode} step={step} index={nav.index} brand={brand} />
+    <Stage step={step} mode={nav.mode} designWidth={designWidth} designHeight={designHeight} />
+    {nav.mode === 'browse' && wide && <Toc steps={steps} index={nav.index} jump={nav.jump} />}
+    <Footer steps={steps} index={nav.index} mode={nav.mode} next={nav.next} prev={nav.prev} jump={nav.jump} />
+    <button data-presentation-mode-toggle="" aria-label={`Switch to ${nav.mode === 'browse' ? 'present' : 'browse'} mode`} onClick={nav.toggle} style={{ position: 'absolute', right: 24, top: 24 }}>{nav.mode === 'browse' ? 'Present' : 'Browse'}</button>
+    {attribution !== false && <a data-presentation-attribution="" href={attribution?.href ?? DEFAULT_ATTRIBUTION_URL} style={{ position: 'absolute', bottom: 12, right: 24 }}>{attribution?.label ?? 'made by and-scene'}</a>}
+  </main>
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d903bda72d8645c94e2080c245866212f607854a
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,30 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { useId } from 'react'
+import { DESIGN_H, DESIGN_W, EASE, LAYOUT_T } from './constants'
+import type { Mode, Step } from './types'
+import { useFitScale } from './useFitScale'
+
+const sceneIds = new WeakMap<object, number>()
+let nextSceneId = 0
+function identity(scene: object) {
+  if (!sceneIds.has(scene)) sceneIds.set(scene, nextSceneId++)
+  return sceneIds.get(scene)
+}
+
+export function Stage<T>({ step, mode, designWidth = DESIGN_W, designHeight = DESIGN_H }: { step: Step<T>; mode: Mode; designWidth?: number; designHeight?: number }) {
+  const fit = useFitScale(mode, designWidth, designHeight)
+  const namespace = useId()
+  const Scene = step.Scene
+  // Scene type is part of identity: a different component remounts even for the same group key.
+  return <div data-presentation-stage="" style={{ position: 'absolute', left: fit.left, top: fit.top, width: fit.width, height: fit.height, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
+    <div data-presentation-canvas="" style={{ position: 'relative', width: designWidth, height: designHeight, transform: `scale(${fit.scale})`, flexShrink: 0 }}>
+      <LayoutGroup id={namespace}>
+        <AnimatePresence initial={false}>
+          <motion.div key={`${step.groupKey ?? step.id}:${identity(Scene)}`} data-presentation-scene="" style={{ position: 'absolute', inset: 0 }} initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} transition={{ duration: LAYOUT_T, ease: EASE }}>
+            <Scene payload={step.payload} step={step} />
+          </motion.div>
+        </AnimatePresence>
+      </LayoutGroup>
+    </div>
+  </div>
+}
diff --git a/src/presentation-kit/chrome/Footer.tsx b/src/presentation-kit/chrome/Footer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..79093d46727d04ee90a577f3da13699e27be51aa
--- /dev/null
+++ b/src/presentation-kit/chrome/Footer.tsx
@@ -0,0 +1,13 @@
+import type { Mode, StepMeta } from '../types'
+export function Footer({ steps, index, mode, next, prev, jump }: { steps: readonly StepMeta[]; index: number; mode: Mode; next: () => void; prev: () => void; jump: (index: number) => void }) {
+  return <footer data-presentation-footer="" style={{ position: 'absolute', bottom: 44, left: 24, right: 24 }}>
+    {mode === 'present' ? <div data-presentation-title="" style={{ whiteSpace: 'nowrap' }}>{steps[index].title}</div> : <>
+      <p data-presentation-caption="">{steps[index].caption}</p>
+      <nav aria-label="Steps" data-presentation-navigation="">
+        <button data-presentation-prev="" onClick={prev} disabled={index === 0} aria-label="Previous step">Previous</button>
+        <div data-presentation-progress="">{steps.map((step, i) => <button key={step.id} aria-label={`Step ${i + 1}: ${step.title}`} aria-current={index === i ? 'step' : undefined} data-presentation-progress-entry="" data-presentation-active={index === i ? 'true' : 'false'} onClick={() => jump(i)}>{i + 1}</button>)}</div>
+        <button data-presentation-next="" onClick={next} disabled={index === steps.length - 1} aria-label="Next step">Next</button>
+      </nav>
+    </>}
+  </footer>
+}
diff --git a/src/presentation-kit/chrome/Header.tsx b/src/presentation-kit/chrome/Header.tsx
