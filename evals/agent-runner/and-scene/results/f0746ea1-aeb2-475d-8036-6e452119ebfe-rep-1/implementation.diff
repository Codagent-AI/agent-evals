diff --git a/skills/presentation/templates/bootstrap/scripts/browser.mjs b/skills/presentation/templates/bootstrap/scripts/browser.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..bdbe15aecd6c911b3f1ab7cbf038d305e01c5200
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/browser.mjs
@@ -0,0 +1,79 @@
+import { spawn } from 'node:child_process'
+import { once } from 'node:events'
+import { createServer } from 'node:net'
+import { resolve } from 'node:path'
+import { setTimeout as delay } from 'node:timers/promises'
+import { chromium } from 'playwright'
+
+export const HOST = '127.0.0.1'
+export const SETTLE_MS = 810
+export async function command(program, args, cwd = process.cwd()) {
+  const child = spawn(program, args, { cwd, stdio: 'inherit' })
+  const [code] = await once(child, 'exit')
+  if (code !== 0) throw new Error(`${program} ${args.join(' ')} exited ${code}`)
+}
+export async function preview(cwd = process.cwd()) {
+  const probe = createServer()
+  probe.listen(0, HOST)
+  await once(probe, 'listening')
+  const port = probe.address().port
+  await new Promise(resolve => probe.close(resolve))
+  const url = `http://${HOST}:${port}`
+  const child = spawn(process.execPath, [resolve(cwd, 'node_modules/vite/bin/vite.js'), 'preview', '--host', HOST, '--port', String(port), '--strictPort'], { cwd, stdio: ['ignore', 'pipe', 'pipe'] })
+  let output = ''
+  child.stdout.on('data', chunk => { output += chunk })
+  child.stderr.on('data', chunk => { output += chunk })
+  let spawnError
+  child.on('error', error => { spawnError = error })
+  const stop = async () => {
+    if (child.exitCode !== null || child.signalCode) return
+    const exited = once(child, 'exit')
+    child.kill('SIGTERM')
+    const timer = setTimeout(() => child.kill('SIGKILL'), 2000)
+    await exited
+    clearTimeout(timer)
+  }
+  try {
+    for (let i = 0; i < 100; i++) {
+      if (spawnError || child.exitCode !== null) throw new Error(`preview failed: ${spawnError ?? output}`)
+      try { if ((await fetch(url)).ok) return { url, port, stop } } catch { /* readiness retry */ }
+      await delay(100)
+    }
+    throw new Error(`preview readiness timed out: ${output}`)
+  } catch (error) { await stop(); throw error }
+}
+export async function withBrowser(cwd, callback, options = {}) {
+  const server = await preview(cwd)
+  let browser
+  const abort = () => { void browser?.close(); void server.stop() }
+  process.once('SIGINT', abort)
+  process.once('SIGTERM', abort)
+  try {
+    browser = await chromium.launch({ headless: true })
+    const page = await browser.newPage({ viewport: options.viewport ?? { width: 1440, height: 900 } })
+    page.setDefaultTimeout(5000)
+    console.log(`preview ${server.url}`)
+    return await callback(page, server.url)
+  } finally {
+    try { await browser?.close() } finally { await server.stop() }
+    process.removeListener('SIGINT', abort)
+    process.removeListener('SIGTERM', abort)
+    console.log(`preview stopped ${server.url}`)
+  }
+}
+export async function stepCount(page) {
+  const hook = page.locator('[data-presentation][data-step-count][data-step-index]')
+  await hook.waitFor()
+  const count = Number(await hook.getAttribute('data-step-count'))
+  if (!Number.isInteger(count) || count < 1) throw new Error('invalid data-step-count')
+  return { hook, count }
+}
+export async function visitSteps(page, count, hook, callback, settleMs = SETTLE_MS) {
+  for (let index = 0; index < count; index++) {
+    if (index) await page.keyboard.press('ArrowRight')
+    await page.waitForFunction(expected => document.querySelector('[data-presentation]')?.getAttribute('data-step-index') === String(expected), index, { timeout: 3000 }).catch(() => { throw new Error(`step ${index}: transition did not advance`) })
+    await page.waitForTimeout(settleMs)
+    await callback(index)
+    if (Number(await hook.getAttribute('data-step-index')) !== index) throw new Error(`step ${index}: inconsistent active index`)
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/diagnostics.mjs b/skills/presentation/templates/bootstrap/scripts/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6e294a69513cbe5450d3a189028b0a0b9eb3f117
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/diagnostics.mjs
@@ -0,0 +1,60 @@
+// Runs in the browser. Keep dependencies inside this function for page.evaluate.
+export function collectDiagnostics() {
+  const warnings = []
+  const root = document.querySelector('[data-presentation]')
+  if (!root) return ['missing presentation root']
+  const step = root.getAttribute('data-step-index')
+  const visible = element => {
+    const style = getComputedStyle(element)
+    const box = element.getBoundingClientRect()
+    if (!box.width || !box.height || style.visibility === 'hidden' || style.display === 'none') return false
+    for (let node = element; node instanceof Element; node = node.parentElement) {
+      const ancestor = getComputedStyle(node)
+      if (ancestor.opacity === '0' || ancestor.display === 'none' || ancestor.visibility === 'hidden') return false
+    }
+    return true
+  }
+  const name = element => element.getAttribute('data-presentation-entity') || element.getAttribute('aria-label') || element.textContent.trim().slice(0, 50) || element.tagName
+  // Leaf text ranges avoid treating a card's enclosing box as colliding with its own text.
+  const text = []
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
+  let node
+  while ((node = walker.nextNode())) {
+    const element = node.parentElement
+    if (!node.textContent.trim() || !visible(element) || element.closest('[data-presentation-allow-overlap]')) continue
+    const range = document.createRange()
+    range.selectNodeContents(node)
+    for (const rect of range.getClientRects()) {
+      if (rect.width && rect.height) text.push({ element, rect, kind: 'text' })
+    }
+  }
+  for (const element of root.querySelectorAll('[data-presentation-caption], [data-presentation-title], [data-presentation-marker], [data-presentation-progress-entry], [data-presentation-toc-entry], [data-presentation-prev], [data-presentation-next], [data-presentation-mode-toggle], [data-presentation-attribution]')) {
+    if (visible(element) && !element.closest('[data-presentation-allow-overlap]')) text.push({ element, rect: element.getBoundingClientRect(), kind: 'chrome' })
+  }
+  for (let i = 0; i < text.length; i++) for (let j = i + 1; j < text.length; j++) {
+    const a = text[i], b = text[j]
+    // Exclude a chrome container's own contents, not distinct text ranges in nested elements.
+    if ((a.kind === 'chrome' && a.element.contains(b.element)) || (b.kind === 'chrome' && b.element.contains(a.element))) continue
+    const x = Math.min(a.rect.right, b.rect.right) - Math.max(a.rect.left, b.rect.left)
+    const y = Math.min(a.rect.bottom, b.rect.bottom) - Math.max(a.rect.top, b.rect.top)
+    if (x > 2 && y > 2) warnings.push(`step ${step}: overlap: ${name(a.element)} / ${name(b.element)}`)
+  }
+  const signature = element => {
+    const s = getComputedStyle(element)
+    return [s.color, s.backgroundColor, s.borderColor, s.fontWeight, s.opacity, s.boxShadow, s.outline, s.transform, s.textDecoration, s.borderWidth].join(';')
+  }
+  for (const hook of ['progress-entry', 'toc-entry']) {
+    const controls = [...root.querySelectorAll(`[data-presentation-${hook}]`)].filter(visible)
+    const active = controls.find(element => element.getAttribute('data-presentation-active') === 'true')
+    const inactive = controls.filter(element => element !== active)
+    if (active && inactive.length && inactive.some(element => signature(active) === signature(element))) warnings.push(`step ${step}: indistinct active ${hook}`)
+  }
+  const attribution = root.querySelector('[data-presentation-attribution]')
+  if (!attribution || !visible(attribution)) warnings.push(`step ${step}: missing attribution; style [data-presentation-attribution]`)
+  else {
+    const s = getComputedStyle(attribution)
+    const browserDefault = (s.color === 'rgb(0, 0, 238)' || s.color === 'rgb(85, 26, 139)') && s.textDecorationLine.includes('underline')
+    if (parseFloat(s.fontSize) < 11 || browserDefault) warnings.push(`step ${step}: unpolished attribution; style [data-presentation-attribution]`)
+  }
+  return [...new Set(warnings)]
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
new file mode 100644
