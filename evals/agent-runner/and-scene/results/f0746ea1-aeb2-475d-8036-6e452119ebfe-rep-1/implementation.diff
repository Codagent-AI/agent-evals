--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,21 @@
+import { useEffect, useState } from 'react'
+import { DESIGN_H, DESIGN_W, STAGE_LAYOUT, WIDE_VIEWPORT } from './constants'
+import type { Mode } from './types'
+
+export function fitGeometry(width: number, height: number, mode: Mode, designW = DESIGN_W, designH = DESIGN_H) {
+  const layout = STAGE_LAYOUT[mode]
+  const left = layout.side + (width >= WIDE_VIEWPORT ? layout.toc : 0)
+  const availableW = Math.max(0, width - left - layout.side)
+  const availableH = Math.max(0, height - layout.top - layout.bottom)
+  return { left, top: layout.top, width: availableW, height: availableH,
+    scale: Math.max(0, Math.min(availableW / designW, availableH / designH)) }
+}
+export function useFitScale(mode: Mode, designW = DESIGN_W, designH = DESIGN_H) {
+  const [size, setSize] = useState(() => ({ width: window.innerWidth, height: window.innerHeight }))
+  useEffect(() => {
+    const resize = () => setSize({ width: window.innerWidth, height: window.innerHeight })
+    window.addEventListener('resize', resize)
+    return () => window.removeEventListener('resize', resize)
+  }, [])
+  return fitGeometry(size.width, size.height, mode, designW, designH)
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0e3c2eb42078da6963acbe5434fde73a05057d45
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,50 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import type { Mode } from './types'
+
+export function isInteractive(target: EventTarget | null) {
+  return target instanceof Element && !!target.closest('button, a, input, textarea, select, summary, audio[controls], video[controls], [tabindex], [contenteditable]:not([contenteditable="false"]), [role="button"], [role="slider"], [role="textbox"], [role="combobox"]')
+}
+export function clampIndex(index: number, count: number) {
+  return Math.max(0, Math.min(count - 1, Math.trunc(index)))
+}
+export function usePresentationNav(count: number, initialMode: Mode = 'browse') {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const touch = useRef<{x: number; y: number} | null>(null)
+  const jump = useCallback((value: number) => setIndex(clampIndex(value, count)), [count])
+  const next = useCallback(() => setIndex(value => clampIndex(value + 1, count)), [count])
+  const prev = useCallback(() => setIndex(value => clampIndex(value - 1, count)), [count])
+  const toggle = useCallback(() => setMode(value => value === 'browse' ? 'present' : 'browse'), [])
+  useEffect(() => {
+    const key = (event: KeyboardEvent) => {
+      if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || isInteractive(event.target)) return
+      if (['ArrowRight', ' ', 'PageDown'].includes(event.key)) { event.preventDefault(); next() }
+      else if (['ArrowLeft', 'PageUp'].includes(event.key)) { event.preventDefault(); prev() }
+      else if (event.key.toLowerCase() === 'p') { event.preventDefault(); toggle() }
+    }
+    const start = (event: TouchEvent) => {
+      if (isInteractive(event.target) || event.touches.length !== 1) { touch.current = null; return }
+      touch.current = { x: event.touches[0].clientX, y: event.touches[0].clientY }
+    }
+    const end = (event: TouchEvent) => {
+      const origin = touch.current
+      touch.current = null
+      if (!origin || !event.changedTouches.length) return
+      const dx = event.changedTouches[0].clientX - origin.x
+      const dy = event.changedTouches[0].clientY - origin.y
+      if (Math.abs(dx) >= 40 && Math.abs(dx) > Math.abs(dy)) { if (dx < 0) next(); else prev() }
+    }
+    const cancel = () => { touch.current = null }
+    window.addEventListener('keydown', key)
+    window.addEventListener('touchstart', start, { passive: true })
+    window.addEventListener('touchend', end, { passive: true })
+    window.addEventListener('touchcancel', cancel)
+    return () => {
+      window.removeEventListener('keydown', key)
+      window.removeEventListener('touchstart', start)
+      window.removeEventListener('touchend', end)
+      window.removeEventListener('touchcancel', cancel)
+    }
+  }, [next, prev, toggle])
+  return { index: clampIndex(index, count), mode, jump, next, prev, toggle }
+}
