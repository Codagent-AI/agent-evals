+  return <motion.div layout layoutId={id} data-presentation-node={kind} data-presentation-entity={id} transition={{ layout: { duration: LAYOUT_T, ease: EASE } }} {...props}>{Icon && <Icon aria-hidden="true" />}{children}</motion.div>
+}
