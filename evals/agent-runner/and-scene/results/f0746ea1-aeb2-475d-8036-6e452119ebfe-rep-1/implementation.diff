@@ -0,0 +1,9 @@
+import type { ReactNode } from 'react'
+import type { Mode, StepMeta } from '../types'
+export function Header({ mode, step, index, brand }: { mode: Mode; step: StepMeta; index: number; brand?: ReactNode }) {
+  return <header data-presentation-header="" style={{ position: 'absolute', top: 0, left: 0, right: 0 }}>
+    {brand && <div data-presentation-brand="">{brand}</div>}
+    <span data-presentation-marker="">{String(index + 1).padStart(2, '0')} / {step.era}</span>
+    {mode === 'browse' && <h1 data-presentation-title="">{step.title}</h1>}
+  </header>
+}
diff --git a/src/presentation-kit/chrome/Toc.tsx b/src/presentation-kit/chrome/Toc.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..820376462551ffa534a147e4e45920df77c8bd84
--- /dev/null
+++ b/src/presentation-kit/chrome/Toc.tsx
@@ -0,0 +1,7 @@
+import type { StepMeta } from '../types'
+export function Toc({ steps, index, jump }: { steps: readonly StepMeta[]; index: number; jump: (index: number) => void }) {
+  const eras = steps.flatMap((step, i) => steps.findIndex(item => item.era === step.era) === i ? [{ era: step.era, index: i }] : [])
+  return <nav aria-label="Sections" data-presentation-toc="" style={{ position: 'absolute', left: 24, top: 132, width: 160 }}>
+    {eras.map(item => <button key={item.era} data-presentation-toc-entry="" data-presentation-active={steps[index].era === item.era ? 'true' : 'false'} aria-current={steps[index].era === item.era ? 'step' : undefined} onClick={() => jump(item.index)}>{item.era}</button>)}
+  </nav>
+}
