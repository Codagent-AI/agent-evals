--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,25 @@
+import { useLayoutEffect, useState, type RefObject } from 'react'
+import { computeFitScale } from './fit.ts'
+import type { Mode } from './types.ts'
+
+/** Tracks the box of `ref` and returns the uniform scale for the active mode's stage geometry. */
+export function useFitScale(
+  ref: RefObject<HTMLElement | null>,
+  mode: Mode,
+  design?: { width: number; height: number },
+): number {
+  const [scale, setScale] = useState(1)
+  const width = design?.width
+  const height = design?.height
+  useLayoutEffect(() => {
+    const el = ref.current
+    if (!el) return
+    const d = width && height ? { width, height } : undefined
+    const update = () => setScale(computeFitScale(el.clientWidth, el.clientHeight, mode, d))
+    update()
+    const observer = new ResizeObserver(update)
+    observer.observe(el)
+    return () => observer.disconnect()
+  }, [ref, mode, width, height])
+  return scale
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bf0a9bb4b48f0d53d86769b8c6d11ffd5f5f3a4f
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,47 @@
+import { useCallback, useEffect, useRef, useState, type TouchEvent } from 'react'
+import { actionForKey, actionForSwipe, clampIndex } from './nav.ts'
+import type { Mode } from './types.ts'
+
+/** Step index + mode state with keyboard, touch, and clamped navigation. */
+export function usePresentationNav(count: number, initialMode: Mode = 'browse') {
+  const [rawIndex, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const index = clampIndex(rawIndex, count)
+
+  const goTo = useCallback((i: number) => setIndex(clampIndex(i, count)), [count])
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, count)), [count])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'browse' ? 'present' : 'browse')), [])
+
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      const action = actionForKey(event)
+      if (!action) return
+      event.preventDefault()
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else toggleMode()
+    }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [next, prev, toggleMode])
+
+  const touchStart = useRef<{ x: number; y: number } | null>(null)
+  const swipe = {
+    onTouchStart: (e: TouchEvent) => {
+      const t = e.touches[0]
+      touchStart.current = t ? { x: t.clientX, y: t.clientY } : null
+    },
+    onTouchEnd: (e: TouchEvent) => {
+      const start = touchStart.current
+      const t = e.changedTouches[0]
+      touchStart.current = null
+      if (!start || !t) return
+      const action = actionForSwipe(t.clientX - start.x, t.clientY - start.y)
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+    },
+  }
+
+  return { index, mode, goTo, next, prev, toggleMode, swipe }
+}
