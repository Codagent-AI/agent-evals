diff --git a/skills/presentation/templates/bootstrap/scripts/verify.mjs b/skills/presentation/templates/bootstrap/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b910d5db81ec2a5b023a77bfbde51d3b15fef7dc
--- /dev/null
