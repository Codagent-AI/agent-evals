+import { describe, expect, it } from 'vitest'
+import { Presentation } from './Presentation.tsx'
+import { defineStep, type AnyStep, type SceneProps } from './types.ts'
+
+interface Payload {
+  beat: number
+}
+const Scene = ({ payload }: SceneProps<Payload>) => payload.beat
+
+describe('typed step payloads', () => {
+  it('lets typed grouped steps into a step array without casts', () => {
+    const steps: AnyStep[] = [
+      defineStep({ id: 'a', era: 'e', title: 't', caption: 'c', Scene, groupKey: 'g', payload: { beat: 1 } }),
+      defineStep({ id: 'b', era: 'e', title: 't', caption: 'c', Scene, groupKey: 'g', payload: { beat: 2 } }),
+    ]
+    expect(steps).toHaveLength(2)
+  })
+
+  it('rejects payloads that do not match the scene', () => {
+    // @ts-expect-error payload.beat must be a number
+    defineStep({ id: 'a', era: 'e', title: 't', caption: 'c', Scene, payload: { beat: 'one' } })
+    // @ts-expect-error payload is required by the scene's payload type
+    defineStep({ id: 'a', era: 'e', title: 't', caption: 'c', Scene })
+    expect(true).toBe(true)
+  })
+
+  it('does not accept unchecked step objects at the <Presentation> boundary', () => {
+    // Type-level only: never invoked.
+    const bypass = () =>
+      Presentation({
+        title: 'x',
+        // @ts-expect-error raw step objects skip the payload check, so they are not AnyStep
+        steps: [{ id: 'a', era: 'e', title: 't', caption: 'c', Scene, payload: { beat: 'not a number' } }],
+      })
+    expect(typeof bypass).toBe('function')
+  })
+})
diff --git a/src/presentation-kit/types.ts b/src/presentation-kit/types.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c4060018857cde273639b10c925b62cd810d7f48
--- /dev/null
+++ b/src/presentation-kit/types.ts
@@ -0,0 +1,48 @@
+import { createElement, type ComponentType, type ReactElement } from 'react'
+
+export type Mode = 'browse' | 'present'
+
+/** Narration and identity carried by every step. */
+export interface StepMeta {
+  /** Stable identity; survives reordering. */
+  id: string
+  /** Section / era label used by the table of contents. */
+  era: string
+  /** Presenter title (one-liner). */
+  title: string
+  /** Browse caption (paragraph). */
+  caption: string
+}
+
+export interface SceneProps<TPayload = undefined> {
+  payload: TPayload
+  /** Zero-based index of the active step. */
+  stepIndex: number
+}
+
+export interface Step<TPayload = undefined> extends StepMeta {
+  Scene: ComponentType<SceneProps<TPayload>>
+  /**
+   * Adjacent steps sharing a `groupKey` (and `Scene`) keep one mounted scene
+   * instance; only `payload` changes, so entities update in place.
+   */
+  groupKey?: string
+  payload: TPayload
+}
+
+/**
+ * A step with its scene and payload bound together and their types erased, so a
+ * presentation can hold steps with different payload types. The only way to make
+ * one is `defineStep`, which checks `payload` against the scene's payload type.
+ */
+export interface AnyStep extends StepMeta {
+  groupKey?: string
+  /** Renders the bound scene for the active step. */
+  render: (stepIndex: number) => ReactElement
+}
+
+/** Binds a step's `Scene` to its `payload` (type-checked) and returns a step `<Presentation>` accepts without casts. */
+export function defineStep<TPayload>(step: Step<TPayload>): AnyStep {
+  const { Scene, payload, ...rest } = step
+  return { ...rest, render: (stepIndex) => createElement(Scene, { payload, stepIndex }) }
+}
diff --git a/src/presentation-kit/useFitScale.ts b/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dcb0c5a1991df5d229b0c96054c094c7e78fe3ac
--- /dev/null
+++ b/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,25 @@
+import { useLayoutEffect, useState, type RefObject } from 'react'
+import { computeFitScale } from './fit.ts'
+import type { Mode } from './types.ts'
+
+/** Tracks the box of `ref` and returns the uniform scale for the active mode's stage geometry. */
+export function useFitScale(
+  ref: RefObject<HTMLElement | null>,
+  mode: Mode,
+  design?: { width: number; height: number },
+): number {
+  const [scale, setScale] = useState(1)
+  const width = design?.width
+  const height = design?.height
+  useLayoutEffect(() => {
+    const el = ref.current
+    if (!el) return
+    const d = width && height ? { width, height } : undefined
+    const update = () => setScale(computeFitScale(el.clientWidth, el.clientHeight, mode, d))
+    update()
+    const observer = new ResizeObserver(update)
+    observer.observe(el)
+    return () => observer.disconnect()
+  }, [ref, mode, width, height])
+  return scale
+}
diff --git a/src/presentation-kit/usePresentationNav.ts b/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bf0a9bb4b48f0d53d86769b8c6d11ffd5f5f3a4f
--- /dev/null
+++ b/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,47 @@
+import { useCallback, useEffect, useRef, useState, type TouchEvent } from 'react'
+import { actionForKey, actionForSwipe, clampIndex } from './nav.ts'
+import type { Mode } from './types.ts'
+
+/** Step index + mode state with keyboard, touch, and clamped navigation. */
+export function usePresentationNav(count: number, initialMode: Mode = 'browse') {
+  const [rawIndex, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const index = clampIndex(rawIndex, count)
+
+  const goTo = useCallback((i: number) => setIndex(clampIndex(i, count)), [count])
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, count)), [count])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'browse' ? 'present' : 'browse')), [])
+
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      const action = actionForKey(event)
+      if (!action) return
+      event.preventDefault()
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else toggleMode()
+    }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [next, prev, toggleMode])
+
+  const touchStart = useRef<{ x: number; y: number } | null>(null)
+  const swipe = {
+    onTouchStart: (e: TouchEvent) => {
+      const t = e.touches[0]
+      touchStart.current = t ? { x: t.clientX, y: t.clientY } : null
+    },
+    onTouchEnd: (e: TouchEvent) => {
+      const start = touchStart.current
+      const t = e.changedTouches[0]
+      touchStart.current = null
+      if (!start || !t) return
+      const action = actionForSwipe(t.clientX - start.x, t.clientY - start.y)
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+    },
+  }
+
+  return { index, mode, goTo, next, prev, toggleMode, swipe }
+}
diff --git a/src/presentations/how-to-make-a-presentation/Scene.tsx b/src/presentations/how-to-make-a-presentation/Scene.tsx
