index 0000000000000000000000000000000000000000..fde208c9946ea0208ff7c3745713b2674732fea2
--- /dev/null
+++ b/skills/presentation/SKILL.md
@@ -0,0 +1,137 @@
+---
+name: presentation
+description: Create or modify a browser presentation that works as one evolving diagram (stable entities moving through named steps), from a topic. Self-bootstraps the Vite/React/TypeScript scaffold and scene kit when missing, then builds, renders, and visually inspects the result before reporting done. Use when asked to make, build, update, or edit a presentation, talk, or evolving-diagram deck.
+---
+
+# Presentation skill
+
+A presentation is **one scene** moving through ordered, named **steps**, not a deck of
+slides. Entities keep a stable identity (`layoutId`), so a box that exists in two steps
+morphs in place; entities that only exist in one step enter or exit. Each step carries an
+id, an era (section) label, a one-line title (present mode), and a caption paragraph
+(browse mode).
+
+"Presentation" is the canonical term; "talk" is informal. (`Talk.tsx` is just the
+per-presentation entry component's filename.)
+
+## Paths
+
+Resolve every template and helper path **relative to this `SKILL.md` file's directory**
+(call it `$SKILL`), never relative to the user's working directory:
+
+- `$SKILL/scripts/scaffold.mjs`: detect / scaffold / create / list helper (Node, no deps)
+- `$SKILL/templates/bootstrap/`: full app snapshot used only to bootstrap a project
+- `$SKILL/templates/presentation/`: files for one new presentation (`{{placeholders}}`)
+
+## Procedure
+
+### 1. Gather (one question at a time)
+
+Ask for what is missing, **one question per message**: the topic, the visual style, then
+each step's content and visual description. Do not invent details the user can still give.
+If the prompt already has topic, style, and all steps, proceed without questions. The user
+controls depth: if they choose to build with partial detail, build from what you have and
+iterate; do not block on completeness. For a key or complex step you may draw an ASCII
+mockup and ask the user to confirm the layout, but not for every step.
+
+### 2. Resolve the target and scaffold what is missing
+
+Run `node $SKILL/scripts/scaffold.mjs detect <project-dir>`. It reports the resolved
+`target`, whether it is a monorepo, and the three **contract anchors**:
+
+1. **build**: Vite + React + TypeScript app with a working `npm run build`
+2. **kit**: the scene kit in `src/presentation-kit/` (exports `Presentation`)
+3. **index**: the presentation registry `src/presentations/index.ts`
+
+Detection is contract-level (anchor present or not), so cosmetic differences never
+trigger a re-scaffold.
+
+- All anchors present: skip scaffolding; go to step 3.
+- None or some present: scaffold only what is missing, never overwriting existing files.
+- Target: a standalone or empty project scaffolds at its root; a monorepo (`workspaces`,
+  `pnpm-workspace.yaml`, or `packages/` / `apps/`) gets a self-contained app in
+  `presentations/` and its root is left untouched; inside an existing presentation app, use
+  that app.
+- If the project is **non-empty** and lacks the kit or index (`needsConfirmation: true`),
+  **state the target directory and wait for the user to confirm before writing anything.**
+- Then: `node $SKILL/scripts/scaffold.mjs scaffold <project-dir> --install` (add
+  `--confirm` once the user approved). It merges the full dependency set (react,
+  react-dom, motion, lucide-react, vite, @vitejs/plugin-react, typescript and @types/\*,
+  the eslint stack, playwright) without assuming any is installed, and runs `npm install`.
+  Do not assume Chromium is present: if the render check cannot launch a browser, run
+  `npx playwright install chromium`.
+- Files the helper reports as `skipped` already existed **before this run** (for example
+  an existing `src/main.tsx` in a project that had its own entry); wire those by hand to the
+  router in `templates/bootstrap/src/App.tsx`. A fresh scaffold lists nothing as skipped.
+- A fresh scaffold also adds and registers a small `getting-started` starter presentation, and
+  `scripts/verify.config.json` names it as the reference that `npm run verify` checks. Keep it,
+  or delete its folder and registry line and point `verify.config.json` at a presentation of
+  yours (slug plus the exact titles and captions of its steps).
+- The scaffold has no `npm test`; the gates are `build`, `lint`, `verify`, and `inspect`.
+
+The scaffold is **styling-framework-neutral**: no Tailwind, theme, colors, fonts, card or
+button styles. Add a styling framework only if the host already uses one or the user asks.
+
+### 3. Generate or modify
+
+**Create**: `node $SKILL/scripts/scaffold.mjs new <slug> "<Title>" <project-dir>`. This
+writes `src/presentations/<slug>/` (`entities.ts`, `Scene.tsx`, `steps.ts`, `Talk.tsx`,
+`styles.css`) and registers it in `src/presentations/index.ts`, leaving other presentations
+untouched. Then edit those files for the gathered content:
+
+- Captions: if the user gave no caption text, ask for it or write one short caption per
+  step and say so; never leave the template's "Describe this step." placeholders.
+- `entities.ts`: the presentation's `layoutId` namespace and canvas geometry (880 × 380).
+- `Scene.tsx` / `steps.ts`: compose kit primitives (`Box`, `Label`, `Arrow`, `Frame`,
+  `Emphasis`, `SymbolChip`, `SceneLayer`) from `src/presentation-kit`. Steps in one
+  `groupKey` with the same `Scene` keep a single mounted scene, so only `payload` changes.
+  Wrap **newcomers** in `<Appear>`; never wrap entities that continue. Give every direct
+  child of `<SceneLayer>` a unique `key` (needed for exit animations). Accumulate or
+  transform entities rather than redrawing them.
+- `styles.css`: **all visual design lives here** (or in the host's CSS), targeting the kit's
+  `data-presentation-*` hooks, `data-active`, and `aria-current`. Plain CSS by default.
+  Give the active progress dot and ToC entry a visibly distinct look and make the
+  attribution (`[data-presentation-attribution]`) legible. Never put colors, fonts,
+  borders, or theme tokens in `src/presentation-kit/`.
+- Mark an intentional, readable overlap with `data-presentation-allow-overlap` on that
+  subtree only. The attribute must reach a DOM element (`Box`, `Label`, `Frame`, `Emphasis`,
+  and `SymbolChip` pass extra props through; otherwise wrap the subtree in a `<div>`).
+  DOM order decides stacking: an overlapping element drawn *under* a later sibling can be
+  unreadable yet raise no warning, so always look at the screenshot of a marked overlap.
+
+**Modify**: if the target is unnamed or ambiguous, run `scaffold.mjs list` and ask which
+presentation to change before editing anything. Then ask only about the requested change
+(steps, entities, or style) and edit that presentation in place; do not re-run the create
+flow, and leave other presentations and the shared kit alone.
+
+### 4. Self-verify before saying done
+
+Fix failures yourself and re-check; never report success while a check fails.
+
+1. `npm run build` (no type errors).
+2. Render: `npm run verify` (builds, then steps every registered presentation in
+   Chromium, failing on console/page errors and non-advancing steps). At minimum the first
+   step must render with no runtime or console errors.
+3. Visual composition: run `npm run inspect -- <slug>` (project-local helper; screenshots
+   land in `.presentation-inspect/<slug>/step-NN.png`, captured after animations settle) and
+   **look at** the first step, the last step, and any dense or key steps; also a narrow
+   viewport (`npm run inspect -- <slug> --viewport 390x844`, saved separately in
+   `.presentation-inspect/<slug>-390x844/`) for responsive-sensitive presentations. Confirm important content fits the canvas, intentional overlaps stay
+   readable, and nothing collides with captions, progress dots, ToC, or nav controls.
+   If no helper exists, write any temporary Playwright script **inside the project root**
+   so it resolves local dependencies.
+4. Review every advisory warning the helper prints (`overlap`, `active-nav`,
+   `attribution`). The overlap check compares text with text and chrome, so it can miss a
+   label crossing a box border: the screenshots remain the authority. Fix accidental collisions, make the active chrome distinct, polish the
+   attribution via its hook (avoid `transform: scale` on dots or ToC entries: it makes
+   neighbours touch and trips the overlap check), and only mark genuinely intentional readable overlaps with
+   `data-presentation-allow-overlap`. Re-run until every warning is resolved or explained in your report (what overlaps, and why it is intentional and readable).
+5. Report the final build, render, and visual-check results and any remaining advisory
+   warnings accurately.
+
+## Quality bar
+
+Every presentation builds with no type errors, renders its first step with no runtime or
+console errors, shows a caption per step, supports next/previous (keys, swipe, buttons,
+progress dots, ToC), passes the visual composition check, and follows the evolving-scene
+model above. Keep generated build output, `node_modules`, and screenshots out of git.
diff --git a/skills/presentation/scripts/scaffold.mjs b/skills/presentation/scripts/scaffold.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..29af909a6cfcef2898dedc8c0a1f7005e11c4f3b
--- /dev/null
+++ b/skills/presentation/scripts/scaffold.mjs
@@ -0,0 +1,249 @@
+#!/usr/bin/env node
+// Presentation skill helper: detect scaffold anchors, scaffold what is missing, add presentations.
+// Zero dependencies. Templates resolve relative to this file's skill directory, never the caller's cwd.
+//
+//   node scaffold.mjs detect   [dir]                        -> JSON report (writes nothing)
+//   node scaffold.mjs scaffold [dir] [--confirm] [--install] -> scaffold missing anchors
+//   node scaffold.mjs new <slug> "<title>" [dir]            -> create and register a presentation
+//   node scaffold.mjs list     [dir]                        -> registered presentations (JSON)
+import { spawnSync } from 'node:child_process'
+import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, writeFileSync } from 'node:fs'
+import { dirname, join, relative, resolve, sep } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const SKILL_DIR = resolve(dirname(fileURLToPath(import.meta.url)), '..')
+const BOOTSTRAP = join(SKILL_DIR, 'templates', 'bootstrap')
+const PRESENTATION_TEMPLATE = join(SKILL_DIR, 'templates', 'presentation')
+
+const readText = (p) => readFileSync(p, 'utf8')
+const readPkg = (dir) => {
+  const path = join(dir, 'package.json')
+  if (!existsSync(path)) return null
+  try {
+    return JSON.parse(readText(path))
+  } catch (e) {
+    throw new Error(`invalid JSON in ${path}: ${e.message}`)
+  }
+}
+
+function walk(dir) {
+  return readdirSync(dir).flatMap((name) => {
+    const p = join(dir, name)
+    return statSync(p).isDirectory() ? walk(p) : [p]
+  })
+}
+
+const SOURCE_FILE = /\.(ts|tsx)$/
+const sourceFiles = (app) => (existsSync(join(app, 'src')) ? walk(join(app, 'src')).filter((f) => SOURCE_FILE.test(f) && !/\.test\./.test(f)) : [])
+
+/** Registry contract: a module mapping `slug` + `title` to a lazy `load: () => import(...)`, whatever it is named. */
+const isRegistry = (text) =>
+  /\bexport\s+(const|let)\s+PRESENTATIONS\b/.test(text) || (/\bslug\s*:/.test(text) && /\bload\s*:/.test(text) && /\bimport\s*\(/.test(text))
+/** Kit contract: a module that exports a `Presentation` host. */
+const isKitHost = (text) => /\bexport\s+(function|const)\s+Presentation\b|\bexport\s*\{[^}]*\bPresentation\b[^}]*\}/.test(text)
+
+const registryPath = (app) => sourceFiles(app).find((f) => isRegistry(readText(f)))
+
+/** The module a presentation imports the kit from: the kit directory's index when there is one. */
+function kitEntry(app) {
+  const host = sourceFiles(app).find((f) => isKitHost(readText(f)))
+  if (!host) return undefined
+  const index = ['index.ts', 'index.tsx'].map((n) => join(dirname(host), n)).find(existsSync)
+  return index ?? host
+}
+
+const appEntryResolves = (app) => {
+  const html = existsSync(join(app, 'index.html')) ? readText(join(app, 'index.html')) : ''
+  const entry = /<script[^>]*\bsrc="([^"]+)"/.exec(html)?.[1]
+  return Boolean(entry) && existsSync(join(app, entry.replace(/^\//, '')))
+}
+
+/** Contract-level anchor detection: keyed on what the files provide, not on file names or formatting. */
+export function detectAnchors(app) {
+  const pkg = readPkg(app)
+  const deps = { ...pkg?.dependencies, ...pkg?.devDependencies }
+  return {
+    build: Boolean(pkg?.scripts?.build && deps.vite && deps.react && deps.typescript && existsSync(join(app, 'tsconfig.json')) && appEntryResolves(app)),
+    kit: Boolean(kitEntry(app)),
+    index: Boolean(registryPath(app)),
+  }
+}
+
+const isMonorepo = (dir) => {
+  const pkg = readPkg(dir)
+  return Boolean(pkg?.workspaces) || existsSync(join(dir, 'pnpm-workspace.yaml')) || ['packages', 'apps'].some((d) => existsSync(join(dir, d)))
+}
+
+const isEmpty = (dir) => !existsSync(dir) || readdirSync(dir).every((n) => n === '.git')
+
+/** Resolves where the presentation app belongs: an existing app, `presentations/` in a monorepo, or the root. */
+export function resolveTarget(dir) {
+  const here = detectAnchors(dir)
+  if (here.kit || here.index) return dir
+  const nested = join(dir, 'presentations')
+  const inNested = existsSync(nested) ? detectAnchors(nested) : null
+  if (inNested && (inNested.build || inNested.kit || inNested.index)) return nested
+  return isMonorepo(dir) ? nested : dir
+}
+
+export function detect(dir) {
+  const target = resolveTarget(dir)
+  const anchors = detectAnchors(target)
+  const missing = Object.keys(anchors).filter((k) => !anchors[k])
+  const monorepo = isMonorepo(dir)
+  const nonEmpty = !isEmpty(dir)
+  return {
+    projectDir: dir,
+    target,
+    monorepo,
+    empty: !nonEmpty,
+    anchors,
+    missing,
+    needsScaffold: missing.length > 0,
+    // A non-empty project missing the kit or index must be confirmed with the user before any write.
+    needsConfirmation: nonEmpty && (!anchors.kit || !anchors.index),
+  }
+}
+
+const TOOLING = ['scripts/lib.mjs', 'scripts/verify.mjs', 'scripts/inspect-presentation.mjs']
+// The app entry (and the shell it imports) belongs to the build anchor: index.html cannot build without it.
+const ENTRY_FILES = ['src/main.tsx', 'src/App.tsx', 'src/Landing.tsx', 'src/routes.ts', 'src/index.css']
+const BUILD_FILES = ['tsconfig.json', 'tsconfig.app.json', 'tsconfig.node.json', 'vite.config.ts', 'eslint.config.js', 'index.html', '.npmrc', 'public/favicon.svg']
+const INDEX_FILES = ['scripts/verify.config.json']
+
+function filesFor(anchor) {
+  const all = walk(BOOTSTRAP).map((f) => relative(BOOTSTRAP, f))
+  if (anchor === 'build') return [...BUILD_FILES, ...ENTRY_FILES]
+  if (anchor === 'kit') return all.filter((f) => f.startsWith('src/presentation-kit/'))
+  return [...INDEX_FILES, ...(anchor === 'index' ? ENTRY_FILES : []), ...all.filter((f) => f.startsWith('src/presentations/'))]
+}
+
+function copyIfMissing(rel, app, report) {
+  const to = join(app, rel)
+  if (report.created.includes(rel)) return
+  if (existsSync(to)) return report.skipped.push(rel)
+  mkdirSync(dirname(to), { recursive: true })
+  writeFileSync(to, readText(join(BOOTSTRAP, rel)))
+  report.created.push(rel)
+}
+
+function mergePackage(app, report) {
+  const template = readPkg(BOOTSTRAP)
+  const path = join(app, 'package.json')
+  const pkg = readPkg(app) ?? { name: 'presentations', private: true, version: '0.0.0', type: 'module' }
+  pkg.scripts ??= {}
+  pkg.dependencies ??= {}
+  pkg.devDependencies ??= {}
+  const added = []
+  for (const [name, cmd] of Object.entries(template.scripts)) {
+    if (!(name in pkg.scripts)) (pkg.scripts[name] = cmd), added.push(`script:${name}`)
+  }
+  for (const section of ['dependencies', 'devDependencies']) {
+    for (const [name, version] of Object.entries(template[section])) {
+      if (!(name in pkg.dependencies) && !(name in pkg.devDependencies)) (pkg[section][name] = version), added.push(name)
+    }
+  }
+  if (added.length || !existsSync(path)) {
+    writeFileSync(path, `${JSON.stringify(pkg, null, 2)}\n`)
+    report.merged.push(`package.json (+${added.join(', ') || 'created'})`)
+  }
+}
+
+function mergeGitignore(app, report) {
+  const path = join(app, '.gitignore')
+  const have = existsSync(path) ? readText(path).split('\n') : []
+  const missing = readText(join(BOOTSTRAP, '.gitignore')).split('\n').filter((l) => l && !have.includes(l))
+  if (!missing.length) return
+  writeFileSync(path, `${have.join('\n').replace(/\n*$/, '\n')}${missing.join('\n')}\n`)
+  report.merged.push(`.gitignore (+${missing.join(', ')})`)
+}
+
+export function scaffold(dir, { install = false, confirm = false } = {}) {
+  const info = detect(dir)
+  const report = { ...info, created: [], skipped: [], merged: [], installed: false }
+  if (!info.needsScaffold) return report
+  if (info.needsConfirmation && !confirm) return { ...report, written: false }
+  const app = info.target
+  mkdirSync(app, { recursive: true })
+  mergePackage(app, report)
+  mergeGitignore(app, report)
+  if (!existsSync(join(app, 'package-lock.json')) && !info.anchors.build) copyIfMissing('package-lock.json', app, report)
+  for (const anchor of info.missing) filesFor(anchor).forEach((rel) => copyIfMissing(rel, app, report))
+  TOOLING.forEach((rel) => copyIfMissing(rel, app, report))
+  if (install) {
+    const res = spawnSync('npm', ['install'], { cwd: app, stdio: 'inherit' })
+    report.installed = res.status === 0
+    if (!report.installed) report.installError = `npm install exited with ${res.status}`
+  }
+  return { ...report, written: true }
+}
+
+const render = (text, values) => text.replace(/\{\{(\w+)\}\}/g, (m, k) => (k in values ? values[k] : m))
+
+const stringProp = (block, name) => {
+  const m = new RegExp(`\\b${name}\\s*:\\s*(['"\`])((?:\\\\.|(?!\\1).)*)\\1`, 's').exec(block)
+  return m?.[2].replace(/\\(['"`])/g, '$1')
+}
+
+export function listPresentations(dir) {
+  const path = registryPath(resolveTarget(dir))
+  if (!path) return []
+  return [...readText(path).matchAll(/\{[^{}]*\bslug\s*:[^{}]*\}/g)]
+    .map((m) => ({ slug: stringProp(m[0], 'slug'), title: stringProp(m[0], 'title') ?? '' }))
+    .filter((p) => p.slug)
+}
+
+export function newPresentation(dir, slug, title) {
+  if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug)) throw new Error(`slug must be lowercase kebab-case, got "${slug}"`)
+  const app = resolveTarget(dir)
+  const anchors = detectAnchors(app)
+  if (!anchors.kit || !anchors.index) throw new Error(`scaffold first: missing anchors at ${app}: ${Object.keys(anchors).filter((k) => !anchors[k]).join(', ')}`)
+  const path = registryPath(app)
+  const folder = join(dirname(path), slug)
+  if (existsSync(folder) || listPresentations(dir).some((p) => p.slug === slug)) throw new Error(`presentation "${slug}" already exists`)
+  const safeTitle = title.replace(/[\\'"<>&{}`]|\*\/|[\r\n]+/g, ' ').replace(/\s+/g, ' ').trim()
+  const values = { slug, title: safeTitle }
+  ;[1, 2, 3].forEach((n) => Object.assign(values, { [`era${n}`]: 'start', [`title${n}`]: `Step ${n}`, [`caption${n}`]: 'Describe this step.' }))
+  // Templates import the kit as `../../presentation-kit/index.ts`; point that at wherever this project keeps it.
+  const kit = kitEntry(app)
+  let kitImport = relative(folder, kit).split(sep).join('/')
+  if (!kitImport.startsWith('.')) kitImport = `./${kitImport}`
+  for (const file of walk(PRESENTATION_TEMPLATE)) {
+    const to = join(folder, relative(PRESENTATION_TEMPLATE, file))
+    mkdirSync(dirname(to), { recursive: true })
+    writeFileSync(to, render(readText(file), values).replaceAll('../../presentation-kit/index.ts', kitImport))
+  }
+  const source = readText(path)
+  const entry = `  {\n    slug: '${slug}',\n    title: '${safeTitle}',\n    load: () => import('./${slug}/Talk.tsx'),\n  },\n`
+  const end = source.lastIndexOf('\n]')
+  if (!/PRESENTATIONS[^=]*=\s*\[/.test(source) || end < 0) throw new Error(`could not register "${slug}": add it to ${relative(app, path)} by hand`)
+  writeFileSync(path, `${source.slice(0, end + 1)}${entry}${source.slice(end + 1)}`)
+  return { app, folder, registry: path, slug }
+}
+
+function main(argv) {
+  const [cmd, ...rest] = argv
+  const flags = rest.filter((a) => a.startsWith('--'))
+  const args = rest.filter((a) => !a.startsWith('--'))
+  const out = (value) => console.log(JSON.stringify(value, null, 2))
+  if (cmd === 'detect') return out(detect(resolve(args[0] ?? '.')))
+  if (cmd === 'scaffold') {
+    const report = scaffold(resolve(args[0] ?? '.'), { install: flags.includes('--install'), confirm: flags.includes('--confirm') })
+    out(report)
+    if (report.needsScaffold && report.written === false) process.exitCode = 2
+    return
+  }
+  if (cmd === 'new' && args[0] && args[1]) return out(newPresentation(resolve(args[2] ?? '.'), args[0], args[1]))
+  if (cmd === 'list') return out(listPresentations(resolve(args[0] ?? '.')))
+  console.error('usage: scaffold.mjs detect|scaffold|new|list (see header comment)')
+  process.exitCode = 1
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  try {
+    main(process.argv.slice(2))
+  } catch (e) {
+    console.error(`error: ${e.message}`)
+    process.exitCode = 1
+  }
+}
