+        const active = g.indices.includes(index)
+        return (
+          <button
+            key={g.firstIndex}
+            type="button"
+            data-presentation-toc-entry=""
+            data-presentation-active={active ? 'true' : undefined}
+            aria-current={active ? 'step' : undefined}
+            onClick={() => onJump(g.firstIndex)}
+          >
+            {g.era}
+          </button>
+        )
+      })}
+    </nav>
+  )
+}
