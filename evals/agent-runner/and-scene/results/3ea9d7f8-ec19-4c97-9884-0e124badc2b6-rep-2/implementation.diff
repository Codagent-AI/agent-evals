+import type { ReactNode } from 'react'
+import { DESIGN_H, DESIGN_W } from './constants.ts'
+import type { Mode } from './constants.ts'
+import { Attribution } from './chrome/Attribution.tsx'
+import type { AttributionOptions } from './chrome/Attribution.tsx'
+import { Footer } from './chrome/Footer.tsx'
+import { Header } from './chrome/Header.tsx'
+import { Toc } from './chrome/Toc.tsx'
+import { isWide } from './fit.ts'
+import { Stage } from './Stage.tsx'
+import type { Step } from './types.ts'
+import { usePresentationNav } from './usePresentationNav.ts'
+import { useViewport } from './useViewport.ts'
+
+export interface PresentationProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  title: string
+  initialMode?: Mode
+  /** Override the 880 × 380 design canvas. */
+  canvas?: { width: number; height: number }
+  /** Host-provided header brand; the kit renders none by default. */
+  brand?: ReactNode
+  /** Attribution link options, or null to omit it. */
+  attribution?: AttributionOptions | null
+}
+
+export function Presentation<TPayload>({
+  steps, title, initialMode = 'present', canvas = { width: DESIGN_W, height: DESIGN_H }, brand, attribution = {},
+}: PresentationProps<TPayload>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const viewport = useViewport()
+  const step = steps[nav.index]
+  if (!step) return null
+  return (
+    <div
+      data-presentation-root=""
+      data-presentation-title-text={title}
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+    >
+      <Stage steps={steps} index={nav.index} mode={nav.mode} canvas={canvas} />
+      <Header step={step} index={nav.index} count={steps.length} mode={nav.mode} brand={brand} onToggleMode={nav.toggleMode} />
+      {nav.mode === 'browse' && isWide(viewport.width) ? <Toc steps={steps} index={nav.index} onJump={nav.goTo} /> : null}
+      <Footer steps={steps} index={nav.index} mode={nav.mode} onPrev={nav.prev} onNext={nav.next} onJump={nav.goTo} />
+      {attribution ? <Attribution {...attribution} /> : null}
+    </div>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..bc86259448155cadc5f7518d670182df6a59ce81
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
@@ -0,0 +1,58 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, ENTER_T, STAGE_LAYOUT } from './constants.ts'
+import type { Mode } from './constants.ts'
+import { isWide } from './fit.ts'
+import type { Step } from './types.ts'
+import { useFitScale } from './useFitScale.ts'
+import type { Canvas } from './useFitScale.ts'
+import { sceneKey } from './sceneKey.ts'
+import { useViewport } from './useViewport.ts'
+
+export interface StageProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  index: number
+  mode: Mode
+  canvas?: Canvas
+}
+
+export function Stage<TPayload>({ steps, index, mode, canvas = { width: DESIGN_W, height: DESIGN_H } }: StageProps<TPayload>) {
+  const scale = useFitScale(mode, canvas)
+  const viewport = useViewport()
+  const g = STAGE_LAYOUT[mode]
+  const step = steps[index]
+  const left = g.side + (isWide(viewport.width) ? g.tocWidth : 0)
+
+  return (
+    <div
+      data-presentation-stage=""
+      style={{
+        position: 'fixed', left, right: g.side, top: g.top, bottom: g.bottom,
+        display: 'flex', alignItems: 'center', justifyContent: 'center',
+      }}
+    >
+      <div style={{ width: canvas.width * scale, height: canvas.height * scale, position: 'relative', flex: 'none' }}>
+        <div
+          data-presentation-canvas=""
+          data-presentation-scale={scale}
+          style={{ position: 'absolute', left: 0, top: 0, width: canvas.width, height: canvas.height, transformOrigin: 'top left', transform: `scale(${scale})` }}
+        >
+          <LayoutGroup>
+            <AnimatePresence initial={false}>
+              <motion.div
+                key={sceneKey(step)}
+                initial={{ opacity: 0 }}
+                animate={{ opacity: 1 }}
+                exit={{ opacity: 0 }}
+                transition={{ duration: ENTER_T }}
+                style={{ position: 'absolute', inset: 0 }}
+                data-presentation-scene=""
+              >
+                <step.Scene payload={step.payload} step={step} index={index} />
+              </motion.div>
+            </AnimatePresence>
+          </LayoutGroup>
+        </div>
+      </div>
+    </div>
+  )
+}
