+import { DESIGN_H, DESIGN_W } from './constants.ts'
+import type { Mode } from './constants.ts'
+import { availableStageSize, computeFitScale } from './fit.ts'
+import { useViewport } from './useViewport.ts'
+
+export interface Canvas {
+  width: number
+  height: number
+}
+
+/**
+ * Scale for the active mode's stage geometry. Depends only on mode, viewport and
+ * canvas, never on the active step, so morphs between steps stay undistorted.
+ */
+export function useFitScale(mode: Mode, canvas: Canvas = { width: DESIGN_W, height: DESIGN_H }): number {
+  const viewport = useViewport()
+  return computeFitScale(availableStageSize(mode, viewport), canvas)
+}
diff --git a/src/presentation-kit/usePresentationNav.ts b/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ab4375aefe15615732759ce947849338fc60aaf2
--- /dev/null
+++ b/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,97 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { SWIPE_MIN_PX } from './constants.ts'
+import type { Mode } from './constants.ts'
+
+const NEXT_KEYS = new Set(['ArrowRight', ' ', 'PageDown'])
+const PREV_KEYS = new Set(['ArrowLeft', 'PageUp'])
+const INTERACTIVE_TAGS = new Set(['BUTTON', 'A', 'INPUT', 'SELECT', 'TEXTAREA', 'SUMMARY'])
+const INTERACTIVE_ROLES = new Set([
+  'button', 'link', 'tab', 'menuitem', 'menuitemcheckbox', 'menuitemradio', 'option', 'checkbox', 'radio',
+  'switch', 'slider', 'spinbutton', 'textbox', 'combobox', 'listbox', 'searchbox', 'scrollbar', 'treeitem',
+])
+
+function isInteractive(target: EventTarget | null): boolean {
+  const start = target instanceof Element ? target : null
+  for (let n: Element | null = start; n; n = n.parentElement) {
+    if (INTERACTIVE_TAGS.has(n.tagName)) return true
+    const editable = n.getAttribute('contenteditable')
+    if (editable !== null && editable !== 'false') return true
+    const role = n.getAttribute('role')
+    if (role && INTERACTIVE_ROLES.has(role)) return true
+  }
+  return false
+}
+
+export type KeyAction = 'next' | 'prev' | 'toggle-mode' | null
+
+/** What a keydown means for the deck; null when it belongs to someone else. */
+export function keyAction(e: Pick<KeyboardEvent, 'key' | 'ctrlKey' | 'altKey' | 'metaKey' | 'target'>): KeyAction {
+  if (e.ctrlKey || e.altKey || e.metaKey) return null
+  const action: KeyAction = NEXT_KEYS.has(e.key) ? 'next' : PREV_KEYS.has(e.key) ? 'prev' : e.key === 'p' || e.key === 'P' ? 'toggle-mode' : null
+  if (!action) return null
+  if (isInteractive(e.target) || isInteractive(document.activeElement)) return null
+  return action
+}
+
+/** Horizontal swipe: left advances, right goes back; short or vertical-dominant gestures are ignored. */
+export function swipeAction(dx: number, dy: number): 'next' | 'prev' | null {
+  if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) <= Math.abs(dy)) return null
+  return dx < 0 ? 'next' : 'prev'
+}
+
+export const clampIndex = (i: number, count: number) => Math.max(0, Math.min(i, count - 1))
+
+export interface PresentationNav {
+  index: number
+  mode: Mode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  toggleMode: () => void
+}
+
+export function usePresentationNav(count: number, initialMode: Mode): PresentationNav {
+  const [rawIndex, setIndex] = useState(0)
+  // Steps can be removed while mounted; never expose an index past the end.
+  const index = clampIndex(rawIndex, count)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const goTo = useCallback((i: number) => setIndex(clampIndex(i, count)), [count])
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, count)), [count])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'browse' ? 'present' : 'browse')), [])
+  const touch = useRef<{ x: number; y: number } | null>(null)
+
+  useEffect(() => {
+    const run = (a: KeyAction | 'next' | 'prev' | null) => {
+      if (a === 'next') next()
+      else if (a === 'prev') prev()
+      else if (a === 'toggle-mode') toggleMode()
+    }
+    const onKey = (e: KeyboardEvent) => {
+      const action = keyAction(e)
+      if (!action) return
+      if (e.key === ' ' || e.key.startsWith('Page')) e.preventDefault()
+      run(action)
+    }
+    const onStart = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      touch.current = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onEnd = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      const start = touch.current
+      touch.current = null
+      if (t && start) run(swipeAction(t.clientX - start.x, t.clientY - start.y))
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onStart, { passive: true })
+    window.addEventListener('touchend', onEnd, { passive: true })
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onStart)
+      window.removeEventListener('touchend', onEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, next, prev, goTo, toggleMode }
+}
diff --git a/src/presentation-kit/useViewport.ts b/src/presentation-kit/useViewport.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9242725c299c9a9578b00dc7d05360622787d8cb
--- /dev/null
+++ b/src/presentation-kit/useViewport.ts
@@ -0,0 +1,16 @@
+import { useEffect, useState } from 'react'
+import type { Size } from './fit.ts'
+
+const read = (): Size => ({ width: window.innerWidth, height: window.innerHeight })
+
+/** Current window size; one listener, removed on unmount (StrictMode-safe). */
+export function useViewport(): Size {
+  const [size, setSize] = useState(read)
+  useEffect(() => {
+    const onResize = () => setSize(read())
+    window.addEventListener('resize', onResize)
+    onResize()
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return size
+}
diff --git a/src/presentations/how-to-make-a-presentation/Scene.tsx b/src/presentations/how-to-make-a-presentation/Scene.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..92aeddd4221127c73c5874a44842af7495e196a0
--- /dev/null
+++ b/src/presentations/how-to-make-a-presentation/Scene.tsx
@@ -0,0 +1,63 @@
+import { Check, Flag, Image, SlidersHorizontal } from 'lucide-react'
+import { Appear, Arrow, Box, Frame, Label, SceneLayer, SymbolChip } from '../../presentation-kit/index.ts'
+import type { SceneProps } from '../../presentation-kit/index.ts'
+import { FLAGGED_CARD, entitiesAt } from './entities.ts'
+import type { Entity } from './entities.ts'
+
+export interface Payload {
+  /** 1-based step number whose entities are on screen. */
+  stage: number
+}
+
+function render(e: Entity, stage: number) {
+  switch (e.kind) {
+    case 'node':
+      if (e.role === 'verify') {
+        return (
+          <Box layoutId={e.id} x={e.x} y={e.y} w={e.w} h={e.h} data-role="verify">
+            <span data-part="title">verify</span>
+            <span data-part="check">build</span>
+            <span data-part="check">render</span>
+            <Check data-part="pass" data-presentation-pass="" aria-label="pass" />
+          </Box>
+        )
+      }
+      return e.role === 'tray'
+        ? <Label layoutId={e.id} x={e.x} y={e.y} w={e.w} h={e.h} data-role={e.role}>{e.text}</Label>
+        : <Box layoutId={e.id} x={e.x} y={e.y} w={e.w} h={e.h} data-role={e.role}>{e.text}</Box>
+    case 'card':
+      return (
+        <Box layoutId={e.id} x={e.x} y={e.y} w={e.w} h={e.h} Icon={Image} emphasis={e.id === FLAGGED_CARD && stage >= 8} data-role="card">
+          <span data-part="title">Step {e.n}</span>
+          <span data-part="caption">caption</span>
+        </Box>
+      )
+    case 'chip':
+      return (
+        <SymbolChip
+          layoutId={e.id} x={e.x} y={e.y} w={e.w} h={e.h} data-role={e.role}
+          Icon={e.role === 'depth' ? SlidersHorizontal : e.role === 'flag' ? Flag : undefined}
+          data-presentation-allow-overlap={e.overlap ? '' : undefined}
+        >
+          {e.text}
+        </SymbolChip>
+      )
+    case 'arrow':
+      return <Arrow layoutId={e.id} from={e.a} to={e.b} via={e.via} bidirectional={e.both} data-role={e.role} />
+    case 'frame':
+      return <Frame layoutId={e.id} x={e.x} y={e.y} w={e.w} h={e.h} label={e.text} data-role="frame" />
+  }
+}
+
+/** One persistent scene: only `payload.stage` changes between steps. */
+export function Scene({ payload }: SceneProps<Payload>) {
+  return (
+    <SceneLayer>
+      {entitiesAt(payload.stage).map((e) => (
+        <Appear key={e.id} enter={e.from === payload.stage}>
+          {render(e, payload.stage)}
+        </Appear>
+      ))}
+    </SceneLayer>
+  )
+}
