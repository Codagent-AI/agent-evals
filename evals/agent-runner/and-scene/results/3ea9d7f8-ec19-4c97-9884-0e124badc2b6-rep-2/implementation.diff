+  [data-presentation-header] { gap: 12px; padding: 12px 16px; }
+  [data-presentation-header] [data-presentation-title] {
+    font-size: 15px; line-height: 1.2; overflow: hidden;
+    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
+  }
+}
+[data-presentation-mode-toggle] {
+  margin-left: auto;
+  padding: 6px 14px;
+  color: var(--ink);
+  background: transparent;
+  border: 1px solid var(--line);
+  border-radius: 999px;
