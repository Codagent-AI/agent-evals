+import type { CSSProperties, HTMLAttributes } from 'react'
+import { EASE, EXIT_T, LAYOUT_T } from '../constants.ts'
+
+/** Props every primitive accepts: identity, canvas geometry and styling hooks. */
+export interface NodeProps extends Omit<HTMLAttributes<HTMLElement>, 'onDrag' | 'onDragStart' | 'onDragEnd' | 'onAnimationStart'> {
+  /** Stable entity identity shared across steps; drives the layout morph. */
+  layoutId: string
+  x: number
+  y: number
+  w?: number
+  h?: number
+}
+
+/** Absolute placement inside the design canvas (layout behaviour, not styling). */
+export function place({ x, y, w, h }: Pick<NodeProps, 'x' | 'y' | 'w' | 'h'>, style?: CSSProperties): CSSProperties {
+  return { position: 'absolute', left: x, top: y, width: w, height: h, ...style }
+}
+
+export const morph = { layout: { duration: LAYOUT_T, ease: EASE } }
+export const leave = { opacity: 0, transition: { duration: EXIT_T } }
diff --git a/src/presentation-kit/sceneKey.ts b/src/presentation-kit/sceneKey.ts
new file mode 100644
index 0000000000000000000000000000000000000000..471904695751a419e0df1887c4b6c3ca812cd38a
--- /dev/null
+++ b/src/presentation-kit/sceneKey.ts
@@ -0,0 +1,12 @@
+let nextSceneId = 0
+const sceneIds = new WeakMap<object, number>()
+function sceneId(scene: object): number {
+  let id = sceneIds.get(scene)
+  if (id === undefined) sceneIds.set(scene, (id = nextSceneId++))
+  return id
+}
+
+/** Steps with the same group and Scene share a key, so one instance persists. */
+export function sceneKey(step: { id: string; groupKey?: string; Scene: object }): string {
+  return step.groupKey ? `group:${step.groupKey}:${sceneId(step.Scene)}` : `step:${step.id}`
+}
