+  --muted: #b9b09c;
+  --gold: #c7a755;
+  --line: #4a4336;
+  --panel: #1d1a16;
+  --pass: #6fcf97;
+  color: var(--ink);
+}
+
+[data-presentation-header] {
+  display: flex;
+  align-items: center;
+  gap: 24px;
+  padding: 16px 24px;
+  height: 64px;
+}
+[data-presentation-marker] { color: var(--muted); font-size: 14px; letter-spacing: 0.04em; }
+[data-presentation-marker-era] { text-transform: uppercase; color: var(--gold); }
+[data-presentation-header] [data-presentation-title] { margin: 0; font-size: 20px; font-weight: 600; flex: 1; min-width: 0; }
+/* Narrow screens: keep the title inside the 64px header row. */
