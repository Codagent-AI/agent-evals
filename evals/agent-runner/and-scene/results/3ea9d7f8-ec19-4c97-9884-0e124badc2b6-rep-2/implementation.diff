+[data-presentation-caption] { margin: 0 auto 14px; max-width: 760px; font-size: 18px; line-height: 1.5; color: var(--ink); }
+
+[data-presentation-progress] { display: flex; justify-content: center; gap: 10px; margin-bottom: 14px; }
