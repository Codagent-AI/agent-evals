index 0000000000000000000000000000000000000000..e363b07de22b48a0e5c8c5d096802707ead315ea
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/preview.mjs
@@ -0,0 +1,119 @@
+// Shared helpers: IPv4-loopback `vite preview` lifecycle and Playwright launching.
+import { spawn } from 'node:child_process'
+import { createRequire } from 'node:module'
+import net from 'node:net'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+export const HOST = '127.0.0.1'
+
+/** Project root: the parent of the `scripts/` directory this file lives under. */
+export function projectRoot() {
+  return path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..')
+}
+
+export function freePort() {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer()
+    server.on('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+}
+
+export function runCommand(cmd, args, { cwd, env } = {}) {
+  return new Promise((resolve) => {
+    const child = spawn(cmd, args, { cwd, env: { ...process.env, ...env }, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (d) => (output += d))
+    child.stderr.on('data', (d) => (output += d))
+    child.on('error', (err) => resolve({ code: 1, output: output + String(err) }))
+    child.on('close', (code) => resolve({ code: code ?? 1, output }))
+  })
+}
+
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
+
+/**
+ * Start `vite preview` bound to 127.0.0.1 on a free port. Returns
+ * `{ url, port, stop }`; `stop()` is idempotent and also runs on exit/signals.
+ */
+export async function startPreview(root, { port, outDir } = {}) {
+  const require = createRequire(path.join(root, 'package.json'))
+  const viteBin = path.join(path.dirname(require.resolve('vite/package.json')), 'bin', 'vite.js')
+  const chosen = port ?? (Number(process.env.PREVIEW_PORT) || (await freePort()))
+  const args = [viteBin, 'preview', '--host', HOST, '--port', String(chosen), '--strictPort']
+  if (outDir) args.push('--outDir', outDir)
+  const child = spawn(process.execPath, args, { cwd: root, stdio: ['ignore', 'pipe', 'pipe'] })
+  let log = ''
+  child.stdout.on('data', (d) => (log += d))
+  child.stderr.on('data', (d) => (log += d))
+  let exited = false
+  child.on('exit', () => (exited = true))
+
+  let stopped = false
+  const stop = async () => {
+    if (stopped) return
+    stopped = true
+    process.off('exit', onExit)
+    for (const sig of ['SIGINT', 'SIGTERM', 'SIGHUP']) process.off(sig, onSignal)
+    if (exited) return
+    const done = new Promise((r) => child.once('exit', r))
+    child.kill('SIGTERM')
+    await Promise.race([done, sleep(3000)])
+    if (!exited) {
+      child.kill('SIGKILL')
+      await Promise.race([done, sleep(1000)])
+    }
+  }
+  const onExit = () => {
+    if (!exited) child.kill('SIGKILL')
+  }
+  const onSignal = () => {
+    onExit()
+    process.exit(130)
+  }
+  process.on('exit', onExit)
+  for (const sig of ['SIGINT', 'SIGTERM', 'SIGHUP']) process.on(sig, onSignal)
+
+  const url = `http://${HOST}:${chosen}`
+  const deadline = Date.now() + 30_000
+  for (;;) {
+    if (exited) {
+      await stop()
+      throw new Error(`vite preview exited before becoming ready:\n${log}`)
+    }
+    try {
+      const res = await fetch(`${url}/`)
+      if (res.ok) break
+    } catch {
+      /* not ready yet */
+    }
+    if (Date.now() > deadline) {
+      await stop()
+      throw new Error(`vite preview was not ready at ${url} within 30s:\n${log}`)
+    }
+    await sleep(100)
+  }
+  return { url, port: chosen, stop }
+}
+
+export const BROWSER_HELP =
+  'Playwright Chromium is not available. Install it with: npx playwright install chromium'
+
+/** Launch Playwright Chromium, or throw an error with install guidance. */
+export async function launchChromium() {
+  let chromium
+  try {
+    ;({ chromium } = await import('playwright'))
+  } catch {
+    throw new Error(`The "playwright" package is not installed. Run: npm ci. ${BROWSER_HELP}`)
+  }
+  try {
+    return await chromium.launch()
+  } catch (err) {
+    throw new Error(`${BROWSER_HELP}\n${String(err?.message ?? err).split('\n')[0]}`)
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/verify.mjs b/skills/presentation/templates/bootstrap/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..69042a3b2ddc9f900c3b564577a1b76c4e2751e4
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/verify.mjs
@@ -0,0 +1,221 @@
+#!/usr/bin/env node
+// Deterministic production gate: build -> sample -> render -> report.
+import fs from 'node:fs'
+import path from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { HOST, launchChromium, projectRoot, runCommand, startPreview } from './lib/preview.mjs'
+
+// ---- Defaults for this repository's reference sample ----
+// A scaffolded project overrides them with an optional `verify.config.json` at its root:
+//   { "slug": "starter", "registry"?: "src/presentations/index.ts",
+//     "outline"?: "src/presentations/starter/outline.ts", "steps"?: [{ "title", "caption" }] }
+// Without `steps` the render phase checks every step of `slug` for non-empty title/caption
+// and console/page errors, but not exact text or outline order.
+export const SAMPLE_SLUG = 'how-to-make-a-presentation'
+export const REGISTRY_FILE = 'src/presentations/index.ts'
+export const OUTLINE_FILE = `src/presentations/${SAMPLE_SLUG}/outline.ts`
+export const EXPECTED_STEPS = [
+  ['You have a topic', 'It starts with you, a topic, and mild overconfidence.'],
+  ['The skill interviews you', 'One question at a time: the topic, the look, then each beat of the story.'],
+  ['Answers become steps', 'Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next.'],
+  ['The deck grows', 'Same shapes, new beats. Every answer extends the story without redrawing it.'],
+  ['You set the depth', 'Spell out every step, or sketch a few and see how it looks. You hold the gate.'],
+  ['It assembles the scene', 'Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph.'],
+  ['It checks its own work', 'Before saying done, it builds and renders every step — and fixes what breaks.'],
+  ['Changed your mind? Loop it.', 'Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch.'],
+  ["You're looking at one", 'This presentation was built exactly this way. Thanks for watching.'],
+].map(([title, caption]) => ({ title, caption }))
+export const CONFIG_FILE = 'verify.config.json'
+
+/** Resolve the verification target for a project root (defaults or `verify.config.json`). */
+export function loadConfig(root) {
+  const file = path.join(root, CONFIG_FILE)
+  if (!fs.existsSync(file)) {
+    return { slug: SAMPLE_SLUG, registry: REGISTRY_FILE, outline: OUTLINE_FILE, steps: EXPECTED_STEPS }
+  }
+  let raw
+  try {
+    raw = JSON.parse(fs.readFileSync(file, 'utf8'))
+  } catch (err) {
+    throw new PhaseError('sample', `${CONFIG_FILE} is not valid JSON: ${err.message}`)
+  }
+  if (typeof raw.slug !== 'string' || !/^[a-z0-9-]+$/.test(raw.slug)) {
+    throw new PhaseError('sample', `${CONFIG_FILE} "slug" must match /^[a-z0-9-]+$/`)
+  }
+  if (raw.outline && !Array.isArray(raw.steps)) {
+    throw new PhaseError('sample', `${CONFIG_FILE} sets "outline" without "steps"; the outline is checked against "steps"`)
+  }
+  return {
+    slug: raw.slug,
+    registry: raw.registry ?? REGISTRY_FILE,
+    outline: raw.outline,
+    steps: Array.isArray(raw.steps) ? raw.steps : undefined,
+  }
+}
+// Per-step settle before checking errors / pressing the next key (ms).
+const STEP_SETTLE_MS = Number(process.env.VERIFY_STEP_SETTLE_MS ?? 700)
+const TRANSITION_TIMEOUT_MS = 3000
+
+export class PhaseError extends Error {
+  constructor(phase, message, step) {
+    super(message)
+    this.phase = phase
+    this.step = step
+  }
+}
+
+/** Assert titles and captions occur in `source` in the expected order. */
+export function assertOutlineOrder(source, expected = EXPECTED_STEPS) {
+  let cursor = 0
+  expected.forEach(({ title, caption }, i) => {
+    for (const [kind, text] of [['title', title], ['caption', caption]]) {
+      const at = source.indexOf(text, cursor)
+      if (at === -1) {
+        const anywhere = source.includes(text)
+        throw new PhaseError(
+          'sample',
+          `step ${i + 1} ${kind} ${JSON.stringify(text)} ${anywhere ? 'is out of order' : 'is missing'} in the sample outline`,
+          i,
+        )
+      }
+      cursor = at + text.length
+    }
+  })
+}
+
+export function formatReport(results, failure) {
+  const lines = results.map((r) => `  ${r.ok ? 'PASS' : 'FAIL'}  ${r.phase}${r.detail ? ` — ${r.detail}` : ''}`)
+  if (failure) {
+    const where = failure.step === undefined ? '' : ` at step index ${failure.step}`
+    lines.push('', `VERIFY FAIL: phase "${failure.phase}"${where}: ${failure.message}`)
+  } else {
+    lines.push('', 'VERIFY PASS: build, sample, and render checks all passed')
+  }
+  return lines.join('\n')
+}
+
+async function buildPhase(root) {
+  const { code, output } = await runCommand('npm', ['run', 'build'], { cwd: root })
+  if (code !== 0) throw new PhaseError('build', `npm run build failed (exit ${code})\n${output.trim()}`)
+  return 'npm run build succeeded'
+}
+
+function samplePhase(root, config) {
+  const { slug, registry: registryFile, outline, steps } = config
+  const registryPath = path.join(root, registryFile)
+  if (!fs.existsSync(registryPath)) throw new PhaseError('sample', `registry ${registryFile} not found`)
+  const registry = fs.readFileSync(registryPath, 'utf8')
+  if (!new RegExp(`slug:\\s*['"\`]${slug}['"\`]`).test(registry)) {
+    throw new PhaseError('sample', `sample "${slug}" is not registered in ${registryFile}`)
+  }
+  if (!steps) return `${slug} registered`
+  if (!outline) return `${slug} registered; ${steps.length} titles/captions checked at render (no outline file)`
+  const outlinePath = path.join(root, outline)
+  if (!fs.existsSync(outlinePath)) throw new PhaseError('sample', `sample outline ${outline} not found`)
+  assertOutlineOrder(fs.readFileSync(outlinePath, 'utf8'), steps)
+  return `${slug} registered; ${steps.length} titles/captions in order`
+}
+
+async function renderPhase(root, config) {
+  const { slug, steps: expectedSteps } = config
+  let preview
+  let browser
+  let current = 0
+  const fail = (message, step = current) => new PhaseError('render', message, step)
+  try {
+    preview = await startPreview(root)
+    browser = await launchChromium()
+    const page = await browser.newPage({ viewport: { width: 1440, height: 900 } })
+    const errors = []
+    page.on('console', (m) => m.type() === 'error' && errors.push({ step: current, text: `console.error: ${m.text()}` }))
+    page.on('pageerror', (e) => errors.push({ step: current, text: `pageerror: ${e.message}` }))
+    const checkErrors = () => {
+      if (errors.length) throw fail(errors[0].text, errors[0].step)
+    }
+
+    const url = `http://${HOST}:${preview.port}/${slug}`
+    await page.goto(url)
+    try {
+      await page.waitForSelector('[data-presentation-root]', { timeout: 10_000 })
+    } catch {
+      checkErrors()
+      throw fail(`sample route ${url} did not render a presentation`, 0)
+    }
+    const root$ = page.locator('[data-presentation-root]')
+    const count = Number(await root$.getAttribute('data-step-count'))
+    if (expectedSteps ? count !== expectedSteps.length : !(count >= 1)) {
+      throw fail(`data-step-count is ${count}, expected ${expectedSteps ? expectedSteps.length : 'at least 1'}`, 0)
+    }
+
+    for (let i = 0; i < count; i++) {
+      current = i
+      const idx = await root$.getAttribute('data-step-index').catch(() => null)
+      if (idx === null) {
+        checkErrors()
+        throw fail(`presentation root disappeared while rendering step ${i}`)
+      }
+      if (Number(idx) !== i) throw fail(`expected data-step-index ${i} but found ${idx}`)
+      const title = await page.locator('[data-presentation-step-title]').textContent()
+      const caption = await page.locator('[data-presentation-caption]').textContent()
+      if (expectedSteps) {
+        if (title !== expectedSteps[i].title) throw fail(`title ${JSON.stringify(title)} does not match ${JSON.stringify(expectedSteps[i].title)}`)
+        if (caption !== expectedSteps[i].caption) throw fail(`caption ${JSON.stringify(caption)} does not match the outline`)
+      } else if (!title?.trim() || !caption?.trim()) {
+        throw fail('step title or caption is empty')
+      }
+      await page.waitForTimeout(STEP_SETTLE_MS)
+      checkErrors()
+      if (i === count - 1) break
+      current = i + 1 // errors raised while rendering the next step belong to it
+      await page.keyboard.press('ArrowRight')
+      try {
+        await page.waitForFunction(
+          (next) => document.querySelector('[data-presentation-root]')?.getAttribute('data-step-index') === String(next),
+          i + 1,
+          { timeout: TRANSITION_TIMEOUT_MS },
+        )
+      } catch {
+        checkErrors()
+        throw fail(`ArrowRight did not advance data-step-index from ${i} to ${i + 1}`, i)
+      }
+    }
+    return `${count} steps rendered at http://${HOST}:${preview.port} with no console or page errors`
+  } finally {
+    await browser?.close().catch(() => {})
+    await preview?.stop()
+  }
+}
+
+export async function runVerify(root = projectRoot()) {
+  const results = []
+  let config
+  try {
+    config = loadConfig(root)
+  } catch (err) {
+    results.push({ phase: 'config', ok: false })
+    return { ok: false, report: formatReport(results, err), failure: err }
+  }
+  const phases = [
+    ['build', buildPhase],
+    ['sample', samplePhase],
+    ['render', renderPhase],
+  ]
+  for (const [name, fn] of phases) {
+    try {
+      const detail = await fn(root, config)
+      results.push({ phase: name, ok: true, detail })
+    } catch (err) {
+      const failure =
+        err instanceof PhaseError ? err : new PhaseError(name, String(err?.message ?? err))
+      results.push({ phase: name, ok: false })
+      return { ok: false, report: formatReport(results, failure), failure }
+    }
+  }
+  return { ok: true, report: formatReport(results) }
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  const { ok, report } = await runVerify()
+  console[ok ? 'log' : 'error'](report)
+  process.exit(ok ? 0 : 1)
+}
