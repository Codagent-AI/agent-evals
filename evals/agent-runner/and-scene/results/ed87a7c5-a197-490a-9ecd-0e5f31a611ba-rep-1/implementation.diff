index 0000000000000000000000000000000000000000..dd9b021ca1c65ab4cceea6358dce915248a6dca5
--- /dev/null
+++ b/src/presentations/how-to-make-a-presentation/talk.css
@@ -0,0 +1,304 @@
+/* Presentation-owned styling: palette, type, spacing, chrome. The kit ships none. */
+[data-presentation-root] {
+  --htp-bg: #0d0c0b;
+  --htp-ink: #f8f3e6;
+  --htp-dim: #b8b09c;
+  --htp-gold: #e0b94f;
+  --htp-line: #4a4436;
+  --htp-panel: #1d1a16;
+  --htp-green: #6fcf97;
+  --htp-red: #ef8f7a;
+  color: var(--htp-ink);
+  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
+}
+
+/* ---- chrome ---- */
+[data-presentation-header] {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  height: 64px;
+  padding: 0 24px;
+}
+[data-presentation-marker] {
+  font-variant-numeric: tabular-nums;
+  color: var(--htp-gold);
+  font-weight: 600;
+}
+[data-presentation-deck-title] {
+  flex: 1;
+  color: var(--htp-dim);
+  font-size: 15px;
+}
+[data-presentation-mode-toggle],
+[data-presentation-prev],
+[data-presentation-next] {
+  background: var(--htp-panel);
+  color: var(--htp-ink);
+  border: 1px solid var(--htp-line);
+  border-radius: 8px;
+  padding: 6px 14px;
+  font-size: 14px;
+  cursor: pointer;
+}
+[data-presentation-mode-toggle] {
+  margin-left: auto;
+}
+[data-presentation-prev]:disabled,
+[data-presentation-next]:disabled {
+  opacity: 0.4;
+  cursor: default;
+}
+
+[data-presentation-footer] {
+  padding: 16px 24px 12px;
+  text-align: center;
+}
+[data-presentation-step-title],
+[data-presentation-title] {
+  margin: 0 0 6px;
+  font-size: 26px;
+  line-height: 1.2;
+}
+[data-presentation-caption] {
+  max-width: 44rem;
+  margin: 0 auto 14px;
+  color: var(--htp-dim);
+  font-size: 16px;
+  line-height: 1.45;
+}
+[data-presentation-progress] {
+  display: flex;
+  justify-content: center;
+  gap: 10px;
+  margin-bottom: 10px;
+}
+[data-presentation-progress-item] {
+  width: 12px;
+  height: 12px;
+  padding: 0;
+  border: 1px solid var(--htp-line);
+  border-radius: 999px;
+  background: transparent;
+  cursor: pointer;
+  transition: all 0.2s;
+}
+[data-presentation-progress-item][data-presentation-active='true'] {
+  width: 28px;
+  background: var(--htp-gold);
+  border-color: var(--htp-gold);
+}
+[data-presentation-controls] {
+  display: flex;
+  justify-content: center;
+  gap: 10px;
+}
+[data-presentation-attribution] {
+  position: absolute;
+  right: 24px;
+  bottom: 12px;
+  font-size: 13px;
+  font-weight: 500;
+  letter-spacing: 0.02em;
+  color: var(--htp-gold);
+  text-decoration: none;
+  border-bottom: 1px solid rgba(224, 185, 79, 0.45);
+}
+[data-presentation-attribution]:hover {
+  border-bottom-color: var(--htp-gold);
+}
+
+[data-presentation-toc] {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 8px 16px;
+}
+[data-presentation-toc-item] {
+  text-align: left;
+  background: transparent;
+  color: var(--htp-dim);
+  border: 0;
+  border-left: 3px solid var(--htp-line);
+  padding: 8px 12px;
+  font-size: 15px;
+  text-transform: capitalize;
+  cursor: pointer;
+}
+[data-presentation-toc-item][data-presentation-active='true'] {
+  color: var(--htp-ink);
+  font-weight: 700;
+  border-left-color: var(--htp-gold);
+  background: rgba(224, 185, 79, 0.14);
+}
+
+/* ---- scene ---- */
+.htp-scene {
+  font-size: 14px;
+}
+.htp-node,
+.htp-card,
+.htp-bubble {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  width: 100%;
+  height: 100%;
+  border: 1.5px solid var(--htp-line);
+  border-radius: 12px;
+  background: var(--htp-panel);
+  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
+  font-weight: 600;
+}
+.htp-you {
+  border-color: var(--htp-gold);
+  color: var(--htp-gold);
+  font-size: 20px;
+}
+.htp-skill {
+  border-color: var(--htp-green);
+  color: var(--htp-green);
+  font-size: 20px;
+}
+.htp-bubble {
+  border-radius: 18px 18px 18px 4px;
+  font-weight: 500;
+  color: var(--htp-dim);
+}
+.htp-arrow {
+  color: var(--htp-dim);
+}
+.htp-chip {
+  display: inline-block;
+  padding: 3px 10px;
+  border: 1px solid var(--htp-gold);
+  border-radius: 999px;
+  color: var(--htp-gold);
+  font-size: 13px;
+  white-space: nowrap;
+}
+.htp-tray {
+  width: 100%;
+  height: 100%;
+  /* The tray is a flat band, not a frame: only the final reveal frame outlines the diagram. */
+  border: 0;
+  border-radius: 0;
+  background: rgba(255, 255, 255, 0.04);
+}
+.htp-card {
+  align-items: stretch;
+  justify-content: flex-start;
+  gap: 3px;
+  padding: 6px;
+  overflow: hidden;
+  font-size: 10px;
+  font-weight: 500;
+}
+.htp-card-n {
+  color: var(--htp-gold);
+  font-weight: 700;
+  font-size: 12px;
+}
+.htp-card-row {
+  padding: 2px 6px;
+  border-radius: 4px;
+  background: rgba(255, 255, 255, 0.07);
+  color: var(--htp-dim);
+}
+.htp-card-visual {
+  border: 1px dashed var(--htp-line);
+  background: transparent;
+}
+.htp-card[data-edited='true'] {
+  border-color: var(--htp-red);
+  box-shadow: 0 0 0 3px rgba(239, 143, 122, 0.25);
+}
+.htp-ghost {
+  align-items: center;
+  justify-content: center;
+  border-style: dashed;
+  background: transparent;
+  box-shadow: none;
+  color: var(--htp-dim);
+  font-size: 13px;
+}
+.htp-link {
+  display: block;
+  color: var(--htp-gold);
+  font-size: 18px;
+  text-align: center;
+}
+.htp-note {
+  display: block;
+  color: var(--htp-dim);
+  font-size: 12px;
+  white-space: nowrap;
+}
+.htp-depth {
+  background: var(--htp-panel);
+}
+.htp-plug {
+  display: block;
+  color: var(--htp-gold);
+  font-size: 18px;
+  text-align: center;
+}
+.htp-kit {
+  border-color: var(--htp-gold);
+  border-radius: 8px 8px 20px 20px;
+  color: var(--htp-gold);
+}
+.htp-verify {
+  border-color: var(--htp-green);
+  gap: 4px;
+  font-size: 15px;
+}
+.htp-verify-sub {
+  color: var(--htp-dim);
+  font-size: 11px;
+  font-weight: 500;
+}
+.htp-pass {
+  padding: 2px 8px;
+  border-radius: 999px;
+  background: rgba(111, 207, 151, 0.18);
+  color: var(--htp-green);
+  font-size: 12px;
+}
+.htp-modify {
+  color: var(--htp-red);
+}
+.htp-modify-tag {
+  display: block;
+  color: var(--htp-red);
+  font-size: 13px;
+  font-weight: 700;
+}
+.htp-frame {
+  width: 100%;
+  height: 100%;
+  border: 2px dashed var(--htp-gold);
+  border-radius: 20px;
+  pointer-events: none;
+}
+.htp-frame-label {
+  display: block;
+  color: var(--htp-gold);
+  font-size: 13px;
+  font-weight: 600;
+  text-align: right;
+  white-space: nowrap;
+}
+
+/* Narrow viewports: keep the attribution out of the controls row. */
+@media (max-width: 700px) {
+  [data-presentation-attribution] {
+    position: static;
+    display: inline-block;
+    margin-top: 10px;
+  }
+  [data-presentation-header] {
+    padding: 0 12px;
+  }
+}
