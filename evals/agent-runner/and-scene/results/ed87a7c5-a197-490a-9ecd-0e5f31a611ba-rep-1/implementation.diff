+# Styling
+
+- Default: **plain CSS** in `src/presentations/<slug>/talk.css`, imported by `Talk.tsx`. Scope with a per-presentation
+  class prefix and `[data-presentation-*]` selectors. Put palette/type tokens on `[data-presentation-root]`.
+- Use Tailwind or another framework only if the host project already uses it or the user asks for it.
+- Never add styling to `src/presentation-kit/` or define theme tokens in the host `src/index.css`.
+- Style the chrome: header, marker, footer title/caption, controls, progress items, ToC items.
+- The **active** progress/ToC item (`[data-presentation-active='true']`) must be visibly different (weight, color,
+  background, or marker) from inactive ones.
+- The attribution link (`[data-presentation-attribution]`) must be legible: sufficient contrast and a readable size,
+  not hidden behind scene content.
+- Keep scene content clear of the chrome regions; if text and chrome must overlap, mark the scene element with
+  `data-presentation-allow-overlap` only when the overlap is intentional and readable.
diff --git a/skills/presentation/scripts/scaffold-lib.mjs b/skills/presentation/scripts/scaffold-lib.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6eae965dc597e18727aea4b98269f32a6c020f00
--- /dev/null
+++ b/skills/presentation/scripts/scaffold-lib.mjs
@@ -0,0 +1,129 @@
+// Deterministic helpers for the presentation skill. Pure Node, no dependencies.
+//   node scaffold-lib.mjs detect [dir]    -> JSON: monorepo signals, anchors, resolved target, templates dir
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+
+const SKILL_DIR = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+
+/** Templates live next to SKILL.md, never relative to the caller's working directory. */
+export function templatesDir(name = 'bootstrap') {
+  return path.join(SKILL_DIR, 'templates', name)
+}
+
+const readJson = (file) => {
+  try {
+    return JSON.parse(fs.readFileSync(file, 'utf8'))
+  } catch {
+    return undefined
+  }
+}
+
+function walk(dir, depth = 4) {
+  if (depth < 0 || !fs.existsSync(dir)) return []
+  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
+    const p = path.join(dir, e.name)
+    if (e.isDirectory()) return e.name === 'node_modules' ? [] : walk(p, depth - 1)
+    return [p]
+  })
+}
+
+/** Monorepo signals: `workspaces` in package.json, pnpm-workspace.yaml, or a packages/|apps/ layout. */
+export function detectMonorepo(dir) {
+  const signals = []
+  if (readJson(path.join(dir, 'package.json'))?.workspaces) signals.push('workspaces')
+  if (fs.existsSync(path.join(dir, 'pnpm-workspace.yaml'))) signals.push('pnpm-workspace.yaml')
+  for (const d of ['packages', 'apps']) {
+    if (fs.existsSync(path.join(dir, d)) && fs.statSync(path.join(dir, d)).isDirectory()) signals.push(`${d}/`)
+  }
+  return { isMonorepo: signals.length > 0, signals }
+}
+
+/** Contract-level anchor detection (presence of the contract, not byte-identity). */
+export function detectAnchors(dir) {
+  const pkg = readJson(path.join(dir, 'package.json'))
+  const deps = { ...pkg?.dependencies, ...pkg?.devDependencies }
+  const hasVite = ['vite.config.ts', 'vite.config.js', 'vite.config.mjs'].some((f) => fs.existsSync(path.join(dir, f)))
+  const buildSetup = Boolean(pkg?.scripts?.build && deps.vite && deps.react && deps.typescript && hasVite)
+
+  const files = walk(path.join(dir, 'src'))
+  const text = (f) => fs.readFileSync(f, 'utf8')
+  const sourceFiles = files.filter((f) => /\.(ts|tsx)$/.test(f))
+  const sceneKit =
+    sourceFiles.some((f) => /export\s+(function|const)\s+Presentation\b/.test(text(f))) &&
+    sourceFiles.some((f) => /data-presentation-root/.test(text(f)))
+  const presentationIndex = sourceFiles.some(
+    (f) => /(^|\/)presentations\/index\.tsx?$/.test(f.split(path.sep).join('/')) && /\bslug\b/.test(text(f)) && /\bload\b/.test(text(f)),
+  )
+  return { buildSetup, sceneKit, presentationIndex }
+}
+
+const isApp = (a) => a.buildSetup && a.sceneKit && a.presentationIndex
+
+/** Find an enclosing presentation app (all three anchors) at `dir`, an ancestor, or below `presentations/`. */
+export function resolveTarget(dir) {
+  const anchors = detectAnchors(dir)
+  const { isMonorepo, signals } = detectMonorepo(dir)
+  const empty = !fs.existsSync(dir) || fs.readdirSync(dir).filter((f) => f !== '.git').length === 0
+  if (isApp(anchors)) {
+    return { target: dir, kind: 'existing-app', anchors, isMonorepo, signals, needsConfirmation: false }
+  }
+  // Already inside an app: walk up, stopping at the repository root (or the filesystem root).
+  for (let up = dir; !fs.existsSync(path.join(up, '.git')) && path.dirname(up) !== up; ) {
+    up = path.dirname(up)
+    const upAnchors = detectAnchors(up)
+    if (isApp(upAnchors)) {
+      const m = detectMonorepo(up)
+      return { target: up, kind: 'existing-app', anchors: upAnchors, isMonorepo: m.isMonorepo, signals: m.signals, needsConfirmation: false }
+    }
+  }
+  const nested = path.join(dir, 'presentations')
+  if (isMonorepo && fs.existsSync(nested)) {
+    const nestedAnchors = detectAnchors(nested)
+    if (isApp(nestedAnchors)) {
+      return { target: nested, kind: 'existing-app', anchors: nestedAnchors, isMonorepo, signals, needsConfirmation: false }
+    }
+  }
+  const target = isMonorepo ? nested : dir
+  const anchorsAtTarget = isMonorepo ? detectAnchors(nested) : anchors
+  return {
+    target,
+    kind: isMonorepo ? 'monorepo-app' : 'root',
+    anchors: anchorsAtTarget,
+    isMonorepo,
+    signals,
+    // Empty dirs scaffold freely; a non-empty project missing the kit or index needs the user's confirmation.
+    needsConfirmation: !empty && !(anchorsAtTarget.sceneKit && anchorsAtTarget.presentationIndex),
+  }
+}
+
+/** Merge template dependencies into an existing package.json object without downgrading or overwriting. */
+export function mergeDependencies(existing, template) {
+  const out = { ...existing }
+  const added = []
+  for (const field of ['dependencies', 'devDependencies']) {
+    const have = { ...out.dependencies, ...out.devDependencies }
+    const merged = { ...out[field] }
+    for (const [name, range] of Object.entries(template[field] ?? {})) {
+      if (name in have) continue
+      merged[name] = range
+      added.push(name)
+    }
+    if (Object.keys(merged).length) out[field] = merged
+  }
+  const scripts = { ...out.scripts }
+  for (const [name, cmd] of Object.entries(template.scripts ?? {})) {
+    if (!(name in scripts)) scripts[name] = cmd
+  }
+  if (Object.keys(scripts).length) out.scripts = scripts
+  return { pkg: out, added }
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  const [cmd, dir = process.cwd()] = process.argv.slice(2)
+  if (cmd !== 'detect') {
+    console.error('usage: node scaffold-lib.mjs detect [dir]')
+    process.exit(2)
+  }
+  console.log(JSON.stringify({ ...resolveTarget(path.resolve(dir)), templates: templatesDir() }, null, 2))
+}
diff --git a/skills/presentation/scripts/scaffold-lib.test.mjs b/skills/presentation/scripts/scaffold-lib.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c1c6cad6490825616f66aa651032ad37b8a7542d
--- /dev/null
+++ b/skills/presentation/scripts/scaffold-lib.test.mjs
@@ -0,0 +1,100 @@
+import { cpSync, existsSync, mkdirSync, mkdtempSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import path from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { detectAnchors, detectMonorepo, mergeDependencies, resolveTarget, templatesDir } from './scaffold-lib.mjs'
+
+const tmp = () => mkdtempSync(path.join(tmpdir(), 'skill-lib-'))
+const bootstrap = templatesDir('bootstrap')
+
+describe('templatesDir', () => {
+  it('resolves next to SKILL.md regardless of cwd', () => {
+    const before = process.cwd()
+    process.chdir(tmpdir())
+    try {
+      expect(existsSync(path.join(templatesDir(), 'package.json'))).toBe(true)
+      expect(existsSync(path.join(templatesDir('presentation'), 'Talk.tsx.tmpl'))).toBe(true)
+    } finally {
+      process.chdir(before)
+    }
+  })
+})
+
+describe('detectMonorepo', () => {
+  it('detects each signal and none for a plain project', () => {
+    const plain = tmp()
+    writeFileSync(path.join(plain, 'package.json'), '{}')
+    expect(detectMonorepo(plain).isMonorepo).toBe(false)
+    const ws = tmp()
+    writeFileSync(path.join(ws, 'package.json'), '{"workspaces":["a"]}')
+    expect(detectMonorepo(ws).signals).toEqual(['workspaces'])
+    const pnpm = tmp()
+    writeFileSync(path.join(pnpm, 'pnpm-workspace.yaml'), 'packages: []')
+    expect(detectMonorepo(pnpm).signals).toEqual(['pnpm-workspace.yaml'])
+    const apps = tmp()
+    mkdirSync(path.join(apps, 'apps'))
+    expect(detectMonorepo(apps).signals).toEqual(['apps/'])
+  })
+})
+
+describe('detectAnchors / resolveTarget', () => {
+  it('finds all anchors in the bootstrap template', () => {
+    expect(detectAnchors(bootstrap)).toEqual({ buildSetup: true, sceneKit: true, presentationIndex: true })
+    expect(resolveTarget(bootstrap).kind).toBe('existing-app')
+  })
+
+  it('empty directory scaffolds at the root without confirmation', () => {
+    const r = resolveTarget(tmp())
+    expect(r).toMatchObject({ kind: 'root', needsConfirmation: false })
+    expect(r.anchors).toEqual({ buildSetup: false, sceneKit: false, presentationIndex: false })
+  })
+
+  it('non-empty standalone project missing the kit needs confirmation', () => {
+    const d = tmp()
+    writeFileSync(path.join(d, 'package.json'), '{}')
+    expect(resolveTarget(d)).toMatchObject({ kind: 'root', needsConfirmation: true })
+  })
+
+  it('monorepo targets presentations/ and reuses an existing app there', () => {
+    const d = tmp()
+    writeFileSync(path.join(d, 'package.json'), '{"workspaces":["packages/*"]}')
+    const r = resolveTarget(d)
+    expect(r).toMatchObject({ kind: 'monorepo-app', target: path.join(d, 'presentations'), needsConfirmation: true })
+    cpSync(bootstrap, path.join(d, 'presentations'), { recursive: true })
+    expect(resolveTarget(d)).toMatchObject({ kind: 'existing-app', target: path.join(d, 'presentations') })
+  })
+
+  it('resolves an enclosing app from a nested directory', () => {
+    const d = tmp()
+    cpSync(bootstrap, d, { recursive: true })
+    const nested = path.join(d, 'src', 'presentations', 'starter')
+    expect(resolveTarget(nested)).toMatchObject({ kind: 'existing-app', target: d, needsConfirmation: false })
+  })
+
+  it('does not walk past a repository root', () => {
+    const outer = tmp()
+    cpSync(bootstrap, outer, { recursive: true })
+    const inner = path.join(outer, 'sub')
+    mkdirSync(path.join(inner, '.git'), { recursive: true })
+    expect(resolveTarget(inner).kind).not.toBe('existing-app')
+  })
+
+  it('detects a partial scaffold', () => {
+    const d = tmp()
+    cpSync(bootstrap, d, { recursive: true, filter: (s) => !s.includes('presentation-kit') })
+    expect(detectAnchors(d)).toEqual({ buildSetup: true, sceneKit: false, presentationIndex: true })
+  })
+})
+
+describe('mergeDependencies', () => {
+  it('adds only missing packages and scripts and never overwrites', () => {
+    const { pkg, added } = mergeDependencies(
+      { name: 'x', scripts: { build: 'custom' }, dependencies: { react: '^18.0.0' } },
+      { scripts: { build: 'tsc', verify: 'node v' }, dependencies: { react: '^19', motion: '^12' }, devDependencies: { vite: '^8' } },
+    )
+    expect(pkg.dependencies).toEqual({ react: '^18.0.0', motion: '^12' })
+    expect(pkg.devDependencies).toEqual({ vite: '^8' })
+    expect(pkg.scripts).toEqual({ build: 'custom', verify: 'node v' })
+    expect(added.sort()).toEqual(['motion', 'vite'])
+  })
+})
