new file mode 100644
index 0000000000000000000000000000000000000000..713db6f09f34e21e55c14d7a84ec54dd9ed630c2
--- /dev/null
+++ b/scripts/diagnostics.test.mjs
@@ -0,0 +1,78 @@
+import { describe, expect, it } from 'vitest'
+import {
+  evaluateActiveChrome,
+  evaluateAttribution,
+  evaluateOverlaps,
+  warningsForSnapshot,
+} from './lib/diagnostics.mjs'
+import { parseArgs, stepFileName } from './inspect-presentation.mjs'
+
+const el = (uid, x, y, extra = {}) => ({
+  uid,
+  label: `el${uid}`,
+  rect: { x, y, w: 100, h: 20 },
+  allowed: false,
+  ancestors: [],
+  ...extra,
+})
+
+describe('evaluateOverlaps', () => {
+  it('flags unmarked overlap', () => {
+    expect(evaluateOverlaps([el(1, 0, 0), el(2, 10, 5)])).toEqual([{ a: 'el1', b: 'el2' }])
+  })
+  it('ignores disjoint, allowed, and nested elements', () => {
+    expect(evaluateOverlaps([el(1, 0, 0), el(2, 0, 40)])).toEqual([])
+    expect(evaluateOverlaps([el(1, 0, 0), el(2, 10, 5, { allowed: true })])).toEqual([])
+    expect(evaluateOverlaps([el(1, 0, 0), el(2, 10, 5, { ancestors: [1] })])).toEqual([])
+  })
+})
+
+const style = (over = {}) => ({
+  backgroundColor: 'rgb(0, 0, 0)', color: 'rgb(255, 255, 255)', borderTopColor: 'rgb(0, 0, 0)',
+  borderLeftColor: 'rgb(0, 0, 0)', outlineColor: 'rgb(0, 0, 0)', width: '12px', height: '12px',
+  fontWeight: '400', opacity: '1', boxShadow: 'none', textDecorationLine: 'none', transform: 'none',
+  borderTopWidth: '1px', borderLeftWidth: '1px', ...over,
+})
+
+describe('evaluateActiveChrome', () => {
+  const group = (activeStyle) => [{
+    name: 'progress',
+    items: [
+      { label: 'a', active: true, style: activeStyle },
+      { label: 'b', active: false, style: style() },
+    ],
+  }]
+  it('flags identical active/inactive styles', () => {
+    expect(evaluateActiveChrome(group(style()))).toHaveLength(1)
+  })
+  it('accepts a distinct active style', () => {
+    expect(evaluateActiveChrome(group(style({ backgroundColor: 'rgb(224, 185, 79)' })))).toEqual([])
+    expect(evaluateActiveChrome(group(style({ width: '28px' })))).toEqual([])
+  })
+})
+
+describe('evaluateAttribution', () => {
+  const attr = (s, h = 16) => ({ label: 'a', style: { fontSize: '13px', color: 'rgb(224, 185, 79)', textDecorationLine: 'none', ...s }, rect: { w: 100, h } })
+  it('passes a polished link and ignores a missing one', () => {
+    expect(evaluateAttribution(attr({}))).toEqual([])
+    expect(evaluateAttribution(null)).toEqual([])
+  })
+  it('flags tiny and browser-default links', () => {
+    expect(evaluateAttribution(attr({ fontSize: '9px' }, 11))).toHaveLength(1)
+    expect(evaluateAttribution(attr({ color: 'rgb(0, 0, 238)', textDecorationLine: 'underline' }))).toHaveLength(1)
+  })
+  it('points to the styling hook in warnings', () => {
+    const lines = warningsForSnapshot(2, { elements: [], chromeGroups: [], attribution: attr({ fontSize: '8px' }, 10) })
+    expect(lines[0]).toMatch(/^WARN step 2: .*\[data-presentation-attribution\]/)
+  })
+})
+
+describe('inspect args', () => {
+  it('parses options and file names', () => {
+    expect(parseArgs(['demo', '--settle', '50', '--viewport', '390x844', '--skip-build'])).toMatchObject({
+      slug: 'demo', settle: 50, viewport: { width: 390, height: 844 }, build: false,
+    })
+    expect(stepFileName(0)).toBe('step-01.png')
+    expect(() => parseArgs([])).toThrow(/usage/)
+  })
+})
diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c5b05c87948a20b0f20fecbff4385dce2048494e
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,102 @@
+#!/usr/bin/env node
+// Capture settled per-step screenshots of a presentation from a production preview
+// and print advisory (never fatal) visual-quality warnings.
+//
+//   npm run inspect -- <slug> [--settle <ms>] [--viewport WxH] [--out <dir>]
+//                              [--skip-build] [--dist <dir>]
+//
+// By default the script runs `npm run build` first so screenshots reflect the
+// current source; `--skip-build` reuses an existing build (`--dist` selects its dir).
+import fs from 'node:fs'
+import path from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { collectSnapshot, warningsForSnapshot } from './lib/diagnostics.mjs'
+import { HOST, launchChromium, projectRoot, runCommand, startPreview } from './lib/preview.mjs'
+
+export const DEFAULT_SETTLE_MS = 1200 // longer than kit enter delay + enter duration
+export const DEFAULT_VIEWPORT = { width: 1440, height: 900 }
+
+export function parseArgs(argv) {
+  const opts = { slug: undefined, settle: DEFAULT_SETTLE_MS, viewport: DEFAULT_VIEWPORT, out: undefined, build: true, dist: undefined }
+  for (let i = 0; i < argv.length; i++) {
+    const a = argv[i]
+    if (a === '--settle') opts.settle = Number(argv[++i])
+    else if (a === '--viewport') {
+      const m = /^(\d+)x(\d+)$/.exec(argv[++i] ?? '')
+      if (!m) throw new Error('--viewport expects WxH, e.g. 390x844')
+      opts.viewport = { width: Number(m[1]), height: Number(m[2]) }
+    } else if (a === '--out') opts.out = argv[++i]
+    else if (a === '--dist') opts.dist = argv[++i]
+    else if (a === '--skip-build') opts.build = false
+    else if (a.startsWith('--')) throw new Error(`unknown option ${a}`)
+    else opts.slug = a
+  }
+  if (!opts.slug) throw new Error('usage: npm run inspect -- <slug> [--settle <ms>] [--viewport WxH] [--out <dir>] [--skip-build] [--dist <dir>]')
+  if (!Number.isFinite(opts.settle) || opts.settle < 0) throw new Error('--settle expects milliseconds')
+  return opts
+}
+
+export const stepFileName = (index) => `step-${String(index + 1).padStart(2, '0')}.png`
+
+export async function inspect(opts, root = projectRoot()) {
+  if (opts.build) {
+    const { code, output } = await runCommand('npm', ['run', 'build'], { cwd: root })
+    if (code !== 0) throw new Error(`build failed (exit ${code})\n${output.trim()}`)
+  }
+  const outDir = path.resolve(root, opts.out ?? path.join('artifacts', 'inspection', opts.slug))
+  // Only clear files this tool wrote, so a mistaken --out never deletes other data.
+  for (const f of fs.existsSync(outDir) ? fs.readdirSync(outDir) : []) {
+    if (/^step-\d+\.png$/.test(f) || f === 'manifest.json') fs.rmSync(path.join(outDir, f))
+  }
+  fs.mkdirSync(outDir, { recursive: true })
+
+  const warnings = []
+  const manifest = { slug: opts.slug, viewport: opts.viewport, settleMs: opts.settle, steps: [] }
+  const preview = await startPreview(root, { outDir: opts.dist })
+  let browser
+  try {
+    browser = await launchChromium()
+    const page = await browser.newPage({ viewport: opts.viewport })
+    await page.goto(`http://${HOST}:${preview.port}/${opts.slug}`)
+    await page.waitForSelector('[data-presentation-root]', { timeout: 10_000 })
+    const root$ = page.locator('[data-presentation-root]')
+    const count = Number(await root$.getAttribute('data-step-count'))
+    if (!Number.isInteger(count) || count < 1) {
+      throw new Error(`data-step-count is invalid (${count}) for slug "${opts.slug}"`)
+    }
+    for (let i = 0; i < count; i++) {
+      const advancedAt = Date.now()
+      if (i > 0) {
+        await page.keyboard.press('ArrowRight')
+        await page.waitForFunction(
+          (n) => document.querySelector('[data-presentation-root]')?.getAttribute('data-step-index') === String(n),
+          i,
+          { timeout: 5000 },
+        )
+      }
+      await page.waitForTimeout(opts.settle)
+      const stepIndex = Number(await root$.getAttribute('data-step-index'))
+      const file = stepFileName(i)
+      await page.screenshot({ path: path.join(outDir, file) })
+      manifest.steps.push({ step: i + 1, file, stepIndex, advancedAt, capturedAt: Date.now() })
+      warnings.push(...warningsForSnapshot(i + 1, await page.evaluate(collectSnapshot)))
+    }
+  } finally {
+    await browser?.close().catch(() => {})
+    await preview.stop()
+  }
+  fs.writeFileSync(path.join(outDir, 'manifest.json'), JSON.stringify(manifest, null, 2))
+  return { outDir, manifest, warnings }
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  try {
+    const { outDir, manifest, warnings } = await inspect(parseArgs(process.argv.slice(2)))
+    for (const w of warnings) console.log(w)
+    console.log(`Captured ${manifest.steps.length} settled screenshots in ${outDir}`)
+    console.log(warnings.length ? `${warnings.length} advisory warning(s); these do not affect the exit code.` : 'No advisory warnings.')
+  } catch (err) {
+    console.error(`inspect failed: ${err.message}`)
+    process.exit(1)
+  }
+}
diff --git a/scripts/lib/diagnostics.mjs b/scripts/lib/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..eb5cd0e0ba8bad459f5573dc247167f6c80bc8e2
--- /dev/null
+++ b/scripts/lib/diagnostics.mjs
@@ -0,0 +1,215 @@
+// Advisory visual diagnostics. `evaluate*` functions are pure; `collectSnapshot`
+// is the thin in-browser part (serialized into the page by Playwright).
+
+// ---- Thresholds ----
+export const THRESHOLDS = {
+  /** Minimum intersection area (px²) for two text/chrome boxes to count as overlapping. */
+  overlapMinArea: 12,
+  /** Minimum intersection as a fraction of the smaller box. */
+  overlapMinRatio: 0.08,
+  /** Per-channel-summed RGB distance that makes two colors visibly different. */
+  colorDeltaMin: 48,
+  sizeDeltaMinPx: 2,
+  fontWeightDeltaMin: 100,
+  opacityDeltaMin: 0.15,
+  /** Attribution below this font size (px) or box height (px) is "too small". */
+  attributionMinFontPx: 11,
+  attributionMinHeightPx: 12,
+}
+
+const DEFAULT_LINK_COLORS = ['rgb(0, 0, 238)', 'rgb(85, 26, 139)', 'rgb(255, 0, 0)', 'rgb(0, 0, 255)']
+
+function intersection(a, b) {
+  const w = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x)
+  const h = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y)
+  return w > 0 && h > 0 ? w * h : 0
+}
+
+/**
+ * elements: [{ uid, label, rect:{x,y,w,h}, allowed, ancestors:[uid] }]
+ * Returns [{ a, b }] label pairs for overlaps not exempted by allow-overlap.
+ */
+export function evaluateOverlaps(elements, t = THRESHOLDS) {
+  const out = []
+  for (let i = 0; i < elements.length; i++) {
+    for (let j = i + 1; j < elements.length; j++) {
+      const a = elements[i]
+      const b = elements[j]
+      if (a.allowed || b.allowed) continue
+      if (a.ancestors.includes(b.uid) || b.ancestors.includes(a.uid)) continue
+      const area = intersection(a.rect, b.rect)
+      const smaller = Math.min(a.rect.w * a.rect.h, b.rect.w * b.rect.h)
+      if (area >= t.overlapMinArea && smaller > 0 && area / smaller >= t.overlapMinRatio) {
+        out.push({ a: a.label, b: b.label })
+      }
+    }
+  }
+  return out
+}
+
+function rgb(str) {
+  const m = /rgba?\(([^)]+)\)/.exec(str ?? '')
+  if (!m) return null
+  const [r, g, b, a = 1] = m[1].split(/[ ,/]+/).filter(Boolean).map(Number)
+  return { r, g, b, a }
+}
+
+function colorDiffers(x, y, t) {
+  if (x === y) return false
+  const a = rgb(x)
+  const b = rgb(y)
+  if (!a || !b) return true
+  return Math.abs(a.r - b.r) + Math.abs(a.g - b.g) + Math.abs(a.b - b.b) + Math.abs(a.a - b.a) * 255 >= t.colorDeltaMin
+}
+
+/** True when two computed-style snapshots differ visibly in any tracked property. */
+export function stylesDistinct(active, inactive, t = THRESHOLDS) {
+  for (const k of ['backgroundColor', 'color', 'borderTopColor', 'borderLeftColor', 'outlineColor']) {
+    if (colorDiffers(active[k], inactive[k], t)) return true
+  }
+  for (const k of ['width', 'height']) {
+    if (Math.abs(parseFloat(active[k]) - parseFloat(inactive[k])) >= t.sizeDeltaMinPx) return true
+  }
+  if (Math.abs(Number(active.fontWeight) - Number(inactive.fontWeight)) >= t.fontWeightDeltaMin) return true
+  if (Math.abs(Number(active.opacity) - Number(inactive.opacity)) >= t.opacityDeltaMin) return true
+  for (const k of ['boxShadow', 'textDecorationLine', 'transform', 'borderTopWidth', 'borderLeftWidth']) {
+    if (active[k] !== inactive[k]) return true
+  }
+  return false
+}
+
+/**
+ * groups: [{ name, items:[{ label, active, style }] }]
+ * Warns for each group whose active item matches an inactive sibling.
+ */
+export function evaluateActiveChrome(groups, t = THRESHOLDS) {
+  const out = []
+  for (const g of groups) {
+    const active = g.items.find((i) => i.active)
+    const inactive = g.items.filter((i) => !i.active)
+    if (!active || inactive.length === 0) continue
+    const twin = inactive.find((i) => !stylesDistinct(active.style, i.style, t))
+    if (twin) out.push({ name: g.name, active: active.label, twin: twin.label })
+  }
+  return out
+}
+
+/** attribution: null | { label, style:{fontSize,color,textDecorationLine}, rect:{w,h} } */
+export function evaluateAttribution(attribution, t = THRESHOLDS) {
+  if (!attribution) return []
+  const issues = []
+  const size = parseFloat(attribution.style.fontSize)
+  if (size < t.attributionMinFontPx || attribution.rect.h < t.attributionMinHeightPx) {
+    issues.push(`too small (${size}px text, ${Math.round(attribution.rect.h)}px tall)`)
+  }
+  if (
+    DEFAULT_LINK_COLORS.includes(attribution.style.color) &&
+    attribution.style.textDecorationLine.includes('underline')
+  ) {
+    issues.push('browser-default link styling (default link color + underline)')
+  }
+  return issues
+}
+
+/** Turn a snapshot into the WARN lines for one step. */
+export function warningsForSnapshot(step, snapshot, t = THRESHOLDS) {
+  const lines = []
+  for (const o of evaluateOverlaps(snapshot.elements, t)) {
+    lines.push(
+      `WARN step ${step}: overlap between ${o.a} and ${o.b}; fix the layout or wrap an intentional overlap in [data-presentation-allow-overlap]`,
+    )
+  }
+  for (const c of evaluateActiveChrome(snapshot.chromeGroups, t)) {
+    lines.push(
+      `WARN step ${step}: active ${c.name} item ${c.active} looks the same as inactive ${c.twin}; style [data-presentation-active="true"]`,
+    )
+  }
+  for (const issue of evaluateAttribution(snapshot.attribution, t)) {
+    lines.push(
+      `WARN step ${step}: attribution link is ${issue}; style the [data-presentation-attribution] hook in your presentation CSS`,
+    )
+  }
+  return lines
+}
+
+/** Runs inside the page. Must stay self-contained (no closures over module scope). */
+export function collectSnapshot() {
+  const STYLE_KEYS = [
+    'backgroundColor', 'color', 'borderTopColor', 'borderLeftColor', 'outlineColor', 'width', 'height',
+    'fontWeight', 'opacity', 'boxShadow', 'textDecorationLine', 'transform', 'borderTopWidth', 'borderLeftWidth',
+  ]
+  const styleOf = (el) => {
+    const cs = getComputedStyle(el)
+    const out = {}
+    for (const k of STYLE_KEYS) out[k] = cs[k]
+    out.fontSize = cs.fontSize
+    return out
+  }
+  const visible = (el) => {
+    let opacity = 1
+    for (let n = el; n && n !== document.documentElement; n = n.parentElement) {
+      const cs = getComputedStyle(n)
+      if (cs.display === 'none' || cs.visibility === 'hidden') return false
+      opacity *= Number(cs.opacity)
+    }
+    return opacity > 0.05
+  }
+  const describe = (el) => {
+    const hook = el.getAttributeNames().find((a) => a.startsWith('data-presentation-') && a !== 'data-presentation-active')
+    const text = (el.textContent ?? '').trim().replace(/\s+/g, ' ').slice(0, 40)
+    return `<${el.tagName.toLowerCase()}${hook ? ` ${hook}` : ''}>${text ? ` "${text}"` : ''}`
+  }
+  const rectOf = (r) => ({ x: r.left, y: r.top, w: r.width, h: r.height })
+
+  const found = new Map()
+  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT)
+  for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+    if (!node.nodeValue.trim() || !node.parentElement) continue
+    if (['SCRIPT', 'STYLE', 'NOSCRIPT'].includes(node.parentElement.tagName)) continue
+    const range = document.createRange()
+    range.selectNodeContents(node)
+    const r = range.getBoundingClientRect()
+    if (r.width <= 0 || r.height <= 0) continue
+    const el = node.parentElement
+    const prev = found.get(el)
+    if (!prev) found.set(el, r)
+    else {
+      const l = Math.min(prev.left, r.left), t = Math.min(prev.top, r.top)
+      found.set(el, new DOMRect(l, t, Math.max(prev.right, r.right) - l, Math.max(prev.bottom, r.bottom) - t))
+    }
+  }
+  // Text-less chrome (e.g. progress dots) participates by its box.
+  for (const el of document.querySelectorAll('[data-presentation-progress-item], [data-presentation-toc-item]')) {
+    if (!found.has(el)) found.set(el, el.getBoundingClientRect())
+  }
+  const entries = [...found.entries()].filter(([el]) => visible(el))
+  const elements = entries.map(([el, r], uid) => ({
+    uid, el, label: describe(el), rect: rectOf(r), allowed: !!el.closest('[data-presentation-allow-overlap]'),
+  }))
+  for (const e of elements) {
+    e.ancestors = elements.filter((o) => o !== e && o.el.contains(e.el)).map((o) => o.uid)
+  }
+  const chromeGroups = []
+  for (const [name, sel] of [['progress', '[data-presentation-progress-item]'], ['table-of-contents', '[data-presentation-toc-item]']]) {
+    const items = [...document.querySelectorAll(sel)].filter(visible)
+    if (items.length) {
+      chromeGroups.push({
+        name,
+        items: items.map((el) => ({
+          label: describe(el) + (el.getAttribute('aria-label') ? ` (${el.getAttribute('aria-label')})` : ''),
+          active: el.getAttribute('data-presentation-active') === 'true',
+          style: styleOf(el),
+        })),
+      })
+    }
+  }
+  const a = document.querySelector('[data-presentation-attribution]')
+  const attribution = a && visible(a)
+    ? { label: describe(a), style: styleOf(a), rect: rectOf(a.getBoundingClientRect()) }
+    : null
+  return {
+    elements: elements.map(({ el: _el, ...rest }) => rest),
+    chromeGroups,
+    attribution,
+  }
+}
