@@ -0,0 +1,28 @@
+export const DEFAULTS = { settleMs: 1500, width: 1440, height: 900 }
+
+export function screenshotName(index) {
+  return `step-${String(index + 1).padStart(2, '0')}.png`
+}
+
+/** Parses `<slug> [--out dir] [--settle ms] [--viewport WxH] [--skip-build]`. */
+export function parseArgs(argv) {
+  const options = { slug: null, out: null, settleMs: DEFAULTS.settleMs, width: DEFAULTS.width, height: DEFAULTS.height, skipBuild: false }
+  for (let i = 0; i < argv.length; i++) {
+    const arg = argv[i]
+    if (arg === '--skip-build') options.skipBuild = true
+    else if (arg === '--out') options.out = argv[++i]
+    else if (arg === '--settle') {
+      options.settleMs = Number(argv[++i])
+      if (!Number.isFinite(options.settleMs) || options.settleMs < 0) throw new Error('--settle needs a non-negative number of milliseconds')
+    } else if (arg === '--viewport') {
+      const match = /^(\d+)x(\d+)$/.exec(argv[++i] ?? '')
+      if (!match) throw new Error('--viewport needs WIDTHxHEIGHT, for example 1440x900')
+      options.width = Number(match[1])
+      options.height = Number(match[2])
+    } else if (arg.startsWith('--')) throw new Error(`unknown option ${arg}`)
+    else if (!options.slug) options.slug = arg
+    else throw new Error(`unexpected argument ${arg}`)
+  }
+  if (!options.slug) throw new Error('usage: npm run inspect -- <slug> [--out dir] [--settle ms] [--viewport WxH] [--skip-build]')
+  return options
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/project.mjs b/skills/presentation/templates/bootstrap/scripts/lib/project.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f98ec7c0871dc8878dc2eedd0b2f64112d23795c
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/project.mjs
@@ -0,0 +1,97 @@
+import { spawn } from 'node:child_process'
+import { readFile } from 'node:fs/promises'
+import net from 'node:net'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+/** All local browser automation uses the IPv4 loopback address. */
+export const HOST = '127.0.0.1'
+
+/** The project root is the parent of `scripts/`, regardless of the caller's cwd. */
+export const PROJECT_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..')
+
+export function freePort() {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer()
+    server.once('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+}
+
+function run(command, args, options) {
+  return new Promise((resolve) => {
+    const child = spawn(command, args, { ...options, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (chunk) => (output += chunk))
+    child.stderr.on('data', (chunk) => (output += chunk))
+    child.on('error', (error) => resolve({ code: 1, output: String(error) }))
+    child.on('close', (code) => resolve({ code: code ?? 1, output }))
+  })
+}
+
+export function runBuild(root = PROJECT_ROOT) {
+  return run('npm', ['run', 'build'], { cwd: root })
+}
+
+/** Reads `{ slug, title }` pairs from the explicit registry source. */
+export async function readRegistry(root = PROJECT_ROOT) {
+  const source = await readFile(path.join(root, 'src/presentations/index.ts'), 'utf8')
+  const entries = []
+  for (const match of source.matchAll(/slug:\s*(['"])(.*?)\1\s*,\s*title:\s*(['"])(.*?)\3/gs)) {
+    entries.push({ slug: match[2], title: match[4] })
+  }
+  return entries
+}
+
+/**
+ * Starts `vite preview` on the loopback address and resolves once it answers.
+ * `stop()` terminates the process and resolves when it has exited.
+ */
+export async function startPreview(root = PROJECT_ROOT, { timeoutMs = 30000 } = {}) {
+  const port = await freePort()
+  const vite = path.join(root, 'node_modules/vite/bin/vite.js')
+  const child = spawn(
+    process.execPath,
+    [vite, 'preview', '--host', HOST, '--port', String(port), '--strictPort'],
+    { cwd: root, stdio: ['ignore', 'pipe', 'pipe'] },
+  )
+  let log = ''
+  let exited = false
+  child.stdout.on('data', (chunk) => (log += chunk))
+  child.stderr.on('data', (chunk) => (log += chunk))
+  const exit = new Promise((resolve) => child.once('exit', () => ((exited = true), resolve())))
+  const stop = async () => {
+    if (exited) return
+    child.kill('SIGTERM')
+    const timer = setTimeout(() => child.kill('SIGKILL'), 3000)
+    await exit
+    clearTimeout(timer)
+  }
+  const url = `http://${HOST}:${port}`
+  const deadline = Date.now() + timeoutMs
+  try {
+    for (;;) {
+      if (exited) throw new Error(`preview exited early:\n${log}`)
+      if (Date.now() > deadline) throw new Error(`preview not ready at ${url}:\n${log}`)
+      try {
+        const response = await fetch(`${url}/`)
+        if (response.ok) break
+      } catch {
+        /* not listening yet */
+      }
+      await new Promise((resolve) => setTimeout(resolve, 150))
+    }
+  } catch (error) {
+    await stop()
+    throw error
+  }
+  return { url, port, stop }
+}
+
+export async function launchBrowser() {
+  const { chromium } = await import('playwright')
+  return chromium.launch({ headless: true })
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/verify-core.mjs b/skills/presentation/templates/bootstrap/scripts/lib/verify-core.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..15dfab52ec4880935f9badd368611a935278f0e7
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/verify-core.mjs
@@ -0,0 +1,48 @@
+/** Pure checks used by verify.mjs; kept free of I/O so they can be unit tested. */
+
+/**
+ * Confirms the registry holds the mandatory sample (when one is configured) and
+ * returns the route to render: the requested slug, else the sample, else the
+ * first registered presentation. Only the sample has expected step text.
+ */
+export function selectTarget(registry, sample, requested = null) {
+  let expected = null
+  if (sample) {
+    const entry = registry.find((e) => e.slug === sample.slug)
+    if (!entry) throw new Error(`reference sample "${sample.slug}" is not registered`)
+    if (entry.title !== sample.title) {
+      throw new Error(`sample title is "${entry.title}", expected "${sample.title}"`)
+    }
+    expected = sample.steps
+  }
+  if (requested && requested !== sample?.slug) {
+    if (!registry.some((e) => e.slug === requested)) {
+      throw new Error(`presentation "${requested}" is not registered; registered: ${registry.map((e) => e.slug).join(', ')}`)
+    }
+    return { slug: requested, expected: null }
+  }
+  if (sample) return { slug: sample.slug, expected }
+  if (registry.length === 0) throw new Error('no presentation is registered in src/presentations/index.ts')
+  return { slug: requested ?? registry[0].slug, expected: null }
+}
+
+/** Describes how an observed step differs from the expected one, or returns null. */
+export function diffStep(expected, observed) {
+  for (const field of ['era', 'title', 'caption']) {
+    if (observed[field] !== expected[field]) {
+      return `${field} is ${JSON.stringify(observed[field])}, expected ${JSON.stringify(expected[field])}`
+    }
+  }
+  return null
+}
+
+/** The step index must advance by exactly one per transition. */
+export function checkAdvance(previous, observed) {
+  if (observed === previous + 1) return null
+  if (observed === previous) return `step index stayed at ${previous}`
+  return `step index went from ${previous} to ${observed}, expected ${previous + 1}`
+}
+
+export function formatError(kind, step, text) {
+  return `${kind} at step ${step}: ${text}`
+}
