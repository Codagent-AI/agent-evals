+import type { Step } from '../../presentation-kit'
+import { DiagramScene } from './DiagramScene'
+import type { DiagramPayload } from './DiagramScene'
+
+type Beat = Pick<Step<DiagramPayload>, 'id' | 'era' | 'title' | 'caption'>
+
+const BEATS: readonly Beat[] = [
+  { id: 'topic', era: 'the ask', title: 'You have a topic', caption: 'It starts with you, a topic, and mild overconfidence.' },
+  { id: 'interview', era: 'the ask', title: 'The skill interviews you', caption: 'One question at a time: the topic, the look, then each beat of the story.' },
+  { id: 'steps', era: 'the gathering', title: 'Answers become steps', caption: 'Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next.' },
+  { id: 'grows', era: 'the gathering', title: 'The deck grows', caption: 'Same shapes, new beats. Every answer extends the story without redrawing it.' },
+  { id: 'depth', era: 'the gathering', title: 'You set the depth', caption: 'Spell out every step, or sketch a few and see how it looks. You hold the gate.' },
+  { id: 'assemble', era: 'the build', title: 'It assembles the scene', caption: 'Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph.' },
+  { id: 'verify', era: 'the build', title: 'It checks its own work', caption: 'Before saying done, it builds and renders every step — and fixes what breaks.' },
+  { id: 'loop', era: 'the loop', title: 'Changed your mind? Loop it.', caption: 'Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch.' },
+  { id: 'reveal', era: 'the reveal', title: "You're looking at one", caption: 'This presentation was built exactly this way. Thanks for watching.' },
+]
+
+export const STEPS: readonly Step<DiagramPayload>[] = BEATS.map((beat, stage) => ({
+  ...beat,
+  groupKey: 'diagram',
+  Scene: DiagramScene,
+  payload: { stage },
+}))
