@@ -0,0 +1,58 @@
+import type { ReactNode } from 'react'
+
+export type PresentationMode = 'present' | 'browse'
+
+export interface Canvas {
+  width: number
+  height: number
+}
+
+/** Props every scene component receives: the active step's payload. */
+export interface SceneProps<TPayload = undefined> {
+  payload: TPayload
+}
+
+// Method-style signature keeps scene components bivariant in their payload so a
+// Step<P> can cross the Presentation boundary without casts, while mismatched
+// Scene/payload pairs are still rejected where a Step<P> is declared.
+export type Scene<TPayload = undefined> = {
+  bivarianceHack(props: SceneProps<TPayload>): ReactNode
+}['bivarianceHack']
+
+export interface StepMeta {
+  /** Stable identity; never derived from position. */
+  id: string
+  /** Section/era label, also the table-of-contents grouping. */
+  era: string
+  /** Presenter title (one-liner). */
+  title: string
+  /** Browse caption (paragraph). */
+  caption: string
+}
+
+export interface Step<TPayload = undefined> extends StepMeta {
+  /** Adjacent steps sharing a groupKey and Scene keep one mounted scene. */
+  groupKey?: string
+  Scene: Scene<TPayload>
+  /** The diagram state shown while this step is active. */
+  payload: TPayload
+}
+
+export interface AttributionOptions {
+  /** Replaces the default "made by and-scene" link. */
+  content: ReactNode
+}
+
+export interface PresentationProps {
+  steps: readonly Step<unknown>[]
+  title: string
+  initialMode?: PresentationMode
+  initialIndex?: number
+  /** Host-provided top-left brand; the kit renders none by default. */
+  brand?: ReactNode
+  /** `false` removes the attribution, an object replaces it. */
+  attribution?: false | AttributionOptions
+  /** Overrides the fixed design canvas. */
+  canvas?: Canvas
+  className?: string
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b854e207ba409778d095ad69a81c8c345bbba502
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,55 @@
+import { useEffect, useState } from 'react'
+import { DEFAULT_CANVAS, MIN_SCALE, STAGE_LAYOUT, TOC_WIDTH, WIDE_BREAKPOINT } from './constants'
+import type { Canvas, PresentationMode } from './types'
+
+export interface Viewport {
+  width: number
+  height: number
+}
+
+export interface Fit {
+  scale: number
+  /** The region (viewport px) the canvas is centered in. */
+  region: { top: number; bottom: number; left: number; right: number }
+}
+
+export function computeFit(
+  viewport: Viewport,
+  mode: PresentationMode,
+  tocVisible: boolean,
+  canvas: Canvas = DEFAULT_CANVAS,
+): Fit {
+  const insets = STAGE_LAYOUT[mode]
+  const left = insets.left + (tocVisible ? TOC_WIDTH : 0)
+  const availW = Math.max(viewport.width - left - insets.right, 0)
+  const availH = Math.max(viewport.height - insets.top - insets.bottom, 0)
+  const scale = Math.max(Math.min(availW / canvas.width, availH / canvas.height), MIN_SCALE)
+  return { scale, region: { top: insets.top, bottom: insets.bottom, left, right: insets.right } }
+}
+
+export function readViewport(): Viewport {
+  return { width: window.innerWidth, height: window.innerHeight }
+}
+
+export function useViewport(): Viewport {
+  const [viewport, setViewport] = useState(readViewport)
+  useEffect(() => {
+    const onResize = () => setViewport(readViewport())
+    window.addEventListener('resize', onResize)
+    onResize()
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return viewport
+}
+
+export interface FitState extends Fit {
+  wide: boolean
+  tocVisible: boolean
+}
+
+export function useFitScale(mode: PresentationMode, canvas: Canvas = DEFAULT_CANVAS): FitState {
+  const viewport = useViewport()
+  const wide = viewport.width >= WIDE_BREAKPOINT
+  const tocVisible = mode === 'browse' && wide
+  return { ...computeFit(viewport, mode, tocVisible, canvas), wide, tocVisible }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4dd66b4e1a91362484dcfe6c43e83b4df603859b
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,119 @@
+import { useCallback, useEffect, useState } from 'react'
+import { SWIPE_MIN_PX } from './constants'
+import type { PresentationMode } from './types'
+
+export type SwipeResult = 'next' | 'prev' | null
+
+/** Horizontal travel must pass the threshold and dominate vertical travel. */
+export function classifySwipe(dx: number, dy: number, min = SWIPE_MIN_PX): SwipeResult {
+  if (Math.abs(dx) < min || Math.abs(dx) <= Math.abs(dy)) return null
+  return dx < 0 ? 'next' : 'prev'
+}
+
+const INTERACTIVE_ROLES = new Set([
+  'button', 'link', 'checkbox', 'radio', 'switch', 'tab', 'menuitem', 'option',
+  'slider', 'spinbutton', 'textbox', 'combobox', 'searchbox',
+])
+const INTERACTIVE_SELECTOR = 'button, a[href], input, select, textarea, summary'
+
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+  if (!(target instanceof Element)) return false
+  if (target.closest(INTERACTIVE_SELECTOR)) return true
+  const editable = target.closest('[contenteditable]')
+  if (editable && editable.getAttribute('contenteditable') !== 'false') return true
+  const roled = target.closest('[role]')
+  return !!roled && INTERACTIVE_ROLES.has(roled.getAttribute('role') ?? '')
+}
+
+export type NavAction = 'next' | 'prev' | 'toggle-mode'
+
+export function keyToAction(key: string): NavAction | null {
+  switch (key) {
+    case 'ArrowRight':
+    case ' ':
+    case 'PageDown':
+      return 'next'
+    case 'ArrowLeft':
+    case 'PageUp':
+      return 'prev'
+    case 'p':
+    case 'P':
+      return 'toggle-mode'
+    default:
+      return null
+  }
+}
+
+export interface NavOptions {
+  count: number
+  initialIndex?: number
+  initialMode?: PresentationMode
+}
+
+export interface Nav {
+  index: number
+  mode: PresentationMode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  setMode: (mode: PresentationMode) => void
+  toggleMode: () => void
+}
+
+export function usePresentationNav({
+  count,
+  initialIndex = 0,
+  initialMode = 'browse',
+}: NavOptions): Nav {
+  const last = Math.max(count - 1, 0)
+  const [rawIndex, setIndex] = useState(initialIndex)
+  const [mode, setMode] = useState<PresentationMode>(initialMode)
+  const index = Math.min(Math.max(rawIndex, 0), last)
+
+  const goTo = useCallback(
+    (target: number) => setIndex(Math.min(Math.max(target, 0), last)),
+    [last],
+  )
+  const next = useCallback(() => setIndex(Math.min(index + 1, last)), [index, last])
+  const prev = useCallback(() => setIndex(Math.max(index - 1, 0)), [index])
+  const toggleMode = useCallback(
+    () => setMode((m) => (m === 'present' ? 'browse' : 'present')),
+    [],
+  )
+
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      if (event.ctrlKey || event.metaKey || event.altKey) return
+      if (isInteractiveTarget(event.target)) return
+      const action = keyToAction(event.key)
+      if (!action) return
+      event.preventDefault()
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else toggleMode()
+    }
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (event: TouchEvent) => {
+      const t = event.changedTouches[0]
+      start = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onTouchEnd = (event: TouchEvent) => {
+      const t = event.changedTouches[0]
+      if (!start || !t) return
+      const result = classifySwipe(t.clientX - start.x, t.clientY - start.y)
+      start = null
+      if (result === 'next') next()
+      else if (result === 'prev') prev()
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart)
+    window.addEventListener('touchend', onTouchEnd)
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, next, prev, goTo, setMode, toggleMode }
+}
