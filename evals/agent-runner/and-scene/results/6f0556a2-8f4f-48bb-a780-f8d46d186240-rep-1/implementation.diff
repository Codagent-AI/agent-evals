+import type { CSSProperties } from 'react'
+import { EASE, LAYOUT_T } from '../constants'
+
+export interface Rect {
+  x: number
+  y: number
+  w: number
+  h: number
+}
+
+export const LAYOUT_TRANSITION = { duration: LAYOUT_T, ease: EASE }
+
+/** Literal canvas coordinates; pure placement, no visual styling. */
+export function rectStyle(at?: Rect): CSSProperties {
+  return at
+    ? { position: 'absolute', left: at.x, top: at.y, width: at.w, height: at.h }
+    : {}
+}
+
+/** Absolutely fills the canvas; used by layers and wrappers that must not affect layout. */
+export const FILL_STYLE: CSSProperties = { position: 'absolute', left: 0, top: 0, width: '100%', height: '100%' }
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
new file mode 100644
index 0000000000000000000000000000000000000000..382e892e2c045dfeaca1ab6d785e7c24539de56e
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
@@ -0,0 +1,18 @@
+import type { Scene, Step } from './types'
+
+const sceneIds = new WeakMap<object, number>()
+let nextSceneId = 1
+
+function sceneId(scene: Scene<never> | Scene<unknown>): number {
+  let id = sceneIds.get(scene)
+  if (id === undefined) {
+    id = nextSceneId++
+    sceneIds.set(scene, id)
+  }
+  return id
+}
+
+/** Steps sharing a groupKey and Scene share a key, so the scene instance persists. */
+export function sceneKey(step: Step<unknown>): string {
+  return `${step.groupKey ?? step.id}#${sceneId(step.Scene)}`
+}
