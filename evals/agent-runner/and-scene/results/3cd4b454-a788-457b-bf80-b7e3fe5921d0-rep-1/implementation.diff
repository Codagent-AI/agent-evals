@@ -0,0 +1,35 @@
+import type { ReactNode } from 'react'
+import { Header } from './chrome/Header'
+import { Footer } from './chrome/Footer'
+import { Toc } from './chrome/Toc'
+import { Stage } from './Stage'
+import type { PresentationMode, Step } from './types'
+import { useFitScale } from './useFitScale'
+import { usePresentationNav } from './usePresentationNav'
+
+export interface PresentationProps<TPayload = undefined> {
+  steps: readonly Step<TPayload>[]
+  title: string
+  initialMode?: PresentationMode
+  brand?: ReactNode
+  attribution?: false | { label: string; href: string }
+  className?: string
+}
+
+export function Presentation<TPayload = undefined>({ steps, title, initialMode = 'browse', brand, attribution = {
+  label: 'made by and-scene', href: 'https://github.com/Codagent-AI/and-scene',
+}, className }: PresentationProps<TPayload>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const fit = useFitScale(nav.mode)
+  if (!steps.length) throw new Error('A presentation requires at least one step.')
+
+  return <main className={className} data-presentation-chrome data-presentation-mode={nav.mode}
+    data-step-count={steps.length} data-step-index={nav.index} aria-label={title}
+    style={{ position: 'relative', width: '100%', height: '100dvh' }} {...nav.touchHandlers}>
+    <Stage steps={steps} index={nav.index} fit={fit} />
+    <Header step={steps[nav.index]} index={nav.index} count={steps.length} mode={nav.mode} brand={brand} title={title} />
+    {nav.mode === 'browse' && fit.wide && <Toc steps={steps} index={nav.index} jump={nav.jump} top={fit.top} />}
+    <Footer steps={steps} index={nav.index} mode={nav.mode} jump={nav.jump} prev={nav.prev} next={nav.next} left={fit.left} right={fit.right} />
+    {attribution && <a data-presentation-attribution href={attribution.href} style={{ position: 'absolute', bottom: 8, right: 24 }}>{attribution.label}</a>}
+  </main>
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/README.md b/skills/presentation/templates/bootstrap/src/presentation-kit/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..bd472a0c3766e6e19e88d688d5d13b771af46d14
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/README.md
@@ -0,0 +1,44 @@
+# Scene kit
+
+A presentation supplies an ordered `Step<TPayload>[]`, a title, and (optionally)
+`initialMode`, `brand`, `attribution`, and `className` to `Presentation`.
+Each step supplies `id`, `era`, `title`, `caption`, `Scene`, and `payload`.
+For a scene with no data, use the default payload type and `payload: undefined`.
+`SceneProps<TPayload>` keeps payloads typed at the presentation boundary.
+
+Adjacent steps with the same `groupKey` and the same `Scene` component update the
+existing scene instance. A different group or component begins a cross-fade;
+shared `layoutId`s continue to project through the enclosing `LayoutGroup`.
+Use presentation-specific identity namespaces to avoid accidental collisions.
+
+Continuing entities use primitives (or raw Motion elements) with stable
+`layoutId`s directly. Wrap only newcomers in `Appear`, keyed inside an
+`AnimatePresence` owned by the scene; entry waits `ENTER_DELAY` for layout motion
+to settle, while exit is immediate. `SceneLayer` positions diagrams absolutely.
+Never use a new `Appear` wrapper for an entity that continues between beats.
+
+`Box`, `Label`, `Arrow`, `Frame`, `Emphasis`, and `SymbolChip` provide identities,
+motion, and hooks; their shapes and visual treatments come from the author.
+Arrow content can be a glyph, SVG, or other author-supplied markup. `Box` accepts
+an optional `Icon: LucideIcon`. All nodes forward class, style, and data hooks.
+The kit adds no CSS. Canvas and chrome geometry are constant per mode and do not
+depend on step content; keep narration within the reserved chrome regions.
+
+Navigation: Right / Space / PageDown advances, Left / PageUp goes back, and P
+switches browse/present modes. Focused interactive controls retain their keys.
+Horizontal touch swipes navigate; progress buttons jump to a step, and table of
+contents buttons jump to the first step of an era. Numbering follows array order.
+Attribution defaults to `made by and-scene`, can be replaced with `{ label, href }`,
+or disabled with `false`. Header branding is empty unless supplied explicitly.
+
+The chrome root exposes `data-step-count`, `data-step-index`,
+`data-presentation-chrome`, and `data-presentation-mode`. Active progress and ToC
+buttons expose `data-presentation-active="true"` with `aria-current`. Authors own
+active-state styling and attribution legibility. The `data-presentation-*` hooks
+on narration, stage, nodes, and controls are the public inspection contract.
+`ALLOW_OVERLAP_ATTRIBUTE` exports `data-presentation-allow-overlap`; apply this
+subtree marker only to intentional, readable overlap. Inspection tooling consumes
+it; the kit does not alter a marked composition.
+
+Canonical files in this directory must stay byte-aligned with
+`skills/presentation/templates/bootstrap/src/presentation-kit/`.
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a26b173d4f61eff40244358ea70d66a942529b65
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
@@ -0,0 +1,39 @@
+import { useId, useMemo } from 'react'
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, EASE, ENTER_T } from './constants'
+import type { Step } from './types'
+import type { computeFitScale } from './useFitScale'
+
+export interface StageProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  index: number
+  fit: ReturnType<typeof computeFitScale>
+}
+
+export function Stage<TPayload>({ steps, index, fit }: StageProps<TPayload>) {
+  const namespace = useId()
+  // Each contiguous run is distinct. Reusing a group name after leaving it
+  // cannot revive an exiting scene; component changes also begin a new run.
+  const keys = useMemo(() => {
+    let run = 0
+    return steps.map((step, i) => {
+      const previous = steps[i - 1]
+      if (!previous || !step.groupKey || step.groupKey !== previous.groupKey || step.Scene !== previous.Scene) run++
+      return `scene-${run}`
+    })
+  }, [steps])
+  const step = steps[index]
+  const Scene = step.Scene
+
+  return <div style={{ position: 'absolute', left: fit.left, right: fit.right, top: fit.top, bottom: fit.bottom }}>
+    <div data-presentation-stage style={{ position: 'absolute', width: DESIGN_W, height: DESIGN_H, left: '50%', top: '50%', transform: `translate(-50%, -50%) scale(${fit.scale})` }}>
+      <LayoutGroup id={namespace}>
+        <AnimatePresence initial={false}>
+          <motion.div key={keys[index]} style={{ position: 'absolute', inset: 0 }} initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} transition={{ duration: ENTER_T, ease: EASE }}>
+            <Scene payload={step.payload} />
+          </motion.div>
+        </AnimatePresence>
+      </LayoutGroup>
+    </div>
+  </div>
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/Footer.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/Footer.tsx
new file mode 100644
