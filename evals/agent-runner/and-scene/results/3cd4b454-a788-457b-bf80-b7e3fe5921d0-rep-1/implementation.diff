@@ -0,0 +1,70 @@
+.reference-presentation {
+  background: #f5f2eb; color: #263c34; font-family: ui-sans-serif, system-ui, sans-serif;
+  overflow: hidden;
+}
+.reference-presentation * { box-sizing: border-box; }
+.reference-presentation header { padding: 24px 32px; }
+.reference-presentation [data-presentation-marker] { font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums; }
+.reference-presentation [data-presentation-era] { margin-left: 18px; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: #68766d; }
+.reference-presentation h1 { margin: 9px 0 0; font-weight: 500; font-size: clamp(25px, 3vw, 38px); letter-spacing: -.04em; line-height: 1.15; }
+.reference-presentation [data-presentation-caption] { max-width: 750px; font-size: 18px; line-height: 1.55; margin: 0 0 24px; color: #52645a; }
+.reference-presentation footer nav { display: flex; align-items: center; gap: 20px; }
+.reference-presentation button { font: inherit; cursor: pointer; border: 1px solid #c4cec4; color: #334c40; background: transparent; border-radius: 6px; padding: 9px 13px; }
+.reference-presentation button:hover { background: #e8e9de; }
+.reference-presentation button:focus-visible { outline: 2px solid #397554; outline-offset: 3px; }
+.reference-presentation button:disabled { opacity: .35; cursor: default; }
