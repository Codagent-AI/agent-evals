diff --git a/scripts/browser-preview.mjs b/scripts/browser-preview.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..16b746f46a606ee3192145ec3ac172d1b3c97725
--- /dev/null
+++ b/scripts/browser-preview.mjs
@@ -0,0 +1,38 @@
+import { spawn } from 'node:child_process'
+import { once } from 'node:events'
+import { createServer } from 'node:net'
+import { setTimeout as delay } from 'node:timers/promises'
+
+export async function stop(child) {
+  if (!child || child.exitCode !== null || child.signalCode !== null) return
+  const exited = once(child, 'exit')
+  child.kill('SIGTERM')
+  const timer = setTimeout(() => child.kill('SIGKILL'), 3000)
+  try { await exited } finally { clearTimeout(timer) }
+}
+
+export async function availablePort(requested = 0) {
+  const server = createServer()
+  await new Promise((resolve, reject) => { server.once('error', reject); server.listen(requested, '127.0.0.1', resolve) })
+  const port = server.address().port
+  await new Promise(resolve => server.close(resolve))
+  return port
+}
+
+export function spawnPreview(port) {
+  return spawn(process.execPath, ['node_modules/vite/bin/vite.js', 'preview', '--host', '127.0.0.1', '--port', String(port), '--strictPort'], { stdio: ['ignore', 'pipe', 'pipe'], env: { ...process.env, NODE_ENV: 'production' } })
+}
+
+export async function waitForPreview(preview, origin) {
+  let output = ''
+  preview.stdout.on('data', data => { output += data })
+  preview.stderr.on('data', data => { output += data })
+  for (let attempt = 0; attempt < 100; attempt++) {
+    if (preview.exitCode !== null) throw new Error(`Preview exited: ${output}`)
+    let ready = false
+    try { ready = (await fetch(origin, { signal: AbortSignal.timeout(500) })).ok } catch { /* not ready yet */ }
+    if (ready) return
+    await delay(150)
+  }
+  throw new Error(`Preview did not become ready: ${output}`)
+}
diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..afdd4d9e568c5847c14d20ebdd39ef3d275076ee
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,180 @@
+import { spawn } from 'node:child_process'
+import { once } from 'node:events'
+import { access, mkdir, readFile, readdir, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import ts from 'typescript'
+import { chromium } from 'playwright'
+import { availablePort, spawnPreview, stop, waitForPreview } from './browser-preview.mjs'
+
+// Advisory diagnostic thresholds in CSS pixels.
+const DIAGNOSTICS = { overlapTolerance: 2, minAttributionFont: 11, minOpacity: 0.05, sizeTolerance: 1 }
+const SETTLE_MARGIN_MS = 150
+let preview, browser, build
+let step = 1
+async function cleanup() {
+  try { await browser?.close() } finally { await stop(preview); await stop(build) }
+}
+for (const signal of ['SIGINT', 'SIGTERM']) process.once(signal, async () => {
+  console.error(`FAIL step ${step}: interrupted by ${signal}`)
+  await cleanup()
+  process.exit(1)
+})
+
+// Runs inside Chromium. Only elements with their own text are candidates; empty
+// enclosing diagram containers are not collisions. Ancestor/child pairs are excluded.
+function diagnose(thresholds) {
+  const root = document.querySelector('[data-step-count][data-step-index]')
+  const warnings = []
+  const chromeSelector = ['title', 'caption', 'progress-item', 'toc-item', 'prev', 'next', 'attribution']
+    .map(name => `[data-presentation-${name}]`).join(',')
+  function visibleRect(element, rect = element.getBoundingClientRect()) {
+    if (rect.width <= 0 || rect.height <= 0) return null
+    let left = Math.max(0, rect.left), top = Math.max(0, rect.top)
+    let right = Math.min(innerWidth, rect.right), bottom = Math.min(innerHeight, rect.bottom)
+    let opacity = 1
+    for (let parent = element; parent; parent = parent.parentElement) {
+      const style = getComputedStyle(parent)
+      opacity *= Number(style.opacity)
+      if (style.display === 'none' || style.visibility !== 'visible' || opacity < thresholds.minOpacity) return null
+      if (parent !== element) {
+        const box = parent.getBoundingClientRect()
+        if (['hidden', 'clip', 'scroll', 'auto'].includes(style.overflowX)) { left = Math.max(left, box.left); right = Math.min(right, box.right) }
+        if (['hidden', 'clip', 'scroll', 'auto'].includes(style.overflowY)) { top = Math.max(top, box.top); bottom = Math.min(bottom, box.bottom) }
+      }
+    }
+    return right > left && bottom > top ? { left, right, top, bottom } : null
+  }
+  function describe(element, text = element.textContent) {
+    const hook = element.getAttributeNames().find(name => name.startsWith('data-presentation-') && name !== 'data-presentation-active')
+    return `${hook ? `[${hook}]` : element.tagName.toLowerCase()} ${JSON.stringify(text?.trim().replace(/\s+/g, ' ').slice(0, 90))}`
+  }
+  const candidates = []
+  function add(element, rect, text) {
+    if (element.closest('[data-presentation-allow-overlap]')) return
+    const visible = visibleRect(element, rect)
+    if (visible) candidates.push({ element, rect: visible, label: describe(element, text) })
+  }
+  for (const element of root.querySelectorAll(chromeSelector)) add(element, element.getBoundingClientRect(), element.textContent)
+  const textElements = new Set()
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
+  while (walker.nextNode()) {
+    const node = walker.currentNode
+    const element = node.parentElement
+    if (!node.textContent.trim() || element.closest(`${chromeSelector},script,style,svg`)) continue
+    if (textElements.has(element)) continue
+    textElements.add(element)
+    add(element, element.getBoundingClientRect(), element.textContent)
+  }
+  const reported = new Set()
+  for (let i = 0; i < candidates.length; i++) for (let j = i + 1; j < candidates.length; j++) {
+    const a = candidates[i], b = candidates[j]
+    if (a.element === b.element || a.element.contains(b.element) || b.element.contains(a.element)) continue
+    const width = Math.min(a.rect.right, b.rect.right) - Math.max(a.rect.left, b.rect.left)
+    const height = Math.min(a.rect.bottom, b.rect.bottom) - Math.max(a.rect.top, b.rect.top)
+    const message = `overlap between ${a.label} and ${b.label}`
+    if (width > thresholds.overlapTolerance && height > thresholds.overlapTolerance && !reported.has(message)) {
+      warnings.push(message); reported.add(message)
+    }
+  }
+  const visualProperties = ['color', 'backgroundColor', 'backgroundImage', 'borderTopColor', 'borderRightColor', 'borderBottomColor', 'borderLeftColor', 'borderTopWidth', 'borderRightWidth', 'borderBottomWidth', 'borderLeftWidth', 'borderTopStyle', 'borderRadius', 'opacity', 'fontWeight', 'fontSize', 'outline', 'outlineOffset', 'boxShadow', 'transform']
+  for (const [hook, name] of [['progress-item', 'progress'], ['toc-item', 'ToC']]) {
+    const controls = [...root.querySelectorAll(`[data-presentation-${hook}]`)].filter(element => visibleRect(element))
+    const active = controls.find(element => element.getAttribute('data-presentation-active') === 'true')
+    const inactive = active && controls.find(element => element !== active && element.parentElement === active.parentElement && element.getAttribute('data-presentation-active') !== 'true')
+    if (!active || !inactive) continue
+    const a = getComputedStyle(active), b = getComputedStyle(inactive)
+    const sameSize = ['width', 'height'].every(property => Math.abs(parseFloat(a[property]) - parseFloat(b[property])) <= thresholds.sizeTolerance)
+    if (sameSize && visualProperties.every(property => a[property] === b[property])) warnings.push(`indistinct active ${name} [data-presentation-${hook}]`)
+  }
+  const attribution = root.querySelector('a[data-presentation-attribution][href]')
+  if (!attribution) warnings.push('attribution missing link; style [data-presentation-attribution]')
+  else {
+    const style = getComputedStyle(attribution)
+    const rect = attribution.getBoundingClientRect(), visible = visibleRect(attribution)
+    const reasons = []
+    if (!visible || visible.right - visible.left < rect.width - thresholds.overlapTolerance || visible.bottom - visible.top < rect.height - thresholds.overlapTolerance) reasons.push('clipped/invisible')
+    if (parseFloat(style.fontSize) < thresholds.minAttributionFont) reasons.push(`too small (${style.fontSize})`)
+    if (['rgb(0, 0, 238)', 'rgb(85, 26, 139)'].includes(style.color) && style.textDecorationLine.includes('underline')) reasons.push('browser-default link styling')
+    if (reasons.length) warnings.push(`attribution ${reasons.join(', ')}; style [data-presentation-attribution]`)
+  }
+  return warnings
+}
+
+try {
+  // Compile the kit's actual constants instead of duplicating its animation timings.
+  const source = await readFile('src/presentation-kit/constants.ts', 'utf8')
+  const compiled = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.ESNext } }).outputText
+  const timing = await import(`data:text/javascript;base64,${Buffer.from(compiled).toString('base64')}`)
+  const defaultSettle = Math.ceil(Math.max(timing.LAYOUT_T, timing.ENTER_DELAY + timing.ENTER_T) * 1000) + SETTLE_MARGIN_MS
+  if (!Number.isFinite(defaultSettle)) throw new Error('Invalid kit animation constants')
+  const args = process.argv.slice(2)
+  let slug, settle = defaultSettle, viewport = { width: 1440, height: 900 }, forceBuild = false
+  for (let i = 0; i < args.length; i++) {
+    const arg = args[i]
+    if (arg === '--build') forceBuild = true
+    else if (arg === '--settle') {
+      const value = args[++i]
+      if (!value || !/^\d+$/.test(value)) throw new Error('--settle requires nonnegative milliseconds')
+      settle = Number(value)
+      if (!Number.isSafeInteger(settle) || settle > 2147483647) throw new Error('Invalid --settle interval')
+    } else if (arg === '--viewport') {
+      const match = /^(\d+)x(\d+)$/.exec(args[++i] ?? '')
+      if (!match || match.slice(1).some(value => Number(value) < 1 || Number(value) > 16384)) throw new Error('--viewport requires WxH (1–16384 pixels)')
+      viewport = { width: Number(match[1]), height: Number(match[2]) }
+    } else if (!slug && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(arg)) slug = arg
+    else throw new Error(`Unknown argument: ${arg}`)
+  }
+  if (!slug) throw new Error('Usage: npm run inspect -- <slug> [--settle ms] [--viewport WxH] [--build]')
+  let distExists = true
+  try { await access('dist/index.html') } catch { distExists = false }
+  if (forceBuild || !distExists) {
+    build = spawn(process.platform === 'win32' ? 'npm.cmd' : 'npm', ['run', 'build'], { stdio: 'inherit', env: { ...process.env, NODE_ENV: 'production' } })
+    const [code] = await once(build, 'exit')
+    if (code !== 0) throw new Error(`npm run build exited ${code}`)
+  }
+  const port = await availablePort()
+  const origin = `http://127.0.0.1:${port}`
+  preview = spawnPreview(port)
+  await waitForPreview(preview, origin)
+  console.log(`Inspect ${origin}/${slug} viewport=${viewport.width}x${viewport.height} settle=${settle}ms`)
+  browser = await chromium.launch({ headless: true })
+  const page = await browser.newPage({ viewport })
+  page.setDefaultTimeout(5000)
+  const errors = []
+  page.on('console', message => { if (message.type() === 'error') errors.push(message.text()) })
+  page.on('pageerror', error => errors.push(error.message))
+  page.on('crash', () => errors.push('Browser page crashed'))
+  const checkErrors = () => { if (errors.length) throw new Error(errors.join('\n')) }
+  // Confirm the slug is publicly registered, rather than inspecting a fallback route.
+  await page.goto(origin)
+  const registered = await page.locator('[data-presentation-link]').evaluateAll(links => links.map(link => new URL(link.getAttribute('href'), location.href).pathname))
+  if (!registered.includes(`/${slug}`)) throw new Error(`Unreachable registered route: ${slug}`)
+  await page.goto(`${origin}/${slug}`)
+  const chrome = page.locator('[data-step-count][data-step-index]')
+  await chrome.waitFor()
+  if (await chrome.getAttribute('data-presentation-mode') === 'present') await page.keyboard.press('p')
+  const countValue = await chrome.getAttribute('data-step-count')
+  const count = Number(countValue)
+  if (!countValue || !Number.isSafeInteger(count) || count < 1) throw new Error(`Invalid step-count hook: ${countValue}`)
+  const directory = join('.inspection', slug)
+  await mkdir(directory, { recursive: true })
+  // Remove stale step images after a deck shrinks, keeping unrelated artifacts intact.
+  for (const file of await readdir(directory)) if (/^step-\d+\.png$/.test(file)) await rm(join(directory, file))
+  for (step = 1; step <= count; step++) {
+    if (step > 1) await page.keyboard.press('ArrowRight')
+    await page.waitForFunction(expected => document.querySelector('[data-step-count][data-step-index]')?.getAttribute('data-step-index') === String(expected), step - 1)
+    await page.waitForTimeout(settle)
+    await page.evaluate(() => document.fonts.ready)
+    checkErrors()
+    if (await chrome.getAttribute('data-step-index') !== String(step - 1)) throw new Error('Step-index changed while settling')
+    for (const warning of await page.evaluate(diagnose, DIAGNOSTICS)) console.log(`WARN step ${step}: ${warning}`)
+    const file = join(directory, `step-${String(step).padStart(2, '0')}.png`)
+    await page.screenshot({ path: file, animations: 'allow' })
+    checkErrors()
+    console.log(`Captured step ${step}: ${file}`)
+  }
+  console.log(`PASS captured ${count} settled steps; visual warnings are advisory`)
+} catch (error) {
+  console.error(`FAIL step ${step}: ${error.message}`)
+  process.exitCode = 1
+} finally { await cleanup() }
diff --git a/scripts/sync-templates.mjs b/scripts/sync-templates.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e1a067fbbdfb50c093763d509e56f401444ec07c
--- /dev/null
+++ b/scripts/sync-templates.mjs
@@ -0,0 +1,61 @@
+import { cp, mkdir, mkdtemp, rename, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+// Resolve relative to this script so the command also works from another cwd.
+const root = new URL('../', import.meta.url)
+const snapshot = fileURLToPath(new URL('skills/presentation/templates/bootstrap/', root))
+let staging
+let retainBackups = false
+
+try {
+  await mkdir(snapshot, { recursive: true })
+  staging = await mkdtemp(join(snapshot, '.sync-templates-'))
+  const entries = [
+    { destination: join(snapshot, 'src/presentation-kit'), next: join(staging, 'next-kit'), backup: join(staging, 'old-kit'), backedUp: false, installed: false },
+    { destination: join(snapshot, 'scripts'), next: join(staging, 'next-scripts'), backup: join(staging, 'old-scripts'), backedUp: false, installed: false },
+  ]
+  // Finish every source copy before touching either committed snapshot.
+  await cp(new URL('src/presentation-kit/', root), entries[0].next, { recursive: true })
+  await mkdir(entries[1].next)
+  for (const name of ['verify.mjs', 'inspect-presentation.mjs', 'browser-preview.mjs']) {
+    await cp(new URL(`scripts/${name}`, root), join(entries[1].next, name))
+  }
+  await mkdir(join(snapshot, 'src'), { recursive: true })
+  try {
+    for (const entry of entries) {
+      try {
+        await rename(entry.destination, entry.backup)
+        entry.backedUp = true
+      } catch (error) {
+        if (error.code !== 'ENOENT') throw error
+      }
+      await rename(entry.next, entry.destination)
+      entry.installed = true
+    }
+  } catch (error) {
+    for (const entry of [...entries].reverse()) {
+      try {
+        if (entry.installed) await rm(entry.destination, { recursive: true, force: true })
+        if (entry.backedUp) await rename(entry.backup, entry.destination)
+      } catch (restoreError) {
+        retainBackups = true
+        console.error(`Could not restore ${entry.destination}: ${restoreError.message}`)
+      }
+    }
+    throw error
+  }
+  console.log('Synced canonical scene kit and browser drivers to bootstrap templates')
+} catch (error) {
+  console.error(`FAIL template synchronization: ${error.message}`)
+  console.error(retainBackups ? `Recovery backups retained in ${staging}` : 'Previous snapshots preserved')
+  process.exitCode = 1
+} finally {
+  if (staging && !retainBackups) {
+    try { await rm(staging, { recursive: true, force: true }) }
+    catch (error) {
+      console.error(`Could not clean staging directory ${staging}: ${error.message}`)
+      process.exitCode = 1
+    }
+  }
+}
diff --git a/scripts/verify.mjs b/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c3673247fec540ac5ddff430be640b04bab47b55
--- /dev/null
+++ b/scripts/verify.mjs
@@ -0,0 +1,127 @@
+import { spawn } from 'node:child_process'
+import { once } from 'node:events'
+import { readFile } from 'node:fs/promises'
+import ts from 'typescript'
+import { chromium } from 'playwright'
+import { availablePort, spawnPreview, stop, waitForPreview } from './browser-preview.mjs'
+
+// Reference requirements are project data, never baked into this distributable driver.
+let phase = 'build'
+let step
+let slug
+let preview
+let browser
+let build
+
+function fail(message) { throw new Error(message) }
+async function cleanup() {
+  try { await browser?.close() } finally { await stop(preview); await stop(build) }
+}
+for (const signal of ['SIGINT', 'SIGTERM']) process.once(signal, async () => {
+  console.error(`FAIL phase=${phase}${step === undefined ? '' : ` step=${step}`} interrupted by ${signal}`)
+  await cleanup()
+  process.exit(1)
+})
+
+function registeredSlugs(source) {
+  const file = ts.createSourceFile('index.ts', source, ts.ScriptTarget.Latest, true)
+  const slugs = []
+  for (const statement of file.statements) {
+    if (!ts.isVariableStatement(statement) || !statement.modifiers?.some(mod => mod.kind === ts.SyntaxKind.ExportKeyword)) continue
+    for (const declaration of statement.declarationList.declarations) {
+      if (declaration.name.getText(file) !== 'presentations') continue
+      let value = declaration.initializer
+      while (value && (ts.isAsExpression(value) || ts.isSatisfiesExpression(value) || ts.isParenthesizedExpression(value))) value = value.expression
+      if (!value || !ts.isArrayLiteralExpression(value)) fail('Registry must be an explicit presentations array')
+      for (const entry of value.elements) {
+        if (!ts.isObjectLiteralExpression(entry)) fail('Registry entries must be explicit objects')
+        const prop = entry.properties.find(prop => ts.isPropertyAssignment(prop) && prop.name.getText(file).replace(/['"]/g, '') === 'slug')
+        if (!prop || !ts.isStringLiteral(prop.initializer)) fail('Registry entries need literal slugs')
+        slugs.push(prop.initializer.text)
+      }
+    }
+  }
+  return slugs
+}
+
+try {
+  build = spawn(process.platform === 'win32' ? 'npm.cmd' : 'npm', ['run', 'build'], { stdio: 'inherit', env: { ...process.env, NODE_ENV: 'production' } })
+  const [code] = await once(build, 'exit')
+  if (code !== 0) fail(`npm run build exited ${code}`)
+
+  phase = 'sample'
+  const config = JSON.parse(await readFile('verify.config.json', 'utf8'))
+  if (!Array.isArray(config.referencePresentations)) fail('referencePresentations must be an array')
+  const references = config.referencePresentations
+  const registry = registeredSlugs(await readFile('src/presentations/index.ts', 'utf8'))
+  for (const reference of references) {
+    if (!reference || typeof reference.slug !== 'string' || !Array.isArray(reference.steps) || !reference.steps.length || reference.steps.some(item => !item || typeof item.title !== 'string' || typeof item.caption !== 'string')) fail('Malformed reference presentation config')
+    if (!registry.includes(reference.slug)) fail(`Reference ${reference.slug} is absent from the registry`)
+  }
+
+  phase = 'render'
+  const requested = process.env.VERIFY_PORT === undefined ? 0 : Number(process.env.VERIFY_PORT)
+  if (!Number.isInteger(requested) || requested < 0 || requested > 65535) fail('Invalid VERIFY_PORT')
+  const port = await availablePort(requested)
+  const origin = `http://127.0.0.1:${port}`
+  console.log(`Preview ${origin}`)
+  preview = spawnPreview(port)
+  await waitForPreview(preview, origin)
+  browser = await chromium.launch({ headless: true })
+  const page = await browser.newPage({ viewport: { width: 1440, height: 900 } })
+  page.setDefaultTimeout(5000)
+  const errors = []
+  page.on('console', message => { if (message.type() === 'error') errors.push(message.text()) })
+  page.on('pageerror', error => errors.push(error.message))
+  function checkErrors() {
+    if (errors.length) { phase = 'render'; fail(errors.join('\n')) }
+  }
+  await page.goto(origin)
+  await page.waitForTimeout(900)
+  checkErrors()
+  const routes = [...new Set(await page.locator('[data-presentation-link]').evaluateAll(links => links.map(link => new URL(link.getAttribute('href'), location.href).pathname.replace(/^\//, '').replace(/\/$/, ''))))]
+  phase = 'sample'
+  for (const reference of references) if (!routes.includes(reference.slug)) fail(`Reference ${reference.slug} is absent from landing links`)
+  for (const registered of registry) if (!routes.includes(registered)) fail(`Registered presentation ${registered} is absent from landing links`)
+  for (slug of routes) {
+    phase = 'render'
+    step = 0
+    const reference = references.find(item => item.slug === slug)
+    await page.goto(`${origin}/${slug}`)
+    const chrome = page.locator('[data-presentation-chrome]')
+    try { await chrome.waitFor() } catch (error) { checkErrors(); throw error }
+    if (await chrome.getAttribute('data-presentation-mode') === 'present') await page.keyboard.press('p')
+    const count = Number(await chrome.getAttribute('data-step-count'))
+    if (!Number.isSafeInteger(count) || count < 1) fail(`Invalid step count: ${count}`)
+    if (reference && count !== reference.steps.length) { phase = 'sample'; fail(`Expected ${reference.steps.length} steps, got ${count}`) }
+    for (step = 0; step < count; step++) {
+      if (step > 0) {
+        phase = 'transition'
+        await page.keyboard.press('ArrowRight')
+        try {
+          await page.waitForFunction(expected => document.querySelector('[data-presentation-chrome]')?.getAttribute('data-step-index') === String(expected), step, { timeout: 3000 })
+        } catch { checkErrors(); fail(`Step failed to advance to ${step}`) }
+      }
+      // Settle layout + delayed entry animations, and catch effect/asynchronous errors.
+      await page.waitForTimeout(900)
+      checkErrors()
+      phase = 'transition'
+      const actual = await chrome.getAttribute('data-step-index')
+      if (actual !== String(step)) fail(`Expected index ${step}, got ${actual}`)
+      if (reference) {
+        phase = 'sample'
+        for (const field of ['title', 'caption']) {
+          const actualText = await page.locator(`[data-presentation-${field}]`).textContent()
+          if (actualText !== reference.steps[step][field]) fail(`${field} mismatch: expected ${JSON.stringify(reference.steps[step][field])}, got ${JSON.stringify(actualText)}`)
+        }
+      }
+      console.log(`${slug} step ${step} OK`)
+    }
+  }
+  console.log(`PASS build, sample, render, transition (${routes.length} presentations)`)
+} catch (error) {
+  console.error(`FAIL phase=${phase}${slug ? ` route=${slug}` : ''}${step === undefined ? '' : ` step=${step}`}: ${error.message}`)
+  process.exitCode = 1
+} finally {
+  await cleanup()
+}
diff --git a/skills/presentation/SKILL.md b/skills/presentation/SKILL.md
new file mode 100644
index 0000000000000000000000000000000000000000..d99eb0522250e639661c3ef0d6edb3e350bc8c6d
--- /dev/null
+++ b/skills/presentation/SKILL.md
@@ -0,0 +1,131 @@
+---
+name: presentation
+description: Create or modify browser presentations as evolving diagrammatic scenes; gather narrative and visual requirements, bootstrap a React scene app when needed, and verify its behavior and composition.
+---
+
+# Presentation
+
+Build one scene through named states, preserving entities as the story develops.
+Use the four phases below. Templates are relative to the directory containing
+**this SKILL.md**, never the user's current working directory:
+[bootstrap](templates/bootstrap/) and [presentation](templates/presentation/).
+Read the supplied [scene-kit contract](templates/bootstrap/src/presentation-kit/README.md)
+before authoring scenes.
+
+## 1. Gather
+
+Ask one question at a time for missing topic, visual style, and each step's
+content plus visual description. Do not invent details the user can still
+provide. The user controls depth: accept an explicit choice to build with
+partial detail and iterate; there is no completeness gate. Skip questions when
+the prompt already provides these details. Optional ASCII mockups can confirm
+key or complex compositions; they are unnecessary for every step.
+
+For a modification, identify the presentation first. If unspecified or ambiguous,
+list existing presentations and ask which to modify. Then ask only about the
+requested changes, without repeating the full creation interview.
+
+## 2. Resolve target and scaffold missing infrastructure
+
+Inspect the project for three **contract anchors**, not byte equality or specific
+filenames. Cosmetic differences and extra dependencies do not require replacement:
+
+- Build: Vite + React + TypeScript with a working `npm run build`.
+- Scene kit: typed `Step`/`Scene`, active-step host and entity morphs, present/browse
+  navigation, captions/ToC chrome, and fixed-canvas fit scaling.
+- Presentation index: explicit registry mapping multiple presentations to routes.
+
+Already inside a presentation app: use it and add only missing anchors. Otherwise,
+an empty directory or standalone project targets its root. Detect monorepos via
+`workspaces` in `package.json`, `pnpm-workspace.yaml`, or a `packages/` or `apps/`
+layout; target a self-contained `presentations/` app there, preserving the root
+build and unrelated content. In a non-empty project missing the kit or index,
+state the resolved target and wait for confirmation before writing. Respect
+explicit target authorization already supplied by the user.
+
+For a fresh app copy the entire bootstrap, including dotfiles and committed
+`package-lock.json`. For partial scaffolds merge only missing anchors and their
+dependencies; preserve existing configuration and presentations. Adapt imports
+and routing to existing contracts rather than overwriting a working host.
+Ensure the complete dependency set declared in the bootstrap package:
+`react`, `react-dom`, `motion`, `lucide-react`; `vite`, `@vitejs/plugin-react`,
+`typescript`, `@types/react`, `@types/react-dom`, `@types/node`, `eslint`,
+`@eslint/js`, `typescript-eslint`, `eslint-plugin-react-hooks`,
+`eslint-plugin-react-refresh`, `globals`, and `playwright`. Never assume these
+are installed. Run `npm ci` for the intact fresh lock; use `npm install` after
+merging dependencies into an existing package. Make Chromium available with
+`npx playwright install chromium` (system dependencies may need `--with-deps`).
+Keep `dev`, `build` (`tsc -b && vite build`), `lint`, `preview`, `verify`, and
+`inspect` scripts working. The empty scaffold can verify its landing page;
+register a presentation before claiming presentation render verification.
+
+The scaffold and kit supply no visual theme or required styling framework.
+Plain CSS is the default; add Tailwind or another system only if the host
+already uses it or the user requests it.
+
+## 3. Generate or modify
+
+Copy the presentation template into `src/presentations/<slug>/`. Replace its
+neutral example with captured content; change the entity namespace and root
+CSS class to the unique slug. Each folder owns `entities.ts`, `steps/*.tsx`,
+`Talk.tsx`, and plain `style.css`. Add one explicit `{ slug, title, load }` entry
+in `src/presentations/index.ts`, using `load: () => import('./<slug>/Talk')`.
+Check that the landing link reaches `/<slug>`; keep existing presentations intact.
+For modifications edit the identified presentation in place and preserve scope.
+
+Every `Step<TPayload>` has stable `id`, `era`, one-line `title`, paragraph
+`caption`, `Scene`, and typed `payload`; numbering follows array order. Adjacent
+steps with the same `groupKey` and `Scene` persist without remounting. Assign
+stable presentation-namespaced `layoutId`s to continuing entities; morph their
+positions, size, label, or emphasis. Wrap only newcomers in `Appear` inside
+scene-owned `AnimatePresence`, so entry follows continuing motion and departures
+exit. Do not fade continuing entities as newcomers. Compose in the 880 × 380
+fixed canvas using `SceneLayer`, kit nodes, or raw Motion elements with stable
+identities; fit scaling preserves composition across viewport sizes.
+
+Presentations own palette, typography, spacing, borders, shadows, node/control
+treatments, visibly distinct active chrome, and legible attribution. Keep those
+choices in presentation-owned or host-owned CSS, scoped to the presentation's
+class. The kit owns behavior and geometry with zero visual defaults. Style via
+these stable hooks (see the kit contract for navigation and modes):
+
+- `data-step-count`, `data-step-index`, `data-presentation-chrome`,
+  `data-presentation-mode`, `data-presentation-stage`.
+- `data-presentation-title`, `data-presentation-caption`,
+  `data-presentation-marker`, `data-presentation-era`.
+- `data-presentation-progress`, `data-presentation-progress-item`,
+  `data-presentation-toc`, `data-presentation-toc-item`,
+  `data-presentation-prev`, `data-presentation-next`.
+- `data-presentation-active="true"` with `aria-current` identifies current
+  progress/ToC controls. Give them a visible local treatment.
+- `data-presentation-attribution` styles the bottom-right link;
+  `data-presentation-brand` is host opt-in; `data-presentation-link` identifies
+  registered landing links.
+- `data-presentation-allow-overlap` exempts only an intentionally overlapping,
+  readable subtree from visual diagnostics.
+
+## 4. Self-verify before completion
+
+Run `npm run build` and render at least the first step without runtime or console
+errors. Check captions, next/previous controls, and entity continuity. You may
+start with this lighter check, but finish with `npm run verify`, which builds the
+whole app and renders every registered presentation through every step.
+Use `127.0.0.1` for preview, readiness probes, and browser routes.
+
+Run the project-local `npm run inspect -- <slug> --build` helper. Review settled
+screenshots of first, last, and dense/key steps; also run
+`npm run inspect -- <slug> --viewport 390x844` when responsive-sensitive. Prefer
+`chrome-devtools-axi` when available: open the route, start with `snapshot`, then
+capture screenshots and inspect composition. Important content must fit the
+canvas, intentional overlaps must stay readable, and scenes must avoid caption,
+progress, ToC, and navigation collisions. Review every advisory warning: fix
+accidental collisions, indistinct active controls, and unpolished attribution
+with local CSS; mark only readable intentional overlaps. Rerun inspection after
+fixes. Warnings are advisory, not evidence of visual success by themselves.
+If the helper is unavailable, write any temporary Playwright helper **under the
+project root** so dependencies resolve locally. Ignore `.inspection/`, generated
+build output, and dependency directories; do not commit screenshots or add CI.
+
+Never report success while build, render, or composition checks fail. Fix and
+recheck. Report the route, changes, verification outcome, visual evidence, and
+any remaining advisory limitations accurately.
