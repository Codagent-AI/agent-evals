+}
+const steps: Step<{ label: string; count: number }>[] = [{
+  id: 'typed', era: 'type safety', title: 'Typed', caption: 'Payload remains typed',
+  Scene: TypedScene, groupKey: 'typed', payload: { label: 'value', count: 1 },
+}]
