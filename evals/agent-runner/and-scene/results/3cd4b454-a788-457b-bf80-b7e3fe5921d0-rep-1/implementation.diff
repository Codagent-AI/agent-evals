+import type { Step } from '../../../presentation-kit/types'
+import { Scene } from './Scene'
+import type { Beat } from './Scene'
+
+export const STEPS: readonly Step<Beat>[] = [
+  { id: 'beat-1', era: "the ask", title: "You have a topic",
+    caption: "It starts with you, a topic, and mild overconfidence.", groupKey: 'conversation', Scene, payload: { beat: 1 } },
+  { id: 'beat-2', era: "the ask", title: "The skill interviews you",
+    caption: "One question at a time: the topic, the look, then each beat of the story.", groupKey: 'conversation', Scene, payload: { beat: 2 } },
+  { id: 'beat-3', era: "the gathering", title: "Answers become steps",
+    caption: "Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next.", groupKey: 'conversation', Scene, payload: { beat: 3 } },
+  { id: 'beat-4', era: "the gathering", title: "The deck grows",
+    caption: "Same shapes, new beats. Every answer extends the story without redrawing it.", groupKey: 'conversation', Scene, payload: { beat: 4 } },
+  { id: 'beat-5', era: "the gathering", title: "You set the depth",
+    caption: "Spell out every step, or sketch a few and see how it looks. You hold the gate.", groupKey: 'conversation', Scene, payload: { beat: 5 } },
+  { id: 'beat-6', era: "the build", title: "It assembles the scene",
+    caption: "Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph.", groupKey: 'conversation', Scene, payload: { beat: 6 } },
+  { id: 'beat-7', era: "the build", title: "It checks its own work",
+    caption: "Before saying done, it builds and renders every step — and fixes what breaks.", groupKey: 'conversation', Scene, payload: { beat: 7 } },
+  { id: 'beat-8', era: "the loop", title: "Changed your mind? Loop it.",
+    caption: "Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch.", groupKey: 'conversation', Scene, payload: { beat: 8 } },
+  { id: 'beat-9', era: "the reveal", title: "You're looking at one",
+    caption: "This presentation was built exactly this way. Thanks for watching.", groupKey: 'conversation', Scene, payload: { beat: 9 } },
+]
diff --git a/src/presentations/how-to-make-a-presentation/style.css b/src/presentations/how-to-make-a-presentation/style.css
