diff --git a/src/presentation-kit/useFitScale.ts b/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a4452bf3ee08e8805cf5aad15d9b10d0498989e0
--- /dev/null
+++ b/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,26 @@
+import { useSyncExternalStore } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT, WIDE_VIEWPORT } from './constants'
+import type { PresentationMode } from './types'
+
+function subscribe(callback: () => void) {
+  window.addEventListener('resize', callback)
+  return () => window.removeEventListener('resize', callback)
+}
+function viewport() { return `${window.innerWidth},${window.innerHeight}` }
+
+export function computeFitScale(width: number, height: number, mode: PresentationMode) {
+  const layout = STAGE_LAYOUT[mode]
+  const wide = width >= WIDE_VIEWPORT
+  const left = layout.gutter + (wide ? layout.tocWidth : 0)
+  const right = layout.gutter
+  const available = Math.max(0, Math.min((width - left - right) / DESIGN_W, (height - layout.top - layout.bottom) / DESIGN_H))
+  // The minimum is a preferred floor, never permission to overflow the viewport.
+  const scale = Math.min(available, Math.max(MIN_SCALE, Math.min(1, available)))
+  return { scale, left, right, top: layout.top, bottom: layout.bottom, wide }
+}
+
+export function useFitScale(mode: PresentationMode) {
+  const dimensions = useSyncExternalStore(subscribe, viewport, () => '880,720')
+  const [width, height] = dimensions.split(',').map(Number)
+  return computeFitScale(width, height, mode)
+}
diff --git a/src/presentation-kit/usePresentationNav.ts b/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4187512f560731479686d2c751c83a43c0595b95
--- /dev/null
+++ b/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,63 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import type { TouchEvent } from 'react'
+import type { PresentationMode } from './types'
+
+// Native controls, focusable custom elements, and ARIA widgets own their keys.
+const WIDGET_ROLES = [
+  'button', 'checkbox', 'combobox', 'grid', 'gridcell', 'link', 'listbox',
+  'menu', 'menubar', 'menuitem', 'menuitemcheckbox', 'menuitemradio', 'option',
+  'progressbar', 'radio', 'radiogroup', 'scrollbar', 'searchbox', 'separator',
+  'slider', 'spinbutton', 'switch', 'tab', 'tablist', 'textbox', 'toolbar',
+  'tree', 'treegrid', 'treeitem',
+]
+const INTERACTIVE = [
+  'button', 'a[href]', 'input', 'textarea', 'select', '[tabindex]',
+  '[contenteditable]:not([contenteditable="false"])',
+  ...WIDGET_ROLES.map(role => `[role~="${role}"]`),
+].join(', ')
+
+export function usePresentationNav(count: number, initialMode: PresentationMode = 'browse') {
+  const [position, setPosition] = useState(0)
+  const [mode, setMode] = useState(initialMode)
+  const last = Math.max(0, count - 1)
+  const index = Math.min(position, last)
+  const jump = useCallback((target: number) => {
+    if (Number.isFinite(target)) setPosition(Math.max(0, Math.min(last, Math.trunc(target))))
+  }, [last])
+  const next = useCallback(() => setPosition(value => Math.min(last, value + 1)), [last])
+  const prev = useCallback(() => setPosition(value => Math.max(0, Math.min(last, value) - 1)), [last])
+  const toggleMode = useCallback(() => setMode(value => value === 'browse' ? 'present' : 'browse'), [])
+  const touch = useRef<{ x: number; y: number } | null>(null)
+
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey || event.shiftKey || event.isComposing) return
+      if (event.target instanceof Element && event.target.closest(INTERACTIVE)) return
+      if (document.activeElement?.closest(INTERACTIVE)) return
+      if (['ArrowRight', ' ', 'PageDown'].includes(event.key)) { event.preventDefault(); next() }
+      else if (['ArrowLeft', 'PageUp'].includes(event.key)) { event.preventDefault(); prev() }
+      else if (event.key.toLowerCase() === 'p') { event.preventDefault(); toggleMode() }
+    }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [next, prev, toggleMode])
+
+  const touchHandlers = {
+    onTouchStart(event: TouchEvent) {
+      const first = event.touches[0]
+      touch.current = event.touches.length === 1 && first ? { x: first.clientX, y: first.clientY } : null
+    },
+    onTouchEnd(event: TouchEvent) {
+      const start = touch.current
+      touch.current = null
+      const end = event.changedTouches[0]
+      if (!start || !end) return
+      const dx = end.clientX - start.x
+      const dy = end.clientY - start.y
+      if (Math.abs(dx) >= 48 && Math.abs(dx) > Math.abs(dy)) { if (dx < 0) next(); else prev() }
+    },
+    onTouchCancel() { touch.current = null },
+  }
+
+  return { index, mode, next, prev, jump, toggleMode, touchHandlers }
+}
