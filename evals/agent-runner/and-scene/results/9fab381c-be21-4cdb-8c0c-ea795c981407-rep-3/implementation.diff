--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/eras.ts
@@ -0,0 +1,23 @@
+import type { StepMeta } from './types'
+
+export interface Era {
+  era: string
+  /** Index of the first step of this era. */
+  firstIndex: number
+  indices: number[]
+}
+
+/** Groups steps into consecutive eras, in order of appearance. */
+export function groupEras(steps: readonly StepMeta[]): Era[] {
+  const eras: Era[] = []
+  steps.forEach((step, i) => {
+    const last = eras[eras.length - 1]
+    if (last && last.era === step.era) last.indices.push(i)
+    else eras.push({ era: step.era, firstIndex: i, indices: [i] })
+  })
+  return eras
+}
+
+export function formatStepNumber(index: number): string {
+  return String(index + 1).padStart(2, '0')
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/hostKey.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/hostKey.ts
new file mode 100644
index 0000000000000000000000000000000000000000..187a0068b6657a9d732f4c7141b88d3ecf4b467a
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/hostKey.ts
@@ -0,0 +1,17 @@
+import type { ComponentType } from 'react'
+import type { Step } from './types'
+
+const sceneIds = new WeakMap<ComponentType<never>, number>()
+let nextSceneId = 0
+
+/** Steps with the same host key share one mounted Scene; any other change swaps hosts with a cross-fade. */
+export function hostKey<TPayload>(step: Pick<Step<TPayload>, "id" | "groupKey" | "Scene">): string {
+  if (step.groupKey === undefined) return `step:${step.id}`
+  const scene = step.Scene as ComponentType<never>
+  let id = sceneIds.get(scene)
+  if (id === undefined) {
+    id = nextSceneId++
+    sceneIds.set(scene, id)
+  }
+  return `group:${step.groupKey}:${id}`
+}
