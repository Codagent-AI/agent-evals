-}
-
-.node-scene {
-  min-height: 172px;
-  border-color: rgba(199, 167, 85, 0.72);
-  background: #253222;
-}
-
-.node-talk {
-  background: #312430;
-}
-
-.connector {
-  color: #c7a755;
-}
-
-.beats {
-  display: grid;
-  grid-template-columns: repeat(3, 1fr);
-  gap: 14px;
-  margin-top: 18px;
-}
-
-.beat {
-  min-height: 148px;
-  border: 1px solid rgba(248, 243, 230, 0.14);
-  border-radius: 8px;
-  padding: 22px;
-  background: rgba(248, 243, 230, 0.045);
-}
-
-.beat-number {
-  color: #c7a755;
-  font-size: 0.75rem;
-  font-weight: 700;
-  letter-spacing: 0.12em;
-}
-
-.beat h2 {
-  margin-top: 20px;
-  color: #f8f3e6;
-  font-size: 1.2rem;
-}
-
-.beat p {
-  margin-top: 10px;
-  color: #b6aea0;
-}
-
-@media (max-width: 820px) {
-  .shell {
-    width: min(100% - 24px, 620px);
-    padding-top: 32px;
-  }
-
-  .diagram {
-    grid-template-columns: 1fr;
-    min-height: auto;
-    padding: 22px;
-  }
-
-  .connector {
-    justify-self: center;
-    transform: rotate(90deg);
-  }
-
-  .beats {
-    grid-template-columns: 1fr;
-  }
-}
