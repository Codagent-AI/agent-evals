+// @vitest-environment node
+import { execFileSync } from 'node:child_process'
+import { readdirSync, readFileSync, statSync } from 'node:fs'
+import path from 'node:path'
+import { describe, expect, it } from 'vitest'
+
+const KIT = 'src/presentation-kit'
+const BOOT = 'skills/presentation/templates/bootstrap'
+
+export function files(dir: string): string[] {
+  return readdirSync(dir).flatMap((n) => {
+    const p = path.join(dir, n)
+    return statSync(p).isDirectory() ? files(p) : [p]
+  })
+}
+const kitFiles = files(KIT)
+const GEOMETRY = new Set([
+  'position', 'left', 'right', 'top', 'bottom', 'width', 'height', 'transform', 'transformOrigin', 'display', 'flexDirection',
+  'alignItems', 'justifyContent', 'flex', 'overflow', 'boxSizing', 'pointerEvents', 'zIndex',
+])
+
+describe('style ownership boundary (L-10, L-12, I-7, L-40, I-41)', () => {
+  it('ships no CSS, CSS imports, styling-framework imports or theme tokens', () => {
+    expect(kitFiles.filter((f) => /\.(css|scss|sass|less|styl)$/.test(f))).toEqual([])
+    for (const f of kitFiles) {
+      const src = readFileSync(f, 'utf8')
+      expect(src, f).not.toMatch(/import\s+['"][^'"]*\.(css|scss)['"]|tailwind|styled-components|@emotion|var\(--|--[a-z-]+\s*:/i)
+      expect(src, f).not.toMatch(/#[0-9a-fA-F]{3,8}\b|\b(rgba?|hsla?)\(/)
+      expect(src, f).not.toMatch(/createElement\(\s*['"]style['"]|<style|insertRule|adoptedStyleSheets/)
+    }
+  })
+  it('uses inline styles only for geometry and layout behavior', () => {
+    for (const f of kitFiles.filter((f) => f.endsWith('.tsx') || f.endsWith('.ts'))) {
+      const src = readFileSync(f, 'utf8')
+      const blocks = [...src.matchAll(/style=\{\{([\s\S]*?)\}\}|return\s*\{\s*(position:[^}]*)\}|style:\s*\{([^}]*)\}/g)]
+      for (const m of blocks) {
+        const body = m[1] ?? m[2] ?? m[3] ?? ''
+        const names = [...body.matchAll(/(?:^|[,{\s])([a-zA-Z]+)\s*:/g)].map((x) => x[1]!)
+        for (const n of names) expect(GEOMETRY.has(n), `${f}: style property ${n}`).toBe(true)
+      }
+    }
+  })
+  it('keeps the dependency graph free of a styling framework and avoids visual attributes', () => {
+    const imports = kitFiles.flatMap((f) => [...readFileSync(f, 'utf8').matchAll(/from\s+'([^']+)'/g)].map((m) => m[1]!))
+    const external = new Set(imports.filter((i) => !i.startsWith('.')))
+    expect([...external].sort()).toEqual(['lucide-react', 'motion/react', 'react'])
+    for (const pkgPath of ['package.json', `${BOOT}/package.json`]) {
+      const pkg = JSON.parse(readFileSync(pkgPath, 'utf8'))
+      const all = Object.keys({ ...pkg.dependencies, ...pkg.devDependencies })
+      expect(all.filter((d) => /tailwind|styled|emotion|bootstrap$|chakra|mui/i.test(d))).toEqual([])
+    }
+    for (const cfg of ['vite.config.ts', `${BOOT}/vite.config.ts`]) expect(readFileSync(cfg, 'utf8')).not.toMatch(/tailwind/i)
+  })
+})
+
+describe('scaffold ships no visual defaults (L-40, I-41)', () => {
+  const VISUAL = /(^|[;{\s])(color|background(-color)?|font(-[a-z]+)?|border(-[a-z]+)*|box-shadow|text-shadow|padding(-[a-z]+)*|gap|--[a-z-]+)\s*:/m
+  it('has only reset-level CSS in the bootstrap template, including its starter presentation', () => {
+    const css = files(BOOT).filter((f) => f.endsWith('.css') && !f.includes('node_modules'))
+    expect(css.map((f) => path.relative(BOOT, f)).sort()).toEqual(['src/index.css', 'src/presentations/starter/presentation.css'])
+    for (const f of css) expect(readFileSync(f, 'utf8').replace(/\/\*[\s\S]*?\*\//g, ''), f).not.toMatch(VISUAL)
+  })
+  it('has no CSS in the presentation template beyond guidance comments', () => {
+    const f = 'skills/presentation/templates/presentation/presentation.css'
+    expect(readFileSync(f, 'utf8').replace(/\/\*[\s\S]*?\*\//g, '').trim()).toBe('')
+  })
+})
+
+describe('template parity (L-67, I-42)', () => {
+  const isTest = (f: string) => /\.test\.|__tests__/.test(f)
+  const rel = (list: string[], base: string) => list.map((f) => path.relative(base, f)).sort()
+  it('keeps the non-test kit file set and bytes identical to the bootstrap copy', () => {
+    const canonical = files(KIT).filter((f) => !isTest(f))
+    const copy = files(`${BOOT}/${KIT}`).filter((f) => !isTest(f))
+    expect(rel(copy, `${BOOT}/${KIT}`)).toEqual(rel(canonical, KIT))
+    for (const f of canonical) expect(readFileSync(path.join(BOOT, f), 'utf8'), f).toBe(readFileSync(f, 'utf8'))
+  })
+  it('keeps verify, inspect and their library identical to the bootstrap copy', () => {
+    const scripts = files('scripts').filter((f) => f !== path.join('scripts', 'sync-template.mjs'))
+    expect(rel(files(`${BOOT}/scripts`), `${BOOT}/scripts`)).toEqual(rel(scripts, 'scripts'))
+    for (const f of scripts) expect(readFileSync(path.join(BOOT, f), 'utf8'), f).toBe(readFileSync(f, 'utf8'))
+  })
+})
+
+describe('repository contract (L-68, I-23, I-49, C-3)', () => {
+  const pkg = JSON.parse(readFileSync('package.json', 'utf8'))
+  const tracked = execFileSync('git', ['ls-files'], { encoding: 'utf8' }).split('\n').filter(Boolean)
+  it('declares the required npm gates, with fast unit tests kept separate from browser-backed suites', () => {
+    for (const s of ['test', 'lint', 'build', 'verify', 'inspect', 'test:integration', 'test:e2e']) expect(pkg.scripts[s], s).toBeTruthy()
+    expect(pkg.scripts.test).toBe('vitest run')
+    expect(pkg.scripts.build).toBe('tsc -b && vite build')
+    expect(pkg.scripts['test:integration']).toMatch(/tests\/integration/)
+    expect(pkg.scripts['test:e2e']).toMatch(/tests\/e2e/)
+    const unit = readFileSync('vitest.config.ts', 'utf8')
+    expect(unit).toMatch(/tests\/unit\/\*\*/)
+    expect(unit).not.toMatch(/tests\/(integration|e2e)/)
+  })
+  it('commits no dependencies, build output, screenshots or CI configuration', () => {
+    expect(tracked.filter((f) => /(^|\/)node_modules\//.test(f))).toEqual([])
+    expect(tracked.filter((f) => /^(dist|inspection)\//.test(f) || /\.png$/.test(f) && !f.startsWith('public/'))).toEqual([])
+    expect(tracked.filter((f) => f.startsWith('.github/') || /\.gitlab-ci|circleci|azure-pipelines/.test(f))).toEqual([])
+    const ignore = readFileSync('.gitignore', 'utf8')
+    expect(ignore).toMatch(/^inspection$/m)
+    expect(ignore).toMatch(/^dist$/m)
+    expect(ignore).toMatch(/^node_modules$/m)
+  })
+  it('keeps React StrictMode in the root and bootstrap entry points', () => {
+    for (const f of ['src/main.tsx', `${BOOT}/src/main.tsx`]) expect(readFileSync(f, 'utf8')).toMatch(/<StrictMode>[\s\S]*<\/StrictMode>/)
+  })
+  it('keeps the removed placeholder app out of the tree', () => {
+    expect(tracked).not.toContain('src/App.tsx')
+  })
+})
diff --git a/tests/unit/nav.test.tsx b/tests/unit/nav.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b5da3e607e482574d620ffa61bfbeb71497077bb
--- /dev/null
+++ b/tests/unit/nav.test.tsx
@@ -0,0 +1,203 @@
+import { act, render, renderHook } from '@testing-library/react'
+import { StrictMode } from 'react'
+import { describe, expect, it, vi } from 'vitest'
+import { Presentation } from '../../src/presentation-kit'
+import { SWIPE_THRESHOLD } from '../../src/presentation-kit/constants'
+import { classifySwipe, clampIndex, usePresentationNav } from '../../src/presentation-kit/usePresentationNav'
+import { key, makeSteps, setViewport, stepIndex, swipe } from './helpers'
+
+const setup = (count = 5, mode: 'browse' | 'present' = 'browse') => renderHook(() => usePresentationNav(count, mode))
+const step = (r: ReturnType<typeof setup>, k: string, n = 1) => {
+  for (let i = 0; i < n; i++) key(k)
+  return r.result.current.index
+}
+
+describe('keyboard navigation (L-21, I-12)', () => {
+  it.each([['ArrowRight'], [' '], ['PageDown']])('%j advances exactly one step', (k) => {
+    const r = setup()
+    step(r, 'ArrowRight', 2)
+    expect(step(r, k)).toBe(3)
+  })
+  it.each([['ArrowLeft'], ['PageUp']])('%s goes back exactly one step', (k) => {
+    const r = setup()
+    step(r, 'ArrowRight', 3)
+    expect(step(r, k)).toBe(2)
+  })
+  it('prevents browser scrolling for handled keys and ignores others', () => {
+    setup()
+    const e = new KeyboardEvent('keydown', { key: ' ', cancelable: true, bubbles: true })
+    act(() => void window.dispatchEvent(e))
+    expect(e.defaultPrevented).toBe(true)
+    const other = new KeyboardEvent('keydown', { key: 'x', cancelable: true })
+    act(() => void window.dispatchEvent(other))
+    expect(other.defaultPrevented).toBe(false)
+  })
+  it('ignores modified shortcuts', () => {
+    const r = setup()
+    key('ArrowRight', window, { ctrlKey: true })
+    expect(r.result.current.index).toBe(0)
+  })
+})
+
+describe('boundaries (L-26, L-27, I-17)', () => {
+  it('clamps at the start for prev, Left, PageUp and right swipe', () => {
+    const r = setup()
+    act(() => r.result.current.prev())
+    key('ArrowLeft')
+    key('PageUp')
+    swipe(120)
+    expect(r.result.current.index).toBe(0)
+  })
+  it('clamps at the end for next, Right, Space, PageDown and left swipe', () => {
+    const r = setup(3)
+    step(r, 'ArrowRight', 5)
+    expect(r.result.current.index).toBe(2)
+    act(() => r.result.current.next())
+    key(' ')
+    key('PageDown')
+    swipe(-120)
+    expect(r.result.current.index).toBe(2)
+  })
+  it('handles a one-step deck at both ends', () => {
+    const r = setup(1)
+    key('ArrowRight')
+    key('ArrowLeft')
+    swipe(-100)
+    swipe(100)
+    expect(r.result.current.index).toBe(0)
+    expect(clampIndex(5, 0)).toBe(0)
+  })
+  it('never wraps when jumping out of range', () => {
+    const r = setup(3)
+    act(() => r.result.current.goTo(99))
+    expect(r.result.current.index).toBe(2)
+    act(() => r.result.current.goTo(-4))
+    expect(r.result.current.index).toBe(0)
+  })
+})
+
+describe('touch swipe (L-22, I-13)', () => {
+  it('left swipe advances and right swipe goes back by one', () => {
+    const r = setup()
+    swipe(-100)
+    expect(r.result.current.index).toBe(1)
+    swipe(100)
+    expect(r.result.current.index).toBe(0)
+  })
+  it('ignores short, vertical-dominant and cancelled gestures', () => {
+    const r = setup()
+    swipe(-(SWIPE_THRESHOLD - 5))
+    swipe(-100, 200)
+    expect(r.result.current.index).toBe(0)
+    const start = new Event('touchstart')
+    Object.assign(start, { touches: [{ clientX: 300, clientY: 300 }] })
+    act(() => void window.dispatchEvent(start))
+    act(() => void window.dispatchEvent(new Event('touchcancel')))
+    const end = new Event('touchend')
+    Object.assign(end, { changedTouches: [{ clientX: 100, clientY: 300 }] })
+    act(() => void window.dispatchEvent(end))
+    expect(r.result.current.index).toBe(0)
+  })
+  it('classifies by threshold and horizontal dominance', () => {
+    expect(classifySwipe(-SWIPE_THRESHOLD, 0)).toBe('next')
+    expect(classifySwipe(SWIPE_THRESHOLD, 0)).toBe('prev')
+    expect(classifySwipe(-SWIPE_THRESHOLD, SWIPE_THRESHOLD)).toBeNull()
+  })
+})
+
+describe('focused controls keep their keys (L-25, I-16)', () => {
+  const cases: [string, () => HTMLElement][] = [
+    ['button', () => document.createElement('button')],
+    ['input', () => document.createElement('input')],
+    ['select', () => document.createElement('select')],
+    ['textarea', () => document.createElement('textarea')],
+    ['link', () => Object.assign(document.createElement('a'), { href: '#x' })],
+    ['editable', () => {
+      const div = document.createElement('div')
+      div.setAttribute('contenteditable', 'true')
+      return div
+    }],
+    ['nested in button', () => document.createElement('button')],
+  ]
+  it.each(cases)('does not move the deck from a %s', (name, make) => {
+    const r = setup()
+    const el = make()
+    if (name === 'nested in button') el.appendChild(document.createElement('span'))
+    document.body.appendChild(el)
+    const target = name === 'nested in button' ? (el.firstChild as Element) : el
+    const e = new KeyboardEvent('keydown', { key: 'ArrowRight', bubbles: true, cancelable: true })
+    act(() => void target.dispatchEvent(e))
+    expect(r.result.current.index).toBe(0)
+    expect(e.defaultPrevented).toBe(false)
+    el.remove()
+  })
+  it('still navigates from non-interactive targets', () => {
+    const r = setup()
+    const div = document.body.appendChild(document.createElement('div'))
+    key('ArrowRight', div)
+    expect(r.result.current.index).toBe(1)
+    div.remove()
+  })
+})
+
+describe('mode switching (L-19, I-11)', () => {
+  it.each([['browse', 'present'], ['present', 'browse']] as const)('starts in %s and P toggles to %s', (from, to) => {
+    const r = setup(3, from)
+    expect(r.result.current.mode).toBe(from)
+    key('p')
+    expect(r.result.current.mode).toBe(to)
+    key('P')
+    expect(r.result.current.mode).toBe(from)
+  })
+  it('keeps the active step when toggling', () => {
+    const r = setup()
+    step(r, 'ArrowRight', 2)
+    key('p')
+    expect(r.result.current.index).toBe(2)
+  })
+})
+
+describe('StrictMode and listener cleanup (C-3)', () => {
+  it('moves one step per event under StrictMode', () => {
+    setViewport(1024)
+    const { container } = render(<StrictMode><Presentation steps={makeSteps()} title="t" /></StrictMode>)
+    key('ArrowRight')
+    expect(stepIndex(container)).toBe(1)
+  })
+  it('removes every window listener the full presentation adds, resize included, under StrictMode', () => {
+    setViewport(1200)
+    const added: [string, unknown][] = []
+    const removed: [string, unknown][] = []
+    const realAdd = window.addEventListener.bind(window)
+    const realRemove = window.removeEventListener.bind(window)
+    const add = vi.spyOn(window, 'addEventListener').mockImplementation((type: string, fn: EventListenerOrEventListenerObject, opts?: boolean | AddEventListenerOptions) => {
+      added.push([type, fn])
+      realAdd(type, fn, opts)
+    })
+    const remove = vi.spyOn(window, 'removeEventListener').mockImplementation((type: string, fn: EventListenerOrEventListenerObject, opts?: boolean | EventListenerOptions) => {
+      removed.push([type, fn])
+      realRemove(type, fn, opts)
+    })
+    const { unmount, container } = render(<StrictMode><Presentation steps={makeSteps()} title="t" /></StrictMode>)
+    expect(added.map(([t]) => t)).toEqual(expect.arrayContaining(['resize', 'keydown', 'touchstart', 'touchend', 'touchcancel']))
+    key('ArrowRight')
+    expect(stepIndex(container)).toBe(1)
+    unmount()
+    // Every registration is paired with a removal of the same function: nothing leaks, nothing double-fires.
+    for (const [type, fn] of added) expect(removed.some(([t, f]) => t === type && f === fn), type).toBe(true)
+    key('ArrowRight')
+    expect(stepIndex(container)).toBeNaN()
+    add.mockRestore()
+    remove.mockRestore()
+  })
+  it('removes every listener on unmount', () => {
+    const add = vi.spyOn(window, 'addEventListener')
+    const remove = vi.spyOn(window, 'removeEventListener')
+    const { unmount } = renderHook(() => usePresentationNav(3))
+    const added = add.mock.calls.filter(([t]) => ['keydown', 'touchstart', 'touchend', 'touchcancel'].includes(String(t)))
+    unmount()
+    for (const [type, fn] of added) expect(remove.mock.calls.some(([t, f]) => t === type && f === fn)).toBe(true)
+    add.mockRestore()
+    remove.mockRestore()
+  })
+})
