+  prompt: 'hmp/prompt',
+  skill: 'hmp/skill',
+  conversation: 'hmp/conversation',
+  question: 'hmp/question',
+  tray: 'hmp/tray',
+  ghost: 'hmp/ghost',
+  socket: 'hmp/socket',
