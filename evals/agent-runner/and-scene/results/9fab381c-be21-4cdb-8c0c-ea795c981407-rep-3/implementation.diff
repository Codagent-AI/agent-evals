diff --git a/src/Landing.tsx b/src/Landing.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a8697cd0f3acf33ab445d10ea45b897e281fa972
--- /dev/null
+++ b/src/Landing.tsx
@@ -0,0 +1,16 @@
+import type { PresentationEntry } from './presentations/types'
+
+export function Landing({ registry }: { registry: readonly PresentationEntry[] }) {
+  return (
+    <main className="landing">
+      <h1>and-scene</h1>
+      <ul>
+        {registry.map((entry) => (
+          <li key={entry.slug}>
+            <a href={`/${entry.slug}`}>{entry.title}</a>
+          </li>
+        ))}
+      </ul>
+    </main>
+  )
+}
diff --git a/src/Router.tsx b/src/Router.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..db2828a34725d77bf43f5c656c4ed9bc2e6122ec
--- /dev/null
+++ b/src/Router.tsx
@@ -0,0 +1,10 @@
+import { createElement, Suspense } from 'react'
+import { Landing } from './Landing'
+import type { PresentationEntry } from './presentations/types'
+import { componentFor, resolveRoute } from './routes'
+
+export function Router({ pathname, registry }: { pathname: string; registry: readonly PresentationEntry[] }) {
+  const entry = resolveRoute(pathname, registry)
+  if (!entry) return <Landing registry={registry} />
+  return <Suspense fallback={null}>{createElement(componentFor(entry))}</Suspense>
+}
