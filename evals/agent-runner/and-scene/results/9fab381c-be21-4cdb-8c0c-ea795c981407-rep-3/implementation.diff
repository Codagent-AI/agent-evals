new file mode 100644
index 0000000000000000000000000000000000000000..c3372ccdc20ec8a39f1f0cc063f2604f50a7aaeb
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,59 @@
+import type { CSSProperties, ReactNode } from 'react'
+import { Attribution, type AttributionProps } from './chrome/Attribution'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { Toc } from './chrome/Toc'
+import type { Mode } from './constants'
+import { Stage } from './Stage'
+import type { Step } from './types'
+import type { Canvas } from './useFitScale'
+import { showsToc } from './useFitScale'
+import { usePresentationNav } from './usePresentationNav'
+import { useViewportSize } from './useViewportSize'
+
+export interface PresentationProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  title: string
+  initialMode?: Mode
+  canvas?: Canvas
+  /** Host branding for the top-left slot; absent by default. */
+  brand?: ReactNode
+  /** Override the default bottom-right attribution, or pass false to omit it. */
+  attribution?: false | AttributionProps
+  className?: string
+  style?: CSSProperties
+}
+
+export function Presentation<TPayload>({
+  steps,
+  title,
+  initialMode = 'browse',
+  canvas,
+  brand,
+  attribution,
+  className,
+  style,
+}: PresentationProps<TPayload>) {
+  const { index, mode, goTo, next, prev } = usePresentationNav(steps.length, initialMode)
+  const { width } = useViewportSize()
+  const step = steps[index]
+  if (!step) return null
+  return (
+    <div
+      data-presentation-root=""
+      data-presentation-mode={mode}
+      data-presentation-step-id={step.id}
+      data-step-count={steps.length}
+      data-step-index={index}
+      aria-label={title}
+      className={className}
+      style={{ position: 'fixed', left: 0, top: 0, right: 0, bottom: 0, overflow: 'hidden', ...style }}
+    >
+      <Header step={step} index={index} mode={mode} brand={brand} />
+      {showsToc(mode, width) && <Toc steps={steps} index={index} onGoTo={goTo} />}
+      <Stage steps={steps} index={index} mode={mode} canvas={canvas} />
+      <Footer steps={steps} index={index} mode={mode} onGoTo={goTo} onPrev={prev} onNext={next} />
+      {attribution !== false && <Attribution {...attribution} />}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c5150d479376c56d91f5df58f6b49a8b82b9405b
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,73 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { EASE, ENTER_T, type Mode } from './constants'
+import { hostKey } from './hostKey'
+import type { Step } from './types'
+import { availableSpace, computeFitScale, DEFAULT_CANVAS, type Canvas } from './useFitScale'
+import { useViewportSize } from './useViewportSize'
+
+export interface StageProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  index: number
+  mode: Mode
+  canvas?: Canvas
+}
+
+export function Stage<TPayload>({ steps, index, mode, canvas = DEFAULT_CANVAS }: StageProps<TPayload>) {
+  const { width, height } = useViewportSize()
+  const avail = availableSpace(width, height, mode)
+  const scale = computeFitScale(width, height, mode, canvas)
+  const step = steps[index]
+  if (!step) return null
+  const { Scene } = step
+  return (
+    <div
+      data-presentation-stage=""
+      data-presentation-scale={scale.toFixed(4)}
+      style={{
+        position: 'absolute',
+        left: avail.left,
+        top: avail.top,
+        width: Math.max(avail.width, 0),
+        height: Math.max(avail.height, 0),
+        display: 'flex',
+        alignItems: 'center',
+        justifyContent: 'center',
+        overflow: 'hidden',
+      }}
+    >
+      <div
+        data-presentation-canvas=""
+        style={{ position: 'relative', flex: 'none', width: canvas.width * scale, height: canvas.height * scale }}
+      >
+        <div
+          data-presentation-canvas-inner=""
+          style={{
+            position: 'absolute',
+            left: 0,
+            top: 0,
+            width: canvas.width,
+            height: canvas.height,
+            transform: `scale(${scale})`,
+            transformOrigin: '0 0',
+          }}
+        >
+          <LayoutGroup>
+            <AnimatePresence initial={false}>
+              <motion.div
+                key={hostKey(step)}
+                data-presentation-scene-host=""
+                initial={{ opacity: 0 }}
+                animate={{ opacity: 1 }}
+                exit={{ opacity: 0 }}
+                transition={{ duration: ENTER_T, ease: EASE }}
+                style={{ position: 'absolute', left: 0, top: 0, width: '100%', height: '100%' }}
+              >
+                <Scene payload={step.payload} stepId={step.id} stepIndex={index} />
+              </motion.div>
+            </AnimatePresence>
+          </LayoutGroup>
+        </div>
+      </div>
+    </div>
+  )
+}
