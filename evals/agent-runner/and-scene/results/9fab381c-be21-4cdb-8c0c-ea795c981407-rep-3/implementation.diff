+import { motion, type HTMLMotionProps } from 'motion/react'
+import { EASE, ENTER_DELAY, ENTER_T } from '../constants'
+import { placeStyle, type Rect } from './geometry'
+
+export interface AppearProps extends Omit<HTMLMotionProps<'div'>, 'id'> {
+  at?: Rect
+  /** Seconds to wait before entering; defaults to ENTER_DELAY so persisting entities settle first. */
+  delay?: number
+}
+
+/**
+ * Wraps newcomers only. Place it inside `AnimatePresence` so departures fade out too.
+ * It fills the canvas by default so children keep their canvas coordinates.
+ */
+export function Appear({ at, delay = ENTER_DELAY, style, ...rest }: AppearProps) {
+  return (
+    <motion.div
+      initial={{ opacity: 0 }}
+      animate={{ opacity: 1, transition: { duration: ENTER_T, delay, ease: EASE } }}
+      exit={{ opacity: 0, transition: { duration: ENTER_T, ease: EASE } }}
+      data-presentation-appear=""
+      {...rest}
+      style={at ? placeStyle(at, style) : { position: 'absolute', left: 0, top: 0, width: '100%', height: '100%', pointerEvents: 'none', ...style }}
+    />
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/nodes/Arrow.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/nodes/Arrow.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..7da8669a55e4a5f04d8dc0472f4764ab59b577d5
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/nodes/Arrow.tsx
@@ -0,0 +1,54 @@
+import { motion, type HTMLMotionProps } from 'motion/react'
+import { entityProps } from './geometry'
+
+export interface ArrowProps extends Omit<HTMLMotionProps<'div'>, 'id' | 'layoutId'> {
+  entity: string
+  from: readonly [number, number]
+  to: readonly [number, number]
+  /** Arrowheads at both ends. */
+  bidirectional?: boolean
+  /** Perpendicular bow of the path in canvas px; 0 draws a straight line. */
+  curve?: number
+}
+
+const PAD = 8
+const HEAD = 7
+
+function head(x: number, y: number, angle: number): string {
+  const a = (d: number) => [x - HEAD * Math.cos(angle + d), y - HEAD * Math.sin(angle + d)]
+  const [x1, y1] = a(0.45)
+  const [x2, y2] = a(-0.45)
+  return `M${x1},${y1} L${x} ${y} L${x2},${y2}`
+}
+
+/** A line or arc between two canvas points. Stroke and colour come from the presentation via currentColor/CSS. */
+export function Arrow({ entity, from, to, bidirectional, curve = 0, style, ...rest }: ArrowProps) {
+  const left = Math.min(from[0], to[0]) - PAD - Math.abs(curve)
+  const top = Math.min(from[1], to[1]) - PAD - Math.abs(curve)
+  const right = Math.max(from[0], to[0]) + PAD + Math.abs(curve)
+  const bottom = Math.max(from[1], to[1]) + PAD + Math.abs(curve)
+  const w = right - left
+  const h = bottom - top
+  const [x1, y1, x2, y2] = [from[0] - left, from[1] - top, to[0] - left, to[1] - top]
+  const mx = (x1 + x2) / 2
+  const my = (y1 + y2) / 2
+  const len = Math.hypot(x2 - x1, y2 - y1) || 1
+  const cx = mx + (-(y2 - y1) / len) * curve
+  const cy = my + ((x2 - x1) / len) * curve
+  const path = `M${x1},${y1} Q${cx},${cy} ${x2},${y2}`
+  const endAngle = Math.atan2(y2 - cy, x2 - cx)
+  const startAngle = Math.atan2(y1 - cy, x1 - cx)
+  return (
+    <motion.div
+      {...entityProps(entity, 'arrow')}
+      {...rest}
+      style={{ position: 'absolute', left, top, width: w, height: h, pointerEvents: 'none', ...style }}
+    >
+      <svg width={w} height={h} viewBox={`0 0 ${w} ${h}`} style={{ overflow: 'visible', display: 'block' }} aria-hidden="true">
+        <path d={path} fill="none" stroke="currentColor" data-presentation-arrow-line="" />
+        <path d={head(x2, y2, endAngle)} fill="none" stroke="currentColor" data-presentation-arrow-head="" />
+        {bidirectional && <path d={head(x1, y1, startAngle)} fill="none" stroke="currentColor" data-presentation-arrow-head="" />}
+      </svg>
+    </motion.div>
+  )
+}
