new file mode 100644
index 0000000000000000000000000000000000000000..09adddfcfc20d2a3f245302da43854838d76523d
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,21 @@
+import { useEffect, useState } from 'react'
+import { DESIGN_H, DESIGN_W, STAGE_LAYOUT } from './constants'
+import type { Mode } from './types'
+
+export function fitGeometry(width: number, height: number, mode: Mode, designWidth = DESIGN_W, designHeight = DESIGN_H) {
+  const layout = STAGE_LAYOUT[mode]
+  const left = layout.side + (width >= 1100 ? layout.toc : 0)
+  const availableWidth = Math.max(0, width - left - layout.side)
+  const availableHeight = Math.max(0, height - layout.top - layout.bottom)
+  const scale = Math.min(availableWidth / designWidth, availableHeight / designHeight, 1)
+  return { scale, left, top: layout.top, width: availableWidth, height: availableHeight }
+}
+export function useFitScale(mode: Mode, width = DESIGN_W, height = DESIGN_H) {
+  const [viewport, setViewport] = useState(() => ({ width: window.innerWidth, height: window.innerHeight }))
+  useEffect(() => {
+    const resize = () => setViewport({ width: window.innerWidth, height: window.innerHeight })
+    window.addEventListener('resize', resize)
+    return () => window.removeEventListener('resize', resize)
+  }, [])
+  return fitGeometry(viewport.width, viewport.height, mode, width, height)
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c9c3400724c9598b5c106dc6a577d1b32428846b
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,45 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import type { TouchEvent } from 'react'
+import type { Mode } from './types'
+
+export function clampIndex(index: number, count: number) {
+  return Math.max(0, Math.min(count - 1, Math.trunc(index) || 0))
+}
+export function isInteractive(target: EventTarget | null) {
+  return target instanceof Element && !!target.closest(
+    'button,a,input,textarea,select,[contenteditable]:not([contenteditable="false"]),[role="button"],[role="slider"],[role="textbox"],[role="combobox"],[role="menuitem"],[role="tab"],[role="spinbutton"]',
+  )
+}
+export function usePresentationNav(count: number, initialMode: Mode = 'browse') {
+  const [position, setPosition] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const index = clampIndex(position, count)
+  const jump = useCallback((n: number) => setPosition(clampIndex(n, count)), [count])
+  const next = useCallback(() => setPosition(n => clampIndex(n + 1, count)), [count])
+  const prev = useCallback(() => setPosition(n => clampIndex(n - 1, count)), [count])
+  const toggle = useCallback(() => setMode(m => m === 'browse' ? 'present' : 'browse'), [])
+  useEffect(() => {
+    function key(event: KeyboardEvent) {
+      if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || isInteractive(event.target)) return
+      if (['ArrowRight', ' ', 'PageDown'].includes(event.key)) { event.preventDefault(); next() }
+      else if (['ArrowLeft', 'PageUp'].includes(event.key)) { event.preventDefault(); prev() }
+      else if (event.key.toLowerCase() === 'p') { event.preventDefault(); toggle() }
+    }
+    window.addEventListener('keydown', key)
+    return () => window.removeEventListener('keydown', key)
+  }, [next, prev, toggle])
+  const touch = useRef<{ x: number; y: number } | null>(null)
+  const onTouchStart = (e: TouchEvent) => {
+    touch.current = e.touches.length === 1 && !isInteractive(e.target)
+      ? { x: e.touches[0].clientX, y: e.touches[0].clientY } : null
+  }
+  const onTouchEnd = (e: TouchEvent) => {
+    const start = touch.current
+    touch.current = null
+    if (!start || !e.changedTouches.length) return
+    const dx = e.changedTouches[0].clientX - start.x
+    const dy = e.changedTouches[0].clientY - start.y
+    if (Math.abs(dx) >= 40 && Math.abs(dx) > Math.abs(dy)) { if (dx < 0) next(); else prev() }
+  }
+  return { index, mode, jump, next, prev, toggle, onTouchStart, onTouchEnd, onTouchCancel: () => { touch.current = null } }
+}
