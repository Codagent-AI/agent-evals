+  expect(css).toMatch(/\[data-presentation-attribution\]\s*\{[^}]*font-size: 12px/)
+  expect(css).toMatch(/\.ghost-card\s*\{[^}]*border: 1px dashed/)
+  expect(css).toMatch(/\.tray\s*\{[^}]*border: 0/)
