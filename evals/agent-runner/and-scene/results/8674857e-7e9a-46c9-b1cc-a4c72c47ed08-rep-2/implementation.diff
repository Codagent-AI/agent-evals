diff --git a/scripts/browser-runtime.mjs b/scripts/browser-runtime.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..79e3ddab4ba249563816224977d395b14df62ea7
--- /dev/null
+++ b/scripts/browser-runtime.mjs
@@ -0,0 +1,78 @@
+import { spawn } from 'node:child_process'
+import { createServer } from 'node:net'
+import { fileURLToPath } from 'node:url'
+import { resolve, dirname } from 'node:path'
+import { chromium } from 'playwright'
+export const projectRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..')
+export async function build(root = projectRoot) {
+  console.log('PHASE build: npm run build')
+  await new Promise((accept, reject) => {
+    const process = spawn('npm', ['run', 'build'], { cwd: root, stdio: 'inherit' })
+    process.on('error', reject)
+    process.on('exit', code => code === 0 ? accept() : reject(new Error(`build: npm run build exited ${code}`)))
+  })
+}
+async function freePort() {
+  const server = createServer()
+  await new Promise((accept, reject) => { server.once('error', reject); server.listen(0, '127.0.0.1', accept) })
+  const port = server.address().port
+  await new Promise(accept => server.close(accept))
+  return port
+}
+export async function withBrowser(run, { root = projectRoot, width = 1440, height = 900 } = {}) {
+  const port = await freePort()
+  const url = `http://127.0.0.1:${port}`
+  const server = spawn(process.execPath, [resolve(root, 'node_modules/vite/bin/vite.js'), 'preview', '--host', '127.0.0.1', '--port', String(port), '--strictPort'], { cwd: root, stdio: ['ignore', 'pipe', 'pipe'] })
+  let serverOutput = ''
+  let launchError
+  server.on('error', error => { launchError = error })
+  server.stdout.on('data', chunk => { serverOutput += chunk })
+  server.stderr.on('data', chunk => { serverOutput += chunk })
+  console.log(`PREVIEW pid=${server.pid} host=127.0.0.1 probe=${url}`)
+  let browser
+  const terminate = () => { server.kill('SIGTERM'); void browser?.close() }
+  process.once('SIGTERM', terminate)
+  process.once('SIGINT', terminate)
+  try {
+    let ready = false
+    for (let i = 0; i < 100; i++) {
+      if (launchError || server.exitCode !== null) throw new Error(`preview: ${launchError ?? serverOutput}`)
+      try { ready = (await fetch(url)).ok } catch { /* server not yet listening */ }
+      if (ready) break
+      await new Promise(accept => setTimeout(accept, 50))
+    }
+    if (!ready) throw new Error(`preview readiness timeout: ${serverOutput}`)
+    browser = await chromium.launch({ headless: true })
+    const page = await browser.newPage({ viewport: { width, height } })
+    return await run(page, url)
+  } finally {
+    await browser?.close()
+    if (server.exitCode === null) {
+      const stopped = new Promise(accept => server.once('exit', accept))
+      server.kill('SIGTERM')
+      const force = setTimeout(() => server.kill('SIGKILL'), 2000)
+      await stopped
+      clearTimeout(force)
+    }
+    process.off('SIGTERM', terminate)
+    process.off('SIGINT', terminate)
+    console.log(`CLEANUP preview pid=${server.pid}`)
+  }
+}
+export function watchErrors(page) {
+  const errors = []
+  page.on('console', message => { if (message.type() === 'error') errors.push(`console.error: ${message.text()}`) })
+  page.on('pageerror', error => errors.push(`pageerror: ${error.message}`))
+  return () => { if (errors.length) throw new Error(errors.join('\n')) }
+}
+export async function readStepCount(page) {
+  await page.locator('[data-presentation][data-step-count]').waitFor({ timeout: 5000 })
+  const count = Number(await page.locator('[data-presentation]').getAttribute('data-step-count'))
+  if (!Number.isInteger(count) || count < 1) throw new Error(`invalid step count ${count}`)
+  return count
+}
+export async function settleStep(page, index, settle = 850) {
+  await page.waitForFunction(i => document.querySelector('[data-presentation]')?.getAttribute('data-step-index') === String(i), index, { timeout: 3000 })
+  await page.waitForTimeout(settle)
+}
+export function isMain(url) { return process.argv[1] && resolve(process.argv[1]) === fileURLToPath(url) }
diff --git a/scripts/diagnostics.mjs b/scripts/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4018d8236e25b0da1895aab2047d3dbf3d71e3c4
--- /dev/null
+++ b/scripts/diagnostics.mjs
@@ -0,0 +1,78 @@
+export function findOverlaps(items) {
+  const warnings = []
+  for (let i = 0; i < items.length; i++) for (let j = i + 1; j < items.length; j++) {
+    const a = items[i], b = items[j]
+    if (a.allowed || b.allowed || a.owner === b.owner || a.ancestors?.includes(b.owner) || b.ancestors?.includes(a.owner)) continue
+    if (Math.min(a.right, b.right) - Math.max(a.left, b.left) > 2 && Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top) > 2) warnings.push(`overlap: ${a.label} / ${b.label}`)
+  }
+  return warnings
+}
+export function diagnose({ texts, chrome = [], controls, attribution }) {
+  const warnings = findOverlaps([...texts, ...chrome])
+  for (const active of controls.filter(c => c.active)) {
+    const signature = JSON.stringify(active.visual)
+    if (controls.some(c => !c.active && c.kind === active.kind && JSON.stringify(c.visual) === signature)) warnings.push(`indistinct active navigation: ${active.kind} ${active.label}`)
+  }
+  if (!attribution) warnings.push('missing attribution: style [data-presentation-attribution]')
+  else if (attribution.size < 11 || attribution.browserDefault) warnings.push('unpolished attribution: style [data-presentation-attribution]')
+  return warnings
+}
+// Serialized into the page by Playwright; keep this function self-contained.
+export function collectDiagnostics() {
+  const texts = [], chrome = [], controls = []
+  const root = document.querySelector('[data-presentation]')
+  const owners = new Map()
+  function visible(el) {
+    for (let node = el; node; node = node.parentElement) {
+      const style = getComputedStyle(node)
+      if (style.display === 'none' || style.visibility === 'hidden' || Number(style.opacity) === 0) return false
+    }
+    return el.getBoundingClientRect().width > 0 && el.getBoundingClientRect().height > 0
+  }
+  function decorated(style) {
+    const background = style.backgroundColor
+    if (background && background !== 'transparent' && !/(,|\/)\s*0\)$/.test(background)) return true
+    if (['Top', 'Right', 'Bottom', 'Left'].some(side => parseFloat(style[`border${side}Width`]) > 0 && style[`border${side}Style`] !== 'none')) return true
+    return !!style.boxShadow && style.boxShadow !== 'none'
+  }
+  function owner(node) {
+    if (!owners.has(node)) owners.set(node, owners.size)
+    return owners.get(node)
+  }
+  function item(node, rect, label) {
+    const el = node.nodeType === Node.TEXT_NODE ? node.parentElement : node
+    const ancestors = []
+    for (let parent = node.parentElement; parent; parent = parent.parentElement) ancestors.push(owner(parent))
+    return { left: rect.left, right: rect.right, top: rect.top, bottom: rect.bottom, owner: owner(node), ancestors, label, allowed: !!el.closest('[data-presentation-allow-overlap]') }
+  }
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
+  while (walker.nextNode()) {
+    const node = walker.currentNode, el = node.parentElement
+    if (!node.textContent.trim() || !visible(el) || el.closest('script,style')) continue
+    const range = document.createRange()
+    range.selectNodeContents(node)
+    const label = el.closest('[data-entity-id]')?.getAttribute('data-entity-id') ?? node.textContent.trim().slice(0, 60)
+    texts.push(item(node, range.getBoundingClientRect(), label))
+  }
+  const hooks = ['prev', 'next', 'progress-step', 'toc-entry', 'mode-toggle', 'attribution', 'caption', 'title', 'marker', 'document-title', 'brand']
+  for (const hook of hooks) {
+    for (const el of root.querySelectorAll(`[data-presentation-${hook}]`)) {
+      if (el.closest('[data-presentation-stage]') || !visible(el)) continue
+      // Undecorated non-interactive text chrome is block-level, so its box spans the container; its glyphs are already collected.
+      if (!el.matches('button,a') && !decorated(getComputedStyle(el)) && texts.some(t => t.ancestors.includes(owner(el)))) continue
+      const name = el.getAttribute('aria-label') || el.textContent.trim().slice(0, 60)
+      chrome.push(item(el, el.getBoundingClientRect(), `${hook}${name ? ` (${name})` : ''}`))
+    }
+  }
+  for (const kind of ['progress-step', 'toc-entry']) {
+    for (const el of root.querySelectorAll(`[data-presentation-${kind}]`)) {
+      if (!visible(el)) continue
+      const style = getComputedStyle(el)
+      controls.push({ kind, label: el.getAttribute('aria-label') ?? el.textContent, active: el.getAttribute('data-presentation-active') === 'true', visual: ['color','backgroundColor','borderColor','borderWidth','fontWeight','textDecorationLine','opacity','boxShadow','transform'].map(key => style[key]) })
+    }
+  }
+  const link = root.querySelector('[data-presentation-attribution]')
+  const style = link && getComputedStyle(link)
+  const attribution = link && visible(link) ? { size: parseFloat(style.fontSize), browserDefault: ['rgb(0, 0, 238)', 'rgb(85, 26, 139)'].includes(style.color) && style.textDecorationLine.includes('underline') } : null
+  return { texts, chrome, controls, attribution }
+}
diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4c50e22b9a7910eb6d12c5505d5c7475675d7a94
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,36 @@
+import { mkdir, writeFile } from 'node:fs/promises'
+import { resolve } from 'node:path'
+import { build, isMain, projectRoot, readStepCount, settleStep, watchErrors, withBrowser } from './browser-runtime.mjs'
+import { collectDiagnostics, diagnose } from './diagnostics.mjs'
+export async function inspect({ slug, root = projectRoot, width = 1440, height = 900, settle = 850, skipBuild = false } = {}) {
+  if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug ?? '')) throw new Error('Usage: npm run inspect -- <registered-slug> [--width N] [--height N] [--settle N]')
+  if (![width,height,settle].every(Number.isFinite) || width < 1 || height < 1 || settle < 0) throw new Error('Invalid viewport or settle interval')
+  if (!skipBuild) await build(root)
+  const directory = resolve(root, 'artifacts/inspection', slug, `${width}x${height}`)
+  await mkdir(directory, { recursive: true })
+  const reports = []
+  await withBrowser(async (page, url) => {
+    const checkErrors = watchErrors(page)
+    await page.goto(`${url}/${slug}`)
+    const count = await readStepCount(page)
+    for (let index = 0; index < count; index++) {
+      const started = Date.now()
+      await settleStep(page, index, settle)
+      checkErrors()
+      const warnings = diagnose(await page.evaluate(collectDiagnostics))
+      for (const warning of warnings) console.warn(`ADVISORY step ${index}: ${warning}`)
+      const file = `step-${String(index + 1).padStart(2, '0')}.png`
+      await page.screenshot({ path: resolve(directory, file) })
+      reports.push({ index, file, settle, elapsedBeforeCapture: Date.now() - started, warnings })
+      console.log(`CAPTURE step ${index}: ${file}`)
+      if (index < count - 1) await page.keyboard.press('ArrowRight')
+    }
+  }, { root, width, height })
+  await writeFile(resolve(directory, 'report.json'), JSON.stringify(reports, null, 2))
+  console.log(`Inspection artifacts: ${directory}; warnings are advisory, visual review is required.`)
+  return reports
+}
+if (isMain(import.meta.url)) {
+  const option = (name, fallback) => { const i = process.argv.indexOf(name); return i < 0 ? fallback : Number(process.argv[i + 1]) }
+  inspect({ slug: process.argv[2], width: option('--width', 1440), height: option('--height', 900), settle: option('--settle', 850) }).catch(error => { console.error(`FAIL inspection: ${error.message}`); process.exitCode = 1 })
+}
