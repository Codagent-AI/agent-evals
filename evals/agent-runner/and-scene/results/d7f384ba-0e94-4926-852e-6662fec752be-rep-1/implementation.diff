+for(let index=0;index<count;index++){await page.waitForTimeout(1000);await page.screenshot({path:`${output}/step-${String(index+1).padStart(2,'0')}.png`,fullPage:true});const result=await page.evaluate(()=>{const visible=e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e);return r.width>0&&r.height>0&&s.visibility!=='hidden'&&s.display!=='none'},units='[data-presentation-node],a,button',hasText=e=>[...e.childNodes].some(n=>n.nodeType===3&&n.textContent.trim()),label=e=>e.textContent?.trim()||e.getAttribute('aria-label')||e.tagName.toLowerCase(),nodes=[...document.querySelectorAll('[data-presentation] *')].filter(e=>(e.matches(units)||(hasText(e)&&!e.closest(units)))&&visible(e)),collisions=[];for(let a=0;a<nodes.length;a++)for(let b=a+1;b<nodes.length;b++){if(nodes[a].contains(nodes[b])||nodes[b].contains(nodes[a]))continue;const x=nodes[a].getBoundingClientRect(),y=nodes[b].getBoundingClientRect();if(x.left<y.right&&x.right>y.left&&x.top<y.bottom&&x.bottom>y.top&&!nodes[a].closest('[data-presentation-allow-overlap]')&&!nodes[b].closest('[data-presentation-allow-overlap]'))collisions.push(`${label(nodes[a])} / ${label(nodes[b])}`)}const groups=['[data-presentation-progress-step]','[data-presentation-toc-entry]'].map(selector=>{const es=[...document.querySelectorAll(selector)],sig=e=>{const s=getComputedStyle(e);return[s.color,s.backgroundColor,s.fontWeight,s.border,s.outline,s.textDecorationLine].join('|')},active=es.find(e=>e.getAttribute('data-presentation-active')==='true'||e.getAttribute('aria-current'));return{active:!!active,hasInactive:es.some(e=>e!==active),distinct:!!active&&es.filter(e=>e!==active).every(e=>sig(active)!==sig(e))}}).filter(g=>g.hasInactive);const a=document.querySelector('[data-presentation-attribution]'),s=a&&getComputedStyle(a);return{collisions,groups,attribution:a?{text:a.textContent,href:a.getAttribute('href'),size:parseFloat(s.fontSize),family:s.fontFamily}:null}});for(const c of result.collisions)warnings.push(`step ${index+