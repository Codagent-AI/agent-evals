+    // remove
+    rerender(<Presentation steps={FOUR.filter((s) => s.id !== 'a')} title="t" />)
+    expect(screen.getByLabelText('Step 1: Title b')).toBeTruthy()
+    expect(screen.queryByLabelText('Step 1: Title a')).toBeNull()
