diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/motion.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/motion.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cc718a0430af03942f3a1d5db0efcfc122f93046
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/motion.ts
@@ -0,0 +1,24 @@
+import { ENTER_DELAY, ENTER_T, EASE, EXIT_T, LAYOUT_T } from './constants'
+
+export const LAYOUT_TRANSITION = { layout: { duration: LAYOUT_T, ease: EASE } }
+
+/** Newcomer enter timing; caller offsets can only delay, never advance. */
+export function appearTransition(offset = 0) {
+  return { duration: ENTER_T, delay: ENTER_DELAY + Math.max(0, offset), ease: EASE }
+}
+
+export const EXIT_TRANSITION = { duration: EXIT_T }
+
+/**
+ * Props that make an element a newcomer: it fades in after persisting entities
+ * settle. `appear` of `false`/`undefined` adds no enter behavior, so continuing
+ * entities are never faded. Every element can exit when its parent is removed.
+ */
+export function presenceProps(appear: boolean | number | undefined) {
+  const enter = appear === undefined || appear === false ? null : appear === true ? 0 : appear
+  return {
+    initial: enter === null ? undefined : { opacity: 0 },
+    animate: enter === null ? undefined : { opacity: 1, transition: appearTransition(enter) },
+    exit: { opacity: 0, transition: EXIT_TRANSITION },
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/navigation.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/navigation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1d6767289793f41f5f5087413740af629fa70fdd
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/navigation.ts
@@ -0,0 +1,41 @@
+import { SWIPE_MIN_PX } from './constants'
+
+export type NavAction = 'next' | 'prev' | 'toggle-mode'
+
+export function clampIndex(index: number, count: number): number {
+  return Math.min(Math.max(index, 0), count - 1)
+}
+
+const NEXT_KEYS = new Set(['ArrowRight', ' ', 'PageDown'])
+const PREV_KEYS = new Set(['ArrowLeft', 'PageUp'])
+
+export function keyAction(e: Pick<KeyboardEvent, 'key' | 'ctrlKey' | 'metaKey' | 'altKey'>): NavAction | null {
+  if (e.ctrlKey || e.metaKey || e.altKey) return null
+  if (NEXT_KEYS.has(e.key)) return 'next'
+  if (PREV_KEYS.has(e.key)) return 'prev'
+  if (e.key === 'p' || e.key === 'P') return 'toggle-mode'
+  return null
+}
+
+/** Horizontal swipes only: left advances, right goes back. */
+export function swipeAction(dx: number, dy: number): NavAction | null {
+  if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) <= Math.abs(dy)) return null
+  return dx < 0 ? 'next' : 'prev'
+}
+
+const INTERACTIVE_ROLES = new Set([
+  'button', 'link', 'tab', 'checkbox', 'radio', 'switch', 'menuitem', 'option',
+  'slider', 'spinbutton', 'textbox', 'combobox', 'searchbox', 'listbox', 'treeitem',
+])
+
+/** Focused controls keep their own keys. */
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+  if (!(target instanceof Element)) return false
+  const tag = target.tagName.toLowerCase()
+  if (tag === 'button' || tag === 'input' || tag === 'select' || tag === 'textarea' || tag === 'summary') return true
+  if (tag === 'a' && target.hasAttribute('href')) return true
+  const editable = target.getAttribute('contenteditable')
+  if (editable !== null && editable !== 'false') return true
+  const role = target.getAttribute('role')
+  return role !== null && INTERACTIVE_ROLES.has(role.toLowerCase())
+}
