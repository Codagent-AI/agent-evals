new file mode 100644
index 0000000000000000000000000000000000000000..2e2edcd4c4f04090c9df960dd83fd01e82613902
--- /dev/null
+++ b/tests/integration/e2e-001-verify.test.ts
@@ -0,0 +1,42 @@
+import { afterAll, describe, expect, it } from 'vitest'
+import { cleanupTmp, portIsClosed, processesMentioning, run, tmpDir } from '../helpers/proc'
+import { ROOT, specOutline } from '../helpers/spec-outline'
+
+afterAll(cleanupTmp)
+
+// E2E-001: the reference presentation passes production verification.
+describe('E2E-001: `npm run verify` on the committed repository', () => {
+  it('builds, finds the nine-step sample, renders every step on 127.0.0.1 and exits zero with a clear pass', async () => {
+    const scratch = tmpDir('e2e001-tmp') // the browser profile lives here, so leftover browsers are findable
+    const result = await run('npm', ['run', 'verify', '--silent'], { cwd: ROOT, timeoutMs: 400000, env: { TMPDIR: scratch } })
+    const out = result.stdout + result.stderr
+    expect(result.code, out).toBe(0)
+    expect(result.stdout).toMatch(/^PASS verify:/m)
+    expect(out).not.toMatch(/FAIL/)
+
+    // build then sample then render, in order
+    const order = ['build: ok', 'sample: "how-to-make-a-presentation" is registered and matches its 9-step outline', 'render: opening']
+    let at = -1
+    for (const marker of order) {
+      const next = out.indexOf(marker)
+      expect(next, marker).toBeGreaterThan(at)
+      at = next
+    }
+    expect(specOutline()).toHaveLength(9)
+
+    // every one of the nine step indices observed in order
+    expect(out).toContain('observed step indices 0,1,2,3,4,5,6,7,8 with no console or page errors')
+
+    // IPv4 loopback for the preview host, the readiness probe and the browser URL
+    const probe = /preview host 127\.0\.0\.1 port (\d+); readiness probe http:\/\/127\.0\.0\.1:\1\//.exec(out)
+    expect(probe, out).not.toBeNull()
+    const port = Number(probe![1])
+    expect(out).toContain(`render: opening http://127.0.0.1:${port}/how-to-make-a-presentation`)
+    expect(out).not.toMatch(/localhost|\[::1\]/)
+
+    // the preview is gone once verification exits
+    expect(await portIsClosed(port)).toBe(true)
+    // and so is the browser it launched
+    expect(processesMentioning(scratch)).toEqual([])
+  })
+})
diff --git a/tests/integration/e2e-002-failures.test.ts b/tests/integration/e2e-002-failures.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2082f24164e551f6679d52a3235e02c76cff2208
--- /dev/null
+++ b/tests/integration/e2e-002-failures.test.ts
@@ -0,0 +1,144 @@
+import { appendFileSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import path from 'node:path'
+import { afterAll, describe, expect, it } from 'vitest'
+import { addPresentation } from '../../skills/presentation/scripts/scaffold.mjs'
+import { cleanupTmp, copyRepo, portIsClosed, processesMentioning, run, tmpDir } from '../helpers/proc'
+
+afterAll(cleanupTmp)
+
+const SLUG = 'how-to-make-a-presentation'
+const stepsFile = (dir: string) => path.join(dir, 'src/presentations', SLUG, 'steps/index.ts')
+const edit = (file: string, fn: (text: string) => string) => writeFileSync(file, fn(readFileSync(file, 'utf8')))
+const prependNoCheck = (file: string) => edit(file, (t) => `// @ts-nocheck\n${t}`)
+
+/** Replace the Scene of step `i` (0-based) with a faulty wrapper around the real one. */
+function breakStep(dir: string, i: number, body: string) {
+  prependNoCheck(stepsFile(dir))
+  appendFileSync(
+    stepsFile(dir),
+    `\nimport { createElement } from 'react'\nconst Real = STEPS[${i}].Scene\nSTEPS[${i}] = { ...STEPS[${i}], Scene: (p) => { ${body}; return createElement(Real, p) } }\n`,
+  )
+}
+
+interface Fault {
+  name: string
+  setup: (dir: string) => void
+  phase: 'build' | 'sample' | 'render'
+  expectOutput: RegExp[]
+}
+
+const faults: Fault[] = [
+  {
+    name: 'a type error inside the sample breaks the build',
+    setup: (d) => appendFileSync(stepsFile(d), "\nexport const broken: number = 'not a number'\n"),
+    phase: 'build',
+    expectOutput: [/npm run build exited with code/],
+  },
+  {
+    name: 'a type error outside the sample breaks the build',
+    setup: (d) => writeFileSync(path.join(d, 'src/elsewhere.ts'), "export const x: number = 'nope'\n"),
+    phase: 'build',
+    expectOutput: [/npm run build exited with code/],
+  },
+  {
+    name: 'an absent reference sample fails the sample phase',
+    setup: (d) => {
+      addPresentation(d, { slug: 'other', title: 'Other' })
+      rmSync(path.join(d, 'src/presentations', SLUG), { recursive: true })
+      edit(path.join(d, 'src/presentations/index.ts'), (t) => t.split('\n').filter((l) => !l.includes(SLUG)).join('\n'))
+    },
+    phase: 'sample',
+    expectOutput: [/reference presentation "how-to-make-a-presentation" is not registered/],
+  },
+  {
+    name: 'out-of-order sample steps fail the sample phase',
+    setup: (d) => {
+      prependNoCheck(stepsFile(d))
+      appendFileSync(stepsFile(d), '\n;[STEPS[2], STEPS[3]] = [STEPS[3], STEPS[2]]\n')
+    },
+    phase: 'sample',
+    expectOutput: [/step 3 title/, /step 4 title/],
+  },
+  {
+    name: 'a wrong caption fails the sample phase',
+    setup: (d) => {
+      prependNoCheck(stepsFile(d))
+      appendFileSync(stepsFile(d), "\nSTEPS[6] = { ...STEPS[6], caption: 'Something else entirely.' }\n")
+    },
+    phase: 'sample',
+    expectOutput: [/step 7 caption/],
+  },
+  {
+    name: 'a truncated sample fails the sample phase',
+    setup: (d) => {
+      prependNoCheck(stepsFile(d))
+      appendFileSync(stepsFile(d), '\nSTEPS.pop()\n')
+    },
+    phase: 'sample',
+    expectOutput: [/expected 9 steps, found 8/],
+  },
+  {
+    name: 'a browser step count that disagrees with the reference outline fails the render phase',
+    setup: (d) =>
+      edit(path.join(d, 'src/presentation-kit/Presentation.tsx'), (t) =>
+        t.replace('data-step-count={steps.length}', 'data-step-count={steps.length - 1}'),
+      ),
+    phase: 'render',
+    expectOutput: [/step index 0/, /data-step-count is 8 but the reference outline has 9 steps/],
+  },
+  {
+    name: 'a console error while stepping fails the render phase and names the step',
+    setup: (d) => breakStep(d, 4, "console.error('INJECTED console error')"),
+    phase: 'render',
+    expectOutput: [/step index 4 \(step 5 of 9\)/, /INJECTED console error/],
+  },
+  {
+    name: 'an uncaught page error while stepping fails the render phase and names the step',
+    setup: (d) => breakStep(d, 6, "setTimeout(() => { throw new Error('INJECTED uncaught error') }, 0)"),
+    phase: 'render',
+    expectOutput: [/step index 6 \(step 7 of 9\)/, /INJECTED uncaught error/],
+  },
+  {
+    name: 'a step that throws while rendering fails the render phase and names the step',
+    setup: (d) => breakStep(d, 5, "throw new Error('INJECTED render failure')"),
+    phase: 'render',
+    expectOutput: [/step index 5 \(step 6 of 9\)/, /INJECTED render failure/],
+  },
+  {
+    name: 'a transition that does not advance the step index fails the render phase',
+    setup: (d) =>
+      edit(path.join(d, 'src/presentation-kit/navigation.ts'), (t) =>
+        t.replace('Math.min(Math.max(index, 0), count - 1)', 'Math.min(Math.max(index, 0), Math.min(count - 1, 4))'),
+      ),
+    phase: 'render',
+    expectOutput: [/step index 5 \(step 6 of 9\)/, /did not advance data-step-index to 5/],
+  },
+]
+
+// E2E-002: verification failures are actionable. Each fault runs in its own
+// disposable copy of the repository, so the source checkout is never touched.
+describe('E2E-002: `npm run verify` fails clearly on injected faults', () => {
+  it.concurrent.each(faults)('$name', async ({ setup, phase, expectOutput }) => {
+    const dir = copyRepo('e2e002')
+    setup(dir)
+    const scratch = tmpDir('e2e002-tmp')
+    const result = await run('node', ['scripts/verify.mjs'], { cwd: dir, timeoutMs: 400000, env: { TMPDIR: scratch } })
+    const out = result.stdout + result.stderr
+    expect(result.code, out).not.toBe(0)
+    expect(result.stderr, out).toContain(`FAIL [${phase}]`)
+    expect(out).not.toMatch(/PASS/)
+    for (const re of expectOutput) expect(out).toMatch(re)
+
+    // phases stop at the first failure
+    expect(out.includes('build: ok')).toBe(phase !== 'build')
+    expect(out.includes('render: opening')).toBe(phase === 'render')
+
+    // the preview is cleaned up after a failure
+    const probe = /preview host 127\.0\.0\.1 port (\d+)/.exec(out)
+    if (phase === 'render') {
+      expect(probe, out).not.toBeNull()
+      expect(await portIsClosed(Number(probe![1]))).toBe(true)
+      expect(processesMentioning(scratch)).toEqual([]) // no browser left behind
+    }
+  })
+})
diff --git a/tests/integration/int-001-bootstrap.test.ts b/tests/integration/int-001-bootstrap.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..000e60bbe8137752fae739759d9380e0140e4c6e
--- /dev/null
+++ b/tests/integration/int-001-bootstrap.test.ts
@@ -0,0 +1,126 @@
+import { cpSync, existsSync, mkdirSync, readdirSync, readFileSync, statSync, symlinkSync, writeFileSync } from 'node:fs'
+import path from 'node:path'
+import { afterAll, beforeAll, describe, expect, it } from 'vitest'
+import { cleanupTmp, run, tmpDir } from '../helpers/proc'
+import { ROOT } from '../helpers/spec-outline'
+
+afterAll(cleanupTmp)
+
+const CLI = path.join(ROOT, 'skills/presentation/scripts/scaffold.mjs')
+const REQUIRED = ['react', 'react-dom', 'motion', 'lucide-react', 'vite', '@vitejs/plugin-react', 'typescript', '@types/react', '@types/react-dom', '@types/node', 'playwright']
+
+const walk = (dir: string, base = dir): string[] =>
+  readdirSync(dir).flatMap((n) => {
+    if (n === 'node_modules' || n === 'dist') return []
+    const f = path.join(dir, n)
+    return statSync(f).isDirectory() ? walk(f, base) : [path.relative(base, f)]
+  })
+
+let app: string
+let cwd: string
+
+beforeAll(async () => {
+  // Materialize from a working directory unrelated to the source repository.
+  cwd = tmpDir('int001-cwd')
+  app = path.join(tmpDir('int001-app'), 'app')
+  const boot = await run('node', [CLI, 'bootstrap', app, '--target', app], { cwd })
+  expect(boot.code, boot.stderr).toBe(0)
+  const add = await run('node', [CLI, 'add', app, 'smoke-test', 'Smoke Test'], { cwd })
+  expect(add.code, add.stderr).toBe(0)
+  // a title with quotes, an ampersand, markup and a comment terminator must still generate valid sources
+  const quoted = await run('node', [CLI, 'add', app, 'quoted-title', 'Say "hi" & <b>bye</b> */'], { cwd })
+  expect(quoted.code, quoted.stderr).toBe(0)
+  const install = await run('npm', ['ci', '--no-audit', '--no-fund'], { cwd: app, timeoutMs: 400000 })
+  expect(install.code, install.stdout + install.stderr).toBe(0)
+})
+
+// INT-001: the distributable bootstrap snapshot is complete and style-neutral.
+describe('INT-001: materialized bootstrap', () => {
+  it('has all three contract anchors, and template lookup did not depend on the caller\'s cwd', async () => {
+    const resolved = JSON.parse((await run('node', [CLI, 'resolve', app], { cwd })).stdout)
+    expect(resolved.anchors).toEqual({ build: true, kit: true, index: true })
+    expect(resolved.missing).toEqual([])
+    expect(walk(cwd)).toEqual([]) // nothing was written relative to the caller's cwd
+    for (const anchor of ['src/presentation-kit/Presentation.tsx', 'src/presentations/index.ts', 'vite.config.ts']) {
+      expect(existsSync(path.join(app, anchor)), anchor).toBe(true)
+    }
+  })
+
+  it('declares the full dependency set in package.json and the committed lock data, and installed it', () => {
+    const pkg = JSON.parse(readFileSync(path.join(app, 'package.json'), 'utf8'))
+    const lock = JSON.parse(readFileSync(path.join(app, 'package-lock.json'), 'utf8'))
+    const declared = { ...pkg.dependencies, ...pkg.devDependencies }
+    const eslintStack = ['eslint', '@eslint/js', 'eslint-plugin-react-hooks', 'eslint-plugin-react-refresh', 'globals', 'typescript-eslint']
+    for (const dep of [...REQUIRED, ...eslintStack]) {
+      expect(declared[dep], `${dep} declared`).toBeDefined()
+      expect(lock.packages[`node_modules/${dep}`], `${dep} locked`).toBeDefined()
+      expect(existsSync(path.join(app, 'node_modules', dep, 'package.json')), `${dep} installed`).toBe(true)
+    }
+  })
+
+  it('builds, lints, and passes its own verification entry point on the registered route', async () => {
+    const build = await run('npm', ['run', 'build', '--silent'], { cwd: app, timeoutMs: 300000 })
+    expect(build.code, build.stdout + build.stderr).toBe(0)
+    const lint = await run('npm', ['run', 'lint', '--silent'], { cwd: app, timeoutMs: 300000 })
+    expect(lint.code, lint.stdout + lint.stderr).toBe(0)
+    const verify = await run('npm', ['run', 'verify', '--silent'], { cwd: app, timeoutMs: 400000 })
+    const out = verify.stdout + verify.stderr
+    expect(verify.code, out).toBe(0)
+    expect(out).toContain('render: opening http://127.0.0.1:')
+    expect(out).toContain('/smoke-test')
+    expect(out).toContain('/quoted-title')
+    expect(out).toContain('observed step indices 0,1')
+    expect(out).toMatch(/PASS verify/)
+  })
+
+  it('keeps the kit and scripts byte-aligned with the canonical sources', () => {
+    const kit = walk(path.join(ROOT, 'src/presentation-kit'))
+    expect(walk(path.join(app, 'src/presentation-kit'))).toEqual(kit)
+    for (const f of kit) {
+      expect(readFileSync(path.join(app, 'src/presentation-kit', f)), f).toEqual(readFileSync(path.join(ROOT, 'src/presentation-kit', f)))
+    }
+    for (const f of ['verify.mjs', 'inspect-presentation.mjs', ...walk(path.join(ROOT, 'scripts/lib')).map((x) => path.join('lib', x))]) {
+      expect(readFileSync(path.join(app, 'scripts', f)), f).toEqual(readFileSync(path.join(ROOT, 'scripts', f)))
+    }
+  })
+
+  it('introduces no Tailwind or visual defaults in the reusable kit or the scaffold', () => {
+    expect(existsSync(path.join(app, 'node_modules/tailwindcss'))).toBe(false)
+    expect(existsSync(path.join(app, 'node_modules/@tailwindcss'))).toBe(false)
+    const generated = ['smoke-test', 'quoted-title'].map((slug) => `src${path.sep}presentations${path.sep}${slug}`)
+    const own = walk(app).filter((f) => !generated.some((g) => f.startsWith(g)) && f !== 'package-lock.json')
+    for (const f of own) {
+      expect(readFileSync(path.join(app, f), 'utf8'), f).not.toMatch(/tailwind/i)
+    }
+    const css = own.filter((f) => /\.(css|scss|sass|less)$/.test(f))
+    expect(css).toEqual([path.join('src', 'index.css')])
+    for (const f of own.filter((x) => x.startsWith(`src${path.sep}presentation-kit`))) {
+      expect(readFileSync(path.join(app, f), 'utf8'), f).not.toMatch(/\b(?:backgroundColor|fontFamily|boxShadow|borderRadius|fontSize)\s*:|#[0-9a-fA-F]{6}\b/)
+    }
+  })
+
+  it('wires an ordinary existing Vite app (entry point renders its own App) to the registry, builds and renders it', async () => {
+    // build anchor only: the template's build files, but its own App and entry point
+    const ordinary = path.join(tmpDir('int001-ordinary'), 'ordinary')
+    mkdirSync(path.join(ordinary, 'src'), { recursive: true })
+    for (const f of ['package.json', 'package-lock.json', 'vite.config.ts', 'tsconfig.json', 'tsconfig.app.json', 'tsconfig.node.json', 'eslint.config.js', 'index.html', '.gitignore']) {
+      cpSync(path.join(app, f), path.join(ordinary, f))
+    }
+    writeFileSync(path.join(ordinary, 'src/App.tsx'), 'export default function App() { return <p>my own app</p> }\n')
+    writeFileSync(path.join(ordinary, 'src/main.tsx'), "import { createRoot } from 'react-dom/client'\nimport App from './App'\ncreateRoot(document.getElementById('root')!).render(<App />)\n")
+    symlinkSync(path.join(app, 'node_modules'), path.join(ordinary, 'node_modules'))
+
+    const resolved = JSON.parse((await run('node', [CLI, 'resolve', ordinary], { cwd })).stdout)
+    expect(resolved.anchors).toEqual({ build: true, kit: false, index: false })
+    const boot = JSON.parse((await run('node', [CLI, 'bootstrap', ordinary], { cwd })).stdout)
+    expect(boot.notes.join(' ')).toContain('now renders the presentation router')
+    expect(existsSync(path.join(ordinary, 'src/main.tsx.bak'))).toBe(true)
+    const add = await run('node', [CLI, 'add', ordinary, 'wired-up', 'Wired Up'], { cwd })
+    expect(add.code, add.stderr).toBe(0)
+
+    const verify = await run('npm', ['run', 'verify', '--silent'], { cwd: ordinary, timeoutMs: 400000 })
+    const out = verify.stdout + verify.stderr
+    expect(verify.code, out).toBe(0)
+    expect(out).toContain('/wired-up')
+  })
+})
diff --git a/tests/integration/int-002-inspect.test.ts b/tests/integration/int-002-inspect.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a2f5d5413211316f4cf5b93ec325e05369ea4e13
--- /dev/null
+++ b/tests/integration/int-002-inspect.test.ts
@@ -0,0 +1,147 @@
+import { mkdirSync, readFileSync, writeFileSync, existsSync, cpSync } from 'node:fs'
+import path from 'node:path'
+import { afterAll, beforeAll, describe, expect, it } from 'vitest'
+import { cleanupTmp, copyRepo, run } from '../helpers/proc'
+import { ROOT } from '../helpers/spec-outline'
+
+afterAll(cleanupTmp)
+
+type Variant = { progress: boolean; toc: boolean; attribution: 'good' | 'small' | 'default' | 'missing'; collision: 'none' | 'unmarked' | 'allowed' }
+const polished: Variant = { progress: true, toc: true, attribution: 'good', collision: 'none' }
+const VARIANTS: Record<string, Variant> = {
+  'fx-clean': polished,
+  'fx-collision': { ...polished, collision: 'unmarked' },
+  'fx-allowed': { ...polished, collision: 'allowed' },
+  'fx-indistinct-progress': { ...polished, progress: false },
+  'fx-indistinct-toc': { ...polished, toc: false },
+  'fx-attr-small': { ...polished, attribution: 'small' },
+  'fx-attr-default': { ...polished, attribution: 'default' },
+  'fx-attr-missing': { ...polished, attribution: 'missing' },
+}
+
+let app: string
+const warningsOf = (out: string) => out.split('\n').filter((l) => l.startsWith('WARN '))
+const inspectRun = (slug: string, extra: string[] = []) =>
+  run('node', ['scripts/inspect-presentation.mjs', slug, '--no-build', ...extra], { cwd: app, timeoutMs: 120000 })
+
+function png(file: string) {
+  const bytes = readFileSync(file)
+  expect(bytes.subarray(0, 8).toString('hex')).toBe('89504e470d0a1a0a')
+  return { width: bytes.readUInt32BE(16), height: bytes.readUInt32BE(20), size: bytes.length }
+}
+
+beforeAll(async () => {
+  app = copyRepo('int002')
+  cpSync(path.join(ROOT, 'tests/fixtures/inspect'), path.join(app, 'src/presentations/inspect-fixture'), { recursive: true })
+  const entries: string[] = []
+  for (const [slug, variant] of Object.entries(VARIANTS)) {
+    mkdirSync(path.join(app, 'src/presentations', slug), { recursive: true })
+    writeFileSync(
+      path.join(app, 'src/presentations', slug, 'Talk.tsx'),
+      `import { makeTalk } from '../inspect-fixture/Fixture'\nexport default makeTalk('${slug}', ${JSON.stringify(variant)})\n`,
+    )
+    entries.push(`  { slug: '${slug}', title: '${slug}', load: () => import('./${slug}/Talk') },`)
+  }
+  const registry = path.join(app, 'src/presentations/index.ts')
+  writeFileSync(registry, readFileSync(registry, 'utf8').replace('  // presentations:end', `${entries.join('\n')}\n  // presentations:end`))
+  // the fixture variants need `attribution: 'default'` to leave the link unstyled (nothing to add)
+  const build = await run('npm', ['run', 'build', '--silent'], { cwd: app, timeoutMs: 300000 })
+  expect(build.code, build.stdout + build.stderr).toBe(0)
+})
+
+// INT-002: the screenshot helper emits faithful artifacts and advisory warnings.
+describe('INT-002: project-local screenshot helper', () => {
+  it('writes one 1440x900 screenshot per step at predictable paths, waits the settle interval, and stays silent on a polished presentation', async () => {
+    const result = await inspectRun('fx-clean')
+    expect(result.code, result.stdout + result.stderr).toBe(0)
+    const dir = path.join(app, 'inspection/fx-clean')
+    for (const n of ['01', '02', '03']) {
+      const shot = png(path.join(dir, `step-${n}.png`))
+      expect([shot.width, shot.height]).toEqual([1440, 900])
+      expect(shot.size).toBeGreaterThan(5000)
+    }
+    expect(existsSync(path.join(dir, 'step-04.png'))).toBe(false)
+    expect(warningsOf(result.stdout)).toEqual([])
+    expect(result.stdout).toContain('INSPECT fx-clean: 3 screenshot(s)')
+
+    const report = JSON.parse(readFileSync(path.join(dir, 'report.json'), 'utf8'))
+    expect(report.url).toMatch(/^http:\/\/127\.0\.0\.1:\d+\/fx-clean$/)
+    expect(report.steps).toHaveLength(3)
+    for (const step of report.steps) {
+      expect(step.elapsedMs).toBeGreaterThanOrEqual(900)
+      expect(step.runningAnimationsAtCapture).toBe(0) // the fixture's 600 ms transition has settled
+    }
+  })
+
+  it('captures before the transition settles only when the interval is shortened', async () => {
+    const result = await inspectRun('fx-clean', ['--settle', '100', '--out', path.join(app, 'inspection/fx-fast')])
+    expect(result.code, result.stdout + result.stderr).toBe(0)
+    const report = JSON.parse(readFileSync(path.join(app, 'inspection/fx-fast/report.json'), 'utf8'))
+    expect(report.steps.slice(1).every((s: { runningAnimationsAtCapture: number }) => s.runningAnimationsAtCapture > 0)).toBe(true)
+    expect(report.steps.every((s: { elapsedMs: number }) => s.elapsedMs >= 100 && s.elapsedMs < 800)).toBe(true)
+  })
+
+  it('reports an unmarked text/chrome collision with the step and both elements, still exiting zero', async () => {
+    const result = await inspectRun('fx-collision')
+    expect(result.code, result.stdout + result.stderr).toBe(0)
+    const warnings = warningsOf(result.stdout)
+    const overlaps = warnings.filter((w) => w.includes('[overlap]'))
+    const labels = overlaps.find((w) => w.includes('step 2'))!
+    expect(labels).toContain('first overlapping label')
+    expect(labels).toContain('second overlapping label')
+    const chrome = overlaps.find((w) => w.includes('step 3'))!
+    expect(chrome).toContain('COLLIDING TEXT')
+    expect(chrome).toContain('data-presentation-title')
+    expect(warnings.some((w) => w.includes('step 1'))).toBe(false)
+    expect(warnings.every((w) => w.includes('[overlap]'))).toBe(true)
+  })
+
+  it('does not warn about an overlap inside an allow-overlap subtree', async () => {
+    const result = await inspectRun('fx-allowed')
+    expect(result.code, result.stdout + result.stderr).toBe(0)
+    expect(warningsOf(result.stdout)).toEqual([])
+  })
+
+  it.each([
+    ['fx-indistinct-progress', 'progress indicator', 'table-of-contents entry'],
+    ['fx-indistinct-toc', 'table-of-contents entry', 'progress indicator'],
+  ])('reports indistinct active chrome on %s (%s) but not the other kind', async (slug, flagged, other) => {
+    const result = await inspectRun(slug)
+    expect(result.code).toBe(0)
+    const warnings = warningsOf(result.stdout)
+    expect(warnings.length).toBeGreaterThan(0)
+    expect(warnings.every((w) => w.includes('[active-chrome]'))).toBe(true)
+    expect(warnings.some((w) => w.includes(`active ${flagged}`) && w.includes('step 1'))).toBe(true)
+    expect(warnings.some((w) => w.includes(other))).toBe(false)
+  })
+
+  it.each([
+    ['fx-attr-small', /9px \(under 11px\)/],
+    ['fx-attr-default', /browser-default link styling/],
+    ['fx-attr-missing', /attribution link is missing/],
+  ])('reports unpolished attribution on %s and points at its hook', async (slug, reason) => {
+    const result = await inspectRun(slug)
+    expect(result.code).toBe(0)
+    const warnings = warningsOf(result.stdout)
+    expect(warnings).toHaveLength(3) // one per step
+    warnings.forEach((w, i) => {
+      expect(w).toContain('[attribution]')
+      expect(w).toContain(`step ${i + 1}`)
+      expect(w).toMatch(reason)
+      expect(w).toContain('data-presentation-attribution')
+    })
+  })
+
+  it.each([[[], 9], [['--viewport', '390x844'], 9]])('finds no advisory warnings on the committed sample (%j)', async (args, steps) => {
+    const result = await inspectRun('how-to-make-a-presentation', args as string[])
+    expect(result.code, result.stdout + result.stderr).toBe(0)
+    expect(warningsOf(result.stdout)).toEqual([])
+    expect(result.stdout).toContain(`${steps} screenshot(s)`)
+  })
+
+  it('fails (non-zero) only for operational problems such as an unknown route', async () => {
+    const result = await run('node', ['scripts/inspect-presentation.mjs', 'does-not-exist', '--no-build'], { cwd: app, timeoutMs: 120000 })
+    expect(result.code).toBe(1)
+    expect(result.stderr).toContain('FAIL [inspect]')
+  })
+})
diff --git a/tests/types/step-contract.typecheck.tsx b/tests/types/step-contract.typecheck.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a452969c88e49a1370bb9e44bf57c0ad11e1841c
--- /dev/null
+++ b/tests/types/step-contract.typecheck.tsx
@@ -0,0 +1,42 @@
+// Compiled by `npm run build` (tsc -b). Each @ts-expect-error line must fail
+// to type-check, so relaxing the step contract breaks the build.
+import { Presentation, type SceneProps, type Step } from '../../src/presentation-kit'
+
+interface Payload {
+  label: string
+}
+
+function PayloadScene({ payload }: SceneProps<Payload>) {
+  return <span>{payload.label.toUpperCase()}</span>
+}
+
+const meta = { id: 'a', era: 'e', title: 't', caption: 'c' }
+
+export const typed: Step<Payload>[] = [
+  { ...meta, Scene: PayloadScene, payload: { label: 'one' }, groupKey: 'g' },
+  { ...meta, id: 'b', Scene: PayloadScene, payload: { label: 'two' }, groupKey: 'g' },
+]
+
+// Typed array reaches <Presentation> with no casts.
+export const host = <Presentation steps={typed} title="typed" />
+
+// @ts-expect-error id is required
+export const noId: Step<Payload> = { era: 'e', title: 't', caption: 'c', Scene: PayloadScene, payload: { label: 'x' } }
+// @ts-expect-error era is required
+export const noEra: Step<Payload> = { id: 'a', title: 't', caption: 'c', Scene: PayloadScene, payload: { label: 'x' } }
+// @ts-expect-error title is required
+export const noTitle: Step<Payload> = { id: 'a', era: 'e', caption: 'c', Scene: PayloadScene, payload: { label: 'x' } }
+// @ts-expect-error caption is required
+export const noCaption: Step<Payload> = { id: 'a', era: 'e', title: 't', Scene: PayloadScene, payload: { label: 'x' } }
+// @ts-expect-error Scene is required
+export const noScene: Step<Payload> = { id: 'a', era: 'e', title: 't', caption: 'c', payload: { label: 'x' } }
+// @ts-expect-error payload is required
+export const noPayload: Step<Payload> = { id: 'a', era: 'e', title: 't', caption: 'c', Scene: PayloadScene }
+// @ts-expect-error payload must match the Scene's payload type
+export const wrongPayload: Step<Payload> = { ...meta, Scene: PayloadScene, payload: { label: 3 } }
+// @ts-expect-error payload type is not erased to any: unknown properties are rejected
+export const extraPayload: Step<Payload> = { ...meta, Scene: PayloadScene, payload: { label: 'x', other: 1 } }
+// @ts-expect-error Scene payload type must agree with the step payload type
+export const mismatched: Step<Payload> = { ...meta, Scene: ({ payload }: SceneProps<{ n: number }>) => <i>{payload.n}</i>, payload: { label: 'x' } }
+// @ts-expect-error a step array with a different payload type is rejected by the host
+export const badHost = <Presentation<{ n: number }> steps={typed} title="bad" />
diff --git a/tests/unit/fit-scale.test.tsx b/tests/unit/fit-scale.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a4b7333cd5d2f41f0ad1b86286fa5aa092e6b4b6
--- /dev/null
+++ b/tests/unit/fit-scale.test.tsx
@@ -0,0 +1,81 @@
+import { act, fireEvent, render } from '@testing-library/react'
+import { beforeEach, describe, expect, it } from 'vitest'
+import {
+  computeFitScale, DESIGN_H, DESIGN_W, MIN_SCALE, Presentation, STAGE_LAYOUT, stageInsets,
+} from '../../src/presentation-kit'
+import { FOUR, setViewport } from '../helpers/fixtures'
+
+const canvas = () => document.querySelector('[data-presentation-canvas]') as HTMLElement
+const scaleOf = () => Number(/scale\(([^)]+)\)/.exec(canvas().style.transform)![1])
+
+beforeEach(() => setViewport(1440, 900))
+
+describe('default canvas', () => {
+  it('is 880 x 380', () => {
+    expect([DESIGN_W, DESIGN_H]).toEqual([880, 380])
+    render(<Presentation steps={FOUR} title="t" />)
+    expect([canvas().style.width, canvas().style.height]).toEqual(['880px', '380px'])
+  })
+
+  it('honours an overridden canvas for both geometry and fit math', () => {
+    render(<Presentation steps={FOUR} title="t" designWidth={400} designHeight={200} />)
+    expect([canvas().style.width, canvas().style.height]).toEqual(['400px', '200px'])
+    const expected = computeFitScale({ viewportWidth: 1440, viewportHeight: 900, mode: 'browse', designWidth: 400, designHeight: 200 })
+    expect(scaleOf()).toBeCloseTo(expected, 5)
+    expect(expected).not.toBeCloseTo(computeFitScale({ viewportWidth: 1440, viewportHeight: 900, mode: 'browse' }), 3)
+  })
+})
+
+describe('fit math', () => {
+  it('uses one uniform factor limited by the tighter axis', () => {
+    const { top, bottom, side } = stageInsets('browse', 1440)
+    const w = (1440 - 2 * side) / DESIGN_W
+    const h = (900 - top - bottom) / DESIGN_H
+    expect(computeFitScale({ viewportWidth: 1440, viewportHeight: 900, mode: 'browse' })).toBeCloseTo(Math.min(w, h), 10)
+    // a very wide viewport is height-limited
+    expect(computeFitScale({ viewportWidth: 4000, viewportHeight: 700, mode: 'browse' })).toBeCloseTo((700 - top - bottom) / DESIGN_H, 10)
+  })
+
+  it('never drops below MIN_SCALE', () => {
+    expect(computeFitScale({ viewportWidth: 50, viewportHeight: 50, mode: 'present' })).toBe(MIN_SCALE)
+  })
+
+  it('uses each mode\'s stage geometry (table of contents widens the browse side inset)', () => {
+    expect(stageInsets('browse', 1440)).toEqual({ top: STAGE_LAYOUT.browse.top, bottom: STAGE_LAYOUT.browse.bottom, side: STAGE_LAYOUT.browse.tocSide })
+    expect(stageInsets('browse', 600).side).toBe(STAGE_LAYOUT.browse.side)
+    expect(stageInsets('present', 1440)).toEqual({ top: STAGE_LAYOUT.present.top, bottom: STAGE_LAYOUT.present.bottom, side: STAGE_LAYOUT.present.side })
+    const browse = computeFitScale({ viewportWidth: 1440, viewportHeight: 900, mode: 'browse' })
+    const present = computeFitScale({ viewportWidth: 1440, viewportHeight: 900, mode: 'present' })
+    expect(present).toBeGreaterThan(browse)
+  })
+})
+
+describe('scaled stage', () => {
+  it('keeps the scale identical for every step at a fixed viewport and mode', () => {
+    render(<Presentation steps={FOUR} title="t" />)
+    const first = scaleOf()
+    for (let i = 0; i < 3; i++) {
+      fireEvent.keyDown(window, { key: 'ArrowRight' })
+      expect(scaleOf()).toBe(first)
+    }
+  })
+
+  it('recomputes uniformly on resize without changing the internal canvas', () => {
+    render(<Presentation steps={FOUR} title="t" />)
+    const before = scaleOf()
+    act(() => setViewport(1000, 700))
+    const after = scaleOf()
+    expect(after).not.toBe(before)
+    expect(after).toBeCloseTo(computeFitScale({ viewportWidth: 1000, viewportHeight: 700, mode: 'browse' }), 10)
+    expect([canvas().style.width, canvas().style.height]).toEqual(['880px', '380px'])
+    expect(canvas().style.transform).toBe(`scale(${after})`) // a single uniform factor
+  })
+
+  it('recomputes from the new mode geometry on mode change', () => {
+    render(<Presentation steps={FOUR} title="t" />)
+    const browse = scaleOf()
+    fireEvent.keyDown(window, { key: 'p' })
+    expect(scaleOf()).toBeCloseTo(computeFitScale({ viewportWidth: 1440, viewportHeight: 900, mode: 'present' }), 10)
+    expect(scaleOf()).not.toBe(browse)
+  })
+})
