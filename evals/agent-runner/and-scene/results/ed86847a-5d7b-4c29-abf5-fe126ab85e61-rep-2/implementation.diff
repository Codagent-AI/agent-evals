+    fireEvent.keyDown(window, { key: 'ArrowRight' }) // across eras
+    expect(active('[data-presentation-toc-entry]')).toEqual([false, true, false])
+    expect(inert('[data-presentation-progress-item]')).toEqual([true, true, false, true])
