diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..de81526d90cc22ee4544bd46ef72eded42848b65
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,131 @@
+#!/usr/bin/env node
+// Captures one settled screenshot per step of a registered presentation from a
+// production preview on 127.0.0.1, and prints advisory visual warnings.
+// Warnings never fail the run; only operational failures exit non-zero.
+import { mkdir, writeFile } from 'node:fs/promises'
+import path from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { runBuild, tail } from './lib/build.mjs'
+import { collectSnapshot } from './lib/collect.mjs'
+import { diagnose, settle } from './lib/diagnostics.mjs'
+import { freePort, HOST, startPreview, waitForReady } from './lib/preview.mjs'
+
+export const DEFAULT_SETTLE_MS = 900
+export const DEFAULT_VIEWPORT = { width: 1440, height: 900 }
+
+export class InspectionError extends Error {}
+
+async function build(root) {
+  const { code, output } = await runBuild(root)
+  if (code !== 0) throw new InspectionError(`npm run build exited with code ${code}\n${tail(output)}`)
+}
+
+const realDeps = {
+  build,
+  freePort,
+  startPreview,
+  waitForReady,
+  launchBrowser: async () => (await import('playwright')).chromium.launch(),
+  mkdir: (dir) => mkdir(dir, { recursive: true }),
+  writeFile,
+  settle,
+  log: console.log,
+}
+
+export function stepFile(outDir, index) {
+  return path.join(outDir, `step-${String(index + 1).padStart(2, '0')}.png`)
+}
+
+export async function inspect(options, deps = realDeps) {
+  const { root = process.cwd(), slug, settleMs = DEFAULT_SETTLE_MS, viewport = DEFAULT_VIEWPORT, build = true, port } = options
+  if (!slug) throw new InspectionError('usage: inspect-presentation <slug> [--settle ms] [--viewport WxH] [--no-build]')
+  const custom = viewport.width !== DEFAULT_VIEWPORT.width || viewport.height !== DEFAULT_VIEWPORT.height
+  const outDir = options.outDir ?? path.join(root, 'inspection', custom ? `${slug}-${viewport.width}x${viewport.height}` : slug)
+
+  if (build) await deps.build(root)
+  let preview
+  let browser
+  try {
+    const p = port ?? (await deps.freePort())
+    try {
+      preview = await deps.startPreview(root, p)
+      await deps.waitForReady(`${preview.origin}/`)
+    } catch (err) {
+      throw new InspectionError(`could not start the production preview on ${HOST}: ${err.message}`)
+    }
+    try {
+      browser = await deps.launchBrowser()
+    } catch (err) {
+      throw new InspectionError(`could not launch Chromium: ${err.message}`)
+    }
+    const page = await browser.newPage({ viewport })
+    const url = `${preview.origin}/${slug}`
+    try {
+      await page.goto(url, { waitUntil: 'load' })
+      await page.waitForSelector('[data-step-count]', { timeout: 10000 })
+    } catch (err) {
+      throw new InspectionError(`route ${url} did not render a presentation: ${err.message}`)
+    }
+    const count = Number(await page.getAttribute('[data-step-count]', 'data-step-count'))
+    await deps.mkdir(outDir)
+
+    const report = { slug, url, viewport, settleMs, steps: [], warnings: [] }
+    for (let i = 0; i < count; i++) {
+      if (i > 0) {
+        await page.keyboard.press('ArrowRight')
+        try {
+          await page.waitForFunction((n) => document.querySelector('[data-step-index]')?.getAttribute('data-step-index') === String(n), i, { timeout: 4000 })
+        } catch {
+          throw new InspectionError(`ArrowRight from index ${i - 1} did not advance data-step-index to ${i}; refusing to capture a repeated step`)
+        }
+      }
+      const elapsedMs = await deps.settle(settleMs)
+      const snapshot = await page.evaluate(collectSnapshot)
+      if (snapshot.index !== i) throw new InspectionError(`expected step index ${i} at capture but the page shows ${snapshot.index}`)
+      const file = stepFile(outDir, i)
+      try {
+        await page.screenshot({ path: file })
+      } catch (err) {
+        throw new InspectionError(`could not write screenshot ${file}: ${err.message}`)
+      }
+      const warnings = diagnose(snapshot)
+      report.steps.push({ index: i, file, elapsedMs, runningAnimationsAtCapture: snapshot.runningAnimations, warnings: warnings.length })
+      report.warnings.push(...warnings)
+    }
+    await deps.writeFile(path.join(outDir, 'report.json'), JSON.stringify(report, null, 2))
+    for (const w of report.warnings) deps.log(`WARN ${w}`)
+    deps.log(`INSPECT ${slug}: ${count} screenshot(s) in ${outDir}; ${report.warnings.length} advisory warning(s)`)
+    return report
+  } finally {
+    await browser?.close().catch(() => {})
+    await preview?.close().catch(() => {})
+  }
+}
+
+export function parseArgs(argv) {
+  const opts = { build: true }
+  for (let i = 0; i < argv.length; i++) {
+    const a = argv[i]
+    if (a === '--no-build') opts.build = false
+    else if (a === '--settle') opts.settleMs = Number(argv[++i])
+    else if (a === '--port') opts.port = Number(argv[++i])
+    else if (a === '--out') opts.outDir = path.resolve(argv[++i])
+    else if (a === '--viewport') {
+      const [width, height] = argv[++i].split('x').map(Number)
+      opts.viewport = { width, height }
+    } else if (!a.startsWith('--')) opts.slug = a
+  }
+  return opts
+}
+
+async function main() {
+  try {
+    await inspect(parseArgs(process.argv.slice(2)))
+    process.exit(0)
+  } catch (err) {
+    console.error(`FAIL [inspect] ${err.message}`)
+    process.exit(1)
+  }
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) await main()
diff --git a/scripts/lib/build.mjs b/scripts/lib/build.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0d1f2a99c92908e9470654afcd21452622cf5189
--- /dev/null
+++ b/scripts/lib/build.mjs
@@ -0,0 +1,15 @@
+import { spawn } from 'node:child_process'
+
+/** Run `npm run build` in `root`, resolving with the exit code and combined output. */
+export function runBuild(root) {
+  return new Promise((resolve, reject) => {
+    const child = spawn('npm', ['run', 'build'], { cwd: root, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (d) => (output += d))
+    child.stderr.on('data', (d) => (output += d))
+    child.on('error', reject)
+    child.on('close', (code) => resolve({ code, output }))
+  })
+}
+
+export const tail = (output, lines = 30) => output.trim().split('\n').slice(-lines).join('\n')
diff --git a/scripts/lib/collect.mjs b/scripts/lib/collect.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8e59eda3c03edc662c108dede0a6de847ea81c31
--- /dev/null
+++ b/scripts/lib/collect.mjs
@@ -0,0 +1,91 @@
+/**
+ * Runs inside the page. Collects visible text/chrome boxes and styles for the
+ * advisory diagnostics. Kept dependency-free so it can be serialized.
+ */
+export function collectSnapshot() {
+  const ALLOW = 'data-presentation-allow-overlap'
+  const CHROME = [
+    '[data-presentation-marker]', '[data-presentation-era]', '[data-presentation-title]',
+    '[data-presentation-caption]', '[data-presentation-progress-item]', '[data-presentation-prev]',
+    '[data-presentation-next]', '[data-presentation-toc-entry]', '[data-presentation-mode-toggle]',
+    '[data-presentation-attribution]',
+  ].join(',')
+
+  const describe = (el) => {
+    const hook = [...el.attributes].find((a) => a.name.startsWith('data-presentation-') && a.value !== '' && !/^(active|step|scale)/.test(a.name.slice(18)))
+    const tag = el.tagName.toLowerCase()
+    const suffix = hook ? `[${hook.name}="${hook.value}"]` : [...el.attributes].filter((a) => a.name.startsWith('data-presentation-')).map((a) => `[${a.name}]`).slice(0, 1).join('')
+    const text = (el.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 40)
+    return `${tag}${suffix}${text ? ` "${text}"` : ''}`
+  }
+  const visible = (el) => {
+    const cs = getComputedStyle(el)
+    if (cs.visibility === 'hidden' || cs.display === 'none') return false
+    for (let n = el; n && n !== document.documentElement; n = n.parentElement) {
+      if (Number(getComputedStyle(n).opacity) < 0.05) return false
+    }
+    return true
+  }
+  const textRect = (el) => {
+    const range = document.createRange()
+    let rect = null
+    for (const node of el.childNodes) {
+      if (node.nodeType !== Node.TEXT_NODE || !node.textContent.trim()) continue
+      range.selectNodeContents(node)
+      for (const r of range.getClientRects()) {
+        rect = rect
+          ? { left: Math.min(rect.left, r.left), top: Math.min(rect.top, r.top), right: Math.max(rect.right, r.right), bottom: Math.max(rect.bottom, r.bottom) }
+          : { left: r.left, top: r.top, right: r.right, bottom: r.bottom }
+      }
+    }
+    return rect
+  }
+
+  const candidates = new Set(document.querySelectorAll(CHROME))
+  for (const el of document.body.querySelectorAll('*')) {
+    if ([...el.childNodes].some((n) => n.nodeType === Node.TEXT_NODE && n.textContent.trim())) candidates.add(el)
+  }
+  const list = [...candidates].filter((el) => visible(el))
+  const keys = new Map(list.map((el, i) => [el, i]))
+  const items = []
+  for (const el of list) {
+    const own = textRect(el)
+    const b = el.getBoundingClientRect()
+    const rect = own ?? { left: b.left, top: b.top, right: b.right, bottom: b.bottom }
+    if (rect.right - rect.left <= 0 || rect.bottom - rect.top <= 0) continue
+    const ancestors = []
+    for (let n = el.parentElement; n; n = n.parentElement) if (keys.has(n)) ancestors.push(keys.get(n))
+    items.push({ key: keys.get(el), label: describe(el), rect, allowed: !!el.closest(`[${ALLOW}]`), ancestors })
+  }
+
+  const style = (el) => {
+    const cs = getComputedStyle(el)
+    // Text-bearing controls differ in size just because their labels differ.
+    const sized = (el.textContent || '').trim() === ''
+    return {
+      color: cs.color, backgroundColor: cs.backgroundColor, borderColor: cs.borderTopColor,
+      borderWidth: cs.borderTopWidth, opacity: cs.opacity, fontWeight: cs.fontWeight,
+      transform: cs.transform, width: sized ? cs.width : '', height: sized ? cs.height : '',
+    }
+  }
+  const chromeGroup = (name, selector) => {
+    const all = [...document.querySelectorAll(selector)]
+    const active = all.find((el) => el.getAttribute('data-presentation-active') === 'true')
+    const inactive = all.find((el) => el !== active)
+    return { name, active: active && inactive ? style(active) : null, inactive: active && inactive ? style(inactive) : null }
+  }
+  const attr = document.querySelector('[data-presentation-attribution]')
+  const acs = attr && getComputedStyle(attr)
+  const root = document.querySelector('[data-step-index]')
+  return {
+    index: Number(root?.getAttribute('data-step-index') ?? -1),
+    title: document.querySelector('[data-presentation-title]')?.textContent ?? '',
+    items,
+    activeChrome: [
+      chromeGroup('progress indicator', '[data-presentation-progress-item]'),
+      chromeGroup('table-of-contents entry', '[data-presentation-toc-entry]'),
+    ],
+    attribution: attr ? { fontSize: parseFloat(acs.fontSize), color: acs.color, textDecorationLine: acs.textDecorationLine } : null,
+    runningAnimations: document.getAnimations().filter((a) => a.playState === 'running').length,
+  }
+}
diff --git a/scripts/lib/diagnostics.mjs b/scripts/lib/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e2d00a2815533833b2ade10f29b68500a84c73ed
--- /dev/null
+++ b/scripts/lib/diagnostics.mjs
@@ -0,0 +1,77 @@
+// Advisory visual diagnostics. Pure functions over data collected from the page.
+
+export const MIN_ATTRIBUTION_PX = 11
+export const ALLOW_OVERLAP_ATTR = 'data-presentation-allow-overlap'
+
+export function rectsOverlap(a, b, tolerance = 0.5) {
+  const w = Math.min(a.right, b.right) - Math.max(a.left, b.left)
+  const h = Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top)
+  return w > tolerance && h > tolerance
+}
+
+/**
+ * items: [{ label, rect, allowed, ancestors: [labels of ancestor items] }]
+ * Items inside an allow-overlap subtree are exempt; ancestor/descendant pairs
+ * never collide with each other.
+ */
+export function findOverlaps(items) {
+  const found = []
+  for (let i = 0; i < items.length; i++) {
+    for (let j = i + 1; j < items.length; j++) {
+      const a = items[i]
+      const b = items[j]
+      if (a.allowed || b.allowed) continue
+      if (a.ancestors.includes(b.key) || b.ancestors.includes(a.key)) continue
+      if (rectsOverlap(a.rect, b.rect)) found.push([a, b])
+    }
+  }
+  return found
+}
+
+const STYLE_KEYS = ['color', 'backgroundColor', 'borderColor', 'borderWidth', 'opacity', 'fontWeight', 'transform', 'width', 'height']
+
+/** True when the active control looks the same as an inactive sibling. */
+export function isIndistinct(active, inactive) {
+  return STYLE_KEYS.every((k) => active[k] === inactive[k])
+}
+
+const BROWSER_LINK = 'rgb(0, 0, 238)'
+
+/** Returns a reason string when the attribution looks unpolished, else null. */
+export function attributionIssue(attr) {
+  if (!attr) return 'attribution link is missing'
+  if (attr.fontSize < MIN_ATTRIBUTION_PX) return `attribution text is ${attr.fontSize}px (under ${MIN_ATTRIBUTION_PX}px)`
+  if (attr.color === BROWSER_LINK && /underline/.test(attr.textDecorationLine)) {
+    return 'attribution uses the browser-default link styling'
+  }
+  return null
+}
+
+/**
+ * Settle helper: resolves after `settleMs` using the injected sleep, returning
+ * the elapsed time as measured by the injected clock.
+ */
+export async function settle(settleMs, { sleep = (ms) => new Promise((r) => setTimeout(r, ms)), now = () => Date.now() } = {}) {
+  const start = now()
+  await sleep(settleMs)
+  return now() - start
+}
+
+/** Turn a step snapshot into advisory warning lines. */
+export function diagnose(step) {
+  const warnings = []
+  const where = `step ${step.index + 1}${step.title ? ` (${step.title})` : ''}`
+  for (const [a, b] of findOverlaps(step.items)) {
+    warnings.push(`[overlap] ${where}: ${a.label} overlaps ${b.label}; mark an intentional readable overlap with ${ALLOW_OVERLAP_ATTR}`)
+  }
+  for (const group of step.activeChrome) {
+    if (group.active && group.inactive && isIndistinct(group.active, group.inactive)) {
+      warnings.push(`[active-chrome] ${where}: active ${group.name} is visually indistinct from inactive ${group.name}; style [data-presentation-active="true"]`)
+    }
+  }
+  const issue = attributionIssue(step.attribution)
+  if (issue) {
+    warnings.push(`[attribution] ${where}: ${issue}; style the [data-presentation-attribution] hook`)
+  }
+  return warnings
+}
