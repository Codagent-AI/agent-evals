+    // reorder
+    rerender(<Presentation steps={[FOUR[3], FOUR[2], FOUR[1]]} title="t" />)
+    expect(screen.getByLabelText('Step 1: Title d')).toBeTruthy()
+    expect(screen.getByLabelText('Step 3: Title b')).toBeTruthy()
+  })
+})
+
+describe('present mode', () => {
