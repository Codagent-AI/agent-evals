+            <Label id="l" x={1} y={2}>l</Label>
+            <Frame id="f" x={0} y={0} width={5} height={5} />
+            <Emphasis id="e" x={0} y={0} width={5} height={5} />
+            <SymbolChip id="s" x={0} y={0}>s</SymbolChip>
+            <Arrow id="ar" from={{ x: 0, y: 0 }} to={{ x: 9, y: 9 }} bidirectional />
