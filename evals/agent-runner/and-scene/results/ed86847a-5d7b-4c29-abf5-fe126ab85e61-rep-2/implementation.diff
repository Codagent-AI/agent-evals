+  })
+
+  it('animates a departing entity out before removing it (grouped)', async () => {
+    render(<Presentation steps={[ent('a', ['x', 'y'], ['x', 'y'], 'g'), ent('b', ['x'], [], 'g')]} title="t" />)
+    const y = screen.getByTestId('e-y')
