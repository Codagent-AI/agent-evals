+                aria-current={active ? 'step' : undefined}
+                onClick={() => onSelect(entry.firstIndex)}
+              >
+                {entry.era}
+              </button>
+            </li>
+          )
+        })}
+      </ol>
+    </nav>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/eras.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/eras.ts
