@@ -0,0 +1,89 @@
+import { useEffect, useState, type ReactNode } from 'react'
+import { WIDE_BREAKPOINT } from './constants'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { erasOf } from './chrome/eras'
+import { Stage } from './Stage'
+import { usePresentationNav } from './usePresentationNav'
+import type { CanvasSize, Mode, Step } from './types'
+
+export interface PresentationProps<TPayload> {
+  title: string
+  steps: Step<TPayload>[]
+  initialMode?: Mode
+  brand?: ReactNode
+  /** Overrides the default design canvas; omitted fields keep the per-mode default. */
+  design?: Partial<CanvasSize>
+  /** Omits the default bottom-right attribution link. */
+  hideAttribution?: boolean
+}
+
+const WIDE_QUERY = `(min-width: ${WIDE_BREAKPOINT}px)`
+
+function canMatchMedia(): boolean {
+  return typeof window !== 'undefined' && typeof window.matchMedia === 'function'
+}
+
+/** Tracks whether the viewport is at or above the wide breakpoint. */
+function useIsWide(): boolean {
+  const [wide, setWide] = useState(() => canMatchMedia() && window.matchMedia(WIDE_QUERY).matches)
+
+  useEffect(() => {
+    if (!canMatchMedia()) return
+    const query = window.matchMedia(WIDE_QUERY)
+    const update = () => setWide(query.matches)
+    update()
+    query.addEventListener('change', update)
+    return () => query.removeEventListener('change', update)
+  }, [])
+
+  return wide
+}
+
+/** A complete presentation: the active step on the scene stage with present/browse chrome. */
+export function Presentation<TPayload>({
+  title,
+  steps,
+  initialMode,
+  brand,
+  design,
+  hideAttribution,
+}: PresentationProps<TPayload>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const wide = useIsWide()
+  const step = steps[nav.index]
+  // The index before the most recent change. Updated during render, so no effect is needed.
+  const [history, setHistory] = useState({ current: nav.index, previous: nav.index })
+  let previousIndex = history.previous
+  if (history.current !== nav.index) {
+    previousIndex = history.current
+    setHistory({ current: nav.index, previous: previousIndex })
+  }
+  const previous = steps[Math.min(previousIndex, steps.length - 1)]
+  const eras = erasOf(steps)
+  const marker = `${String(nav.index + 1).padStart(2, '0')} · ${step.era}`
+
+  return (
+    <div
+      data-presentation-root=""
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      style={{ position: 'relative', display: 'flex', flexDirection: 'column', minHeight: '100dvh' }}
+    >
+      <Header mode={nav.mode} deckTitle={title} marker={marker} brand={brand} />
+      <Stage step={step} previous={previous} mode={nav.mode} design={design} />
+      <Footer
+        mode={nav.mode}
+        steps={steps}
+        index={nav.index}
+        eras={eras}
+        wide={wide}
+        onGoTo={nav.goTo}
+        onPrev={nav.prev}
+        onNext={nav.next}
+        showAttribution={!hideAttribution}
+      />
+    </div>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..bdf1feba45f926f0e78f340656de2e21e7791343
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
@@ -0,0 +1,78 @@
+import { useMemo, useRef } from 'react'
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { EASE, LAYOUT_T, STAGE_LAYOUT } from './constants'
+import { useFitScale } from './useFitScale'
+import type { CanvasSize, Mode, Step } from './types'
+
+export interface StageProps<TPayload> {
+  step: Step<TPayload>
+  previous?: Step<TPayload>
+  mode: Mode
+  design?: Partial<CanvasSize>
+}
+
+const sceneIds = new WeakMap<object, number>()
+let nextSceneId = 0
+
+/** A stable number per Scene component, so a different Scene is a different scene instance. */
+function sceneId(Scene: object): number {
+  let id = sceneIds.get(Scene)
+  if (id === undefined) {
+    nextSceneId += 1
+    id = nextSceneId
+    sceneIds.set(Scene, id)
+  }
+  return id
+}
+
+/**
+ * Mounts the active step's Scene on the fixed design canvas. Steps that share a
+ * groupKey keep the same keyed element, so the scene instance persists and only
+ * its payload changes. Ungrouped steps get their own key, so AnimatePresence
+ * cross-fades them while shared layoutIds morph.
+ */
+export function Stage<TPayload>({ step, previous, mode, design }: StageProps<TPayload>) {
+  const ref = useRef<HTMLDivElement>(null)
+  const preset = STAGE_LAYOUT[mode]
+  const width = design?.width ?? preset.width
+  const height = design?.height ?? preset.height
+  const geometry = useMemo(() => ({ ...preset, width, height }), [preset, width, height])
+  const scale = useFitScale(ref, geometry)
+  const { Scene } = step
+  const sceneKey = `${step.groupKey ? `group:${step.groupKey}` : `step:${step.id}`}:scene${sceneId(Scene)}`
+
+  return (
+    <div
+      ref={ref}
+      data-presentation-stage
+      style={{ position: 'relative', flex: 1, minHeight: 0, overflow: 'hidden' }}
+    >
+      <div
+        data-presentation-canvas
+        style={{
+          position: 'absolute',
+          left: '50%',
+          top: '50%',
+          width: geometry.width,
+          height: geometry.height,
+          transform: `translate(-50%, -50%) scale(${scale})`,
+          transformOrigin: 'center',
+        }}
+      >
+        <LayoutGroup>
+          <AnimatePresence>
+            <motion.div
+              key={sceneKey}
+              data-presentation-scene
+              style={{ position: 'absolute', inset: 0 }}
+              exit={{ opacity: 0 }}
+              transition={{ duration: LAYOUT_T, ease: EASE }}
+            >
+              <Scene payload={step.payload} previous={previous?.payload} />
+            </motion.div>
+          </AnimatePresence>
+        </LayoutGroup>
+      </div>
+    </div>
+  )
+}
