+// @vitest-environment jsdom
+import { describe, expect, it, vi } from 'vitest'
+import { act, fireEvent, render, renderHook } from '@testing-library/react'
+import { useRef } from 'react'
+import { computeFitScale, useFitScale } from '../../src/presentation-kit/useFitScale'
+import { DESIGN_H, DESIGN_W, ENTER_DELAY, LAYOUT_T, MIN_SCALE, STAGE_LAYOUT, WIDE_BREAKPOINT } from '../../src/presentation-kit/constants'
+import { Presentation } from '../../src/presentation-kit'
+import { makeSteps, stubMatchMedia, stubViewport } from './fixtures'
+
+describe('canvas and timing constants', () => {
+  it('the default design canvas is 880 × 380', () => {
+    expect(DESIGN_W).toBe(880)
+    expect(DESIGN_H).toBe(380)
+  })
+
+  it('newcomers start after the persisting-entity layout motion has finished', () => {
+    expect(ENTER_DELAY).toBeGreaterThanOrEqual(LAYOUT_T)
+  })
+
+  it('each mode has its own fit geometry on the default canvas', () => {
+    expect(STAGE_LAYOUT.browse.width).toBe(DESIGN_W)
+    expect(STAGE_LAYOUT.present.height).toBe(DESIGN_H)
+    expect(STAGE_LAYOUT.browse.padding).not.toBe(STAGE_LAYOUT.present.padding)
+  })
+
+  it('the wide breakpoint separates the 1280 px desktop inspection width from 390 px', () => {
+    expect(1280).toBeGreaterThanOrEqual(WIDE_BREAKPOINT)
+    expect(390).toBeLessThan(WIDE_BREAKPOINT)
+  })
+})
+
+describe('computeFitScale', () => {
+  const geometry = { width: DESIGN_W, height: DESIGN_H, padding: 0 }
+
+  it('is limited by width when the box is wide and short enough', () => {
+    expect(computeFitScale({ width: 1000, height: 1000 }, geometry)).toBeCloseTo(1000 / 880)
+  })
+
+  it('is limited by height when the box is tall and narrow enough', () => {
+    expect(computeFitScale({ width: 2000, height: 190 }, geometry)).toBeCloseTo(0.5)
+  })
+
+  it('never drops below MIN_SCALE', () => {
+    expect(computeFitScale({ width: 10, height: 10 }, geometry)).toBe(MIN_SCALE)
+  })
+
+  it('subtracts the mode padding from the available box', () => {
+    const padded = computeFitScale({ width: 1000, height: 1000 }, { ...geometry, padding: 50 })
+    expect(padded).toBeCloseTo(900 / 880)
+  })
+
+  it('scales the same way in both modes given the same box', () => {
+    const box = { width: 900, height: 400 }
+    const browse = computeFitScale(box, STAGE_LAYOUT.browse)
+    const present = computeFitScale(box, STAGE_LAYOUT.present)
+    expect(browse).toBeLessThanOrEqual(present)
+  })
+})
+
+describe('useFitScale', () => {
+  it('recomputes the uniform scale on resize and holds it across steps at a fixed box', () => {
+    const rect = { width: 1100, height: 600 }
+    const spy = spyRect(rect)
+    stubMatchMedia(true)
+    const { result } = renderHook(() => {
+      const ref = useRef<HTMLDivElement>(document.createElement('div'))
+      return useFitScale(ref, STAGE_LAYOUT.browse)
+    })
+    const first = result.current
+    rect.width = 550
+    act(() => {
+      window.dispatchEvent(new Event('resize'))
+    })
+    expect(result.current).toBeLessThan(first)
+    spy.mockRestore()
+  })
+
+  it('the table of contents appears at or above the breakpoint and is absent just below it', () => {
+    const { container, unmount } = render(<Presentation title="t" steps={makeSteps()} />)
+    for (const [width, expected] of [[899, false], [900, true], [1280, true], [390, false]] as const) {
+      unmount()
+      stubViewport(width)
+      const view = render(<Presentation title="t" steps={makeSteps()} />)
+      expect(view.container.querySelector('[data-presentation-toc]') !== null, `width ${width}`).toBe(expected)
+      for (const hook of ['[data-presentation-caption]', '[data-presentation-prev]', '[data-presentation-progress]']) {
+        expect(view.container.querySelector(hook), `${hook} at ${width}`).not.toBeNull()
+      }
+      view.unmount()
+    }
+    expect(container).toBeDefined()
+  })
+
+  it('the scale stays the same across steps at a fixed viewport and mode', () => {
+    stubViewport(1280)
+    const spy = vi.spyOn(HTMLElement.prototype, 'getBoundingClientRect').mockReturnValue({
+      x: 0, y: 0, top: 0, left: 0, right: 1100, bottom: 600, width: 1100, height: 600, toJSON: () => ({}),
+    } as DOMRect)
+    const { container } = render(<Presentation title="t" steps={makeSteps()} />)
+    const scaleOf = () => (container.querySelector('[data-presentation-canvas]') as HTMLElement).style.transform
+    const first = scaleOf()
+    fireEvent.click(container.querySelector('[data-presentation-next]')!)
+    fireEvent.click(container.querySelector('[data-presentation-next]')!)
+    expect(scaleOf()).toBe(first)
+    spy.mockRestore()
+  })
+
+  it('a presentation can override the design canvas, and omitted fields keep the mode default', () => {
+    stubViewport(1280)
+    const { container } = render(<Presentation title="t" steps={makeSteps()} design={{ width: 640 }} />)
+    const canvas = container.querySelector('[data-presentation-canvas]') as HTMLElement
+    expect(canvas.style.width).toBe('640px')
+    expect(canvas.style.height).toBe(`${DESIGN_H}px`)
+  })
+
+  it('Presentation applies the stage scale to the canvas via a single uniform transform', () => {
+    stubMatchMedia(true)
+    const { container } = render(<Presentation title="t" steps={makeSteps()} />)
+    const canvas = container.querySelector('[data-presentation-canvas]') as HTMLElement
+    expect(canvas.style.width).toBe(`${DESIGN_W}px`)
+    expect(canvas.style.height).toBe(`${DESIGN_H}px`)
+    expect(canvas.style.transform).toMatch(/^translate\(-50%, -50%\) scale\(/)
+  })
+})
+
+/** Makes every element report the given box size, so the fit hook sees a known viewport. */
+function spyRect(rect: { width: number; height: number }) {
+  return vi.spyOn(HTMLElement.prototype, 'getBoundingClientRect').mockImplementation(
+    () =>
+      ({
+        x: 0,
+        y: 0,
+        top: 0,
+        left: 0,
+        right: rect.width,
+        bottom: rect.height,
+        width: rect.width,
+        height: rect.height,
+        toJSON: () => ({}),
+      }) as DOMRect,
+  )
+}
diff --git a/tests/unit/layout-id.test.tsx b/tests/unit/layout-id.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..51bfd131711080298245ec5427b30ddbe3c29e76
--- /dev/null
+++ b/tests/unit/layout-id.test.tsx
@@ -0,0 +1,127 @@
+// @vitest-environment jsdom
+import { createElement, type ReactNode } from 'react'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { fireEvent, render } from '@testing-library/react'
+import { EXIT, LAYOUT_T, LAYOUT_TRANSITION } from '../../src/presentation-kit/constants'
+import { Presentation, Box, Label, Arrow, Frame, Emphasis, SymbolChip, SceneLayer } from '../../src/presentation-kit'
+import { stubViewport } from './fixtures'
+import { STEPS } from '../../src/presentations/how-to-make-a-presentation/steps'
+import { Diagram } from '../../src/presentations/how-to-make-a-presentation/scene'
+import type { DiagramState } from '../../src/presentations/how-to-make-a-presentation/entities'
+import { motion } from 'motion/react'
+
+// Records the props each motion element receives, and renders a plain element that keeps the
+// author-visible props (className, style, data-*, children). Motion-only props are dropped.
+// AnimatePresence stays real; these tests check props and DOM structure, not animation.
+const received: Array<Record<string, unknown>> = []
+const MOTION_ONLY = new Set(['layout', 'layoutId', 'transition', 'initial', 'animate', 'exit', 'rotate'])
+
+vi.mock('motion/react', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('motion/react')>()
+  const div = (props: Record<string, unknown>) => {
+    received.push(props)
+    const visible = Object.fromEntries(Object.entries(props).filter(([key]) => !MOTION_ONLY.has(key)))
+    return createElement('div', visible as Record<string, unknown>, props.children as ReactNode)
+  }
+  return { ...actual, motion: new Proxy(actual.motion, { get: (target, key) => (key === 'div' ? div : Reflect.get(target, key)) }) }
+})
+
+beforeEach(() => {
+  received.length = 0
+})
+
+function propsFor(predicate: (props: Record<string, unknown>) => boolean) {
+  return received.filter(predicate)
+}
+
+describe('primitives pass layoutId, a layout transition, and an exit to motion', () => {
+  it.each([
+    ['Box', <Box key="x" id="x" />],
+    ['Label', <Label key="x" id="x" />],
+    ['Arrow', <Arrow key="x" id="x" x={0} y={0} length={10} />],
+    ['Frame', <Frame key="x" id="x" geometry={{ x: 0, y: 0, w: 1, h: 1 }} />],
+    ['Emphasis', <Emphasis key="x" id="x" />],
+    ['SymbolChip', <SymbolChip key="x" id="x" />],
+  ])('%s keeps its stable id as layoutId, morphs for LAYOUT_T, and exits by fading out', (_name, element) => {
+    render(<SceneLayer>{element}</SceneLayer>)
+    const [props] = propsFor((p) => p.layoutId === 'x')
+    expect(props).toBeDefined()
+    expect(props.layout).toBe(true)
+    expect((props.transition as { layout: { duration: number } }).layout.duration).toBe(LAYOUT_T)
+    expect((props.transition as { layout: unknown }).layout).toBe(LAYOUT_TRANSITION)
+    expect(props.exit).toBe(EXIT)
+    expect((props.exit as { opacity: number }).opacity).toBe(0)
+    expect((props.exit as { transition: { duration: number } }).transition.duration).toBe(LAYOUT_T)
+  })
+})
+
+describe('newcomers are classified against the previous step, forward and backward', () => {
+  const payloadOf = (i: number): DiagramState => STEPS[i].payload
+
+  /** Which entity ids are wrapped in Appear when `payload` is shown after `previous`. */
+  function wrappedIds(payload: DiagramState, previous?: DiagramState) {
+    const { container, unmount } = render(<Diagram payload={payload} previous={previous} />)
+    const result = payload.visible.map((id) => {
+      const node = container.querySelector(`[data-presentation-id="${id}"]`)
+      return { id, wrapped: node!.closest('[data-presentation-appear]') !== null }
+    })
+    unmount()
+    return result
+  }
+
+  it('forward: an id visible in the previous step is outside Appear, and a new id is inside it', () => {
+    for (let i = 1; i < STEPS.length; i += 1) {
+      const previous = new Set(payloadOf(i - 1).visible)
+      for (const { id, wrapped } of wrappedIds(payloadOf(i), payloadOf(i - 1))) {
+        expect(wrapped, `forward to step ${i + 1}, ${id}`).toBe(!previous.has(id))
+      }
+    }
+  })
+
+  it('backward: going from a later step back to an earlier one wraps nothing that was already on screen', () => {
+    for (let i = STEPS.length - 1; i >= 1; i -= 1) {
+      for (const { id, wrapped } of wrappedIds(payloadOf(i - 1), payloadOf(i))) {
+        expect(wrapped, `backward to step ${i}, ${id}`).toBe(false)
+      }
+    }
+  })
+
+  it('a transition with no newcomers renders no Appear wrapper at all', () => {
+    const payload = { visible: ['you', 'prompt'], emphasized: [] }
+    const { container } = render(<Diagram payload={payload} previous={payload} />)
+    expect(container.querySelectorAll('[data-presentation-appear]')).toHaveLength(0)
+  })
+})
+
+describe('coordinate-heavy diagrams with a raw motion element', () => {
+  it('a raw motion element keeps its layoutId, and its author coordinates update within one grouped scene', () => {
+    stubViewport(1280)
+    function Dot({ payload }: { payload: { x: number } }) {
+      return createElement(
+        SceneLayer,
+        null,
+        createElement(motion.div, {
+          layoutId: 'dot',
+          'data-presentation-id': 'dot',
+          style: { position: 'absolute', left: payload.x, top: 10 },
+        }),
+      )
+    }
+    const steps = [0, 300].map((x, i) => ({
+      id: `s${i}`,
+      era: 'e',
+      title: `t${i}`,
+      caption: `c${i}`,
+      groupKey: 'dots',
+      Scene: Dot as never,
+      payload: { x },
+    }))
+    const { container } = render(<Presentation title="t" steps={steps} />)
+    const node = container.querySelector('[data-presentation-id="dot"]') as HTMLElement
+    expect(propsFor((p) => p.layoutId === 'dot').length).toBeGreaterThan(0)
+    expect(node.style.left).toBe('0px')
+    fireEvent.click(container.querySelector('[data-presentation-next]')!)
+    expect(container.querySelector('[data-presentation-id="dot"]')).toBe(node)
+    expect(node.style.left).toBe('300px')
+  })
+})
diff --git a/tests/unit/nav.test.tsx b/tests/unit/nav.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..3833b3c21cb39ebde5dbdcd9155306fe3ce3772b
--- /dev/null
+++ b/tests/unit/nav.test.tsx
@@ -0,0 +1,186 @@
+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { fireEvent, render, renderHook, act } from '@testing-library/react'
+import { clampIndex, swipeDirection, usePresentationNav } from '../../src/presentation-kit/usePresentationNav'
+import { SWIPE_MIN_PX } from '../../src/presentation-kit/constants'
+
+afterEach(() => {
+  vi.restoreAllMocks()
+})
+
+function dispatchTouch(type: 'touchstart' | 'touchend', clientX: number, clientY: number) {
+  const event = new Event(type)
+  Object.defineProperty(event, 'changedTouches', { value: [{ clientX, clientY }] })
+  act(() => {
+    window.dispatchEvent(event)
+  })
+}
+
+function swipe(dx: number, dy = 0) {
+  dispatchTouch('touchstart', 300, 300)
+  dispatchTouch('touchend', 300 + dx, 300 + dy)
+}
+
+describe('usePresentationNav keyboard', () => {
+  it.each([
+    ['ArrowRight', 1],
+    [' ', 1],
+    ['PageDown', 1],
+    ['ArrowLeft', -1],
+    ['PageUp', -1],
+  ])('key %j from a middle index moves exactly one step (%i)', (key, delta) => {
+    const { result } = renderHook(() => usePresentationNav(9))
+    act(() => result.current.goTo(4))
+    fireEvent.keyDown(window, { key })
+    expect(result.current.index).toBe(4 + delta)
+  })
+
+  it('P toggles the mode in both directions without moving the step', () => {
+    const { result } = renderHook(() => usePresentationNav(9, 'browse'))
+    act(() => result.current.goTo(4))
+    fireEvent.keyDown(window, { key: 'p' })
+    expect(result.current.mode).toBe('present')
+    expect(result.current.index).toBe(4)
+    fireEvent.keyDown(window, { key: 'P' })
+    expect(result.current.mode).toBe('browse')
+    expect(result.current.index).toBe(4)
+  })
+
+  it('handled navigation keys prevent the browser default; unhandled keys do not', () => {
+    renderHook(() => usePresentationNav(9))
+    const handled = new KeyboardEvent('keydown', { key: 'ArrowRight', cancelable: true })
+    act(() => {
+      window.dispatchEvent(handled)
+    })
+    expect(handled.defaultPrevented).toBe(true)
+    const unhandled = new KeyboardEvent('keydown', { key: 'x', cancelable: true })
+    act(() => {
+      window.dispatchEvent(unhandled)
+    })
+    expect(unhandled.defaultPrevented).toBe(false)
+  })
+
+  it('a modifier key does not navigate', () => {
+    const { result } = renderHook(() => usePresentationNav(9))
+    fireEvent.keyDown(window, { key: 'ArrowRight', ctrlKey: true })
+    expect(result.current.index).toBe(0)
+  })
+
+  it.each([
+    ['button', ''],
+    ['a', '#x'],
+    ['input', ''],
+    ['select', ''],
+    ['textarea', ''],
+    ['summary', ''],
+  ])('focused %s keeps every navigation key: no move, no mode change, no default prevented', (tag, href) => {
+    const { result } = renderHook(() => usePresentationNav(9))
+    act(() => result.current.goTo(4))
+    const element = document.createElement(tag)
+    if (href) element.setAttribute('href', href)
+    document.body.appendChild(element)
+    for (const key of ['ArrowRight', ' ', 'PageDown', 'ArrowLeft', 'PageUp', 'p', 'P']) {
+      const event = new KeyboardEvent('keydown', { key, bubbles: true, cancelable: true })
+      act(() => {
+        element.dispatchEvent(event)
+      })
+      expect(event.defaultPrevented, `${tag} ${key}`).toBe(false)
+      expect(result.current.index, `${tag} ${key}`).toBe(4)
+      expect(result.current.mode, `${tag} ${key}`).toBe('browse')
+    }
+    element.remove()
+  })
+
+  it('keys inside a contenteditable descendant keep their keys', () => {
+    const { result } = renderHook(() => usePresentationNav(9))
+    const host = document.createElement('div')
+    host.setAttribute('contenteditable', 'true')
+    const child = document.createElement('span')
+    host.appendChild(child)
+    document.body.appendChild(host)
+    fireEvent.keyDown(child, { key: 'PageDown' })
+    expect(result.current.index).toBe(0)
+    host.remove()
+  })
+
+  it('the same key on the document body still navigates', () => {
+    const { result } = renderHook(() => usePresentationNav(9))
+    render(<div />)
+    fireEvent.keyDown(document.body, { key: 'ArrowRight' })
+    expect(result.current.index).toBe(1)
+  })
+})
+
+describe('usePresentationNav clamping', () => {
+  it('clamps at the first step: going back stays on 0', () => {
+    const { result } = renderHook(() => usePresentationNav(4))
+    fireEvent.keyDown(window, { key: 'ArrowLeft' })
+    act(() => result.current.prev())
+    expect(result.current.index).toBe(0)
+  })
+
+  it('clamps at the last step: advancing stays on the last index, no wrap', () => {
+    const { result } = renderHook(() => usePresentationNav(4))
+    act(() => result.current.goTo(3))
+    fireEvent.keyDown(window, { key: 'ArrowRight' })
+    act(() => result.current.next())
+    expect(result.current.index).toBe(3)
+    expect(clampIndex(99, 4)).toBe(3)
+    expect(clampIndex(-5, 4)).toBe(0)
+  })
+
+  it('swipes that overshoot either end do not wrap', () => {
+    const { result } = renderHook(() => usePresentationNav(3))
+    swipe(-200)
+    swipe(-200)
+    swipe(-200)
+    expect(result.current.index).toBe(2)
+    swipe(200)
+    swipe(200)
+    swipe(200)
+    swipe(200)
+    expect(result.current.index).toBe(0)
+  })
+})
+
+describe('usePresentationNav touch swipe', () => {
+  it('left advances and right goes back', () => {
+    const { result } = renderHook(() => usePresentationNav(9))
+    act(() => result.current.goTo(4))
+    swipe(-120)
+    expect(result.current.index).toBe(5)
+    swipe(120)
+    expect(result.current.index).toBe(4)
+  })
+
+  it('a short gesture, or one that is mostly vertical, does nothing', () => {
+    const { result } = renderHook(() => usePresentationNav(9))
+    act(() => result.current.goTo(4))
+    swipe(-(SWIPE_MIN_PX - 1))
+    expect(result.current.index).toBe(4)
+    swipe(-100, 200)
+    expect(result.current.index).toBe(4)
+  })
+
+  it('applies the displacement threshold at exactly SWIPE_MIN_PX', () => {
+    expect(swipeDirection(-SWIPE_MIN_PX, 0)).toBe(1)
+    expect(swipeDirection(-(SWIPE_MIN_PX - 1), 0)).toBe(0)
+    expect(swipeDirection(100, 100)).toBe(0)
+    expect(swipeDirection(100, 99)).toBe(-1)
+  })
+})
+
+describe('usePresentationNav mode', () => {
+  it('toggles mode while keeping the current step', () => {
+    const { result } = renderHook(() => usePresentationNav(9))
+    act(() => result.current.goTo(4))
+    act(() => result.current.toggleMode())
+    expect(result.current.mode).toBe('present')
+    expect(result.current.index).toBe(4)
+  })
+
+  it('starts in browse mode by default, and honors an explicit initial mode', () => {
+    expect(renderHook(() => usePresentationNav(3)).result.current.mode).toBe('browse')
+    expect(renderHook(() => usePresentationNav(3, 'present')).result.current.mode).toBe('present')
+  })
+})
