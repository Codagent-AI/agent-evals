+  /* The 880 x 380 canvas scales to about 0.4 on a phone, so scene text is large on the canvas. */
+  font-size: 22px;
+  line-height: 1.15;
+  padding: 6px;
+  border-radius: 10px;
+}
+
+.talk-control {
+  white-space: nowrap;
+}
+
+.talk-verify {
+  /* Leave room for the pass chip that sits on the bottom of the node. */
+  padding-bottom: 46px;
+}
+
+.talk-person,
+.talk-card,
+.talk-verify,
+.talk-socket {
+  background: #fff;
+  border: 1.5px solid #1d1f24;
+}
+
+.talk-tray {
+  /* Deliberately unframed: the tray is a region, not a box. */
+  background: transparent;
+  border: none;
+}
+
+.talk-ghost {
+  background: transparent;
+  border: 1.5px dashed #8a8f9b;
+  color: #5b5f69;
