@@ -0,0 +1,21 @@
+import type { Geometry } from '../../presentation-kit/nodes/shared'
+
+/**
+ * Stable entity ids for this presentation. Each id is also the layoutId, so an entity that
+ * persists between steps morphs from its old geometry to its new one.
+ */
+export type EntityId = 'example-box'
+
+export const ENTITIES: Record<EntityId, { text: string; geometry: Geometry }> = {
+  'example-box': { text: 'example', geometry: { x: 40, y: 60, w: 160, h: 80 } },
+}
+
+/** What one step shows. Newcomers are derived from the previous step by the scene, not listed here. */
+export interface DiagramState {
+  visible: EntityId[]
+  emphasized: EntityId[]
+}
+
+export function diagramState(visible: EntityId[], emphasized: EntityId[] = []): DiagramState {
+  return { visible, emphasized }
+}
diff --git a/skills/presentation/templates/presentation/scene.tsx b/skills/presentation/templates/presentation/scene.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0161d0accc4cb15ae0153d7fb6af75a01a79ec7b
--- /dev/null
+++ b/skills/presentation/templates/presentation/scene.tsx
@@ -0,0 +1,24 @@
+import { Fragment } from 'react'
+import { Appear, Box, SceneLayer, type SceneProps } from '../../presentation-kit'
+import { ENTITIES, type DiagramState } from './entities'
+
+/**
+ * The scene every step renders. An entity visible in the previous step is continuing and mounts
+ * unwrapped; a newcomer wraps in Appear so it enters after the persisting entities have moved.
+ */
+export function Diagram({ payload, previous }: SceneProps<DiagramState>) {
+  const before = new Set(previous?.visible ?? [])
+  return (
+    <SceneLayer>
+      {payload.visible.map((id) => {
+        const { text, geometry } = ENTITIES[id]
+        const node = (
+          <Box id={id} geometry={geometry} emphasized={payload.emphasized.includes(id)}>
+            {text}
+          </Box>
+        )
+        return before.has(id) ? <Fragment key={id}>{node}</Fragment> : <Appear key={id}>{node}</Appear>
+      })}
+    </SceneLayer>
+  )
+}
