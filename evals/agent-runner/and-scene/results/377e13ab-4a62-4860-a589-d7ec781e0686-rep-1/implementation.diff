diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..dbff9e3f7866b28a9ab0a799367fb2d38c0b4032
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,206 @@
+#!/usr/bin/env node
+// Captures a settled screenshot per step of a registered presentation and prints advisory
+// visual warnings. Usage: npm run inspect -- <slug> [--settle <ms>] [--viewport <WxH>] [--skip-build] [--positions]
+// Warnings are advisory: they never change the exit code. Only capture failures exit non-zero.
+import { mkdir, rm } from 'node:fs/promises'
+import { fileURLToPath } from 'node:url'
+import { join, resolve, sep } from 'node:path'
+import { chromium } from 'playwright'
+import { findFreePort, runBuild, startPreview, stopAllPreviews } from './lib/preview.mjs'
+
+const root = fileURLToPath(new URL('..', import.meta.url))
+/** Covers the kit's longest transition: layout (0.6 s) + newcomer delay (0.7 s) + fade (0.5 s). */
+const DEFAULT_SETTLE_MS = 2000
+const DEFAULT_VIEWPORT = { width: 1280, height: 720 }
+const OVERLAP_MIN_AREA = 16
+const STABLE_SAMPLE_MS = 150
+const STABLE_TIMEOUT_MS = 4000
+/** Presentation slugs are lowercase words joined by hyphens, as the registry requires. */
+const SLUG_PATTERN = /^[a-z0-9][a-z0-9-]*$/
+
+function parseArgs(argv) {
+  const options = { slug: null, settle: DEFAULT_SETTLE_MS, viewport: DEFAULT_VIEWPORT, skipBuild: false, positions: false }
+  for (let i = 0; i < argv.length; i += 1) {
+    const arg = argv[i]
+    if (arg === '--settle') options.settle = Number(argv[++i])
+    else if (arg === '--viewport') {
+      const [width, height] = argv[++i].split('x').map(Number)
+      options.viewport = { width, height }
+    } else if (arg === '--skip-build') options.skipBuild = true
+    else if (arg === '--positions') options.positions = true
+    else if (!options.slug) options.slug = arg
+    else throw new Error(`unexpected argument: ${arg}`)
+  }
+  if (!options.slug) throw new Error('usage: inspect-presentation.mjs <slug>')
+  if (!SLUG_PATTERN.test(options.slug)) throw new Error(`invalid slug: ${options.slug}`)
+  return options
+}
+
+/** Collects per-step advisory diagnostics from the rendered DOM. */
+async function diagnose(page) {
+  return page.evaluate(
+    ({ minArea }) => {
+      const warnings = []
+      const root = document.querySelector('[data-presentation-root]')
+      const stepLabel = String(Number(root.getAttribute('data-step-index')) + 1)
+
+      // Glyph bounds: a text element's box can be far larger than its text, so measure the text.
+      const textBox = (el) => {
+        const range = document.createRange()
+        range.selectNodeContents(el)
+        return range.getBoundingClientRect()
+      }
+      const isShown = (el) => {
+        const style = getComputedStyle(el)
+        const rect = el.getBoundingClientRect()
+        return style.visibility !== 'hidden' && style.display !== 'none' && Number(style.opacity) > 0 && rect.width > 0 && rect.height > 0
+      }
+      const ownText = (el) => [...el.childNodes].some((node) => node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '')
+      // Exempt only when both elements sit inside the same marked subtree.
+      const exemptPair = (a, b) => {
+        const marked = a.closest('[data-presentation-allow-overlap]')
+        return marked !== null && marked.contains(b)
+      }
+
+      // A readable name for an element, used in warnings.
+      const labelOf = (el) => {
+        const text = el.textContent.trim()
+        if (text) return text.slice(0, 30)
+        if (el.hasAttribute('data-presentation-progress-dot')) return 'progress dot'
+        return el.getAttribute('aria-label') || el.tagName.toLowerCase()
+      }
+
+      // Overlap: visible text or chrome (a control, a progress dot) whose boxes intersect, neither containing
+      // the other. Text is measured by its glyphs; controls without text by their boxes.
+      const chromeSelector = 'button, a[href], [data-presentation-progress-dot]'
+      const candidates = [...root.querySelectorAll('*')]
+        .filter((el) => (ownText(el) || el.matches(chromeSelector)) && isShown(el))
+        .map((el) => ({ el, rect: ownText(el) ? textBox(el) : el.getBoundingClientRect() }))
+      for (let i = 0; i < candidates.length; i += 1) {
+        for (let j = i + 1; j < candidates.length; j += 1) {
+          const a = candidates[i].el
+          const b = candidates[j].el
+          if (a.contains(b) || b.contains(a) || exemptPair(a, b) || exemptPair(b, a)) continue
+          const ra = candidates[i].rect
+          const rb = candidates[j].rect
+          const w = Math.min(ra.right, rb.right) - Math.max(ra.left, rb.left)
+          const h = Math.min(ra.bottom, rb.bottom) - Math.max(ra.top, rb.top)
+          if (w > 0 && h > 0 && w * h >= minArea) {
+            warnings.push(`step ${stepLabel}: overlap between "${labelOf(a)}" and "${labelOf(b)}"`)
+          }
+        }
+      }
+
+      // Active chrome: an active dot or ToC entry identical to an inactive sibling on every checked property.
+      const checked = ['color', 'background-color', 'border-top-color', 'opacity', 'font-weight', 'width', 'height']
+      const signature = (el) => {
+        const style = getComputedStyle(el)
+        return checked.map((prop) => style.getPropertyValue(prop)).join('|')
+      }
+      for (const selector of ['[data-presentation-progress-dot]', '[data-presentation-toc-entry]']) {
+        const items = [...document.querySelectorAll(selector)]
+        const active = items.find((el) => el.getAttribute('data-presentation-active') === 'true')
+        if (!active) continue
+        const sameAsInactive = items.some((el) => el !== active && signature(el) === signature(active))
+        if (sameAsInactive) warnings.push(`step ${stepLabel}: active ${selector.replace(/\[|\]/g, '')} is indistinct from inactive items`)
+      }
+
+      // Attribution: present, not too small, and not the browser-default link look.
+      const attribution = root.querySelector('[data-presentation-attribution]')
+      if (!attribution || !isShown(attribution)) {
+        warnings.push(`step ${stepLabel}: attribution link missing; style [data-presentation-attribution]`)
+      } else {
+        const style = getComputedStyle(attribution)
+        const browserDefault = style.color === 'rgb(0, 0, 238)' && style.textDecorationLine.includes('underline')
+        if (parseFloat(style.fontSize) < 11 || browserDefault) {
+          warnings.push(`step ${stepLabel}: attribution is too small or browser-default; style [data-presentation-attribution]`)
+        }
+      }
+      return warnings
+    },
+    { minArea: OVERLAP_MIN_AREA },
+  )
+}
+
+/** Element geometry on the page, sampled to detect motion. */
+async function geometrySnapshot(page) {
+  return page.evaluate(() =>
+    [...document.querySelectorAll('[data-presentation-id]')].map((el) => {
+      const r = el.getBoundingClientRect()
+      return `${el.getAttribute('data-presentation-id')}=${Math.round(r.left)},${Math.round(r.top)},${Math.round(r.width)},${Math.round(r.height)}`
+    }),
+  )
+}
+
+/** Waits until entity geometry stops changing, so captures show the completed state. */
+async function waitUntilStable(page) {
+  const deadline = Date.now() + STABLE_TIMEOUT_MS
+  let previous = await geometrySnapshot(page)
+  while (Date.now() < deadline) {
+    await page.waitForTimeout(STABLE_SAMPLE_MS)
+    const current = await geometrySnapshot(page)
+    if (current.join('|') === previous.join('|')) return
+    previous = current
+  }
+  console.log('warning: presentation still moving after the settle timeout; capture may be mid-transition')
+}
+
+async function main() {
+  const options = parseArgs(process.argv.slice(2))
+  const inspectionRoot = resolve(root, '.inspection')
+  const outDir = resolve(inspectionRoot, options.slug)
+  // Only ever clear a directory strictly inside .inspection/.
+  if (!outDir.startsWith(inspectionRoot + sep)) throw new Error(`refusing to write outside ${inspectionRoot}`)
+  await rm(outDir, { recursive: true, force: true })
+  await mkdir(outDir, { recursive: true })
+
+  if (!options.skipBuild) await runBuild(root, (line) => console.log(line))
+  let browser = null
+  const preview = await startPreview(root, await findFreePort())
+  try {
+    browser = await chromium.launch()
+    const page = await browser.newPage({ viewport: options.viewport })
+    await page.goto(`${preview.url}/${options.slug}`)
+    const rootLocator = page.locator('[data-presentation-root]')
+    await rootLocator.waitFor()
+    const count = Number(await rootLocator.getAttribute('data-step-count'))
+
+    for (let index = 0; index < count; index += 1) {
+      if (index > 0) {
+        await page.keyboard.press('ArrowRight')
+      }
+      await page.waitForFunction(
+        (expected) => document.querySelector('[data-presentation-root]')?.getAttribute('data-step-index') === String(expected),
+        index,
+      )
+      const started = Date.now()
+      await page.waitForTimeout(options.settle)
+      await waitUntilStable(page)
+      console.log(`settled: step ${String(index + 1).padStart(2, '0')} waited ${Date.now() - started}ms (configured settle ${options.settle}ms)`)
+      const file = join(outDir, `step-${String(index + 1).padStart(2, '0')}.png`)
+      await page.screenshot({ path: file })
+      console.log(`captured: ${file}`)
+      if (options.positions) {
+        for (const line of await geometrySnapshot(page)) console.log(`position: step ${String(index + 1).padStart(2, '0')} ${line}`)
+      }
+      for (const warning of await diagnose(page)) console.log(`warning: ${warning}`)
+    }
+    console.log(`inspect: ${count} steps captured for ${options.slug}`)
+  } finally {
+    await browser?.close()
+    await stopAllPreviews()
+  }
+}
+
+// Ctrl-C or a termination signal stops every preview this run started before exiting.
+for (const signal of ['SIGINT', 'SIGTERM']) {
+  process.on(signal, () => {
+    stopAllPreviews().finally(() => process.exit(signal === 'SIGINT' ? 130 : 143))
+  })
+}
+
+main().catch(async (error) => {
+  console.error(`inspect: ${error.message}`)
+  await stopAllPreviews()
+  process.exit(1)
+})
diff --git a/scripts/lib/preview.mjs b/scripts/lib/preview.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9a2534276db884da3f458c0e731e4a5734c0b7e1
--- /dev/null
+++ b/scripts/lib/preview.mjs
@@ -0,0 +1,106 @@
+import { spawn } from 'node:child_process'
+import { createServer } from 'node:net'
+import { join } from 'node:path'
+
+const HOST = '127.0.0.1'
+const READY_TIMEOUT_MS = 30_000
+/** Most recent output kept from the preview process, for startup failures. */
+const OUTPUT_TAIL_CHARS = 4_000
+
+/** Every preview process this module has started and not yet seen exit, including ones still starting. */
+const running = new Set()
+
+/** Asks the OS for a free loopback port. */
+export function findFreePort() {
+  return new Promise((resolve, reject) => {
+    const server = createServer()
+    server.unref()
+    server.on('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+}
+
+/** Runs the production build in `root`, streaming its output with a `build:` prefix. */
+export function runBuild(root, log) {
+  return new Promise((resolve, reject) => {
+    const child = spawn('npm', ['run', 'build'], { cwd: root, stdio: ['ignore', 'pipe', 'pipe'] })
+    const relay = (chunk) => {
+      for (const line of String(chunk).split('\n')) if (line.trim()) log(`build: ${line}`)
+    }
+    child.stdout.on('data', relay)
+    child.stderr.on('data', relay)
+    child.on('error', reject)
+    child.on('exit', (code) => (code === 0 ? resolve() : reject(new Error(`npm run build exited with ${code}`))))
+  })
+}
+
+/**
+ * Starts `vite preview` on the loopback address in its own process group, so the
+ * whole tree can be stopped. Resolves once the preview answers an HTTP probe.
+ */
+export async function startPreview(root, port) {
+  const viteBin = join(root, 'node_modules', 'vite', 'bin', 'vite.js')
+  const child = spawn(
+    process.execPath,
+    [viteBin, 'preview', '--host', HOST, '--port', String(port), '--strictPort'],
+    { cwd: root, detached: true, stdio: ['ignore', 'pipe', 'pipe'] },
+  )
+  running.add(child)
+  // Drain both pipes so vite never blocks on a full buffer; keep only the tail for error reports.
+  let outputTail = ''
+  const keep = (chunk) => {
+    outputTail = (outputTail + String(chunk)).slice(-OUTPUT_TAIL_CHARS)
+  }
+  child.stdout.on('data', keep)
+  child.stderr.on('data', keep)
+  let exited = null
+  child.on('exit', (code, signal) => {
+    running.delete(child)
+    exited = { code, signal }
+  })
+
+  const url = `http://${HOST}:${port}`
+  const deadline = Date.now() + READY_TIMEOUT_MS
+  while (Date.now() < deadline) {
+    if (exited) {
+      throw new Error(`vite preview exited (${exited.code ?? exited.signal}) before it was ready:\n${outputTail.trim()}`)
+    }
+    try {
+      const response = await fetch(`${url}/`)
+      if (response.ok) return { url, stop: () => stopProcessGroup(child) }
+    } catch {
+      // Not listening yet; retry until the deadline.
+    }
+    await new Promise((resolve) => setTimeout(resolve, 150))
+  }
+  await stopProcessGroup(child)
+  throw new Error(`vite preview was not ready at ${url} within ${READY_TIMEOUT_MS} ms:\n${outputTail.trim()}`)
+}
+
+/** Stops a detached child and every process it started. */
+export function stopProcessGroup(child) {
+  if (child.exitCode !== null || child.signalCode !== null) return Promise.resolve()
+  return new Promise((resolve) => {
+    child.once('exit', resolve)
+    try {
+      process.kill(-child.pid, 'SIGTERM')
+    } catch {
+      resolve()
+    }
+    setTimeout(() => {
+      try {
+        process.kill(-child.pid, 'SIGKILL')
+      } catch {
+        // Already gone.
+      }
+    }, 2_000).unref()
+  })
+}
+
+/** Stops every preview this module started, whether or not it is ready yet. */
+export function stopAllPreviews() {
+  return Promise.all([...running].map(stopProcessGroup))
+}
