+
+/* Arrowheads at the tip; two-way arrows also get one at the tail. */
+.talk-link::after,
+.talk-morph::after,
+.talk-chain::after,
+.talk-modify::after {
+  content: '';
+  position: absolute;
+  right: -2px;
+  top: -5px;
