+  position: absolute;
+  left: -2px;
+  top: -5px;
+  border-right: 8px solid currentColor;
+  border-top: 5px solid transparent;
+  border-bottom: 5px solid transparent;
+}
+
+.talk-edited {
+  border: 2px solid #2f6fed;
+  border-radius: 12px;
+}
+
+.talk-reveal {
+  border: 2px solid #1d1f24;
+  border-radius: 16px;
+  text-align: left;
+}
+
+.talk-reveal > span {
+  position: absolute;
