+  geometry?: Geometry
+  icon?: LucideIcon
+  className?: string
+  style?: CSSProperties
+  children?: ReactNode
+}
+
+export function SymbolChip({ id, geometry, icon: Icon, className, style, children, ...data }: SymbolChipProps) {
+  return (
+    <motion.div
+      {...data}
+      layout
+      transition={{ layout: LAYOUT_TRANSITION }}
+      exit={EXIT}
