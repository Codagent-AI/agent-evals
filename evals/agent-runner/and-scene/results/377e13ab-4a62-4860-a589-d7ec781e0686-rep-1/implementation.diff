+      <ol>
+        {eras.map((entry) => {
+          const active = entry.era === activeEra
+          return (
+            <li key={entry.era}>
+              <button
+                type="button"
+                data-presentation-toc-entry=""
+                data-presentation-active={active ? 'true' : undefined}
+                aria-current={active ? 'step' : undefined}
+                onClick={() => onSelect(entry.firstIndex)}
+              >
+                {entry.era}
+              </button>
+            </li>
+          )
+        })}
+      </ol>
+    </nav>
+  )
+}
