+
+[data-presentation-controls] button {
+  font: inherit;
+  padding: 4px 12px;
+  border: 1px solid #1d1f24;
+  background: #fff;
+  border-radius: 6px;
+  cursor: pointer;
+}
+
+[data-presentation-controls] button:disabled {
+  opacity: 0.4;
+  cursor: default;
+}
+
+[data-presentation-attribution] {
+  font-size: 12px;
+  color: #3b4352;
+  text-decoration: none;
+  border-bottom: 1px solid #3b4352;
+}
+
+/* Scene entities */
+.talk-person,
+.talk-card,
+.talk-tray,
+.talk-socket,
+.talk-verify,
+.talk-ghost,
+.talk-bubble,
+.talk-question,
+.talk-control,
+.talk-pass,
