+      className={className}
+      style={{ ...geometryStyle(geometry), ...style }}
+      data-presentation-node="symbol-chip"
+      data-presentation-id={id}
+    >
+      {Icon ? <Icon aria-hidden="true" data-presentation-glyph="" /> : null}
+      {children}
+    </motion.div>
+  )
+}
