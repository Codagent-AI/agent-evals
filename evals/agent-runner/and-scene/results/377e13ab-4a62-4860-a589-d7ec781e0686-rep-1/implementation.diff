+import { copyFileSync, existsSync, readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { afterAll, beforeAll, describe, expect, it } from 'vitest'
+import { copyWithSharedModules, materializeBootstrap, removeDir, run } from './helpers'
+import { VARIANTS, writeFixtures } from './fixture-app'
+
+/**
+ * INT-002: the project-local inspection helper, run against a production preview of fixture
+ * presentations, writes one settled screenshot per step and prints advisory warnings only.
+ */
+let app: string
+let base: string
+
+function inspect(slug: string, extra: string[] = []) {
+  return run('node', ['scripts/inspect-presentation.mjs', slug, '--skip-build', ...extra], app, 300_000)
+}
+
+function warningsFor(output: string) {
+  return output.split('\n').filter((line) => line.startsWith('warning:'))
+}
+
+function pngSize(path: string) {
+  const bytes = readFileSync(path)
+  return { width: bytes.readUInt32BE(16), height: bytes.readUInt32BE(20) }
+}
+
+beforeAll(() => {
+  base = materializeBootstrap('int002-base-')
+  const install = run('npm', ['ci', '--no-audit', '--no-fund'], base, 900_000)
+  if (install.status !== 0) throw new Error(`npm ci failed:\n${install.output}`)
+  app = copyWithSharedModules(base, join(base, 'node_modules'), 'int002-app-')
+  writeFixtures(app)
+  const build = run('npm', ['run', 'build'], app, 300_000)
+  if (build.status !== 0) throw new Error(`fixture build failed:\n${build.output}`)
+}, 1_000_000)
+
+afterAll(() => {
+  if (app) removeDir(app)
+  if (base) removeDir(base)
+})
+
+describe('screenshot artifacts', () => {
+  it('writes one 1280x720 screenshot per step at a predictable project-local path', () => {
+    const result = inspect('fixture-clean')
+    expect(result.status, result.output).toBe(0)
+    for (let step = 1; step <= 3; step += 1) {
+      const file = join(app, '.inspection/fixture-clean', `step-0${step}.png`)
+      expect(existsSync(file), file).toBe(true)
+      expect(pngSize(file)).toEqual({ width: 1280, height: 720 })
+    }
+    expect(result.output).toContain('inspect: 3 steps captured for fixture-clean')
+  }, 300_000)
+
+  it('captures a settled completed state: a zero-settle image is byte-identical to the default-settle image, and the configured interval is honored', () => {
+    const copyStep2 = (name: string) => {
+      const dest = join(app, `${name}.png`)
+      copyFileSync(join(app, '.inspection/fixture-slow/step-02.png'), dest)
+      return readFileSync(dest)
+    }
+    const settled = inspect('fixture-slow', ['--positions'])
+    const settledPng = copyStep2('settled-default')
+    const immediate = inspect('fixture-slow', ['--positions', '--settle', '0'])
+    const immediatePng = copyStep2('settled-zero')
+    expect(settled.status).toBe(0)
+    expect(immediate.status).toBe(0)
+    // Completed state, not mid-transition: the two captures are the same pixels.
+    expect(immediatePng.equals(settledPng)).toBe(true)
+    // The configured interval is honored, and the report says what was waited.
+    const waited = (output: string) => Number(/settled: step 02 waited (\d+)ms \(configured settle (\d+)ms\)/.exec(output)?.[1])
+    expect(waited(settled.output)).toBeGreaterThanOrEqual(2000)
+    const slow = inspect('fixture-slow', ['--settle', '1500'])
+    expect(/configured settle 1500ms/.test(slow.output)).toBe(true)
+    expect(waited(slow.output)).toBeGreaterThanOrEqual(1500)
+    // The moving entity really moves between steps; the captures are not just the start position.
+    const mover = (output: string, step: string) =>
+      output.split('\n').find((line) => line.startsWith(`position: step ${step}`) && line.includes('mover='))
+    expect(mover(immediate.output, '02')).toBe(mover(settled.output, '02'))
+    expect(mover(settled.output, '02')?.split('mover=')[1]).not.toBe(mover(settled.output, '01')?.split('mover=')[1])
+  }, 300_000)
+})
+
+describe('advisory overlap warnings', () => {
+  it('warns for an unmarked text collision and names the step', () => {
+    const result = inspect('fixture-collision')
+    expect(result.status).toBe(0)
+    expect(warningsFor(result.output).some((line) => line.startsWith('warning: step 1: overlap'))).toBe(true)
+  }, 300_000)
+
+  it('warns when text overlaps an empty progress dot (chrome without text)', () => {
+    const result = inspect('fixture-chrome-overlap')
+    expect(result.status).toBe(0)
+    expect(warningsFor(result.output).some((line) => line.startsWith('warning: step 1: overlap') && line.includes('progress dot'))).toBe(true)
+  }, 300_000)
+
+  it('does not warn when both overlapping elements are inside an allow-overlap subtree', () => {
+    const result = inspect('fixture-allowed')
+    expect(result.status).toBe(0)
+    expect(warningsFor(result.output).filter((line) => line.includes('overlap'))).toEqual([])
+  }, 300_000)
+
+  it('still warns for a marked element that collides with an unmarked outsider', () => {
+    const result = inspect('fixture-mixed')
+    expect(result.status).toBe(0)
+    expect(warningsFor(result.output).some((line) => line.includes('overlap'))).toBe(true)
+  }, 300_000)
+})
+
+describe('advisory chrome and attribution warnings', () => {
+  it('warns when the active progress dot and ToC entry are indistinct from inactive ones', () => {
+    const result = inspect('fixture-indistinct')
+    expect(result.status).toBe(0)
+    const warnings = warningsFor(result.output)
+    expect(warnings.some((line) => line.includes('indistinct') && line.includes('progress-dot'))).toBe(true)
+    expect(warnings.some((line) => line.includes('indistinct') && line.includes('toc-entry'))).toBe(true)
+  }, 300_000)
+
+  it('warns for a too-small attribution and names the styling hook', () => {
+    const result = inspect('fixture-attribution-small')
+    expect(result.status).toBe(0)
+    expect(warningsFor(result.output).some((line) => line.includes('attribution') && line.includes('data-presentation-attribution'))).toBe(true)
+  }, 300_000)
+
+  it('warns for a browser-default attribution link', () => {
+    const result = inspect('fixture-attribution-default')
+    expect(result.status).toBe(0)
+    expect(warningsFor(result.output).some((line) => line.includes('browser-default'))).toBe(true)
+  }, 300_000)
+
+  it('warns when the attribution element is absent from the page', () => {
+    const result = inspect('fixture-attribution-absent')
+    expect(result.status).toBe(0)
+    expect(warningsFor(result.output).some((line) => line.includes('attribution link missing'))).toBe(true)
+  }, 300_000)
+
+  it('warns when the attribution is missing or hidden', () => {
+    const result = inspect('fixture-attribution-missing')
+    expect(result.status).toBe(0)
+    expect(warningsFor(result.output).some((line) => line.includes('attribution link missing'))).toBe(true)
+  }, 300_000)
+
+  it('a clean styled presentation produces no warnings', () => {
+    const result = inspect('fixture-clean')
+    expect(warningsFor(result.output)).toEqual([])
+  }, 300_000)
+
+  it('warnings alone never change the exit code, even when several are printed together', () => {
+    const result = inspect('fixture-combined')
+    expect(warningsFor(result.output).length).toBeGreaterThanOrEqual(2)
+    expect(result.status).toBe(0)
+  }, 300_000)
+})
+
+it('every fixture variant is registered', () => {
+  expect(VARIANTS.length).toBeGreaterThan(5)
+})
diff --git a/tests/integration/fixture-app.ts b/tests/integration/fixture-app.ts
new file mode 100644
index 0000000000000000000000000000000000000000..708bdc5a70ae74f77299212c169a1045bea506b2
--- /dev/null
+++ b/tests/integration/fixture-app.ts
@@ -0,0 +1,161 @@
+import { mkdirSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+
+/**
+ * Fixture presentations for the inspection helper. Each slug is one controlled variant:
+ * a collision, an allowed overlap, a styled or unstyled attribution, and so on. The variant
+ * name also selects the stylesheet rules through a data attribute on the wrapper.
+ */
+export const VARIANTS = [
+  'clean',
+  'collision',
+  'allowed',
+  'mixed',
+  'indistinct',
+  'attribution-small',
+  'attribution-default',
+  'attribution-missing',
+  'attribution-absent',
+  'chrome-overlap',
+  'slow',
+  'combined',
+] as const
+
+export type Variant = (typeof VARIANTS)[number]
+
+const FIXTURE_TSX = `import type { ComponentType } from 'react'
+import { Presentation, Box, Label, SceneLayer, type SceneProps, type Step } from '../../presentation-kit'
+import './fixture.css'
+
+export interface FixturePayload {
+  variant: string
+  labels: Array<{ id: string; text: string; x: number; y: number; marked?: boolean }>
+  mover: number
+}
+
+function FixtureScene({ payload }: SceneProps<FixturePayload>) {
+  const plain = payload.labels.filter((label) => !label.marked)
+  const marked = payload.labels.filter((label) => label.marked)
+  return (
+    <SceneLayer>
+      {plain.map((label) => (
+        <Label key={label.id} id={label.id} geometry={{ x: label.x, y: label.y, w: 120, h: 30 }}>
+          {label.text}
+        </Label>
+      ))}
+      {marked.length > 0 ? (
+        <div data-presentation-allow-overlap="" style={{ position: 'absolute', inset: 0 }}>
+          {marked.map((label) => (
+            <Label key={label.id} id={label.id} geometry={{ x: label.x, y: label.y, w: 120, h: 30 }}>
+              {label.text}
+            </Label>
+          ))}
+        </div>
+      ) : null}
+      <Box id="mover" geometry={{ x: payload.mover, y: 280, w: 80, h: 40 }} />
+    </SceneLayer>
+  )
+}
+
+const overlapping = [
+  { id: 'a', text: 'AAAA', x: 100, y: 100 },
+  { id: 'b', text: 'BBBB', x: 110, y: 104 },
+]
+
+const steps = (variant: string, layers: FixturePayload['labels'][]): Step<FixturePayload>[] =>
+  layers.map((labels, i) => ({
+    id: \`\${variant}-\${i}\`,
+    era: \`fixture era \${i + 1}\`,
+    title: \`Step \${i + 1}\`,
+    caption: 'Fixture caption for inspection.',
+    Scene: FixtureScene as ComponentType<SceneProps<FixturePayload>>,
+    payload: { variant, labels, mover: i === 1 ? 600 : 0 },
+  }))
+
+export function FixtureTalk({ variant }: { variant: string }) {
+  const first = firstStepLabels(variant)
+  const layers: FixturePayload['labels'][] = [
+    first,
+    [{ id: 'c', text: 'CCCC', x: 500, y: 60 }],
+    [{ id: 'd', text: 'DDDD', x: 500, y: 200 }],
+  ]
+  // Wrapper flags select which styling the variant keeps: active chrome, and the attribution look.
+  const distinct = variant !== 'indistinct' && variant !== 'combined' ? '' : undefined
+  const browserLink = variant === 'attribution-default' ? '' : undefined
+  return (
+    <div data-fixture={variant} data-distinct={distinct} data-browser-link={browserLink}>
+      <Presentation
+        title={\`fixture \${variant}\`}
+        steps={steps(variant, layers)}
+        initialMode="browse"
+        hideAttribution={variant === 'attribution-absent'}
+      />
+    </div>
+  )
+}
+
+/** The first step's labels: a collision, an allowed overlap, a mixed overlap, or none. */
+function firstStepLabels(variant: string): FixturePayload['labels'] {
+  if (variant === 'collision' || variant === 'combined') return overlapping
+  if (variant === 'allowed') {
+    return overlapping.map((label) => ({ ...label, marked: true }))
+  }
+  if (variant === 'mixed') {
+    return [
+      { id: 'a', text: 'AAAA', x: 100, y: 100, marked: true },
+      { id: 'b', text: 'BBBB', x: 110, y: 104 },
+    ]
+  }
+  return [{ id: 'a', text: 'AAAA', x: 100, y: 100 }]
+}
+`
+
+const FIXTURE_CSS = `
+/* Base styling: distinct active chrome and a legible attribution. Variants opt out with wrapper flags. */
+[data-fixture] [data-presentation-progress-dot] { width: 8px; height: 8px; background: #ccc; }
+[data-fixture][data-distinct] [data-presentation-progress-dot][data-presentation-active='true'] { width: 16px; height: 16px; background: #d00; }
+[data-fixture] [data-presentation-toc-entry] { background: #fff; color: #111; }
+[data-fixture][data-distinct] [data-presentation-toc-entry][data-presentation-active='true'] { background: #00c; color: #fff; }
+[data-fixture]:not([data-browser-link]) [data-presentation-attribution] { font-size: 13px; color: #222; text-decoration: none; }
+[data-fixture='attribution-small'] [data-presentation-attribution] { font-size: 9px !important; }
+[data-fixture='attribution-missing'] [data-presentation-attribution] { display: none !important; }
+/* The progress dots sit over the step title, so the text and the controls collide. */
+[data-fixture='chrome-overlap'] [data-presentation-footer] [data-presentation-progress] { position: absolute; left: 0; top: 0; }
+[data-fixture='chrome-overlap'] [data-presentation-step-title] { margin: 0; }
+`
+
+/** One Talk.tsx per variant, registered under the slug fixture-<variant>. */
+export function fixtureRegistry(variants: readonly string[]): string {
+  const entries = variants.map(
+    (variant) =>
+      `  { slug: 'fixture-${variant}', title: 'fixture ${variant}', load: () => import('./fixture-${variant}/Talk') },`,
+  )
+  return `import type { ComponentType } from 'react'
+
+export interface PresentationEntry {
+  slug: string
+  title: string
+  load: () => Promise<{ default: ComponentType }>
+}
+
+export const presentations: PresentationEntry[] = [
+  { slug: 'how-to-make-a-presentation', title: 'How to Use This Skill to Make a Presentation', load: () => import('./how-to-make-a-presentation/Talk') },
+${entries.join('\n')}
+]
+`
+}
+
+/** Writes the fixture presentations into an app that already has the kit. */
+export function writeFixtures(appDir: string) {
+  mkdirSync(join(appDir, 'src/presentations/fixture'), { recursive: true })
+  writeFileSync(join(appDir, 'src/presentations/fixture/Fixture.tsx'), FIXTURE_TSX)
+  writeFileSync(join(appDir, 'src/presentations/fixture/fixture.css'), FIXTURE_CSS)
+  for (const variant of VARIANTS) {
+    mkdirSync(join(appDir, `src/presentations/fixture-${variant}`), { recursive: true })
+    writeFileSync(
+      join(appDir, `src/presentations/fixture-${variant}/Talk.tsx`),
+      `import { FixtureTalk } from '../fixture/Fixture'\n\nexport default function Talk() {\n  return <FixtureTalk variant="${variant}" />\n}\n`,
+    )
+  }
+  writeFileSync(join(appDir, 'src/presentations/index.ts'), fixtureRegistry(VARIANTS))
+}
