+}
+
+[data-presentation-attribution] {
+  font-size: 12px;
+  color: var(--htmap-muted);
+  text-decoration: none;
+}
+
+[data-presentation-attribution]:hover {
+  color: var(--htmap-accent);
+}
+
+/* --- the scene itself --- */
+
+.htmap-scene {
+  font-size: 13px;
+}
+
+.htmap-node,
+.htmap-bubble,
+.htmap-chip {
