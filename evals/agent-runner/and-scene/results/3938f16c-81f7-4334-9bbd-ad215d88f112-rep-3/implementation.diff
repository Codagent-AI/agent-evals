+/* Presentation-owned styling for "How to Use This Skill to Make a
+   Presentation". The scene kit supplies no visual defaults; every color,
+   spacing, and typography decision below belongs to this presentation. */
+
+[data-presentation-root] {
+  --htmap-ink: #f8f3e6;
+  --htmap-muted: #b8ae9a;
+  --htmap-accent: #c7a755;
+  --htmap-panel: #1b1815;
+  --htmap-panel-border: rgba(199, 167, 85, 0.35);
+  color: var(--htmap-ink);
+}
+
+/* Chrome keeps a gutter off the viewport edges. The stage stays full-width so
+   the fixed canvas scales as large as the viewport allows. */
+[data-presentation-header],
+[data-presentation-footer] {
+  padding: 0.75rem clamp(1rem, 4vw, 2.5rem);
+}
+
+[data-presentation-toc] {
+  flex: 0 0 auto;
+  padding: 0.75rem 0 0 clamp(1rem, 4vw, 2.5rem);
+}
+
+[data-presentation-header] h1 {
