+  font-variant-numeric: tabular-nums;
+  margin-right: 0.75rem;
+}
+
+[data-presentation-caption] {
+  color: var(--htmap-muted);
+  max-width: 42rem;
+}
+
+[data-presentation-progress-item] {
+  background: none;
+  border: none;
+  padding: 4px;
+  cursor: pointer;
+}
+
+[data-presentation-progress-item] [data-presentation-progress-dot] {
+  display: block;
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: rgba(248, 243, 230, 0.25);
+}
+
+[data-presentation-progress-item][data-presentation-active] {
+  background: rgba(199, 167, 85, 0.25);
+  border-radius: 999px;
+}
+
+[data-presentation-progress-item][data-presentation-active] [data-presentation-progress-dot] {
+  background: var(--htmap-accent);
+  box-shadow: 0 0 0 3px rgba(199, 167, 85, 0.25);
+}
+
+[data-presentation-toc-item] {
+  color: var(--htmap-muted);
+  background: none;
+  border: none;
+  padding: 0.25rem 0;
+  text-align: left;
+  cursor: pointer;
+}
+
+[data-presentation-toc-item][data-presentation-active] {
+  color: var(--htmap-accent);
+  font-weight: 700;
+}
+
+[data-presentation-prev],
+[data-presentation-next] {
+  background: var(--htmap-panel);
+  color: var(--htmap-ink);
+  border: 1px solid var(--htmap-panel-border);
+  border-radius: 6px;
+  padding: 0.35rem 0.9rem;
