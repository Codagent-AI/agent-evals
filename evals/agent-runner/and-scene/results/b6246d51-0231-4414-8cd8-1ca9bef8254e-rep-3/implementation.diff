+:root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #e9edf5; background: #101723; }
+* { box-sizing: border-box } body { margin: 0 } button { font: inherit; cursor: pointer }
+[data-presentation] { min-height: 100vh; padding: 26px 6vw 60px; background: radial-gradient(circle at 70% 10%, #203249, #101723 58%); }
+[data-presentation-header] { display: flex; align-items: center; gap: 14px; color: #a9b6c9; font-size: 13px; letter-spacing: .04em; height: 40px }
+[data-presentation-marker] { color: #70e2c3; font-weight: 800; font-size: 18px }
+[data-presentation-mode-toggle] { margin-left: auto; color: #e9edf5; background: transparent; border: 1px solid #56677e; border-radius: 20px; padding: 6px 14px }
+[data-presentation-stage] { margin-top: 35px !important; margin-bottom: 18px !important }
+[data-presentation-footer] { max-width: 720px; margin: auto; text-align: center }
+[data-presentation-footer] h1 { font-size: clamp(23px, 3vw, 36px); margin: 0 0 10px; letter-spacing: -.04em }
+[data-presentation-caption] { color: #aebccd; line-height: 1.55; min-height: 50px; margin: 0 auto 18px; max-width: 640px }
+[data-presentation-progress] { display: flex; justify-content: center; gap: 9px }
+[data-presentation-progress] button { border: 0; border-radius: 50%; width: 9px; height: 9px; padding: 0; background: #58677b }
+[data-presentation-progress] button[data-presentation-active=true] { background: #75e4c1; box-shadow: 0 0 0 4px #75e4c133 }
+[data-presentation-controls] { display: flex; justify-content: center; gap: 20px; margin-top: 16px }
+[data-presentation-controls] button, [data-presentation-toc] button { border: 0; background: transparent; color: #9aabc0 }
+[data-presentation-controls] button:disabled { opacity: .35 }
+[data-presentation-toc] { display: flex; justify-content: center; gap: 12px; margin: 22px auto }
+[data-presentation-toc] button[data-presentation-active=true] { color: #75e4c1; text-decoration: underline; text-underline-offset: 5px }
+[data-presentation-attribution] { color: #adbdce; font-size: 12px; text-decoration: none }
+.scene { position: absolute; inset: 0; color: #eaf4f4 }.scene-item { position: absolute }.scene small { display: block; font-size: 10px; letter-spacing: .12em; color: #93a9b9; margin-bottom: 8px }.person { border: 1px solid #587487; border-radius: 14px; background: #23384a; padding: 18px 22px; width: 190px; height: 78px }.person strong { font-size: 19px }.skill { border-color: #64cbaa }.bubble { border: 1px solid #668398; background: #1b2b39; border-radius: 25px; padding: 12px 20px; font-size: 14px }.question { color: #75e4c1; background: #203247; border: 1px solid #64cbaa; border-radius: 14px; padding: 4px 10px; font-size: 12px }.tray-label { color: #869caf; font-size: 10px; letter-spacing: .16em }.card { width: 148px; height: 88px; border-radius: 10px; border: 1px solid #54718a; background: #203247; padding: 11px 14px }.card b,.card span { display: block }.card b { font-size: 15px }.card span { color: #a1b6c8; font-size: 11px; margin-top: 5px }.ghost { border-style: dashed; opacity: .75 }.morph { color: #75e4c1; font-size: 10px }.depth,.kit,.modify { font-size: 12px; color: #75e4c1 }.depth { border: 1px solid #64cbaa; background: #203247; border-radius: 0 0 9px 9px; padding: 5px 10px }.kit { border: 1px solid #62ae9f; border-radius: 5px; padding: 8px 15px }.verify { border-color: #75e4c1 }.verify span { color: #75e4c1 }.reveal { width: 850px; height: 360px; border: 1px solid #75e4c1; border-radius: 22px; padding: 8px 20px; color: #75e4c1; font-size: 10px; letter-spacing: .13em; pointer-events: none }
+@media(max-width: 700px) { [data-presentation] { padding-inline: 16px } [data-presentation-toc] { display: none } [data-presentation-stage] { margin-top: 20px !important } }
