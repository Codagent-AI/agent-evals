diff --git a/scripts/browser-utils.mjs b/scripts/browser-utils.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..411994deef29303cb94a511d22ccd306faeb32b2
--- /dev/null
+++ b/scripts/browser-utils.mjs
@@ -0,0 +1,12 @@
+import { spawn } from 'node:child_process'
+import { chromium } from 'playwright'
+import { createServer } from 'node:net'
+import { resolve } from 'node:path'
+export async function preview() {
+ const port = await new Promise((resolvePort, reject) => { const socket = createServer(); socket.once('error', reject); socket.listen(0, '127.0.0.1', () => { const port = socket.address().port; socket.close(() => resolvePort(port)) }) })
+ const base = `http://127.0.0.1:${port}`
+ const server = spawn(process.execPath, [resolve('node_modules/vite/bin/vite.js'),'preview','--host','127.0.0.1','--port',String(port),'--strictPort'], { stdio: 'ignore' })
+ try { for (let i=0;i<100;i++) { if (server.exitCode !== null) throw Error('Preview exited before readiness'); try { if ((await fetch(base)).ok) return { server, base } } catch {} await new Promise(r=>setTimeout(r,100)) } throw Error('Preview readiness timed out') } catch(e) { server.kill(); throw e }
+}
+export async function browser() { return chromium.launch({ headless: true }) }
+export async function stop(server, instance) { await instance?.close(); if (server && server.exitCode === null) { server.kill('SIGTERM'); await new Promise(resolve => { server.once('exit', resolve); setTimeout(resolve, 2000).unref() }) } }
diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d441ad3e6c28c80540cee8a3027539596f3ed079
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,19 @@
+import { mkdir } from 'node:fs/promises'
+import path from 'node:path'
+import { preview, browser, stop } from './browser-utils.mjs'
+const slug = process.argv[2]
+if (!slug || !/^[a-z0-9-]+$/.test(slug)) { console.error('Usage: npm run inspect -- <slug>'); process.exit(1) }
+let server, instance
+try {
+ const p = await preview(); server = p.server; instance = await browser(); const page = await instance.newPage({ viewport: { width: 1440, height: 900 } }); await page.goto(`${p.base}/${slug}`, { waitUntil: 'networkidle' }); const root = page.locator('[data-presentation]'); await root.waitFor({ state: 'attached', timeout: 10000 }); const count = Number(await root.getAttribute('data-step-count')); const dir = path.join('artifacts','presentations',slug); await mkdir(dir,{ recursive: true })
+ for (let i=0;i<count;i++) { if (i) await page.keyboard.press('ArrowRight'); await page.waitForFunction(index => document.querySelector('[data-presentation]')?.getAttribute('data-step-index') === String(index), i, { timeout: 5000 }); await page.waitForTimeout(900); await page.screenshot({ path: path.join(dir,`step-${String(i+1).padStart(2,'0')}.png`) }); const warnings = await page.evaluate(() => {
+  const out = []; const visible = e => { const r=e.getBoundingClientRect(), s=getComputedStyle(e); return r.width>0 && r.height>0 && s.visibility!=='hidden' && s.display!=='none' && Number(s.opacity)>0 }
+  const nodes = []; const root = document.querySelector('[data-presentation]'); const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
+  while (walker.nextNode()) { const node = walker.currentNode, parent = node.parentElement, label = node.textContent.trim(); if (!label || !parent || !visible(parent) || parent.closest('[data-presentation-allow-overlap]')) continue; const range = document.createRange(); range.selectNodeContents(node); for (const rect of range.getClientRects()) if (rect.width && rect.height) nodes.push({ element: parent, rect, label }) }
+  for (const element of root.querySelectorAll('button, a')) { if (!visible(element) || element.closest('[data-presentation-allow-overlap]')) continue; nodes.push({ element, rect: element.getBoundingClientRect(), label: element.getAttribute('aria-label') || element.textContent.trim() || element.tagName }) }
+  for (let a=0;a<nodes.length;a++) for(let b=a+1;b<nodes.length;b++) { const x=nodes[a],y=nodes[b]; if(x.element===y.element || x.element.contains(y.element) || y.element.contains(x.element)) continue; const r=x.rect,s=y.rect; if (Math.min(r.right,s.right)-Math.max(r.left,s.left)>2 && Math.min(r.bottom,s.bottom)-Math.max(r.top,s.top)>2) out.push(`overlap: ${x.label} / ${y.label}`) }
+  for (const nav of document.querySelectorAll('[data-presentation-progress], [data-presentation-toc]')) { const active=nav.querySelector('[data-presentation-active="true"]'), inactive=nav.querySelector('[data-presentation-active="false"]'); if(active && inactive) { const a=getComputedStyle(active),b=getComputedStyle(inactive); const properties=['backgroundColor','backgroundImage','boxShadow','opacity','transform']; const visibleBorder=s=>s.borderStyle!=='none' && s.borderWidth!=='0px'; const visibleOutline=s=>s.outlineStyle!=='none' && s.outlineWidth!=='0px'; const sameBorder=(!visibleBorder(a) && !visibleBorder(b)) || (a.borderStyle===b.borderStyle && a.borderWidth===b.borderWidth && a.borderColor===b.borderColor); const sameOutline=(!visibleOutline(a) && !visibleOutline(b)) || (a.outlineStyle===b.outlineStyle && a.outlineWidth===b.outlineWidth && a.outlineColor===b.outlineColor); const same=properties.every(name=>a[name]===b[name]) && sameBorder && sameOutline; const hasVisibleText=active.textContent.trim() && inactive.textContent.trim(); if(same && (!hasVisibleText || (a.color===b.color && a.textDecorationLine===b.textDecorationLine))) out.push(`indistinct active ${nav.hasAttribute('data-presentation-progress') ? 'progress' : 'table of contents'} navigation`) } }
+  const link=document.querySelector('[data-presentation-attribution]'); if(!link || !visible(link) || parseFloat(getComputedStyle(link).fontSize)<11 || (getComputedStyle(link).color==='rgb(0, 0, 238)' && getComputedStyle(link).textDecorationLine.includes('underline'))) out.push('unpolished attribution: style [data-presentation-attribution]')
+  return out
