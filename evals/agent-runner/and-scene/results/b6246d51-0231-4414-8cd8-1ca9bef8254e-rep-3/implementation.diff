+  const nodes = []; const root = document.querySelector('[data-presentation]'); const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
+  while (walker.nextNode()) { const node = walker.currentNode, parent = node.parentElement, label = node.textContent.trim(); if (!label || !parent || !visible(parent) || parent.closest('[data-presentation-allow-overlap]')) continue; const range = document.createRange(); range.selectNodeContents(node); for (const rect of range.getClientRects()) if (rect.width && rect.height) nodes.push({ element: parent, rect, label }) }
+  for (const element of root.querySelectorAll('button, a')) { if (!visible(element) || element.closest('[data-presentation-allow-overlap]')) continue; nodes.push({ element, rect: element.getBoundingClientRect(), label: element.getAttribute('aria-label') || element.textContent.trim() || element.tagName }) }
+  for (let a=0;a<nodes.length;a++) for(let b=a+1;b<nodes.length;b++) { const x=nodes[a],y=nodes[b]; if(x.element===y.element || x.element.contains(y.element) || y.element.contains(x.element)) continue; const r=x.rect,s=y.rect; if (Math.min(r.right,s.right)-Math.max(r.left,s.left)>2 && Math.min(r.bottom,s.bottom)-Math.max(r.top,s.top)>2) out.push(`overlap: ${x.label} / ${y.label}`) }
+  for (const nav of document.querySelectorAll('[data-presentation-progress], [data-presentation-toc]')) { const active=nav.querySelector('[data-presentation-active="true"]'), inactive=nav.querySelector('[data-presentation-active="false"]'); if(active && inactive) { const a=getComputedStyle(active),b=getComputedStyle(inactive); const properties=['backgroundColor','backgroundImage','boxShadow','opacity','transform']; const visibleBorder=s=>s.borderStyle!=='none' && s.borderWidth!=='0px'; const visibleOutline=s=>s.outlineStyle!=='none' && s.outlineWidth!=='0px'; const sameBorder=(!visibleBorder(a) && !visibleBorder(b)) || (a.borderStyle===b.borderStyle && a.borderWidth===b.borderWidth && a.borderColor===b.borderColor); const sameOutline=(!visibleOutline(a) && !visibleOutline(b)) || (a.outlineStyle===b.outlineStyle && a.outlineWidth===b.outlineWidth && a.outlineColor===b.outlineColor); const same=properties.every(name=>a[name]===b[name]) && sameBorder && sameOutline; const hasVisibleText=active.textContent.trim() && inactive.textContent.trim(); if(same && (!hasVisibleText || (a.color===b.color && a.textDecorationLine===b.textDecorationLine))) out.push(`indistinct active ${nav.hasAttribute('data-presentation-progress') ? 'progress' : 'table of contents'} navigation`) } }
+  const link=document.querySelector('[data-presentation-attribution]'); if(!link || !visible(link) || parseFloat(getComputedStyle(link).fontSize)<11 || (getComputedStyle(link).color==='rgb(0, 0, 238)' && getComputedStyle(link).textDecorationLine.includes('underline'))) out.push('unpolished attribution: style [data-presentation-attribution]')
