@@ -0,0 +1,35 @@
+import type { ComponentPropsWithoutRef, CSSProperties } from 'react'
+import { EASE, LAYOUT_T } from '../constants.ts'
+
+/** Optional absolute placement in design-canvas coordinates. */
+export interface Placement {
+  x?: number
+  y?: number
+  w?: number
+  h?: number
+}
+
+export interface NodeBaseProps extends Placement {
+  /** Stable entity identity; becomes the motion `layoutId` and `data-presentation-entity`. */
+  id?: string
+  className?: string
+  style?: CSSProperties
+}
+
+export const LAYOUT_TRANSITION = { layout: { duration: LAYOUT_T, ease: EASE } }
+
+/** Literal coordinates pass through unchanged; author `style` wins over placement. */
+export function placementStyle(
+  { x, y, w, h }: Placement,
+  style?: CSSProperties,
+): CSSProperties | undefined {
+  const placed = x !== undefined || y !== undefined || w !== undefined || h !== undefined
+  if (!placed) return style
+  return { position: 'absolute', left: x, top: y, width: w, height: h, ...style }
+}
+
+/** Native div props a node accepts besides the ones the kit owns. */
+export type DivProps = Omit<
+  ComponentPropsWithoutRef<'div'>,
+  'style' | 'className' | 'id' | 'onDrag' | 'onDragStart' | 'onDragEnd' | 'onAnimationStart'
+>
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8f7263a8efe9fd39f7cce8990799815806304a91
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
@@ -0,0 +1,17 @@
+const sceneIds = new WeakMap<object, number>()
+let nextSceneId = 0
+function sceneId(Scene: object) {
+  let id = sceneIds.get(Scene)
+  if (id === undefined) {
+    id = nextSceneId++
+    sceneIds.set(Scene, id)
+  }
+  return id
+}
+
+/** Steps with the same group and Scene share one instance; anything else swaps scenes. */
+export function sceneKey(step: { id: string; groupKey?: string; Scene: object }) {
+  // Group keys and step ids live in separate namespaces so an id can never collide with a group.
+  const identity = step.groupKey === undefined ? `step:${step.id}` : `group:${step.groupKey}`
+  return `${identity}:${sceneId(step.Scene)}`
+}
