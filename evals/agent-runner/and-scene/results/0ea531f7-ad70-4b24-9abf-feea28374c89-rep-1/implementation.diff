diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..60c9ee9dcb73ad16807a4e7fdf58c9f1fadf53d4
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,124 @@
+#!/usr/bin/env node
+// Captures one settled screenshot per step from a production preview and prints advisory
+// visual warnings. Screenshots and warnings are for human review, not pass/fail evidence;
+// only runtime/console errors make this command exit non-zero.
+// Usage: node scripts/inspect-presentation.mjs <slug> [--out .inspection] [--settle 1500]
+//        [--viewport 1280x800] [--narrow] [--no-build] [--root <dir>]
+import { spawnSync } from 'node:child_process'
+import { mkdirSync } from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { chromium } from 'playwright'
+import {
+  DEFAULT_SETTLE_MS,
+  captureSequence,
+  collectSnapshot,
+  screenshotPath,
+  stepWarnings,
+} from './lib/inspect-diagnostics.mjs'
+import { freePort, startPreview, trackErrors, waitForStep } from './lib/preview.mjs'
+
+const HELP = `Usage: npm run inspect -- <slug> [options]
+
+Builds the app (unless --no-build), serves it on 127.0.0.1, and writes one settled screenshot
+per step to <out>/<slug>/step-NN.png (<out>/<slug>/narrow/ with --narrow).
+Advisory warnings (text/chrome overlap, indistinct active chrome, unpolished attribution, scene text
+scaled too small to read) are
+printed for review and never change the exit code. Mark an intentional, readable overlap with
+data-presentation-allow-overlap. A warning count of zero is not visual approval.
+
+Options:
+  --out <dir>        output directory (default .inspection)
+  --settle <ms>      wait after each step before capturing (default ${DEFAULT_SETTLE_MS})
+  --viewport WxH     desktop viewport (default 1280x800)
+  --narrow           also capture a 390x844 pass
+  --no-build         reuse the existing dist/
+  --root <dir>       project root (default: parent of scripts/)`
+
+const argv = process.argv.slice(2)
+if (argv.includes('--help') || argv.includes('-h')) {
+  console.log(HELP)
+  process.exit(0)
+}
+const option = (name, fallback) => {
+  const i = argv.lastIndexOf(name) // a later flag overrides an earlier one
+  return i >= 0 ? argv[i + 1] : fallback
+}
+const slug = argv.find((a, i) => !a.startsWith('--') && !['--out', '--settle', '--viewport', '--root'].includes(argv[i - 1]))
+if (!slug) {
+  console.error(HELP)
+  process.exit(2)
+}
+const root = path.resolve(option('--root', path.join(path.dirname(fileURLToPath(import.meta.url)), '..')))
+const outDir = path.resolve(root, option('--out', '.inspection'))
+const settleMs = Number(option('--settle', DEFAULT_SETTLE_MS))
+const [vw, vh] = option('--viewport', '1280x800').split('x').map(Number)
+
+async function capturePass(browser, baseUrl, viewport, variant) {
+  const page = await browser.newPage({ viewport })
+  const errors = trackErrors(page)
+  await page.goto(`${baseUrl}/${slug}`)
+  try {
+    await page.waitForSelector('[data-step-count]', { timeout: 10000 })
+  } catch {
+    errors.push(`no presentation rendered at /${slug}`)
+    return { warnings: [], errors, shots: 0 }
+  }
+  const count = Number(await page.getAttribute('[data-step-count]', 'data-step-count'))
+  const warnings = []
+  let shots = 0
+  await captureSequence({
+    count,
+    settleMs,
+    sleep: (ms) => page.waitForTimeout(ms),
+    advance: async (i) => {
+      if (i === 0) return
+      await page.keyboard.press('ArrowRight')
+      if (!(await waitForStep(page, i))) errors.push(`step ${i + 1}: the step index did not advance`)
+    },
+    capture: async (i) => {
+      const file = screenshotPath(outDir, slug, i, variant)
+      mkdirSync(path.dirname(file), { recursive: true })
+      await page.screenshot({ path: file })
+      shots++
+      warnings.push(...stepWarnings(i + 1, await page.evaluate(collectSnapshot)))
+      if (errors.length) console.error(`ERROR step ${i + 1}: ${errors.join('; ')}`)
+    },
+  })
+  await page.close()
+  return { warnings, errors, shots, count }
+}
+
+async function main() {
+  if (!argv.includes('--no-build')) {
+    const build = spawnSync('npm', ['run', 'build'], { cwd: root, stdio: 'inherit' })
+    if (build.status !== 0) throw new Error('npm run build failed')
+  }
+  const preview = await startPreview(root, await freePort())
+  let browser
+  try {
+    browser = await chromium.launch()
+    const passes = [{ viewport: { width: vw, height: vh }, variant: undefined }]
+    if (argv.includes('--narrow')) passes.push({ viewport: { width: 390, height: 844 }, variant: 'narrow' })
+    let warningCount = 0
+    let failed = false
+    for (const pass of passes) {
+      const result = await capturePass(browser, preview.url, pass.viewport, pass.variant)
+      for (const line of result.warnings) console.log(line)
+      for (const error of result.errors) console.error(`ERROR ${error}`)
+      warningCount += result.warnings.length
+      failed ||= result.errors.length > 0
+      console.log(`inspect: ${result.shots} screenshots for /${slug} (${pass.viewport.width}x${pass.viewport.height}) in ${path.relative(root, outDir) || '.'}`)
+    }
+    console.log(`inspect: ${warningCount} advisory warning(s); review the screenshots, warnings are not approval`)
+    process.exitCode = failed ? 1 : 0
+  } finally {
+    await browser?.close().catch(() => {})
+    await preview.stop()
+  }
+}
+
+main().catch((error) => {
+  console.error(`inspect failed: ${error.message}`)
+  process.exit(1)
+})
diff --git a/scripts/lib/inspect-diagnostics.mjs b/scripts/lib/inspect-diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ce76099cbd2526581e3de0a1c7b18f61d55cf191
--- /dev/null
+++ b/scripts/lib/inspect-diagnostics.mjs
@@ -0,0 +1,198 @@
+// Pure helpers for the screenshot/diagnostic helper. Everything except `collectSnapshot`
+// is plain data-in/data-out so it can be unit-tested without a browser.
+
+/** Longer than a newcomer's layout wait plus fade-in (see presentation-kit constants). */
+export const DEFAULT_SETTLE_MS = 1500
+export const MIN_ATTRIBUTION_PX = 11
+/** Scene text that the fit scale shrinks below this many rendered pixels is hard to read. */
+export const MIN_LEGIBLE_PX = 8
+export const BROWSER_DEFAULT_LINK_COLORS = ['rgb(0, 0, 238)', 'rgb(85, 26, 139)']
+
+/** `<out>/<slug>[/<variant>]/step-NN.png`, one-based and zero-padded. */
+export function screenshotPath(outDir, slug, index, variant) {
+  const name = `step-${String(index + 1).padStart(2, '0')}.png`
+  return [outDir, slug, ...(variant ? [variant] : []), name].join('/')
+}
+
+/**
+ * Visit every step, wait for the transition to settle, then capture it.
+ * `advance(i)` moves to step i (a no-op for the first step); `sleep` waits `settleMs`.
+ */
+export async function captureSequence({ count, advance, sleep, capture, settleMs = DEFAULT_SETTLE_MS }) {
+  for (let i = 0; i < count; i++) {
+    await advance(i)
+    await sleep(settleMs)
+    await capture(i)
+  }
+}
+
+export function rectsOverlap(a, b) {
+  const w = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x)
+  const h = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y)
+  return w > 1 && h > 1
+}
+
+/**
+ * Element: { uid, name, rect:{x,y,w,h}, allow:boolean, ancestors:number[] }.
+ * Elements inside an allow-overlap subtree are exempt; nesting pairs are not collisions.
+ */
+export function findOverlaps(elements) {
+  const found = []
+  for (let i = 0; i < elements.length; i++) {
+    for (let j = i + 1; j < elements.length; j++) {
+      const a = elements[i]
+      const b = elements[j]
+      if (a.allow || b.allow) continue
+      if (a.ancestors.includes(b.uid) || b.ancestors.includes(a.uid)) continue
+      if (rectsOverlap(a.rect, b.rect)) found.push([a.name, b.name])
+    }
+  }
+  return found
+}
+
+const STYLE_KEYS = [
+  'color',
+  'backgroundColor',
+  'borderColor',
+  'borderWidth',
+  'transform',
+  'opacity',
+  'fontWeight',
+  'textDecorationLine',
+  'boxShadow',
+  'outlineStyle',
+]
+
+/**
+ * True when the active entry's computed style matches an inactive one on every visual property.
+ * Progress dots have identical content, so their size is a visual cue; table-of-contents
+ * entries differ in text length, so their size is not.
+ */
+export function isIndistinct(active, inactive, kind) {
+  const keys = kind === 'progress' ? [...STYLE_KEYS, 'width', 'height'] : STYLE_KEYS
+  return keys.every((key) => active[key] === inactive[key])
+}
+
+/** attr: null (missing) or { fontSize:number, color:string }. Returns issue strings. */
+export function attributionIssues(attr) {
+  if (!attr) return ['is missing']
+  const issues = []
+  if (attr.fontSize < MIN_ATTRIBUTION_PX) issues.push(`is too small (${attr.fontSize}px)`)
+  if (BROWSER_DEFAULT_LINK_COLORS.includes(attr.color)) issues.push('uses the browser-default link color')
+  return issues
+}
+
+/**
+ * legibility: null (no scaled scene text) or { scale, smallest: { name, px }, count } where
+ * `px` is the smallest rendered font size and `count` the elements under MIN_LEGIBLE_PX.
+ * Returns an issue string, or null when every scene text is large enough to read.
+ */
+export function legibilityIssue(legibility) {
+  if (!legibility || !legibility.smallest || legibility.smallest.px >= MIN_LEGIBLE_PX) return null
+  const { scale, smallest, count } = legibility
+  return `scene text is too small to read: ${count} element(s) render under ${MIN_LEGIBLE_PX}px (smallest ${smallest.px.toFixed(1)}px in ${smallest.name}) at canvas scale ${scale.toFixed(2)}`
+}
+
+/** Turn one step's snapshot into advisory warning lines. */
+export function stepWarnings(step, snapshot) {
+  const warnings = []
+  for (const [a, b] of findOverlaps(snapshot.elements)) {
+    warnings.push(`WARN step ${step} [overlap] ${a} overlaps ${b}`)
+  }
+  for (const [kind, pair] of Object.entries(snapshot.active)) {
+    if (pair && isIndistinct(pair.active, pair.inactive, kind)) {
+      warnings.push(`WARN step ${step} [active-${kind}] active ${kind} entry looks the same as inactive ones; style [data-presentation-active]`)
+    }
+  }
+  const small = legibilityIssue(snapshot.legibility)
+  if (small) {
+    warnings.push(`WARN step ${step} [legibility] ${small}; enlarge the type, simplify the step, or give the presentation a canvas that suits this viewport`)
+  }
+  for (const issue of attributionIssues(snapshot.attribution)) {
+    warnings.push(`WARN step ${step} [attribution] attribution link ${issue}; style [data-presentation-attribution]`)
+  }
+  return warnings
+}
+
+/** Runs inside the page (serialized by Playwright): must not reference anything outside itself. */
+export function collectSnapshot() {
+  const root = document.querySelector('[data-presentation-root]')
+  if (!root) return { elements: [], active: {}, attribution: null, legibility: null }
+  const CONTROLS =
+    '[data-presentation-progress-item],[data-presentation-prev],[data-presentation-next],[data-presentation-mode-toggle],[data-presentation-toc-item],[data-presentation-attribution]'
+  // Visible means not hidden itself and not inside an invisible ancestor (display, opacity 0).
+  const visible = (el) => {
+    if (getComputedStyle(el).visibility === 'hidden') return false
+    for (let node = el; node && node !== document.documentElement; node = node.parentElement) {
+      const s = getComputedStyle(node)
+      if (s.display === 'none' || Number(s.opacity) === 0) return false
+    }
+    return true
+  }
+  const describe = (el) => {
+    const hook = el.getAttributeNames().find((n) => n.startsWith('data-presentation-') || n === 'data-role' || n === 'data-card-part')
+    const text = (el.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 32)
+    return `${el.tagName.toLowerCase()}${hook ? `[${hook}${el.getAttribute(hook) ? `="${el.getAttribute(hook)}"` : ''}]` : ''}${text ? ` "${text}"` : ''}`
+  }
+  const textRect = (el) => {
+    const range = document.createRange()
+    let rect = null
+    for (const node of el.childNodes) {
+      if (node.nodeType !== Node.TEXT_NODE || !node.textContent.trim()) continue
+      range.selectNodeContents(node)
+      const r = range.getBoundingClientRect()
+      if (!r.width || !r.height) continue
+      rect = rect
+        ? { x1: Math.min(rect.x1, r.left), y1: Math.min(rect.y1, r.top), x2: Math.max(rect.x2, r.right), y2: Math.max(rect.y2, r.bottom) }
+        : { x1: r.left, y1: r.top, x2: r.right, y2: r.bottom }
+    }
+    return rect && { x: rect.x1, y: rect.y1, w: rect.x2 - rect.x1, h: rect.y2 - rect.y1 }
+  }
+  const picked = []
+  for (const el of root.querySelectorAll('*')) {
+    if (!visible(el)) continue
+    const isControl = el.matches(CONTROLS)
+    const rect = isControl ? (({ left, top, width, height }) => ({ x: left, y: top, w: width, h: height }))(el.getBoundingClientRect()) : textRect(el)
+    if (!rect || !rect.w || !rect.h) continue
+    picked.push({ el, rect })
+  }
+  const uids = new Map(picked.map((p, i) => [p.el, i]))
+  const elements = picked.map(({ el, rect }, uid) => {
+    const ancestors = []
+    for (let p = el.parentElement; p && p !== root; p = p.parentElement) if (uids.has(p)) ancestors.push(uids.get(p))
+    return { uid, name: describe(el), rect, allow: el.closest('[data-presentation-allow-overlap]') !== null, ancestors }
+  })
+  const styleOf = (el) => {
+    const s = getComputedStyle(el)
+    return Object.fromEntries(
+      ['color', 'backgroundColor', 'borderColor', 'borderWidth', 'width', 'height', 'transform', 'opacity', 'fontWeight', 'textDecorationLine', 'boxShadow', 'outlineStyle'].map((k) => [k, s[k]]),
+    )
+  }
+  const pairFor = (selector) => {
+    const items = [...root.querySelectorAll(selector)].filter(visible)
+    const active = items.find((el) => el.hasAttribute('data-presentation-active'))
+    const inactive = items.find((el) => !el.hasAttribute('data-presentation-active'))
+    return active && inactive ? { active: styleOf(active), inactive: styleOf(inactive) } : null
+  }
+  // Text inside the fixed canvas is drawn at font-size x the fit scale; report how small it gets.
+  const canvas = root.querySelector('[data-presentation-canvas]')
+  const scale = canvas ? Number(canvas.getAttribute('data-presentation-scale')) || 1 : 1
+  let legibility = null
+  if (canvas) {
+    const sizes = picked
+      .filter(({ el }) => canvas.contains(el) && !el.matches(CONTROLS) && textRect(el))
+      .map(({ el }) => ({ name: describe(el), px: parseFloat(getComputedStyle(el).fontSize) * scale }))
+    if (sizes.length) {
+      const smallest = sizes.reduce((a, b) => (b.px < a.px ? b : a))
+      legibility = { scale, smallest, count: sizes.filter((s) => s.px < 8).length }
+    }
+  }
+  const attr = root.querySelector('[data-presentation-attribution]')
+  const attrStyle = attr && getComputedStyle(attr)
+  return {
+    elements,
+    active: { progress: pairFor('[data-presentation-progress-item]'), toc: pairFor('[data-presentation-toc-item]') },
+    attribution: attr ? { fontSize: parseFloat(attrStyle.fontSize), color: attrStyle.color } : null,
+    legibility,
+  }
+}
diff --git a/scripts/lib/outline.mjs b/scripts/lib/outline.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..dd33a8d1d816c94de5fc0692f92c637148c74fe2
--- /dev/null
+++ b/scripts/lib/outline.mjs
@@ -0,0 +1,62 @@
+// Static checks of the reference sample against the verification config.
+import { existsSync, readFileSync } from 'node:fs'
+import path from 'node:path'
+
+/**
+ * Finds the registry entry for `slug` and returns { title, loadPath } (or a problem).
+ * The registry is a literal array of `{ slug, title, load: () => import('./dir/Talk.tsx') }`.
+ */
+export function findRegistryEntry(registrySource, slug) {
+  for (const match of registrySource.matchAll(/slug:\s*['"`]([^'"`]+)['"`]/g)) {
+    if (match[1] !== slug) continue
+    let start = match.index
+    for (let depth = 0; start > 0; start--) {
+      const ch = registrySource[start]
+      if (ch === '}') depth++
+      else if (ch === '{' && depth-- === 0) break
+    }
+    let end = start
+    for (let depth = 0; end < registrySource.length; end++) {
+      const ch = registrySource[end]
+      if (ch === '{') depth++
+      else if (ch === '}' && --depth === 0) break
+    }
+    const text = registrySource.slice(start, end + 1)
+    return {
+      title: text.match(/title:\s*(['"`])(.*?)\1/)?.[2],
+      loadPath: text.match(/import\(\s*['"`](.+?)['"`]\s*\)/)?.[1],
+    }
+  }
+  return null
+}
+
+/** Returns a list of problems; empty means the registered sample matches the config. */
+export function checkSampleRegistration(root, config) {
+  const registryFile = ['index.ts', 'index.tsx']
+    .map((f) => path.join(root, 'src', 'presentations', f))
+    .find((f) => existsSync(f))
+  if (!registryFile) return ['presentation registry src/presentations/index.ts is missing']
+  const entry = findRegistryEntry(readFileSync(registryFile, 'utf8'), config.slug)
+  if (!entry) return [`sample "${config.slug}" is not registered in src/presentations/index.ts`]
+  const problems = []
+  if (entry.title !== config.title) {
+    problems.push(`sample title is ${JSON.stringify(entry.title)}, expected ${JSON.stringify(config.title)}`)
+  }
+  if (!entry.loadPath) problems.push(`registry entry "${config.slug}" has no import() loader`)
+  else {
+    const base = path.resolve(path.dirname(registryFile), entry.loadPath)
+    if (!existsSync(base)) problems.push(`sample source ${path.relative(root, base)} does not exist`)
+  }
+  return problems
+}
+
+/** Compare what the page rendered at one step with the expected outline row. */
+export function checkRenderedStep(expected, rendered) {
+  const problems = []
+  for (const key of ['era', 'title', 'caption']) {
+    if (rendered[key] !== expected[key]) {
+      problems.push(`${key} is ${JSON.stringify(rendered[key])}, expected ${JSON.stringify(expected[key])}`)
+    }
+  }
+  return problems
+}
diff --git a/scripts/lib/preview.mjs b/scripts/lib/preview.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7601598158bd1ab83b7df0434f8fd8826ae3fb79
--- /dev/null
+++ b/scripts/lib/preview.mjs
@@ -0,0 +1,83 @@
+// Shared by verify.mjs and inspect-presentation.mjs: a production preview on the IPv4 loopback.
+import { spawn } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import net from 'node:net'
+import path from 'node:path'
+
+export const HOST = '127.0.0.1'
+
+export function freePort() {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer()
+    server.once('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+}
+
+/** Starts `vite preview` bound to 127.0.0.1 and resolves once it answers a probe. */
+export async function startPreview(root, port, { timeoutMs = 30000 } = {}) {
+  const vite = path.join(root, 'node_modules', 'vite', 'bin', 'vite.js')
+  if (!existsSync(vite)) throw new Error(`vite is not installed in ${root}; run npm ci`)
+  const child = spawn(process.execPath, [vite, 'preview', '--host', HOST, '--port', String(port), '--strictPort'], {
+    cwd: root,
+    stdio: ['ignore', 'pipe', 'pipe'],
+  })
+  let output = ''
+  child.stdout.on('data', (d) => (output += d))
+  child.stderr.on('data', (d) => (output += d))
+  const exited = new Promise((resolve) => child.once('exit', resolve))
+  const url = `http://${HOST}:${port}`
+  const deadline = Date.now() + timeoutMs
+  for (;;) {
+    if (child.exitCode !== null) throw new Error(`preview exited early:\n${output.trim()}`)
+    try {
+      const res = await fetch(`${url}/`, { signal: AbortSignal.timeout(1500) })
+      if (res.ok) break
+    } catch {
+      /* not ready yet */
+    }
+    if (Date.now() > deadline) {
+      child.kill('SIGKILL')
+      throw new Error(`preview was not ready at ${url} within ${timeoutMs}ms:\n${output.trim()}`)
+    }
+    await new Promise((r) => setTimeout(r, 150))
+  }
+  return {
+    url,
+    async stop() {
+      if (child.exitCode === null) {
+        child.kill('SIGTERM')
+        const timer = setTimeout(() => child.kill('SIGKILL'), 3000)
+        await exited
+        clearTimeout(timer)
+      }
+    },
+  }
+}
+
+/** Collects console and page errors from the moment it is attached. */
+export function trackErrors(page) {
+  const errors = []
+  page.on('console', (msg) => {
+    if (msg.type() === 'error') errors.push(`console.error: ${msg.text()}`)
+  })
+  page.on('pageerror', (err) => errors.push(`uncaught: ${err.message}`))
+  return errors
+}
+
+/** Waits until the chrome reports `index` as the active step; returns false on timeout. */
+export async function waitForStep(page, index, timeout = 4000) {
+  try {
+    await page.waitForFunction(
+      (i) => document.querySelector('[data-step-count]')?.getAttribute('data-step-index') === String(i),
+      index,
+      { timeout },
+    )
+    return true
+  } catch {
+    return false
+  }
+}
diff --git a/scripts/sync-templates.mjs b/scripts/sync-templates.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f8c0fb15d8218dd46193e565c8ef94dd04768267
--- /dev/null
+++ b/scripts/sync-templates.mjs
@@ -0,0 +1,73 @@
+#!/usr/bin/env node
+// Refreshes the bootstrap template snapshot from the canonical sources:
+// the scene kit, the root verification/inspection scripts, and the routing shell are copied
+// byte-for-byte, and the starter presentation is instantiated from templates/presentation.
+// Usage: node scripts/sync-templates.mjs [--check]   (--check exits 1 if anything is stale)
+import { existsSync, mkdirSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync } from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const skill = path.join(root, 'skills', 'presentation')
+const bootstrap = path.join(skill, 'templates', 'bootstrap')
+const check = process.argv.includes('--check')
+
+const STARTER = { slug: 'starter', title: 'Starter presentation' }
+const COPIES = [
+  ['src/presentation-kit', 'src/presentation-kit'],
+  ['scripts/verify.mjs', 'scripts/verify.mjs'],
+  ['scripts/inspect-presentation.mjs', 'scripts/inspect-presentation.mjs'],
+  ['scripts/lib', 'scripts/lib'],
+  ['src/main.tsx', 'src/main.tsx'],
+  ['src/Router.tsx', 'src/Router.tsx'],
+  ['src/route.ts', 'src/route.ts'],
+  ['src/Landing.tsx', 'src/Landing.tsx'],
+]
+
+function files(dir) {
+  if (!existsSync(dir)) return []
+  return readdirSync(dir).flatMap((name) => {
+    const full = path.join(dir, name)
+    return statSync(full).isDirectory() ? files(full) : [full]
+  })
+}
+
+const stale = []
+function write(file, content) {
+  if (existsSync(file) && readFileSync(file, 'utf8') === content) return
+  stale.push(path.relative(root, file))
+  if (!check) {
+    mkdirSync(path.dirname(file), { recursive: true })
+    writeFileSync(file, content)
+  }
+}
+
+for (const [from, to] of COPIES) {
+  const source = path.join(root, from)
+  const sources = statSync(source).isDirectory() ? files(source) : [source]
+  for (const file of sources) {
+    const target = path.join(bootstrap, to, path.relative(source, file))
+    write(target, readFileSync(file, 'utf8'))
+  }
+  // Files deleted from the canonical source must disappear from the snapshot too.
+  if (statSync(source).isDirectory()) {
+    for (const file of files(path.join(bootstrap, to))) {
+      if (!existsSync(path.join(source, path.relative(path.join(bootstrap, to), file)))) {
+        stale.push(path.relative(root, file))
+        if (!check) rmSync(file)
+      }
+    }
+  }
+}
+
+const templateDir = path.join(skill, 'templates', 'presentation')
+for (const file of files(templateDir)) {
+  const text = readFileSync(file, 'utf8').replace(/__SLUG__/g, STARTER.slug).replace(/__TITLE_JSON__/g, JSON.stringify(STARTER.title)).replace(/__KIT__/g, '../../presentation-kit/index.ts')
+  write(path.join(bootstrap, 'src', 'presentations', STARTER.slug, path.relative(templateDir, file)), text)
+}
+
+if (check && stale.length) {
+  console.error(`stale template files:\n${stale.join('\n')}`)
+  process.exit(1)
+}
+console.log(stale.length ? `synced ${stale.length} file(s)` : 'templates are up to date')
diff --git a/scripts/verify.mjs b/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..fb2395141baf612d2811732f4fc16a1fd1737e2e
--- /dev/null
+++ b/scripts/verify.mjs
@@ -0,0 +1,116 @@
+#!/usr/bin/env node
+// Whole-app verification: build -> reference sample present -> render every step in Chromium.
+// Usage: node scripts/verify.mjs [--root <dir>] [--port <n>]   (config: <root>/verify.config.json)
+import { spawn } from 'node:child_process'
+import { existsSync, readFileSync } from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { chromium } from 'playwright'
+import { checkRenderedStep, checkSampleRegistration } from './lib/outline.mjs'
+import { HOST, freePort, startPreview, trackErrors, waitForStep } from './lib/preview.mjs'
+
+const argv = process.argv.slice(2)
+const rootArg = argv.indexOf('--root')
+const root = path.resolve(rootArg >= 0 ? argv[rootArg + 1] : path.join(path.dirname(fileURLToPath(import.meta.url)), '..'))
+
+const portArg = argv.indexOf('--port')
+
+class PhaseError extends Error {
+  constructor(phase, message) {
+    super(message)
+    this.phase = phase
+  }
+}
+
+function runBuild() {
+  return new Promise((resolve, reject) => {
+    const child = spawn('npm', ['run', 'build'], { cwd: root, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (d) => (output += d))
+    child.stderr.on('data', (d) => (output += d))
+    child.on('error', (e) => reject(new PhaseError('build', `could not run npm: ${e.message}`)))
+    child.on('exit', (code) => {
+      if (code === 0) resolve()
+      else reject(new PhaseError('build', `npm run build exited ${code}\n${output.trim().split('\n').slice(-25).join('\n')}`))
+    })
+  })
+}
+
+async function renderEveryStep(config, settleMs) {
+  const port = portArg >= 0 ? Number(argv[portArg + 1]) : await freePort()
+  let preview
+  let browser
+  try {
+    preview = await startPreview(root, port).catch((e) => {
+      throw new PhaseError('render', `preview failed to start: ${e.message}`)
+    })
+    browser = await chromium.launch().catch((e) => {
+      throw new PhaseError('render', `browser failed to launch: ${e.message}`)
+    })
+    const page = await browser.newPage({ viewport: { width: 1280, height: 800 } })
+    const errors = trackErrors(page)
+    const route = `${preview.url}/${config.slug}`
+    await page.goto(route)
+    try {
+      await page.waitForSelector('[data-step-count]', { timeout: 10000 })
+    } catch {
+      throw new PhaseError('render', `step 0: ${route} did not render a presentation${errors.length ? `\n${errors.join('\n')}` : ''}`)
+    }
+    const count = Number(await page.getAttribute('[data-step-count]', 'data-step-count'))
+    if (count !== config.steps.length) {
+      throw new PhaseError('outline', `sample has ${count} steps, expected ${config.steps.length}`)
+    }
+    if ((await page.getAttribute('[data-presentation-root]', 'data-presentation-mode')) !== 'browse') await page.keyboard.press('p')
+    for (let i = 0; i < count; i++) {
+      if (i > 0) {
+        await page.keyboard.press('ArrowRight')
+      }
+      if (!(await waitForStep(page, i))) {
+        throw new PhaseError('render', `step ${i}: the step index did not advance to ${i}${errors.length ? `\n${errors.join('\n')}` : ''}`)
+      }
+      await page.waitForTimeout(settleMs)
+      const rendered = await page.evaluate(() => ({
+        era: document.querySelector('[data-presentation-marker]')?.getAttribute('data-presentation-era'),
+        title: document.querySelector('[data-presentation-title]')?.textContent,
+        caption: document.querySelector('[data-presentation-caption]')?.textContent,
+      }))
+      const problems = checkRenderedStep(config.steps[i], rendered)
+      if (problems.length) throw new PhaseError('outline', `step ${i}: ${problems.join('; ')}`)
+      if (errors.length) throw new PhaseError('render', `step ${i}: ${errors.join('; ')}`)
+      console.log(`verify: [render] ${config.slug}: step ${i} ok (${rendered.title})`)
+    }
+    return { count, url: route }
+  } finally {
+    await browser?.close().catch(() => {})
+    await preview?.stop()
+  }
+}
+
+async function main() {
+  const configPath = path.join(root, 'verify.config.json')
+  if (!existsSync(configPath)) throw new PhaseError('config', `${configPath} is missing`)
+  const { presentations = [], settleMs = 1500 } = JSON.parse(readFileSync(configPath, 'utf8'))
+  if (!presentations.length) throw new PhaseError('config', 'verify.config.json lists no presentations')
+  console.log(`verify: root ${root}`)
+
+  console.log('verify: [build] npm run build')
+  await runBuild()
+
+  const rendered = []
+  for (const config of presentations) {
+    console.log(`verify: [sample] ${config.slug}`)
+    const problems = checkSampleRegistration(root, config)
+    if (problems.length) throw new PhaseError('sample', problems.join('; '))
+
+    console.log(`verify: [render] ${config.slug}: stepping through ${config.steps.length} steps on http://${HOST}`)
+    const { count, url } = await renderEveryStep(config, settleMs)
+    rendered.push(`${count} steps at ${url}`)
+  }
+  console.log(`PASS verify: build, sample, render (${rendered.join('; ')}; no console or page errors)`)
+}
+
+main().catch((error) => {
+  const phase = error instanceof PhaseError ? error.phase : 'internal'
+  console.error(`FAIL verify [${phase}]: ${error.message}`)
+  process.exit(1)
+})
diff --git a/skills/presentation/SKILL.md b/skills/presentation/SKILL.md
new file mode 100644
index 0000000000000000000000000000000000000000..c3fdda72f52bb1d7e67bbe049f600d57bbf6f56b
--- /dev/null
+++ b/skills/presentation/SKILL.md
@@ -0,0 +1,185 @@
+---
+name: presentation
+description: Create or modify a browser presentation that works as one evolving diagram (stable entities that appear, move, connect and re-label across named steps) from a topic. Use when asked to make, build, create, update, change or fix a presentation, talk, or evolving-scene deck. Self-bootstraps the Vite + React + TypeScript app, the scene kit and the presentation index, then builds, renders and visually checks the result.
+---
+
+# Presentation
+
+A presentation is **one scene moving through named steps**, not a deck of slides. Entities have
+stable ids; between steps they morph in place, new ones fade in after the others settle, and
+departing ones fade out. "Presentation" is the canonical term ("talk" is only a synonym; the entry
+file is `Talk.tsx`).
+
+## 0. Where things are
+
+`SKILL_DIR` is the directory that contains this `SKILL.md`. Resolve it to an absolute path first
+and use it for everything below. Never look for templates relative to the current working
+directory.
+
+- `SKILL_DIR/templates/bootstrap/`: the full app (build setup, scene kit, presentation index,
+  starter presentation, `verify`/`inspect` scripts, committed lockfile).
+- `SKILL_DIR/templates/presentation/`: the files of one new presentation (`entities.ts`,
+  `Scene.tsx`, `steps.ts`, `Talk.tsx`, `style.css`).
+- `SKILL_DIR/scripts/presentation-tool.mjs`: deterministic helper (`detect`, `scaffold`, `new`).
+  Run it as `node "$SKILL_DIR/scripts/presentation-tool.mjs" <command>`; it finds the templates
+  from its own location, so it works from any directory.
+
+Every request, whether it **creates** or **modifies** a presentation, goes through section 2
+(infrastructure) before any presentation file is written.
+
+## 1. Gather the details (create only)
+
+Ask clarifying questions **one at a time** (never a list of questions in one message) until you have:
+
+1. the **topic**,
+2. the **visual style** (mood, palette, typography, density),
+3. for each step, its **content** and its **visual description** (which entities appear, move,
+   connect or change).
+
+Rules:
+
+- Ask for anything missing from the prompt; do not invent an answer the user can still give.
+- The user decides how much detail to give. If they choose to build with partial detail, build
+  from what you have and iterate afterwards. There is no completeness gate and no mandatory
+  re-interview. Mark gaps you filled in your final summary.
+- If the prompt already contains the topic, the style and every step's details, skip the
+  questions and build.
+- For a key or visually complex step you may draw an ASCII mockup and ask the user to confirm the
+  layout before building. This is optional and selective: never mock up every step.
+
+## 2. Ensure the infrastructure (create and modify)
+
+A generated presentation depends on three **contract anchors** in one app directory. Detection is
+by contract, not by byte-identical files: renamed files, formatting and extra dependencies do not
+count as missing.
+
+1. **Build setup**: a `package.json` with a `build` script that runs a Vite + React + TypeScript
+   build (`react`, `react-dom`, `vite`, `typescript`), a Vite config and tsconfig files.
+2. **Scene kit**: the presentation-agnostic engine: the `Step`/`Scene` step contract
+   (`Step`, `SceneProps`), a stage/host that mounts the active step and runs entity morphs
+   (`Stage`, `Presentation`), present/browse navigation (`use…Nav`), the chrome (caption, table of
+   contents, progress, prev/next) and the fit-scaled design canvas (`use…Fit…`).
+3. **Presentation index**: a registry mapping each presentation to its own route (entries with
+   `slug`, `title`, `load`), plus the router that reads `location.pathname` and loads the matching
+   entry.
+
+Procedure:
+
+1. **Detect and resolve the target.** Run
+   `node "$SKILL_DIR/scripts/presentation-tool.mjs" detect <project root>`. It reports `target`,
+   `reason`, `anchors`, `missing`, `empty` and `needsConfirmation`. Target rules:
+   - already inside a presentation app (all anchors at the root, or an existing app in
+     `presentations/`): use it;
+   - **monorepo** (any one of `workspaces` in `package.json`, `pnpm-workspace.yaml`, a `packages/`
+     or `apps/` directory): scaffold a self-contained app in `presentations/` and leave the
+     monorepo root untouched. Say which signal you used;
+   - empty or standalone project: scaffold at the repository root.
+2. **Confirm before writing into a non-empty project.** When `needsConfirmation` is true (the
+   project is non-empty and scaffold files will be written), tell the user the resolved target and
+   what will be added, and wait for their confirmation before copying or installing anything. No
+   confirmation is needed for an empty directory, or when all three anchors are present and only
+   presentation files are written.
+3. **Scaffold only what is missing.** Run
+   `node "$SKILL_DIR/scripts/presentation-tool.mjs" scaffold <target> --only <missing anchors, comma separated> --install`.
+   - Empty directory or none of the anchors present: scaffold all three, then install.
+   - All anchors present: skip scaffolding entirely and go to section 3 or 4.
+   - Partial scaffold: scaffold only the missing anchors. Existing files are **never**
+     overwritten; `package.json` only gains missing dependencies and scripts; an existing lockfile,
+     Vite config or registry is kept as it is. If an existing anchor lives at different paths
+     than the starter files assume, adapt the new files' imports instead of replacing the anchor.
+   - If the app already has a `src/main.tsx`, the helper keeps it and mounts its `<App />` as the
+     router's `fallback`; if it reports `manual`, mount `<Router />` from `src/Router.tsx` yourself
+     so `/<slug>` routes load.
+   - Do not assume any dependency is installed. The scaffold declares React, Vite, TypeScript,
+     the `@types/*` packages, Motion, Lucide icons, ESLint and Playwright; `--install` runs
+     `npm ci` (new lockfile) or `npm install`. If Chromium is missing, run
+     `npx playwright install chromium`.
+4. The scaffold is **style-neutral**: no Tailwind or other styling framework, no theme, colors,
+   fonts, spacing scale, card or button styles. Do not add any styling framework unless the host
+   project already uses one or the user explicitly asks for it.
+
+## 3. Create a presentation
+
+1. Pick a slug (lowercase words joined by hyphens) and a title.
+2. `node "$SKILL_DIR/scripts/presentation-tool.mjs" new <target> <slug> --title "<title>"` writes
+   a `<slug>/` folder from the template next to the presentation registry (its own folder, route
+   `/<slug>`, kit imports resolved relative to the detected scene kit) and appends one entry to that
+   registry. It refuses to overwrite an existing folder or slug, and
+   it leaves every other presentation and registry entry as they are.
+3. Replace the template content with the real presentation:
+   - `entities.ts`: this presentation's entity namespace: stable ids, the step each first appears in,
+     and geometry in the 880 × 380 design canvas.
+   - `Scene.tsx`: one scene composed from the kit primitives (`Box`, `Label`, `Arrow`, `Frame`,
+     `Emphasis`, `SymbolChip`, `Appear`, `SceneLayer`). Raw `motion` elements with a stable
+     `layoutId` are fine for coordinate-heavy diagrams. Glyphs are Lucide components
+     (`icon={User}`); no custom SVG authoring is required.
+   - `steps.ts`: an ordered `Step[]`. Every step has a stable `id`, an `era` (table-of-contents
+     section), a one-line `title`, a paragraph `caption` and a `Scene` + `payload`. Steps that are
+     successive states of the same diagram share `groupKey` and the same `Scene`, so the scene
+     persists and only the payload changes. Step numbers come from position; never number steps by
+     hand.
+   - `Talk.tsx`: `<Presentation steps={STEPS} title="…" initialMode="browse" />`.
+4. Design rules for the scene: entities that continue keep their id and morph in place (do not
+   re-create them with new ids); wrap only newcomers in `Appear`; keep every entity inside the
+   canvas and clear of the chrome (caption, progress, table of contents, navigation); overlapping
+   or stacked entities are fine when intentional and readable.
+5. **Styling belongs to the presentation.** Put the look in `src/presentations/<slug>/style.css`
+   (plain CSS by default), targeting the kit's `data-presentation-*` hooks. Never edit
+   `src/presentation-kit/` to add colors, fonts, borders or other visual defaults. The CSS must
+   also: make the active progress dot and active table-of-contents entry visibly different from
+   inactive ones (`[data-presentation-active]`), and make the attribution link
+   (`[data-presentation-attribution]`) legible: sized, colored and not browser-default. Style
+   responsively when the layout depends on width.
+6. Add the presentation's outline (`slug`, `title`, and each step's `era`, `title`, `caption`) to
+   `verify.config.json` so `npm run verify` renders it.
+
+## 4. Modify a presentation
+
+1. Identify the target. If the request does not clearly name one presentation, **list the
+   presentations in `src/presentations/index.ts` and ask which to modify before changing
+   anything**. Never silently pick one (including the first or the sample).
+2. Ask only about the requested change (steps, entities or style). Do not repeat the create
+   interview and do not touch other presentations.
+3. Edit that presentation's files (and its `verify.config.json` outline if titles or captions
+   changed). Keep continuing entities' ids so they still morph.
+4. Run section 5 in full.
+
+## 5. Self-verify before reporting success
+
+Do all of these, in order, for the presentation you created or modified. Do not report success
+while any of them fails.
+
+1. **Build:** `npm run build` (no type errors).
+2. **Render the target route:** open `/<slug>` in a real browser and confirm its first step renders
+   with no runtime, console or page errors. `npm run inspect -- <slug>` does this for every step
+   and exits non-zero on errors. `npm run verify` is not a substitute: it only renders the
+   presentations listed in `verify.config.json`. In a host that has no such scripts, write a
+   temporary Playwright script **inside the project root** (so it resolves the project's own
+   dependencies), run it, and delete it.
+3. **Visual composition:** use the project-local helper `npm run inspect -- <slug> --narrow`
+   (screenshots under `.inspection/<slug>/`, settled after the transitions) when it exists.
+   Only if it is unavailable use an equivalent browser view, again from a script inside the
+   project root. Look at the screenshots of the **first step, the last step, and every dense or
+   key step**, and also the **narrow viewport** whenever the layout is responsive-sensitive.
+   Check that important content fits the canvas, intentional overlaps stay readable, and nothing
+   collides with the caption, progress dots, table of contents or navigation controls.
+4. **Warnings:** read every `WARN` line the helper prints. Open the step it names, then fix
+   accidental collisions, indistinct active progress/ToC styling and unpolished attribution
+   (style `[data-presentation-active]` / `[data-presentation-attribution]` in the presentation's
+   CSS). A `[legibility]` warning means the fit scale shrinks scene text below readable size at
+   that viewport (typically `--narrow`): enlarge the type, simplify the step, or give the
+   presentation a canvas that suits that width; do not report a narrow layout as fine while it
+   is unreadable. Mark a subtree with `data-presentation-allow-overlap` **only** when the overlap is
+   intentional and readable, and mark only that subtree, never a whole scene. Rerun the helper
+   and re-inspect. A warning count of zero is not visual approval.
+5. **Final gate:** where the scaffolded scripts exist (`npm run verify` in the project's
+   `package.json`), run `npm run verify` (it builds the whole app and renders every presentation
+   listed in `verify.config.json`, failing on any console or page error). A host app that has no
+   such script is not required to gain one: its completion gate is steps 1-4 (build, error-free
+   first-step render of the target route, visual check) using equivalent commands.
+6. If any check fails, fix the cause and repeat the checks that could be affected, including the
+   visual ones. Rerunning only the build after a visual fault is not enough.
+
+Finish with a short summary: the route, the files changed, the checks you ran, the advisory
+warnings that remain and why they are acceptable, and any detail you filled in on the user's
+behalf.
