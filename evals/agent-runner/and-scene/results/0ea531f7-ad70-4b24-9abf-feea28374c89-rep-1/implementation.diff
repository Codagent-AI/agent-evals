diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..e1e1546e327d975de5328fc0e87c31317184c0b5
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,97 @@
+import { useEffect, useState, type ReactNode } from 'react'
+import { Attribution, type AttributionOptions } from './chrome/Attribution.tsx'
+import { Footer } from './chrome/Footer.tsx'
+import { Header } from './chrome/Header.tsx'
+import type { ChromeSlots } from './chrome/slots.ts'
+import { Toc } from './chrome/Toc.tsx'
+import { DEFAULT_MODE, TOC_MIN_VIEWPORT } from './constants.ts'
+import { Stage } from './Stage.tsx'
+import type { Canvas, Mode, Step } from './types.ts'
+import { usePresentationNav } from './usePresentationNav.ts'
+
+export interface PresentationProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  title?: string
+  initialMode?: Mode
+  canvas?: Canvas
+  /** Host-provided top-left brand. */
+  brand?: ReactNode
+  /** Override the default "made by and-scene" attribution, or pass `false` to omit it. */
+  attribution?: AttributionOptions | false
+  /** Props forwarded to individual chrome parts for presentation-owned styling. */
+  slots?: ChromeSlots
+}
+
+function useViewportWidth() {
+  const [width, setWidth] = useState(() => window.innerWidth)
+  useEffect(() => {
+    const onResize = () => setWidth(window.innerWidth)
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return width
+}
+
+/** Hosts a list of steps as one evolving scene with present/browse chrome and navigation. */
+export function Presentation<TPayload>({
+  steps,
+  title,
+  initialMode = DEFAULT_MODE,
+  canvas,
+  brand,
+  attribution,
+  slots = {},
+}: PresentationProps<TPayload>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const viewportWidth = useViewportWidth()
+  const step = steps[nav.index]
+  if (!step) return null
+  const showToc = nav.mode === 'browse' && viewportWidth >= TOC_MIN_VIEWPORT
+
+  return (
+    <div
+      style={{ position: 'fixed', inset: 0, display: 'flex', flexDirection: 'column' }}
+      {...slots.root}
+      data-presentation-root=""
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      data-step-id={step.id}
+    >
+      <Header
+        step={step}
+        index={nav.index}
+        mode={nav.mode}
+        deckTitle={title}
+        brand={brand}
+        onToggleMode={nav.toggleMode}
+        slot={slots.header}
+        toggleSlot={slots.modeToggle}
+      />
+      <div style={{ display: 'flex', flex: '1 1 auto', minHeight: 0 }} data-presentation-main="">
+        {showToc ? <Toc steps={steps} index={nav.index} onJump={nav.goTo} slot={slots.toc} /> : null}
+        <Stage
+          step={step}
+          index={nav.index}
+          mode={nav.mode}
+          canvas={canvas}
+          viewportSlot={slots.stage}
+          canvasSlot={slots.canvas}
+        />
+      </div>
+      <Footer
+        steps={steps}
+        index={nav.index}
+        mode={nav.mode}
+        onJump={nav.goTo}
+        onPrev={nav.prev}
+        onNext={nav.next}
+        slot={slots.footer}
+        progressSlot={slots.progress}
+        prevSlot={slots.prev}
+        nextSlot={slots.next}
+      />
+      {attribution === false ? null : <Attribution options={attribution} slot={slots.attribution} />}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..47b39fec61452bc3b8b4d57e8cedeb049dcce26e
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,63 @@
+import { useRef } from 'react'
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, EASE, ENTER_T, EXIT_T } from './constants.ts'
+import type { SlotProps } from './chrome/slots.ts'
+import { sceneKey } from './sceneKey.ts'
+import { useFitScale } from './useFitScale.ts'
+import type { Canvas, Mode, Step } from './types.ts'
+
+export interface StageProps<TPayload> {
+  step: Step<TPayload>
+  index: number
+  mode: Mode
+  canvas?: Canvas
+  viewportSlot?: SlotProps
+  canvasSlot?: SlotProps
+}
+
+/** Fixed design canvas, scaled uniformly to its viewport, hosting the active step's Scene. */
+export function Stage<TPayload>({ step, index, mode, canvas, viewportSlot, canvasSlot }: StageProps<TPayload>) {
+  const width = canvas?.width ?? DESIGN_W
+  const height = canvas?.height ?? DESIGN_H
+  const viewport = useRef<HTMLDivElement>(null)
+  const scale = useFitScale(viewport, mode, width, height)
+  const { Scene, payload, ...meta } = step
+  return (
+    <div
+      ref={viewport}
+      style={{ position: 'relative', flex: '1 1 auto', minWidth: 0, minHeight: 0, overflow: 'hidden' }}
+      {...viewportSlot}
+      data-presentation-stage=""
+    >
+      <div
+        style={{
+          position: 'absolute',
+          left: '50%',
+          top: '50%',
+          width,
+          height,
+          transform: `translate(-50%, -50%) scale(${scale})`,
+          transformOrigin: 'center center',
+        }}
+        {...canvasSlot}
+        data-presentation-canvas=""
+        data-presentation-scale={scale}
+      >
+        <LayoutGroup>
+          <AnimatePresence>
+            <motion.div
+              key={sceneKey(step)}
+              style={{ position: 'absolute', inset: 0 }}
+              initial={{ opacity: 0 }}
+              animate={{ opacity: 1, transition: { duration: ENTER_T, ease: EASE } }}
+              exit={{ opacity: 0, transition: { duration: EXIT_T, ease: EASE } }}
+              data-presentation-scene=""
+            >
+              <Scene payload={payload} step={meta} index={index} mode={mode} />
+            </motion.div>
+          </AnimatePresence>
+        </LayoutGroup>
+      </div>
+    </div>
+  )
+}
