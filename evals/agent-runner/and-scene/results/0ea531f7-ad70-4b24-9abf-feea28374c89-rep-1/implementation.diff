@@ -0,0 +1,42 @@
+import type { ReactNode } from 'react'
+import { stepNumber } from '../model.ts'
+import type { Mode, StepMeta } from '../types.ts'
+import type { SlotProps } from './slots.ts'
+
+export interface HeaderProps {
+  step: StepMeta
+  index: number
+  mode: Mode
+  deckTitle?: string
+  /** Host-provided brand for the top-left slot; nothing is rendered by default. */
+  brand?: ReactNode
+  onToggleMode: () => void
+  slot?: SlotProps
+  toggleSlot?: SlotProps
+}
+
+export function Header({ step, index, mode, deckTitle, brand, onToggleMode, slot, toggleSlot }: HeaderProps) {
+  return (
+    <header
+      style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flex: '0 0 auto' }}
+      {...slot}
+      data-presentation-header=""
+    >
+      <div data-presentation-header-start="">
+        {brand !== undefined && brand !== null ? <span data-presentation-brand="">{brand}</span> : null}
+      </div>
+      <div data-presentation-header-middle="">
+        <span data-presentation-marker="" data-presentation-era={step.era}>
+          {stepNumber(index)}
+        </span>
+        {mode === 'browse' ? <h1 data-presentation-title="">{step.title}</h1> : null}
+        {deckTitle ? <span data-presentation-deck-title="">{deckTitle}</span> : null}
+      </div>
+      <div data-presentation-header-end="">
+        <button type="button" onClick={onToggleMode} {...toggleSlot} data-presentation-mode-toggle="" data-presentation-mode={mode}>
+          {mode === 'browse' ? 'Present' : 'Browse'}
+        </button>
+      </div>
+    </header>
+  )
+}
diff --git a/src/presentation-kit/chrome/Toc.tsx b/src/presentation-kit/chrome/Toc.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c38b9521624787d8007d67c1330c4023250f2287
--- /dev/null
+++ b/src/presentation-kit/chrome/Toc.tsx
@@ -0,0 +1,38 @@
+import { activeEraIndex, eraSections } from '../model.ts'
+import type { StepMeta } from '../types.ts'
+import type { SlotProps } from './slots.ts'
+
+export interface TocProps {
+  steps: readonly StepMeta[]
+  index: number
+  onJump: (index: number) => void
+  slot?: SlotProps
+}
+
+/** Era-based table of contents; entries jump to the first step of their era. */
+export function Toc({ steps, index, onJump, slot }: TocProps) {
+  const eras = eraSections(steps)
+  const active = activeEraIndex(eras, index)
+  return (
+    <nav aria-label="Table of contents" {...slot} data-presentation-toc="">
+      <ol>
+        {eras.map((era, i) => {
+          const isActive = i === active
+          return (
+            <li key={`${era.label}:${era.firstIndex}`}>
+              <button
+                type="button"
+                onClick={() => onJump(era.firstIndex)}
+                aria-current={isActive ? 'true' : undefined}
+                data-presentation-toc-item=""
+                data-presentation-active={isActive ? '' : undefined}
+              >
+                {era.label}
+              </button>
+            </li>
+          )
+        })}
