+// @vitest-environment node
+import { spawnSync } from 'node:child_process'
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { afterAll, describe, expect, it } from 'vitest'
+import { listFiles } from '../helpers'
+
+// INT-001: the bootstrap snapshot, materialized into a fresh directory outside this repository
+// by the skill's own helper, builds, lints, and passes its local verification with a presentation
+// generated from templates/presentation.
+const repoRoot = join(dirname(fileURLToPath(import.meta.url)), '..', '..')
+const skillRoot = join(repoRoot, 'skills', 'presentation')
+const helper = join(skillRoot, 'scripts', 'scaffold.mjs')
+const npm = process.platform === 'win32' ? 'npm.cmd' : 'npm'
+// Dependency install and Chromium provisioning dominate; the cache keeps repeat runs practical.
+const MATERIALIZE_TIMEOUT_MS = 900_000
+// Removing an installed app tree can outlast the default 10s hook timeout when suites run in parallel.
+const CLEANUP_TIMEOUT_MS = 120_000
+
+const disposables: string[] = []
+
+afterAll(() => {
+  for (const dir of disposables) rmSync(dir, { recursive: true, force: true })
+}, CLEANUP_TIMEOUT_MS)
+
+function tempDir(prefix: string): string {
+  const dir = mkdtempSync(join(tmpdir(), prefix))
+  disposables.push(dir)
+  return dir
+}
+
+function step(command: string, args: string[], cwd: string, timeout: number) {
+  const run = spawnSync(command, args, { cwd, encoding: 'utf8', timeout, maxBuffer: 64 * 1024 * 1024 })
+  const output = `${run.stdout ?? ''}${run.stderr ?? ''}`
+  return { status: run.status, output }
+}
+
+function expectPassing(label: string, result: { status: number | null; output: string }) {
+  if (result.status !== 0) console.error(`${label} failed:\n${result.output}`)
+  expect(result.status, label).toBe(0)
+}
+
+describe('INT-001 materialized bootstrap is complete and style-neutral', () => {
+  it(
+    'scaffolds, installs from the committed lock, builds, lints, and verifies a generated presentation',
+    () => {
+      // The helper runs from a directory unrelated to the skill and to the repository.
+      const elsewhere = tempDir('and-scene-int-cwd-')
+      const app = join(tempDir('and-scene-int-app-'), 'app')
+      mkdirSync(app)
+
+      const scaffold = step(process.execPath, [helper, 'scaffold', app, '--no-install'], elsewhere, 120_000)
+      expectPassing('scaffold', scaffold)
+      const add = step(
+        process.execPath,
+        [helper, 'add', app, '--slug', 'int-check', '--title', 'Integration check'],
+        elsewhere,
+        120_000,
+      )
+      expectPassing('add presentation', add)
+
+      expectPassing('npm ci', step(npm, ['ci', '--no-audit', '--no-fund'], app, 600_000))
+      expectPassing('npm run build', step(npm, ['run', 'build'], app, 300_000))
+      expectPassing('npm run lint', step(npm, ['run', 'lint'], app, 300_000))
+      const verify = step(npm, ['run', 'verify'], app, 900_000)
+      expectPassing('npm run verify', verify)
+      expect(verify.output).toMatch(/PASS: int-check \(1 steps\)/)
+      expect(verify.output).toMatch(/ok int-check: step 1\/1/)
+
+      // Three anchors and the full dependency set.
+      for (const anchor of ['vite.config.ts', 'src/presentation-kit/Presentation.tsx', 'src/presentations/index.ts']) {
+        expect(existsSync(join(app, anchor)), anchor).toBe(true)
+      }
+      const pkg = JSON.parse(readFileSync(join(app, 'package.json'), 'utf8')) as {
+        dependencies: Record<string, string>
+        devDependencies: Record<string, string>
+      }
+      const declared = { ...pkg.dependencies, ...pkg.devDependencies }
+      for (const name of [
+        'react',
+        'react-dom',
+        'motion',
+        'lucide-react',
+        'vite',
+        '@vitejs/plugin-react',
+        'typescript',
+        '@types/react',
+        '@types/react-dom',
+        '@types/node',
+        'eslint',
+        'typescript-eslint',
+        'playwright',
+      ]) {
+        expect(declared[name], name).toBeDefined()
+      }
+      expect(Object.keys(declared).filter((name) => /tailwind/.test(name))).toEqual([])
+
+      // Kit files are byte-identical to the canonical source.
+      const canonicalKit = join(repoRoot, 'src', 'presentation-kit')
+      const kitFiles = listFiles(canonicalKit).filter((file) => !/\.test\./.test(file))
+      expect(listFiles(join(app, 'src', 'presentation-kit'))).toEqual(kitFiles)
+      for (const file of kitFiles) {
+        expect(readFileSync(join(app, 'src', 'presentation-kit', file), 'utf8'), file).toBe(
+          readFileSync(join(canonicalKit, file), 'utf8'),
+        )
+      }
+
+      // The scaffold's host CSS carries no visual defaults.
+      const hostCss = readFileSync(join(app, 'src', 'index.css'), 'utf8')
+      expect(hostCss).not.toMatch(/\b(color|font|font-family|background|border|box-shadow)\s*:/)
+    },
+    MATERIALIZE_TIMEOUT_MS,
+  )
+})
diff --git a/tests/integration/inspect-presentation.test.ts b/tests/integration/inspect-presentation.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..43274e318632b2929c8b8f40886feab79565f150
--- /dev/null
+++ b/tests/integration/inspect-presentation.test.ts
@@ -0,0 +1,134 @@
+// @vitest-environment node
+import { spawnSync } from 'node:child_process'
+import { mkdtempSync, readdirSync, readFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { afterAll, describe, expect, it } from 'vitest'
+import { isPortOpen } from '../helpers'
+
+// INT-002: the screenshot helper drives a production preview of a controlled multi-step
+// presentation and writes one settled screenshot per step plus advisory warnings.
+const repoRoot = join(dirname(fileURLToPath(import.meta.url)), '..', '..')
+const helper = join(repoRoot, 'scripts', 'inspect-presentation.mjs')
+const fixtureRoot = join(repoRoot, 'tests', 'fixtures', 'inspect-app')
+const RUN_TIMEOUT_MS = 240_000
+// Short enough to keep the suite quick, long enough to clear the kit's 1.0s transition window.
+const SETTLE_MS = 1_200
+const STEP_COUNT = 4
+
+const disposables: string[] = []
+
+afterAll(() => {
+  for (const dir of disposables) rmSync(dir, { recursive: true, force: true })
+})
+
+interface RunResult {
+  status: number | null
+  output: string
+  outDir: string
+  port: number | null
+}
+
+function runHelper(slug: string, extra: string[] = []): RunResult {
+  const outDir = mkdtempSync(join(tmpdir(), 'and-scene-inspect-'))
+  disposables.push(outDir)
+  const run = spawnSync(
+    process.execPath,
+    [helper, slug, '--root', fixtureRoot, '--out', outDir, '--settle', String(SETTLE_MS), ...extra],
+    { encoding: 'utf8', timeout: RUN_TIMEOUT_MS, maxBuffer: 32 * 1024 * 1024 },
+  )
+  const output = `${run.stdout ?? ''}${run.stderr ?? ''}`
+  if (run.status !== 0) console.error(output)
+  const portMatch = output.match(/preview http:\/\/127\.0\.0\.1:(\d+)/)
+  return { status: run.status, output, outDir, port: portMatch ? Number(portMatch[1]) : null }
+}
+
+function warningsFor(output: string, kind: string): string[] {
+  return output.split('\n').filter((line) => line.startsWith(`warning [${kind}]`))
+}
+
+describe('INT-002 screenshot helper emits faithful artifacts and advisory warnings', () => {
+  it(
+    'writes one settled PNG per step, reports nothing for a clean presentation, and releases its preview',
+    async () => {
+      const result = runHelper('clean')
+      expect(result.status).toBe(0)
+      expect(result.output).toMatch(/http:\/\/127\.0\.0\.1:\d+/)
+      expect(result.output).not.toMatch(/localhost/)
+      expect(result.output).not.toMatch(/warning \[/)
+
+      const files = readdirSync(join(result.outDir, 'clean')).filter((name) => name.endsWith('.png')).sort()
+      expect(files).toEqual(
+        Array.from({ length: STEP_COUNT }, (_, index) => `step-${String(index).padStart(2, '0')}.png`),
+      )
+      for (const file of files) {
+        const bytes = readFileSync(join(result.outDir, 'clean', file))
+        expect(bytes.subarray(0, 8).toString('hex')).toBe('89504e470d0a1a0a')
+      }
+
+      const manifest = JSON.parse(readFileSync(join(result.outDir, 'clean', 'manifest.json'), 'utf8'))
+      expect(manifest.steps).toHaveLength(STEP_COUNT)
+      manifest.steps.forEach((step: { index: number; settledMs: number }, index: number) => {
+        expect(step.index).toBe(index)
+        // Capture happens only after the configured settle interval has elapsed since the step changed.
+        expect(step.settledMs).toBeGreaterThanOrEqual(SETTLE_MS)
+      })
+
+      expect(result.port).not.toBeNull()
+      expect(await isPortOpen(result.port as number)).toBe(false)
+    },
+    RUN_TIMEOUT_MS,
+  )
+
+  it(
+    'names the step and both elements for an unmarked text collision',
+    () => {
+      const result = runHelper('collision')
+      expect(result.status).toBe(0)
+      const overlaps = warningsFor(result.output, 'overlap')
+      expect(overlaps).toHaveLength(1)
+      expect(overlaps[0]).toMatch(/step index 1 \(step 2 of 4\)/)
+      expect(overlaps[0]).toMatch(/Overlapping label one/)
+      expect(overlaps[0]).toMatch(/Second label collides/)
+    },
+    RUN_TIMEOUT_MS,
+  )
+
+  it(
+    'does not warn about overlap inside an allow-overlap subtree',
+    () => {
+      const result = runHelper('allowed-overlap')
+      expect(result.status).toBe(0)
+      expect(warningsFor(result.output, 'overlap')).toEqual([])
+      expect(readdirSync(join(result.outDir, 'allowed-overlap')).filter((name) => name.endsWith('.png'))).toHaveLength(STEP_COUNT)
+    },
+    RUN_TIMEOUT_MS,
+  )
+
+  it(
+    'warns about visually indistinct active chrome and names the step',
+    () => {
+      const result = runHelper('indistinct')
+      expect(result.status).toBe(0)
+      const indistinct = warningsFor(result.output, 'active-chrome')
+      expect(indistinct.length).toBeGreaterThan(0)
+      expect(indistinct[0]).toMatch(/step index 0 \(step 1 of 4\)/)
+      expect(indistinct[0]).toMatch(/data-presentation-(progress-item|toc-entry)/)
+    },
+    RUN_TIMEOUT_MS,
+  )
+
+  it(
+    'warns about browser-default attribution and points at the attribution hook',
+    () => {
+      const result = runHelper('plain-attribution')
+      expect(result.status).toBe(0)
+      const attribution = warningsFor(result.output, 'attribution')
+      expect(attribution.length).toBeGreaterThan(0)
+      expect(attribution[0]).toMatch(/step index 0 \(step 1 of 4\)/)
+      expect(attribution[0]).toMatch(/data-presentation-attribution/)
+    },
+    RUN_TIMEOUT_MS,
+  )
+})
