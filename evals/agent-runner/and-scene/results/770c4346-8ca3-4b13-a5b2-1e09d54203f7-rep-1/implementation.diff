@@ -0,0 +1,26 @@
+import { PRESENTATIONS, type PresentationEntry } from './presentations'
+
+export interface LandingProps {
+  entries?: ReadonlyArray<PresentationEntry>
+}
+
+/** Index of registered presentations. */
+export function Landing({ entries = PRESENTATIONS }: LandingProps) {
+  return (
+    <main className="landing">
+      <h1>and-scene</h1>
+      <p>Presentations as one evolving diagram.</p>
+      {entries.length === 0 ? (
+        <p>No presentations yet. Register one in src/presentations/index.ts.</p>
+      ) : (
+        <ul className="landing-list">
+          {entries.map((entry) => (
+            <li key={entry.slug}>
+              <a href={`/${entry.slug}`}>{entry.title}</a>
+            </li>
+          ))}
+        </ul>
+      )}
+    </main>
+  )
+}
diff --git a/src/RouteView.tsx b/src/RouteView.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..875cd3998b6f7d94303592a99b4b7e4e4e631518
--- /dev/null
+++ b/src/RouteView.tsx
@@ -0,0 +1,27 @@
+import { lazy, Suspense } from 'react'
+import { Landing } from './Landing'
+import { PRESENTATIONS } from './presentations'
+import { resolveRoute } from './router'
+
+// Each registered presentation becomes its own lazy chunk. Built once at module load.
+const ROUTABLE = PRESENTATIONS.map((entry) => ({ ...entry, Talk: lazy(entry.load) }))
+
+export function RouteView({ pathname }: { pathname: string }) {
+  const route = resolveRoute(pathname, ROUTABLE)
+  if (route.kind === 'landing') return <Landing />
+  if (route.kind === 'not-found') {
+    return (
+      <main className="landing">
+        <h1>Not found</h1>
+        <p>No presentation at {route.pathname}.</p>
+        <a href="/">Back to the index</a>
+      </main>
+    )
+  }
+  const { Talk } = route.entry
+  return (
+    <Suspense fallback={null}>
+      <Talk />
+    </Suspense>
+  )
+}
