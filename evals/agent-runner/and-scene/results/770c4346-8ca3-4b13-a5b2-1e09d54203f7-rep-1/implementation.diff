+  link2: `${NS}:link-2`,
+  ghost: `${NS}:ghost`,
+  depth: `${NS}:depth`,
+  kit: `${NS}:kit`,
+  plug: `${NS}:plug`,
+  verify: `${NS}:verify`,
+  chain: `${NS}:chain`,
+  modify: `${NS}:modify`,
+  reveal: `${NS}:reveal`,
+  revealLabel: `${NS}:reveal-label`,
+} as const
