+      style={{ ...rectStyle(rect), ...style }}
+      {...nodeAttrs('emphasis', id, data)}
+      {...hookAttrs(HOOK.emphasis, active ? 'true' : 'false')}
+    >
+      {children}
+    </motion.div>
+  )
+}
