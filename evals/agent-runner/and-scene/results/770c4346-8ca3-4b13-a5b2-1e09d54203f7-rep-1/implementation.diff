+  active: boolean
+  children: ReactNode
+}
+
+/** Marks emphasis state with a stable hook; the presentation draws the emphasis. */
+export function Emphasis({ id, active, children, className, style, data, ...rect }: EmphasisProps) {
+  return (
+    <motion.div
+      layoutId={id}
+      layout="position"
