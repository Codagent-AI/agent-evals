+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,83 @@
+import type { ReactNode } from 'react'
+import { STAGE_LAYOUT } from './constants'
+import { hookAttrs, HOOK } from './hooks'
+import { Attribution } from './chrome/Attribution'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { Toc } from './chrome/Toc'
+import { Stage } from './Stage'
+import { stepNumber } from './stepModel'
+import { useFitScale } from './useFitScale'
+import { usePresentationNav } from './usePresentationNav'
+import type { PresentationMode, Step } from './types'
+
+export interface PresentationProps<TPayload> {
+  /** Ordered steps. Numbering is derived from position. Needs at least one. */
+  steps: ReadonlyArray<Step<TPayload>>
+  title: string
+  initialMode?: PresentationMode
+  /** Host-provided top-left brand. The kit renders no brand by default. */
+  brand?: ReactNode
+  /** Bottom-right "made by and-scene" link. On by default. */
+  attribution?: boolean
+}
+
+/** Composes the stage, chrome, and navigation for one scene. */
+export function Presentation<TPayload>({
+  steps,
+  title,
+  initialMode = 'browse',
+  brand,
+  attribution = true,
+}: PresentationProps<TPayload>) {
+  const nav = usePresentationNav({ count: steps.length, initialMode })
+  const { scale, rect, wide } = useFitScale(nav.mode)
+  const step = steps[nav.index]
+  if (!step) return null
+
+  const layout = STAGE_LAYOUT[nav.mode]
+  const browse = nav.mode === 'browse'
+
+  return (
+    <section
+      aria-label={title}
+      {...hookAttrs(HOOK.root)}
+      {...hookAttrs(HOOK.mode, nav.mode)}
+      {...hookAttrs(HOOK.stepCount, String(steps.length))}
+      {...hookAttrs(HOOK.stepIndex, String(nav.index))}
+      style={{ position: 'relative', width: '100%', height: '100dvh', overflow: 'hidden' }}
+      {...nav.touchHandlers}
+    >
+      <Header
+        height={layout.top}
+        brand={brand}
+        marker={stepNumber(nav.index)}
+        title={step.title}
+        mode={nav.mode}
+        onToggleMode={nav.toggleMode}
+      />
+      {browse && wide ? (
+        <Toc
+          title={title}
+          steps={steps}
+          index={nav.index}
+          top={layout.top}
+          bottom={layout.bottom}
+          width={layout.side}
+          onGoTo={nav.goTo}
+        />
+      ) : null}
+      <Stage step={step} rect={rect} scale={scale} />
+      <Footer
+        height={layout.bottom}
+        steps={steps}
+        index={nav.index}
+        mode={nav.mode}
+        onGoTo={nav.goTo}
+        onPrev={nav.prev}
+        onNext={nav.next}
+      />
+      {attribution ? <Attribution /> : null}
+    </section>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..705109bb5254ff9b8f6584bafac77ce2cad440c3
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,84 @@
+import { AnimatePresence, LayoutGroup } from 'motion/react'
+import { DESIGN_H, DESIGN_W } from './constants'
+import { hookAttrs, HOOK } from './hooks'
+import { SceneLayer } from './nodes/SceneLayer'
+import type { StageRect } from './geometry'
+import type { Step } from './types'
+
+export interface StageProps<TPayload> {
+  step: Step<TPayload>
+  rect: StageRect
+  scale: number
+}
+
+// Stable numeric id per scene component, so layer keys can tell scenes apart.
+const sceneIds = new WeakMap<object, number>()
+let lastSceneId = 0
+
+function sceneId(scene: object): number {
+  const known = sceneIds.get(scene)
+  if (known !== undefined) return known
+  lastSceneId += 1
+  sceneIds.set(scene, lastSceneId)
+  return lastSceneId
+}
+
+/**
+ * Shared-layer identity for a step. Grouped steps keep one layer only when both
+ * `groupKey` and `scene` match; otherwise AnimatePresence cross-fades them.
+ */
+function layerKey<TPayload>(step: Step<TPayload>): string {
+  return step.groupKey === undefined
+    ? `step:${step.id}`
+    : `group:${step.groupKey}:${sceneId(step.scene)}`
+}
+
+/**
+ * Hosts the active step's scene on a fixed 880 x 380 canvas, scaled uniformly
+ * into the stage region. The canvas is laid out at design size and transformed,
+ * so entity geometry never reflows with the viewport.
+ */
+export function Stage<TPayload>({ step, rect, scale }: StageProps<TPayload>) {
+  const Scene = step.scene
+  return (
+    <div
+      {...hookAttrs(HOOK.stage)}
+      style={{
+        position: 'absolute',
+        left: rect.left,
+        top: rect.top,
+        width: rect.width,
+        height: rect.height,
+        display: 'flex',
+        alignItems: 'center',
+        justifyContent: 'center',
+        overflow: 'hidden',
+      }}
+    >
+      <div
+        {...hookAttrs(HOOK.canvas)}
+        style={{ position: 'relative', flex: 'none', width: DESIGN_W * scale, height: DESIGN_H * scale }}
+      >
+        <div
+          style={{
+            position: 'absolute',
+            left: 0,
+            top: 0,
+            width: DESIGN_W,
+            height: DESIGN_H,
+            transform: `scale(${scale})`,
+            transformOrigin: '0 0',
+          }}
+        >
+          <LayoutGroup>
+            <AnimatePresence initial={false}>
+              <SceneLayer key={layerKey(step)}>
+                <Scene payload={step.payload} />
+              </SceneLayer>
+            </AnimatePresence>
+          </LayoutGroup>
+        </div>
+      </div>
+    </div>
+  )
+}
