+  background: var(--paper);
+  color: var(--ink);
+  font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
+}
+
+/* Header: marker, browse title, and mode toggle. */
+.{{SLUG}} [data-presentation-marker] {
