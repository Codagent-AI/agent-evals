diff --git a/src/presentations/how-to-make-a-presentation/talk.css b/src/presentations/how-to-make-a-presentation/talk.css
new file mode 100644
index 0000000000000000000000000000000000000000..34d559cd02d184931e4c4dfae5f6aebb88236f91
--- /dev/null
+++ b/src/presentations/how-to-make-a-presentation/talk.css
@@ -0,0 +1,346 @@
+/* Presentation-owned styling for the reference sample, imported by Talk.tsx. The scene kit ships none of this. */
+
+.how-to-make-a-presentation {
+  --paper: #f6f3ec;
+  --ink: #1d2433;
+  --muted: #5b6475;
+  --rule: #c9c4b6;
+  --accent: #0f6b5c;
+  --amber: #a86412;
+  --green: #22703f;
+
+  min-height: 100dvh;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
+}
+
+/* Header: marker, browse title, and mode toggle. */
+.how-to-make-a-presentation [data-presentation-header] {
+  padding: 0 24px;
+  gap: 14px;
+  box-sizing: border-box;
+}
+
+.how-to-make-a-presentation [data-presentation-marker] {
+  font: 600 13px ui-monospace, SFMono-Regular, Menlo, monospace;
+  color: var(--paper);
+  background: var(--ink);
+  border-radius: 999px;
+  padding: 3px 10px;
+}
+
+.how-to-make-a-presentation h1[data-presentation-title] {
+  margin: 0;
+  min-width: 0;
+  /* Keeps a long browse title wrapping clear of the Present toggle on narrow viewports. */
+  padding-right: 120px;
+  font: 400 24px Georgia, 'Iowan Old Style', serif;
+  letter-spacing: -0.01em;
+}
+
+.how-to-make-a-presentation [data-presentation-mode-toggle] {
+  right: 24px;
+  font: 600 13px system-ui, sans-serif;
+  color: var(--ink);
+  background: transparent;
+  border: 1px solid var(--ink);
+  border-radius: 999px;
+  padding: 6px 14px;
+  cursor: pointer;
+}
+
+/* Table of contents: wide browse viewports only. */
+.how-to-make-a-presentation [data-presentation-toc] {
+  padding: 18px 12px 18px 24px;
+  box-sizing: border-box;
+}
+
+.how-to-make-a-presentation [data-presentation-toc-entry] {
+  display: block;
+  width: 100%;
+  text-align: left;
+  font: 500 14px system-ui, sans-serif;
+  color: var(--muted);
+  background: none;
+  border: 0;
