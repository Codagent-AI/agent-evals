@@ -0,0 +1,43 @@
+import type { PresentationMode } from './types'
+
+/** Shared easing curve for layout morphs and entrances. */
+export const EASE = [0.22, 1, 0.36, 1] as const
+
+/** Duration in seconds of a persisting entity's layout morph. */
+export const LAYOUT_T = 0.6
+
+/** Duration in seconds of a newcomer's fade-in. */
+export const ENTER_T = 0.4
+
+/** Newcomers start only once persisting entities have settled. */
+export const ENTER_DELAY = LAYOUT_T
+
+/** Default design canvas that every scene is composed in. */
+export const DESIGN_W = 880
+export const DESIGN_H = 380
+
+/** Floor for the uniform fit scale so degenerate viewports stay usable. */
+export const MIN_SCALE = 0.2
+
+/** Viewports at or above this width show the browse table of contents. */
+export const WIDE_VIEWPORT = 1024
+
+export interface StageLayout {
+  /** Height reserved for the header above the stage. */
+  top: number
+  /** Height reserved for the footer below the stage. */
+  bottom: number
+  /** Width of the side column reserved on wide viewports, when shown. */
+  side: number
+  /** Inset between the stage edges and the canvas fit box. */
+  inset: number
+}
+
+/** Chrome geometry per mode. Layout only; carries no visual style. */
+export const STAGE_LAYOUT: Record<PresentationMode, StageLayout> = {
+  browse: { top: 96, bottom: 168, side: 200, inset: 24 },
+  present: { top: 64, bottom: 96, side: 0, inset: 32 },
+}
+
+/** Public and-scene repository; the default attribution links here. */
+export const ATTRIBUTION_URL = 'https://github.com/Codagent-AI/and-scene'
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/geometry.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/geometry.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bf4327a4db859e0a601e7596154ba64b02f4c70f
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/geometry.ts
@@ -0,0 +1,40 @@
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT, WIDE_VIEWPORT } from './constants'
+import type { PresentationMode } from './types'
+
+export interface ViewportSize {
+  viewportWidth: number
+  viewportHeight: number
+  mode: PresentationMode
+}
+
+export interface StageRect {
+  left: number
+  top: number
+  width: number
+  height: number
+}
+
+/**
+ * The region between header and footer where the canvas is fit. The table of
+ * contents column only exists in browse mode on wide viewports.
+ */
+export function stageRect({ viewportWidth, viewportHeight, mode }: ViewportSize): StageRect {
+  const layout = STAGE_LAYOUT[mode]
+  const left = mode === 'browse' && viewportWidth >= WIDE_VIEWPORT ? layout.side : 0
+  return {
+    left,
+    top: layout.top,
+    width: Math.max(0, viewportWidth - left),
+    height: Math.max(0, viewportHeight - layout.top - layout.bottom),
+  }
+}
+
+/** Uniform scale that fits the design canvas inside the mode's stage region. */
+export function computeFitScale(size: ViewportSize): number {
+  const rect = stageRect(size)
+  const { inset } = STAGE_LAYOUT[size.mode]
+  const availableWidth = rect.width - 2 * inset
+  const availableHeight = rect.height - 2 * inset
+  const fit = Math.min(availableWidth / DESIGN_W, availableHeight / DESIGN_H)
+  return Math.max(MIN_SCALE, fit)
+}
