+    for (const filename of screenshots) expect((await readFile(path.join(screenshotDir, filename))).subarray(0, 8)).toEqual(Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]))
+    await expectNoPreviewProcess(root)
