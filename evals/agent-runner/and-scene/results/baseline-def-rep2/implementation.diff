diff --git a/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7a06c3d50c2acab51c1d8900011baaf3d42ba895
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
@@ -0,0 +1,79 @@
+import { mkdir, rm } from 'node:fs/promises'
+import path from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { chromium } from 'playwright'
+import { freePort, waitReady } from './verify.mjs'
+import { validateSample } from './verification-lib.mjs'
+import { spawn } from 'node:child_process'
+import { findOverlaps, stylesIndistinguishable, attributionWarnings, inspectDocument } from './inspection-lib.mjs'
+
+export { findOverlaps, stylesIndistinguishable, attributionWarnings }
+export function parseInspectArgs(args) {
+  const result = { slug: null, narrow: false, settle: Number(process.env.AND_SCENE_SETTLE_MS || 900), root: process.cwd() }
+  for (let i = 0; i < args.length; i++) {
+    if (!args[i].startsWith('--')) result.slug = args[i]
+    else if (args[i] === '--narrow') result.narrow = true
+    else if (args[i] === '--settle') result.settle = Number(args[++i])
+    else if (args[i] === '--root') result.root = path.resolve(args[++i])
+    else throw new Error(`unknown argument: ${args[i]}`)
+  }
+  if (!result.slug) throw new Error('usage: npm run inspect -- <slug> [--narrow] [--settle ms]')
+  if (!Number.isFinite(result.settle) || result.settle < 0) throw new Error('--settle must be a non-negative number')
+  return result
+}
+export async function inspect({ slug, narrow, settle, root }) {
+  let browser, preview
+  const cleanup = async () => {
+    await browser?.close().catch(() => {})
+    if (preview && preview.exitCode === null) { preview.kill('SIGTERM'); await new Promise((resolve) => setTimeout(resolve, 300)); if (preview.exitCode === null) preview.kill('SIGKILL') }
+  }
+  process.once('SIGINT', () => { process.exitCode = 130; void cleanup() })
+  try {
+    const { execFileSync } = await import('node:child_process')
+    execFileSync('npm', ['run', 'build'], { cwd: root, stdio: 'inherit' })
+    const sample = slug === 'how-to-make-a-presentation'
+    if (sample) await validateSample(root, slug)
+    else {
+      const registry = await import('node:fs/promises').then(({ readFile }) => readFile(path.join(root, 'src/presentations/index.ts'), 'utf8'))
+      if (!registry.includes(`slug: '${slug}'`) || !registry.includes(`./${slug}/Talk`)) throw new Error(`unknown presentation slug: ${slug}`)
+    }
+    const port = await freePort(), base = `http://127.0.0.1:${port}`
+    preview = spawn(process.execPath, ['node_modules/vite/bin/vite.js', 'preview', '--host', '127.0.0.1', '--port', String(port), '--strictPort'], { cwd: root, stdio: ['ignore', 'inherit', 'inherit'] })
+    await waitReady(base, preview)
+    try { browser = await chromium.launch({ headless: true }) } catch (error) { throw new Error(`Playwright Chromium unavailable; run "npx playwright install chromium": ${error.message}`) }
+    const page = await browser.newPage({ viewport: narrow ? { width: 390, height: 844 } : { width: 1440, height: 900 } })
+    const pageErrors = []
+    page.on('pageerror', (error) => pageErrors.push(error.message))
+    await page.goto(`${base}/${slug}`, { waitUntil: 'networkidle' })
+    const countAttribute = await page.locator('[data-step-count]').getAttribute('data-step-count', { timeout: 3000 }).catch(() => null)
+    const total = countAttribute === null ? Number.NaN : Number(countAttribute)
+    if (!Number.isFinite(total) || total <= 0) {
+      const detail = pageErrors.length ? ` (page errors: ${pageErrors.join('; ')})` : ''
+      throw new Error(`no registered presentation found for ${slug}${detail}`)
+    }
+    const output = path.join(root, 'artifacts/inspection', `${slug}${narrow ? '-narrow' : ''}`)
+    await rm(output, { recursive: true, force: true })
+    await mkdir(output, { recursive: true })
+    for (let step = 0; step < total; step++) {
+      if (step) { await page.keyboard.press('ArrowRight'); await page.waitForFunction((index) => Number(document.querySelector('[data-step-index]')?.getAttribute('data-step-index')) === index, step) }
+      const settleStarted = Date.now()
+      await page.waitForTimeout(settle)
+      if (process.env.AND_SCENE_INSPECT_TRACE === '1') {
+        const activeAnimations = await page.evaluate(() => document.getAnimations().filter((animation) => animation.playState === 'running').length)
+        console.log(`CAPTURE step ${step} settled=${Date.now() - settleStarted}ms activeAnimations=${activeAnimations}`)
+      }
+      const measurements = await page.evaluate(inspectDocument)
+      const report = {
+        overlaps: findOverlaps(measurements.visibleText),
+        indistinct: measurements.navigationStyles.some((styles) => styles && stylesIndistinguishable(...styles)) ? ['navigation'] : [],
+        attribution: attributionWarnings(measurements.attributionInfo),
+      }
+      for (const warning of report.overlaps) console.warn(`WARN step ${step}: overlapping text/chrome "${warning.first}" and "${warning.second}"`)
+      for (const warning of report.indistinct) console.warn(`WARN step ${step}: active progress/ToC is indistinguishable from inactive controls`)
+      for (const warning of report.attribution) console.warn(`WARN step ${step}: ${warning}`)
+      await page.screenshot({ path: path.join(output, `step-${String(step + 1).padStart(2, '0')}.png`), fullPage: true })
+    }
+    console.log(`PASS: captured ${total} settled step screenshots in ${output}`)
+  } finally { await cleanup() }
+}
+if (import.meta.url === pathToFileURL(path.resolve(process.argv[1] || '')).href) inspect(parseInspectArgs(process.argv.slice(2))).catch((error) => { console.error(`FAIL [inspect]: ${error.message}`); process.exitCode = 1 })
diff --git a/skills/presentation/templates/bootstrap/scripts/inspection-lib.mjs b/skills/presentation/templates/bootstrap/scripts/inspection-lib.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6ccc5c2161465a8bb1f8c6a91d2356ec13634753
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/inspection-lib.mjs
@@ -0,0 +1,55 @@
+export function overlaps(a, b) {
+  return a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top
+}
+export function findOverlaps(elements) {
+  const warnings = []
+  for (let i = 0; i < elements.length; i++) for (let j = i + 1; j < elements.length; j++) {
+    const a = elements[i], b = elements[j]
+    if (a.allowed || b.allowed || !a.text || !b.text || !overlaps(a.rect, b.rect)) continue
+    warnings.push({ first: a.label, second: b.label })
+  }
+  return warnings
+}
+export function stylesIndistinguishable(active, inactive) {
+  const keys = ['color', 'backgroundColor', 'borderColor', 'fontWeight', 'opacity', 'textDecorationLine']
+  return keys.every((key) => active[key] === inactive[key])
+}
+export function attributionWarnings(info) {
+  if (!info) return ['attribution link is missing; style the [data-presentation-attribution] hook']
+  const warnings = []
+  if (info.fontSize < 12) warnings.push('attribution is too small; style the [data-presentation-attribution] hook')
+  if (info.defaultLike) warnings.push('attribution looks browser-default; style the [data-presentation-attribution] hook')
+  return warnings
+}
+export function inspectDocument() {
+  const allowed = (element) => Boolean(element.closest('[data-presentation-allow-overlap]'))
+  const visibleText = [...document.querySelectorAll('body *')].filter((element) => {
+    if (element.children.length !== 0 || !element.textContent.trim() || ['arrow', 'frame'].includes(element.getAttribute('data-presentation-node'))) return false
+    let ancestor = element
+    while (ancestor && ancestor instanceof Element) {
+      const style = getComputedStyle(ancestor)
+      if (style.display === 'none' || style.visibility === 'hidden' || !(Number.parseFloat(style.opacity) > 0)) return false
+      ancestor = ancestor.parentElement
+    }
+    const range = document.createRange()
+    range.selectNodeContents(element)
+    const rect = range.getBoundingClientRect()
+    const elementRect = element.getBoundingClientRect()
+    return elementRect.width > 0 && elementRect.height > 0 && rect.width > 0 && rect.height > 0 && rect.right > 0 && rect.bottom > 0 && rect.left < innerWidth && rect.top < innerHeight
+  }).map((element) => {
+    const range = document.createRange()
+    range.selectNodeContents(element)
+    const rect = range.getBoundingClientRect()
+    return { label: element.getAttribute('data-presentation-label') || element.getAttribute('data-presentation-node') || element.getAttribute('data-presentation-caption') || element.tagName.toLowerCase(), text: element.textContent.trim(), allowed: allowed(element), rect: { left: rect.left, right: rect.right, top: rect.top, bottom: rect.bottom } }
+  })
+  const active = [...document.querySelectorAll('[data-presentation-progress] [data-presentation-active="true"], [data-presentation-toc] [data-presentation-active="true"]')]
+  const style = (el) => { const s = getComputedStyle(el); return { color: s.color, backgroundColor: s.backgroundColor, borderColor: s.borderColor, fontWeight: s.fontWeight, opacity: s.opacity, textDecorationLine: s.textDecorationLine } }
+  const navigationStyles = active.map((item) => {
+    const inactive = [...(item.parentElement?.querySelectorAll('button') || [])].find((candidate) => candidate !== item)
+    return inactive ? [style(item), style(inactive)] : null
+  })
+  const attribution = document.querySelector('[data-presentation-attribution]')
+  let attributionInfo = null
+  if (attribution) { const s = getComputedStyle(attribution); attributionInfo = { fontSize: parseFloat(s.fontSize), defaultLike: s.textDecorationLine.includes('underline') || s.color === 'rgb(0, 0, 238)' } }
+  return { visibleText, navigationStyles, attributionInfo }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/verification-lib.mjs b/skills/presentation/templates/bootstrap/scripts/verification-lib.mjs
