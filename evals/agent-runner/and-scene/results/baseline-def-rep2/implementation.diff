diff --git a/scripts/bootstrap.integration.test.ts b/scripts/bootstrap.integration.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7d96f0756b565df770f2b0a05db473d1bbcd6dde
--- /dev/null
+++ b/scripts/bootstrap.integration.test.ts
@@ -0,0 +1,61 @@
+import { cp, mkdtemp, readFile, readdir, rm } from 'node:fs/promises'
+import os from 'node:os'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+import { execFileSync } from 'node:child_process'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const bootstrap = path.join(root, 'skills/presentation/templates/bootstrap')
+const run = (command: string, args: string[], cwd: string) => execFileSync(command, args, { cwd, stdio: 'pipe', encoding: 'utf8', env: { ...process.env, CI: '1' } })
+async function walk(dir: string): Promise<string[]> {
+  const entries = await readdir(dir, { withFileTypes: true })
+  const nested = await Promise.all(entries.filter((entry) => entry.isDirectory()).map((entry) => walk(path.join(dir, entry.name))))
+  return [...nested.flat(), ...entries.filter((entry) => entry.isFile()).map((entry) => path.join(dir, entry.name))]
+}
+
+describe('INT-001 materialized bootstrap', () => {
+  it('installs from its lockfile, builds, smoke-verifies, and remains style-neutral', async () => {
+    const target = await mkdtemp(path.join(os.tmpdir(), 'and-scene-bootstrap-'))
+    try {
+      await cp(bootstrap, target, { recursive: true })
+      const manifest = JSON.parse(await readFile(path.join(target, 'package.json'), 'utf8'))
+      const allDependencies = { ...manifest.dependencies, ...manifest.devDependencies }
+      for (const dependency of ['react', 'react-dom', 'motion', 'lucide-react', 'vite', '@vitejs/plugin-react', 'typescript', '@types/react', '@types/react-dom', '@types/node', 'eslint', '@eslint/js', 'eslint-plugin-react-hooks', 'eslint-plugin-react-refresh', 'typescript-eslint', 'globals', 'playwright', 'vitest']) expect(allDependencies).toHaveProperty(dependency)
+      expect(manifest.scripts).toMatchObject({ build: expect.any(String), verify: expect.any(String), inspect: expect.any(String) })
+      expect(manifest.dependencies && JSON.stringify(manifest).toLowerCase()).not.toContain('tailwind')
+
+      run('npm', ['ci', '--offline'], target)
+      run('npm', ['run', 'build'], target)
+      try { run('npm', ['run', 'verify'], target) } catch (error) {
+        const detail = error instanceof Error ? error.message : String(error)
+        if (/executable.*doesn.t exist|browser.*not found|chromium/i.test(detail)) throw new Error(`INT-001 requires Playwright Chromium. Install it with "npx playwright install chromium". ${detail}`, { cause: error })
+        throw new Error(detail, { cause: error })
+      }
+
+      for (const anchor of ['vite.config.ts', 'src/presentation-kit/Presentation.tsx', 'src/presentations/index.ts']) expect(await readFile(path.join(target, anchor), 'utf8')).toBeTruthy()
+      for (const script of ['scripts/verify.mjs', 'scripts/inspect-presentation.mjs']) expect(await readFile(path.join(target, script))).toEqual(await readFile(path.join(root, script)))
+      for (const file of await walk(path.join(root, 'src/presentation-kit'))) {
+        if (/\.test\.[jt]sx?$/.test(file)) continue
+        const relative = path.relative(root, file)
+        expect(await readFile(path.join(target, relative))).toEqual(await readFile(file))
+      }
+
+      const appFiles = (await walk(target)).filter((file) => !file.startsWith(path.join(target, 'node_modules') + path.sep) && !file.startsWith(path.join(target, 'dist') + path.sep))
+      const cssFiles = appFiles.filter((file) => file.endsWith('.css'))
+      expect(cssFiles.length).toBeGreaterThan(0)
+      const stylePattern = /\b(color|background(?:-color)?|font(?:-family|-size|-weight)?|padding|margin|gap|border(?:-radius|-color|-width)?|box-shadow|text-shadow)\s*:/i
+      for (const file of cssFiles) expect(await readFile(file, 'utf8'), path.relative(target, file)).not.toMatch(stylePattern)
+      for (const file of appFiles.filter((file) => /\.[jt]sx?$/.test(file))) {
+        const source = await readFile(file, 'utf8')
+        expect(source, path.relative(target, file)).not.toMatch(/tailwind/i)
+        for (const [, inlineStyle] of source.matchAll(/style=\{\{([\s\S]*?)\}\}/g)) expect(inlineStyle).not.toMatch(stylePattern)
+      }
+      expect(await readFile(path.join(target, 'src/index.css'), 'utf8')).toMatch(/box-sizing/)
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error)
+      if (/Chromium|executable doesn't exist|browserType\.launch/i.test(message)) throw new Error(`INT-001 could not launch Chromium. Install it with "npx playwright install chromium". ${message}`, { cause: error })
+      throw new Error(message, { cause: error })
+    } finally { await rm(target, { recursive: true, force: true }) }
+  }, 240_000)
+})
diff --git a/scripts/entrance-motion.e2e.test.ts b/scripts/entrance-motion.e2e.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..62f422f3e60e6dff02791702dc4fc61dff05f5ae
--- /dev/null
+++ b/scripts/entrance-motion.e2e.test.ts
@@ -0,0 +1,48 @@
+import { afterAll, beforeAll, describe, expect, it } from 'vitest'
+import { spawn, type ChildProcess } from 'node:child_process'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { chromium, type Browser } from 'playwright'
+import { freePort, waitReady } from './verify.mjs'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+let server: ChildProcess, browser: Browser, base: string
+
+beforeAll(async () => {
+  const port = await freePort()
+  base = `http://127.0.0.1:${port}`
+  server = spawn(process.execPath, [path.join(root, 'node_modules/vite/bin/vite.js'), '--host', '127.0.0.1', '--port', String(port), '--strictPort'], { cwd: root, stdio: 'ignore' })
+  await waitReady(`${base}/`, server)
+  browser = await chromium.launch()
+}, 60_000)
+afterAll(async () => { await browser?.close(); server?.kill('SIGTERM') })
+
+describe('reference sample entrance motion in a real browser', () => {
+  it('fades a newly introduced step card in after navigating forward, sampled from the click itself', async () => {
+    const page = await browser.newPage({ viewport: { width: 1440, height: 900 } })
+    try {
+      await page.goto(`${base}/how-to-make-a-presentation`)
+      await page.waitForSelector('[data-step-count]')
+      await page.click('button[aria-label^="Go to step 2"]')
+      await page.waitForSelector('[data-step-index="1"]')
+      await page.waitForFunction(() => document.getAnimations().length === 0)
+      expect(await page.locator('.step-card').count()).toBe(0)
+      const samples = await page.evaluate(() => new Promise<{ t: number; opacity: number; animations: number }[]>((resolve) => {
+        const out: { t: number; opacity: number; animations: number }[] = []
+        const t0 = performance.now()
+        ;(document.querySelector('button[aria-label="Next step"]') as HTMLElement).click()
+        const frame = () => {
+          const wrapper = document.querySelector('.step-card')?.closest('[data-presentation-appear]')
+          if (wrapper) out.push({ t: performance.now() - t0, opacity: Number(getComputedStyle(wrapper).opacity), animations: document.getAnimations().length })
+          if (performance.now() - t0 < 1400) requestAnimationFrame(frame); else resolve(out)
+        }
+        requestAnimationFrame(frame)
+      }))
+      expect(samples.length).toBeGreaterThan(10)
+      expect(samples[0]!.opacity).toBeLessThan(0.1)
+      expect(samples.some((s) => s.animations > 0)).toBe(true)
+      expect(samples.some((s) => s.opacity > 0.1 && s.opacity < 0.9)).toBe(true)
+      expect(samples.at(-1)!.opacity).toBe(1)
+    } finally { await page.close() }
+  }, 30_000)
+})
diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7a06c3d50c2acab51c1d8900011baaf3d42ba895
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,79 @@
+import { mkdir, rm } from 'node:fs/promises'
+import path from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { chromium } from 'playwright'
+import { freePort, waitReady } from './verify.mjs'
+import { validateSample } from './verification-lib.mjs'
+import { spawn } from 'node:child_process'
+import { findOverlaps, stylesIndistinguishable, attributionWarnings, inspectDocument } from './inspection-lib.mjs'
+
+export { findOverlaps, stylesIndistinguishable, attributionWarnings }
+export function parseInspectArgs(args) {
+  const result = { slug: null, narrow: false, settle: Number(process.env.AND_SCENE_SETTLE_MS || 900), root: process.cwd() }
+  for (let i = 0; i < args.length; i++) {
+    if (!args[i].startsWith('--')) result.slug = args[i]
+    else if (args[i] === '--narrow') result.narrow = true
+    else if (args[i] === '--settle') result.settle = Number(args[++i])
+    else if (args[i] === '--root') result.root = path.resolve(args[++i])
+    else throw new Error(`unknown argument: ${args[i]}`)
+  }
+  if (!result.slug) throw new Error('usage: npm run inspect -- <slug> [--narrow] [--settle ms]')
+  if (!Number.isFinite(result.settle) || result.settle < 0) throw new Error('--settle must be a non-negative number')
+  return result
+}
+export async function inspect({ slug, narrow, settle, root }) {
+  let browser, preview
+  const cleanup = async () => {
+    await browser?.close().catch(() => {})
+    if (preview && preview.exitCode === null) { preview.kill('SIGTERM'); await new Promise((resolve) => setTimeout(resolve, 300)); if (preview.exitCode === null) preview.kill('SIGKILL') }
+  }
+  process.once('SIGINT', () => { process.exitCode = 130; void cleanup() })
+  try {
+    const { execFileSync } = await import('node:child_process')
+    execFileSync('npm', ['run', 'build'], { cwd: root, stdio: 'inherit' })
+    const sample = slug === 'how-to-make-a-presentation'
+    if (sample) await validateSample(root, slug)
+    else {
+      const registry = await import('node:fs/promises').then(({ readFile }) => readFile(path.join(root, 'src/presentations/index.ts'), 'utf8'))
+      if (!registry.includes(`slug: '${slug}'`) || !registry.includes(`./${slug}/Talk`)) throw new Error(`unknown presentation slug: ${slug}`)
+    }
+    const port = await freePort(), base = `http://127.0.0.1:${port}`
+    preview = spawn(process.execPath, ['node_modules/vite/bin/vite.js', 'preview', '--host', '127.0.0.1', '--port', String(port), '--strictPort'], { cwd: root, stdio: ['ignore', 'inherit', 'inherit'] })
+    await waitReady(base, preview)
+    try { browser = await chromium.launch({ headless: true }) } catch (error) { throw new Error(`Playwright Chromium unavailable; run "npx playwright install chromium": ${error.message}`) }
+    const page = await browser.newPage({ viewport: narrow ? { width: 390, height: 844 } : { width: 1440, height: 900 } })
+    const pageErrors = []
+    page.on('pageerror', (error) => pageErrors.push(error.message))
+    await page.goto(`${base}/${slug}`, { waitUntil: 'networkidle' })
+    const countAttribute = await page.locator('[data-step-count]').getAttribute('data-step-count', { timeout: 3000 }).catch(() => null)
+    const total = countAttribute === null ? Number.NaN : Number(countAttribute)
+    if (!Number.isFinite(total) || total <= 0) {
+      const detail = pageErrors.length ? ` (page errors: ${pageErrors.join('; ')})` : ''
+      throw new Error(`no registered presentation found for ${slug}${detail}`)
+    }
+    const output = path.join(root, 'artifacts/inspection', `${slug}${narrow ? '-narrow' : ''}`)
+    await rm(output, { recursive: true, force: true })
+    await mkdir(output, { recursive: true })
+    for (let step = 0; step < total; step++) {
+      if (step) { await page.keyboard.press('ArrowRight'); await page.waitForFunction((index) => Number(document.querySelector('[data-step-index]')?.getAttribute('data-step-index')) === index, step) }
+      const settleStarted = Date.now()
+      await page.waitForTimeout(settle)
+      if (process.env.AND_SCENE_INSPECT_TRACE === '1') {
+        const activeAnimations = await page.evaluate(() => document.getAnimations().filter((animation) => animation.playState === 'running').length)
+        console.log(`CAPTURE step ${step} settled=${Date.now() - settleStarted}ms activeAnimations=${activeAnimations}`)
+      }
+      const measurements = await page.evaluate(inspectDocument)
+      const report = {
+        overlaps: findOverlaps(measurements.visibleText),
+        indistinct: measurements.navigationStyles.some((styles) => styles && stylesIndistinguishable(...styles)) ? ['navigation'] : [],
+        attribution: attributionWarnings(measurements.attributionInfo),
+      }
+      for (const warning of report.overlaps) console.warn(`WARN step ${step}: overlapping text/chrome "${warning.first}" and "${warning.second}"`)
+      for (const warning of report.indistinct) console.warn(`WARN step ${step}: active progress/ToC is indistinguishable from inactive controls`)
+      for (const warning of report.attribution) console.warn(`WARN step ${step}: ${warning}`)
+      await page.screenshot({ path: path.join(output, `step-${String(step + 1).padStart(2, '0')}.png`), fullPage: true })
+    }
+    console.log(`PASS: captured ${total} settled step screenshots in ${output}`)
+  } finally { await cleanup() }
+}
+if (import.meta.url === pathToFileURL(path.resolve(process.argv[1] || '')).href) inspect(parseInspectArgs(process.argv.slice(2))).catch((error) => { console.error(`FAIL [inspect]: ${error.message}`); process.exitCode = 1 })
