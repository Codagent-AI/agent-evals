diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..04737f312613cea469e6870af99b89812509b253
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,25 @@
+import { useEffect, useState, type RefObject } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE } from './constants'
+
+export { DESIGN_H, DESIGN_W }
+export function fitScale(width: number, height: number, designWidth = DESIGN_W, designHeight = DESIGN_H): number {
+  if (width <= 0 || height <= 0) return 1
+  return Math.max(MIN_SCALE, Math.min(width / designWidth, height / designHeight))
+}
+export function useFitScale(ref: RefObject<HTMLElement | null>): number {
+  const [scale, setScale] = useState(1)
+  useEffect(() => {
+    const node = ref.current
+    if (!node) return
+    const update = () => setScale(fitScale(node.clientWidth, node.clientHeight))
+    update()
+    if (typeof ResizeObserver !== 'undefined') {
+      const observer = new ResizeObserver(update)
+      observer.observe(node)
+      return () => observer.disconnect()
+    }
+    window.addEventListener('resize', update)
+    return () => window.removeEventListener('resize', update)
+  }, [ref])
+  return scale
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8931cfcd3046af7fa01e19f44f43c4bbde6411b4
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,39 @@
+import { useCallback, useEffect, useState } from 'react'
+import type { PresentationMode } from './types'
+
+export function shouldIgnoreNavigationKey(target: HTMLElement): boolean {
+  return target.isContentEditable || /^(INPUT|TEXTAREA|SELECT|BUTTON|A)$/.test(target.tagName) || target.getAttribute?.('role') === 'button'
+}
+export function clampStep(index: number, stepCount: number): number { return Math.max(0, Math.min(stepCount - 1, index)) }
+export type NavigationAction = 'next' | 'prev' | 'toggle' | null
+export function navigationKeyAction(key: string, target?: HTMLElement | null, modifiers?: Partial<Pick<KeyboardEvent, 'ctrlKey' | 'metaKey' | 'altKey'>>): NavigationAction {
+  if (target && shouldIgnoreNavigationKey(target)) return null
+  if (modifiers?.ctrlKey || modifiers?.metaKey || modifiers?.altKey) return null
+  if (['ArrowRight', ' ', 'PageDown'].includes(key)) return 'next'
+  if (['ArrowLeft', 'PageUp'].includes(key)) return 'prev'
+  if (key.toLowerCase() === 'p') return 'toggle'
+  return null
+}
+export function swipeAction(deltaX: number, threshold = 48): 'next' | 'prev' | null {
+  if (Math.abs(deltaX) <= threshold) return null
+  return deltaX < 0 ? 'next' : 'prev'
+}
+export function usePresentationNav(stepCount: number, initialMode: PresentationMode = 'browse') {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState<PresentationMode>(initialMode)
+  const next = useCallback(() => setIndex((i) => clampStep(clampStep(i, stepCount) + 1, stepCount)), [stepCount])
+  const prev = useCallback(() => setIndex((i) => clampStep(clampStep(i, stepCount) - 1, stepCount)), [stepCount])
+  const goTo = useCallback((i: number) => setIndex(clampStep(i, stepCount)), [stepCount])
+  const toggleMode = useCallback(() => setMode((m) => m === 'browse' ? 'present' : 'browse'), [])
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      const action = navigationKeyAction(event.key, event.target as HTMLElement | null, event)
+      if (action === 'next') { event.preventDefault(); next() }
+      else if (action === 'prev') { event.preventDefault(); prev() }
+      else if (action === 'toggle') toggleMode()
+    }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [next, prev, toggleMode])
+  return { index, mode, next, prev, goTo, toggleMode, setMode }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentations/index.ts b/skills/presentation/templates/bootstrap/src/presentations/index.ts
new file mode 100644
