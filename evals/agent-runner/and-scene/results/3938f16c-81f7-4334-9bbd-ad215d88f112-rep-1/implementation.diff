+  border-radius: 0.4rem;
+  padding: 0.25rem 0.6rem;
+  cursor: pointer;
+}
+
+.htmap-talk [data-presentation-body] {
+  position: relative;
+}
+
+.htmap-talk [data-presentation-toc] {
+  flex: 0 0 auto;
+  width: 160px;
+  padding: 0.5rem 1rem;
+  overflow-y: auto;
+}
+
