+/*
+ * Presentation-owned visual system for "How to Use This Skill to Make a
+ * Presentation". The scene kit ships no palette, borders, or spacing —
+ * every visual decision below belongs to this talk.
+ */
+
+/*
+ * The scene kit already stacks header/body/footer to fill the viewport, fits
+ * the stage to the body, and pins attribution bottom-right; these rules add
+ * this talk's padding and the ToC column around that arrangement.
+ */
+.htmap-talk {
+  overflow: hidden;
+  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
+  color: #f8f3e6;
+}
+
+.htmap-talk [data-presentation-header] {
