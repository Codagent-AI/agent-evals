+  .__SLUG__-talk [data-presentation-toc] {
+    display: none;
+  }
+}
+
+.__SLUG__-box {
+  border: 1px solid currentColor;
+  border-radius: 0.5rem;
+  padding: 0.75rem 1rem;
+}
