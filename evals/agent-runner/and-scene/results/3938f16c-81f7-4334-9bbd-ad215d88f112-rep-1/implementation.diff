+}
+
+.htmap-talk [data-presentation-controls] button:disabled {
+  opacity: 0.35;
+  cursor: default;
+}
+
+.htmap-talk [data-presentation-progress] {
+  display: flex;
+  gap: 0.4rem;
+}
+
+.htmap-box,
+.htmap-card,
+.htmap-chip {
+  border-radius: 0.6rem;
+  border: 1px solid rgba(248, 243, 230, 0.35);
+  background: rgba(22, 20, 18, 0.85);
