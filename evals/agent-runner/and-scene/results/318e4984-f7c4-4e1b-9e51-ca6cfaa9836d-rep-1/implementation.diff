diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e37985cf9c2dac2ab50fc6517cd48b299dfa2efb
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,139 @@
+// Captures one settled screenshot per step of a registered presentation from a production
+// preview and prints advisory visual warnings. Warnings never change the exit status; only
+// operational failures (build, route, browser) do.
+//
+//   npm run inspect -- <slug> [--settle ms] [--viewport WxH] [--out dir] [--no-build]
+import { mkdirSync, rmSync, writeFileSync } from 'node:fs'
+import { join, resolve, sep } from 'node:path'
+import { chromium } from 'playwright'
+import { collectDiagnostics, diagnosticOptions, formatWarnings } from './lib/diagnostics.mjs'
+import {
+  installSignalCleanup,
+  projectRoot,
+  runNpm,
+  sleep,
+  startPreview,
+  stopAll,
+} from './lib/runtime.mjs'
+import { resolveSettleMs } from './lib/settle.mjs'
+
+const STEP_TIMEOUT_MS = 5000
+const DEFAULT_VIEWPORT = { width: 1440, height: 900 }
+
+function parseArgs(argv) {
+  const options = { slug: undefined, build: true, out: '.inspection', viewport: DEFAULT_VIEWPORT }
+  for (let i = 0; i < argv.length; i++) {
+    const arg = argv[i]
+    if (arg === '--no-build') options.build = false
+    else if (arg === '--settle') options.settle = argv[++i]
+    else if (arg === '--out') options.out = argv[++i]
+    else if (arg === '--viewport') {
+      const [width, height] = String(argv[++i]).split('x').map(Number)
+      options.viewport = { width, height }
+    } else if (!arg.startsWith('--') && !options.slug) options.slug = arg
+    else throw new Error(`unknown argument: ${arg}`)
+  }
+  if (!options.slug) throw new Error('usage: npm run inspect -- <slug> [--settle ms] [--viewport WxH] [--out dir] [--no-build]')
+  return options
+}
+
+const pad = (n) => String(n).padStart(2, '0')
+
+async function main() {
+  installSignalCleanup()
+  const options = parseArgs(process.argv.slice(2))
+  const settleMs = resolveSettleMs({ flag: options.settle })
+  // the output directory is wiped below, so it must stay strictly inside the inspection root
+  if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(options.slug)) throw new Error(`invalid slug: ${options.slug}`)
+  const base = resolve(projectRoot, options.out)
+  const outDir = resolve(base, options.slug)
+  if (!outDir.startsWith(base + sep) || !base.startsWith(projectRoot + sep)) {
+    throw new Error(`output path ${outDir} must be inside a dedicated directory under the project`)
+  }
+  rmSync(outDir, { recursive: true, force: true })
+  mkdirSync(outDir, { recursive: true })
+
+  if (options.build) {
+    console.log('[inspect] building')
+    const { code, output } = await runNpm('build')
+    if (code !== 0) {
+      console.log(output.split('\n').slice(-40).join('\n'))
+      throw new Error(`npm run build exited with code ${code}`)
+    }
+  }
+
+  const preview = await startPreview()
+  const url = `${preview.baseUrl}/${options.slug}`
+  console.log(`[inspect] ${url} (settle ${settleMs} ms)`)
+  const browser = await chromium.launch()
+  const warnings = []
+  const captures = []
+  try {
+    const page = await browser.newPage({ viewport: options.viewport })
+    const startedAt = Date.now()
+    await page.goto(url)
+    try {
+      await page.waitForSelector('[data-step-count]', { timeout: STEP_TIMEOUT_MS })
+    } catch {
+      throw new Error(`route /${options.slug} did not render a presentation`)
+    }
+    const count = Number(await page.getAttribute('[data-step-count]', 'data-step-count'))
+    const diagnose = (step) =>
+      page.evaluate(collectDiagnostics, diagnosticOptions).then((found) => formatWarnings(step, found))
+
+    // Active-chrome checks need browse chrome; look at it once if the deck opens in present mode.
+    const openedIn = await page.getAttribute('[data-presentation-root]', 'data-presentation-mode')
+    if (openedIn === 'present') {
+      await page.keyboard.press('p')
+      await sleep(settleMs)
+      const chrome = (await diagnose(0)).filter((w) => w.kind === 'active-chrome')
+      warnings.push(...chrome)
+      for (const warning of chrome) console.log(`WARN step ${warning.step} [${warning.kind}] ${warning.message}`)
+      await page.keyboard.press('p')
+    }
+
+    for (let index = 0; index < count; index++) {
+      let transitionAt = startedAt
+      if (index > 0) {
+        transitionAt = Date.now()
+        await page.keyboard.press('ArrowRight')
+        await page.waitForFunction(
+          (want) => document.querySelector('[data-step-index]')?.getAttribute('data-step-index') === want,
+          String(index),
+          { timeout: STEP_TIMEOUT_MS },
+        )
+      }
+      await sleep(settleMs)
+      const runningAnimations = await page.evaluate(
+        () => document.getAnimations().filter((a) => a.playState === 'running').length,
+      )
+      const stepWarnings = await diagnose(index)
+      warnings.push(...stepWarnings)
+      const file = join(outDir, `step-${pad(index + 1)}.png`)
+      await page.screenshot({ path: file })
+      const capturedAt = Date.now()
+      const observedIndex = Number(await page.getAttribute('[data-step-index]', 'data-step-index'))
+      captures.push({ index, observedIndex, file: `step-${pad(index + 1)}.png`, transitionAt, capturedAt, runningAnimations })
+      console.log(`[inspect] step ${index} -> ${options.out}/${options.slug}/step-${pad(index + 1)}.png`)
+      for (const warning of stepWarnings) console.log(`WARN step ${warning.step} [${warning.kind}] ${warning.message}`)
+    }
+  } finally {
+    await browser.close()
+  }
+  writeFileSync(
+    join(outDir, 'report.json'),
+    JSON.stringify({ slug: options.slug, viewport: options.viewport, settleMs, captures, warnings }, null, 2),
+  )
+  console.log(`[inspect] done: ${captures.length} screenshots, ${warnings.length} advisory warnings`)
+}
+
+let code = 0
+try {
+  await main()
+} catch (error) {
+  console.error(`[inspect] FAIL: ${error?.message ?? error}`)
+  code = 1
+} finally {
+  await stopAll()
+}
+process.exit(code)
diff --git a/scripts/lib/diagnostics.mjs b/scripts/lib/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..256275660b43ccbb9ebabc60617e62de0c72153b
--- /dev/null
+++ b/scripts/lib/diagnostics.mjs
@@ -0,0 +1,210 @@
+// Advisory visual diagnostics for inspect-presentation.mjs. `collectDiagnostics` runs inside
+// the page (it must stay self-contained); `formatWarnings` turns its findings into messages.
+
+export const OVERLAP_TOLERANCE_PX = 2
+export const ATTRIBUTION_MIN_FONT_PX = 11
+export const ATTRIBUTION_MIN_HIT_PX = 16
+export const BROWSER_DEFAULT_LINK_COLOR = 'rgb(0, 0, 238)'
+export const ALLOW_OVERLAP_ATTRIBUTE = 'data-presentation-allow-overlap'
+
+export const CHROME_SELECTOR = [
+  '[data-presentation-progress-item]',
+  '[data-presentation-toc-entry]',
+  '[data-presentation-prev]',
+  '[data-presentation-next]',
+  '[data-presentation-attribution]',
+  '[data-presentation-marker]',
+].join(',')
+
+export function collectDiagnostics(options) {
+  const { tolerance, minFont, minHit, defaultLinkColor, chromeSelector, allowAttribute } = options
+
+  const isVisible = (element) => {
+    for (let node = element; node && node !== document.documentElement; node = node.parentElement) {
+      const style = getComputedStyle(node)
+      if (style.display === 'none' || style.visibility === 'hidden' || Number(style.opacity) < 0.05) {
+        return false
+      }
+    }
+    return true
+  }
+
+  const describe = (element) => {
+    const hooks = element.getAttributeNames().filter((name) => name.startsWith('data-presentation-'))
+    const entity = element.getAttribute('data-presentation-entity')
+    const label = entity ? `data-presentation-entity="${entity}"` : hooks[0]
+    const text = (element.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 24)
+    return `<${element.tagName.toLowerCase()}${label ? ` ${label}` : ''}>${text ? ` "${text}"` : ''}`
+  }
+
+  const union = (rects) => {
+    const boxes = rects.filter((rect) => rect.width > 0 && rect.height > 0)
+    if (!boxes.length) return null
+    return {
+      left: Math.min(...boxes.map((r) => r.left)),
+      top: Math.min(...boxes.map((r) => r.top)),
+      right: Math.max(...boxes.map((r) => r.right)),
+      bottom: Math.max(...boxes.map((r) => r.bottom)),
+    }
+  }
+
+  const candidates = new Map()
+  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT)
+  for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+    const parent = node.parentElement
+    if (!parent || !node.textContent.trim() || /^(SCRIPT|STYLE|NOSCRIPT)$/.test(parent.tagName)) continue
+    if (!isVisible(parent)) continue
+    const range = document.createRange()
+    range.selectNodeContents(node)
+    const rect = union([...range.getClientRects()])
+    if (!rect) continue
+    const previous = candidates.get(parent)
+    candidates.set(parent, previous ? union([previous, rect].map(toRect)) : rect)
+  }
+  function toRect(box) {
+    return { ...box, width: box.right - box.left, height: box.bottom - box.top }
+  }
+  for (const element of document.querySelectorAll(chromeSelector)) {
+    if (!isVisible(element)) continue
+    const box = element.getBoundingClientRect()
+    if (box.width > 0 && box.height > 0) {
+      candidates.set(element, { left: box.left, top: box.top, right: box.right, bottom: box.bottom })
+    }
+  }
+
+  const overlaps = []
+  const entries = [...candidates.entries()]
+  for (let i = 0; i < entries.length; i++) {
+    for (let j = i + 1; j < entries.length; j++) {
+      const [a, boxA] = entries[i]
+      const [b, boxB] = entries[j]
+      if (a.contains(b) || b.contains(a)) continue
+      if (a.closest(`[${allowAttribute}]`) || b.closest(`[${allowAttribute}]`)) continue
+      const width = Math.min(boxA.right, boxB.right) - Math.max(boxA.left, boxB.left)
+      const height = Math.min(boxA.bottom, boxB.bottom) - Math.max(boxA.top, boxB.top)
+      if (width > tolerance && height > tolerance) {
+        overlaps.push({ a: describe(a), b: describe(b) })
+      }
+    }
+  }
+
+  const styleKeys = [
+    'color',
+    'backgroundColor',
+    'borderTopColor',
+    'borderLeftColor',
+    'opacity',
+    'fontWeight',
+    'textDecorationLine',
+    'transform',
+  ]
+  const signature = (element) => {
+    const style = getComputedStyle(element)
+    const box = element.getBoundingClientRect()
+    // Text-bearing items differ in width just because their labels differ, which is not a
+    // visual distinction, so width counts only for items without text (such as dots).
+    const hasText = element.textContent.trim() !== ''
+    return JSON.stringify([
+      ...styleKeys.map((key) => style[key]),
+      hasText ? null : Math.round(box.width),
+      Math.round(box.height),
+    ])
+  }
+  const indistinct = []
+  for (const [kind, selector] of [
+    ['progress', '[data-presentation-progress-item]'],
+    ['toc', '[data-presentation-toc-entry]'],
+  ]) {
+    const items = [...document.querySelectorAll(selector)].filter(isVisible)
+    const active = items.filter((item) => item.getAttribute('data-presentation-active') === 'true')
+    const inactive = items.filter((item) => !active.includes(item))
+    if (active.length && inactive.length) {
+      const activeSignature = signature(active[0])
+      // matching any inactive peer is enough: the viewer cannot tell those two apart
+      if (inactive.some((item) => signature(item) === activeSignature)) {
+        indistinct.push({ kind, hook: selector.slice(1, -1) })
+      }
+    }
+  }
+
+  let attribution = { status: 'missing' }
+  const link = document.querySelector('[data-presentation-attribution]')
+  if (link && isVisible(link)) {
+    const box = link.getBoundingClientRect()
+    if (box.width > 0 && box.height > 0) {
+      const style = getComputedStyle(link)
+      const probe = document.createElement('span')
+      probe.style.cssText = 'all: initial'
+      document.body.append(probe)
+      const defaultFamily = getComputedStyle(probe).fontFamily
+      probe.remove()
+      const browserDefault =
+        style.color === defaultLinkColor &&
+        style.textDecorationLine.includes('underline') &&
+        style.fontFamily === defaultFamily
+      attribution = {
+        status: 'present',
+        fontSize: parseFloat(style.fontSize),
+        height: box.height,
+        browserDefault,
+      }
+    }
+  }
+
+  return { overlaps: overlaps.slice(0, 20), indistinct, attribution, minFont, minHit }
+}
+
+export function formatWarnings(step, findings) {
+  const warnings = []
+  for (const { a, b } of findings.overlaps) {
+    warnings.push({
+      step,
+      kind: 'overlap',
+      message: `${a} overlaps ${b}; mark an intentional overlap with ${ALLOW_OVERLAP_ATTRIBUTE}`,
+    })
+  }
+  for (const { kind, hook } of findings.indistinct) {
+    warnings.push({
+      step,
+      kind: 'active-chrome',
+      message: `active ${kind} item is visually indistinct from inactive items; style [${hook}][data-presentation-active="true"]`,
+    })
+  }
+  const { attribution } = findings
+  const hint = 'style it through [data-presentation-attribution]'
+  if (attribution.status === 'missing') {
+    warnings.push({ step, kind: 'attribution', message: `attribution is missing or hidden; ${hint}` })
+  } else {
+    if (attribution.fontSize < findings.minFont) {
+      warnings.push({
+        step,
+        kind: 'attribution',
+        message: `attribution font size ${attribution.fontSize}px is under ${findings.minFont}px; ${hint}`,
+      })
+    }
+    if (attribution.height < findings.minHit) {
+      warnings.push({
+        step,
+        kind: 'attribution',
+        message: `attribution hit box ${Math.round(attribution.height)}px is under ${findings.minHit}px; ${hint}`,
+      })
+    }
+    if (attribution.browserDefault) {
+      warnings.push({
+        step,
+        kind: 'attribution',
+        message: `attribution uses the browser-default link look; ${hint}`,
+      })
+    }
+  }
+  return warnings
+}
+
+export const diagnosticOptions = {
+  tolerance: OVERLAP_TOLERANCE_PX,
+  minFont: ATTRIBUTION_MIN_FONT_PX,
+  minHit: ATTRIBUTION_MIN_HIT_PX,
+  defaultLinkColor: BROWSER_DEFAULT_LINK_COLOR,
+  chromeSelector: CHROME_SELECTOR,
+  allowAttribute: ALLOW_OVERLAP_ATTRIBUTE,
+}
diff --git a/scripts/lib/runtime.mjs b/scripts/lib/runtime.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3c5f0b81a72a5a8762e6b5afa01dc55194ef99bb
--- /dev/null
+++ b/scripts/lib/runtime.mjs
@@ -0,0 +1,118 @@
+// Shared plumbing for verify.mjs and inspect-presentation.mjs: project root, loopback
+// preview server lifecycle, and child-process cleanup. Everything binds to 127.0.0.1.
+import { spawn } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import net from 'node:net'
+import { dirname, join, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+export const HOST = '127.0.0.1'
+
+const ANSI = new RegExp(`${String.fromCharCode(27)}\\[[0-9;]*m`, 'g')
+
+/** The project root is derived from this file's location, never from the caller's cwd. */
+export const projectRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..')
+
+export const sleep = (ms) => new Promise((done) => setTimeout(done, ms))
+
+const children = new Set()
+
+function killGroup(child, signal) {
+  try {
+    process.kill(-child.pid, signal)
+  } catch {
+    // already gone
+  }
+}
+
+/** Stops every process started through this module, escalating to SIGKILL. */
+export async function stopAll() {
+  const running = [...children]
+  for (const child of running) killGroup(child, 'SIGTERM')
+  const deadline = Date.now() + 3000
+  while (running.some((child) => child.exitCode === null && child.signalCode === null)) {
+    if (Date.now() > deadline) {
+      for (const child of running) killGroup(child, 'SIGKILL')
+      break
+    }
+    await sleep(50)
+  }
+  children.clear()
+}
+
+export function installSignalCleanup() {
+  for (const signal of ['SIGINT', 'SIGTERM']) {
+    process.once(signal, () => {
+      stopAll().finally(() => process.exit(signal === 'SIGINT' ? 130 : 143))
+    })
+  }
+}
+
+export function freePort() {
+  return new Promise((resolvePort, reject) => {
+    const server = net.createServer()
+    server.once('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolvePort(port))
+    })
+  })
+}
+
+/** Runs `npm run <script>` in the project root; resolves with { code, output }. */
+export function runNpm(script, cwd = projectRoot) {
+  return new Promise((done) => {
+    const child = spawn('npm', ['run', script], { cwd, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (chunk) => (output += chunk))
+    child.stderr.on('data', (chunk) => (output += chunk))
+    child.on('error', (error) => done({ code: 1, output: String(error) }))
+    child.on('close', (code) => done({ code: code ?? 1, output }))
+  })
+}
+
+/**
+ * Starts `vite preview` on the loopback address and resolves once it answers.
+ * Returns the url the server reports for itself and the url used for the readiness probe.
+ */
+export async function startPreview({ root = projectRoot, port } = {}) {
+  const chosen = port ?? Number(process.env.VERIFY_PORT || 0)
+  const previewPort = chosen || (await freePort())
+  const vite = join(root, 'node_modules', 'vite', 'bin', 'vite.js')
+  if (!existsSync(vite)) throw new Error(`vite is not installed under ${root}`)
+  const child = spawn(
+    process.execPath,
+    [vite, 'preview', '--host', HOST, '--port', String(previewPort), '--strictPort'],
+    { cwd: root, detached: true, stdio: ['ignore', 'pipe', 'pipe'] },
+  )
+  children.add(child)
+  let output = ''
+  child.stdout.on('data', (chunk) => (output += chunk))
+  child.stderr.on('data', (chunk) => (output += chunk))
+  let exited = false
+  child.on('exit', () => (exited = true))
+
+  const probeUrl = `http://${HOST}:${previewPort}/`
+  const deadline = Date.now() + 30_000
+  for (;;) {
+    if (exited) throw new Error(`preview server exited early:\n${output}`)
+    if (Date.now() > deadline) throw new Error(`preview server not ready at ${probeUrl}`)
+    try {
+      const response = await fetch(probeUrl)
+      if (response.ok) break
+    } catch {
+      // not listening yet
+    }
+    await sleep(100)
+  }
+  // Vite prints its own "Local:" url a moment after it starts listening.
+  const stripAnsi = (text) => text.replace(ANSI, '')
+  const urlPattern = /https?:\/\/[^\s/]+:\d+/
+  for (let wait = 0; wait < 20 && !urlPattern.test(stripAnsi(output)); wait++) await sleep(100)
+  const reported = stripAnsi(output).match(urlPattern)?.[0]
+  return { baseUrl: `http://${HOST}:${previewPort}`, probeUrl, boundUrl: reported, port: previewPort }
+}
+
+export function normalize(text) {
+  return String(text ?? '').replace(/\s+/g, ' ').trim()
+}
diff --git a/scripts/lib/settle.mjs b/scripts/lib/settle.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..1d99f37e2b342d6fe7630ae836a44cb4726e2b9e
--- /dev/null
+++ b/scripts/lib/settle.mjs
@@ -0,0 +1,18 @@
+/**
+ * Longest scene motion is a layout move followed by an entry fade
+ * (ENTER_DELAY + ENTER_T = 0.85 s in the kit); the default leaves headroom.
+ */
+export const DEFAULT_SETTLE_MS = 900
+
+/**
+ * Precedence: command-line flag, then INSPECT_SETTLE_MS, then the default.
+ * @param {{ flag?: string, env?: Record<string, string | undefined> }} [options]
+ */
+export function resolveSettleMs({ flag, env = process.env } = {}) {
+  for (const candidate of [flag, env.INSPECT_SETTLE_MS]) {
+    if (candidate === undefined || candidate === '') continue
+    const value = Number(candidate)
+    if (Number.isFinite(value) && value >= 0) return value
+  }
+  return DEFAULT_SETTLE_MS
+}
