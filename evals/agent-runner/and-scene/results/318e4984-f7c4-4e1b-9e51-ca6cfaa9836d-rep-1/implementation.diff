@@ -0,0 +1,270 @@
+.htmp {
+  --ink: #f8f3e6;
+  --muted: #b9b09b;
+  --accent: #e0bd5b;
+  --line: #6d6552;
+  --panel: #1d1a16;
+  --ok: #6fcf8a;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
+  color: var(--ink);
+  background: radial-gradient(circle at 20% 0%, #2a2418 0%, #0d0c0b 60%);
+}
+
+/* chrome */
+.htmp [data-presentation-header] {
+  display: flex;
+  align-items: baseline;
+  gap: 1.25rem;
+  flex-wrap: wrap;
+  padding: 1rem 1.5rem 0.25rem;
+}
+.htmp [data-presentation-marker] {
+  font-size: 0.8rem;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+.htmp [data-presentation-era] {
+  color: var(--accent);
+}
+.htmp [data-presentation-header] [data-presentation-title] {
+  margin: 0;
+  font-size: 1.5rem;
+  font-weight: 650;
+}
+.htmp [data-presentation-footer] {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: center;
+  gap: 0.5rem 1.5rem;
+  padding: 0.5rem 1.5rem 2.5rem;
+}
+.htmp [data-presentation-footer] [data-presentation-title] {
+  grid-column: 1 / -1;
+  margin: 0;
+  overflow: hidden;
+  font-size: clamp(1.4rem, 4vw, 2.25rem);
+  font-weight: 700;
+  text-align: center;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.htmp [data-presentation-caption] {
+  grid-column: 1 / -1;
+  max-width: 60rem;
+  margin: 0;
+  color: var(--muted);
+  font-size: 1rem;
+  line-height: 1.5;
+}
+.htmp [data-presentation-progress] {
+  display: flex;
+  align-items: center;
+  gap: 0.5rem;
+}
+.htmp [data-presentation-progress-item] {
+  width: 0.65rem;
+  height: 0.65rem;
+  padding: 0;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  background: transparent;
+  cursor: pointer;
+  transition: width 0.2s;
+}
+.htmp [data-presentation-progress-item][data-presentation-active='true'] {
+  width: 1.8rem;
+  border-color: var(--accent);
+  background: var(--accent);
