+  height: number
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6676990dd084361ca48a51fae08d8b03085d4f75
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,45 @@
+import { useCallback, useSyncExternalStore, type RefObject } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT } from './constants'
+import type { Canvas, Mode } from './types'
+
+/** Uniform scale that fits the canvas into the available box for a mode. */
+export function computeFitScale(
+  availableW: number,
+  availableH: number,
+  mode: Mode,
+  canvas: Canvas = { width: DESIGN_W, height: DESIGN_H },
+): number {
+  const { padX, padY } = STAGE_LAYOUT[mode]
+  const fit = Math.min(
+    (availableW - 2 * padX) / canvas.width,
+    (availableH - 2 * padY) / canvas.height,
+  )
+  return Math.max(MIN_SCALE, fit)
+}
+
+/** Fit scale for the element in `ref`, recomputed on resize and mode change. */
+export function useFitScale(
+  ref: RefObject<HTMLElement | null>,
+  mode: Mode,
+  canvas?: Canvas,
+): number {
+  const subscribe = useCallback(
+    (notify: () => void) => {
+      const element = ref.current
+      const observer = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(notify)
+      if (element) observer?.observe(element)
+      window.addEventListener('resize', notify)
+      return () => {
+        observer?.disconnect()
+        window.removeEventListener('resize', notify)
+      }
+    },
+    [ref],
+  )
+  const size = useSyncExternalStore(subscribe, () => {
+    const element = ref.current
+    return element ? `${element.clientWidth}x${element.clientHeight}` : '0x0'
+  })
+  const [w, h] = size.split('x').map(Number)
+  return computeFitScale(w, h, mode, canvas)
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0211f221de4e5565895d7a32c201fa122a5d6ae7
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,75 @@
+import { useCallback, useEffect, useState } from 'react'
+import { clampIndex, keyAction, swipeAction } from './navigation'
+import type { Mode } from './types'
+
+export interface PresentationNav {
+  index: number
+  mode: Mode
+  next(): void
+  prev(): void
+  goTo(index: number): void
+  toggleMode(): void
+}
+
+interface NavState {
+  index: number
+  mode: Mode
+}
+
+export function usePresentationNav(count: number, initialMode: Mode = 'present'): PresentationNav {
+  const [state, setState] = useState<NavState>({ index: 0, mode: initialMode })
+  const index = clampIndex(state.index, count)
+
+  const goTo = useCallback(
+    (target: number) =>
+      setState((s) => ({ ...s, index: clampIndex(target, count) })),
+    [count],
+  )
+  const next = useCallback(
+    () => setState((s) => ({ ...s, index: clampIndex(clampIndex(s.index, count) + 1, count) })),
+    [count],
+  )
+  const prev = useCallback(
+    () => setState((s) => ({ ...s, index: clampIndex(clampIndex(s.index, count) - 1, count) })),
+    [count],
+  )
+  const toggleMode = useCallback(
+    () => setState((s) => ({ ...s, mode: s.mode === 'present' ? 'browse' : 'present' })),
+    [],
+  )
+
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      const action = keyAction(event)
+      if (!action) return
+      event.preventDefault()
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else toggleMode()
+    }
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (event: TouchEvent) => {
+      const touch = event.touches[0]
+      start = touch ? { x: touch.clientX, y: touch.clientY } : null
+    }
+    const onTouchEnd = (event: TouchEvent) => {
+      const touch = event.changedTouches[0]
+      const origin = start
+      start = null
+      if (!origin || !touch) return
+      const action = swipeAction(touch.clientX - origin.x, touch.clientY - origin.y)
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart, { passive: true })
+    window.addEventListener('touchend', onTouchEnd, { passive: true })
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode: state.mode, next, prev, goTo, toggleMode }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useWideViewport.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useWideViewport.ts
