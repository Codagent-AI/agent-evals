+function Scene({payload}: {payload:number}) { return <span>Payload {payload}</span> }
+const steps: Step<number>[] = [0,1,2].map(i => ({id:String(i),era:i<2?'one':'two',title:`Title ${i}`,caption:`Caption ${i}`,Scene,payload:i,groupKey:'group'}))
+afterEach(cleanup)
