+  it('exposes metadata and clamped keyboard navigation', () => { const {container}=render(<Presentation steps={steps} title="Example"/>); const root=container.querySelector('[data-presentation-root]')!; expect(root.getAttribute('data-step-count')).toBe('3'); fireEvent.keyDown(window,{key:'ArrowLeft'}); expect(root.getAttribute('data-step-index')).toBe('0'); fireEvent.keyDown(window,{key:'ArrowRight'}); expect(screen.getByText('Caption 1')).toBeTruthy(); fireEvent.keyDown(window,{key:'PageDown'}); fireEvent.keyDown(window,{key:' '}); expect(root.getAttribute('data-step-index')).toBe('2') })
+  it('jumps, exposes active state and preserves position when changing mode', () => { render(<Presentation steps={steps} title="Example"/>); fireEvent.click(screen.getByLabelText('Step 3: Title 2')); expect(screen.getByLabelText('Step 3: Title 2').getAttribute('aria-current')).toBe('step'); fireEvent.click(screen.getByText('Present')); expect(screen.getByText('Title 2')).toBeTruthy(); expect(screen.queryByText('Caption 2')).toBeNull(); fireEvent.click(screen.getByText('Browse')); expect(screen.getByText('Caption 2')).toBeTruthy() })
+  it('does not intercept navigation keys from a focused control', () => { const {container}=render(<Presentation steps={steps} title="Example"/>); const button=screen.getByText('Present'); button.focus(); fireEvent.keyDown(button,{key:'ArrowRight'}); expect(container.querySelector('[data-presentation-root]')?.getAttribute('data-step-index')).toBe('0') })
+  it('calculates uniform scaling', () => { expect(fitScale(920,630,'browse')).toBe(1); expect(fitScale(480,440,'browse')).toBe(.5) })
+})
+describe('navigation details', () => {
+ it('supports previous keys, section jumps and initial present mode', () => { const {container}=render(<Presentation steps={steps} title="Example" initialMode="present"/>); const root=container.querySelector('[data-presentation-root]')!; fireEvent.keyDown(window,{key:'PageDown'}); fireEvent.keyDown(window,{key:'PageDown'}); fireEvent.keyDown(window,{key:'PageUp'}); expect(root.getAttribute('data-step-index')).toBe('1'); fireEvent.keyDown(window,{key:'ArrowLeft'}); expect(root.getAttribute('data-step-index')).toBe('0'); fireEvent.keyDown(window,{key:'p'}); fireEvent.click(screen.getByText('two')); expect(root.getAttribute('data-step-index')).toBe('2') })
+ it('uses horizontal swipes in both directions', () => { const {container}=render(<Presentation steps={steps} title="Example"/>); const root=container.querySelector('[data-presentation-root]')!; fireEvent.touchStart(root,{touches:[{clientX:200}]}); fireEvent.touchEnd(root,{changedTouches:[{clientX:100}]}); expect(root.getAttribute('data-step-index')).toBe('1'); fireEvent.touchStart(root,{touches:[{clientX:100}]}); fireEvent.touchEnd(root,{changedTouches:[{clientX:200}]}); expect(root.getAttribute('data-step-index')).toBe('0') })
+ it('shows linked attribution without default header branding', () => { const {container}=render(<Presentation steps={steps} title="Example"/>); const link=screen.getByText('made by and-scene'); expect(link.getAttribute('href')).toContain('github.com'); expect(container.querySelector('[data-presentation-header] a')).toBeNull() })
+})
+describe('scene contracts', () => {
+ it('retains a grouped scene instance as payload changes', () => { let mounts=0; function Group({payload}:{payload:number}) { const [id] = React.useState(() => ++mounts); return <span data-testid="group">{id}:{payload}</span> }; const grouped=steps.map(s=>({...s,Scene:Group})); render(<Presentation steps={grouped} title="Example"/>); expect(screen.getByTestId('group').textContent).toBe('1:0'); fireEvent.keyDown(window,{key:'ArrowRight'}); expect(screen.getByTestId('group').textContent).toBe('1:1'); expect(mounts).toBe(1) })
+})
