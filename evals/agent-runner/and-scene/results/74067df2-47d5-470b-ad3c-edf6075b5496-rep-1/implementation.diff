diff --git a/src/presentations/how-to-make-a-presentation/entities.ts b/src/presentations/how-to-make-a-presentation/entities.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a4341c07931fb28c4bf572ffd4abb5c80603b5ce
