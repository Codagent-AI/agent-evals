+{
+  "name": "presentations",
+  "version": "0.0.0",
+  "lockfileVersion": 3,
+  "requires": true,
+  "packages": {
+    "": {
+      "name": "presentations",
+      "version": "0.0.0",
+      "dependencies": {
+        "lucide-react": "^1.17.0",
+        "motion": "^12.40.0",
+        "react": "^19.2.6",
+        "react-dom": "^19.2.6"
+      },
