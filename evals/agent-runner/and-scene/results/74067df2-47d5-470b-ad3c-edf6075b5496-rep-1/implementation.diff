diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..42d6571cb18c6a8ff77c3511748278d61a5a9045
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,104 @@
+#!/usr/bin/env node
+import { mkdirSync, rmSync } from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { collectSceneContent, collectSnapshot, DEFAULT_SETTLE_MS, DISTINCTION_PROPS, unsettledEntities, VIEWPORT, warningsForStep } from './lib/inspect-diagnostics.mjs'
+import { closeAll, exitOnSignals, launchBrowser, runNpmBuild, startPreview } from './lib/preview.mjs'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+
+function parseArgs(argv) {
+  const options = { slug: undefined, settleMs: Number(process.env.INSPECT_SETTLE_MS) || DEFAULT_SETTLE_MS, build: true }
+  for (let i = 0; i < argv.length; i++) {
+    if (argv[i] === '--settle') options.settleMs = Number(argv[++i])
+    else if (argv[i] === '--skip-build') options.build = false
+    else if (!argv[i].startsWith('--')) options.slug = argv[i]
+    else throw new Error(`unknown option ${argv[i]}`)
+  }
+  if (!options.slug) throw new Error('usage: npm run inspect -- <slug> [--settle <ms>] [--skip-build]')
+  if (!(options.settleMs >= 0)) throw new Error('--settle must be a number of milliseconds')
+  return options
+}
+
+/** Fonts loaded, then two samples a few frames apart show every entity still, opaque and painted. */
+async function sceneSettled(page, timeoutMs = 5000) {
+  const deadline = Date.now() + timeoutMs
+  await page.evaluate(() => document.fonts?.ready)
+  let pending = ['scene']
+  while (Date.now() < deadline) {
+    const before = await page.evaluate(collectSceneContent)
+    await page.evaluate(() => new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve))))
+    await page.waitForTimeout(100)
+    pending = unsettledEntities(before, await page.evaluate(collectSceneContent))
+    if (pending.length === 0) return []
+  }
+  return pending
+}
+
+const readIndex = (page) => page.evaluate(() => Number(document.querySelector('[data-step-index]')?.getAttribute('data-step-index')))
+
+async function inspect({ slug, settleMs, build }) {
+  if (build) await runNpmBuild(root)
+  const outDir = path.join(root, 'inspection', slug)
+  rmSync(outDir, { recursive: true, force: true })
+  mkdirSync(outDir, { recursive: true })
+
+  const preview = await startPreview(root)
+  exitOnSignals(() => preview.stop())
+  let browser
+  let warningCount = 0
+  try {
+    browser = await launchBrowser()
+    const page = await browser.newPage({ viewport: VIEWPORT })
+    await page.goto(`${preview.url}/${slug}`, { waitUntil: 'load' })
+    await page.waitForSelector('[data-step-count]', { timeout: 10000 })
+    const total = Number(await page.getAttribute('[data-step-count]', 'data-step-count'))
+    for (let index = 0; index < total; index++) {
+      const began = Date.now()
+      if (index > 0) {
+        await page.keyboard.press('ArrowRight')
+        await page.waitForFunction((want) => Number(document.querySelector('[data-step-index]')?.getAttribute('data-step-index')) === want, index, { timeout: 5000 })
+          .catch(async () => {
+            throw new Error(`step ${index + 1} of ${total}: ArrowRight did not advance to index ${index} (stayed at ${await readIndex(page)})`)
+          })
+      }
+      await page.waitForTimeout(settleMs)
+      const wrappersOpaque = await page
+        .waitForFunction(
+          () => [...document.querySelectorAll('[data-presentation-appear],[data-presentation-scene]')].every((el) => Number(getComputedStyle(el).opacity) >= 0.999),
+          undefined,
+          { timeout: 5000 },
+        )
+        .then(() => true, () => false)
+      const pending = await sceneSettled(page)
+      const settled = wrappersOpaque && pending.length === 0
+      const file = path.join(outDir, `step-${String(index + 1).padStart(2, '0')}.png`)
+      await page.screenshot({ path: file })
+      const shown = await page.evaluate(() => ({
+        index: Number(document.querySelector('[data-step-index]')?.getAttribute('data-step-index')),
+        title: document.querySelector('[data-presentation-title]')?.textContent ?? '',
+      }))
+      console.log(
+        `captured ${path.basename(file)} ${Date.now() - began}ms after navigation (settle ${settleMs}ms) ` +
+          `step ${shown.index + 1}/${total} "${shown.title}" ${settled ? 'settled' : 'UNSETTLED'}`,
+      )
+      if (!settled) {
+        warningCount++
+        console.log(`WARN step ${index + 1} settle: animations were still running at capture${pending.length ? ` (${pending.slice(0, 3).join('; ')})` : ''}; raise --settle`)
+      }
+      const warnings = warningsForStep(index + 1, await page.evaluate(collectSnapshot, DISTINCTION_PROPS))
+      warningCount += warnings.length
+      for (const warning of warnings) console.log(warning)
+    }
+    console.log(`inspected ${slug}: ${total} screenshots in ${path.relative(root, outDir)}/ (${warningCount} advisory warnings)`)
+  } finally {
+    await closeAll(browser, preview)
+  }
+}
+
+try {
+  await inspect(parseArgs(process.argv.slice(2)))
+} catch (error) {
+  console.error(`ERROR inspect: ${error.message}`)
+  process.exitCode = 1
+}
diff --git a/scripts/lib/inspect-diagnostics.mjs b/scripts/lib/inspect-diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3901b74b09ae12c241143c217d8f50a946a13483
--- /dev/null
+++ b/scripts/lib/inspect-diagnostics.mjs
@@ -0,0 +1,201 @@
+/** Defaults for the inspection helper. */
+export const VIEWPORT = { width: 1280, height: 720 }
+/** Longer than the kit's longest transition (layout morph + enter delay + fade-in ≈ 1.05 s). */
+export const DEFAULT_SETTLE_MS = 1500
+export const MIN_ATTRIBUTION_PX = 11
+export const OVERLAP_MIN_PX = 4
+export const DEFAULT_LINK_COLORS = ['rgb(0, 0, 238)', 'rgb(85, 26, 139)', 'rgb(158, 158, 255)', 'rgb(255, 0, 0)']
+
+/** Computed-style properties that can make an active control look different. */
+export const DISTINCTION_PROPS = [
+  'color', 'backgroundColor', 'borderTopColor', 'borderTopWidth', 'borderTopStyle', 'outlineStyle',
+  'outlineWidth', 'outlineColor', 'boxShadow', 'fontWeight', 'opacity', 'width', 'height',
+  'textDecorationLine', 'transform',
+]
+
+/** Overlapping area exceeds `min` px in both axes. */
+export function rectsOverlap(a, b, min = OVERLAP_MIN_PX) {
+  const w = Math.min(a.x + a.width, b.x + b.width) - Math.max(a.x, b.x)
+  const h = Math.min(a.y + a.height, b.y + b.height) - Math.max(a.y, b.y)
+  return w > min && h > min
+}
+
+/**
+ * Pairs of visible text/chrome items that overlap. Ancestor/descendant pairs and
+ * pairs with a member inside an allow-overlap subtree are exempt.
+ * item: { desc, rect, allowed, ancestors: number[] }
+ */
+export function findOverlaps(items) {
+  const pairs = []
+  for (let i = 0; i < items.length; i++) {
+    for (let j = i + 1; j < items.length; j++) {
+      const a = items[i]
+      const b = items[j]
+      if (a.allowed || b.allowed) continue
+      if (a.ancestors.includes(j) || b.ancestors.includes(i)) continue
+      if (rectsOverlap(a.rect, b.rect)) pairs.push([a.desc, b.desc])
+    }
+  }
+  return pairs
+}
+
+/**
+ * True when every compared style property of the active control equals the inactive one.
+ * Size only counts for controls without a text label, since label widths differ regardless of styling.
+ */
+export function isIndistinct(active, inactive) {
+  const labelled = active._hasText || inactive._hasText
+  return DISTINCTION_PROPS.filter((prop) => !(labelled && (prop === 'width' || prop === 'height'))).every((prop) => active[prop] === inactive[prop])
+}
+
+export function attributionIssues(snapshot) {
+  if (!snapshot.present) return ['no default attribution link was found']
+  const issues = []
+  if (snapshot.fontSize < MIN_ATTRIBUTION_PX) issues.push(`text is ${snapshot.fontSize}px, under ${MIN_ATTRIBUTION_PX}px`)
+  if (DEFAULT_LINK_COLORS.includes(snapshot.color)) issues.push(`uses the browser-default link color ${snapshot.color}`)
+  if (snapshot.fontFamily === snapshot.defaultFontFamily) issues.push('uses the browser-default font family')
+  return issues
+}
+
+/** Turns an in-page snapshot of one settled step into advisory warning lines. */
+export function warningsForStep(step, snapshot) {
+  const warnings = []
+  for (const [a, b] of findOverlaps(snapshot.items)) {
+    warnings.push(`WARN step ${step} overlap: ${a} overlaps ${b} (mark an intentional overlap with data-presentation-allow-overlap)`)
+  }
+  for (const group of snapshot.nav) {
+    if (group.active && group.inactive && isIndistinct(group.active, group.inactive)) {
+      warnings.push(`WARN step ${step} active-chrome: the active ${group.name} looks the same as inactive ones (style [data-presentation-active="true"])`)
+    }
+  }
+  const issues = attributionIssues(snapshot.attribution)
+  if (issues.length) {
+    warnings.push(`WARN step ${step} attribution: ${issues.join('; ')} (style [data-presentation-attribution])`)
+  }
+  return warnings
+}
+
+/** Largest per-axis drift (px) between two samples that still counts as "not moving". */
+export const SETTLE_DRIFT_PX = 0.5
+/** Largest opacity change between two samples that still counts as "not fading". */
+export const SETTLE_OPACITY_DRIFT = 0.001
+
+/**
+ * Entities that are still changing between two samples taken a few frames apart.
+ * sample: [{ id, opacity, rect: { x, y, width, height } }] (ids are unique within a sample)
+ * An entity is unsettled while it moves, resizes, fades, or has just mounted or unmounted.
+ * Entities that are steady but deliberately dimmed or hidden are settled.
+ */
+export function unsettledEntities(before, after) {
+  const earlier = new Map(before.map((entity) => [entity.id, entity]))
+  const pending = []
+  for (const entity of after) {
+    const prior = earlier.get(entity.id)
+    if (!prior) {
+      pending.push(`${entity.id} (mounted since the previous sample)`)
+      continue
+    }
+    if (['x', 'y', 'width', 'height'].some((axis) => Math.abs(entity.rect[axis] - prior.rect[axis]) > SETTLE_DRIFT_PX)) pending.push(`${entity.id} (still moving)`)
+    else if (Math.abs(entity.opacity - prior.opacity) > SETTLE_OPACITY_DRIFT) pending.push(`${entity.id} (still fading)`)
+  }
+  for (const id of earlier.keys()) if (!after.some((entity) => entity.id === id)) pending.push(`${id} (unmounted since the previous sample)`)
+  return pending
+}
+
+/** Runs inside the page; must stay self-contained (it is serialised into the browser). */
+export function collectSceneContent() {
+  const opacityOf = (el) => {
+    let opacity = 1
+    for (let node = el; node && node !== document.documentElement; node = node.parentElement) opacity *= Number(getComputedStyle(node).opacity)
+    return opacity
+  }
+  const seen = {}
+  return [...document.querySelectorAll('[data-presentation-entity]')].map((el) => {
+    const rect = el.getBoundingClientRect()
+    const name = el.getAttribute('data-presentation-entity')
+    // duplicate ids are keyed by DOM order so each element is compared with itself
+    seen[name] = (seen[name] ?? -1) + 1
+    return {
+      id: seen[name] === 0 ? name : `${name}#${seen[name]}`,
+      opacity: opacityOf(el),
+      rect: { x: rect.x, y: rect.y, width: rect.width, height: rect.height },
+    }
+  })
+}
+
+/** Runs inside the page; must stay self-contained (it is serialised into the browser). */
+export function collectSnapshot(props) {
+  const root = document.querySelector('[data-presentation-root]')
+  const visible = (el) => {
+    const rect = el.getBoundingClientRect()
+    if (rect.width <= 0 || rect.height <= 0) return false
+    // hidden when it, or any ancestor, is not displayed or fully transparent
+    for (let node = el; node && node !== document.documentElement; node = node.parentElement) {
+      const style = getComputedStyle(node)
+      if (style.display === 'none' || style.visibility === 'hidden' || Number(style.opacity) === 0) return false
+    }
+    return true
+  }
+  const textRect = (el) => {
+    let box = null
+    for (const node of el.childNodes) {
+      if (node.nodeType !== Node.TEXT_NODE || !node.textContent.trim()) continue
+      const range = document.createRange()
+      range.selectNodeContents(node)
+      const r = range.getBoundingClientRect()
+      if (!r.width || !r.height) continue
+      box = box
+        ? { x: Math.min(box.x, r.x), y: Math.min(box.y, r.y), right: Math.max(box.right, r.right), bottom: Math.max(box.bottom, r.bottom) }
+        : { x: r.x, y: r.y, right: r.right, bottom: r.bottom }
+    }
+    return box && { x: box.x, y: box.y, width: box.right - box.x, height: box.bottom - box.y }
+  }
+  const describe = (el) => {
+    const owner = el.closest('[data-presentation-entity]')
+    const hook = owner ? `[data-presentation-entity="${owner.getAttribute('data-presentation-entity')}"]` : el.getAttributeNames().find((n) => n.startsWith('data-presentation-')) ?? el.tagName.toLowerCase()
+    const text = (el.textContent ?? '').trim().replace(/\s+/g, ' ').slice(0, 30)
+    return text ? `${hook} "${text}"` : hook
+  }
+  const elements = []
+  if (root) {
+    const controls = '[data-presentation-dot],[data-presentation-prev],[data-presentation-next],[data-presentation-toc-entry]'
+    for (const el of root.querySelectorAll('*')) {
+      if (!visible(el)) continue
+      const box = el.matches(controls) ? el.getBoundingClientRect() : textRect(el)
+      if (box) elements.push({ el, rect: { x: box.x, y: box.y, width: box.width, height: box.height } })
+    }
+  }
+  const items = elements.map(({ el, rect }, i) => ({
+    desc: describe(el),
+    rect,
+    allowed: el.closest('[data-presentation-allow-overlap]') !== null,
+    ancestors: elements.flatMap((other, j) => (j !== i && other.el.contains(el) ? [j] : [])),
+  }))
+  const style = (el) => ({ ...Object.fromEntries(props.map((p) => [p, getComputedStyle(el)[p]])), _hasText: el.textContent.trim().length > 0 })
+  const group = (name, selector) => {
+    const all = [...document.querySelectorAll(selector)].filter(visible)
+    const active = all.find((el) => el.getAttribute('data-presentation-active') === 'true')
+    const inactive = all.find((el) => el !== active)
+    return { name, active: active ? style(active) : null, inactive: inactive ? style(inactive) : null }
+  }
+  const link = document.querySelector('[data-presentation-attribution]')
+  const frame = document.createElement('iframe')
+  document.body.appendChild(frame)
+  const probe = frame.contentDocument.createElement('a')
+  probe.href = '#'
+  frame.contentDocument.body.appendChild(probe)
+  const defaultFontFamily = getComputedStyle(probe).fontFamily
+  frame.remove()
+  const linkStyle = link && getComputedStyle(link)
+  return {
+    items,
+    nav: [group('progress indicator', '[data-presentation-dot]'), group('table-of-contents entry', '[data-presentation-toc-entry]')],
+    attribution: {
+      present: Boolean(link),
+      fontSize: linkStyle ? parseFloat(linkStyle.fontSize) : 0,
+      color: linkStyle?.color ?? '',
+      fontFamily: linkStyle?.fontFamily ?? '',
+      defaultFontFamily,
+    },
+  }
+}
diff --git a/scripts/lib/preview.mjs b/scripts/lib/preview.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..63fa967f359455a24233977ed40497aecad39fa4
--- /dev/null
+++ b/scripts/lib/preview.mjs
@@ -0,0 +1,126 @@
+import { spawn } from 'node:child_process'
+import { createRequire } from 'node:module'
+import http from 'node:http'
+import net from 'node:net'
+import path from 'node:path'
+
+/** Deterministic IPv4 loopback, so nothing depends on how the local hostname resolves. */
+export const HOST = '127.0.0.1'
+
+export function freePort() {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer()
+    server.once('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+}
+
+function probe(url) {
+  return new Promise((resolve) => {
+    const request = http.get(url, (response) => {
+      response.resume()
+      resolve(response.statusCode === 200)
+    })
+    request.on('error', () => resolve(false))
+    request.setTimeout(1000, () => {
+      request.destroy()
+      resolve(false)
+    })
+  })
+}
+
+function killTree(child, signal) {
+  try {
+    process.kill(-child.pid, signal)
+  } catch {
+    // no process groups (e.g. Windows) or already gone: fall back to the child itself
+    try {
+      child.kill(signal)
+    } catch {
+      /* already gone */
+    }
+  }
+}
+
+/** Serves `dist/` with `vite preview` on 127.0.0.1 and resolves once it answers. */
+export async function startPreview(root, { timeoutMs = 30000 } = {}) {
+  let viteBin
+  try {
+    viteBin = path.join(path.dirname(createRequire(path.join(root, 'package.json')).resolve('vite/package.json')), 'bin', 'vite.js')
+  } catch {
+    throw new Error(`vite is not installed for ${root}`)
+  }
+  const port = await freePort()
+  const child = spawn(process.execPath, [viteBin, 'preview', '--host', HOST, '--port', String(port), '--strictPort'], {
+    cwd: root,
+    stdio: ['ignore', 'pipe', 'pipe'],
+    detached: true,
+  })
+  let output = ''
+  child.stdout.on('data', (chunk) => (output += chunk))
+  child.stderr.on('data', (chunk) => (output += chunk))
+  const exited = new Promise((resolve) => child.once('exit', resolve))
+  const onExit = () => killTree(child, 'SIGKILL')
+  process.on('exit', onExit)
+
+  const url = `http://${HOST}:${port}`
+  const stop = async () => {
+    process.off('exit', onExit)
+    killTree(child, 'SIGTERM')
+    const timer = setTimeout(() => killTree(child, 'SIGKILL'), 3000)
+    // never wait forever for a process that cannot be signalled
+    await Promise.race([exited, new Promise((resolve) => setTimeout(resolve, 6000).unref())])
+    clearTimeout(timer)
+  }
+
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    if (child.exitCode !== null) throw new Error(`preview exited early:\n${output}`)
+    if (await probe(`${url}/`)) return { url, port, stop }
+    await new Promise((resolve) => setTimeout(resolve, 150))
+  }
+  await stop()
+  throw new Error(`preview did not become ready on ${url}:\n${output}`)
+}
+
+/** Runs `cleanup` on SIGINT/SIGTERM before exiting, so previews never outlive the script. */
+export function exitOnSignals(cleanup) {
+  for (const signal of ['SIGINT', 'SIGTERM']) {
+    process.once(signal, () => {
+      Promise.resolve(cleanup()).finally(() => process.exit(signal === 'SIGINT' ? 130 : 143))
+    })
+  }
+}
+
+export async function launchBrowser() {
+  const { chromium } = await import('playwright')
+  return chromium.launch()
+}
+
+/** Runs `npm run build` in `root`; rejects with the captured output on failure. */
+export function runNpmBuild(root) {
+  return new Promise((resolve, reject) => {
+    const npm = process.platform === 'win32' ? 'npm.cmd' : 'npm'
+    const child = spawn(npm, ['run', 'build'], { cwd: root, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (chunk) => (output += chunk))
+    child.stderr.on('data', (chunk) => (output += chunk))
+    child.on('error', (error) => reject(new Error(`could not run npm: ${error.message}`)))
+    child.on('close', (code) => {
+      if (code === 0) resolve()
+      else reject(new Error(`npm run build exited with code ${code}\n${output.trim()}`))
+    })
+  })
+}
+
+/** Closes the browser, then always stops the preview, even when closing the browser fails. */
+export async function closeAll(browser, preview) {
+  try {
+    await browser?.close()
+  } finally {
+    await preview.stop()
+  }
+}
