diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..85664b7bc8e34cd9876cce81b092e6591e608530
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,69 @@
+import { useEffect, type ReactNode } from 'react'
+import { Attribution } from './chrome/Attribution'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { Toc } from './chrome/Toc'
+import { DESIGN_H, DESIGN_W, WIDE_VIEWPORT_MIN } from './constants'
+import { Stage } from './Stage'
+import type { AttributionOption, Canvas, Mode, Step } from './types'
+import { usePresentationNav } from './usePresentationNav'
+import { useViewport } from './useViewport'
+
+const DEFAULT_CANVAS: Canvas = { width: DESIGN_W, height: DESIGN_H }
+
+export interface PresentationProps<P> {
+  steps: readonly Step<P>[]
+  /** Presentation title; becomes the document title. */
+  title: string
+  initialMode?: Mode
+  initialIndex?: number
+  canvas?: Canvas
+  /** Default attribution link; pass `false` to hide it or an object to override it. */
+  attribution?: AttributionOption
+  /** Optional host branding for the top-left header slot. */
+  brand?: ReactNode
+  className?: string
+}
+
+export function Presentation<P>({
+  steps,
+  title,
+  initialMode,
+  initialIndex,
+  canvas = DEFAULT_CANVAS,
+  attribution,
+  brand,
+  className,
+}: PresentationProps<P>) {
+  const nav = usePresentationNav({ count: steps.length, initialMode, initialIndex })
+  const viewport = useViewport()
+  useEffect(() => {
+    document.title = title
+  }, [title])
+
+  if (steps.length === 0) {
+    // Nothing to show yet; keep the verification hooks so tooling reports an empty deck, not a crash.
+    return <div className={className} data-presentation-root="" data-step-count={0} data-presentation-step-count={0} data-step-index={0} data-presentation-step-index={0} />
+  }
+  const step = steps[nav.index]
+  const browse = nav.mode === 'browse'
+  return (
+    <div
+      className={className}
+      data-presentation-root=""
+      data-presentation-title-text={title}
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      data-presentation-step-count={steps.length}
+      data-presentation-step-index={nav.index}
+      style={{ position: 'fixed', inset: 0, overflow: 'hidden' }}
+    >
+      <Header mode={nav.mode} index={nav.index} step={step} brand={brand} />
+      {browse && viewport.width >= WIDE_VIEWPORT_MIN && <Toc steps={steps} index={nav.index} onJump={nav.goTo} />}
+      <Stage step={step} index={nav.index} mode={nav.mode} canvas={canvas} />
+      <Footer mode={nav.mode} steps={steps} index={nav.index} onJump={nav.goTo} onPrev={nav.prev} onNext={nav.next} />
+      <Attribution option={attribution} />
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..40f7e80ae9f1fe19726dccd204aa9ad5d3863f73
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,65 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { ENTER_T } from './constants'
+import { sceneKey } from './sceneKey'
+import type { Canvas, Mode, SceneProps, Step } from './types'
+import { stageBox, useFitScale } from './useFitScale'
+import { useViewport } from './useViewport'
+
+export interface StageProps<P> {
+  step: Step<P>
+  index: number
+  mode: Mode
+  canvas: Canvas
+}
+
+export function Stage<P>({ step, index, mode, canvas }: StageProps<P>) {
+  const scale = useFitScale(mode, canvas)
+  const box = stageBox(mode, useViewport())
+  const sceneProps: SceneProps<P> = { payload: step.payload, step, index }
+  const Scene = step.Scene
+  return (
+    <div
+      data-presentation-stage=""
+      style={{
+        position: 'absolute',
+        top: box.top,
+        bottom: box.bottom,
+        left: box.side,
+        right: box.side,
+        display: 'flex',
+        alignItems: 'center',
+        justifyContent: 'center',
+        overflow: 'hidden',
+      }}
+    >
+      <div
+        data-presentation-canvas=""
+        data-presentation-scale={scale}
+        style={{
+          position: 'relative',
+          flex: 'none',
+          width: canvas.width,
+          height: canvas.height,
+          transform: `scale(${scale})`,
+          transformOrigin: 'center center',
+        }}
+      >
+        <LayoutGroup>
+          <AnimatePresence initial={false}>
+            <motion.div
+              key={sceneKey(step)}
+              data-presentation-scene=""
+              initial={{ opacity: 0 }}
+              animate={{ opacity: 1 }}
+              exit={{ opacity: 0 }}
+              transition={{ duration: ENTER_T }}
+              style={{ position: 'absolute', left: 0, top: 0, width: '100%', height: '100%' }}
+            >
+              <Scene {...sceneProps} />
+            </motion.div>
+          </AnimatePresence>
+        </LayoutGroup>
+      </div>
+    </div>
+  )
+}
diff --git a/src/presentation-kit/chrome/Attribution.tsx b/src/presentation-kit/chrome/Attribution.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..922ada60414000bb19d571a10dcb860a96a775e4
--- /dev/null
+++ b/src/presentation-kit/chrome/Attribution.tsx
@@ -0,0 +1,20 @@
+import { DEFAULT_ATTRIBUTION } from '../constants'
+import type { AttributionOption } from '../types'
+
+export function Attribution({ option }: { option?: AttributionOption }) {
+  if (option === false) return null
+  const label = option?.label ?? DEFAULT_ATTRIBUTION.label
+  const href = option?.href ?? DEFAULT_ATTRIBUTION.href
+  return (
+    <a
+      data-presentation-attribution=""
+      data-presentation-chrome="attribution"
+      href={href}
+      target="_blank"
+      rel="noopener noreferrer"
+      style={{ position: 'absolute', right: 0, bottom: 0 }}
+    >
+      {label}
+    </a>
+  )
+}
diff --git a/src/presentation-kit/chrome/Footer.tsx b/src/presentation-kit/chrome/Footer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..77b3d6e8997ae66dc48d156e098d203a1ad7b27c
--- /dev/null
+++ b/src/presentation-kit/chrome/Footer.tsx
@@ -0,0 +1,62 @@
+import { STAGE_LAYOUT } from '../constants'
+import type { Mode, StepMeta } from '../types'
+import { activeProps } from './activeProps'
+
+export interface FooterProps {
+  mode: Mode
+  steps: readonly StepMeta[]
+  index: number
+  onJump: (index: number) => void
+  onPrev: () => void
+  onNext: () => void
+}
+
+export function Footer({ mode, steps, index, onJump, onPrev, onNext }: FooterProps) {
+  const step = steps[index]
+  const present = mode === 'present'
+  return (
+    <footer
+      data-presentation-footer=""
+      data-presentation-chrome="footer"
+      style={{
+        position: 'absolute',
+        bottom: 0,
+        left: 0,
+        right: 0,
+        height: present ? STAGE_LAYOUT.present.insetBottom : STAGE_LAYOUT.browse.insetBottom,
+        display: 'flex',
+        flexDirection: 'column',
+        justifyContent: 'flex-end',
+      }}
+    >
+      {present ? (
+        <p data-presentation-title="">{step.title}</p>
+      ) : (
+        <>
+          <p data-presentation-caption="">{step.caption}</p>
+          <div data-presentation-controls="" style={{ display: 'flex', alignItems: 'center' }}>
+            <button type="button" data-presentation-prev="" aria-label="Previous step" disabled={index === 0} onClick={onPrev}>
+              Prev
+            </button>
+            <ol data-presentation-progress="" data-presentation-chrome="dots" style={{ display: 'flex' }}>
+              {steps.map((s, i) => (
+                <li key={s.id}>
+                  <button
+                    type="button"
+                    data-presentation-dot={s.id}
+                    aria-label={`Go to step ${i + 1}: ${s.title}`}
+                    onClick={() => onJump(i)}
+                    {...activeProps(i === index)}
+                  />
+                </li>
+              ))}
+            </ol>
+            <button type="button" data-presentation-next="" aria-label="Next step" disabled={index === steps.length - 1} onClick={onNext}>
+              Next
+            </button>
+          </div>
+        </>
+      )}
+    </footer>
+  )
+}
diff --git a/src/presentation-kit/chrome/Header.tsx b/src/presentation-kit/chrome/Header.tsx
