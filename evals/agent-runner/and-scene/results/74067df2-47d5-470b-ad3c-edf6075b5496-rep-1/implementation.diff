diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..911e7f720e2b0c89587184ae1ad0a5745ada94be
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,33 @@
+import { MIN_SCALE, STAGE_LAYOUT } from './constants'
+import type { Canvas, Mode } from './types'
+import { useViewport, type Viewport } from './useViewport'
+
+export interface StageBox {
+  top: number
+  bottom: number
+  side: number
+  width: number
+  height: number
+}
+
+export function stageBox(mode: Mode, viewport: Viewport): StageBox {
+  const { insetTop, insetBottom, insetX } = STAGE_LAYOUT[mode]
+  return {
+    top: insetTop,
+    bottom: insetBottom,
+    side: insetX,
+    width: viewport.width - insetX * 2,
+    height: viewport.height - insetTop - insetBottom,
+  }
+}
+
+/** Uniform fit scale: no upper cap, never below MIN_SCALE. */
+export function computeFitScale(available: Viewport, canvas: Canvas): number {
+  const fit = Math.min(available.width / canvas.width, available.height / canvas.height)
+  return Math.max(MIN_SCALE, fit)
+}
+
+export function useFitScale(mode: Mode, canvas: Canvas): number {
+  const viewport = useViewport()
+  return computeFitScale(stageBox(mode, viewport), canvas)
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..caa86030ceab7d827ea29fe9164c5aa803e389cd
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,109 @@
+import { useCallback, useEffect, useState } from 'react'
+import { SWIPE_MIN_PX } from './constants'
+import type { Mode } from './types'
+
+const INTERACTIVE_ROLES = [
+  'button', 'link', 'tab', 'menuitem', 'menuitemcheckbox', 'menuitemradio', 'checkbox', 'radio',
+  'switch', 'slider', 'spinbutton', 'textbox', 'searchbox', 'combobox', 'listbox', 'option', 'treeitem',
+  // composite widgets that own arrow-key navigation
+  'grid', 'gridcell', 'treegrid', 'tree', 'tablist', 'menu', 'menubar', 'radiogroup', 'toolbar', 'scrollbar',
+  'row', 'rowheader', 'columnheader',
+]
+const INTERACTIVE_SELECTOR = [
+  'button',
+  'a[href]',
+  'input',
+  'select',
+  'textarea',
+  'summary',
+  '[contenteditable]:not([contenteditable="false"])',
+  ...INTERACTIVE_ROLES.map((role) => `[role="${role}"]`),
+].join(',')
+
+/** True when the event target is (inside) a control that owns navigation keys. */
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE_SELECTOR) !== null
+}
+
+export function clampIndex(index: number, count: number): number {
+  return Math.max(0, Math.min(index, Math.max(0, count - 1)))
+}
+
+export function swipeDirection(dx: number, dy: number): 'next' | 'prev' | null {
+  if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) <= Math.abs(dy)) return null
+  return dx < 0 ? 'next' : 'prev'
+}
+
+export interface NavOptions {
+  count: number
+  initialMode?: Mode
+  initialIndex?: number
+}
+
+export interface Nav {
+  index: number
+  mode: Mode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  setMode: (mode: Mode) => void
+  toggleMode: () => void
+}
+
+export function usePresentationNav({ count, initialMode = 'present', initialIndex = 0 }: NavOptions): Nav {
+  const [rawIndex, setIndex] = useState(initialIndex)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const index = clampIndex(rawIndex, count)
+
+  const goTo = useCallback((i: number) => setIndex(clampIndex(i, count)), [count])
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, count)), [count])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'present' ? 'browse' : 'present')), [])
+
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.ctrlKey || event.metaKey || event.altKey) return
+      if (isInteractiveTarget(event.target)) return
+      switch (event.key) {
+        case 'ArrowRight':
+        case 'PageDown':
+        case ' ':
+          event.preventDefault()
+          next()
+          break
+        case 'ArrowLeft':
+        case 'PageUp':
+          event.preventDefault()
+          prev()
+          break
+        case 'p':
+        case 'P':
+          toggleMode()
+          break
+      }
+    }
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (event: TouchEvent) => {
+      const touch = event.touches[0]
+      start = touch ? { x: touch.clientX, y: touch.clientY } : null
+    }
+    const onTouchEnd = (event: TouchEvent) => {
+      const touch = event.changedTouches[0]
+      if (!start || !touch) return
+      const direction = swipeDirection(touch.clientX - start.x, touch.clientY - start.y)
+      start = null
+      if (direction === 'next') next()
+      else if (direction === 'prev') prev()
+    }
+    window.addEventListener('keydown', onKeyDown)
+    window.addEventListener('touchstart', onTouchStart)
+    window.addEventListener('touchend', onTouchEnd)
+    return () => {
+      window.removeEventListener('keydown', onKeyDown)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, next, prev, goTo, setMode, toggleMode }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useViewport.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useViewport.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4da016da2e2a5c84df1efb5ce141a4e77c8859ae
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useViewport.ts
@@ -0,0 +1,18 @@
+import { useEffect, useState } from 'react'
+
+export interface Viewport {
+  width: number
+  height: number
+}
+
+const read = (): Viewport => ({ width: window.innerWidth, height: window.innerHeight })
+
+export function useViewport(): Viewport {
+  const [viewport, setViewport] = useState(read)
+  useEffect(() => {
+    const onResize = () => setViewport(read())
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return viewport
+}
