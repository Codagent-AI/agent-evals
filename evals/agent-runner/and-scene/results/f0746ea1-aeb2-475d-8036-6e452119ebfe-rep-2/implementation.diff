diff --git a/scripts/browser.mjs b/scripts/browser.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ba6854d8d2ef3663683768b431f4e085ed744770
--- /dev/null
+++ b/scripts/browser.mjs
@@ -0,0 +1,100 @@
+import { spawn, spawnSync } from 'node:child_process'
+import { createServer } from 'node:net'
+import { resolve } from 'node:path'
+import { chromium } from 'playwright'
+
+export const HOST = '127.0.0.1'
+export function build(cwd = process.cwd()) {
+  const result = spawnSync('npm', ['run', 'build'], { cwd, stdio: 'inherit' })
+  if (result.status !== 0) throw new Error('build: whole-application build failed')
+}
+async function freePort() {
+  const server = createServer()
+  await new Promise((yes, no) => { server.once('error', no); server.listen(0, HOST, yes) })
+  const port = server.address().port
+  await new Promise((yes, no) => server.close(error => error ? no(error) : yes()))
+  return port
+}
+async function closeBrowser(browser, browserServer) {
+  const failures = []
+  try { await browser?.close() } catch (error) { failures.push(error) }
+  if (browserServer) {
+    try { await browserServer.close() }
+    catch (error) {
+      failures.push(error)
+      await browserServer.kill()
+    }
+    console.log(`browser: cleaned pid=${browserServer.process().pid}`)
+  }
+  if (failures.length) throw new AggregateError(failures, `cleanup: browser close failed: ${failures.map(error => error.message).join('; ')}`)
+}
+export async function withPreview(run, { cwd = process.cwd(), viewport = { width: 1440, height: 900 } } = {}) {
+  const port = await freePort()
+  const baseURL = `http://${HOST}:${port}`
+  const server = spawn(process.execPath, [resolve(cwd, 'node_modules/vite/bin/vite.js'), 'preview', '--host', HOST, '--port', String(port), '--strictPort'], { cwd, stdio: ['ignore', 'pipe', 'pipe'] })
+  let serverOutput = ''
+  server.stdout.on('data', data => { serverOutput += data })
+  server.stderr.on('data', data => { serverOutput += data })
+  const exited = new Promise(resolveExit => { server.once('exit', resolveExit); server.once('error', resolveExit) })
+  let browser, browserServer
+  try {
+    const deadline = Date.now() + 15000
+    while (true) {
+      if (server.exitCode !== null) throw new Error(`preview: exited early: ${serverOutput}`)
+      try { const response = await fetch(baseURL); if (response.ok) break } catch { /* readiness retry */ }
+      if (Date.now() >= deadline) throw new Error(`preview: readiness timeout at ${baseURL}: ${serverOutput}`)
+      await new Promise(done => setTimeout(done, 100))
+    }
+    console.log(`preview: host=${HOST} readiness=${baseURL} pid=${server.pid}`)
+    browserServer = await chromium.launchServer({ headless: true })
+    console.log(`browser: pid=${browserServer.process().pid}`)
+    browser = await chromium.connect(browserServer.wsEndpoint())
+    const page = await browser.newPage({ viewport })
+    return await run(page, baseURL)
+  } finally {
+    try { await closeBrowser(browser, browserServer) }
+    finally {
+      try {
+        if (server.exitCode === null) {
+          server.kill('SIGTERM')
+          await Promise.race([exited, new Promise(done => setTimeout(done, 2000))])
+          if (server.exitCode === null) { server.kill('SIGKILL'); await exited }
+        }
+      } finally {
+        server.stdout.destroy()
+        server.stderr.destroy()
+        console.log(`preview: cleaned pid=${server.pid}`)
+      }
+    }
+  }
+}
+export function browserErrors(page) {
+  let step = 0
+  const errors = []
+  const record = (kind, message) => errors.push(`browser: step ${step} ${kind}: ${message}`)
+  page.on('console', message => { if (message.type() === 'error') record('console.error', message.text()) })
+  page.on('pageerror', error => record('pageerror', error.message))
+  return {
+    setStep(value) { step = value },
+    assertClean() { if (errors.length) throw new Error(errors.join('\n')) },
+    errors,
+  }
+}
+export async function visit(page, baseURL, slug, errors) {
+  if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) throw new Error('sample: invalid presentation slug')
+  console.log(`browser: url=${baseURL}/${slug}`)
+  await page.goto(`${baseURL}/${slug}`)
+  const host = page.locator('[data-presentation]')
+  try { await host.waitFor({ timeout: 5000 }) } catch { errors.assertClean(); throw new Error(`sample: registered presentation not reachable: ${slug}`) }
+  errors.assertClean()
+  const count = Number(await host.getAttribute('data-step-count'))
+  if (!Number.isInteger(count) || count < 1) throw new Error('sample: invalid data-step-count')
+  return { host, count }
+}
+export async function advance(page, index, errors) {
+  errors.setStep(index)
+  await page.keyboard.press('ArrowRight')
+  try { await page.waitForFunction(i => document.querySelector('[data-presentation]')?.getAttribute('data-step-index') === String(i), index, { timeout: 4000 }) }
+  catch { errors.assertClean(); throw new Error(`transition: step ${index} did not advance data-step-index`) }
+  errors.assertClean()
+}
diff --git a/scripts/diagnostics.mjs b/scripts/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..85e86c8a176b67f94555ce59b5ce5b9f2f0fd370
--- /dev/null
+++ b/scripts/diagnostics.mjs
@@ -0,0 +1,82 @@
+// Pure decisions shared by DOM collection and unit tests. No visual-taste gate.
+export function overlaps(a, b) {
+  return a.x < b.x + b.width - 1 && a.x + a.width > b.x + 1 && a.y < b.y + b.height - 1 && a.y + a.height > b.y + 1
+}
+// A control's contained label is another measurement of that same control.
+// Nested text/text pairs are always checked independently.
+function ownLabel(surface, text) {
+  return surface.kind === 'control' && text.kind === 'text' && text.control === surface.element &&
+    text.x >= surface.x && text.y >= surface.y && text.x + text.width <= surface.x + surface.width && text.y + text.height <= surface.y + surface.height
+}
+export function collisionWarnings(items) {
+  const warnings = []
+  for (let i = 0; i < items.length; i++) for (let j = i + 1; j < items.length; j++) {
+    const a = items[i], b = items[j]
+    if (!a.visible || !b.visible || a.allowed || b.allowed) continue
+    if (ownLabel(a, b) || ownLabel(b, a)) continue
+    if (overlaps(a, b)) warnings.push(`overlap: ${a.label} <> ${b.label}`)
+  }
+  return warnings
+}
+export function indistinct(active, inactive) {
+  return Boolean(active && inactive && JSON.stringify(active) === JSON.stringify(inactive))
+}
+export function attributionWarnings(attribution) {
+  const hook = '[data-presentation-attribution]'
+  if (!attribution?.visible) return [`attribution: missing or hidden; style ${hook}`]
+  const warnings = []
+  if (attribution.fontSize < 11) warnings.push(`attribution: undersized; style ${hook}`)
+  if (attribution.color === 'rgb(0, 0, 238)' || attribution.color === 'rgb(85, 26, 139)' || (attribution.fontFamily.includes('Times New Roman') && attribution.textDecoration.includes('underline'))) warnings.push(`attribution: browser-default; style ${hook}`)
+  return warnings
+}
+export function collectDiagnostics() {
+  // Runs in the browser; return serializable geometry and computed style only.
+  const host = document.querySelector('[data-presentation]')
+  const visible = el => {
+    const rect = el.getBoundingClientRect()
+    if (!rect.width || !rect.height) return false
+    for (let ancestor = el; ancestor; ancestor = ancestor.parentElement) {
+      const style = getComputedStyle(ancestor)
+      if (style.display === 'none' || style.visibility === 'hidden' || Number(style.opacity) === 0) return false
+    }
+    return true
+  }
+  const all = [...host.querySelectorAll('*')]
+  const identify = el => all.indexOf(el)
+  const controls = 'button,a,input,textarea,select,[role="button"],[role="slider"],[role="tab"],[data-presentation-progress-item],[data-presentation-toc-item]'
+  const items = []
+  const add = (el, rect, kind, label) => {
+    if (!rect.width || !rect.height) return
+    items.push({ element: identify(el), kind, control: identify(el.closest(controls)), label,
+      visible: true, allowed: Boolean(el.closest('[data-presentation-allow-overlap]')),
+      x: rect.x, y: rect.y, width: rect.width, height: rect.height })
+  }
+  for (const control of host.querySelectorAll(controls)) {
+    if (visible(control)) add(control, control.getBoundingClientRect(), 'control', `control: ${control.getAttribute('aria-label') || control.textContent.trim() || control.tagName.toLowerCase()}`)
+  }
+  const walker = document.createTreeWalker(host, NodeFilter.SHOW_TEXT)
+  while (walker.nextNode()) {
+    const node = walker.currentNode, el = node.parentElement
+    if (!node.textContent.trim() || !visible(el) || el.closest('[aria-hidden="true"]')) continue
+    const range = document.createRange(); range.selectNodeContents(node)
+    for (const rect of range.getClientRects()) add(el, rect, 'text', `${el.tagName.toLowerCase()}: ${node.textContent.trim().slice(0, 60)}`)
+  }
+  const fingerprint = el => {
+    if (!el) return null
+    const css = getComputedStyle(el)
+    return Object.fromEntries(['color','backgroundColor','borderColor','fontWeight','textDecorationLine','boxShadow','opacity','outlineStyle'].map(key => [key, css[key]]))
+  }
+  const chrome = ['progress', 'toc'].flatMap(kind => {
+    const elements = [...document.querySelectorAll(`[data-presentation-${kind}-item]`)].filter(visible)
+    const active = elements.find(el => el.dataset.presentationActive === 'true')
+    const inactive = elements.find(el => el.dataset.presentationActive === 'false')
+    return active && inactive ? [{ kind, active: fingerprint(active), inactive: fingerprint(inactive) }] : []
+  })
+  const link = document.querySelector('[data-presentation-attribution]')
+  const css = link ? getComputedStyle(link) : null
+  const attribution = css ? { visible: visible(link), fontSize: parseFloat(css.fontSize), fontFamily: css.fontFamily, color: css.color, textDecoration: css.textDecorationLine } : null
+  return { items, chrome, attribution }
+}
+export function diagnose(data) {
+  return [...collisionWarnings(data.items), ...data.chrome.filter(item => indistinct(item.active, item.inactive)).map(item => `active chrome: indistinct ${item.kind}`), ...attributionWarnings(data.attribution)]
+}
diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7a1624620713e3a92c82c833ac297a9e2c8f5cf2
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,36 @@
+import { mkdir, writeFile } from 'node:fs/promises'
+import { resolve } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { build, withPreview, browserErrors, visit, advance } from './browser.mjs'
+import { collectDiagnostics, diagnose } from './diagnostics.mjs'
+
+export async function inspect({ cwd = process.cwd(), slug, settle = 850, skipBuild = false, output = resolve(cwd, 'artifacts/inspection', slug ?? ''), viewport } = {}) {
+  if (!slug) throw new Error('inspection: supply a registered presentation slug')
+  if (!Number.isFinite(settle) || settle < 0) throw new Error('inspection: settle interval must be non-negative')
+  if (!skipBuild) build(cwd)
+  await mkdir(output, { recursive: true })
+  const captures = []
+  await withPreview(async (page, baseURL) => {
+    const errors = browserErrors(page)
+    const { count } = await visit(page, baseURL, slug, errors)
+    for (let index = 0; index < count; index++) {
+      if (index) await advance(page, index, errors)
+      const transitionAt = Date.now()
+      await page.waitForTimeout(settle)
+      errors.assertClean()
+      const warnings = diagnose(await page.evaluate(collectDiagnostics))
+      const file = `${String(index + 1).padStart(2, '0')}.png`
+      await page.screenshot({ path: resolve(output, file) })
+      captures.push({ index, file, transitionAt, capturedAt: Date.now(), settle, warnings })
+      for (const warning of warnings) console.warn(`WARN step ${index}: ${warning}`)
+      console.log(`capture: step ${index} ${resolve(output, file)}`)
+    }
+  }, { cwd, viewport })
+  await writeFile(resolve(output, 'report.json'), JSON.stringify(captures, null, 2) + '\n')
+  console.log('inspection: captures complete; visual warnings are advisory')
+  return captures
+}
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  const settleArg = process.argv.find(arg => arg.startsWith('--settle='))
+  inspect({ slug: process.argv[2], settle: settleArg ? Number(settleArg.split('=')[1]) : undefined }).catch(error => { console.error(`FAIL: ${error.message}`); process.exitCode = 1 })
+}
