+export const REFERENCE_TITLE = "How to Use This Skill to Make a Presentation"
+export const REFERENCE_SLUG = "how-to-make-a-presentation"
+export const REFERENCE_STEPS = [
+  {
+    "id": "step-1",
+    "era": "the ask",
+    "title": "You have a topic",
+    "caption": "It starts with you, a topic, and mild overconfidence."
+  },
+  {
+    "id": "step-2",
+    "era": "the ask",
+    "title": "The skill interviews you",
+    "caption": "One question at a time: the topic, the look, then each beat of the story."
+  },
+  {
+    "id": "step-3",
+    "era": "the gathering",
+    "title": "Answers become steps",
+    "caption": "Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next."
+  },
+  {
+    "id": "step-4",
+    "era": "the gathering",
+    "title": "The deck grows",
+    "caption": "Same shapes, new beats. Every answer extends the story without redrawing it."
+  },
+  {
+    "id": "step-5",
+    "era": "the gathering",
+    "title": "You set the depth",
+    "caption": "Spell out every step, or sketch a few and see how it looks. You hold the gate."
+  },
+  {
+    "id": "step-6",
+    "era": "the build",
+    "title": "It assembles the scene",
+    "caption": "Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph."
+  },
+  {
+    "id": "step-7",
+    "era": "the build",
+    "title": "It checks its own work",
+    "caption": "Before saying done, it builds and renders every step — and fixes what breaks."
+  },
+  {
+    "id": "step-8",
+    "era": "the loop",
+    "title": "Changed your mind? Loop it.",
+    "caption": "Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch."
+  },
+  {
+    "id": "step-9",
+    "era": "the reveal",
+    "title": "You're looking at one",
+    "caption": "This presentation was built exactly this way. Thanks for watching."
+  }
+]
+
+export function validateReference(actual, title) {
+  if (title !== REFERENCE_TITLE || !Array.isArray(actual) || actual.length !== 9) throw new Error('sample: missing or malformed nine-step reference')
+  REFERENCE_STEPS.forEach((expected, index) => {
+    for (const field of ['era', 'title', 'caption']) {
+      if (actual[index]?.[field] !== expected[field]) throw new Error(`sample: step ${index} has wrong ${field}`)
+    }
+  })
+}
diff --git a/scripts/verify.mjs b/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c28bcf48b0a5f278e482d3e44bdf9825dfc1f508
--- /dev/null
+++ b/scripts/verify.mjs
@@ -0,0 +1,29 @@
+import { pathToFileURL } from 'node:url'
+import { build, withPreview, browserErrors, visit, advance } from './browser.mjs'
+import { REFERENCE_SLUG, REFERENCE_TITLE, validateReference } from './reference.mjs'
+
+export async function verify({ cwd = process.cwd(), slug = REFERENCE_SLUG, skipBuild = false } = {}) {
+  if (!skipBuild) build(cwd)
+  const canonical = slug === REFERENCE_SLUG
+  await withPreview(async (page, baseURL) => {
+    const errors = browserErrors(page)
+    const { host, count } = await visit(page, baseURL, slug, errors)
+    const metadata = []
+    for (let index = 0; index < count; index++) {
+      if (index) await advance(page, index, errors)
+      await page.waitForTimeout(850)
+      errors.assertClean()
+      const actualIndex = Number(await host.getAttribute('data-step-index'))
+      if (actualIndex !== index) throw new Error(`transition: step ${index} has index ${actualIndex}`)
+      metadata.push(await host.evaluate(el => ({ era: el.dataset.stepEra, title: el.dataset.stepTitle, caption: el.dataset.stepCaption })))
+      console.log(`render: step ${index} / ${count} clean`)
+    }
+    if (canonical) validateReference(metadata, await host.getAttribute('aria-label'))
+    errors.assertClean()
+  }, { cwd })
+  console.log(`PASS: build, ${canonical ? REFERENCE_TITLE : slug}, and every step rendered`)
+}
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  const slugIndex = process.argv.indexOf('--presentation')
+  verify({ slug: slugIndex >= 0 ? process.argv[slugIndex + 1] : undefined }).catch(error => { console.error(`FAIL: ${error.message}`); process.exitCode = 1 })
+}
