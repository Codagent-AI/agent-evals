+import type { ComponentType } from 'react'
+
+export type Mode = 'present' | 'browse'
+
+/** Narration and identity carried by every step. */
+export interface StepMeta {
+  /** Stable step identity. */
+  id: string
+  /** Section / era label; steps with the same era are grouped in the table of contents. */
+  era: string
+  /** One-line presenter title (shown in present mode). */
+  title: string
+  /** Paragraph caption (shown in browse mode). */
+  caption: string
+}
+
+export interface SceneProps<TPayload = undefined> {
+  /** The active step's diagram state. */
+  payload: TPayload
+  /** Zero-based index of the active step. */
+  stepIndex: number
+}
+
+export interface Step<TPayload = undefined> extends StepMeta {
+  Scene: ComponentType<SceneProps<TPayload>>
+  /** Diagram state handed to `Scene` while this step is active. */
+  payload: TPayload
+  /**
+   * Adjacent steps sharing a `groupKey` (and `Scene`) keep one mounted scene
+   * instance; only `payload` changes, so entities update in place.
+   */
+  groupKey?: string
+}
+
+export interface PresentationProps<TPayload = undefined> {
+  steps: readonly Step<TPayload>[]
+  title: string
+  initialMode?: Mode
+  /** Class applied to the root so presentation-owned CSS can scope itself. */
+  className?: string
+  /** Optional host-provided top-left brand. The kit renders none by default. */
+  brand?: React.ReactNode
+  /** Replace the default attribution, or pass `null` to remove it. */
+  attribution?: React.ReactNode
+}
diff --git a/src/presentation-kit/useFitScale.ts b/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b54cb757243fa28fa87256d0e36b215d3f8d333f
--- /dev/null
+++ b/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,27 @@
+import { useLayoutEffect, useRef, useState } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT } from './constants'
+import type { Mode } from './types'
+
+export function fitScale(w: number, h: number, mode: Mode, dw = DESIGN_W, dh = DESIGN_H): number {
+  const { insetX, insetY } = STAGE_LAYOUT[mode]
+  const s = Math.min((w - insetX * 2) / dw, (h - insetY * 2) / dh)
+  return Math.max(Number.isFinite(s) ? s : MIN_SCALE, MIN_SCALE)
+}
+
+/** Uniform scale fitting the design canvas inside the observed element. */
+export function useFitScale(mode: Mode, dw = DESIGN_W, dh = DESIGN_H) {
+  const ref = useRef<HTMLDivElement>(null)
+  const [scale, setScale] = useState(1)
+
+  useLayoutEffect(() => {
+    const el = ref.current
+    if (!el) return
+    const update = () => setScale(fitScale(el.clientWidth, el.clientHeight, mode, dw, dh))
+    update()
+    const ro = new ResizeObserver(update)
+    ro.observe(el)
+    return () => ro.disconnect()
+  }, [mode, dw, dh])
+
+  return { ref, scale }
+}
diff --git a/src/presentation-kit/usePresentationNav.ts b/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4694e5d56af7fff20a19f7059017570dda11505d
--- /dev/null
+++ b/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,46 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import type { TouchEvent } from 'react'
+import type { Mode } from './types'
+import { NEXT_KEYS, PREV_KEYS, clamp, isInteractive, swipeDirection } from './nav'
+
+export function usePresentationNav(count: number, initialMode: Mode = 'present') {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const touchStart = useRef<{ x: number; y: number } | null>(null)
+
+  const go = useCallback((i: number) => setIndex(clamp(i, count)), [count])
+  const next = useCallback(() => setIndex((i) => clamp(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clamp(i - 1, count)), [count])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'present' ? 'browse' : 'present')), [])
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || isInteractive(e.target)) return
+      if (NEXT_KEYS.includes(e.key)) next()
+      else if (PREV_KEYS.includes(e.key)) prev()
+      else if (e.key === 'p' || e.key === 'P') toggleMode()
+      else return
+      e.preventDefault()
+    }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [next, prev, toggleMode])
+
+  const touchHandlers = {
+    onTouchStart: (e: TouchEvent) => {
+      const t = e.touches[0]
+      touchStart.current = t ? { x: t.clientX, y: t.clientY } : null
+    },
+    onTouchEnd: (e: TouchEvent) => {
+      const s = touchStart.current
+      const t = e.changedTouches[0]
+      touchStart.current = null
+      if (!s || !t) return
+      const dir = swipeDirection(t.clientX - s.x, t.clientY - s.y)
+      if (dir === 1) next()
+      else if (dir === -1) prev()
+    },
+  }
+
+  return { index: clamp(index, count), mode, go, next, prev, toggleMode, touchHandlers }
+}
