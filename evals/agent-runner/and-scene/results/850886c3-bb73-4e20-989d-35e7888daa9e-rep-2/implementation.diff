+/* Presentation-owned styling; the scene kit supplies hooks only. */
+.how-to-make-a-presentation {
+  --ink: #f8f3e6;
+  --muted: #b9b09a;
+  --gold: #e8c76a;
+  --line: #5a5346;
+  --panel: #1a1815;
+  --good: #6fcf8e;
+  color: var(--ink);
+  font-size: 16px;
+}
+
+.how-to-make-a-presentation [data-presentation-header] {
+  display: flex;
+  align-items: baseline;
+  gap: 0.75rem;
+  padding: 0.9rem 1.5rem 0;
+  color: var(--muted);
+}
+.how-to-make-a-presentation [data-presentation-marker] { color: var(--gold); font-variant-numeric: tabular-nums; font-weight: 600; }
+.how-to-make-a-presentation [data-presentation-era] { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; }
+.how-to-make-a-presentation [data-presentation-header] [data-presentation-stack] { margin-left: auto; }
+.how-to-make-a-presentation [data-presentation-header] h1 { margin: 0; font-size: 1.25rem; color: var(--ink); text-align: right; }
+
+.how-to-make-a-presentation [data-presentation-footer] { padding: 0.75rem 1.5rem 2.6rem; display: grid; gap: 0.75rem; justify-items: center; }
+.how-to-make-a-presentation [data-presentation-footer][data-presentation-mode='present'] { padding-bottom: 3rem; }
+.how-to-make-a-presentation [data-presentation-footer] [data-presentation-stack] { max-width: 46rem; }
+.how-to-make-a-presentation [data-presentation-footer] h1 { margin: 0; font-size: 2rem; text-align: center; }
+.how-to-make-a-presentation [data-presentation-footer] p { margin: 0; text-align: center; color: var(--ink); line-height: 1.5; }
+
+.how-to-make-a-presentation [data-presentation-progress] { display: flex; gap: 0.5rem; }
+.how-to-make-a-presentation [data-presentation-dot] {
+  width: 0.75rem; height: 0.75rem; padding: 0; border-radius: 999px;
+  border: 1px solid var(--muted); background: transparent; cursor: pointer;
+}
+.how-to-make-a-presentation [data-presentation-dot][data-active='true'] { background: var(--gold); border-color: var(--gold); transform: scale(1.5); }
+
+.how-to-make-a-presentation [data-presentation-controls] { display: flex; gap: 0.75rem; }
+.how-to-make-a-presentation [data-presentation-prev], .how-to-make-a-presentation [data-presentation-next] {
+  font: inherit; color: var(--ink); background: var(--panel); border: 1px solid var(--line);
+  border-radius: 0.5rem; padding: 0.35rem 1rem; cursor: pointer;
+}
+.how-to-make-a-presentation button:disabled { opacity: 0.4; cursor: default; }
+.how-to-make-a-presentation button:focus-visible, .how-to-make-a-presentation a:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
+
+.how-to-make-a-presentation [data-presentation-toc] { width: 11rem; padding: 1rem 0 0 1.5rem; flex: none; }
+.how-to-make-a-presentation [data-presentation-toc] ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
+.how-to-make-a-presentation [data-presentation-toc-entry] {
+  font: inherit; width: 100%; text-align: left; color: var(--muted); background: none;
+  border: 0; border-left: 3px solid transparent; padding: 0.35rem 0.6rem; cursor: pointer;
+}
+.how-to-make-a-presentation [data-presentation-toc-entry][data-active='true'] {
+  color: var(--gold); border-left-color: var(--gold); background: rgba(232, 199, 106, 0.12); font-weight: 600;
+}
+
+.how-to-make-a-presentation [data-presentation-attribution] {
+  right: 1rem !important; bottom: 0.75rem !important;
+  font-size: 0.8125rem; color: var(--muted); text-decoration: underline; text-underline-offset: 3px;
+}
+.how-to-make-a-presentation [data-presentation-attribution]:hover { color: var(--gold); }
+
+/* Diagram entities */
+.how-to-make-a-presentation [data-presentation-node] { color: var(--ink); font-size: 14px; }
+.how-to-make-a-presentation [data-presentation-node='box'], .how-to-make-a-presentation [data-presentation-node='chip'] {
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
+  background: var(--panel); border: 1.5px solid var(--line); border-radius: 12px; text-align: center;
+}
+.how-to-make-a-presentation [data-presentation-kind='actor'] { border-color: var(--gold); font-size: 18px; font-weight: 600; flex-direction: row; gap: 8px; }
+.how-to-make-a-presentation [data-presentation-kind='prompt'], .how-to-make-a-presentation [data-presentation-kind='question'] { border-radius: 999px; flex-direction: row; font-size: 13px; color: var(--muted); }
