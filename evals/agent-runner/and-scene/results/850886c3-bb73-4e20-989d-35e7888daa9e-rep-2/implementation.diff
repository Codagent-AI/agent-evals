+.how-to-make-a-presentation [data-presentation-kind='morph'] { border-radius: 999px; padding: 0; }
+.how-to-make-a-presentation [data-presentation-icon] { width: 18px; height: 18px; flex: none; }
+.how-to-make-a-presentation [data-presentation-kind='morph'] [data-presentation-icon] { width: 14px; height: 14px; }
+
