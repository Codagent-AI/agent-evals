diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..3b03c42e45b6f3e5b1a7e467b361718b0ef47f23
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,67 @@
+import { useEffect, useState } from 'react'
+import { ATTRIBUTION_HREF, ATTRIBUTION_LABEL, TOC_MIN_WIDTH } from './constants'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { Toc } from './chrome/Toc'
+import { Stage } from './Stage'
+import type { PresentationProps } from './types'
+import { usePresentationNav } from './usePresentationNav'
+
+function useWideViewport() {
+  const query = `(min-width: ${TOC_MIN_WIDTH}px)`
+  const [wide, setWide] = useState(() => window.matchMedia(query).matches)
+  useEffect(() => {
+    const mq = window.matchMedia(query)
+    const on = () => setWide(mq.matches)
+    mq.addEventListener('change', on)
+    return () => mq.removeEventListener('change', on)
+  }, [query])
+  return wide
+}
+
+export function Presentation<T = undefined>({
+  steps,
+  title,
+  initialMode = 'present',
+  brand,
+  attribution,
+  className,
+}: PresentationProps<T>) {
+  const { index, mode, go, next, prev, touchHandlers } = usePresentationNav(steps.length, initialMode)
+  const wide = useWideViewport()
+  const step = steps[index]
+  if (!step) return null
+
+  return (
+    <div
+      className={className}
+      data-presentation-root=""
+      data-presentation-title-text={title}
+      data-presentation-mode={mode}
+      data-step-count={steps.length}
+      data-step-index={index}
+      data-step-id={step.id}
+      {...touchHandlers}
+      style={{ position: 'relative', display: 'flex', flexDirection: 'column', height: '100dvh', width: '100%' }}
+    >
+      <Header mode={mode} marker={`${index + 1} / ${steps.length}`} era={step.era} titles={steps.map((s) => s.title)} index={index} brand={brand} />
+      <div style={{ display: 'flex', flex: '1 1 0', minHeight: 0 }}>
+        {mode === 'browse' && wide && <Toc steps={steps} index={index} go={go} />}
+        <Stage steps={steps} index={index} mode={mode} />
+      </div>
+      <Footer mode={mode} steps={steps} index={index} go={go} next={next} prev={prev} />
+      {attribution !== null &&
+        (attribution ?? (
+          <a
+            data-presentation-attribution=""
+            href={ATTRIBUTION_HREF}
+            target="_blank"
+            rel="noreferrer"
+            style={{ position: 'absolute', right: 0, bottom: 0 }}
+          >
+            {ATTRIBUTION_LABEL}
+          </a>
+        ))}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..bf3c1db806193437610d5fceecd2e689c9fe5040
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,59 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, ENTER_T } from './constants'
+import type { Mode, Step } from './types'
+import { useFitScale } from './useFitScale'
+
+interface StageProps<T> {
+  steps: readonly Step<T>[]
+  index: number
+  mode: Mode
+}
+
+/** Hosts the active step's scene on the fixed design canvas, scaled to fit. */
+export function Stage<T>({ steps, index, mode }: StageProps<T>) {
+  const { ref, scale } = useFitScale(mode)
+  const step = steps[index]
+  if (!step) return null
+  const { Scene } = step
+  // Steps sharing a group key keep one scene instance; otherwise scenes cross-fade.
+  const sceneKey = step.groupKey ?? step.id
+
+  return (
+    <div
+      ref={ref}
+      data-presentation-stage=""
+      data-presentation-scale={scale.toFixed(3)}
+      style={{ position: 'relative', flex: '1 1 0', minHeight: 0, minWidth: 0, overflow: 'hidden' }}
+    >
+      <div
+        data-presentation-canvas=""
+        style={{
+          position: 'absolute',
+          left: '50%',
+          top: '50%',
+          width: DESIGN_W,
+          height: DESIGN_H,
+          transform: `translate(-50%, -50%) scale(${scale})`,
+          transformOrigin: 'center center',
+        }}
+      >
+        <LayoutGroup>
+          <AnimatePresence initial={false}>
+            <motion.div
+              key={sceneKey}
+              data-presentation-scene=""
+              data-presentation-scene-key={sceneKey}
+              initial={{ opacity: 0 }}
+              animate={{ opacity: 1 }}
+              exit={{ opacity: 0 }}
+              transition={{ duration: ENTER_T }}
+              style={{ position: 'absolute', inset: 0 }}
+            >
+              <Scene payload={step.payload} stepIndex={index} />
+            </motion.div>
+          </AnimatePresence>
+        </LayoutGroup>
+      </div>
+    </div>
+  )
+}
diff --git a/src/presentation-kit/chrome/Footer.tsx b/src/presentation-kit/chrome/Footer.tsx
