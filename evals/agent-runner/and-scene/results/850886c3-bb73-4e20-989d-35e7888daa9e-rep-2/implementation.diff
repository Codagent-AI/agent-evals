--- /dev/null
+++ b/scripts/lib.mjs
@@ -0,0 +1,86 @@
+import { spawn } from 'node:child_process'
+import net from 'node:net'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+/** Deterministic IPv4 loopback for the preview server, readiness probe and browser URLs. */
+export const HOST = '127.0.0.1'
+
+export const projectRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+
+export function run(cmd, args, cwd) {
+  return new Promise((resolve) => {
+    const child = spawn(cmd, args, { cwd, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (d) => (output += d))
+    child.stderr.on('data', (d) => (output += d))
+    child.on('error', (e) => resolve({ code: 1, output: String(e) }))
+    child.on('close', (code) => resolve({ code: code ?? 1, output }))
+  })
+}
+
+function freePort() {
+  return new Promise((resolve, reject) => {
+    const srv = net.createServer()
+    srv.once('error', reject)
+    srv.listen(0, HOST, () => {
+      const { port } = srv.address()
+      srv.close(() => resolve(port))
+    })
+  })
+}
+
+/** Starts `vite preview` on 127.0.0.1 and waits until it answers. */
+export async function startPreview(root) {
+  const port = await freePort()
+  const vite = path.join(root, 'node_modules', '.bin', 'vite')
+  const child = spawn(vite, ['preview', '--host', HOST, '--port', String(port), '--strictPort'], {
+    cwd: root,
+    detached: true,
+    stdio: ['ignore', 'pipe', 'pipe'],
+  })
+  let log = ''
+  child.stdout.on('data', (d) => (log += d))
+  child.stderr.on('data', (d) => (log += d))
+  let exited = false
+  child.on('exit', () => (exited = true))
+  const base = `http://${HOST}:${port}`
+  const stop = () => {
+    if (exited || !child.pid) return
+    try {
+      process.kill(-child.pid, 'SIGTERM')
+    } catch {
+      /* already gone */
+    }
+  }
+  const deadline = Date.now() + 30_000
+  while (Date.now() < deadline) {
+    if (exited) break
+    try {
+      const res = await fetch(`${base}/`)
+      if (res.ok) return { base, stop }
+    } catch {
+      /* not ready yet */
+    }
+    await new Promise((r) => setTimeout(r, 150))
+  }
+  stop()
+  throw new Error(`preview did not become ready on ${base}\n${log}`)
+}
+
+export const STEP = '[data-step-index]'
+
+export const readIndex = (page) => page.getAttribute(STEP, 'data-step-index').then(Number)
+
+export async function waitForIndex(page, expected, timeout = 4000) {
+  try {
+    await page.waitForFunction(
+      ([sel, want]) => document.querySelector(sel)?.getAttribute('data-step-index') === String(want),
+      [STEP, expected],
+      { timeout },
+    )
+    return true
+  } catch {
+    return false
+  }
+}
diff --git a/scripts/verify.mjs b/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..10cbfc5a109a658c49c0a2f5f90bda4d11a6ea46
--- /dev/null
+++ b/scripts/verify.mjs
@@ -0,0 +1,170 @@
+// Deterministic gate: build the whole app, check the reference presentation is
+// registered, then render it through every step in Chromium against a production preview.
+import fs from 'node:fs'
+import path from 'node:path'
+import { chromium } from 'playwright'
+import { HOST, projectRoot, readIndex, run, startPreview, waitForIndex } from './lib.mjs'
+
+const root = projectRoot
+
+// The committed reference sample of the and-scene repository. It is enforced here, not
+// read from replaceable project configuration, whenever the project is and-scene itself.
+const CANONICAL = {
+  slug: 'how-to-make-a-presentation',
+  steps: [
+    { title: "You have a topic", caption: "It starts with you, a topic, and mild overconfidence." },
+    { title: "The skill interviews you", caption: "One question at a time: the topic, the look, then each beat of the story." },
+    { title: "Answers become steps", caption: "Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next." },
+    { title: "The deck grows", caption: "Same shapes, new beats. Every answer extends the story without redrawing it." },
+    { title: "You set the depth", caption: "Spell out every step, or sketch a few and see how it looks. You hold the gate." },
+    { title: "It assembles the scene", caption: "Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph." },
+    { title: "It checks its own work", caption: "Before saying done, it builds and renders every step — and fixes what breaks." },
+    { title: "Changed your mind? Loop it.", caption: "Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch." },
+    { title: "You're looking at one", caption: "This presentation was built exactly this way. Thanks for watching." },
+  ],
+}
+
+const isAndScene = () => JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8')).name === 'and-scene'
+
+class Failure extends Error {
+  constructor(phase, message, step) {
+    super(message)
+    this.phase = phase
+    this.step = step
+  }
+}
+
+/** Every reference this project must render: the canonical sample and/or its own configured one. */
+function loadReferences() {
+  const refs = isAndScene() ? [CANONICAL] : []
+  const file = path.join(root, 'verify.config.json')
+  if (fs.existsSync(file)) {
+    const configured = JSON.parse(fs.readFileSync(file, 'utf8')).reference
+    if (!refs.some((r) => r.slug === configured.slug)) refs.push(configured)
+  }
+  if (refs.length === 0) throw new Failure('sample', 'no reference presentation: verify.config.json is missing')
+  return refs
+}
+
+const SOURCE = /\.[tj]sx?$/
+const SKIP = new Set(['node_modules', 'dist', '.git', '.inspection'])
+
+function sourceFiles(dir) {
+  if (!fs.existsSync(dir)) return []
+  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
+    const full = path.join(dir, e.name)
+    if (e.isDirectory()) return SKIP.has(e.name) ? [] : sourceFiles(full)
+    return SOURCE.test(e.name) ? [full] : []
+  })
+}
+
+/**
+ * The reference must be a registry entry (`slug` + lazy `load`, matched within that one entry) whose imported module exists.
+ * The registry is found by contract, not by name, so renamed registry files and folders verify too.
+ */
+function checkRegistered(slug) {
+  const entry = new RegExp(`slug:\\s*['"]${slug.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}['"][^{}]*?load:[^{}]*?import\\(\\s*['"]([^'"]+)['"]`)
+  for (const file of sourceFiles(path.join(root, 'src'))) {
+    const found = fs.readFileSync(file, 'utf8').match(entry)
+    if (!found) continue
+    const base = path.resolve(path.dirname(file), found[1])
+    const rel = path.relative(root, file)
+    const exts = ['.ts', '.tsx', '.js', '.jsx']
+    const candidates = [base, ...exts.map((x) => base + x), ...exts.map((x) => path.join(base, `index${x}`))]
+    if (!candidates.some((c) => fs.existsSync(c) && fs.statSync(c).isFile())) {
+      throw new Failure('sample', `reference presentation "${slug}" is registered in ${rel} but ${found[1]} does not exist`)
+    }
+    return
+  }
+  throw new Failure('sample', `reference presentation "${slug}" is not registered in any presentation registry under src/ (an entry needs its own { slug, load: () => import('./...') })`)
+}
+
+async function render(reference, preview, browser) {
+  const page = await browser.newPage()
+  // `current` is the step being rendered, so errors raised by a transition belong to its target.
+  let current = 0
+  const errors = []
+  const note = (kind, text) => errors.push(new Failure('render', `${kind}: ${text}`, current))
+  page.on('console', (m) => m.type() === 'error' && note('console.error', m.text()))
+  page.on('pageerror', (e) => note('pageerror', e.message))
+
+  const url = `${preview.base}/${reference.slug}`
+  if (!url.startsWith(`http://${HOST}:`)) throw new Failure('render', `unexpected URL ${url}`)
+  await page.goto(url)
+  try {
+    await page.waitForSelector('[data-step-count]', { timeout: 10_000 })
+  } catch {
+    throw errors[0] ?? new Failure('render', `route ${url} did not render a presentation`, 0)
+  }
+  const count = Number(await page.getAttribute('[data-step-count]', 'data-step-count'))
+  if (count !== reference.steps.length) {
+    throw new Failure('sample', `expected ${reference.steps.length} steps, found ${count}`)
+  }
+  if (!(await page.$('[data-presentation-caption]'))) await page.keyboard.press('p')
+
+  for (let step = 0; step < count; step++) {
+    current = step
+    if (!(await waitForIndex(page, step))) {
+      throw new Failure('transition', `step index did not advance to ${step} (at ${await readIndex(page)})`, step)
+    }
+    await page.waitForTimeout(300)
+    const title = await page.textContent('[data-presentation-title]')
+    const caption = await page.textContent('[data-presentation-caption]')
+    const want = reference.steps[step]
+    if (title !== want.title || caption !== want.caption) {
+      throw new Failure('sample', `step ${step} title/caption differ from the reference (got "${title}")`, step)
+    }
+    if (errors.length) throw errors[0]
+    if (step < count - 1) {
+      current = step + 1
+      await page.keyboard.press('ArrowRight')
+    }
+  }
+  await page.waitForTimeout(500)
+  if (errors.length) throw errors[0]
+  await page.close()
+  return count
+}
+
+async function renderAll(references) {
+  const preview = await startPreview(root).catch((e) => {
+    throw new Failure('preview', e.message)
+  })
+  let browser
+  try {
+    browser = await chromium.launch().catch((e) => {
+      throw new Failure('render', `browser launch failed: ${e.message.split('\n')[0]}`)
+    })
+    const counts = []
+    for (const reference of references) counts.push([reference.slug, await render(reference, preview, browser)])
+    return counts
+  } finally {
+    await browser?.close()
+    preview.stop()
+  }
+}
+
+async function main() {
+  const build = await run('npm', ['run', 'build'], root)
+  if (build.code !== 0) throw new Failure('build', `npm run build failed\n${build.output.slice(-2000)}`)
+  console.log('[verify] build: ok')
+
+  const references = loadReferences()
+  for (const { slug } of references) {
+    checkRegistered(slug)
+    console.log(`[verify] sample: "${slug}" is registered`)
+  }
+
+  for (const [slug, steps] of await renderAll(references)) {
+    console.log(`[verify] render: ${slug}: ${steps} steps rendered without errors on ${HOST}`)
+  }
+}
+
+main().then(
+  () => console.log('VERIFY PASSED'),
+  (e) => {
+    const where = e.step === undefined ? '' : ` step=${e.step}`
+    console.error(`VERIFY FAILED phase=${e.phase ?? 'internal'}${where}: ${e.message}`)
+    process.exit(1)
+  },
+)
diff --git a/skills/presentation/SKILL.md b/skills/presentation/SKILL.md
new file mode 100644
index 0000000000000000000000000000000000000000..45fc508664726d91e3f2afe5a5c22b599e3ed613
--- /dev/null
+++ b/skills/presentation/SKILL.md
@@ -0,0 +1,107 @@
+---
+name: presentation
+description: Create or modify a browser presentation that works as one evolving diagram (stable entities moving through named steps) from a topic. Use when the user wants a presentation, talk, or explainer built from a topic, or wants to change an existing one. Self-bootstraps the Vite + React + TypeScript scaffold and scene kit when missing, then builds, renders, and visually inspects the result.
+---
+
+# Presentation
+
+Generate presentations that are **one evolving scene**, not a stack of slides:
+entities (boxes, labels, arrows, frames, markers) keep a stable identity and
+morph, appear, or leave as the explanation moves through ordered, named steps.
+"Presentation" is the canonical term; `Talk.tsx` is just the entry filename.
+
+Paths below are relative to **this file's directory** (`SKILL_DIR`). Resolve
+`templates/` and `scripts/` from here, never from the user's working directory.
+
+## Procedure
+
+### 1. Gather (one question at a time)
+
+Ask for what is missing, one question per message: the **topic**, the **visual
+style**, then each **step's content and visual description**. Do not assume
+details the user can still give. The user controls depth: if they choose to
+build with partial detail, proceed with what you have and iterate afterwards;
+if the prompt already holds topic, style and every step, build without more
+questions. For a key or complex step you may draw an ASCII mockup and confirm
+the layout before building. Do not mock up every step.
+
+When **modifying**, skip the full interview: identify the target first (below),
+then ask only about the requested changes (steps, entities, or style).
+
+### 2. Resolve the target and scaffold what is missing
+
+A presentation app needs three **contract anchors**:
+
+1. **Build setup**: a Vite + React + TypeScript app with a working `npm run build`.
+2. **Scene kit**: `src/presentation-kit/` in a fresh scaffold (step contract, stage, nav, chrome, fit-scale canvas, primitives); a project may name the directory differently.
+3. **Presentation index**: `src/presentations/index.ts` in a fresh scaffold, mapping each presentation to its own route; a project may name the file and folder differently.
+
+```bash
+node SKILL_DIR/scripts/detect.mjs <project-dir>      # JSON: target, anchors, missing, locations, needsConfirmation
+node SKILL_DIR/scripts/scaffold.mjs <target> [--anchors build,kit,index]
+```
+
+`detect.mjs` is contract-level (anchors, not byte-identical files) and resolves
+the target:
+
+- empty or standalone project: the project root;
+- monorepo (`workspaces`, `pnpm-workspace.yaml`, or `packages/` / `apps/`): a
+  self-contained app in `presentations/`, never the monorepo root;
+- already inside a presentation app: use it.
+
+Then:
+
+- All anchors present: skip scaffolding.
+- Some missing: scaffold **only the missing anchors**; `scaffold.mjs` never overwrites an existing file and merges missing dependencies into an existing `package.json`.
+- If `needsConfirmation` is true (non-empty project lacking the kit or index), **state the target directory and wait for the user to confirm before writing anything.**
+- If the project already has its own entry point (e.g. `src/main.tsx`) that does not reach the presentation registry, `scaffold.mjs` moves it to `app-main` (`.ts`, `.tsx`, `.js` and `.jsx` entries are handled; `index.html` is repointed at the new `.tsx` router entry and a plain-JS host gets an `app-main.d.ts` so it builds) and installs a router entry that serves presentation routes and keeps the old app for every other path; `detect.mjs` only counts the index anchor once the entry point reaches the registry. Detection keys on contracts (a kit directory exporting `Presentation` with a stage, and a `{ slug, load }` registry reachable from the entry), so renamed files still count.
+- Run `npm install` in the target afterwards. Never assume the dependencies (react, react-dom, motion, lucide-react, vite, @vitejs/plugin-react, typescript, @types/*, eslint stack, playwright) are installed. Install Chromium for Playwright if needed (`npx playwright install chromium`).
+- The scaffold is styling-framework-neutral and ships zero visual defaults. Do not add Tailwind or another framework unless the host already uses one or the user asks.
+
+### 3. Generate or modify
+
+**Create**: use the locations `detect.mjs` reported, never assume the canonical names. Anchors may be renamed (`src/scene-kit/`, `src/talks/registry.ts`, ...) and the project still counts as scaffolded:
+
+```bash
+node SKILL_DIR/scripts/create.mjs <target> <slug> "<Title>"
+```
+
+It copies `templates/presentation/` into `locations.presentations/<slug>/`, replaces `__SLUG__` and `__TITLE__`, points the kit imports at `locations.kit`, and registers `{ slug, title, load: () => import('./<slug>/Talk') }` in `locations.registry`. It refuses to overwrite an existing presentation. If it cannot register (unusual registry shape), add that one entry to `locations.registry` by hand. Any hand edit must still import the kit from `locations.kit` and register in `locations.registry`, not at `src/presentation-kit/` or `src/presentations/index.ts` unless those are the detected locations. Inside a presentation, import the kit through its public entry (for example `../../presentation-kit`, or whatever relative path reaches `locations.kit`).
+
+Each presentation is a self-contained folder: `entities.ts` (its `layoutId` namespace and canvas geometry), `steps/` (the persistent `Scene` and the `STEPS` array), `Talk.tsx`, and `talk.css`. Leave every other presentation untouched.
+
+**Modify**: if the target is missing or ambiguous, list the registered presentations (`locations.registry`) and ask which one before changing anything. Then edit only that presentation (plus its registry line if renamed).
+
+Model rules:
+
+- Each step has `id`, `era` (section label), `title` (one line, present mode), `caption` (paragraph, browse mode), `Scene`, `payload`. Step numbers come from array position; never number steps by hand.
+- Put consecutive steps of one evolving diagram in a shared `groupKey` with the same `Scene`: the scene stays mounted and only `payload` changes. Entities that persist keep the same `layoutId` (use the primitive's `id` prop) and morph in place; wrap only **new** entities in `Appear` (it waits for persisting entities to settle) and put them under `AnimatePresence` so departing ones animate out. Do not fade persisting entities in.
+- Compose with the kit's primitives (`Box`, `Label`, `Arrow`, `Frame`, `Emphasis`, `SymbolChip`, `SceneLayer`, `Appear`) imported from the kit's public entry (`../../presentation-kit` in a standard scaffold; the relative path to `locations.kit` otherwise); for coordinate-heavy diagrams use raw `motion` elements with stable `layoutId`s. Lay out on the fixed **880 x 380** canvas inside a `SceneLayer`.
+- Keep intentional overlaps and stacking when that is the composition; do not spread things out just to avoid them.
+
+**Styling** belongs to the presentation (`talk.css`, plain CSS by default) or the host app, never the kit. The kit only exposes `data-presentation-*` hooks. At minimum style:
+
+- the active progress dot and active table-of-contents entry (`[data-active='true']`, also `aria-current="step"`), so the current step is visibly distinct;
+- `[data-presentation-attribution]` (the default bottom-right "made by and-scene" link) so it is legible and intentional;
+- headers, captions, controls, and every node kind (`[data-presentation-kind=...]`). Header and footer titles and captions sit in `[data-presentation-stack]` wrappers (all step texts share one grid cell so the chrome height, and therefore the canvas scale, stays constant); scope rules for the wrapper to the header or footer, e.g. `[data-presentation-header] [data-presentation-stack]`, so a header alignment rule does not also move the caption.
+
+Mark a subtree whose overlap is intentional and readable with `data-presentation-allow-overlap`. Use it only there.
+
+### 4. Self-verify before reporting done
+
+Never report success while a check fails. Fix the cause and re-run.
+
+1. `npm run build` (no type errors) and `npm run lint`.
+2. Render check: at minimum the first step renders with no runtime or console errors. Run the full `npm run verify` before completion (it builds and steps through the reference presentation). Do not report success on broken output.
+3. Visual composition check with the project-local helper (preferred over ad hoc scripts; any temporary Playwright helper must live under the project root):
+
+   ```bash
+   npm run inspect -- <slug>                       # screenshots in .inspection/<slug>/step-NN.png
+   npm run inspect -- <slug> --viewport 390x844    # narrow, for responsive-sensitive presentations
+   ```
+
+   It waits for each transition to settle, then prints advisory `WARN` lines for unmarked text/chrome overlap, indistinct active navigation, and missing/browser-default/undersized attribution. Look at the screenshots of the **first step, the last step, and every dense or key step**. Confirm important content fits the canvas, intentional overlaps stay readable, and nothing collides with captions, progress, table of contents or controls.
+4. Review every warning: fix accidental collisions and indistinct or unpolished chrome in the presentation's CSS or layout, mark only genuinely intentional readable overlaps with `data-presentation-allow-overlap`, then re-run the inspection.
+5. Report the checks actually run, their results, and any remaining advisory warnings, accurately.
+
+Optionally use `chrome-devtools-axi` (`open`, `snapshot`, `screenshot`) for interactive inspection; it does not replace `npm run verify`.
diff --git a/skills/presentation/scripts/create.mjs b/skills/presentation/scripts/create.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d0f6a51e1f6a3b2a842edae82c3603b8900b0394
--- /dev/null
+++ b/skills/presentation/scripts/create.mjs
@@ -0,0 +1,69 @@
+// Creates a presentation from templates/presentation at the locations detect.mjs found
+// (renamed kit directories and registry files are honoured), then registers it.
+// Template paths resolve from this file, never from the caller's working directory.
+//
+// usage: node create.mjs <target-dir> <slug> <title>
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { locations } from './detect.mjs'
+
+const TEMPLATE = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', 'templates', 'presentation')
+
+const walk = (p) =>
+  fs.statSync(p).isDirectory() ? fs.readdirSync(p).flatMap((f) => walk(path.join(p, f))) : [p]
+
+export function createPresentation(target, slug, title) {
+  if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug)) throw new Error(`slug "${slug}" must be lowercase words joined by hyphens`)
+  if (/['"\\<>{}\n`$]/.test(title)) throw new Error('title must not contain quotes, backslashes, braces, angle brackets or line breaks')
+  const where = locations(target)
+  if (!where.kit || !where.registry) throw new Error('no scene kit and presentation registry found: scaffold the missing anchors first')
+  const kit = path.join(target, where.kit)
+  const registry = path.join(target, where.registry)
+  const folder = path.join(target, where.presentations, slug)
+  if (fs.existsSync(folder)) throw new Error(`presentation folder ${path.relative(target, folder)} already exists`)
+
+  // Edit the registry text first: nothing is written until registration is known to work.
+  const source = fs.readFileSync(registry, 'utf8')
+  const last = [...source.matchAll(/\bslug\s*:/g)].at(-1)
+  // The array holding the entries closes at the first line-start `]` after the last entry, not at the file's last one.
+  const close = last ? source.indexOf('\n]', last.index) : -1
+  if (close === -1 || new RegExp(`slug:\\s*['"]${slug}['"]`).test(source)) {
+    throw new Error(`cannot register "${slug}" in ${where.registry}: add it by hand or pick a new slug`)
+  }
+  const head = source.slice(0, close)
+  // A previous entry written without a trailing comma needs one before the new entry.
+  const sep = /[,[]\s*$/.test(head) ? '' : ','
+  const entry = `  {\n    slug: '${slug}',\n    title: '${title}',\n    load: () => import('./${slug}/Talk'),\n  },`
+  const registered = `${head}${sep}\n${entry}${source.slice(close)}`
+
+  try {
+    for (const src of walk(TEMPLATE)) {
+      const dest = path.join(folder, path.relative(TEMPLATE, src))
+      fs.mkdirSync(path.dirname(dest), { recursive: true })
+      const text = fs.readFileSync(src, 'utf8').replaceAll('__SLUG__', slug).replaceAll('__TITLE__', title)
+      // The template imports the kit by its canonical name; point it at wherever the kit actually is.
+      const spec = path.relative(path.dirname(dest), kit).split(path.sep).join('/')
+      fs.writeFileSync(dest, text.replace(/(['"])(?:\.\.\/)+presentation-kit\1/g, `'${spec.startsWith('.') ? spec : `./${spec}`}'`))
+    }
+    fs.writeFileSync(registry, registered)
+  } catch (e) {
+    fs.rmSync(folder, { recursive: true, force: true })
+    throw e
+  }
+  return { folder: path.relative(target, folder).split(path.sep).join('/'), registry: where.registry }
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const [dir, slug, ...title] = process.argv.slice(2)
+  if (!dir || !slug || title.length === 0) {
+    console.error('usage: node create.mjs <target-dir> <slug> <title>')
+    process.exit(2)
+  }
+  try {
+    console.log(JSON.stringify(createPresentation(path.resolve(dir), slug, title.join(' ')), null, 2))
+  } catch (e) {
+    console.error(`create failed: ${e.message}`)
+    process.exit(1)
+  }
+}
diff --git a/skills/presentation/scripts/detect.mjs b/skills/presentation/scripts/detect.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5f5d2567ad32b98bbdede4578a2109c81f77b01c
--- /dev/null
+++ b/skills/presentation/scripts/detect.mjs
@@ -0,0 +1,152 @@
+// Detects the three scaffold anchors (build setup, scene kit, presentation index)
+// and resolves where a presentation app belongs.
+//
+// usage: node detect.mjs [dir]   -> prints JSON
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const exists = (...p) => fs.existsSync(path.join(...p))
+const read = (f) => fs.readFileSync(f, 'utf8')
+const readJson = (file) => {
+  try {
+    return JSON.parse(read(file))
+  } catch {
+    return undefined
+  }
+}
+const SOURCE = /\.(tsx?|jsx?)$/
+const SKIP = new Set(['node_modules', 'dist', '.git', '.inspection'])
+
+function sourceFiles(dir) {
+  if (!fs.existsSync(dir)) return []
+  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
+    const full = path.join(dir, e.name)
+    if (e.isDirectory()) return SKIP.has(e.name) ? [] : sourceFiles(full)
+    return SOURCE.test(e.name) ? [full] : []
+  })
+}
+
+/** Resolves a relative import specifier to an existing source file, if any. */
+function resolveImport(from, spec) {
+  if (!spec.startsWith('.')) return undefined
+  const base = path.resolve(path.dirname(from), spec)
+  const candidates = [base, ...['.ts', '.tsx', '.js', '.jsx'].map((x) => base + x), ...['index.ts', 'index.tsx'].map((x) => path.join(base, x))]
+  return candidates.find((c) => fs.existsSync(c) && fs.statSync(c).isFile())
+}
+
+const importsOf = (file) =>
+  [...read(file).matchAll(/(?:from\s+|import\s*\(\s*|import\s+)['"]([^'"]+)['"]/g)].map((m) => resolveImport(file, m[1])).filter(Boolean)
+
+/** Is `target` reachable from `entry` through relative imports? */
+function reaches(entry, target) {
+  const seen = new Set()
+  const walk = (f) => {
+    if (f === target) return true
+    if (seen.has(f)) return false
+    seen.add(f)
+    return importsOf(f).some(walk)
+  }
+  return walk(entry)
+}
+
+function entryFile(dir) {
+  const html = path.join(dir, 'index.html')
+  const src = fs.existsSync(html) && read(html).match(/<script[^>]*\ssrc="([^"]+)"/)?.[1]
+  const rel = src ? src.replace(/^\//, '') : 'src/main.tsx'
+  return path.join(dir, rel)
+}
+
+const KIT_STAGE = /AnimatePresence/
+const KIT_HOST = /export\s+(default\s+)?(function|const)\s+Presentation\b|export\s*\{[^}]*\bPresentation\b[^}]*\}/
+
+/** Kit = a directory under src exporting a `Presentation` host next to a stage that mounts steps. */
+function findKit(dir) {
+  const files = sourceFiles(path.join(dir, 'src'))
+  const host = files.find((f) => KIT_HOST.test(read(f)))
+  if (!host) return undefined
+  const root = path.dirname(host)
+  return sourceFiles(root).some((f) => KIT_STAGE.test(read(f))) ? root : undefined
+}
+
+/** Registry = a source file listing `{ slug, ..., load: () => import(...) }` entries. */
+function findRegistry(dir, kitDir) {
+  return sourceFiles(path.join(dir, 'src')).find((f) => {
+    if (kitDir && f.startsWith(kitDir + path.sep)) return false
+    const t = read(f)
+    return /\bslug\s*:/.test(t) && /\bload\s*:/.test(t) && /import\s*\(/.test(t)
+  })
+}
+
+/** Contract-level anchor detection: file naming and formatting are free to differ. */
+export function detectAnchors(dir) {
+  const pkg = readJson(path.join(dir, 'package.json'))
+  const deps = { ...pkg?.dependencies, ...pkg?.devDependencies }
+  const hasViteConfig = fs.existsSync(dir) && fs.readdirSync(dir).some((f) => /^vite\.config\./.test(f))
+  const build = Boolean(pkg?.scripts?.build && deps.vite && deps.react && deps.typescript && hasViteConfig)
+
+  const kitDir = findKit(dir)
+  const registry = findRegistry(dir, kitDir)
+  const entry = entryFile(dir)
+  // The registry only counts when the app's entry point actually routes to it.
+  const index = Boolean(registry && fs.existsSync(entry) && reaches(entry, registry))
+  return { build, kit: Boolean(kitDir), index }
+}
+
+/** Where the registry and the app's entry point are; used by the scaffold to wire routing. */
+export const locate = (dir) => ({ entry: entryFile(dir), registry: findRegistry(dir, findKit(dir)) })
+
+/**
+ * Where the kit directory, the registry file and the presentation folders live, relative to `dir`.
+ * Creation must use these, not the canonical names: detection accepts renamed anchors.
+ */
+export function locations(dir) {
+  const kit = findKit(dir)
+  const registry = findRegistry(dir, kit)
+  const rel = (p) => (p ? path.relative(dir, p).split(path.sep).join('/') : undefined)
+  return { kit: rel(kit), registry: rel(registry), presentations: registry ? rel(path.dirname(registry)) : undefined }
+}
+
+const isEmptyDir = (dir) => !fs.existsSync(dir) || fs.readdirSync(dir).filter((f) => f !== '.git').length === 0
+
+export function isMonorepo(dir) {
+  const pkg = readJson(path.join(dir, 'package.json'))
+  return Boolean(pkg?.workspaces) || exists(dir, 'pnpm-workspace.yaml') || exists(dir, 'packages') || exists(dir, 'apps')
+}
+
+const complete = (a) => a.build && a.kit && a.index
+const some = (a) => a.build || a.kit || a.index
+
+export function resolveTarget(dir) {
+  const root = detectAnchors(dir)
+  const nested = path.join(dir, 'presentations')
+  const nestedAnchors = detectAnchors(nested)
+  let target = dir
+  let reason = 'standalone or empty project: scaffold at the root'
+  if (some(root) && !isMonorepo(dir)) reason = 'already inside a presentation app: use it'
+  else if (complete(root)) reason = 'already inside a presentation app: use it'
+  else if (some(nestedAnchors)) {
+    target = nested
+    reason = 'existing presentations/ app: use it'
+  } else if (isMonorepo(dir)) {
+    target = nested
+    reason = 'monorepo: scaffold a self-contained app under presentations/'
+  }
+  const anchors = target === dir ? root : nestedAnchors
+  const missing = Object.keys(anchors).filter((k) => !anchors[k])
+  return {
+    dir,
+    target,
+    reason,
+    anchors,
+    missing,
+    locations: locations(target),
+    empty: isEmptyDir(dir),
+    // A non-empty project without the kit or index must have its target confirmed before writing.
+    needsConfirmation: !isEmptyDir(dir) && (!anchors.kit || !anchors.index),
+  }
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  console.log(JSON.stringify(resolveTarget(path.resolve(process.argv[2] ?? process.cwd())), null, 2))
+}
diff --git a/skills/presentation/scripts/scaffold.mjs b/skills/presentation/scripts/scaffold.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..64961f54ae65c8b602421272d6beb8bc483a4367
--- /dev/null
+++ b/skills/presentation/scripts/scaffold.mjs
@@ -0,0 +1,109 @@
+// Copies the bootstrap template into a target app, adding only what is missing.
+// Template paths resolve from this file, never from the caller's working directory.
+//
+// usage: node scaffold.mjs <target-dir> [--anchors build,kit,index]
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { detectAnchors, locate } from './detect.mjs'
+
+const SKILL_DIR = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+export const BOOTSTRAP = path.join(SKILL_DIR, 'templates', 'bootstrap')
+const HOSTED_MAIN = path.join(SKILL_DIR, 'templates', 'hosted-main.tsx')
+
+const FILES = {
+  build: ['package.json', 'package-lock.json', 'tsconfig.json', 'tsconfig.app.json', 'tsconfig.node.json', 'vite.config.ts', 'eslint.config.js', 'index.html', '.gitignore'],
+  kit: ['src/presentation-kit', 'scripts'],
+  index: ['src/main.tsx', 'src/Router.tsx', 'src/Landing.tsx', 'src/route.ts', 'src/index.css', 'src/presentations', 'verify.config.json'],
+}
+
+const walk = (p) =>
+  fs.statSync(p).isDirectory() ? fs.readdirSync(p).flatMap((f) => walk(path.join(p, f))) : [p]
+
+/** Adds missing keys of `from` into `into`, never changing values already present. */
+function mergeMissing(into, from) {
+  for (const [k, v] of Object.entries(from)) if (!(k in into)) into[k] = v
+}
+
+function mergePackage(target) {
+  const file = path.join(target, 'package.json')
+  const tpl = JSON.parse(fs.readFileSync(path.join(BOOTSTRAP, 'package.json'), 'utf8'))
+  if (!fs.existsSync(file)) {
+    fs.writeFileSync(file, JSON.stringify(tpl, null, 2) + '\n')
+    return
+  }
+  const pkg = JSON.parse(fs.readFileSync(file, 'utf8'))
+  for (const key of ['scripts', 'dependencies', 'devDependencies']) {
+    pkg[key] ??= {}
+    mergeMissing(pkg[key], tpl[key])
+  }
+  pkg.type ??= tpl.type
+  fs.writeFileSync(file, JSON.stringify(pkg, null, 2) + '\n')
+}
+
+/**
+ * An existing entry point that does not reach the registry keeps running its app
+ * for non-presentation paths: it moves to `app-main` and a router entry replaces it.
+ * The router entry is always `.tsx`; `index.html` is repointed when the host entry had another extension.
+ */
+function wireEntry(target, written) {
+  if (detectAnchors(target).index) return
+  const { entry } = locate(target)
+  if (!fs.existsSync(entry) || !/\.[tj]sx?$/.test(entry)) return
+  const ext = path.extname(entry)
+  const dir = path.dirname(entry)
+  const moved = path.join(dir, `app-main${ext}`)
+  if (fs.existsSync(moved)) return
+  const next = path.join(dir, `${path.basename(entry, ext)}.tsx`)
+  fs.renameSync(entry, moved)
+  fs.copyFileSync(HOSTED_MAIN, next)
+  // A plain JS host module has no types: declare it so the router entry's dynamic import builds under `tsc -b`.
+  if (/^\.[jm]?jsx?$/.test(ext)) {
+    const decl = path.join(dir, 'app-main.d.ts')
+    if (!fs.existsSync(decl)) fs.writeFileSync(decl, 'export {}\n')
+  }
+  const html = path.join(target, 'index.html')
+  if (next !== entry && fs.existsSync(html)) {
+    fs.writeFileSync(html, fs.readFileSync(html, 'utf8').replace(path.basename(entry), path.basename(next)))
+  }
+  written.push(`${path.relative(target, next)} (router entry; previous entry moved to ${path.relative(target, moved)})`)
+}
+
+export function scaffold(target, anchors) {
+  const written = []
+  const write = (rel) => {
+    for (const src of walk(path.join(BOOTSTRAP, rel))) {
+      const r = path.relative(BOOTSTRAP, src)
+      const dest = path.join(target, r)
+      if (fs.existsSync(dest)) continue // never disturb what is already there
+      fs.mkdirSync(path.dirname(dest), { recursive: true })
+      fs.copyFileSync(src, dest)
+      written.push(r)
+    }
+  }
+  fs.mkdirSync(target, { recursive: true })
+  const hadPackage = fs.existsSync(path.join(target, 'package.json'))
+  for (const anchor of anchors) {
+    if (anchor === 'build') {
+      // A lock file only matches a freshly written package.json.
+      for (const f of FILES.build) if (f !== 'package.json' && (f !== 'package-lock.json' || !hadPackage)) write(f)
+    } else {
+      FILES[anchor].forEach(write)
+    }
+  }
+  if (anchors.includes('index')) wireEntry(target, written)
+  // Every scaffold needs the dependency set, even when package.json already existed.
+  mergePackage(target)
+  return { written, needsInstall: !hadPackage || anchors.length > 0 }
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const args = process.argv.slice(2)
+  const target = path.resolve(args.find((a) => !a.startsWith('--') && args[args.indexOf(a) - 1] !== '--anchors') ?? '.')
+  const i = args.indexOf('--anchors')
+  const detected = detectAnchors(target)
+  const anchors = i === -1 ? Object.keys(detected).filter((k) => !detected[k]) : args[i + 1].split(',')
+  const result = scaffold(target, anchors)
+  console.log(JSON.stringify({ target, anchors, ...result }, null, 2))
+  if (result.needsInstall) console.log('Next: run `npm install` in the target to install the dependency set.')
+}
