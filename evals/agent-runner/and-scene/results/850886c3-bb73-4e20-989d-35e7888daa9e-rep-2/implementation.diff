index 0000000000000000000000000000000000000000..4e1cd24f1de4becb530d9ccd70169df25d234850
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
@@ -0,0 +1,142 @@
+// Captures settled per-step screenshots of a presentation from a production preview
+// and prints advisory visual-quality warnings. Warnings never change the exit code.
+//
+// usage: node scripts/inspect-presentation.mjs <slug> [--out dir] [--settle ms]
+//        [--viewport WxH] [--no-build]
+import fs from 'node:fs'
+import path from 'node:path'
+import { chromium } from 'playwright'
+import { projectRoot, readIndex, run, startPreview, waitForIndex } from './lib.mjs'
+
+const args = process.argv.slice(2)
+const opt = (name, fallback) => {
+  const i = args.indexOf(`--${name}`)
+  return i === -1 ? fallback : args[i + 1]
+}
+const VALUE_FLAGS = new Set(['--out', '--settle', '--viewport'])
+const slug = args.find((a, i) => !a.startsWith('--') && !VALUE_FLAGS.has(args[i - 1]))
+if (!slug) {
+  console.error('usage: inspect-presentation.mjs <slug> [--out dir] [--settle ms] [--viewport WxH] [--no-build]')
+  process.exit(2)
+}
+const settle = Number(opt('settle', 1800))
+const [width, height] = opt('viewport', '1280x720').split('x').map(Number)
+const outDir = path.resolve(projectRoot, opt('out', '.inspection'), slug)
+
+/** Runs in the page: returns advisory warnings for the current step. */
+function diagnose() {
+  const ALLOW = '[data-presentation-allow-overlap]'
+  const CHROME = [
+    '[data-presentation-dot]',
+    '[data-presentation-prev]',
+    '[data-presentation-next]',
+    '[data-presentation-toc-entry]',
+    '[data-presentation-attribution]',
+  ].join(',')
+  const visible = (el) => {
+    for (let n = el; n; n = n.parentElement) {
+      const s = getComputedStyle(n)
+      if (s.display === 'none' || s.visibility === 'hidden' || Number(s.opacity) < 0.05) return false
+    }
+    return true
+  }
+  const label = (el) => (el.textContent || el.getAttribute('aria-label') || el.tagName).trim().slice(0, 40)
+
+  const items = []
+  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT)
+  const seen = new Set()
+  for (let t = walker.nextNode(); t; t = walker.nextNode()) {
+    const el = t.parentElement
+    if (!t.textContent.trim() || !el || el.closest('script,style') || !visible(el)) continue
+    const range = document.createRange()
+    range.selectNodeContents(t)
+    const r = range.getBoundingClientRect()
+    if (r.width > 0 && r.height > 0) items.push({ el, r, name: t.textContent.trim().slice(0, 40) })
+    seen.add(el)
+  }
+  for (const el of document.querySelectorAll(CHROME)) {
+    const r = el.getBoundingClientRect()
+    if (!seen.has(el) && r.width > 0 && r.height > 0 && visible(el)) items.push({ el, r, name: label(el) })
+  }
+
+  const warnings = []
+  for (let i = 0; i < items.length; i++) {
+    for (let j = i + 1; j < items.length; j++) {
+      const a = items[i]
+      const b = items[j]
+      if (a.el.contains(b.el) || b.el.contains(a.el) || a.el.closest(ALLOW) || b.el.closest(ALLOW)) continue
+      const w = Math.min(a.r.right, b.r.right) - Math.max(a.r.left, b.r.left)
+      const h = Math.min(a.r.bottom, b.r.bottom) - Math.max(a.r.top, b.r.top)
+      if (w > 2 && h > 2) warnings.push(`overlap: "${a.name}" overlaps "${b.name}" (no allow-overlap marker)`)
+    }
+  }
+
+  // Entries of different text length differ in width, so size only counts for progress dots.
+  const looks = (el, withSize) => {
+    const s = getComputedStyle(el)
+    return ['backgroundColor', 'color', 'borderTopColor', 'borderLeftColor', 'transform', 'opacity', 'fontWeight', 'boxShadow', 'textDecorationLine', ...(withSize ? ['width', 'height'] : [])]
+      .map((k) => s[k])
+      .join('|')
+  }
+  for (const [name, sel, withSize] of [['progress indicator', '[data-presentation-dot]', true], ['table-of-contents entry', '[data-presentation-toc-entry]', false]]) {
+    const active = document.querySelector(`${sel}[data-active="true"]`)
+    const inactive = document.querySelector(`${sel}:not([data-active="true"])`)
+    if (active && inactive && looks(active, withSize) === looks(inactive, withSize)) {
+      warnings.push(`active-chrome: the active ${name} looks identical to inactive ones; style ${sel}[data-active="true"]`)
+    }
+  }
+
+  const attr = document.querySelector('[data-presentation-attribution]')
+  if (!attr) {
+    warnings.push('attribution: missing; style the [data-presentation-attribution] hook')
+  } else {
+    const s = getComputedStyle(attr)
+    if (parseFloat(s.fontSize) < 11) warnings.push(`attribution: too small (${s.fontSize}); style [data-presentation-attribution]`)
+    if (s.color === 'rgb(0, 0, 238)') warnings.push('attribution: browser-default link styling; style [data-presentation-attribution]')
+  }
+  return warnings
+}
+
+async function main() {
+  if (!args.includes('--no-build')) {
+    const build = await run('npm', ['run', 'build'], projectRoot)
+    if (build.code !== 0) throw new Error(`npm run build failed\n${build.output.slice(-2000)}`)
+  }
+  fs.rmSync(outDir, { recursive: true, force: true })
+  fs.mkdirSync(outDir, { recursive: true })
+
+  const preview = await startPreview(projectRoot)
+  let browser
+  const report = []
+  try {
+    browser = await chromium.launch()
+    const page = await browser.newPage({ viewport: { width, height } })
+    await page.goto(`${preview.base}/${slug}`)
+    await page.waitForSelector('[data-step-count]', { timeout: 10_000 })
+    const count = Number(await page.getAttribute('[data-step-count]', 'data-step-count'))
+    for (let i = 0; i < count; i++) {
+      if (i > 0) {
+        await page.keyboard.press('ArrowRight')
+        if (!(await waitForIndex(page, i))) throw new Error(`step index did not advance to ${i} (at ${await readIndex(page)})`)
+      }
+      await page.waitForTimeout(settle)
+      const file = path.join(outDir, `step-${String(i + 1).padStart(2, '0')}.png`)
+      await page.screenshot({ path: file })
+      const warnings = await page.evaluate(diagnose)
+      report.push({ step: i + 1, file: path.relative(projectRoot, file), settleMs: settle, warnings })
+      console.log(`step ${i + 1}/${count}: ${path.relative(projectRoot, file)}`)
+      for (const w of warnings) console.log(`  WARN step ${i + 1}: ${w}`)
+    }
+  } finally {
+    await browser?.close()
+    preview.stop()
+  }
+  fs.writeFileSync(path.join(outDir, 'report.json'), JSON.stringify({ slug, viewport: { width, height }, steps: report }, null, 2))
+  const total = report.reduce((n, s) => n + s.warnings.length, 0)
+  console.log(`inspected ${report.length} steps at ${width}x${height}; ${total} advisory warning(s) (advisory only)`)
+}
+
+main().catch((e) => {
+  console.error(`inspect failed: ${e.message}`)
+  process.exit(1)
+})
diff --git a/skills/presentation/templates/bootstrap/scripts/lib.mjs b/skills/presentation/templates/bootstrap/scripts/lib.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4daf320f5503e57d08708f2aa2fab444cf0036f2
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib.mjs
@@ -0,0 +1,86 @@
+import { spawn } from 'node:child_process'
+import net from 'node:net'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+/** Deterministic IPv4 loopback for the preview server, readiness probe and browser URLs. */
+export const HOST = '127.0.0.1'
+
+export const projectRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+
+export function run(cmd, args, cwd) {
+  return new Promise((resolve) => {
+    const child = spawn(cmd, args, { cwd, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (d) => (output += d))
+    child.stderr.on('data', (d) => (output += d))
+    child.on('error', (e) => resolve({ code: 1, output: String(e) }))
+    child.on('close', (code) => resolve({ code: code ?? 1, output }))
+  })
+}
+
+function freePort() {
+  return new Promise((resolve, reject) => {
+    const srv = net.createServer()
+    srv.once('error', reject)
+    srv.listen(0, HOST, () => {
+      const { port } = srv.address()
+      srv.close(() => resolve(port))
+    })
+  })
+}
+
+/** Starts `vite preview` on 127.0.0.1 and waits until it answers. */
+export async function startPreview(root) {
+  const port = await freePort()
+  const vite = path.join(root, 'node_modules', '.bin', 'vite')
+  const child = spawn(vite, ['preview', '--host', HOST, '--port', String(port), '--strictPort'], {
+    cwd: root,
+    detached: true,
+    stdio: ['ignore', 'pipe', 'pipe'],
+  })
+  let log = ''
+  child.stdout.on('data', (d) => (log += d))
+  child.stderr.on('data', (d) => (log += d))
+  let exited = false
+  child.on('exit', () => (exited = true))
+  const base = `http://${HOST}:${port}`
+  const stop = () => {
+    if (exited || !child.pid) return
+    try {
+      process.kill(-child.pid, 'SIGTERM')
+    } catch {
+      /* already gone */
+    }
+  }
+  const deadline = Date.now() + 30_000
+  while (Date.now() < deadline) {
+    if (exited) break
+    try {
+      const res = await fetch(`${base}/`)
+      if (res.ok) return { base, stop }
+    } catch {
+      /* not ready yet */
+    }
+    await new Promise((r) => setTimeout(r, 150))
+  }
+  stop()
+  throw new Error(`preview did not become ready on ${base}\n${log}`)
+}
+
+export const STEP = '[data-step-index]'
+
+export const readIndex = (page) => page.getAttribute(STEP, 'data-step-index').then(Number)
+
+export async function waitForIndex(page, expected, timeout = 4000) {
+  try {
+    await page.waitForFunction(
+      ([sel, want]) => document.querySelector(sel)?.getAttribute('data-step-index') === String(want),
+      [STEP, expected],
+      { timeout },
+    )
+    return true
+  } catch {
+    return false
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/verify.mjs b/skills/presentation/templates/bootstrap/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..10cbfc5a109a658c49c0a2f5f90bda4d11a6ea46
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/verify.mjs
@@ -0,0 +1,170 @@
+// Deterministic gate: build the whole app, check the reference presentation is
+// registered, then render it through every step in Chromium against a production preview.
+import fs from 'node:fs'
+import path from 'node:path'
+import { chromium } from 'playwright'
+import { HOST, projectRoot, readIndex, run, startPreview, waitForIndex } from './lib.mjs'
+
+const root = projectRoot
+
+// The committed reference sample of the and-scene repository. It is enforced here, not
+// read from replaceable project configuration, whenever the project is and-scene itself.
+const CANONICAL = {
+  slug: 'how-to-make-a-presentation',
+  steps: [
+    { title: "You have a topic", caption: "It starts with you, a topic, and mild overconfidence." },
+    { title: "The skill interviews you", caption: "One question at a time: the topic, the look, then each beat of the story." },
+    { title: "Answers become steps", caption: "Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next." },
+    { title: "The deck grows", caption: "Same shapes, new beats. Every answer extends the story without redrawing it." },
+    { title: "You set the depth", caption: "Spell out every step, or sketch a few and see how it looks. You hold the gate." },
+    { title: "It assembles the scene", caption: "Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph." },
+    { title: "It checks its own work", caption: "Before saying done, it builds and renders every step — and fixes what breaks." },
+    { title: "Changed your mind? Loop it.", caption: "Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch." },
+    { title: "You're looking at one", caption: "This presentation was built exactly this way. Thanks for watching." },
+  ],
+}
+
+const isAndScene = () => JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8')).name === 'and-scene'
+
+class Failure extends Error {
+  constructor(phase, message, step) {
+    super(message)
+    this.phase = phase
+    this.step = step
+  }
+}
+
+/** Every reference this project must render: the canonical sample and/or its own configured one. */
+function loadReferences() {
+  const refs = isAndScene() ? [CANONICAL] : []
+  const file = path.join(root, 'verify.config.json')
+  if (fs.existsSync(file)) {
+    const configured = JSON.parse(fs.readFileSync(file, 'utf8')).reference
+    if (!refs.some((r) => r.slug === configured.slug)) refs.push(configured)
+  }
+  if (refs.length === 0) throw new Failure('sample', 'no reference presentation: verify.config.json is missing')
+  return refs
+}
+
+const SOURCE = /\.[tj]sx?$/
+const SKIP = new Set(['node_modules', 'dist', '.git', '.inspection'])
+
+function sourceFiles(dir) {
+  if (!fs.existsSync(dir)) return []
+  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
+    const full = path.join(dir, e.name)
+    if (e.isDirectory()) return SKIP.has(e.name) ? [] : sourceFiles(full)
+    return SOURCE.test(e.name) ? [full] : []
+  })
+}
+
+/**
+ * The reference must be a registry entry (`slug` + lazy `load`, matched within that one entry) whose imported module exists.
+ * The registry is found by contract, not by name, so renamed registry files and folders verify too.
+ */
+function checkRegistered(slug) {
+  const entry = new RegExp(`slug:\\s*['"]${slug.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}['"][^{}]*?load:[^{}]*?import\\(\\s*['"]([^'"]+)['"]`)
+  for (const file of sourceFiles(path.join(root, 'src'))) {
+    const found = fs.readFileSync(file, 'utf8').match(entry)
+    if (!found) continue
+    const base = path.resolve(path.dirname(file), found[1])
+    const rel = path.relative(root, file)
+    const exts = ['.ts', '.tsx', '.js', '.jsx']
+    const candidates = [base, ...exts.map((x) => base + x), ...exts.map((x) => path.join(base, `index${x}`))]
+    if (!candidates.some((c) => fs.existsSync(c) && fs.statSync(c).isFile())) {
+      throw new Failure('sample', `reference presentation "${slug}" is registered in ${rel} but ${found[1]} does not exist`)
+    }
+    return
+  }
+  throw new Failure('sample', `reference presentation "${slug}" is not registered in any presentation registry under src/ (an entry needs its own { slug, load: () => import('./...') })`)
+}
+
+async function render(reference, preview, browser) {
+  const page = await browser.newPage()
+  // `current` is the step being rendered, so errors raised by a transition belong to its target.
+  let current = 0
+  const errors = []
+  const note = (kind, text) => errors.push(new Failure('render', `${kind}: ${text}`, current))
+  page.on('console', (m) => m.type() === 'error' && note('console.error', m.text()))
+  page.on('pageerror', (e) => note('pageerror', e.message))
+
+  const url = `${preview.base}/${reference.slug}`
+  if (!url.startsWith(`http://${HOST}:`)) throw new Failure('render', `unexpected URL ${url}`)
+  await page.goto(url)
+  try {
+    await page.waitForSelector('[data-step-count]', { timeout: 10_000 })
+  } catch {
+    throw errors[0] ?? new Failure('render', `route ${url} did not render a presentation`, 0)
+  }
+  const count = Number(await page.getAttribute('[data-step-count]', 'data-step-count'))
+  if (count !== reference.steps.length) {
+    throw new Failure('sample', `expected ${reference.steps.length} steps, found ${count}`)
+  }
+  if (!(await page.$('[data-presentation-caption]'))) await page.keyboard.press('p')
+
+  for (let step = 0; step < count; step++) {
+    current = step
+    if (!(await waitForIndex(page, step))) {
+      throw new Failure('transition', `step index did not advance to ${step} (at ${await readIndex(page)})`, step)
+    }
+    await page.waitForTimeout(300)
+    const title = await page.textContent('[data-presentation-title]')
+    const caption = await page.textContent('[data-presentation-caption]')
+    const want = reference.steps[step]
+    if (title !== want.title || caption !== want.caption) {
+      throw new Failure('sample', `step ${step} title/caption differ from the reference (got "${title}")`, step)
+    }
+    if (errors.length) throw errors[0]
+    if (step < count - 1) {
+      current = step + 1
+      await page.keyboard.press('ArrowRight')
+    }
+  }
+  await page.waitForTimeout(500)
+  if (errors.length) throw errors[0]
+  await page.close()
+  return count
+}
+
+async function renderAll(references) {
+  const preview = await startPreview(root).catch((e) => {
+    throw new Failure('preview', e.message)
+  })
+  let browser
+  try {
+    browser = await chromium.launch().catch((e) => {
+      throw new Failure('render', `browser launch failed: ${e.message.split('\n')[0]}`)
+    })
+    const counts = []
+    for (const reference of references) counts.push([reference.slug, await render(reference, preview, browser)])
+    return counts
+  } finally {
+    await browser?.close()
+    preview.stop()
+  }
+}
+
+async function main() {
+  const build = await run('npm', ['run', 'build'], root)
+  if (build.code !== 0) throw new Failure('build', `npm run build failed\n${build.output.slice(-2000)}`)
+  console.log('[verify] build: ok')
+
+  const references = loadReferences()
+  for (const { slug } of references) {
+    checkRegistered(slug)
+    console.log(`[verify] sample: "${slug}" is registered`)
+  }
+
+  for (const [slug, steps] of await renderAll(references)) {
+    console.log(`[verify] render: ${slug}: ${steps} steps rendered without errors on ${HOST}`)
+  }
+}
+
+main().then(
+  () => console.log('VERIFY PASSED'),
+  (e) => {
+    const where = e.step === undefined ? '' : ` step=${e.step}`
+    console.error(`VERIFY FAILED phase=${e.phase ?? 'internal'}${where}: ${e.message}`)
+    process.exit(1)
+  },
+)
