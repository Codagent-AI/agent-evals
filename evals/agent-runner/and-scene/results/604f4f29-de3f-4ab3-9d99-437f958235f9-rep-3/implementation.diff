new file mode 100644
index 0000000000000000000000000000000000000000..4aa05870fc65a04d24791179e7f3eeaa615c4e41
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,46 @@
+import { useLayoutEffect, useRef, useState } from 'react'
+import type { RefObject } from 'react'
+import { DESIGN_H, DESIGN_W, MAX_SCALE, MIN_SCALE, STAGE_LAYOUT } from './constants.ts'
+import type { Mode } from './types.ts'
+
+/** Uniform scale that fits the design canvas into the available box. */
+export function computeFitScale(
+  availW: number,
+  availH: number,
+  mode: Mode,
+  designW = DESIGN_W,
+  designH = DESIGN_H,
+): number {
+  if (!Number.isFinite(availW) || !Number.isFinite(availH)) return 1
+  if (availW <= 0 || availH <= 0) return MIN_SCALE
+  // Padding is dropped when it would leave no room, so any positive space still fits.
+  const { padX, padY } = STAGE_LAYOUT[mode]
+  const w = availW > padX ? availW - padX : availW
+  const h = availH > padY ? availH - padY : availH
+  return Math.min(MAX_SCALE, w / designW, h / designH)
+}
+
+/** Measures the stage area and returns the uniform scale for the active mode. */
+export function useFitScale(mode: Mode, designW = DESIGN_W, designH = DESIGN_H) {
+  const areaRef: RefObject<HTMLDivElement | null> = useRef(null)
+  const [scale, setScale] = useState(1)
+
+  useLayoutEffect(() => {
+    const el = areaRef.current
+    if (!el) return
+    const update = () => {
+      const { width, height } = el.getBoundingClientRect()
+      if (width > 0 && height > 0) setScale(computeFitScale(width, height, mode, designW, designH))
+    }
+    update()
+    if (typeof ResizeObserver === 'undefined') {
+      window.addEventListener('resize', update)
+      return () => window.removeEventListener('resize', update)
+    }
+    const observer = new ResizeObserver(update)
+    observer.observe(el)
+    return () => observer.disconnect()
+  }, [mode, designW, designH])
+
+  return { areaRef, scale }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7f108416a246c1c699251688e865be1dcea3be67
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,45 @@
+import { useCallback, useEffect, useMemo, useReducer } from 'react'
+import { isInteractiveTarget, keyAction, navReducer, swipeAction } from './nav.ts'
+import type { NavState } from './nav.ts'
+import type { Mode } from './types.ts'
+
+export function usePresentationNav(count: number, initialMode: Mode = 'browse') {
+  const reducer = useMemo(() => navReducer(count), [count])
+  const [state, dispatch] = useReducer(reducer, { index: 0, mode: initialMode } as NavState)
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.defaultPrevented || isInteractiveTarget(e.target)) return
+      const action = keyAction(e)
+      if (!action) return
+      e.preventDefault()
+      dispatch(action)
+    }
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      start = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onTouchEnd = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      if (!start || !t) return
+      const action = swipeAction(t.clientX - start.x, t.clientY - start.y)
+      start = null
+      if (action) dispatch(action)
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart, { passive: true })
+    window.addEventListener('touchend', onTouchEnd, { passive: true })
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [])
+
+  const next = useCallback(() => dispatch({ type: 'next' }), [])
+  const prev = useCallback(() => dispatch({ type: 'prev' }), [])
+  const goTo = useCallback((index: number) => dispatch({ type: 'goTo', index }), [])
+  const toggleMode = useCallback(() => dispatch({ type: 'toggleMode' }), [])
+  return { ...state, next, prev, goTo, toggleMode }
+}
