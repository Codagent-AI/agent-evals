+import type { ReactNode } from 'react'
+import { stepNumber } from '../steps.ts'
+import type { Mode, StepMeta } from '../types.ts'
+
+interface HeaderProps {
+  step: StepMeta
+  index: number
+  mode: Mode
+  title: string
+  /** Host-provided branding for the top-left slot; the kit renders none by default. */
+  brand?: ReactNode
+}
+
+export function Header({ step, index, mode, title, brand }: HeaderProps) {
+  return (
+    <header
+      data-presentation-header=""
+      style={{ display: 'flex', alignItems: 'center', flex: '0 0 auto' }}
+    >
+      <div data-presentation-brand-slot="">{brand}</div>
+      <span data-presentation-marker="">
+        <span data-presentation-marker-number="">{String(stepNumber(index)).padStart(2, '0')}</span>{' '}
+        <span data-presentation-marker-era="">{step.era}</span>
+      </span>
+      {mode === 'browse' && (
+        <span data-presentation-deck-title="" style={{ marginLeft: 'auto' }}>
+          {title}
+        </span>
+      )}
+    </header>
+  )
+}
diff --git a/src/presentation-kit/chrome/Toc.tsx b/src/presentation-kit/chrome/Toc.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a2d5a8b0b1bab57e32d006df82b8e5c18f8da944
--- /dev/null
+++ b/src/presentation-kit/chrome/Toc.tsx
@@ -0,0 +1,38 @@
+import { groupByEra } from '../steps.ts'
+import type { StepMeta } from '../types.ts'
+
+interface TocProps {
+  steps: readonly StepMeta[]
+  index: number
+  onGoTo: (index: number) => void
+}
+
+/** Era-based table of contents; an entry jumps to the first step of its era. */
+export function Toc({ steps, index, onGoTo }: TocProps) {
+  return (
+    <nav
+      data-presentation-toc=""
+      aria-label="Table of contents"
+      style={{ flex: '0 0 auto', overflowY: 'auto' }}
+    >
+      <ol>
+        {groupByEra(steps).map((group) => {
+          const active = group.indices.includes(index)
+          return (
+            <li key={group.first}>
+              <button
+                type="button"
+                data-presentation-toc-entry=""
+                data-presentation-active={active ? 'true' : 'false'}
+                aria-current={active ? 'step' : undefined}
+                onClick={() => onGoTo(group.first)}
+              >
+                {group.era}
+              </button>
+            </li>
+          )
+        })}
+      </ol>
+    </nav>
+  )
+}
