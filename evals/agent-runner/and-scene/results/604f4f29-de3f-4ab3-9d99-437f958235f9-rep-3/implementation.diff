+// Copies the canonical kit, host files and verification scripts into the skill's
+// bootstrap template so the snapshot never drifts. Run after changing any of them.
+import { cpSync, mkdirSync, rmSync } from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const target = path.join(root, 'skills', 'presentation', 'templates', 'bootstrap')
+
+export const SYNCED_FILES = [
+  'src/main.tsx',
+  'src/Landing.tsx',
+  'src/router.ts',
+  'src/index.css',
+  'scripts/verify.mjs',
+  'scripts/inspect-presentation.mjs',
+  'scripts/lib/preview.mjs',
+]
+export const SYNCED_DIRS = ['src/presentation-kit']
+
+rmSync(path.join(target, 'src', 'presentation-kit'), { recursive: true, force: true })
+for (const rel of [...SYNCED_DIRS, ...SYNCED_FILES]) {
+  mkdirSync(path.dirname(path.join(target, rel)), { recursive: true })
+  cpSync(path.join(root, rel), path.join(target, rel), { recursive: true })
+}
+console.log('synced bootstrap template from canonical sources')
diff --git a/scripts/verify.mjs b/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..2beb865cb6b9b17e5f8e44434e77adcaa0a6fa67
--- /dev/null
+++ b/scripts/verify.mjs
@@ -0,0 +1,141 @@
+// Deterministic verification gate: build, registry, and real-browser render check.
+// Usage: node scripts/verify.mjs [--slug <slug>]...
+// Every registered presentation is stepped through. With scripts/reference-sample.json
+// present, the canonical reference sample is additionally held to its normative outline
+// (existence, registration, every title/caption in order); `--slug` limits the run.
+import { existsSync, readFileSync } from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { launchChromium, run, startPreview } from './lib/preview.mjs'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const STEP_TIMEOUT_MS = 4000
+const SETTLE_MS = 800
+
+class VerifyError extends Error {
+  constructor(phase, message) {
+    super(message)
+    this.phase = phase
+  }
+}
+
+function registeredSlugs() {
+  const file = ['index.ts', 'index.tsx']
+    .map((f) => path.join(root, 'src', 'presentations', f))
+    .find(existsSync)
+  if (!file) throw new VerifyError('registry', 'src/presentations/index.ts is missing')
+  return [...readFileSync(file, 'utf8').matchAll(/slug:\s*['"]([^'"]+)['"]/g)].map((m) => m[1])
+}
+
+function loadReference() {
+  const file = path.join(root, 'scripts', 'reference-sample.json')
+  return existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : null
+}
+
+function targets() {
+  const args = process.argv.slice(2)
+  const slugs = args.flatMap((a, i) => (a === '--slug' ? [args[i + 1]] : []))
+  const registered = registeredSlugs()
+  const reference = loadReference()
+  if (reference && !registered.includes(reference.slug)) {
+    throw new VerifyError('sample', `reference sample "${reference.slug}" is not registered`)
+  }
+  const wanted = slugs.length ? slugs : registered
+  if (!wanted.length) throw new VerifyError('registry', 'no presentations are registered')
+  for (const slug of wanted) {
+    if (!registered.includes(slug)) throw new VerifyError('registry', `"${slug}" is not registered`)
+  }
+  return wanted.map((slug) => ({ slug, steps: slug === reference?.slug ? reference.steps : null }))
+}
+
+async function text(page, selector) {
+  return (await page.locator(selector).first().textContent({ timeout: 2000 }))?.trim() ?? ''
+}
+
+async function renderPresentation(browser, baseUrl, { slug, steps }) {
+  const page = await browser.newPage()
+  let step = 0 // the step being rendered, or entered by the key press in flight
+  const errors = []
+  page.on('console', (msg) => {
+    if (msg.type() === 'error') errors.push(`step ${step}: console error: ${msg.text()}`)
+  })
+  page.on('pageerror', (err) => errors.push(`step ${step}: uncaught exception: ${err.message}`))
+  const fail = (message) => new VerifyError('render', `${slug}: ${message}`)
+  const root$ = '[data-presentation-root]'
+  try {
+    await page.goto(`${baseUrl}/${slug}`)
+    try {
+      await page.waitForSelector(root$, { timeout: 10_000 })
+    } catch {
+      throw fail(`step 0: presentation did not render${errors.length ? ` (${errors[0]})` : ''}`)
+    }
+    const count = Number(await page.getAttribute(root$, 'data-step-count'))
+    if (!count) throw fail('step 0: missing data-step-count hook')
+    if (steps && count !== steps.length) {
+      throw fail(`expected ${steps.length} steps but the presentation reports ${count}`)
+    }
+    step = 0
+    for (;;) {
+      const index = Number(await page.getAttribute(root$, 'data-step-index'))
+      if (index !== step) throw fail(`step ${step}: transition failed, step index is ${index}`)
+      if (steps) {
+        const title = await text(page, '[data-presentation-step-title]')
+        const caption = await text(page, '[data-presentation-caption]').catch(() => '')
+        if (title !== steps[step].title) {
+          throw fail(`step ${step}: title "${title}" does not match "${steps[step].title}"`)
+        }
+        if (caption !== steps[step].caption) {
+          throw fail(`step ${step}: caption "${caption}" does not match "${steps[step].caption}"`)
+        }
+      }
+      await page.waitForTimeout(SETTLE_MS)
+      if (errors.length) throw fail(errors[0])
+      if (step === count - 1) break
+      step += 1
+      await page.keyboard.press('ArrowRight')
+      try {
+        await page.waitForFunction(
+          ([sel, next]) =>
+            document.querySelector(sel)?.getAttribute('data-step-index') === String(next),
+          [root$, step],
+          { timeout: STEP_TIMEOUT_MS },
+        )
+      } catch {
+        if (errors.length) throw fail(errors[0])
+        throw fail(`step ${step - 1}: transition failed, step index did not advance to ${step}`)
+      }
+    }
+    if (errors.length) throw fail(errors[0])
+    console.log(`  ok  ${slug}: ${count} steps rendered without errors`)
+  } finally {
+    await page.close()
+  }
+}
+
+async function main() {
+  console.log('[verify] build')
+  if ((await run('npm', ['run', 'build'], { cwd: root })) !== 0) {
+    throw new VerifyError('build', 'npm run build failed')
+  }
+  console.log('[verify] registry')
+  const list = targets()
+  console.log(`[verify] render`)
+  const preview = await startPreview(root)
+  let browser
+  try {
+    browser = await launchChromium()
+    console.log(`  preview at ${preview.baseUrl}`)
+    for (const target of list) await renderPresentation(browser, preview.baseUrl, target)
+  } finally {
+    await browser?.close()
+    preview.stop()
+  }
+}
+
+main().then(
+  () => console.log('VERIFY PASSED'),
+  (err) => {
+    console.error(`VERIFY FAILED [${err.phase ?? 'internal'}]: ${err.message}`)
+    process.exit(1)
+  },
+)
diff --git a/skills/presentation/SKILL.md b/skills/presentation/SKILL.md
new file mode 100644
index 0000000000000000000000000000000000000000..afb6496399fbb564fe9ddf005f05f3ea0baa544b
--- /dev/null
+++ b/skills/presentation/SKILL.md
@@ -0,0 +1,135 @@
+---
+name: presentation
+description: Creates or modifies a browser presentation from a topic, built as one evolving diagrammatic scene (stable entities that move, connect, and re-label across named steps). Use when asked to make, build, extend, or edit a presentation, talk, or animated explainer. Bootstraps the Vite + React + TypeScript scene kit when the project lacks it.
+---
+
+# Presentation
+
+A presentation is **one scene** moving through ordered, named steps. Entities keep a
+stable id, so they morph in place between steps instead of being redrawn. "Talk" is only
+informal speech for presentation (the per-presentation entry component is `Talk.tsx`).
+
+Paths below are relative to this `SKILL.md`. Run the helper by its absolute path:
+`node <skill-dir>/scripts/scaffold.mjs ...`. It resolves its templates from its own
+location, so the current working directory never matters.
+
+## 1. Gather
+
+Ask the user **one question at a time**, never assuming what they can still tell you:
+
+1. the topic,
+2. the visual style (palette, mood, typography),
+3. for each step: its content and what the diagram looks like.
+
+Skip questions the prompt already answers. The user decides how much to specify: if they
+choose to build with partial detail, build from what you have and iterate — there is no
+completeness gate. For a key or complex step you may draw an ASCII mockup to confirm the
+layout; do not do this for every step.
+
+## 2. Resolve the target and scaffold what is missing
+
+A project is ready when three contract anchors exist (detection is by presence, not by a
+byte-identical scaffold):
+
+1. **Build setup** — Vite + React + TypeScript with a working `npm run build`.
+2. **Scene kit** — `src/presentation-kit/` (step contract, stage, nav, chrome, nodes).
+3. **Presentation index** — `src/presentations/index.ts`, the registry giving each
+   presentation its own route.
+
+```bash
+node <skill-dir>/scripts/scaffold.mjs detect <project-dir>
+```
+
+prints the resolved `target`, which anchors exist, and which are `missing`. The helper
+recognizes anchors by what source files export (a `Presentation` component, a
+`presentations` registry array), not by their names — but it is a heuristic. **Before
+trusting a `missing` result, look at the project yourself** for equivalent
+implementations (a differently named kit, a registry in another file, a half-written
+stub) and treat those as present: never scaffold over them. Cosmetic differences such
+as file names, formatting, or extra dependencies never justify re-scaffolding. If the
+`detect` output says `needsRouting: true`, the app entry point does not use the registry:
+wire it (the `src/main.tsx` and `src/router.ts` templates show the pathname router)
+before creating presentations. Then resolve the target:
+
+- empty or standalone project → the target is the project root;
+- monorepo (`workspaces`, `pnpm-workspace.yaml`, or `packages/`|`apps/`) → a
+  self-contained app under `presentations/`, leaving the monorepo root untouched;
+- already inside a presentation app → use it.
+
+If nothing is missing, skip scaffolding. Otherwise scaffold only the missing anchors:
+
+```bash
+node <skill-dir>/scripts/scaffold.mjs bootstrap <project-dir> [--confirmed] [--install]
+```
+
+In a **non-empty** project, first tell the user the target directory and what will be
+added, wait for their confirmation, then pass `--confirmed` (the helper refuses with exit
+code 2 otherwise). Never overwrite files that already exist. Never assume dependencies
+are installed: pass `--install` (or run `npm install`) so React, Vite, TypeScript,
+Motion, Lucide, the ESLint stack, and Playwright are present, then run
+`npx playwright install chromium` if no browser is available.
+
+The scaffold is styling-framework neutral and ships zero visual defaults. Do not add
+Tailwind or another framework unless the host already uses one or the user asks.
+
+## 3. Generate or modify
+
+**Create.** Make a self-contained folder and register it:
+
+```bash
+node <skill-dir>/scripts/scaffold.mjs create <app-dir> <slug> "<Title>"
+```
+
+This copies `templates/presentation/` to `src/presentations/<slug>/` and adds one entry to
+`src/presentations/index.ts`. Existing presentations are never touched. Then rewrite:
+
+- `entities.ts` — the presentation's `layoutId` namespace (stable ids);
+- `steps/meta.ts` — per step: stable `id`, `era`, one-line `title`, paragraph `caption`;
+- `steps/Scene.tsx` — one persistent scene whose `payload` selects the active beat.
+  Steps sharing a `groupKey` keep one scene instance, so continuing entities morph;
+  only newcomers go in `<Appear>`. Build from the kit primitives (`Box`, `Label`,
+  `Arrow`, `Frame`, `Emphasis`, `SymbolChip`, `SceneLayer`) or raw `motion` elements
+  with stable `layoutId`s when coordinates are specific. The canvas is 880 × 380.
+- `style.css` — **all** visual styling lives here (plain CSS by default), targeting the
+  stable `data-presentation-*` and `data-variant` hooks. Never add styling to
+  `src/presentation-kit/`. Style the active progress dot / table-of-contents entry
+  (`[data-presentation-active="true"]`) so it is clearly distinct, and the attribution
+  (`[data-presentation-attribution]`, "made by and-scene", bottom-right) so it is legible.
+
+Intentional, readable overlaps are marked with `data-presentation-allow-overlap` on the
+smallest subtree that needs it.
+
+**Modify.** If the target presentation is missing or ambiguous, list the registered
+presentations and ask which one before changing anything. Then ask only about the
+requested changes (steps, entities, or style) and edit that presentation in place; do not
+re-walk the create flow.
+
+## 4. Self-verify before reporting done
+
+Never report success while any check fails; fix and re-run.
+
+1. `npm run build` — no type errors.
+2. Render the first step with no console or runtime errors (`npm run verify` builds, then steps every
+   registered presentation through all its steps and fails on any console or page error;
+   for a quick check of just yours use `node scripts/verify.mjs --slug <slug>`).
+3. Visual composition: run the project-local helper (prefer it over ad hoc scripts, which
+   would not resolve Playwright from the project):
+
+   ```bash
+   npm run inspect -- <slug>            # screenshots in inspection/<slug>/step-NN.png
+   ```
+
+   Look at the first step, the last step, and any dense or key steps — and at a narrow
+   viewport (`--viewport 480x800`) when the layout is responsive-sensitive. Confirm the
+   scene fits the canvas, intentional overlaps stay readable, and nothing collides with
+   the caption, progress dots, table of contents, or controls.
+4. Review every `WARN` line the helper prints (overlap, indistinct active chrome,
+   unpolished attribution). Fix accidental collisions and chrome polish in the
+   presentation's CSS; add `data-presentation-allow-overlap` only to overlaps that are
+   intentional and readable; re-run, and report any remaining advisory warnings honestly.
+
+## Quality bar
+
+Every presentation builds without type errors, renders its first step without errors,
+shows a caption per step, supports next/previous navigation, passes the visual check, and
+follows the evolving-scene model (stable entities, grouped scene, order-derived numbering).
diff --git a/skills/presentation/scripts/scaffold.mjs b/skills/presentation/scripts/scaffold.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..1ac342d4ded55b45c1acb29302ae51032c220091
--- /dev/null
+++ b/skills/presentation/scripts/scaffold.mjs
@@ -0,0 +1,290 @@
+#!/usr/bin/env node
+// Deterministic helper for the presentation skill: detect scaffold anchors, resolve the
+// scaffold target, materialize missing anchors, and create/register a presentation.
+// Templates are resolved relative to this file, never the caller's working directory.
+//
+//   node scaffold.mjs detect <dir>
+//   node scaffold.mjs bootstrap <dir> [--confirmed] [--install]
+//   node scaffold.mjs create <dir> <slug> "<Title>"
+import { spawnSync } from 'node:child_process'
+import {
+  cpSync, existsSync, mkdirSync, readFileSync, readdirSync, statSync, writeFileSync,
+} from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const SKILL_DIR = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+export const BOOTSTRAP = path.join(SKILL_DIR, 'templates', 'bootstrap')
+export const PRESENTATION = path.join(SKILL_DIR, 'templates', 'presentation')
+
+/** Files each contract anchor owns inside the bootstrap template (copied only when absent). */
+const ANCHOR_FILES = {
+  build: [
+    'package.json', 'package-lock.json', 'tsconfig.json', 'tsconfig.app.json', 'tsconfig.node.json',
+    'vite.config.ts', 'eslint.config.js', 'index.html', 'gitignore', 'public', 'src/index.css',
+  ],
+  kit: ['src/presentation-kit'],
+  // main.tsx is only created when absent; an existing entry point must be wired by hand.
+  index: ['src/presentations/index.ts', 'src/router.ts', 'src/Landing.tsx', 'src/main.tsx'],
+}
+
+/** The npm scripts we add (verify, inspect) run these, so they ship with any scaffolding. */
+const TOOLING = ['scripts']
+
+const KIT_EXPORT = /export\s+(?:default\s+)?(?:function|const|class)\s+Presentation\b/
+const REGISTRY_EXPORT = /export\s+(?:const|let)\s+presentations\b/
+
+export class ConfirmationRequired extends Error {
+  constructor(target, missing) {
+    super(
+      `"${target}" is not empty and is missing: ${missing.join(', ')}. ` +
+        'State this target to the user and re-run with --confirmed once they agree.',
+    )
+    this.target = target
+    this.missing = missing
+  }
+}
+
+const readJson = (file) => {
+  try {
+    return JSON.parse(readFileSync(file, 'utf8'))
+  } catch {
+    return null
+  }
+}
+
+/** Source files under dir/src (depth <= 3) whose text matches `pattern`. */
+function findSource(dir, pattern, depth = 3) {
+  const out = []
+  const visit = (d, level) => {
+    if (!existsSync(d) || level > depth) return
+    for (const name of readdirSync(d)) {
+      const p = path.join(d, name)
+      if (statSync(p).isDirectory()) {
+        if (name !== 'node_modules') visit(p, level + 1)
+      } else if (/\.(ts|tsx|js|jsx)$/.test(name) && pattern.test(readFileSync(p, 'utf8'))) out.push(p)
+    }
+  }
+  visit(path.join(dir, 'src'), 0)
+  return out
+}
+
+/** Directory holding the scene kit: any source exporting a `Presentation` component. */
+export function findKit(dir) {
+  const known = path.join(dir, 'src', 'presentation-kit')
+  const files = findSource(dir, KIT_EXPORT)
+  return files.map((f) => path.dirname(f)).find((d) => d === known) ?? (files[0] ? path.dirname(files[0]) : null)
+}
+
+/** The registry file: src/presentations/index.* or any source exporting `presentations`. */
+export function findIndex(dir) {
+  const known = ['index.ts', 'index.tsx'].map((f) => path.join(dir, 'src', 'presentations', f)).find(existsSync)
+  return known ?? findSource(dir, REGISTRY_EXPORT)[0] ?? null
+}
+
+/** Contract-level detection: what the file does matters, not what it is called or how it is formatted. */
+export function detectAnchors(dir) {
+  const pkg = readJson(path.join(dir, 'package.json'))
+  const deps = { ...pkg?.dependencies, ...pkg?.devDependencies }
+  return {
+    build: Boolean(pkg?.scripts?.build && deps.vite && deps.react && deps.typescript),
+    kit: findKit(dir) !== null,
+    index: findIndex(dir) !== null,
+  }
+}
+
+/** True when the app entry point does not mention the registry (it needs wiring by hand). */
+export function needsRouting(dir) {
+  const entry = ['main.tsx', 'main.jsx', 'main.ts', 'index.tsx'].map((f) => path.join(dir, 'src', f)).find(existsSync)
+  if (!entry) return true
+  return !/presentations|resolveRoute/.test(readFileSync(entry, 'utf8'))
+}
+
+export function isMonorepo(dir) {
+  const pkg = readJson(path.join(dir, 'package.json'))
+  return Boolean(
+    pkg?.workspaces ||
+      existsSync(path.join(dir, 'pnpm-workspace.yaml')) ||
+      ['packages', 'apps'].some((d) => existsSync(path.join(dir, d)) && statSync(path.join(dir, d)).isDirectory()),
+  )
+}
+
+export function isEmpty(dir) {
+  return !existsSync(dir) || readdirSync(dir).filter((n) => n !== '.git').length === 0
+}
+
+const missingOf = (anchors) => Object.keys(anchors).filter((k) => !anchors[k])
+
+/** Where the presentation app lives: this dir, an existing presentations/ app, or a new presentations/ in a monorepo. */
+export function resolveTarget(dir) {
+  const here = detectAnchors(dir)
+  if (here.kit || here.index) return { target: dir, reason: 'already a presentation app' }
+  const nested = path.join(dir, 'presentations')
+  const inner = detectAnchors(nested)
+  if (inner.kit || inner.index) return { target: nested, reason: 'existing presentations/ app' }
+  if (isMonorepo(dir)) return { target: nested, reason: 'monorepo: self-contained app under presentations/' }
+  return { target: dir, reason: isEmpty(dir) ? 'empty directory' : 'standalone project' }
+}
+
+export function detect(dir) {
+  const { target, reason } = resolveTarget(dir)
+  const anchors = detectAnchors(target)
+  return {
+    target,
+    reason,
+    anchors,
+    missing: missingOf(anchors),
+    kit: findKit(target),
+    index: findIndex(target),
+    needsRouting: needsRouting(target),
+    empty: isEmpty(dir),
+  }
+}
+
+function copyMissing(rel, target, tokens) {
+  const from = path.join(BOOTSTRAP, rel)
+  const to = path.join(target, rel === 'gitignore' ? '.gitignore' : rel)
+  if (!existsSync(from)) return []
+  const created = []
+  const visit = (src, dst) => {
+    if (statSync(src).isDirectory()) {
+      for (const name of readdirSync(src)) visit(path.join(src, name), path.join(dst, name))
+    } else if (!existsSync(dst)) {
+      mkdirSync(path.dirname(dst), { recursive: true })
+      if (/\.(json|ts|tsx|js|mjs|html|css|svg)$/.test(src) || path.basename(src) === 'gitignore') {
+        let text = readFileSync(src, 'utf8')
+        for (const [k, v] of Object.entries(tokens)) text = text.replaceAll(k, v)
+        writeFileSync(dst, text)
+      } else cpSync(src, dst)
+      created.push(path.relative(target, dst))
+    }
+  }
+  visit(from, to)
+  return created
+}
+
+/** Adds required dependencies and scripts that an existing package.json lacks. */
+function mergePackage(target) {
+  const file = path.join(target, 'package.json')
+  const pkg = readJson(file)
+  const tpl = readJson(path.join(BOOTSTRAP, 'package.json'))
+  if (!pkg) return []
+  const added = []
+  for (const field of ['dependencies', 'devDependencies']) {
+    pkg[field] ??= {}
+    for (const [name, version] of Object.entries(tpl[field])) {
+      const present = pkg.dependencies?.[name] ?? pkg.devDependencies?.[name]
+      if (!present) {
+        pkg[field][name] = version
+        added.push(name)
+      }
+    }
+  }
+  pkg.scripts ??= {}
+  for (const [name, cmd] of Object.entries(tpl.scripts)) {
+    if (!pkg.scripts[name]) {
+      pkg.scripts[name] = cmd
+      added.push(`script:${name}`)
+    }
+  }
+  if (added.length) writeFileSync(file, JSON.stringify(pkg, null, 2) + '\n')
+  return added
+}
+
+export function bootstrap(dir, { confirmed = false, install = false, runner = spawnSync } = {}) {
+  const { target } = resolveTarget(dir)
+  const found = detectAnchors(target)
+  const missing = missingOf(found)
+  if (!missing.length) return { target, created: [], missing, installed: false, needsRouting: needsRouting(target) }
+  if (!isEmpty(dir) && !confirmed) throw new ConfirmationRequired(target, missing)
+  const hadPackage = existsSync(path.join(target, 'package.json'))
+  const tokens = { __NAME__: path.basename(path.resolve(target)).toLowerCase().replace(/[^a-z0-9-]+/g, '-') || 'presentations' }
+  mkdirSync(target, { recursive: true })
+  const created = []
+  const files = missing.flatMap((anchor) =>
+    anchor === 'build' && hadPackage ? ANCHOR_FILES.build.filter((f) => !f.startsWith('package')) : ANCHOR_FILES[anchor],
+  )
+  for (const rel of [...files, ...TOOLING]) created.push(...copyMissing(rel, target, tokens))
+  // An existing package.json keeps its content; only missing dependencies and scripts are added.
+  const added = hadPackage ? mergePackage(target) : []
+  let installed = false
+  if (install) {
+    // Never assume dependencies are present: an existing node_modules may be incomplete.
+    const cmd = hadPackage ? ['install'] : ['ci']
+    const res = runner('npm', cmd, { cwd: target, stdio: 'inherit' })
+    if (res.status !== 0) throw new Error(`npm ${cmd[0]} failed in ${target}`)
+    installed = true
+  }
+  return { target, created, missing, addedDependencies: added, installed, needsRouting: needsRouting(target) }
+}
+
+/** Inserts a registry entry before the closing bracket of the `presentations` array, whatever its formatting. */
+export function registerEntry(source, entry) {
+  const decl = /\bpresentations\b[^=;]*=\s*\[/.exec(source)
+  if (!decl) throw new Error('could not find the `presentations` array in the registry')
+  let depth = 0
+  let close = -1
+  for (let i = decl.index + decl[0].length - 1; i < source.length; i++) {
+    if (source[i] === '[') depth++
+    else if (source[i] === ']' && --depth === 0) {
+      close = i
+      break
+    }
+  }
+  if (close < 0) throw new Error('the `presentations` array in the registry is not closed')
+  const before = source.slice(0, close).replace(/\s+$/, '')
+  const comma = /[[,]$/.test(before) ? '' : ','
+  return `${before}${comma}\n${entry}\n${source.slice(close)}`
+}
+
+const SLUG = /^[a-z0-9]+(-[a-z0-9]+)*$/
+
+export function createPresentation(appDir, slug, title) {
+  if (!SLUG.test(slug)) throw new Error(`invalid slug "${slug}": use lowercase letters, digits and hyphens`)
+  const indexFile = findIndex(appDir)
+  const kitDir = findKit(appDir)
+  if (!indexFile || !kitDir) throw new Error('no presentation index or scene kit found; run bootstrap first')
+  const dest = path.join(path.dirname(indexFile), slug)
+  const registry = readFileSync(indexFile, 'utf8')
+  if (existsSync(dest) || registry.includes(`slug: '${slug}'`)) throw new Error(`presentation "${slug}" already exists`)
+  const entry = `  {\n    slug: '${slug}',\n    title: ${JSON.stringify(title)},\n    load: () => import('./${slug}/Talk.tsx'),\n  },`
+  // Compute the registration first so a malformed registry fails before anything is written.
+  const updated = registerEntry(registry, entry)
+  const created = []
+  const visit = (src, dst) => {
+    if (statSync(src).isDirectory()) {
+      for (const name of readdirSync(src)) visit(path.join(src, name), path.join(dst, name))
+      return
+    }
+    const kit = path.relative(path.dirname(dst), kitDir).split(path.sep).join('/') + '/index.ts'
+    const tokens = { __SLUG__: slug, __TITLE_JSON__: JSON.stringify(title), __KIT__: kit }
+    let text = readFileSync(src, 'utf8')
+    for (const [k, v] of Object.entries(tokens)) text = text.replaceAll(k, v)
+    mkdirSync(path.dirname(dst), { recursive: true })
+    writeFileSync(dst, text)
+    created.push(path.relative(appDir, dst))
+  }
+  visit(PRESENTATION, dest)
+  writeFileSync(indexFile, updated)
+  return { slug, created, registered: path.relative(appDir, indexFile) }
+}
+
+function cli(argv) {
+  const [cmd, dir, ...rest] = argv
+  const flags = new Set(rest.filter((a) => a.startsWith('--')))
+  const args = rest.filter((a) => !a.startsWith('--'))
+  const target = path.resolve(dir ?? '.')
+  try {
+    let out
+    if (cmd === 'detect') out = detect(target)
+    else if (cmd === 'bootstrap') out = bootstrap(target, { confirmed: flags.has('--confirmed'), install: flags.has('--install') })
+    else if (cmd === 'create') out = createPresentation(target, args[0], args[1] ?? args[0])
+    else throw new Error('usage: scaffold.mjs detect|bootstrap|create <dir> [...]')
+    console.log(JSON.stringify(out, null, 2))
+  } catch (err) {
+    console.error(err.message)
+    process.exit(err instanceof ConfirmationRequired ? 2 : 1)
+  }
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) cli(process.argv.slice(2))
