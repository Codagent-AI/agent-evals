diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..fab8dcaa5a4661a4d7b5e51508d9ebf803c97c04
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,74 @@
+import { useEffect, useState } from 'react'
+import type { ReactNode } from 'react'
+import { WIDE_VIEWPORT } from './constants.ts'
+import { Footer } from './chrome/Footer.tsx'
+import type { AttributionOptions } from './chrome/Footer.tsx'
+import { Header } from './chrome/Header.tsx'
+import { Toc } from './chrome/Toc.tsx'
+import { Stage } from './Stage.tsx'
+import { usePresentationNav } from './usePresentationNav.ts'
+import type { Mode, Step } from './types.ts'
+
+export interface PresentationProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  title: string
+  initialMode?: Mode
+  designW?: number
+  designH?: number
+  attribution?: AttributionOptions | false
+  /** Host branding for the top-left header slot. Empty by default. */
+  brand?: ReactNode
+  /** Class for the root element so presentation-owned CSS can scope itself. */
+  className?: string
+}
+
+function useIsWide() {
+  const [wide, setWide] = useState(() => window.innerWidth >= WIDE_VIEWPORT)
+  useEffect(() => {
+    const onResize = () => setWide(window.innerWidth >= WIDE_VIEWPORT)
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return wide
+}
+
+export function Presentation<TPayload>({
+  steps,
+  title,
+  initialMode = 'browse',
+  designW,
+  designH,
+  attribution,
+  brand,
+  className,
+}: PresentationProps<TPayload>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const wide = useIsWide()
+  const step = steps[nav.index]
+
+  return (
+    <div
+      className={className}
+      data-presentation-root=""
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      style={{ display: 'flex', flexDirection: 'column', position: 'fixed', inset: 0 }}
+    >
+      <Header step={step} index={nav.index} mode={nav.mode} title={title} brand={brand} />
+      <div style={{ display: 'flex', flex: '1 1 0', minHeight: 0 }}>
+        {nav.mode === 'browse' && wide && <Toc steps={steps} index={nav.index} onGoTo={nav.goTo} />}
+        <Stage steps={steps} index={nav.index} mode={nav.mode} designW={designW} designH={designH} />
+      </div>
+      <Footer
+        steps={steps}
+        index={nav.index}
+        mode={nav.mode}
+        onGoTo={nav.goTo}
+        onPrev={nav.prev}
+        onNext={nav.next}
+        attribution={attribution}
+      />
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4b2c24c6fc060015715ab5fc29d5a5e265e7fc58
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,69 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, ENTER_T, EASE } from './constants.ts'
+import { useFitScale } from './useFitScale.ts'
+import type { Mode, Step } from './types.ts'
+
+interface StageProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  index: number
+  mode: Mode
+  designW?: number
+  designH?: number
+}
+
+/**
+ * Hosts the active step's Scene on a fixed design canvas scaled to fit.
+ * Steps sharing a groupKey (and Scene) keep one instance: only the payload changes,
+ * so continuing entities morph through layout projection instead of remounting.
+ */
+export function Stage<TPayload>({
+  steps,
+  index,
+  mode,
+  designW = DESIGN_W,
+  designH = DESIGN_H,
+}: StageProps<TPayload>) {
+  const { areaRef, scale } = useFitScale(mode, designW, designH)
+  const step = steps[index]
+  const key = `${step.groupKey ?? step.id}`
+  const { Scene } = step
+
+  return (
+    <div
+      ref={areaRef}
+      data-presentation-stage-area=""
+      style={{ position: 'relative', flex: '1 1 0', minWidth: 0, minHeight: 0, overflow: 'hidden' }}
+    >
+      <div
+        data-presentation-stage=""
+        data-presentation-scale={scale.toFixed(3)}
+        style={{
+          position: 'absolute',
+          left: '50%',
+          top: '50%',
+          width: designW,
+          height: designH,
+          transform: `translate(-50%, -50%) scale(${scale})`,
+          transformOrigin: 'center center',
+        }}
+      >
+        <LayoutGroup>
+          <AnimatePresence initial={false}>
+            <motion.div
+              key={key}
+              data-presentation-scene=""
+              data-presentation-group={key}
+              initial={{ opacity: 0 }}
+              animate={{ opacity: 1 }}
+              exit={{ opacity: 0, position: 'absolute', inset: 0 }}
+              transition={{ duration: ENTER_T, ease: EASE }}
+              style={{ position: 'relative', width: designW, height: designH }}
+            >
+              <Scene payload={step.payload} step={step} index={index} />
+            </motion.div>
+          </AnimatePresence>
+        </LayoutGroup>
+      </div>
+    </div>
+  )
+}
diff --git a/src/presentation-kit/chrome/Footer.tsx b/src/presentation-kit/chrome/Footer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a057a4e441bdff8660377acb52b42bc1332a6638
--- /dev/null
+++ b/src/presentation-kit/chrome/Footer.tsx
@@ -0,0 +1,66 @@
+import { ATTRIBUTION_HREF, ATTRIBUTION_LABEL } from '../constants.ts'
+import type { Mode, StepMeta } from '../types.ts'
+
+export interface AttributionOptions {
+  label?: string
+  href?: string
+}
+
+interface FooterProps {
+  steps: readonly StepMeta[]
+  index: number
+  mode: Mode
+  onGoTo: (index: number) => void
+  onPrev: () => void
+  onNext: () => void
+  /** Pass `false` to omit the default attribution. */
+  attribution?: AttributionOptions | false
+}
+
+export function Footer({ steps, index, mode, onGoTo, onPrev, onNext, attribution }: FooterProps) {
+  const step = steps[index]
+  const browse = mode === 'browse'
+  return (
+    <footer data-presentation-footer="" style={{ position: 'relative', flex: '0 0 auto' }}>
+      <h2 data-presentation-step-title="">{step.title}</h2>
+      {browse && (
+        <>
+          <p data-presentation-caption="">{step.caption}</p>
+          <nav data-presentation-nav="" aria-label="Steps">
+            <button type="button" data-presentation-prev="" onClick={onPrev} aria-label="Previous step">
+              Prev
+            </button>
+            <ol data-presentation-dots="" style={{ display: 'inline-flex' }}>
+              {steps.map((s, i) => (
+                <li key={s.id}>
+                  <button
+                    type="button"
+                    data-presentation-dot=""
+                    data-presentation-active={i === index ? 'true' : 'false'}
+                    aria-current={i === index ? 'step' : undefined}
+                    aria-label={`Step ${i + 1}: ${s.title}`}
+                    onClick={() => onGoTo(i)}
+                  />
+                </li>
+              ))}
+            </ol>
+            <button type="button" data-presentation-next="" onClick={onNext} aria-label="Next step">
+              Next
+            </button>
+          </nav>
+        </>
+      )}
+      {attribution !== false && (
+        <a
+          data-presentation-attribution=""
+          href={attribution?.href ?? ATTRIBUTION_HREF}
+          target="_blank"
+          rel="noreferrer"
+          style={{ position: 'absolute', right: 0, bottom: 0 }}
+        >
+          {attribution?.label ?? ATTRIBUTION_LABEL}
+        </a>
+      )}
+    </footer>
+  )
+}
diff --git a/src/presentation-kit/chrome/Header.tsx b/src/presentation-kit/chrome/Header.tsx
