diff --git a/skills/presentation/templates/presentation/style.css b/skills/presentation/templates/presentation/style.css
new file mode 100644
index 0000000000000000000000000000000000000000..70a2a7d42b1cd5e8eab83185683ae8c034b0162d
--- /dev/null
+++ b/skills/presentation/templates/presentation/style.css
@@ -0,0 +1,65 @@
+/* Presentation-owned styling. The scene kit ships no visual defaults, so palette,
+   typography, spacing, and component looks all belong here (plain CSS by default).
+   Target the stable kit hooks: [data-presentation-*] and [data-variant]. */
+.__SLUG__ {
+  background: #ffffff;
+  color: #1a1a1a;
+  font-family: system-ui, sans-serif;
+}
+
+.__SLUG__ [data-presentation-header],
+.__SLUG__ [data-presentation-footer] {
+  padding: 12px 24px;
+}
+
+.__SLUG__ [data-presentation-dots],
+.__SLUG__ [data-presentation-toc] ol {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.__SLUG__ [data-presentation-nav] {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+/* Make the active step unmistakable. */
+.__SLUG__ [data-presentation-dot] {
+  width: 12px;
+  height: 12px;
+  margin: 0 4px;
+  padding: 0;
+  border: 1px solid #888;
+  border-radius: 50%;
+  background: transparent;
+}
+.__SLUG__ [data-presentation-dot][data-presentation-active='true'] {
+  background: #1a1a1a;
+  border-color: #1a1a1a;
+}
+.__SLUG__ [data-presentation-toc-entry][data-presentation-active='true'] {
+  font-weight: 700;
+}
+
+/* Attribution: keep it small but legible. */
+.__SLUG__ [data-presentation-attribution] {
+  right: 24px !important;
+  bottom: 8px !important;
+  font-size: 12px;
+  color: #555;
+  text-decoration: none;
+}
+
+.__SLUG__ [data-presentation-node='box'] {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  box-sizing: border-box;
+  border: 1.5px solid #888;
+  border-radius: 8px;
+}
+.__SLUG__ [data-presentation-node='arrow'] {
+  color: #555;
+}
