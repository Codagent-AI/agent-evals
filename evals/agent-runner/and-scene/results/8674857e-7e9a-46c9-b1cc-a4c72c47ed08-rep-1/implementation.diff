diff --git a/skills/presentation/templates/bootstrap/scripts/README.md b/skills/presentation/templates/bootstrap/scripts/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..acb54b0868f9c2299d8e91e2636f95ed274b5ca3
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/README.md
@@ -0,0 +1,14 @@
+`verify.mjs` builds the entire app, starts Vite's production preview on an ephemeral
+IPv4 loopback port, validates registration and each step, and returns a non-zero
+exit code with phase/step diagnostics on failure. Root default selects the strict
+nine-step canonical sample; `--slug` selects another registered presentation.
+Chromium must be installed with `npx playwright install chromium` first.
+
+`inspect-presentation.mjs` shares the preview lifecycle, captures settled desktop
+screenshots per step, and writes `report.json` with timestamps and advisory
+warnings. It does not fail merely because a visual warning exists. It fails on
+operational errors such as an unreachable route or stalled transition. It does
+not replace independent visual review.
+
+Keep these scripts and the bootstrap snapshot byte-aligned. Do not invoke the
+inspection helper to replace the separately authorized acceptance workflow.
diff --git a/skills/presentation/templates/bootstrap/scripts/browser-tools.mjs b/skills/presentation/templates/bootstrap/scripts/browser-tools.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..342db18605dc6f338f923b7b32c8efb933aae43f
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/browser-tools.mjs
@@ -0,0 +1,80 @@
+import { spawn } from 'node:child_process'
+import { createServer } from 'node:net'
+import { once } from 'node:events'
+import { setTimeout as delay } from 'node:timers/promises'
+import { chromium } from 'playwright'
+export const HOST = '127.0.0.1'
+export const SETTLE_MS = 850
+export function command(bin, args, cwd = process.cwd()) {
+  return new Promise((resolve, reject) => {
+    const child = spawn(bin, args, { cwd, stdio: 'inherit' })
+    child.on('error', reject)
+    child.on('exit', code => code === 0 ? resolve() : reject(new Error(`${bin} ${args.join(' ')} failed (${code})`)))
+  })
+}
+async function freePort() {
+  const server = createServer(); server.listen(0, HOST); await once(server, 'listening')
+  const port = server.address().port
+  await new Promise(resolve => server.close(resolve)); return port
+}
+export async function productionPreview(cwd = process.cwd()) {
+  const port = await freePort()
+  const url = `http://${HOST}:${port}`
+  const child = spawn(process.execPath, ['node_modules/vite/bin/vite.js', 'preview', '--host', HOST, '--port', String(port), '--strictPort'], { cwd, stdio: ['ignore', 'pipe', 'pipe'] })
+  let output = ''; let spawnError
+  child.stdout.on('data', data => { output += data })
+  child.stderr.on('data', data => { output += data })
+  child.on('error', error => { spawnError = error })
+  const close = async () => {
+    if (child.exitCode !== null || child.signalCode) return
+    const exited = once(child, 'exit')
+    child.kill('SIGTERM')
+    const force = setTimeout(() => child.kill('SIGKILL'), 2000)
+    try { await exited } finally { clearTimeout(force) }
+  }
+  try {
+    for (let i = 0; i < 200; i++) {
+      if (spawnError) throw spawnError
+      if (child.exitCode !== null) throw new Error(`Preview exited: ${output}`)
+      try { const response = await fetch(url, { signal: AbortSignal.timeout(500) }); if (response.ok) { console.log(`Preview ready ${url} (pid ${child.pid})`); return { url, close } } } catch { /* retry startup */ }
+      await delay(50)
+    }
+    throw new Error(`Preview readiness failed at ${url}: ${output}`)
+  } catch (error) { await close(); throw error }
+}
+export async function withBrowser(cwd, run) {
+  const preview = await productionPreview(cwd)
+  let server; let browser
+  const stop = () => { void server?.close(); void preview.close() }
+  process.once('SIGINT', stop); process.once('SIGTERM', stop)
+  try {
+    // Own the Chromium process explicitly so cleanup can be verified by PID,
+    // rather than mistaking a disconnected client for a terminated browser.
+    server = await chromium.launchServer({ headless: true })
+    console.log(`Browser ready (pid ${server.process().pid})`)
+    browser = await chromium.connect(server.wsEndpoint())
+    return await run(browser, preview.url)
+  } finally {
+    try {
+      try { await browser?.close() } finally {
+        await server?.close()
+        if (server) console.log(`Browser stopped (pid ${server.process().pid})`)
+      }
+    } finally {
+      await preview.close()
+      process.removeListener('SIGINT', stop); process.removeListener('SIGTERM', stop)
+      console.log(`Preview stopped ${preview.url}`)
+    }
+  }
+}
+export function options(args) {
+  const result = {}
+  for (let i = 0; i < args.length; i++) {
+    if (args[i].startsWith('--')) { const key = args[i].slice(2); if (args[i + 1] && !args[i + 1].startsWith('--')) result[key] = args[++i]; else result[key] = true }
+    else if (!result.slug) result.slug = args[i]
+  }
+  return result
+}
+export async function stepIndex(page, index, timeout = 5000) {
+  await page.locator(`[data-presentation][data-step-index="${index}"]`).waitFor({ timeout })
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/diagnostics.mjs b/skills/presentation/templates/bootstrap/scripts/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..2043c547ec55987789088d8cf9524552e1095823
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/diagnostics.mjs
@@ -0,0 +1,43 @@
+export function overlaps(a, b) {
+  return Math.min(a.x + a.width, b.x + b.width) - Math.max(a.x, b.x) > 1 && Math.min(a.y + a.height, b.y + b.height) - Math.max(a.y, b.y) > 1
+}
+export function diagnostics({ texts, controls, attribution }, step) {
+  const warnings = []
+  for (let i = 0; i < texts.length; i++) for (let j = i + 1; j < texts.length; j++) {
+    const a = texts[i], b = texts[j]
+    if (!a.allowed && !b.allowed && overlaps(a, b)) warnings.push(`Step ${step}: overlap between "${a.name}" and "${b.name}"`)
+  }
+  for (const kind of ['progress', 'toc']) {
+    const group = controls.filter(c => c.kind === kind)
+    const active = group.find(c => c.active)
+    if (active && group.some(c => !c.active && c.signature === active.signature)) warnings.push(`Step ${step}: indistinct active ${kind} chrome`)
+  }
+  if (!attribution || attribution.fontSize < 11 || attribution.browserDefault) warnings.push(`Step ${step}: unpolished attribution; style [data-presentation-attribution]`)
+  return warnings
+}
+// This function runs inside Chromium. Keep it closed over browser globals only.
+export function collectDiagnostics() {
+  const visible = element => {
+    const style = getComputedStyle(element)
+    const rect = element.getBoundingClientRect()
+    return style.display !== 'none' && style.visibility !== 'hidden' && Number(style.opacity) !== 0 && rect.width > 0 && rect.height > 0 && element.checkVisibility({ checkOpacity: true, checkVisibilityCSS: true })
+  }
+  const texts = [...document.querySelectorAll('[data-presentation] button,[data-presentation-attribution]')].filter(visible).map(element => {
+    const r = element.getBoundingClientRect()
+    return { name: element.textContent.trim(), x: r.x, y: r.y, width: r.width, height: r.height, allowed: !!element.closest('[data-presentation-allow-overlap]') }
+  })
+  const walker = document.createTreeWalker(document.querySelector('[data-presentation]'), NodeFilter.SHOW_TEXT)
+  while (walker.nextNode()) {
+    const node = walker.currentNode; const parent = node.parentElement
+    if (!node.textContent.trim() || ['STYLE', 'SCRIPT'].includes(parent.tagName) || !visible(parent) || parent.closest('button,[data-presentation-attribution]')) continue
+    const range = document.createRange(); range.selectNodeContents(node)
+    for (const r of range.getClientRects()) if (r.width && r.height) texts.push({ name: node.textContent.trim(), x: r.x, y: r.y, width: r.width, height: r.height, allowed: !!parent.closest('[data-presentation-allow-overlap]') })
+  }
+  const controls = [...document.querySelectorAll('[data-presentation-progress-step],[data-presentation-toc-entry]')].filter(visible).map(element => {
+    const s = getComputedStyle(element)
+    return { kind: element.hasAttribute('data-presentation-progress-step') ? 'progress' : 'toc', active: element.getAttribute('data-presentation-active') === 'true', signature: [s.color, s.backgroundColor, s.fontWeight, s.borderColor, s.boxShadow, s.opacity, s.outlineStyle, s.transform].join('|') }
+  })
+  const a = document.querySelector('[data-presentation-attribution]')
+  const s = a && getComputedStyle(a)
+  return { texts, controls, attribution: a && visible(a) ? { fontSize: parseFloat(s.fontSize), browserDefault: ['rgb(0, 0, 238)', 'rgb(85, 26, 139)'].includes(s.color) && s.textDecorationLine.includes('underline') } : null }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
new file mode 100644
