diff --git a/skills/presentation/templates/presentation/talk.css.tmpl b/skills/presentation/templates/presentation/talk.css.tmpl
new file mode 100644
index 0000000000000000000000000000000000000000..3f4ef030814fe92c3d9008a7fa71bb12df185d11
