index 0000000000000000000000000000000000000000..981935107a6506d07faff680b37e1abc41120467
--- /dev/null
+++ b/scripts/verify.mjs
@@ -0,0 +1,195 @@
+#!/usr/bin/env node
+// Build the whole app, check the reference sample, then render every registered presentation
+// step by step in Chromium against a production preview on 127.0.0.1.
+import { existsSync, readFileSync } from 'node:fs'
+import path from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { chromium } from 'playwright'
+import { HOST, projectRoot, readRegistrySlugs, resolvePort, runBuild, withPreview } from './lib.mjs'
+
+const STEP_TIMEOUT_MS = 5000
+const SETTLE_MS = 150
+
+/** Normative reference sample: `scripts/reference-sample.json` -> { slug, steps: [{ era, title, caption }] }. */
+export function loadReferenceSample(root) {
+  const file = path.join(root, 'scripts/reference-sample.json')
+  return existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : null
+}
+
+/** Problems found comparing the sample's step data with the normative table (empty when it matches). */
+export function compareSteps(actual, expected) {
+  const problems = []
+  if (actual.length !== expected.length) {
+    problems.push(`expected ${expected.length} steps but found ${actual.length}`)
+  }
+  expected.forEach((want, i) => {
+    const got = actual[i]
+    if (!got) return problems.push(`step ${i + 1} is missing`)
+    for (const key of ['era', 'title', 'caption']) {
+      if (got[key] !== want[key]) {
+        problems.push(`step ${i + 1} ${key} is ${JSON.stringify(got[key])}, expected ${JSON.stringify(want[key])}`)
+      }
+    }
+  })
+  return problems
+}
+
+/** Check that the reference sample is registered, present, and matches the normative table in order. */
+export async function checkSample(root) {
+  const reference = loadReferenceSample(root)
+  if (!reference) return []
+  const { slug } = reference
+  if (!readRegistrySlugs(root).includes(slug)) return [`reference sample "${slug}" is not registered in src/presentations/index.ts`]
+  const meta = path.join(root, 'src/presentations', slug, 'meta.ts')
+  if (!existsSync(meta)) return [`reference sample "${slug}" has no ${path.relative(root, meta)}`]
+  let steps
+  try {
+    steps = (await import(`${pathToFileURL(meta).href}?t=${Date.now()}`)).STEP_META
+  } catch (err) {
+    return [`reference sample metadata could not be loaded: ${err.message}`]
+  }
+  if (!Array.isArray(steps)) return ['reference sample metadata does not export STEP_META']
+  return compareSteps(steps, reference.steps)
+}
+
+/** Collects console errors and uncaught page errors, attributing each to the current step. */
+export function createErrorCollector() {
+  let step = 0
+  const errors = []
+  return {
+    errors,
+    setStep(index) {
+      step = index
+    },
+    attach(page) {
+      page.on('console', (msg) => {
+        if (msg.type() === 'error') errors.push({ step, message: `console.error: ${msg.text()}` })
+      })
+      page.on('pageerror', (err) => {
+        errors.push({ step, message: `uncaught page error: ${err?.message ?? err}` })
+      })
+    },
+  }
+}
+
+const readAttr = (page, name) => page.evaluate((n) => document.querySelector(`[${n}]`)?.getAttribute(n) ?? null, name)
+
+/**
+ * Open one presentation route and advance through every step with ArrowRight.
+ * Returns failures as { step, message }; step is the zero-based index the failure belongs to.
+ */
+export async function verifyRoute(page, url, collector, expected) {
+  collector.setStep(0)
+  await page.goto(url)
+  try {
+    await page.waitForSelector('[data-step-count]', { timeout: STEP_TIMEOUT_MS })
+  } catch {
+    return [...collector.errors, { step: 0, message: 'presentation chrome ([data-step-count]) did not render' }]
+  }
+  const count = Number(await readAttr(page, 'data-step-count'))
+  const failures = []
+  if (!(count > 0)) return [{ step: 0, message: `invalid step count ${count}` }]
+  if (expected && expected.length !== count) {
+    failures.push({ step: 0, message: `expected ${expected.length} steps but chrome reports ${count}` })
+  }
+  const seen = []
+  for (let i = 0; i < count; i++) {
+    collector.setStep(i)
+    if (i > 0) {
+      await page.keyboard.press('ArrowRight')
+      try {
+        await page.waitForFunction(
+          (want) => document.querySelector('[data-step-index]')?.getAttribute('data-step-index') === String(want),
+          i,
+          { timeout: STEP_TIMEOUT_MS },
+        )
+      } catch {
+        const at = await readAttr(page, 'data-step-index')
+        failures.push({ step: i, message: `transition did not advance to step index ${i} (still at ${at})` })
+        break
+      }
+    }
+    seen.push(Number(await readAttr(page, 'data-step-index')))
+    const rendered = await page.evaluate(() => ({
+      mode: document.querySelector('[data-presentation-mode]')?.getAttribute('data-presentation-mode'),
+      title: document.querySelector('[data-presentation-title]')?.textContent ?? '',
+      caption: document.querySelector('[data-presentation-caption]')?.textContent ?? '',
+    }))
+    const want = expected?.[i]
+    if (want && rendered.title !== want.title) {
+      failures.push({ step: i, message: `rendered title ${JSON.stringify(rendered.title)}, expected ${JSON.stringify(want.title)}` })
+    }
+    if (rendered.mode === 'browse') {
+      if (!rendered.caption.trim()) failures.push({ step: i, message: 'no caption rendered' })
+      else if (want && rendered.caption !== want.caption) {
+        failures.push({ step: i, message: `rendered caption ${JSON.stringify(rendered.caption)}, expected ${JSON.stringify(want.caption)}` })
+      }
+    }
+    await page.waitForTimeout(SETTLE_MS)
+  }
+  if (!failures.length && seen.join() !== Array.from({ length: count }, (_, i) => i).join()) {
+    failures.push({ step: 0, message: `step indices observed out of order: ${seen.join(',')}` })
+  }
+  return [...collector.errors, ...failures].sort((a, b) => a.step - b.step)
+}
+
+async function main() {
+  const root = projectRoot()
+  const log = (line) => console.log(`[verify] ${line}`)
+  const fail = (phase, details) => {
+    for (const line of details) console.error(`[verify] ${phase} FAILED: ${line}`)
+    console.error(`VERIFY FAILED: ${phase}`)
+    process.exit(1)
+  }
+
+  log('build: npm run build')
+  const build = await runBuild(root)
+  if (build.code !== 0) {
+    fail('build', [`npm run build exited ${build.code}`, ...build.output.trim().split('\n').slice(-25)])
+  }
+  log('build: ok')
+
+  const sampleProblems = await checkSample(root)
+  if (sampleProblems.length) fail('sample', sampleProblems)
+  const reference = loadReferenceSample(root)
+  log(reference ? `sample: ${reference.slug} matches ${reference.steps.length} normative steps` : 'sample: no reference sample configured')
+
+  const slugs = readRegistrySlugs(root)
+  if (!slugs.length) fail('render', ['no presentations are registered in src/presentations/index.ts'])
+
+  const port = await resolvePort()
+  const failures = []
+  try {
+    await withPreview(root, port, async ({ baseUrl }) => {
+      log(`preview: ${baseUrl}`)
+      const browser = await chromium.launch()
+      try {
+        for (const slug of slugs) {
+          const url = `${baseUrl}/${slug}`
+          const page = await browser.newPage()
+          const collector = createErrorCollector()
+          collector.attach(page)
+          log(`render: opening ${url}`)
+          const expected = reference?.slug === slug ? reference.steps : undefined
+          const found = await verifyRoute(page, url, collector, expected)
+          for (const f of found) failures.push(`${url} at step index ${f.step}: ${f.message}`)
+          if (!found.length) log(`render: ${slug} ok`)
+          await page.close()
+        }
+      } finally {
+        await browser.close()
+      }
+    })
+  } catch (err) {
+    failures.push(`preview/browser error: ${err.stack ?? err.message}`)
+  }
+  if (failures.length) fail('render', failures)
+  console.log(`VERIFY PASSED: build, sample, render (${slugs.length} presentation(s) at ${HOST})`)
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  main().catch((err) => {
+    console.error(`VERIFY FAILED: unexpected error: ${err.stack ?? err}`)
+    process.exit(1)
+  })
+}
diff --git a/skills/presentation/SKILL.md b/skills/presentation/SKILL.md
new file mode 100644
index 0000000000000000000000000000000000000000..8cbe263e93fff80fee7317bffe852de54e446d63
--- /dev/null
+++ b/skills/presentation/SKILL.md
@@ -0,0 +1,142 @@
+---
+name: presentation
+description: Creates or modifies a browser-based presentation that works as one evolving diagram (entities appear, move, connect and re-label across named steps). Use when asked to make, build, edit, or extend a presentation, talk, or slide-style explainer from a topic.
+---
+
+# Presentation
+
+A presentation is **one scene moving through named steps**, not a deck of separate slides. Entities
+keep a stable id, so between steps they move, resize, re-label, enter and leave in place. The
+reusable engine is the scene kit; each presentation supplies only its own entities, steps, and look.
+
+This file lives at `skills/presentation/SKILL.md`. Resolve **every template path relative to the
+directory of this file** (`<skill-dir>`), never relative to the working directory:
+
+- `<skill-dir>/templates/bootstrap/` — a complete app snapshot (build setup, scene kit, presentation index, scripts, lock file)
+- `<skill-dir>/templates/presentation/` — the files of one new presentation
+- `<skill-dir>/scripts/scaffold.mjs` — `detect`, `scaffold` and `new` helpers that apply those templates
+
+Run the helper with its absolute path, for example `node <skill-dir>/scripts/scaffold.mjs detect .`.
+
+## 1. Decide: create or modify
+
+If the user wants to change an existing presentation, follow **Modify** (step 6). Otherwise continue.
+
+## 2. Gather
+
+Ask the user questions **one at a time**, in this order, and wait for each answer:
+
+1. the **topic** (and audience, if it changes the story);
+2. the **visual style** (mood, palette, typography, density);
+3. for each step: its **content** (what is said) and its **visual description** (which entities appear, move, connect or change).
+
+Rules:
+
+- Do not invent details the user can still supply. Ask for what is missing instead of assuming it.
+- Skip any question the prompt already answers. If the prompt already contains the topic, the style
+  and every step's details, **proceed to build without further questions**.
+- The user decides how deep to go. Offer "build with what we have": if they choose it after giving only
+  some details, generate from what was captured, state the assumptions you made, and invite iteration.
+  There is no completeness gate.
+- For a key or complex step you may draw an **ASCII mockup** of its layout and ask whether it matches
+  before building. Use it only where it helps; do not mock up every step.
+
+## 3. Resolve the target and scaffold what is missing
+
+Run `node <skill-dir>/scripts/scaffold.mjs detect <project-dir>`. It reports the three contract anchors
+and the resolved target. Detection is by capability, not by byte-identical files, so renamed files,
+formatting differences and extra dependencies are fine and must not trigger re-scaffolding:
+
+1. **Build setup** — a Vite + React + TypeScript app with a working `npm run build`.
+2. **Scene kit** — the presentation-agnostic engine: the `Step`/`Scene` contract, the stage that mounts
+   the active step and runs entity morphs, present/browse navigation, chrome (captions, table of
+   contents) and the fixed-canvas fit scale.
+3. **Presentation index** — the registry mapping each presentation to its own route.
+
+Target resolution:
+
+- Empty directory or standalone (non-monorepo) project: scaffold at the **root**.
+- Monorepo (`workspaces` in `package.json`, `pnpm-workspace.yaml`, or a `packages/` or `apps/`
+  directory): scaffold a self-contained app in a **`presentations/`** directory; never mutate the
+  monorepo root's infrastructure.
+- Already inside a presentation app (kit or index present): use it and scaffold only the missing anchors.
+
+Then:
+
+- **All anchors present:** skip scaffolding and go to step 4.
+- **Some missing:** scaffold only the missing anchors (and their dependencies); never overwrite files or
+  dependency entries that exist.
+- **None present:** scaffold everything.
+- **Non-empty project:** before any write or install — including when only the build setup is missing —
+  state the resolved target and what will be added, and **wait for the user's confirmation**. Skip the
+  confirmation only for an empty directory and for an already-scaffolded project.
+
+Scaffold with `node <skill-dir>/scripts/scaffold.mjs scaffold <project-dir> [--confirm] [--install]`
+(`--confirm` only after the user agreed). Do not assume any dependency is installed: the scaffold installs
+`react`, `react-dom`, `motion`, `lucide-react`, `vite`, `@vitejs/plugin-react`, `typescript` with
+`@types/react`, `@types/react-dom` and `@types/node`, the eslint stack, and `playwright` (render checks;
+run `npx playwright install chromium` if no browser is available). Where a file such as
+`src/main.tsx` already exists it is kept; wire in `AppRouter` by hand.
+
+The scaffold is **styling-framework-neutral** and ships no presentation styles. Never add Tailwind or
+another framework unless the host project already uses one or the user asks for it.
+
+## 4. Create a presentation
+
+Run `node <skill-dir>/scripts/scaffold.mjs new <target> <slug> "<Title>"`. This writes a self-contained
+folder `src/presentations/<slug>/` and appends **one** line to the registry in
+`src/presentations/index.ts` (append only; never edit other presentations' files or entries).
+The presentation is then served at `/<slug>`.
+
+The generated `talk.css` is only a plain starter; replace it with the look the user asked for. Fill in the generated files:
+
+- `meta.ts` — each step's stable `id`, `era` label, one-line `title`, and browse `caption`.
+- `entities.ts` — the presentation's `layoutId` namespace (stable entity ids).
+- `steps/` — the Scene(s) composed from kit primitives (`Box`, `Label`, `Arrow`, `Frame`, `Emphasis`,
+  `SymbolChip`, `Appear`, `SceneLayer`), or raw `motion` elements with stable `layoutId`s when coordinates are
+  literal. Successive states of one diagram share a `groupKey` and Scene component so the scene
+  stays mounted and entities morph. Wrap **only newcomers** in `Appear`; persisting entities keep their
+  position and id. Preserve intentional overlap or stacking rather than flattening it, and mark a readable,
+  intentional overlap with `data-presentation-allow-overlap` on that subtree only.
+- `Talk.tsx` and `talk.css` — the entry component and the presentation's **own plain CSS**. The kit has zero
+  visual defaults, so the look (colors, fonts, spacing, borders, shadows, buttons) lives in `talk.css`
+  (or the host's CSS). Style the stable hooks: `[data-presentation-active]` on progress and table-of-
+  contents items, `[data-presentation-attribution]`, `[data-presentation-node]`, and the others. Never add
+  visual styling to `src/presentation-kit/`.
+
+## 5. Self-verify before reporting done
+
+Check the presentation you created or modified (its own route, not only the reference sample):
+
+1. `npm run build` — no type or build errors.
+2. Render check — at least the first step renders with no runtime or console errors; `npm run verify`
+   renders every registered presentation through every step and is the full completion gate.
+3. Visual composition — run the project-local helper `npm run inspect -- <slug>` (prefer it over ad hoc
+   scripts; if it is unavailable, write any temporary Playwright script **under the project root** so
+   dependencies resolve locally). It writes settled screenshots to `.inspection/<slug>/`. Look at the
+   **first step, the last step, and every dense or key step**; for a responsive-sensitive presentation
+   also run it with `--viewport 390x844`. Confirm important content fits the fixed canvas, intentional
+   overlaps stay readable, and content does not collide with the caption, progress, table of contents or
+   navigation.
+4. Review every `WARN` the helper prints. Fix accidental collisions, give the active progress and
+   table-of-contents entries a visibly distinct style, and style the attribution so it is legible
+   (at least 12px, not browser-default). Mark an overlap with `data-presentation-allow-overlap` only when it is
+   genuinely intentional and readable; never mark an accidental collision or the whole scene to silence a
+   warning. Re-run the helper afterwards.
+
+If any check fails, **fix it and re-check**. Never report success while a build, render or visual check is
+failing. Report the final results and any remaining advisory warnings accurately.
+
+Every presentation must build clean, render its first step without errors, show a caption per step,
+support next/previous navigation, pass the visual check, and follow the evolving-scene model.
+
+## 6. Modify an existing presentation
+
+1. If the user did not name the target clearly, **list the existing presentations** (from
+   `src/presentations/index.ts`) and ask which to modify. Change nothing — no edits, scaffold writes, or
+   installs — until it is identified.
+2. Run the anchor check of step 3 (and any confirmed repair) before editing, exactly as for create.
+3. Ask only about the requested changes (steps, entities, or style) — do not re-walk the full create flow.
+4. Edit that presentation in place; leave other presentations untouched apart from necessary
+   registration or verification artifacts.
+5. Run the self-verification of step 5 on the modified route.
diff --git a/skills/presentation/scripts/scaffold.mjs b/skills/presentation/scripts/scaffold.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f89b8d389dbcee6ad18e35003200d2b50d55d27e
--- /dev/null
+++ b/skills/presentation/scripts/scaffold.mjs
@@ -0,0 +1,308 @@
+#!/usr/bin/env node
+// Scaffold helper for the presentation skill. Templates are located relative to this file, so the
+// helper works from any working directory.
+//
+//   node scaffold.mjs detect   <dir>                       report anchors and the resolved target
+//   node scaffold.mjs scaffold <dir> [--confirm] [--install]   add whatever anchors are missing
+//   node scaffold.mjs new      <target> <slug> <title>     create and register a presentation
+import { spawnSync } from 'node:child_process'
+import {
+  cpSync,
+  existsSync,
+  mkdirSync,
+  readdirSync,
+  readFileSync,
+  statSync,
+  writeFileSync,
+} from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+
+export const SKILL_DIR = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+export const BOOTSTRAP_DIR = path.join(SKILL_DIR, 'templates/bootstrap')
+export const PRESENTATION_TEMPLATE_DIR = path.join(SKILL_DIR, 'templates/presentation')
+export const REGISTRY_MARKER = '// presentations:end'
+export const REGISTRY_SKELETON = `import type { ComponentType } from 'react'
+
+export interface PresentationEntry {
+  slug: string
+  title: string
+  load: () => Promise<{ default: ComponentType }>
+}
+
+/** Explicit registry: adding a presentation is a new folder plus one line here. */
+export const presentations: PresentationEntry[] = [
+  ${REGISTRY_MARKER}
+]
+`
+
+/** Template files (relative to templates/bootstrap) each contract anchor is responsible for. */
+const ANCHOR_FILES = {
+  build: [
+    'package.json',
+    'package-lock.json',
+    '.gitignore',
+    'index.html',
+    'vite.config.ts',
+    'tsconfig.json',
+    'tsconfig.app.json',
+    'tsconfig.node.json',
+    'eslint.config.js',
+    'scripts',
+  ],
+  kit: ['src/presentation-kit', 'scripts'],
+  index: [
+    'scripts',
+    'src/main.tsx',
+    'src/AppRouter.tsx',
+    'src/Landing.tsx',
+    'src/route.ts',
+    'src/index.css',
+    'src/presentations',
+  ],
+}
+
+const readJson = (file) => JSON.parse(readFileSync(file, 'utf8'))
+
+/** Every file under `target` (or `target` itself when it is a file). */
+function sourceFiles(target) {
+  if (!existsSync(target)) return []
+  if (statSync(target).isFile()) return [target]
+  return readdirSync(target, { recursive: true, withFileTypes: true })
+    .filter((e) => e.isFile())
+    .map((e) => path.join(e.parentPath, e.name))
+}
+
+/** True when the directory has no entries other than `.git`. */
+export function isEmptyDir(dir) {
+  return !existsSync(dir) || readdirSync(dir).every((name) => name === '.git')
+}
+
+function codeFiles(dir) {
+  return sourceFiles(path.join(dir, 'src')).filter((f) => /\.(ts|tsx|js|jsx)$/.test(f))
+}
+
+/**
+ * Where the working kit and registry live. Detection is by capability, not file names:
+ * - kit: a module exporting a `Presentation` component that renders a stage (not a placeholder),
+ *   a `Step` contract carrying a `Scene`, and, in the same directory tree, AnimatePresence-based
+ *   hosting, keyboard navigation and a fit scale.
+ * - index: a module whose entries pair a `slug` with a dynamic `import()` loader.
+ */
+export function locateAnchors(dir) {
+  const files = codeFiles(dir)
+  const text = new Map(files.map((f) => [f, readFileSync(f, 'utf8')]))
+  const presentationFile = files.find(
+    (f) => /export (default )?(function|const) Presentation\b/.test(text.get(f)) && /<Stage|<AnimatePresence/.test(text.get(f)),
+  )
+  let kitDir = null
+  if (presentationFile) {
+    const candidate = path.dirname(presentationFile)
+    const inKit = files.filter((f) => f.startsWith(candidate + path.sep) || f === presentationFile)
+    const all = inKit.map((f) => text.get(f)).join('\n')
+    const capable =
+      /(interface|type)\s+Step\b[^;]*?\bScene\b/s.test(all) &&
+      /<AnimatePresence/.test(all) &&
+      /addEventListener\(\s*['"]keydown['"]/.test(all) &&
+      /scale\(\$\{|scale\(/.test(all)
+    if (capable) kitDir = candidate
+  }
+  const registry = files.find((f) => /slug\s*:/.test(text.get(f)) && /load\s*:\s*\(\)\s*=>\s*import\(/.test(text.get(f))) ?? null
+  return { kitDir, registry }
+}
+
+/** The three contract anchors, detected by capability rather than by exact file names. */
+export function detectAnchors(dir) {
+  const pkgFile = path.join(dir, 'package.json')
+  let build = false
+  if (existsSync(pkgFile)) {
+    const pkg = readJson(pkgFile)
+    const deps = { ...pkg.dependencies, ...pkg.devDependencies }
+    build = Boolean(pkg.scripts?.build && deps.vite && deps.react && deps.typescript)
+  }
+  const { kitDir, registry } = locateAnchors(dir)
+  return { build, kit: kitDir !== null, index: registry !== null }
+}
+
+/** A monorepo has package.json workspaces, pnpm-workspace.yaml, or a packages/ or apps/ directory. */
+export function isMonorepo(dir) {
+  const pkgFile = path.join(dir, 'package.json')
+  if (existsSync(pkgFile) && readJson(pkgFile).workspaces) return true
+  if (existsSync(path.join(dir, 'pnpm-workspace.yaml'))) return true
+  return ['packages', 'apps'].some((d) => existsSync(path.join(dir, d)) && statSync(path.join(dir, d)).isDirectory())
+}
+
+/**
+ * Where the presentation app lives. An existing presentation app (any anchor besides the build
+ * setup) wins; then a monorepo gets a self-contained `presentations/` app; otherwise the root.
+ */
+export function resolveTarget(dir) {
+  const here = detectAnchors(dir)
+  if (here.kit || here.index) return { target: dir, reason: 'existing presentation app' }
+  const nested = path.join(dir, 'presentations')
+  if (existsSync(nested)) {
+    const found = detectAnchors(nested)
+    if (found.build || found.kit || found.index) return { target: nested, reason: 'existing presentation app' }
+  }
+  if (isMonorepo(dir)) return { target: nested, reason: 'monorepo: self-contained app under presentations/' }
+  return { target: dir, reason: isEmptyDir(dir) ? 'empty directory' : 'standalone project' }
+}
+
+/** What scaffolding would do in `target`: missing anchors, files to create, and files kept. */
+export function planScaffold(target) {
+  const anchors = detectAnchors(target)
+  const missing = Object.keys(anchors).filter((name) => !anchors[name])
+  const create = []
+  const keep = []
+  const hasPackage = existsSync(path.join(target, 'package.json'))
+  for (const name of missing) {
+    for (const entry of ANCHOR_FILES[name]) {
+      for (const file of sourceFiles(path.join(BOOTSTRAP_DIR, entry))) {
+        const rel = path.relative(BOOTSTRAP_DIR, file)
+        // A project that already has a package.json keeps it and gets its dependencies merged.
+        if (rel === 'package-lock.json' && hasPackage) continue
+        if (existsSync(path.join(target, rel))) keep.push(rel)
+        else create.push(rel)
+      }
+    }
+  }
+  return { anchors, missing, create: [...new Set(create)].sort(), keep: [...new Set(keep)].sort() }
+}
+
+/** Add missing dependencies and scripts from the bootstrap package.json without touching existing ones. */
+export function mergePackage(target) {
+  const file = path.join(target, 'package.json')
+  const wanted = readJson(path.join(BOOTSTRAP_DIR, 'package.json'))
+  const pkg = readJson(file)
+  const added = []
+  for (const field of ['dependencies', 'devDependencies', 'scripts']) {
+    pkg[field] ??= {}
+    for (const [name, value] of Object.entries(wanted[field] ?? {})) {
+      const present = field === 'scripts' ? name in pkg[field] : name in { ...pkg.dependencies, ...pkg.devDependencies }
+      if (!present) {
+        pkg[field][name] = value
+        added.push(`${field}.${name}`)
+      }
+    }
+  }
+  if (added.length) writeFileSync(file, `${JSON.stringify(pkg, null, 2)}\n`)
+  return added
+}
+
+/** Copy missing template files into the target; existing files are never overwritten. */
+export function applyScaffold(target, plan = planScaffold(target)) {
+  mkdirSync(target, { recursive: true })
+  const hadPackage = existsSync(path.join(target, 'package.json'))
+  for (const rel of plan.create) {
+    const dest = path.join(target, rel)
+    mkdirSync(path.dirname(dest), { recursive: true })
+    cpSync(path.join(BOOTSTRAP_DIR, rel), dest, { errorOnExist: true, force: false })
+  }
+  const merged = hadPackage && plan.missing.length ? mergePackage(target) : []
+  return { created: plan.create, kept: plan.keep, merged }
+}
+
+const SLUG = /^[a-z0-9]+(-[a-z0-9]+)*$/
+
+/** Escape text for a JS/TS string literal in either quote style (also safe inside a CSS comment). */
+export function escapeTitle(title) {
+  return title
+    .replace(/\\/g, '\\\\')
+    .replace(/'/g, "\\'")
+    .replace(/"/g, '\\"')
+    .replace(/[\r\n\u2028\u2029]+/g, ' ')
+    .replace(/\*\//g, '* /')
+}
+
+const posix = (p) => p.split(path.sep).join('/')
+const relativeImport = (from, to) => {
+  const rel = posix(path.relative(from, to))
+  return rel.startsWith('.') ? rel : `./${rel}`
+}
+
+/**
+ * Create <registry dir>/<slug> from the presentation templates and append one registry line.
+ * The registry and kit are located by capability, so renamed layouts get correct import paths.
+ */
+export function createPresentation(target, { slug, title }, { neutralStyle = false } = {}) {
+  if (!SLUG.test(slug)) throw new Error(`invalid slug "${slug}": use lowercase words joined by hyphens`)
+  const located = locateAnchors(target)
+  const registry = located.registry ?? path.join(target, 'src/presentations/index.ts')
+  const kitDir = located.kitDir ?? path.join(target, 'src/presentation-kit')
+  const folder = path.join(path.dirname(registry), slug)
+  if (existsSync(folder)) throw new Error(`presentation "${slug}" already exists`)
+  mkdirSync(path.dirname(registry), { recursive: true })
+  if (!existsSync(registry)) writeFileSync(registry, REGISTRY_SKELETON)
+  const source = readFileSync(registry, 'utf8')
+  if (!source.includes(REGISTRY_MARKER)) {
+    throw new Error(`registry ${path.relative(target, registry)} has no "${REGISTRY_MARKER}" marker; add the entry for "${slug}" by hand`)
+  }
+  const kitImport = relativeImport(folder, kitDir)
+  const steps = relativeImport(path.join(folder, 'steps'), kitDir)
+  const fill = (text, file) =>
+    text
+      .replaceAll('__KIT__', () => (file.includes(`steps${path.sep}`) ? steps : kitImport))
+      .replaceAll('__SLUG__', () => slug)
+      .replaceAll('__TITLE__', () => escapeTitle(title))
+  for (const file of sourceFiles(PRESENTATION_TEMPLATE_DIR)) {
+    const rel = path.relative(PRESENTATION_TEMPLATE_DIR, file).replace(/\.tmpl$/, '')
+    const dest = path.join(folder, rel)
+    mkdirSync(path.dirname(dest), { recursive: true })
+    const content = neutralStyle && rel === 'talk.css' ? '/* Presentation styles go here; the scaffold ships none. */\n' : fill(readFileSync(file, 'utf8'), rel)
+    writeFileSync(dest, content)
+  }
+  const entry = `  {\n    slug: '${slug}',\n    title: ${JSON.stringify(title)},\n    load: () => import('./${slug}/Talk'),\n  },\n  ${REGISTRY_MARKER}`
+  writeFileSync(registry, source.replace(REGISTRY_MARKER, () => entry))
+  return folder
+}
+
+/**
+ * `npm ci` only when the lock file came from the template and package.json was not merged;
+ * a merged or pre-existing package.json needs `npm install` to refresh its lock data.
+ */
+export function installCommand(result) {
+  return result.created.includes('package-lock.json') && !result.merged.length ? 'ci' : 'install'
+}
+
+function main(argv) {
+  const [command, dir, ...rest] = argv
+  if (command === 'detect' && dir) {
+    const root = path.resolve(dir)
+    const { target, reason } = resolveTarget(root)
+    const plan = planScaffold(target)
+    console.log(JSON.stringify({ target, reason, anchors: plan.anchors, missing: plan.missing, empty: isEmptyDir(root) }, null, 2))
+    return 0
+  }
+  if (command === 'scaffold' && dir) {
+    const root = path.resolve(dir)
+    const { target, reason } = resolveTarget(root)
+    const plan = planScaffold(target)
+    if (!plan.missing.length) {
+      console.log(`scaffold: ${target} already has every anchor; nothing to do`)
+      return 0
+    }
+    if (!isEmptyDir(root) && !rest.includes('--confirm')) {
+      console.log(`scaffold: would add [${plan.missing.join(', ')}] to ${target} (${reason}).`)
+      console.log(`  create: ${plan.create.length} file(s); keep existing: ${plan.keep.join(', ') || 'none'}`)
+      console.log('scaffold: nothing written. Ask the user to confirm this target, then re-run with --confirm.')
+      return 3
+    }
+    const result = applyScaffold(target, plan)
+    console.log(`scaffold: wrote ${result.created.length} file(s) to ${target}; merged ${result.merged.join(', ') || 'no package entries'}`)
+    if (rest.includes('--install')) {
+      const install = spawnSync('npm', [installCommand(result)], { cwd: target, stdio: 'inherit' })
+      return install.status ?? 1
+    }
+    return 0
+  }
+  if (command === 'new' && dir && rest.length >= 2) {
+    console.log(`created ${createPresentation(path.resolve(dir), { slug: rest[0], title: rest.slice(1).join(' ') })}`)
+    return 0
+  }
+  console.error('usage: scaffold.mjs detect <dir> | scaffold <dir> [--confirm] [--install] | new <target> <slug> <title>')
+  return 2
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  process.exitCode = main(process.argv.slice(2))
+}
