new file mode 100644
index 0000000000000000000000000000000000000000..4d3470fba5473be28f1d7d4f322ca533fe13a75c
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,34 @@
+import {
+  DESIGN_H,
+  DESIGN_W,
+  MIN_SCALE,
+  STAGE_LAYOUT,
+  TOC_MIN_WIDTH,
+  TOC_WIDTH,
+  type Mode,
+} from './constants'
+import { useViewportSize } from './useViewport'
+
+export function isTocVisible(mode: Mode, viewportWidth: number): boolean {
+  return mode === 'browse' && viewportWidth >= TOC_MIN_WIDTH
+}
+
+/** One uniform factor fitting the design canvas into the viewport minus the mode's chrome. */
+export function computeFitScale(
+  viewportWidth: number,
+  viewportHeight: number,
+  mode: Mode,
+  designW = DESIGN_W,
+  designH = DESIGN_H,
+): number {
+  const { top, bottom, side } = STAGE_LAYOUT[mode]
+  const toc = isTocVisible(mode, viewportWidth) ? TOC_WIDTH : 0
+  const availW = viewportWidth - toc - side * 2
+  const availH = viewportHeight - top - bottom
+  return Math.max(MIN_SCALE, Math.min(availW / designW, availH / designH))
+}
+
+export function useFitScale(mode: Mode, designW = DESIGN_W, designH = DESIGN_H): number {
+  const { width, height } = useViewportSize()
+  return computeFitScale(width, height, mode, designW, designH)
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..77c39c186c0b0a002c492dfba9d16ee6fefda829
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,92 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { SWIPE_MIN_PX, type Mode } from './constants'
+
+const INTERACTIVE =
+  'a[href], button, input, select, textarea, summary, [contenteditable]:not([contenteditable="false"]), [role="button"], [role="link"], [role="tab"], [role="menuitem"]'
+
+export const clampIndex = (index: number, count: number): number =>
+  Math.max(0, Math.min(count - 1, index))
+
+/** +1 advances (swipe left), -1 goes back (swipe right), 0 ignores the gesture. */
+export function swipeStep(dx: number, dy: number): -1 | 0 | 1 {
+  if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) <= Math.abs(dy)) return 0
+  return dx < 0 ? 1 : -1
+}
+
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE) !== null
+}
+
+export interface NavOptions {
+  initialMode?: Mode
+  initialIndex?: number
+}
+
+export function usePresentationNav(count: number, options: NavOptions = {}) {
+  const [rawIndex, setIndex] = useState(options.initialIndex ?? 0)
+  const [mode, setMode] = useState<Mode>(options.initialMode ?? 'browse')
+  const countRef = useRef(count)
+  useEffect(() => {
+    countRef.current = count
+  }, [count])
+  const index = clampIndex(rawIndex, count)
+
+  const goTo = useCallback(
+    (target: number) => setIndex(clampIndex(target, countRef.current)),
+    [],
+  )
+  const move = useCallback(
+    (delta: number) => setIndex((i) => clampIndex(clampIndex(i, countRef.current) + delta, countRef.current)),
+    [],
+  )
+  const next = useCallback(() => move(1), [move])
+  const prev = useCallback(() => move(-1), [move])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'browse' ? 'present' : 'browse')), [])
+
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey) return
+      if (isInteractiveTarget(event.target)) return
+      switch (event.key) {
+        case 'ArrowRight':
+        case ' ':
+        case 'PageDown':
+          next()
+          break
+        case 'ArrowLeft':
+        case 'PageUp':
+          prev()
+          break
+        case 'p':
+        case 'P':
+          toggleMode()
+          break
+        default:
+          return
+      }
+      event.preventDefault()
+    }
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (event: TouchEvent) => {
+      const touch = event.changedTouches[0]
+      start = touch ? { x: touch.clientX, y: touch.clientY } : null
+    }
+    const onTouchEnd = (event: TouchEvent) => {
+      const touch = event.changedTouches[0]
+      if (!start || !touch) return
+      const delta = swipeStep(touch.clientX - start.x, touch.clientY - start.y)
+      start = null
+      if (delta !== 0) move(delta)
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart)
+    window.addEventListener('touchend', onTouchEnd)
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [next, prev, move, toggleMode])
+
+  return { index, mode, goTo, next, prev, toggleMode }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useViewport.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useViewport.ts
new file mode 100644
index 0000000000000000000000000000000000000000..63c7f68987296e60cd4608ab0dbd4878a33da50e
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useViewport.ts
@@ -0,0 +1,19 @@
+import { useEffect, useState } from 'react'
+
+export interface ViewportSize {
+  width: number
+  height: number
+}
+
+export function useViewportSize(): ViewportSize {
+  const [size, setSize] = useState<ViewportSize>(() => ({
+    width: window.innerWidth,
+    height: window.innerHeight,
+  }))
+  useEffect(() => {
+    const onResize = () => setSize({ width: window.innerWidth, height: window.innerHeight })
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return size
+}
