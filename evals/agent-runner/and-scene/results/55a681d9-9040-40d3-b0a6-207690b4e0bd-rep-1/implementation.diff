@@ -0,0 +1,79 @@
+import type { CSSProperties, ReactNode } from 'react'
+import { DESIGN_H, DESIGN_W, type Mode } from './constants'
+import { Attribution, type AttributionOptions } from './chrome/Attribution'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { Toc } from './chrome/Toc'
+import { Stage } from './Stage'
+import type { Step } from './types'
+import { isTocVisible, useFitScale } from './useFitScale'
+import { usePresentationNav } from './usePresentationNav'
+import { useViewportSize } from './useViewport'
+
+export interface PresentationProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  title: string
+  initialMode?: Mode
+  /** Host-provided top-left brand; the kit renders none by default. */
+  brand?: ReactNode
+  /** Pass `false` to drop the default "made by and-scene" attribution. */
+  attribution?: AttributionOptions | false
+  designWidth?: number
+  designHeight?: number
+  className?: string
+  style?: CSSProperties
+}
+
+export function Presentation<TPayload>({
+  steps,
+  title,
+  initialMode = 'browse',
+  brand,
+  attribution,
+  designWidth = DESIGN_W,
+  designHeight = DESIGN_H,
+  className,
+  style,
+}: PresentationProps<TPayload>) {
+  const { index, mode, goTo, next, prev } = usePresentationNav(steps.length, { initialMode })
+  const scale = useFitScale(mode, designWidth, designHeight)
+  const { width } = useViewportSize()
+  const step = steps[index]
+  if (!step) return null
+  return (
+    <div
+      data-presentation-root=""
+      data-presentation-title-text={title}
+      data-presentation-mode={mode}
+      data-presentation-step-index={index}
+      data-presentation-step-count={steps.length}
+      data-step-index={index}
+      data-step-count={steps.length}
+      className={className}
+      style={{
+        position: 'relative',
+        display: 'flex',
+        flexDirection: 'column',
+        width: '100%',
+        height: '100dvh',
+        overflow: 'hidden',
+        ...style,
+      }}
+    >
+      <Header mode={mode} step={step} index={index} count={steps.length} brand={brand} />
+      <div style={{ flex: 1, minHeight: 0, display: 'flex' }}>
+        {isTocVisible(mode, width) && <Toc steps={steps} index={index} onGoTo={goTo} />}
+        <Stage
+          steps={steps}
+          index={index}
+          mode={mode}
+          scale={scale}
+          designWidth={designWidth}
+          designHeight={designHeight}
+        />
+      </div>
+      <Footer mode={mode} steps={steps} index={index} onGoTo={goTo} onPrev={prev} onNext={next} />
+      {attribution !== false && <Attribution {...attribution} />}
+    </div>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c86434a186163037923e85d588d209893aa68b44
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
@@ -0,0 +1,96 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { useState } from 'react'
+import { EntryContext } from './entryContext'
+import { DESIGN_H, DESIGN_W, ENTER_T, type Mode } from './constants'
+import { sceneKey } from './sceneKey'
+import type { Step } from './types'
+
+interface StageProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  index: number
+  mode: Mode
+  scale: number
+  designWidth?: number
+  designHeight?: number
+}
+
+const fill = { position: 'absolute', left: 0, top: 0, width: '100%', height: '100%' } as const
+
+/**
+ * Hosts the active step's Scene on the fixed design canvas. The canvas is scaled by one factor;
+ * the whole stage is re-keyed when mode or scale changes so that change is a plain re-render and
+ * never an entity layout morph.
+ */
+export function Stage<TPayload>({
+  steps,
+  index,
+  mode,
+  scale,
+  designWidth = DESIGN_W,
+  designHeight = DESIGN_H,
+}: StageProps<TPayload>) {
+  if (!steps[index]) return null
+  return (
+    <div
+      data-presentation-stage=""
+      style={{ flex: 1, minWidth: 0, minHeight: 0, display: 'flex', alignItems: 'center', justifyContent: 'center' }}
+    >
+      <Canvas
+        key={`${mode}:${scale.toFixed(3)}`}
+        steps={steps}
+        index={index}
+        mode={mode}
+        scale={scale}
+        designWidth={designWidth}
+        designHeight={designHeight}
+      />
+    </div>
+  )
+}
+
+function Canvas<TPayload>({ steps, index, mode, scale, designWidth, designHeight }: Required<StageProps<TPayload>>) {
+  // The canvas is re-keyed on mode/scale change; scenes first shown by that re-mount do not animate.
+  const [mountIndex] = useState(index)
+  const step = steps[index]
+  const { Scene } = step
+  return (
+    <div
+      data-presentation-canvas-frame=""
+      data-presentation-scale={scale.toFixed(3)}
+      style={{ position: 'relative', width: designWidth * scale, height: designHeight * scale }}
+    >
+      <div
+        data-presentation-canvas=""
+        data-presentation-canvas-width={designWidth}
+        data-presentation-canvas-height={designHeight}
+        style={{
+          position: 'absolute',
+          left: 0,
+          top: 0,
+          width: designWidth,
+          height: designHeight,
+          transform: `scale(${scale})`,
+          transformOrigin: '0 0',
+        }}
+      >
+        <LayoutGroup>
+          <AnimatePresence initial={false}>
+            <motion.div
+              key={sceneKey(step)}
+              data-presentation-scene=""
+              style={fill}
+              initial={{ opacity: 0 }}
+              animate={{ opacity: 1 }}
+              exit={{ opacity: 0 }}
+              transition={{ duration: ENTER_T }}
+            >
+              <EntryContext value={index !== mountIndex}>
+                <Scene payload={step.payload} step={step} index={index} count={steps.length} mode={mode} />
+              </EntryContext>
+            </motion.div>
+          </AnimatePresence>
+        </LayoutGroup>
+      </div>
+    </div>
+  )
+}
