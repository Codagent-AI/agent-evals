+{
+  "title": "How to Use This Skill to Make a Presentation",
+  "steps": [
+    {
+      "id": "beat-1",
+      "era": "the ask",
+      "title": "You have a topic",
+      "caption": "It starts with you, a topic, and mild overconfidence."
+    },
+    {
+      "id": "beat-2",
+      "era": "the ask",
+      "title": "The skill interviews you",
+      "caption": "One question at a time: the topic, the look, then each beat of the story."
+    },
+    {
+      "id": "beat-3",
+      "era": "the gathering",
+      "title": "Answers become steps",
+      "caption": "Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next."
+    },
+    {
+      "id": "beat-4",
+      "era": "the gathering",
+      "title": "The deck grows",
+      "caption": "Same shapes, new beats. Every answer extends the story without redrawing it."
+    },
+    {
+      "id": "beat-5",
+      "era": "the gathering",
+      "title": "You set the depth",
+      "caption": "Spell out every step, or sketch a few and see how it looks. You hold the gate."
+    },
+    {
+      "id": "beat-6",
+      "era": "the build",
+      "title": "It assembles the scene",
+      "caption": "Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph."
+    },
+    {
+      "id": "beat-7",
+      "era": "the build",
+      "title": "It checks its own work",
+      "caption": "Before saying done, it builds and renders every step — and fixes what breaks."
+    },
+    {
+      "id": "beat-8",
+      "era": "the loop",
+      "title": "Changed your mind? Loop it.",
+      "caption": "Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch."
+    },
+    {
+      "id": "beat-9",
+      "era": "the reveal",
+      "title": "You're looking at one",
+      "caption": "This presentation was built exactly this way. Thanks for watching."
+    }
+  ]
+}
diff --git a/scripts/sync-bootstrap.mjs b/scripts/sync-bootstrap.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..51a9ab0fc6634d3cce4609d77295edf574c22d16
--- /dev/null
+++ b/scripts/sync-bootstrap.mjs
@@ -0,0 +1,28 @@
+// Release snapshot maintenance. Never run this against a consumer project.
+import { cp, mkdir, readFile, writeFile, rm } from 'node:fs/promises'
+const target = 'skills/presentation/templates/bootstrap'
+await rm(target, { recursive: true, force: true })
+await mkdir(`${target}/src/presentations/welcome`, { recursive: true })
+for (const file of ['index.html', 'vite.config.ts', 'tsconfig.json', 'tsconfig.app.json', 'tsconfig.node.json', 'eslint.config.js', 'package-lock.json']) await cp(file, `${target}/${file}`)
+for (const file of ['main.tsx','Router.tsx','Landing.tsx']) await cp(`src/${file}`,`${target}/src/${file}`)
+await writeFile(`${target}/src/index.css`, '/* Host styling belongs here. The bootstrap intentionally has no visual defaults. */\n')
+await cp('src/presentation-kit', `${target}/src/presentation-kit`, { recursive: true })
+await mkdir(`${target}/scripts`, { recursive: true })
+for (const file of ['verify.mjs','inspect-presentation.mjs','browser.mjs','diagnostics.mjs','reference.json']) await cp(`scripts/${file}`, `${target}/scripts/${file}`)
+const pkg=JSON.parse(await readFile('package.json','utf8'))
