diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..8a019965998aa41fceec7baea905865b728cb557
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,21 @@
+import { TOC_MIN_WIDTH } from './constants'
+import { Stage } from './Stage'
+import { Header } from './chrome/Header'
+import { Footer } from './chrome/Footer'
+import { Toc } from './chrome/Toc'
+import { usePresentationNav } from './usePresentationNav'
+import { useViewport } from './useFitScale'
+import type { PresentationOptions, Step } from './types'
+export function Presentation<T>({ steps, title, initialMode = 'browse', brand, className }: PresentationOptions & { steps: readonly Step<T>[] }) {
+  const nav = usePresentationNav(steps.length, initialMode), { width } = useViewport()
+  if (!steps.length) throw new Error('A presentation needs at least one step')
+  const step = steps[nav.index]
+  return <main className={className} aria-label={title} data-presentation-root="" data-presentation-mode={nav.mode} data-step-count={steps.length} data-presentation-step-count={steps.length} data-step-index={nav.index} data-presentation-step-index={nav.index} data-step-id={step.id} data-step-era={step.era} style={{ position: 'relative', minHeight: '100dvh', overflow: 'hidden' }} {...nav.touch}>
+    <Header title={step.title} marker={`${String(nav.index + 1).padStart(2, '0')} / ${steps.length} · ${step.era}`} brand={brand} />
+    {nav.mode === 'browse' && width >= TOC_MIN_WIDTH && <Toc steps={steps} index={nav.index} jump={nav.jump} />}
+    <Stage step={step} mode={nav.mode} />
+    <Footer steps={steps} index={nav.index} mode={nav.mode} next={nav.next} prev={nav.prev} jump={nav.jump} />
+    <button data-presentation-mode-toggle="" onClick={nav.toggleMode} aria-label="Toggle presentation mode">{nav.mode === 'browse' ? 'Present' : 'Browse'}</button>
+    <a data-presentation-attribution="" href="https://github.com/Codagent-AI/and-scene" target="_blank" rel="noopener noreferrer" style={{ position: 'absolute', right: 16, bottom: 12 }}>made by and-scene</a>
+  </main>
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..3a8145a15b42b35cba7029cec6bc99212fe7796f
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,21 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { useId } from 'react'
+import type { ComponentType } from 'react'
+const sceneIds = new WeakMap<object, number>()
+let nextSceneId = 0
+function sceneId<T>(Scene: ComponentType<T>) {
+  if (!sceneIds.has(Scene)) sceneIds.set(Scene, nextSceneId++)
+  return sceneIds.get(Scene)
+}
+import { DESIGN_H, DESIGN_W, STAGE_LAYOUT, ENTER_T } from './constants'
+import type { Mode, Step } from './types'
+import { useFitScale } from './useFitScale'
+export function Stage<T>({ step, mode }: { step: Step<T>; mode: Mode }) {
+  const scale = useFitScale(mode), id = useId()
+  const Scene = step.Scene
+  return <div data-presentation-stage="" style={{ position: 'absolute', top: STAGE_LAYOUT[mode].top, bottom: STAGE_LAYOUT[mode].bottom, left: 0, right: 0, display: 'grid', placeItems: 'center', pointerEvents: 'none' }}>
+    <div data-presentation-canvas="" style={{ width: DESIGN_W, height: DESIGN_H, position: 'absolute', left: '50%', top: '50%', transform: `translate(-50%, -50%) scale(${scale})`, pointerEvents: 'auto' }}>
+      <LayoutGroup id={id}><AnimatePresence mode="sync"><motion.div key={`${sceneId(step.Scene)}:${step.groupKey ?? step.id}`} data-presentation-scene="" style={{ position: 'absolute', inset: 0 }} initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} transition={{ duration: ENTER_T }}><Scene payload={step.payload} /></motion.div></AnimatePresence></LayoutGroup>
+    </div>
+  </div>
+}
