diff --git a/scripts/browser.mjs b/scripts/browser.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c5c205246a723d663a90481e0789df1d06fbefc8
--- /dev/null
+++ b/scripts/browser.mjs
@@ -0,0 +1,87 @@
+import { spawn } from 'node:child_process'
+import { createServer } from 'node:net'
+import { chromium } from 'playwright'
+export const HOST = '127.0.0.1'
+export const SETTLE_MS = 1200
+export function command(command, args, cwd = process.cwd()) {
+ return new Promise((resolve, reject) => {
+  const child = spawn(command, args, { cwd, stdio: 'inherit' })
+  child.on('error', reject)
+  child.on('exit', code => code === 0 ? resolve() : reject(new Error(`${command} exited ${code}`)))
+ })
+}
+async function freePort() {
+ const server = createServer()
+ await new Promise((resolve, reject) => { server.once('error', reject); server.listen(0, HOST, resolve) })
+ const port = server.address().port
+ await new Promise(resolve => server.close(resolve))
+ return port
+}
+export async function withPreview(run) {
+ let browser, browserServer, child
+ const port = await freePort(), url = `http://${HOST}:${port}`
+ try {
+  child = spawn(process.execPath, ['node_modules/vite/bin/vite.js', 'preview', '--host', HOST, '--port', String(port), '--strictPort'], { stdio: ['ignore', 'pipe', 'pipe'] })
+  console.log(`PREVIEW started pid=${child.pid}`)
+  let output = '', exited = false
+  child.stdout.on('data', d => { output += d }); child.stderr.on('data', d => { output += d })
+  child.on('exit', () => { exited = true })
+  let ready = false
+  for (let i = 0; i < 100; i++) {
+   if (exited) throw new Error(`preview startup failed: ${output}`)
+   try { if ((await fetch(url)).ok) { ready = true; break } } catch { /* wait for binding */ }
+   await new Promise(r => setTimeout(r, 100))
+  }
+  if (!ready) throw new Error(`preview readiness failed: ${url}`)
+  console.log(`PREVIEW host=${HOST} readiness=${url} pid=${child.pid}`)
+  browserServer = await chromium.launchServer({ headless: true, host: HOST, args: ['--no-sandbox'] })
+  console.log(`BROWSER started pid=${browserServer.process().pid}`)
+  browser = await chromium.connect(browserServer.wsEndpoint())
+  return await run(browser, url)
+ } finally {
+  try {
+   try { if (browser) await browser.close() } finally {
+    if (browserServer) {
+     await browserServer.close()
+     console.log(`BROWSER stopped pid=${browserServer.process().pid}`)
+    }
+   }
+  } finally {
+  if (child && child.exitCode === null) {
+   const closed = new Promise(resolve => child.once('exit', resolve))
+   child.kill('SIGTERM')
+   const timer = setTimeout(() => child.kill('SIGKILL'), 2000)
+   await closed; clearTimeout(timer)
+  }
+  if (child) console.log(`PREVIEW stopped pid=${child.pid}`)
+  }
+ }
+}
+export function monitorErrors(page) {
+ const errors = []
+ let step = 0
+ page.on('console', message => { if (message.type() === 'error') errors.push(`step ${step}: ${message.text()}`) })
+ page.on('pageerror', error => errors.push(`step ${step}: ${error.message}`))
+ return { setStep(index) { step = index }, check() { if (errors.length) throw new Error(`render: ${errors.join('; ')}`) } }
+}
+export async function stepCount(page) {
+ const root = page.locator('[data-presentation-root]')
+ await root.waitFor({ timeout: 5000 })
+ const count = Number(await root.getAttribute('data-step-count'))
+ if (!Number.isInteger(count) || count < 1) throw new Error('sample: invalid step count')
+ return count
+}
+export async function advance(page, index) {
+ await page.keyboard.press('ArrowRight')
+ try { await page.waitForFunction(i => document.querySelector('[data-presentation-root]')?.getAttribute('data-step-index') === String(i), index, { timeout: 3000 }) }
+ catch { throw new Error(`transition: step ${index} failed to advance`) }
+}
+export function validateReference(actual, expected) {
+ if (!Array.isArray(actual) || actual.length !== expected.length) throw new Error('sample: incorrect step count')
+ const ids = new Set()
+ actual.forEach((s, i) => {
+  if (!s || !s.id || ids.has(s.id)) throw new Error(`sample: malformed or duplicate metadata at step ${i}`)
+  ids.add(s.id)
+  for (const key of ['id', 'era', 'title', 'caption']) if (typeof s[key] !== 'string' || !s[key].trim() || s[key] !== expected[i][key]) throw new Error(`sample: wrong ${key} at step ${i}`)
+ })
+}
diff --git a/scripts/diagnostics.mjs b/scripts/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..98a55e529cdcfe37ffcd033c9b2f80093d068fdb
--- /dev/null
+++ b/scripts/diagnostics.mjs
@@ -0,0 +1,45 @@
+export function diagnose({ text, controls = [], chrome, attribution }, step) {
+ const warnings = []
+ const warn = message => warnings.push(`step ${step}: ${message}`)
+ const visible = [...text, ...controls].filter(t => t.visible && !t.allowed)
+ for (let i = 0; i < visible.length; i++) for (let j = i + 1; j < visible.length; j++) {
+  const a = visible[i], b = visible[j]
+  if (a.owner !== undefined && (a.owner === b.owner || a.ancestors?.includes(b.owner) || b.ancestors?.includes(a.owner))) continue
+  if (Math.min(a.right, b.right) - Math.max(a.left, b.left) > 1 && Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top) > 1) warn(`overlap ${a.id} / ${b.id}`)
+ }
+ for (const kind of ['progress', 'toc-entry']) {
+  const controls = chrome.filter(c => c.kind === kind), active = controls.find(c => c.active)
+  if (active && controls.some(c => !c.active && c.signature === active.signature)) warn(`indistinct active ${kind} [data-presentation-${kind}]`)
+ }
+ if (!attribution || attribution.size < 12 || (attribution.family.includes('Times New Roman') && attribution.color === 'rgb(0, 0, 238)')) warn('unpolished attribution: style [data-presentation-attribution]')
+ return warnings
+}
+// Runs in the page: text-node ranges avoid counting an ancestor and its child twice.
+export function collectDiagnostics() {
+ const root = document.querySelector('[data-presentation-root]')
+ const owners = new Map()
+ const owner = el => { if (!owners.has(el)) owners.set(el, owners.size); return owners.get(el) }
+ function participant(el, r, id) {
+  const ancestors = []
+  for (let parent = el.parentElement; parent; parent = parent.parentElement) ancestors.push(owner(parent))
+  return { id, owner: owner(el), ancestors, visible: el.checkVisibility({ checkOpacity: true, checkVisibilityCSS: true }) && Number(getComputedStyle(el).opacity) !== 0 && r.width > 0 && r.height > 0, allowed: !!el.closest('[data-presentation-allow-overlap]'), left: r.left, right: r.right, top: r.top, bottom: r.bottom }
+ }
+ const text = [], walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
+ function identity(el) { return el.getAttribute('data-entity') || el.id || [...el.attributes].find(a => a.name.startsWith('data-presentation-'))?.name || el.tagName.toLowerCase() }
+ let node
+ while ((node = walker.nextNode())) {
+  if (!node.textContent.trim()) continue
+  const el = node.parentElement, range = document.createRange()
+  range.selectNodeContents(node)
+  const r = range.getBoundingClientRect()
+  text.push(participant(el, r, `${identity(el)}:${node.textContent.trim().slice(0, 28)}`))
+ }
+ const controlHooks = ['progress', 'toc-entry', 'prev', 'next', 'mode-toggle', 'attribution']
+ const controls = [...root.querySelectorAll(controlHooks.map(h => `[data-presentation-${h}]`).join(','))].map(el => participant(el, el.getBoundingClientRect(), identity(el)))
+ const chrome = [...root.querySelectorAll('[data-presentation-progress],[data-presentation-toc-entry]')].map(el => {
+  const s = getComputedStyle(el), r = el.getBoundingClientRect()
+  return { kind: el.hasAttribute('data-presentation-progress') ? 'progress' : 'toc-entry', active: el.getAttribute('aria-current') === 'step', signature: [s.color, s.backgroundColor, s.border, r.width, r.height, s.fontWeight, s.opacity, s.boxShadow, s.textDecoration, s.transform].join('|') }
+ })
+ const a = root.querySelector('[data-presentation-attribution]'), s = a && getComputedStyle(a)
+ return { text, controls, chrome, attribution: s && a.checkVisibility({ checkOpacity: true }) ? { size: parseFloat(s.fontSize), family: s.fontFamily, color: s.color, decoration: s.textDecorationLine } : null }
+}
diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..017ddf29819f0ee51a0f394382f928c8d69ba8ca
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,38 @@
+import { mkdir, writeFile } from 'node:fs/promises'
+import path from 'node:path'
+import { command, withPreview, monitorErrors, stepCount, advance, SETTLE_MS } from './browser.mjs'
+import { collectDiagnostics, diagnose } from './diagnostics.mjs'
+const slug = process.argv[2]
+function option(name, fallback) { const i = process.argv.indexOf(name); return i < 0 ? fallback : Number(process.argv[i + 1]) }
+try {
+ if (!slug || !/^[a-z0-9-]+$/.test(slug)) throw new Error('usage: npm run inspect -- <registered-slug> [--width 1440 --height 900 --settle 1200]')
+ const width = option('--width', 1440), height = option('--height', 900), settle = option('--settle', SETTLE_MS)
+ if (![width, height, settle].every(n => Number.isFinite(n) && n > 0)) throw new Error('viewport and settle must be positive')
+ await command('npm', ['run', 'build'])
+ const directory = path.join('inspection', slug)
+ await mkdir(directory, { recursive: true })
+ const report = { viewport: { width, height }, settle, captures: [] }
+ await withPreview(async (browser, base) => {
+  report.url = `${base}/${slug}`
+  const page = await browser.newPage({ viewport: { width, height } }), errors = monitorErrors(page)
+  await page.goto(report.url)
+  const count = await stepCount(page)
+  for (let i = 0; i < count; i++) {
+   errors.setStep(i)
+   if (i) await advance(page, i)
+   const transitionedAt = Date.now()
+   await page.waitForTimeout(settle); errors.check()
+   const warnings = diagnose(await page.evaluate(collectDiagnostics), i)
+   for (const warning of warnings) console.log(`warn ${warning}`)
+   const file = path.join(directory, `step-${String(i + 1).padStart(2, '0')}.png`)
+   const capturedAt = Date.now()
+   // A textual fingerprint makes accidental repeated-step capture detectable.
+   const content = await page.locator('[data-presentation-root]').innerText()
+   await page.screenshot({ path: file })
+   report.captures.push({ index: i, file, transitionedAt, capturedAt, content, warnings })
+   console.log(`CAPTURE step ${i}: ${file}`)
+  }
+ })
+ await writeFile(path.join(directory, 'report.json'), JSON.stringify(report, null, 2))
+ console.log('PASS capture; advisory warnings require composition review')
+} catch (error) { console.error(`FAIL inspection: ${error.message}`); process.exitCode = 1 }
