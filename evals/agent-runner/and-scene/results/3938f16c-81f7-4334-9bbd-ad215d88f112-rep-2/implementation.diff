index 0000000000000000000000000000000000000000..9ffb1cc08ee62348ad35116928742a19ecf7c955
--- /dev/null
+++ b/src/presentation-kit/useViewportWidth.ts
@@ -0,0 +1,17 @@
+import { useEffect, useState } from 'react'
+
+/** Tracks the current viewport width for layout decisions (e.g. wide-viewport chrome). */
+export function useViewportWidth(): number {
+  const [width, setWidth] = useState(() => (typeof window === 'undefined' ? 0 : window.innerWidth))
+
+  useEffect(() => {
+    function handleResize() {
+      setWidth(window.innerWidth)
+    }
+
+    window.addEventListener('resize', handleResize)
+    return () => window.removeEventListener('resize', handleResize)
+  }, [])
+
+  return width
+}
