+    {step >= 6 && <>
+      <div className="kit-connector" aria-hidden="true" />
+      <Box id={ENTITY.sceneKit} className="kit-socket"><span>SHARED SCENE KIT</span><b>Boxes · arrows · motion</b></Box>
+    </>}
+    {step >= 8 && <>
