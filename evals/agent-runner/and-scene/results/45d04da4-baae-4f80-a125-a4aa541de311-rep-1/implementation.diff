@@ -0,0 +1,34 @@
+import type { ComponentType } from 'react'
+
+export interface SceneProps<TPayload = undefined> {
+  /** Diagram state for the active step. */
+  payload: TPayload
+  /** Zero-based index of the active step. */
+  stepIndex: number
+}
+
+/** The narrative fields every step carries, independent of its scene. */
+export interface StepMeta {
+  /** Stable identity; never derived from position. */
+  id: string
+  /** Section/era label; contiguous steps with the same era form a table-of-contents entry. */
+  era: string
+  /** One-line presenter title. */
+  title: string
+  /** Paragraph shown in browse mode. */
+  caption: string
+}
+
+/** A scene component; steps sharing `groupKey` and `Scene` keep one mounted instance. */
+export type Scene<TPayload = undefined> = ComponentType<SceneProps<TPayload>>
+
+interface StepBase<TPayload> extends StepMeta {
+  Scene: Scene<TPayload>
+  groupKey?: string
+}
+
+type PayloadField<TPayload> = [TPayload] extends [undefined]
+  ? { payload?: undefined }
+  : { payload: TPayload }
+
+export type Step<TPayload = undefined> = StepBase<TPayload> & PayloadField<TPayload>
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..24ff9e5c953aa785fc848c2e750dc376bca410d0
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,54 @@
+import { useEffect, useState } from 'react'
+import {
+  DESIGN_H,
+  DESIGN_W,
+  MIN_SCALE,
+  STAGE_LAYOUT,
+  TOC_WIDTH,
+  WIDE_MIN_WIDTH,
+  type Mode,
+  type StageGeometry,
+} from './constants'
+
+export interface Viewport {
+  width: number
+  height: number
+}
+
+function readViewport(): Viewport {
+  return { width: window.innerWidth, height: window.innerHeight }
+}
+
+export function useViewport(): Viewport {
+  const [viewport, setViewport] = useState(readViewport)
+  useEffect(() => {
+    const onResize = () => setViewport(readViewport())
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return viewport
+}
+
+export function isWide(viewport: Viewport): boolean {
+  return viewport.width >= WIDE_MIN_WIDTH
+}
+
+/** Space reserved around the canvas for the given mode and viewport. */
+export function stageGeometry(mode: Mode, viewport: Viewport): StageGeometry {
+  const base = STAGE_LAYOUT[mode]
+  if (mode === 'browse' && isWide(viewport)) return { ...base, left: base.left + TOC_WIDTH }
+  return base
+}
+
+/** Uniform scale that fits the design canvas into the viewport minus the mode's reserved space. */
+export function computeFitScale(viewport: Viewport, geometry: StageGeometry): number {
+  const availableW = viewport.width - geometry.left - geometry.right
+  const availableH = viewport.height - geometry.top - geometry.bottom
+  return Math.max(MIN_SCALE, Math.min(availableW / DESIGN_W, availableH / DESIGN_H))
+}
+
+export function useFitScale(mode: Mode): { scale: number; geometry: StageGeometry } {
+  const viewport = useViewport()
+  const geometry = stageGeometry(mode, viewport)
+  return { scale: computeFitScale(viewport, geometry), geometry }
+}
