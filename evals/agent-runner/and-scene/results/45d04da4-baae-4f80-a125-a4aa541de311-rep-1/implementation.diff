+`
+
+function Scene({ payload }: SceneProps<Payload>) {
+  const allow = payload.variant === 'allowed' ? { 'data-presentation-allow-overlap': '' } : {}
+  return (
+    <>
+      <SceneLayer>
+        <Box id="mover" x={payload.moverX} y={220} w={120} h={80} style={{ background: 'rgb(255, 0, 0)' }} />
+        {payload.variant === 'collision' || payload.variant === 'allowed' ? (
+          <>
+            <Box id="alpha" x={300} y={40} w={200} h={50} label="Alpha collision" {...allow} />
+            <Box id="bravo" x={320} y={48} w={200} h={50} label="Bravo collision" {...allow} />
+          </>
+        ) : null}
+        {payload.variant === 'nested' ? (
+          <Box id="parent" x={300} y={40} w={260} h={60}>
+            Parent own text
+            <div style={{ position: 'absolute', left: 12, top: 2 }}>Child own text</div>
+          </Box>
+        ) : null}
+        {payload.variant === 'inherited' ? (
+          <>
+            <div data-presentation-allow-overlap="" style={{ position: 'absolute', left: 300, top: 40, width: 260, height: 60 }}>
+              <div style={{ position: 'absolute', left: 0, top: 0 }}>Wrapped one</div>
+              <div style={{ position: 'absolute', left: 10, top: 4 }}>Wrapped two</div>
+            </div>
+            <Box id="outside-a" x={300} y={140} w={200} h={50} label="Outside alpha" />
+            <Box id="outside-b" x={320} y={148} w={200} h={50} label="Outside bravo" />
+          </>
+        ) : null}
+      </SceneLayer>
+      {payload.polish ? <style>{POLISH_CSS}</style> : null}
+    </>
+  )
+}
+
+const step = (id: string, era: string, title: string, payload: Payload): Step<Payload> => ({
+  id,
+  era,
+  title,
+  caption: `${title} caption`,
+  Scene,
+  groupKey: 'main',
+  payload,
+})
+
+const STEPS: Step<Payload>[] = [
+  step('baseline', 'first', 'Baseline', { variant: 'baseline', moverX: 40 }),
+  step('collision', 'first', 'Unmarked collision', { variant: 'collision', moverX: 40 }),
+  step('allowed', 'second', 'Allowed overlap', { variant: 'allowed', moverX: 40 }),
+  step('moved', 'second', 'Mover animates', { variant: 'plain', moverX: 640 }),
+  step('settled', 'second', 'Settled and polished', { variant: 'plain', moverX: 640, polish: true }),
+  step('nested', 'second', 'Nested own-text collision', { variant: 'nested', moverX: 640 }),
+  step('inherited', 'second', 'Inherited allow-overlap', { variant: 'inherited', moverX: 640 }),
+]
+
+export default function Talk() {
+  return <Presentation steps={STEPS} title="Inspect fixture" initialMode="browse" />
+}
diff --git a/tests/helpers/motionSpy.tsx b/tests/helpers/motionSpy.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b64ac716701d9cfc21ea62ca2adb35364425f2a1
--- /dev/null
+++ b/tests/helpers/motionSpy.tsx
@@ -0,0 +1,75 @@
+import { createElement, forwardRef, useEffect, type ComponentType, type ReactNode } from 'react'
+import { vi } from 'vitest'
+
+type Props = Record<string, unknown>
+
+export interface MotionCall {
+  tag: string
+  props: Props
+}
+
+/** Every render of a `motion.*` element since the last reset. */
+export const motionCalls: MotionCall[] = []
+/** Elements currently mounted, keyed by entity id (or layoutId). */
+export const liveMounts = new Map<string, number>()
+/** Total mounts ever, keyed likewise. Counts StrictMode's extra mount too. */
+export const totalMounts = new Map<string, number>()
+
+export function resetMotionSpy(): void {
+  motionCalls.length = 0
+  liveMounts.clear()
+  totalMounts.clear()
+}
+
+export function callsFor(entityId: string): MotionCall[] {
+  return motionCalls.filter(
+    (c) => c.props['data-presentation-entity'] === entityId || c.props.layoutId === entityId,
+  )
+}
+
+function bump(map: Map<string, number>, key: string, by: number) {
+  map.set(key, (map.get(key) ?? 0) + by)
+}
+
+/**
+ * Factory for `vi.mock('motion/react', ...)`. Real motion still runs; this only records the props
+ * each `motion.*` element receives, counts mounts, and marks the LayoutGroup and AnimatePresence
+ * ancestry with `data-test-*` wrapper divs.
+ */
+export async function createMotionMock() {
+  const actual = await vi.importActual<typeof import('motion/react')>('motion/react')
+  const cache = new Map<string, ComponentType<Props>>()
+  const motion = new Proxy(actual.motion, {
+    get(target, tag, receiver) {
+      const real = Reflect.get(target, tag, receiver) as unknown
+      if (typeof tag !== 'string' || tag === 'create' || typeof real !== 'object') return real
+      let wrapped = cache.get(tag)
+      if (!wrapped) {
+        const Real = real as ComponentType<Props>
+        wrapped = forwardRef<unknown, Props>(function Spy(props, ref) {
+          motionCalls.push({ tag, props })
+          const key = (props['data-presentation-entity'] ?? props.layoutId) as string | undefined
+          useEffect(() => {
+            if (!key) return
+            bump(liveMounts, key, 1)
+            bump(totalMounts, key, 1)
+            return () => bump(liveMounts, key, -1)
+          }, [key])
+          return createElement(Real, { ...props, ref })
+        }) as unknown as ComponentType<Props>
+        cache.set(tag, wrapped)
+      }
+      return wrapped
+    },
+  })
+  const wrapIn = (marker: string, Inner: ComponentType<{ children?: ReactNode }>) =>
+    function Marked(props: { children?: ReactNode }) {
+      return createElement('div', { [marker]: '' }, createElement(Inner, props))
+    }
+  return {
+    ...actual,
+    motion,
+    AnimatePresence: wrapIn('data-test-presence', actual.AnimatePresence as ComponentType<{ children?: ReactNode }>),
+    LayoutGroup: wrapIn('data-test-layoutgroup', actual.LayoutGroup as ComponentType<{ children?: ReactNode }>),
+  }
+}
diff --git a/tests/helpers/styleScan.ts b/tests/helpers/styleScan.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a85e1f78b61839f2441abfa4f6b5b40949b3beb2
--- /dev/null
+++ b/tests/helpers/styleScan.ts
@@ -0,0 +1,76 @@
+/// <reference types="node" />
+import { readdirSync, readFileSync, statSync } from 'node:fs'
+import { join, relative } from 'node:path'
+
+export interface StyleScanResult {
+  /** Stylesheet files of any flavour. */
+  cssFiles: string[]
+  /** Any mention of Tailwind (dependency, config, import, class plugin). */
+  tailwind: string[]
+  /** CSS custom-property theme tokens (`--foo:` declarations or `var(--foo)` reads). */
+  tokens: string[]
+  /** Inline style properties that are visual styling rather than geometry or motion. */
+  inlineStyle: string[]
+}
+
+const STYLESHEET = /\.(css|scss|sass|less|styl|pcss|postcss)$/i
+const SOURCE = /\.(tsx?|jsx?|mjs|cjs|json|html)$/i
+const SKIP_DIRS = new Set(['node_modules', 'dist', '.git', '.inspection'])
+
+/** Style properties a reusable kit or scaffold must not set inline. */
+const FORBIDDEN_PROP =
+  /\b(color|background\w*|font\w*|border(?!Box)\w*|boxShadow|textShadow|dropShadow|outline\w*|letterSpacing|lineHeight|textDecoration\w*|textTransform|filter|backdropFilter|gap|rowGap|columnGap|accentColor|caretColor|fill|stroke)\s*:/g
+/** Spacing is only allowed as a zero reset. */
+const SPACING_PROP = /\b(padding\w*|margin\w*)\s*:\s*([^,}\n]+)/g
+
+function walk(dir: string, out: string[]): string[] {
+  for (const name of readdirSync(dir)) {
+    if (SKIP_DIRS.has(name)) continue
+    const full = join(dir, name)
+    if (statSync(full).isDirectory()) walk(full, out)
+    else out.push(full)
+  }
+  return out
+}
+
+function stripComments(text: string): string {
+  return text.replace(/\/\*[\s\S]*?\*\//g, (m) => m.replace(/[^\n]/g, ' ')).replace(/(^|[^:'"`])\/\/.*$/gm, '$1')
+}
+
+function isZero(value: string): boolean {
+  return /^\s*['"`]?0(px)?(\s+0(px)?)*['"`]?\s*$/.test(value)
+}
+
+/** Scan every file under `root` (not node_modules/dist) for prohibited styling. */
+export function scanForStyling(root: string): StyleScanResult {
+  const result: StyleScanResult = { cssFiles: [], tailwind: [], tokens: [], inlineStyle: [] }
+  for (const file of walk(root, [])) {
+    const rel = relative(root, file)
+    if (STYLESHEET.test(file)) {
+      result.cssFiles.push(rel)
+      continue
+    }
+    if (!SOURCE.test(file)) continue
+    const raw = readFileSync(file, 'utf8')
+    if (/tailwind/i.test(raw)) result.tailwind.push(rel)
+    const isCode = /\.(tsx?|jsx?|mjs|cjs)$/i.test(file)
+    const text = isCode ? stripComments(raw) : raw
+    const lines = text.split('\n')
+    lines.forEach((line, i) => {
+      const where = `${rel}:${i + 1}: ${line.trim()}`
+      if (/var\(\s*--|(^|[\s'"`{,(])--[a-z][\w-]*\s*['"`]?\s*:/i.test(line)) result.tokens.push(where)
+      if (!isCode) return
+      FORBIDDEN_PROP.lastIndex = 0
+      if (FORBIDDEN_PROP.test(line)) result.inlineStyle.push(where)
+      for (const match of line.matchAll(SPACING_PROP)) {
+        if (!isZero(match[2] ?? '')) result.inlineStyle.push(where)
+      }
+    })
+  }
+  return result
+}
+
+/** True when the scan found nothing. */
+export function isStyleClean(result: StyleScanResult): boolean {
+  return Object.values(result).every((list) => list.length === 0)
+}
diff --git a/tests/helpers/verify-fixture.ts b/tests/helpers/verify-fixture.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7970d9ba393d32c4a69196185e5cda6b0d19ec38
--- /dev/null
+++ b/tests/helpers/verify-fixture.ts
@@ -0,0 +1,195 @@
+import { spawn } from 'node:child_process'
+import { cp, mkdir, mkdtemp, readFile, rm, symlink, writeFile } from 'node:fs/promises'
+import net from 'node:net'
+import os from 'node:os'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+export const REPO_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..')
+export const SAMPLE_SLUG = 'how-to-make-a-presentation'
+
+const EXCLUDED = new Set(['.git', 'dist', 'node_modules', 'openspec', 'validator_logs', 'tests', 'skills'])
+
+export interface ReferenceStep {
+  era: string
+  title: string
+  caption: string
+}
+
+export interface Fault {
+  /** Step index at which the fault triggers in the browser. */
+  step?: number
+  kind?: 'rename-title' | 'swap-titles' | 'change-caption' | 'swap-captions' | 'console-error' | 'throw' | 'stall'
+}
+
+/** Disposable copy of the repo (no .git/dist/node_modules) with node_modules symlinked. */
+export async function makeCopy(): Promise<string> {
+  const dir = await mkdtemp(path.join(os.tmpdir(), 'and-scene-verify-'))
+  await cp(REPO_ROOT, dir, {
+    recursive: true,
+    filter: (src) => {
+      const rel = path.relative(REPO_ROOT, src)
+      return !EXCLUDED.has(rel.split(path.sep)[0] ?? '')
+    },
+  })
+  await symlink(path.join(REPO_ROOT, 'node_modules'), path.join(dir, 'node_modules'))
+  return dir
+}
+
+export async function removeCopy(dir: string): Promise<void> {
+  await rm(dir, { recursive: true, force: true })
+}
+
+export async function readReference(): Promise<{ steps: ReferenceStep[]; presentationTitle: string }> {
+  return JSON.parse(await readFile(path.join(REPO_ROOT, 'scripts', 'verify.reference.json'), 'utf8'))
+}
+
+/** Source of a minimal controlled presentation (kit Presentation + trivial Scene) with an optional fault. */
+export function fixtureSource(steps: ReferenceStep[], presentationTitle: string, fault: Fault = {}): string {
+  const rows = steps.map((s) => ({ ...s }))
+  if (fault.kind === 'rename-title') rows[fault.step ?? 0]!.title = `${rows[fault.step ?? 0]!.title} (renamed)`
+  if (fault.kind === 'swap-titles') {
+    const a = rows[0]!.title
+    rows[0]!.title = rows[1]!.title
+    rows[1]!.title = a
+  }
+  if (fault.kind === 'change-caption') rows[fault.step ?? 0]!.caption = `${rows[fault.step ?? 0]!.caption} (edited)`
+  if (fault.kind === 'swap-captions') {
+    const a = rows[0]!.caption
+    rows[0]!.caption = rows[1]!.caption
+    rows[1]!.caption = a
+  }
+  return `import { useEffect } from 'react'
+import { Box, Presentation, SceneLayer, type SceneProps, type Step } from '../../presentation-kit'
+
+const FAULT: { kind: string | null; step: number } = ${JSON.stringify({ kind: fault.kind ?? null, step: fault.step ?? 0 })}
+
+function Scene({ stepIndex }: SceneProps) {
+  if (FAULT.kind === 'throw' && stepIndex === FAULT.step) throw new Error('fixture render failure at step ' + stepIndex)
+  useEffect(() => {
+    if (FAULT.kind === 'console-error' && stepIndex === FAULT.step) console.error('fixture console error at step ' + stepIndex)
+    if (FAULT.kind !== 'stall' || stepIndex !== FAULT.step) return
+    const block = (e: KeyboardEvent) => {
+      if (e.key === 'ArrowRight') e.stopImmediatePropagation()
+    }
+    window.addEventListener('keydown', block, true)
+    return () => window.removeEventListener('keydown', block, true)
+  }, [stepIndex])
+  return (
+    <SceneLayer>
+      <Box id="you" x={40} y={40} w={120} h={60} label={'step ' + stepIndex} />
+    </SceneLayer>
+  )
+}
+
+const ROWS = ${JSON.stringify(rows, null, 2)}
+
+const STEPS: Step[] = ROWS.map((r, i) => ({ id: 's' + i, era: r.era, title: r.title, caption: r.caption, Scene, groupKey: 'main' }))
+
+export default function Talk() {
+  return <Presentation steps={STEPS} title=${JSON.stringify(presentationTitle)} initialMode="browse" />
+}
+`
+}
+
+export async function installFixture(dir: string, fault: Fault = {}): Promise<void> {
+  const ref = await readReference()
+  const file = path.join(dir, 'src', 'presentations', SAMPLE_SLUG, 'Talk.tsx')
+  await writeFile(file, fixtureSource(ref.steps, ref.presentationTitle, fault))
+}
+
+/** Register a second presentation (slug `second`) built from the controlled fixture with an optional fault. */
+export async function installSecondPresentation(dir: string, fault: Fault = {}): Promise<void> {
+  const ref = await readReference()
+  const secondDir = path.join(dir, 'src', 'presentations', 'second')
+  await mkdir(secondDir, { recursive: true })
+  await writeFile(path.join(secondDir, 'Talk.tsx'), fixtureSource(ref.steps, 'Second', fault))
+  await writeFile(
+    path.join(dir, 'src', 'presentations', 'index.ts'),
+    registrySource([
+      { slug: SAMPLE_SLUG, title: ref.presentationTitle },
+      { slug: 'second', title: 'Second' },
+    ]),
+  )
+}
+
+export function registrySource(entries: Array<{ slug: string; title: string; dir?: string }>): string {
+  const items = entries
+    .map((e) => `  { slug: '${e.slug}', title: '${e.title}', load: () => import('./${e.dir ?? e.slug}/Talk') },`)
+    .join('\n')
+  return `import type { ComponentType } from 'react'
+
+export interface PresentationEntry {
+  slug: string
+  title: string
+  load: () => Promise<{ default: ComponentType }>
+}
+
+export const presentations: PresentationEntry[] = [
+${items}
+]
+`
+}
+
+export interface RunResult {
+  code: number | null
+  output: string
+}
+
+export function runVerify(
+  cwd: string,
+  opts: { env?: Record<string, string>; command?: [string, string[]]; timeoutMs?: number } = {},
+): Promise<RunResult> {
+  const [cmd, args] = opts.command ?? ['node', ['scripts/verify.mjs']]
+  return new Promise((resolve) => {
+    const child = spawn(cmd, args, { cwd, env: { ...process.env, ...opts.env }, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (d) => (output += d))
+    child.stderr.on('data', (d) => (output += d))
+    const timer = setTimeout(() => child.kill('SIGKILL'), opts.timeoutMs ?? 240_000)
+    child.on('close', (code) => {
+      clearTimeout(timer)
+      resolve({ code, output })
+    })
+  })
+}
+
+export function freePort(): Promise<number> {
+  return new Promise((resolve, reject) => {
+    const s = net.createServer()
+    s.once('error', reject)
+    s.listen(0, '127.0.0.1', () => {
+      const { port } = s.address() as net.AddressInfo
+      s.close(() => resolve(port))
+    })
+  })
+}
+
+/** True when something accepts connections on 127.0.0.1:port. */
+export function isListening(port: number): Promise<boolean> {
+  return new Promise((resolve) => {
+    const sock = net.connect({ host: '127.0.0.1', port })
+    sock.once('connect', () => {
+      sock.destroy()
+      resolve(true)
+    })
+    sock.once('error', () => resolve(false))
+  })
+}
+
+/** Command lines of processes whose argv mentions the directory (e.g. a leftover vite preview). */
+export function leftoverProcesses(dir: string): Promise<string> {
+  return new Promise((resolve) => {
+    const child = spawn('pgrep', ['-af', dir])
+    let out = ''
+    child.stdout.on('data', (d) => (out += d))
+    child.on('close', () =>
+      resolve(
+        out
+          .split('\n')
+          .filter((l) => l && !l.includes('pgrep'))
+          .join('\n'),
+      ),
+    )
+  })
+}
diff --git a/tests/integration/bootstrap.test.ts b/tests/integration/bootstrap.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..22504af84ec4a6cf31c4fd69639110f1c15d77e2
--- /dev/null
+++ b/tests/integration/bootstrap.test.ts
@@ -0,0 +1,246 @@
+// INT-001: the distributable bootstrap template materializes into a complete, installable,
+// buildable, routable and style-neutral app outside the authoring repository.
+import { execFileSync, spawnSync } from 'node:child_process'
+import { cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join, relative, resolve } from 'node:path'
+import { afterAll, beforeAll, describe, expect, it } from 'vitest'
+import { scanForStyling } from '../helpers/styleScan'
+
+const repo = resolve(__dirname, '../..')
+const skillDir = join(repo, 'skills/presentation')
+const templateDir = join(skillDir, 'templates/bootstrap')
+const detectScript = join(skillDir, 'scripts/detect-scaffold.mjs')
+
+let sandbox: string // outside the source repository
+let elsewhere: string // unrelated cwd for every command
+let app: string
+let applyOutput: { kind: string; action: string; requiresConfirmation: boolean; applied: { written: string[] } }
+const logs: Record<string, string> = {}
+
+function files(dir: string, base = dir): string[] {
+  const skip = new Set(['node_modules', 'dist', '.inspection'])
+  const out: string[] = []
+  for (const entry of readdirSync(dir, { withFileTypes: true })) {
+    if (skip.has(entry.name)) continue
+    const full = join(dir, entry.name)
+    if (entry.isDirectory()) out.push(...files(full, base))
+    else out.push(relative(base, full).split('\\').join('/'))
+  }
+  return out.sort()
+}
+
+function run(cwd: string, command: string, args: string[], label: string, timeout = 280_000) {
+  const result = spawnSync(command, args, { cwd, encoding: 'utf8', timeout, maxBuffer: 64 * 1024 * 1024, env: { ...process.env, CI: '1' } })
+  logs[label] = `${result.stdout}\n${result.stderr}`
+  return result
+}
+
+beforeAll(() => {
+  sandbox = mkdtempSync(join(tmpdir(), 'int-001-'))
+  elsewhere = join(sandbox, 'unrelated-cwd')
+  mkdirSync(elsewhere)
+  app = join(sandbox, 'fresh-app')
+  mkdirSync(app)
+  // Materialize through the documented skill-relative resolution, from a cwd outside the repo.
+  const out = execFileSync(process.execPath, [detectScript, app, '--apply'], { cwd: elsewhere, encoding: 'utf8' })
+  applyOutput = JSON.parse(out)
+  const install = run(app, 'npm', ['ci', '--no-audit', '--no-fund'], 'npm-ci', 500_000)
+  expect(install.status, logs['npm-ci']).toBe(0)
+}, 600_000)
+
+afterAll(() => {
+  rmSync(sandbox, { recursive: true, force: true })
+})
+
+describe('INT-001 materialized bootstrap', () => {
+  it('is materialized from the skill-relative template, independent of the caller cwd', () => {
+    expect(applyOutput).toMatchObject({ kind: 'empty', action: 'full-scaffold', requiresConfirmation: false })
+    const expected = files(templateDir)
+    expect(files(app)).toEqual(expected)
+    for (const rel of expected.filter((f) => f !== 'package.json' && f !== 'package-lock.json')) {
+      expect(readFileSync(join(app, rel)).equals(readFileSync(join(templateDir, rel))), rel).toBe(true)
+    }
+    expect(app.startsWith(repo)).toBe(false)
+  })
+
+  it('provides all three working anchors', async () => {
+    const { detectAnchors } = await import('../../skills/presentation/scripts/detect-scaffold.mjs')
+    expect(detectAnchors(app)).toMatchObject({ build: true, kit: true, index: true, missing: [] })
+    expect(existsSync(join(app, 'src/presentation-kit/types.ts'))).toBe(true)
+    expect(readFileSync(join(app, 'src/presentations/index.ts'), 'utf8')).toMatch(/slug: 'starter'/)
+  })
+
+  it('declares and locks the complete dependency set, with exact playwright', () => {
+    const pkg = JSON.parse(readFileSync(join(app, 'package.json'), 'utf8'))
+    const lock = JSON.parse(readFileSync(join(app, 'package-lock.json'), 'utf8'))
+    const runtime = ['react', 'react-dom', 'motion', 'lucide-react']
+    const dev = [
+      'vite',
+      '@vitejs/plugin-react',
+      'typescript',
+      '@types/react',
+      '@types/react-dom',
+      '@types/node',
+      'eslint',
+      '@eslint/js',
+      'typescript-eslint',
+      'eslint-plugin-react-hooks',
+      'eslint-plugin-react-refresh',
+      'globals',
+      'playwright',
+    ]
+    for (const dep of runtime) expect(pkg.dependencies[dep], dep).toEqual(expect.any(String))
+    for (const dep of dev) expect(pkg.devDependencies[dep], dep).toEqual(expect.any(String))
+    expect(pkg.devDependencies.playwright).toBe('1.61.0')
+    for (const dep of [...runtime, ...dev]) {
+      expect(lock.packages[`node_modules/${dep}`], `lock entry for ${dep}`).toBeDefined()
+      expect(existsSync(join(app, 'node_modules', dep, 'package.json')), `installed ${dep}`).toBe(true)
+    }
+    expect(lock.packages['node_modules/playwright'].version).toBe('1.61.0')
+  })
+
+  it('builds with the local package scripts', () => {
+    const build = run(app, 'npm', ['run', 'build'], 'build')
+    expect(build.status, logs.build).toBe(0)
+    expect(existsSync(join(app, 'dist/index.html'))).toBe(true)
+  })
+
+  it('lints clean', () => {
+    const lint = run(app, 'npm', ['run', 'lint'], 'lint')
+    expect(lint.status, logs.lint).toBe(0)
+  })
+
+  it('passes its scaffold-local verification on the registered starter route, from outside the source repo', () => {
+    const verify = run(app, 'npm', ['run', 'verify'], 'verify', 400_000)
