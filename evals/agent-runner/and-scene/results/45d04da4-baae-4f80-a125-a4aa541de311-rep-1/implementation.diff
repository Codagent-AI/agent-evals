diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1f23bb39cfc715bc5174edb016eeca90ce3e67bb
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,74 @@
+import type { ReactNode } from 'react'
+import type { Mode } from './constants'
+import { Stage } from './Stage'
+import { Attribution } from './chrome/Attribution'
+import { Footer } from './chrome/Footer'
+import type { ChromeHooks } from './chrome/forward'
+import { Header } from './chrome/Header'
+import { Toc } from './chrome/Toc'
+import { tocEntries } from './chrome/tocEntries'
+import type { Step } from './types'
+import { isWide, useViewport } from './useFitScale'
+import { usePresentationNav } from './usePresentationNav'
+
+export interface PresentationProps<TPayload> {
+  steps: ReadonlyArray<Step<TPayload>>
+  title: string
+  initialMode?: Mode
+  /** Host-provided branding for the top-left header slot. */
+  brand?: ReactNode
+  /** Set to false to remove the default bottom-right attribution. */
+  attribution?: boolean
+  /** Class, style and data-* hooks forwarded to each chrome part's root element. */
+  chrome?: {
+    header?: ChromeHooks
+    footer?: ChromeHooks
+    toc?: ChromeHooks
+    attribution?: ChromeHooks
+  }
+}
+
+export function Presentation<TPayload>({
+  steps,
+  title,
+  initialMode = 'browse',
+  brand,
+  attribution = true,
+  chrome = {},
+}: PresentationProps<TPayload>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const viewport = useViewport()
+  const step = steps[nav.index]
+  if (!step) return null
+  const showToc = nav.mode === 'browse' && isWide(viewport)
+  return (
+    <div
+      data-presentation-root=""
+      data-presentation-title-text={title}
+      data-presentation-mode={nav.mode}
+      data-presentation-step-count={steps.length}
+      data-presentation-step-index={nav.index}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      style={{ position: 'relative', width: '100vw', height: '100vh', overflow: 'hidden' }}
+    >
+      <Header {...chrome.header} brand={brand} era={step.era} />
+      {showToc ? <Toc {...chrome.toc} entries={tocEntries(steps)} activeIndex={nav.index} onJump={nav.goTo} /> : null}
+      <Stage step={step} stepIndex={nav.index} mode={nav.mode} />
+      <Footer
+        {...chrome.footer}
+        mode={nav.mode}
+        index={nav.index}
+        count={steps.length}
+        title={step.title}
+        caption={step.caption}
+        stepTitles={steps.map((s) => s.title)}
+        onJump={nav.goTo}
+        onPrev={nav.prev}
+        onNext={nav.next}
+        onToggleMode={nav.toggleMode}
+      />
+      {attribution ? <Attribution {...chrome.attribution} /> : null}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b96bb4453901d0715535b81fc01de53e736270e2
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,65 @@
+import type { ComponentType } from 'react'
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, EXIT_T, type Mode } from './constants'
+import { useFitScale } from './useFitScale'
+import { sceneKey } from './sceneKey'
+import type { SceneProps, Step } from './types'
+
+export interface StageProps<TPayload> {
+  step: Step<TPayload>
+  stepIndex: number
+  mode: Mode
+}
+
+/** Fixed design canvas, scaled uniformly to fit, hosting the active step's scene. */
+export function Stage<TPayload>({ step, stepIndex, mode }: StageProps<TPayload>) {
+  const { scale, geometry } = useFitScale(mode)
+  const Scene = step.Scene as ComponentType<SceneProps<TPayload | undefined>>
+  return (
+    <div
+      data-presentation-stage=""
+      data-presentation-scale={scale}
+      style={{
+        position: 'absolute',
+        top: geometry.top,
+        bottom: geometry.bottom,
+        left: geometry.left,
+        right: geometry.right,
+        display: 'flex',
+        alignItems: 'center',
+        justifyContent: 'center',
+        overflow: 'hidden',
+      }}
+    >
+      <div style={{ width: DESIGN_W * scale, height: DESIGN_H * scale, position: 'relative', flex: 'none' }}>
+        <div
+          data-presentation-canvas=""
+          style={{
+            position: 'absolute',
+            left: 0,
+            top: 0,
+            width: DESIGN_W,
+            height: DESIGN_H,
+            transform: `scale(${scale})`,
+            transformOrigin: 'top left',
+          }}
+        >
+          <LayoutGroup>
+            <AnimatePresence initial={false}>
+              <motion.div
+                key={sceneKey(step)}
+                data-presentation-scene=""
+                initial={{ opacity: 0 }}
+                animate={{ opacity: 1 }}
+                exit={{ opacity: 0, transition: { duration: EXIT_T } }}
+                style={{ position: 'absolute', left: 0, top: 0, width: DESIGN_W, height: DESIGN_H }}
+              >
+                <Scene payload={step.payload} stepIndex={stepIndex} />
+              </motion.div>
+            </AnimatePresence>
+          </LayoutGroup>
+        </div>
+      </div>
+    </div>
+  )
+}
