+  it('exposes lint, build, verify, inspect and template sync entry points', () => {
+    for (const name of ['lint', 'build', 'verify', 'inspect', 'sync:templates']) {
+      expect(pkg.scripts[name], name).toEqual(expect.any(String))
+    }
+  })
+})
