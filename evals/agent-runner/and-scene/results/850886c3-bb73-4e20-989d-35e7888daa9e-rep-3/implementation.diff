+import type { ReactNode } from 'react'
+import { stepNumber } from '../steps'
+import type { Mode, StepMeta } from '../types'
+
+export interface HeaderProps {
+  title: string
+  mode: Mode
+  step: StepMeta
+  index: number
+  count: number
+  brand?: ReactNode
+  onToggleMode: () => void
+}
+
+export function Header({ title, mode, step, index, count, brand, onToggleMode }: HeaderProps) {
+  return (
+    <header
+      data-presentation-header=""
+      style={{
+        position: 'absolute',
+        left: 0,
+        right: 0,
+        top: 0,
+        display: 'flex',
+        alignItems: 'center',
+        justifyContent: 'space-between',
+        gap: 12,
+        padding: '12px 24px',
+      }}
+    >
+      <div data-presentation-brand-slot="">{brand}</div>
+      {mode === 'browse' && <h1 data-presentation-title="" style={{ margin: 0 }}>{title}</h1>}
+      <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>
+        <span data-presentation-marker="" data-presentation-era={step.era}>
+          {step.era} · {stepNumber(index)} / {count}
+        </span>
+        <button
+          type="button"
+          data-presentation-mode-toggle=""
+          aria-pressed={mode === 'present'}
+          onClick={onToggleMode}
+        >
+          {mode === 'present' ? 'Browse' : 'Present'}
+        </button>
+      </div>
+    </header>
+  )
+}
diff --git a/src/presentation-kit/chrome/Toc.tsx b/src/presentation-kit/chrome/Toc.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4ee6d726251985836117cc57cf14f5142edc0cf6
--- /dev/null
+++ b/src/presentation-kit/chrome/Toc.tsx
@@ -0,0 +1,30 @@
+import { activeEraIndex, type EraEntry } from '../steps'
+
+export interface TocProps {
+  entries: readonly EraEntry[]
+  index: number
+  onJump: (stepIndex: number) => void
+}
+
+export function Toc({ entries, index, onJump }: TocProps) {
+  const active = activeEraIndex(entries, index)
+  return (
+    <nav data-presentation-toc="" aria-label="Table of contents">
+      <ol style={{ display: 'flex', gap: 8, listStyle: 'none', margin: 0, padding: 0, flexWrap: 'wrap' }}>
+        {entries.map((e, i) => (
+          <li key={`${e.era}-${e.start}`}>
+            <button
+              type="button"
+              data-presentation-toc-entry=""
+              data-presentation-active={i === active}
+              aria-current={i === active ? 'true' : undefined}
+              onClick={() => onJump(e.start)}
+            >
+              {e.era}
+            </button>
+          </li>
+        ))}
+      </ol>
+    </nav>
+  )
+}
