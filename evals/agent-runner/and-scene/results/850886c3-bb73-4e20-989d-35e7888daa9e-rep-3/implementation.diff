@@ -0,0 +1,39 @@
+import { useEffect, useState } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT } from './constants'
+import type { Mode } from './types'
+
+export interface StageGeometry {
+  top: number
+  bottom: number
+  side: number
+}
+
+/** Uniform scale that fits the design canvas into the available box. */
+export function computeScale(
+  viewportW: number,
+  viewportH: number,
+  geometry: StageGeometry,
+  designW = DESIGN_W,
+  designH = DESIGN_H,
+) {
+  const availW = Math.max(0, viewportW - geometry.side * 2)
+  const availH = Math.max(0, viewportH - geometry.top - geometry.bottom)
+  return Math.max(MIN_SCALE, Math.min(availW / designW, availH / designH))
+}
+
+export function useFitScale(mode: Mode, designW = DESIGN_W, designH = DESIGN_H) {
+  const geometry = STAGE_LAYOUT[mode]
+  const [scale, setScale] = useState(() =>
+    typeof window === 'undefined'
+      ? 1
+      : computeScale(window.innerWidth, window.innerHeight, geometry, designW, designH),
+  )
+  useEffect(() => {
+    const update = () =>
+      setScale(computeScale(window.innerWidth, window.innerHeight, geometry, designW, designH))
+    update()
+    window.addEventListener('resize', update)
+    return () => window.removeEventListener('resize', update)
+  }, [geometry, designW, designH])
+  return scale
+}
diff --git a/src/presentation-kit/usePresentationNav.ts b/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f93702b9be7d0126553b80adbe1b7caabb8e177b
--- /dev/null
+++ b/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,90 @@
+import { useCallback, useEffect, useState } from 'react'
+import { clampIndex } from './steps'
+import type { Mode } from './types'
+
+const NEXT_KEYS = ['ArrowRight', ' ', 'PageDown']
+const PREV_KEYS = ['ArrowLeft', 'PageUp']
+const SWIPE_MIN = 40
+
+const INTERACTIVE = [
+  'button',
+  'a[href]',
+  'input',
+  'select',
+  'textarea',
+  'summary',
+  '[contenteditable]:not([contenteditable="false"])',
+  '[role="button"],[role="slider"],[role="textbox"],[role="searchbox"],[role="spinbutton"],[role="combobox"],[role="listbox"],[role="option"],[role="checkbox"],[role="radio"],[role="switch"],[role="tab"],[role="menuitem"],[role="scrollbar"]',
+].join(',')
+
+/** True when the key event target is a control that owns its own keyboard behavior. */
+export function isInteractiveTarget(target: EventTarget | null) {
+  if (!(target instanceof Element)) return false
+  return (target instanceof HTMLElement && target.isContentEditable) || target.closest(INTERACTIVE) !== null
+}
+
+export interface Nav {
+  index: number
+  mode: Mode
+  next: () => void
+  prev: () => void
+  goTo: (i: number) => void
+  toggleMode: () => void
+}
+
+export function usePresentationNav(count: number, initialMode: Mode = 'browse'): Nav {
+  const [rawIndex, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+
+  // Steps can shrink after mount (hot reload, swapped arrays); never expose a stale out-of-range index.
+  const index = clampIndex(rawIndex, count)
+
+  const goTo = useCallback((i: number) => setIndex(clampIndex(i, count)), [count])
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, count)), [count])
+  const toggleMode = useCallback(
+    () => setMode((m) => (m === 'browse' ? 'present' : 'browse')),
+    [],
+  )
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey) return
+      // Focused controls keep their own key behavior.
+      if (isInteractiveTarget(e.target)) return
+      if (NEXT_KEYS.includes(e.key)) {
+        e.preventDefault()
+        next()
+      } else if (PREV_KEYS.includes(e.key)) {
+        e.preventDefault()
+        prev()
+      } else if (e.key === 'p' || e.key === 'P') {
+        toggleMode()
+      }
+    }
+    let startX = 0
+    let startY = 0
+    const onStart = (e: TouchEvent) => {
+      startX = e.touches[0].clientX
+      startY = e.touches[0].clientY
+    }
+    const onEnd = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      const dx = t.clientX - startX
+      const dy = t.clientY - startY
+      if (Math.abs(dx) < SWIPE_MIN || Math.abs(dx) < Math.abs(dy)) return
+      if (dx < 0) next()
+      else prev()
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onStart, { passive: true })
+    window.addEventListener('touchend', onEnd, { passive: true })
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onStart)
+      window.removeEventListener('touchend', onEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, next, prev, goTo, toggleMode }
+}
