diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..da14edfcbb77c3158946a637aa15a80e7f895fa8
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,84 @@
+import { useEffect, useMemo, useState, type ReactNode } from 'react'
+import { DESIGN_H, DESIGN_W, TOC_MIN_WIDTH } from './constants'
+import { Attribution, type AttributionOptions } from './chrome/Attribution'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { Stage } from './Stage'
+import { eraEntries } from './steps'
+import type { AnyStep, Mode } from './types'
+import { usePresentationNav } from './usePresentationNav'
+
+export interface PresentationProps {
+  steps: readonly AnyStep[]
+  title: string
+  initialMode?: Mode
+  /** Host-provided top-left brand; empty by default. */
+  brand?: ReactNode
+  /** Override the default bottom-right attribution, or pass false to omit it. */
+  attribution?: AttributionOptions | false
+  canvas?: { width: number; height: number }
+  /** Class on the root element, for presentation-scoped CSS. */
+  className?: string
+}
+
+function useIsWide() {
+  const [wide, setWide] = useState(() => window.innerWidth >= TOC_MIN_WIDTH)
+  useEffect(() => {
+    const on = () => setWide(window.innerWidth >= TOC_MIN_WIDTH)
+    window.addEventListener('resize', on)
+    return () => window.removeEventListener('resize', on)
+  }, [])
+  return wide
+}
+
+export function Presentation({
+  steps,
+  title,
+  initialMode = 'browse',
+  brand,
+  attribution,
+  canvas = { width: DESIGN_W, height: DESIGN_H },
+  className,
+}: PresentationProps) {
+  if (steps.length === 0) throw new Error('Presentation requires at least one step')
+  const nav = usePresentationNav(steps.length, initialMode)
+  const wide = useIsWide()
+  const eras = useMemo(() => eraEntries(steps), [steps])
+  useEffect(() => {
+    document.title = title
+  }, [title])
+
+  return (
+    <div
+      data-presentation-root=""
+      className={className}
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      data-step-id={steps[nav.index].id}
+      style={{ position: 'fixed', inset: 0, overflow: 'hidden' }}
+    >
+      <Header
+        title={title}
+        mode={nav.mode}
+        step={steps[nav.index]}
+        index={nav.index}
+        count={steps.length}
+        brand={brand}
+        onToggleMode={nav.toggleMode}
+      />
+      <Stage steps={steps} index={nav.index} mode={nav.mode} width={canvas.width} height={canvas.height} />
+      <Footer
+        mode={nav.mode}
+        steps={steps}
+        eras={eras}
+        index={nav.index}
+        showToc={wide}
+        onPrev={nav.prev}
+        onNext={nav.next}
+        onJump={nav.goTo}
+      />
+      {attribution !== false && <Attribution {...attribution} />}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..518f8cdf275996136a94e02fd9bef302e1d7167f
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,73 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, ENTER_T, STAGE_LAYOUT } from './constants'
+import { sceneKey } from './steps'
+import type { AnyStep, Mode } from './types'
+import { useFitScale } from './useFitScale'
+
+export interface StageProps {
+  steps: readonly AnyStep[]
+  index: number
+  mode: Mode
+  width?: number
+  height?: number
+}
+
+/**
+ * Fixed design canvas scaled uniformly to fit the gap between header and footer.
+ * Steps sharing a groupKey keep one mounted Scene instance; otherwise the host
+ * cross-fades and shared layoutIds morph.
+ */
+export function Stage({ steps, index, mode, width = DESIGN_W, height = DESIGN_H }: StageProps) {
+  const scale = useFitScale(mode, width, height)
+  const step = steps[index]
+  const { top, bottom, side } = STAGE_LAYOUT[mode]
+  const { Scene, payload } = step
+  return (
+    <div
+      data-presentation-stage-area=""
+      style={{
+        position: 'absolute',
+        left: side,
+        right: side,
+        top,
+        bottom,
+        display: 'flex',
+        alignItems: 'center',
+        justifyContent: 'center',
+        overflow: 'hidden',
+      }}
+    >
+      <div style={{ width: width * scale, height: height * scale, position: 'relative', flex: 'none' }}>
+        <div
+          data-presentation-canvas=""
+          data-presentation-scale={scale.toFixed(3)}
+          style={{
+            width,
+            height,
+            position: 'absolute',
+            left: 0,
+            top: 0,
+            transform: `scale(${scale})`,
+            transformOrigin: 'top left',
+          }}
+        >
+          <LayoutGroup>
+            <AnimatePresence initial={false}>
+              <motion.div
+                key={sceneKey(step)}
+                data-presentation-scene={sceneKey(step)}
+                initial={{ opacity: 0 }}
+                animate={{ opacity: 1 }}
+                exit={{ opacity: 0 }}
+                transition={ENTER_T}
+                style={{ position: 'absolute', inset: 0 }}
+              >
+                <Scene payload={payload} index={index} />
+              </motion.div>
+            </AnimatePresence>
+          </LayoutGroup>
+        </div>
+      </div>
+    </div>
+  )
+}
