+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,16 @@
+#!/usr/bin/env node
+// Per-step screenshots and advisory visual diagnostics: `npm run inspect -- <slug>`.
+import { chromium } from 'playwright'
+import { runInspect } from './lib/inspect-run.mjs'
+import { projectRoot, readRegistry, runBuild, startPreview } from './lib/preview.mjs'
+
+const code = await runInspect(process.argv.slice(2), {
+  root: projectRoot(import.meta.url),
+  log: (message) => console.log(`[inspect] ${message}`),
+  error: (message) => console.error(message),
+  build: runBuild,
+  startPreview,
+  launchBrowser: () => chromium.launch(),
+  readRegistry,
+})
+process.exit(code)
diff --git a/scripts/lib/diagnostics.mjs b/scripts/lib/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c1883b291c18331792da6369ce3bde4f34c6212c
--- /dev/null
+++ b/scripts/lib/diagnostics.mjs
@@ -0,0 +1,187 @@
+// Advisory visual diagnostics. `collectSnapshot` runs inside the page and is
+// self-contained; `analyzeSnapshot` is pure so it can be unit-tested.
+
+export const MIN_ATTRIBUTION_PX = 11
+export const BROWSER_DEFAULT_LINK_COLOR = 'rgb(0, 0, 238)'
+
+/* c8 ignore start -- executed in the browser; exercised by the inspect integration test */
+export function collectSnapshot(doc, win) {
+  const CHROME_SELECTOR = [
+    '[data-presentation-progress-dot]',
+    '[data-presentation-toc-entry]',
+    '[data-presentation-prev]',
+    '[data-presentation-next]',
+    '[data-presentation-mode-toggle]',
+    '[data-presentation-attribution]',
+  ].join(',')
+  const STYLE_KEYS = [
+    'backgroundColor', 'color', 'borderTopColor', 'borderTopWidth', 'width', 'height',
+    'fontWeight', 'textDecorationLine', 'opacity', 'boxShadow', 'outlineStyle', 'transform',
+  ]
+
+  const visible = (el, rect) => {
+    if (!(rect.width > 0 && rect.height > 0)) return false
+    if (win.getComputedStyle(el).visibility === 'hidden') return false
+    // display:none, zero opacity and the like hide everything below them
+    for (let node = el; node && node !== doc.documentElement; node = node.parentElement) {
+      const style = win.getComputedStyle(node)
+      if (style.display === 'none' || Number(style.opacity) === 0) return false
+    }
+    return true
+  }
+  const pathOf = (el) => {
+    const parts = []
+    for (let node = el; node && node !== doc.body; node = node.parentElement) {
+      parts.unshift(Array.prototype.indexOf.call(node.parentElement?.children ?? [], node))
+    }
+    return parts.join('/')
+  }
+  const describe = (el) => {
+    const hook = el.getAttributeNames().find((name) => name.startsWith('data-presentation-'))
+    const entity = el.getAttribute('data-presentation-entity')
+    const text = (el.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 30)
+    const name = entity ? `[data-presentation-entity=${entity}]` : hook ? `[${hook}]` : el.tagName.toLowerCase()
+    return text ? `${name} "${text}"` : name
+  }
+  const textRect = (el) => {
+    const range = doc.createRange()
+    range.selectNodeContents(el)
+    const r = range.getBoundingClientRect()
+    return r
+  }
+
+  const elements = []
+  const seen = new Set()
+  const add = (el, rect) => {
+    if (seen.has(el)) return
+    seen.add(el)
+    elements.push({
+      label: describe(el),
+      path: pathOf(el),
+      rect: { left: rect.left, top: rect.top, right: rect.right, bottom: rect.bottom },
+      allow: el.closest('[data-presentation-allow-overlap]') !== null,
+    })
+  }
+  for (const el of doc.body.querySelectorAll('*')) {
+    const ownText = Array.from(el.childNodes).some((n) => n.nodeType === 3 && n.textContent.trim())
+    if (ownText) {
+      const rect = textRect(el)
+      if (visible(el, rect)) add(el, rect)
+    } else if (el.matches(CHROME_SELECTOR)) {
+      const rect = el.getBoundingClientRect()
+      if (visible(el, rect)) add(el, rect)
+    }
+  }
+
+  const signature = (el) => {
+    const style = win.getComputedStyle(el)
+    // a labelled control's width and height follow its text, so only icon-like controls compare sizes
+    const labelled = (el.textContent || '').trim() !== ''
+    return Object.fromEntries(
+      STYLE_KEYS.filter((key) => !(labelled && (key === 'width' || key === 'height'))).map((key) => [key, style[key]]),
+    )
+  }
+  const activeChrome = (selector) => {
+    const items = Array.from(doc.querySelectorAll(selector))
+    const active = items.find((el) => el.hasAttribute('aria-current'))
+    return items.length === 0 || !active
+      ? null
+      : { active: signature(active), inactive: items.filter((el) => el !== active).map(signature) }
+  }
+
+  const link = doc.querySelector('[data-presentation-attribution]')
+  let attribution = null
+  if (link) {
+    const rect = link.getBoundingClientRect()
+    const style = win.getComputedStyle(link)
+    attribution = {
+      visible: visible(link, rect),
+      fontSize: parseFloat(style.fontSize),
+      color: style.color,
+      textDecorationLine: style.textDecorationLine,
+    }
+  }
+
+  return {
+    elements,
+    progress: activeChrome('[data-presentation-progress-dot]'),
+    toc: activeChrome('[data-presentation-toc-entry]'),
+    attribution,
+  }
+}
+/* c8 ignore stop */
+
+const intersects = (a, b) =>
+  Math.min(a.right, b.right) - Math.max(a.left, b.left) > 1 &&
+  Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top) > 1
+
+/** True when `a` is an ancestor of `b` in the DOM. */
+const isAncestor = (a, b) => b.path.startsWith(`${a.path}/`)
+
+function overlapWarnings(elements, step) {
+  const warnings = []
+  for (let i = 0; i < elements.length; i++) {
+    for (let j = i + 1; j < elements.length; j++) {
+      const a = elements[i]
+      const b = elements[j]
+      if (a.allow || b.allow) continue
+      if (isAncestor(a, b) || isAncestor(b, a)) continue
+      if (!intersects(a.rect, b.rect)) continue
+      warnings.push({
+        step,
+        kind: 'overlap',
+        message: `${a.label} overlaps ${b.label}; fix the collision or mark an intentional overlap with data-presentation-allow-overlap`,
+      })
+    }
+  }
+  return warnings
+}
+
+function sameSignature(a, b) {
+  return Object.keys(a).every((key) => a[key] === b[key])
+}
+
+function indistinct(chrome) {
+  if (!chrome || chrome.inactive.length === 0) return false
+  const tally = new Map()
+  for (const sig of chrome.inactive) {
+    const key = JSON.stringify(sig)
+    tally.set(key, (tally.get(key) ?? 0) + 1)
+  }
+  const [modal] = [...tally.entries()].sort((x, y) => y[1] - x[1])
+  return sameSignature(chrome.active, JSON.parse(modal[0]))
+}
+
+/** Advisory warnings for one settled step; never affects pass/fail. */
+export function analyzeSnapshot(snapshot, step) {
+  const warnings = overlapWarnings(snapshot.elements, step)
+  for (const [name, chrome, hook] of [
+    ['progress indicator', snapshot.progress, '[data-presentation-progress-dot][data-presentation-active]'],
+    ['table-of-contents entry', snapshot.toc, '[data-presentation-toc-entry][data-presentation-active]'],
+  ]) {
+    if (indistinct(chrome)) {
+      warnings.push({
+        step,
+        kind: 'active-chrome',
+        message: `active ${name} looks the same as inactive ones; style ${hook} (or [aria-current]) in presentation CSS`,
+      })
+    }
+  }
+  const attribution = snapshot.attribution
+  const hint = 'style [data-presentation-attribution] in presentation CSS or pass the attribution option'
+  if (!attribution || !attribution.visible) {
+    warnings.push({ step, kind: 'attribution', message: `attribution is missing or hidden; ${hint}` })
+  } else {
+    if (attribution.fontSize < MIN_ATTRIBUTION_PX) {
+      warnings.push({ step, kind: 'attribution', message: `attribution text is ${attribution.fontSize}px (under ${MIN_ATTRIBUTION_PX}px); ${hint}` })
+    }
+    if (attribution.color === BROWSER_DEFAULT_LINK_COLOR && attribution.textDecorationLine.includes('underline')) {
+      warnings.push({ step, kind: 'attribution', message: `attribution uses the browser-default link style; ${hint}` })
+    }
+  }
+  return warnings
+}
+
+export function formatWarning(warning) {
+  return `WARN step ${String(warning.step).padStart(2, '0')} [${warning.kind}]: ${warning.message}`
+}
diff --git a/scripts/lib/inspect-args.mjs b/scripts/lib/inspect-args.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e7b74bb2abf960166992fb103a5b493060c93813
--- /dev/null
+++ b/scripts/lib/inspect-args.mjs
@@ -0,0 +1,48 @@
+import path from 'node:path'
+
+export const DEFAULTS = { viewport: { width: 1440, height: 900 }, settleMs: 900, outDir: 'artifacts/inspection' }
+
+/** Parse CLI arguments: `<slug> [--viewport WxH] [--settle-ms N] [--out DIR] [--no-build]`. */
+export function parseArgs(argv, root) {
+  const options = { slug: undefined, viewport: { ...DEFAULTS.viewport }, settleMs: DEFAULTS.settleMs, outDir: DEFAULTS.outDir, build: true }
+  for (let i = 0; i < argv.length; i++) {
+    const arg = argv[i]
+    const value = () => {
+      const next = argv[++i]
+      if (next === undefined) throw new Error(`${arg} needs a value`)
+      return next
+    }
+    if (arg === '--viewport') {
+      const match = /^(\d+)x(\d+)$/.exec(value())
+      if (!match) throw new Error('--viewport expects WIDTHxHEIGHT, for example 390x844')
+      options.viewport = { width: Number(match[1]), height: Number(match[2]) }
+    } else if (arg === '--settle-ms') {
+      const ms = Number(value())
+      if (!Number.isFinite(ms) || ms < 0) throw new Error('--settle-ms expects a non-negative number')
+      options.settleMs = ms
+    } else if (arg === '--out') {
+      options.outDir = value()
+    } else if (arg === '--no-build') {
+      options.build = false
+    } else if (arg.startsWith('--')) {
+      throw new Error(`unknown option ${arg}`)
+    } else if (options.slug === undefined) {
+      options.slug = arg
+    } else {
+      throw new Error(`unexpected argument ${arg}`)
+    }
+  }
+  if (!options.slug) throw new Error('usage: npm run inspect -- <slug> [--viewport WxH] [--settle-ms N] [--out DIR] [--no-build]')
+  if (!/^[a-z0-9][a-z0-9-]*$/.test(options.slug)) throw new Error(`invalid presentation slug "${options.slug}"`)
+  const resolved = path.resolve(root, options.outDir)
+  const relative = path.relative(root, resolved)
+  if (relative.startsWith('..') || path.isAbsolute(relative)) {
+    throw new Error('--out must stay inside the project')
+  }
+  options.outDir = resolved
+  return options
+}
+
+export function screenshotPath(outDir, slug, index) {
+  return path.join(outDir, slug, `step-${String(index + 1).padStart(2, '0')}.png`)
+}
diff --git a/scripts/lib/inspect-run.mjs b/scripts/lib/inspect-run.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d8fe9431119857d7b54cd20d94a71b527fcfc88f
--- /dev/null
+++ b/scripts/lib/inspect-run.mjs
@@ -0,0 +1,70 @@
+import { mkdir } from 'node:fs/promises'
+import path from 'node:path'
+import { analyzeSnapshot, collectSnapshot, formatWarning } from './diagnostics.mjs'
+import { parseArgs, screenshotPath } from './inspect-args.mjs'
+import { HOST, waitForStepIndex } from './preview.mjs'
+
+/**
+ * Capture every step of a registered presentation and print advisory
+ * warnings. Resolves to the process exit code: warnings never change it,
+ * a capture failure does.
+ */
+export async function runInspect(argv, deps) {
+  const { root, log, warn = console.log, error, build, startPreview, launchBrowser, readRegistry } = deps
+  let preview
+  let browser
+  try {
+    const options = parseArgs(argv, root)
+    if (!readRegistry(root).some((entry) => entry.slug === options.slug)) {
+      throw new Error(`"${options.slug}" is not registered in src/presentations/index.ts`)
+    }
+    if (options.build) {
+      log('npm run build')
+      const result = await build(root)
+      if (result.code !== 0) {
+        throw new Error(`npm run build failed\n${result.output.trim().split('\n').slice(-25).join('\n')}`)
+      }
+    }
+
+    preview = await startPreview(root, log)
+    browser = await launchBrowser()
+    const page = await browser.newPage({ viewport: options.viewport })
+    const url = `http://${HOST}:${new URL(preview.base).port}/${options.slug}`
+    log(`opening ${url} at ${options.viewport.width}x${options.viewport.height}`)
+    const pageErrors = []
+    page.on('pageerror', (pageError) => pageErrors.push(pageError.message))
+    page.on('console', (message) => message.type() === 'error' && pageErrors.push(message.text()))
+    await page.goto(url, { waitUntil: 'load' })
+    await page.waitForSelector('[data-step-count]', { timeout: 10_000 })
+    const count = Number(await page.locator('[data-presentation-root]').getAttribute('data-step-count'))
+    await mkdir(path.join(options.outDir, options.slug), { recursive: true })
+
+    let warnings = 0
+    for (let index = 0; index < count; index++) {
+      try {
+        await waitForStepIndex(page, index)
+      } catch (cause) {
+        const detail = pageErrors.length > 0 ? `; page reported: ${pageErrors.join(' | ')}` : ''
+        throw new Error(`step ${index + 1} did not become active${detail}`, { cause })
+      }
+      await page.waitForTimeout(options.settleMs)
+      const file = screenshotPath(options.outDir, options.slug, index)
+      await page.screenshot({ path: file })
+      log(`step ${index + 1}/${count} -> ${path.relative(root, file)}`)
+      const snapshot = await page.evaluate(`(${collectSnapshot.toString()})(document, window)`)
+      for (const warning of analyzeSnapshot(snapshot, index + 1)) {
+        warnings++
+        warn(formatWarning(warning))
+      }
+      if (index < count - 1) await page.keyboard.press('ArrowRight')
+    }
+    log(`captured ${count} step(s); ${warnings} advisory warning(s)`)
+    return 0
+  } catch (failure) {
+    error(`inspect failed: ${failure.message}`)
+    return 1
+  } finally {
+    await browser?.close().catch(() => {})
+    await preview?.stop()
+  }
+}
diff --git a/scripts/lib/preview.mjs b/scripts/lib/preview.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4d6a37bda9d1442649463af185abe8d4bd7c6cfd
--- /dev/null
+++ b/scripts/lib/preview.mjs
@@ -0,0 +1,140 @@
+import { spawn } from 'node:child_process'
+import { readFileSync } from 'node:fs'
+import { createRequire } from 'node:module'
+import { createServer } from 'node:net'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+/** Deterministic IPv4 loopback so runs never depend on hostname resolution. */
+export const HOST = '127.0.0.1'
+
+export function projectRoot(metaUrl) {
+  return path.resolve(path.dirname(fileURLToPath(metaUrl)), '..')
+}
+
+export class PhaseError extends Error {
+  constructor(phase, message) {
+    super(message)
+    this.phase = phase
+  }
+}
+
+export function freePort() {
+  return new Promise((resolve, reject) => {
+    const server = createServer()
+    server.once('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+}
+
+/** Top-level object literals of the first array in `source`, found by brace matching. */
+function arrayObjects(source) {
+  const declaration = /presentations[^=]*=\s*\[/.exec(source)
+  if (!declaration) return []
+  const start = declaration.index + declaration[0].length - 1
+  const objects = []
+  let depth = 0
+  let from = -1
+  let quote = null
+  for (let i = start + 1; i < source.length; i++) {
+    const ch = source[i]
+    if (quote) {
+      if (ch === '\\') i++
+      else if (ch === quote) quote = null
+    } else if (ch === "'" || ch === '"' || ch === '`') quote = ch
+    else if (ch === '{') {
+      if (depth++ === 0) from = i
+    } else if (ch === '}') {
+      if (--depth === 0) objects.push(source.slice(from, i + 1))
+    } else if (ch === ']' && depth === 0) break
+  }
+  return objects
+}
+
+/** Registered presentations, read from the explicit registry source (property order does not matter). */
+export function readRegistry(root) {
+  const source = readFileSync(path.join(root, 'src/presentations/index.ts'), 'utf8')
+  const entries = []
+  for (const object of arrayObjects(source)) {
+    const slug = /\bslug:\s*(['"])(.+?)\1/.exec(object)
+    const title = /\btitle:\s*(['"])(.+?)\1/.exec(object)
+    if (slug && title) entries.push({ slug: slug[2], title: title[2] })
+  }
+  return entries
+}
+
+export function run(command, args, options = {}) {
+  return new Promise((resolve) => {
+    const child = spawn(command, args, { stdio: ['ignore', 'pipe', 'pipe'], ...options })
+    let output = ''
+    child.stdout.on('data', (chunk) => (output += chunk))
+    child.stderr.on('data', (chunk) => (output += chunk))
+    child.on('error', (error) => resolve({ code: 1, output: output + String(error) }))
+    child.on('close', (code) => resolve({ code: code ?? 1, output }))
+  })
+}
+
+export function runBuild(root) {
+  return run('npm', ['run', 'build'], { cwd: root })
+}
+
+/** Starts `vite preview` on the loopback host and waits until it answers. */
+export async function startPreview(root, log = () => {}) {
+  const require = createRequire(path.join(root, 'package.json'))
+  const viteBin = path.join(path.dirname(require.resolve('vite/package.json')), 'bin/vite.js')
+  const port = await freePort()
+  const base = `http://${HOST}:${port}`
+  const child = spawn(
+    process.execPath,
+    [viteBin, 'preview', '--host', HOST, '--port', String(port), '--strictPort'],
+    { cwd: root, stdio: ['ignore', 'pipe', 'pipe'] },
+  )
+  let output = ''
+  child.stdout.on('data', (chunk) => (output += chunk))
+  child.stderr.on('data', (chunk) => (output += chunk))
+  let exited = false
+  const exit = new Promise((resolve) => {
+    child.on('exit', () => {
+      exited = true
+      resolve()
+    })
+  })
+  const stop = async () => {
+    if (!exited) {
+      child.kill('SIGTERM')
+      const timer = setTimeout(() => child.kill('SIGKILL'), 3000)
+      await exit
+      clearTimeout(timer)
+    }
+  }
+  log(`preview listening on ${base}`)
+  log(`readiness probe ${base}/`)
+  const deadline = Date.now() + 30_000
+  for (;;) {
+    if (exited) throw new PhaseError('preview', `preview exited early:\n${output.trim()}`)
+    try {
+      const response = await fetch(`${base}/`, { signal: AbortSignal.timeout(2000) })
+      if (response.ok) break
+    } catch {
+      // not listening yet
+    }
+    if (Date.now() > deadline) {
+      await stop()
+      throw new PhaseError('preview', 'preview did not become ready within 30s')
+    }
+    await new Promise((resolve) => setTimeout(resolve, 150))
+  }
+  return { base, stop, pid: child.pid }
+}
+
+/** Resolves once the public `data-step-index` hook reads `index`; rejects after the timeout. */
+export function waitForStepIndex(page, index, timeout = 5000) {
+  return page.waitForFunction(
+    (i) => document.querySelector('[data-step-index]')?.getAttribute('data-step-index') === String(i),
+    index,
+    { timeout },
+  )
+}
