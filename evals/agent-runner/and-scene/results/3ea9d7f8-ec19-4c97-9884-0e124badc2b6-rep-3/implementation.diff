+import { ATTRIBUTION_LABEL, ATTRIBUTION_STRIP, ATTRIBUTION_URL } from '../constants'
+
+export interface AttributionOptions {
+  href?: string
+  label?: string
+}
+
+export function Attribution({ href = ATTRIBUTION_URL, label = ATTRIBUTION_LABEL }: AttributionOptions) {
+  return (
+    <a
+      data-presentation-attribution=""
+      href={href}
+      target="_blank"
+      rel="noreferrer noopener"
+      style={{
+        position: 'absolute',
+        right: 0,
+        bottom: 0,
+        height: ATTRIBUTION_STRIP,
+        display: 'flex',
+        alignItems: 'center',
+      }}
+    >
+      {label}
+    </a>
+  )
+}
diff --git a/src/presentation-kit/chrome/Footer.tsx b/src/presentation-kit/chrome/Footer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..e96a2e33a56c8e57fb4253ce25c3571b83590990
--- /dev/null
+++ b/src/presentation-kit/chrome/Footer.tsx
@@ -0,0 +1,79 @@
+import { ATTRIBUTION_STRIP, type PresentationMode } from '../constants'
+import type { StepMeta } from '../types'
+
+export interface FooterProps {
+  mode: PresentationMode
+  steps: readonly StepMeta[]
+  index: number
+  onGoTo: (index: number) => void
+  onPrev: () => void
+  onNext: () => void
+}
+
+export function Footer({ mode, steps, index, onGoTo, onPrev, onNext }: FooterProps) {
+  const active = steps[index]
+  return (
+    <footer
+      data-presentation-footer=""
+      style={{
+        position: 'absolute',
+        left: 0,
+        right: 0,
+        bottom: ATTRIBUTION_STRIP,
+        display: 'flex',
+        flexDirection: 'column',
+        justifyContent: 'flex-end',
+        overflow: 'hidden',
+      }}
+    >
+      {mode === 'present' ? (
+        <p
+          data-presentation-title=""
+          style={{ whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}
+        >
+          {active?.title}
+        </p>
+      ) : (
+        <p data-presentation-caption="">{active?.caption}</p>
+      )}
+      <nav
+        data-presentation-controls=""
+        aria-label="Step navigation"
+        style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', flexWrap: 'wrap' }}
+      >
+        {mode === 'browse' ? (
+          <button type="button" data-presentation-prev="" onClick={onPrev} disabled={index <= 0}>
+            Previous
+          </button>
+        ) : null}
+        <ol
+          data-presentation-progress=""
+          style={{ display: 'flex', alignItems: 'center', listStyle: 'none' }}
+        >
+          {steps.map((step, i) => (
+            <li key={step.id}>
+              <button
+                type="button"
+                data-presentation-progress-dot=""
+                aria-label={`Go to step ${i + 1}: ${step.title}`}
+                aria-current={i === index ? 'step' : undefined}
+                data-presentation-active={i === index ? 'true' : undefined}
+                onClick={() => onGoTo(i)}
+              />
+            </li>
+          ))}
+        </ol>
+        {mode === 'browse' ? (
+          <button
+            type="button"
+            data-presentation-next=""
+            onClick={onNext}
+            disabled={index >= steps.length - 1}
+          >
+            Next
+          </button>
+        ) : null}
+      </nav>
+    </footer>
+  )
+}
diff --git a/src/presentation-kit/chrome/Header.tsx b/src/presentation-kit/chrome/Header.tsx
