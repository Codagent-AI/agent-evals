+describe('generated package name', () => {
+  it.each([
+    ['/x/My Talks', 'my-talks'],
+    ['/x/Deck_V2', 'deck_v2'],
+    ['/x/.hidden', 'hidden'],
+    ['/x/日本語', 'presentations'],
