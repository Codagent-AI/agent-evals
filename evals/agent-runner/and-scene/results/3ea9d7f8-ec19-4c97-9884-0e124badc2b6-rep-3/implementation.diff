index 0000000000000000000000000000000000000000..97230fe899ab39ae23c02555f6130a38fc523f6b
--- /dev/null
+++ b/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,71 @@
+import { useCallback, useEffect, useState } from 'react'
+import type { PresentationMode } from './constants'
+import { clampIndex } from './steps'
+import { keyAction, swipeAction, type Point } from './navigation'
+
+export interface PresentationNav {
+  index: number
+  mode: PresentationMode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  toggleMode: () => void
+}
+
+/** Keyboard, touch and programmatic navigation; clamps at both ends. */
+export function usePresentationNav(
+  count: number,
+  initialMode: PresentationMode = 'browse',
+): PresentationNav {
+  const [rawIndex, setIndex] = useState(0)
+  const [mode, setMode] = useState(initialMode)
+  const index = clampIndex(rawIndex, count)
+
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, count)), [count])
+  const goTo = useCallback((target: number) => setIndex(clampIndex(target, count)), [count])
+  const toggleMode = useCallback(
+    () => setMode((m) => (m === 'browse' ? 'present' : 'browse')),
+    [],
+  )
+
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      const action = keyAction(event)
+      if (!action) return
+      event.preventDefault()
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else toggleMode()
+    }
+    let start: Point | null = null
+    const onTouchStart = (event: TouchEvent) => {
+      const touch = event.changedTouches[0]
+      start = touch ? { x: touch.clientX, y: touch.clientY } : null
+    }
+    const onTouchEnd = (event: TouchEvent) => {
+      const touch = event.changedTouches[0]
+      const from = start
+      start = null
+      if (!from || !touch) return
+      const action = swipeAction(from, { x: touch.clientX, y: touch.clientY })
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+    }
+    const onTouchCancel = () => {
+      start = null
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart)
+    window.addEventListener('touchend', onTouchEnd)
+    window.addEventListener('touchcancel', onTouchCancel)
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+      window.removeEventListener('touchcancel', onTouchCancel)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, next, prev, goTo, toggleMode }
+}
diff --git a/src/presentations/how-to-make-a-presentation/Scene.tsx b/src/presentations/how-to-make-a-presentation/Scene.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..ea0d682450801b1a86cf0a7dc510ac4a90f4c86d
--- /dev/null
+++ b/src/presentations/how-to-make-a-presentation/Scene.tsx
@@ -0,0 +1,66 @@
+import { Check, Route, Sparkles, User, type LucideIcon } from 'lucide-react'
+import { Arrow, Box, Emphasis, Frame, Label, SceneLayer, SymbolChip, type SceneProps } from '../../presentation-kit'
+import { entitiesThrough, type EntityDef } from './entities'
+
+export interface StoryPayload {
+  /** 1-based step; the visible entities are cumulative up to it. */
+  stage: number
+}
+
+const ICONS: Record<string, LucideIcon> = { you: User, skill: Sparkles, route: Route }
+
+function Entity({ def }: { def: EntityDef }) {
+  const geometry = 'x' in def ? { x: def.x, y: def.y, w: def.w, h: def.h } : {}
+  switch (def.kind) {
+    case 'node':
+      return (
+        <Box id={def.id} {...geometry} Icon={def.icon ? ICONS[def.icon] : undefined} className="hmp-node">
+          {def.text}
+        </Box>
+      )
+    case 'card':
+      return (
+        <Box id={def.id} {...geometry} className="hmp-card">
+          <span className="hmp-card-part" data-part="title">title</span>
+          <span className="hmp-card-part" data-part="caption">caption</span>
+          <span className="hmp-card-part" data-part="visual">visual</span>
+        </Box>
+      )
+    case 'ghost':
+      return <Box id={def.id} {...geometry} className="hmp-ghost">{def.text}</Box>
+    case 'tray':
+      return <Box id={def.id} {...geometry} className="hmp-tray" />
+    case 'chip':
+      return <SymbolChip id={def.id} {...geometry} className="hmp-chip">{def.text}</SymbolChip>
+    case 'arrow':
+      return <Arrow id={def.id} from={def.from} to={def.to} bidirectional={def.bidirectional} className="hmp-arrow" />
+    case 'label':
+      return <Label id={def.id} {...geometry} className="hmp-check-label">{def.text}</Label>
+    case 'check':
+      return (
+        <SymbolChip
+          id={def.id}
+          {...geometry}
+          Icon={Check}
+          className="hmp-check"
+          data-resolves={def.resolves.join(' ')}
+          data-presentation-allow-overlap=""
+        />
+      )
+    case 'flag':
+      return <Emphasis id={def.id} {...geometry} className="hmp-flag" />
+    case 'frame':
+      return <Frame id={def.id} {...geometry} className="hmp-frame" />
+  }
+}
+
+/** The one scene every step shares; only the payload's stage changes. */
+export function StoryScene({ payload }: SceneProps<StoryPayload>) {
+  return (
+    <SceneLayer>
+      {entitiesThrough(payload.stage).map((def) => (
+        <Entity key={def.id} def={def} />
+      ))}
+    </SceneLayer>
+  )
+}
