@@ -0,0 +1,53 @@
+import type { CSSProperties, HTMLAttributes } from 'react'
+import { EASE, LAYOUT_T } from '../constants'
+import { useEntrance } from '../entrance'
+
+/** Author-facing props of a node element: plain HTML attributes plus style hooks. */
+export type NodeHtmlProps<E extends HTMLElement> = Omit<
+  HTMLAttributes<E>,
+  'id' | 'style' | 'onAnimationStart' | 'onDrag' | 'onDragStart' | 'onDragEnd'
+> & { style?: CSSProperties }
+
+/** Optional literal canvas geometry shared by every node primitive. */
+export interface Geometry {
+  x?: number
+  y?: number
+  w?: number
+  h?: number
+}
+
+export interface EntityOptions extends Geometry {
+  /** Stable entity identity; doubles as the motion layoutId. */
+  id: string
+  kind: string
+  style?: CSSProperties
+  emphasis?: boolean
+}
+
+export function geometryStyle({ x, y, w, h }: Geometry): CSSProperties {
+  const style: CSSProperties = {}
+  if (x !== undefined || y !== undefined) style.position = 'absolute'
+  if (x !== undefined) style.left = x
+  if (y !== undefined) style.top = y
+  if (w !== undefined) style.width = w
+  if (h !== undefined) style.height = h
+  return style
+}
+
+/**
+ * Props shared by all entity elements: identity, hooks, geometry, layout
+ * morph transition and entrance/exit. Author className/style/data pass through
+ * the caller's own props.
+ */
+export function useEntityProps({ id, kind, style, emphasis, ...geometry }: EntityOptions) {
+  const entrance = useEntrance(id)
+  return {
+    layoutId: id,
+    ...entrance,
+    transition: { layout: { duration: LAYOUT_T, ease: EASE } },
+    'data-presentation-entity': id,
+    'data-presentation-node': kind,
+    ...(emphasis ? { 'data-presentation-emphasis': 'true' } : {}),
+    style: { ...geometryStyle(geometry), ...style },
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/steps.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/steps.ts
new file mode 100644
index 0000000000000000000000000000000000000000..938a889b8a2f5b823b89739e0fe2e2a0c4ba31ec
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/steps.ts
@@ -0,0 +1,61 @@
+import type { Step, StepMeta } from './types'
+
+export function clampIndex(index: number, count: number): number {
+  if (count <= 0) return 0
+  return Math.min(Math.max(Math.trunc(index) || 0, 0), count - 1)
+}
+
+/** On-screen step number, derived from position only. */
+export function formatStepNumber(index: number): string {
+  return String(index + 1).padStart(2, '0')
+}
+
+export interface EraSection {
+  era: string
+  firstIndex: number
+  indices: number[]
+}
+
+/** Consecutive steps sharing an era label form one section. */
+export function eraSections(steps: readonly StepMeta[]): EraSection[] {
+  const sections: EraSection[] = []
+  steps.forEach((step, index) => {
+    const last = sections[sections.length - 1]
+    if (last && last.era === step.era) last.indices.push(index)
+    else sections.push({ era: step.era, firstIndex: index, indices: [index] })
+  })
+  return sections
+}
+
+/** Problems that would make a step list unusable; empty when valid. */
+export function validateSteps(steps: readonly StepMeta[]): string[] {
+  const problems: string[] = []
+  const seen = new Set<string>()
+  steps.forEach((step, index) => {
+    for (const field of ['id', 'era', 'title', 'caption'] as const) {
+      if (typeof step[field] !== 'string' || step[field].trim() === '') {
+        problems.push(`step ${index + 1} has an empty ${field}`)
+      }
+    }
+    if (seen.has(step.id)) problems.push(`duplicate step id "${step.id}"`)
+    seen.add(step.id)
+  })
+  return problems
+}
+
+const sceneIds = new WeakMap<object, number>()
+let nextSceneId = 0
+
+/**
+ * Identity of the scene instance a step renders into. Steps with equal keys
+ * keep one mounted scene; anything else remounts and cross-fades.
+ */
+export function sceneKey(step: Pick<Step<unknown>, 'id' | 'groupKey'> & { Scene: object }): string {
+  if (!step.groupKey) return `step:${step.id}`
+  let id = sceneIds.get(step.Scene)
+  if (id === undefined) {
+    id = ++nextSceneId
+    sceneIds.set(step.Scene, id)
+  }
+  return `group:${step.groupKey}:${id}`
+}
