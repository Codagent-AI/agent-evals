index 0000000000000000000000000000000000000000..05cf13897ab5368e0efb33c8d95a42221a88e601
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,96 @@
+import type { ReactNode } from 'react'
+import { STAGE_LAYOUT, type PresentationMode } from './constants'
+import { tocVisible } from './fitScale'
+import { Attribution, type AttributionOptions } from './chrome/Attribution'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { Toc } from './chrome/Toc'
+import { Stage } from './Stage'
+import type { Step } from './types'
+import { useFitScale } from './useFitScale'
+import { usePresentationNav } from './usePresentationNav'
+
+export interface PresentationProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  title: string
+  initialMode?: PresentationMode
+  className?: string
+  /** Host-provided top-left branding; none by default. */
+  brand?: ReactNode
+  /** Override the default attribution, or pass false to omit it. */
+  attribution?: AttributionOptions | false
+  designWidth?: number
+  designHeight?: number
+}
+
+/** Composes stage, chrome and navigation for an ordered list of steps. */
+export function Presentation<TPayload>({
+  steps,
+  title,
+  initialMode = 'browse',
+  className,
+  brand,
+  attribution,
+  designWidth,
+  designHeight,
+}: PresentationProps<TPayload>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const { mode, index } = nav
+  const { viewport, scale } = useFitScale(mode, designWidth, designHeight)
+  const step = steps[index]
+  if (!step) return null
+  const layout = STAGE_LAYOUT[mode]
+  const showToc = tocVisible(mode, viewport.width)
+
+  return (
+    <div
+      role="region"
+      aria-label={title}
+      className={className}
+      data-presentation-root=""
+      data-presentation-mode={mode}
+      data-step-count={steps.length}
+      data-step-index={index}
+      data-step-id={step.id}
+      style={{ position: 'fixed', left: 0, top: 0, right: 0, bottom: 0, overflow: 'hidden' }}
+    >
+      <Header
+        mode={mode}
+        index={index}
+        era={step.era}
+        title={step.title}
+        brand={brand}
+        onToggleMode={nav.toggleMode}
+      />
+      {showToc ? <Toc steps={steps} index={index} onGoTo={nav.goTo} /> : null}
+      <div
+        data-presentation-stage-region=""
+        style={{
+          position: 'absolute',
+          top: layout.top,
+          bottom: layout.bottom,
+          left: layout.side + (showToc ? layout.toc : 0),
+          right: layout.side,
+        }}
+      >
+        <Stage
+          key={mode}
+          step={step}
+          index={index}
+          scale={scale}
+          designWidth={designWidth}
+          designHeight={designHeight}
+        />
+      </div>
+      <Footer
+        mode={mode}
+        steps={steps}
+        index={index}
+        onGoTo={nav.goTo}
+        onPrev={nav.prev}
+        onNext={nav.next}
+      />
+      {attribution === false ? null : <Attribution {...attribution} />}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a37d18eda134708b65c3928ab53cae293226371a
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,67 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { useEffect, useState } from 'react'
+import { DESIGN_H, DESIGN_W, ENTER_T, EASE } from './constants'
+import { EntityRegistry, EntityRegistryContext } from './entrance'
+import { sceneKey } from './steps'
+import type { Step } from './types'
+
+export interface StageProps<TPayload> {
+  step: Step<TPayload>
+  index: number
+  scale: number
+  designWidth?: number
+  designHeight?: number
+}
+
+/**
+ * Fixed design canvas scaled uniformly to fit. The active step's scene is
+ * hosted under one LayoutGroup with overlapping presence, so shared layoutIds
+ * morph; grouped steps keep a single mounted scene and only change payload.
+ */
+export function Stage<TPayload>({
+  step,
+  index,
+  scale,
+  designWidth = DESIGN_W,
+  designHeight = DESIGN_H,
+}: StageProps<TPayload>) {
+  const [registry] = useState(() => new EntityRegistry())
+  useEffect(() => {
+    registry.markStarted()
+  }, [registry])
+  const { Scene, payload, id, era, title, caption } = step
+  const meta = { id, era, title, caption }
+  return (
+    <EntityRegistryContext.Provider value={registry}>
+      <LayoutGroup>
+        <motion.div
+          data-presentation-stage=""
+          data-presentation-scale={scale}
+          style={{
+            position: 'absolute',
+            left: '50%',
+            top: '50%',
+            width: designWidth,
+            height: designHeight,
+            x: '-50%',
+            y: '-50%',
+            scale,
+          }}
+        >
+          <AnimatePresence initial={false}>
+            <motion.div
+              key={sceneKey(step)}
+              data-presentation-scene={step.groupKey ?? step.id}
+              initial={{ opacity: 0 }}
+              animate={{ opacity: 1, transition: { duration: ENTER_T, ease: EASE } }}
+              exit={{ opacity: 0, transition: { duration: ENTER_T, ease: EASE } }}
+              style={{ position: 'absolute', left: 0, top: 0, width: designWidth, height: designHeight }}
+            >
+              <Scene payload={payload} step={meta} index={index} />
+            </motion.div>
+          </AnimatePresence>
+        </motion.div>
+      </LayoutGroup>
+    </EntityRegistryContext.Provider>
+  )
+}
diff --git a/src/presentation-kit/chrome/Attribution.tsx b/src/presentation-kit/chrome/Attribution.tsx
