+          return (
+            <li key={`${section.firstIndex}:${section.era}`}>
+              <button
+                type="button"
+                data-presentation-toc-entry=""
+                aria-current={isActive ? 'step' : undefined}
+                data-presentation-active={isActive ? 'true' : undefined}
+                onClick={() => onGoTo(section.firstIndex)}
+              >
+                {section.era}
+              </button>
+            </li>
+          )
+        })}
+      </ol>
+    </nav>
+  )
