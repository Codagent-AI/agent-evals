index 0000000000000000000000000000000000000000..0c72b4e1d737b23fdd337362ed4a42323ffc95c1
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,94 @@
+import type { CSSProperties, ReactNode } from 'react'
+import { DESIGN_H, DESIGN_W } from './constants'
+import { dataHooks, type DataHooks } from './nodes/geometry'
+import { eraEntries, stepNumber } from './eras'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { Toc } from './chrome/Toc'
+import { Stage } from './Stage'
+import type { Canvas, Mode, Step } from './types'
+import { useFitScale } from './useFitScale'
+import { useIsWide } from './useMediaQuery'
+import { usePresentationNav } from './usePresentationNav'
+import { usePreviousDistinct } from './usePreviousDistinct'
+
+export const ATTRIBUTION_URL = 'https://github.com/Codagent-AI/and-scene'
+
+export interface PresentationProps<TPayload> extends DataHooks {
+  steps: readonly Step<TPayload>[]
+  title: string
+  initialMode?: Mode
+  /** Overrides the 880 × 380 design canvas. */
+  canvas?: Canvas
+  /** `false` hides the default attribution; a node replaces it. */
+  attribution?: ReactNode | false
+  /** Host-provided top-left brand; none by default. */
+  brand?: ReactNode
+  className?: string
+  style?: CSSProperties
+}
+
+function DefaultAttribution() {
+  return (
+    <a
+      data-presentation-attribution=""
+      href={ATTRIBUTION_URL}
+      target="_blank"
+      rel="noopener noreferrer"
+      style={{ position: 'fixed', right: 0, bottom: 0 }}
+    >
+      made by and-scene
+    </a>
+  )
+}
+
+export function Presentation<TPayload>({
+  steps,
+  title,
+  initialMode = 'browse',
+  canvas,
+  attribution,
+  brand,
+  className,
+  style,
+  ...hooks
+}: PresentationProps<TPayload>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const scale = useFitScale(nav.mode, canvas ?? { width: DESIGN_W, height: DESIGN_H })
+  const wide = useIsWide()
+  const step = steps[nav.index]
+  const previousIndex = usePreviousDistinct(nav.index)
+  const showAttribution =
+    attribution === false ? null : attribution === undefined ? <DefaultAttribution /> : attribution
+  const marker = `${stepNumber(nav.index)} / ${steps.length}`
+
+  return (
+    <div
+      {...dataHooks(hooks)}
+      data-presentation-root=""
+      className={className}
+      style={style}
+      data-presentation-title-text={title}
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      data-step-id={step.id}
+      {...nav.touchHandlers}
+    >
+      <Header mode={nav.mode} marker={marker} title={title} brand={brand} onToggleMode={nav.toggleMode} />
+      {nav.mode === 'browse' && wide ? (
+        <Toc entries={eraEntries(steps)} activeEra={step.era} onGoTo={nav.goTo} />
+      ) : null}
+      <Stage step={step} previous={previousIndex === undefined ? undefined : steps[previousIndex]?.payload} index={nav.index} scale={scale} mode={nav.mode} canvas={canvas} />
+      <Footer
+        mode={nav.mode}
+        steps={steps}
+        index={nav.index}
+        attribution={showAttribution}
+        onGoTo={nav.goTo}
+        onPrev={nav.prev}
+        onNext={nav.next}
+      />
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..ed1448bd5e9e81f5a15695d0df2da87affec5141
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,64 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import type { CSSProperties } from 'react'
+import { DESIGN_H, DESIGN_W, EXIT_T } from './constants'
+import { sceneKey } from './scene-key'
+import { dataHooks, type DataHooks } from './nodes/geometry'
+import type { Canvas, Mode, SceneProps, Step } from './types'
+
+interface StageProps<TPayload> extends DataHooks {
+  step: Step<TPayload>
+  /** Payload of the step displayed before this one. */
+  previous?: TPayload
+  index: number
+  scale: number
+  mode: Mode
+  canvas?: Canvas
+  className?: string
+  style?: CSSProperties
+}
+
+export function Stage<TPayload>({ step, previous, index, scale, mode, canvas, className, style, ...hooks }: StageProps<TPayload>) {
+  const width = canvas?.width ?? DESIGN_W
+  const height = canvas?.height ?? DESIGN_H
+  const { Scene, payload, ...meta } = step
+  const props: SceneProps<TPayload> = { payload, previous, step: meta, index }
+  return (
+    <div
+      {...dataHooks(hooks)}
+      data-presentation-stage=""
+      data-presentation-mode={mode}
+      className={className}
+      style={{ position: 'relative', width: width * scale, height: height * scale, ...style }}
+    >
+      <div
+        data-presentation-canvas=""
+        data-presentation-scale={scale}
+        style={{
+          position: 'absolute',
+          top: 0,
+          left: 0,
+          width,
+          height,
+          transform: `scale(${scale})`,
+          transformOrigin: 'top left',
+        }}
+      >
+        {/* Keyed by mode: a mode switch remounts the scene instead of morphing entities across the geometry change. */}
+        <LayoutGroup key={mode}>
+          <AnimatePresence>
+            <motion.div
+              key={sceneKey(step)}
+              data-presentation-scene=""
+              style={{ position: 'absolute', inset: 0 }}
+              initial={{ opacity: 0 }}
+              animate={{ opacity: 1 }}
+              exit={{ opacity: 0, transition: { duration: EXIT_T } }}
+            >
+              <Scene {...props} />
+            </motion.div>
+          </AnimatePresence>
+        </LayoutGroup>
+      </div>
+    </div>
+  )
+}
