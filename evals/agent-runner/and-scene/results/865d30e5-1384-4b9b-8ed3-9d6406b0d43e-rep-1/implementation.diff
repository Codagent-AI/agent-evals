diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/nodes/geometry.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/nodes/geometry.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1bfa5aa3e9027109478e1a88033916102d0b4bae
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/nodes/geometry.ts
@@ -0,0 +1,51 @@
+import { useState, type CSSProperties } from 'react'
+import { ENTER_DELAY, ENTER_T } from '../constants'
+
+export interface Geometry {
+  x?: number
+  y?: number
+  w?: number
+  h?: number
+}
+
+/** Consumer `data-*` attributes passed through to the rendered element. */
+export type DataHooks = { [key: `data-${string}`]: string | undefined }
+
+/** Keeps only `data-*` attributes; kit hooks are spread after these so they always win. */
+export function dataHooks(props: DataHooks): DataHooks {
+  return Object.fromEntries(Object.entries(props).filter(([key]) => key.startsWith('data-')))
+}
+
+/** Absolute placement inside the fixed design canvas; only layout, no visual style. */
+export function geometryStyle({ x, y, w, h }: Geometry, style?: CSSProperties): CSSProperties {
+  const positioned = x !== undefined || y !== undefined
+  return {
+    ...(positioned ? { position: 'absolute' as const } : null),
+    left: x,
+    top: y,
+    width: w,
+    height: h,
+    ...style,
+  }
+}
+
+/**
+ * Newcomer entrance for a node that persists in place: fades in after persisting entities
+ * settle. Toggling `enter` never remounts the node, so continuing entities keep their identity.
+ *
+ * A node that has been a newcomer keeps an explicit opacity target once `enter` turns off.
+ * Dropping `animate` mid-entrance (a quick jump away and back) would cancel the delayed fade and
+ * leave the node at its initial opacity 0; an unchanged target lets the fade run to completion.
+ * Nodes that never entered carry no animation props at all.
+ */
+export function useEnterMotion(enter: boolean | undefined) {
+  const [entered, setEntered] = useState(Boolean(enter))
+  if (enter && !entered) setEntered(true)
+  if (enter) {
+    return {
+      initial: { opacity: 0 },
+      animate: { opacity: 1, transition: { duration: ENTER_T, delay: ENTER_DELAY } },
+    }
+  }
+  return entered ? { animate: { opacity: 1 } } : null
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/scene-key.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/scene-key.ts
new file mode 100644
index 0000000000000000000000000000000000000000..27eaa5948711db6fd949bcbbc4fe5f96e27eebac
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/scene-key.ts
@@ -0,0 +1,15 @@
+const sceneIds = new WeakMap<object, number>()
+let nextSceneId = 0
+function sceneId(Scene: object): number {
+  let id = sceneIds.get(Scene)
+  if (id === undefined) {
+    id = nextSceneId++
+    sceneIds.set(Scene, id)
+  }
+  return id
+}
+
+/** Steps with the same key share one mounted scene; otherwise the presence host swaps scenes. */
+export function sceneKey(step: { id: string; groupKey?: string; Scene: object }): string {
+  return step.groupKey ? `group:${step.groupKey}:${sceneId(step.Scene)}` : `step:${step.id}`
+}
