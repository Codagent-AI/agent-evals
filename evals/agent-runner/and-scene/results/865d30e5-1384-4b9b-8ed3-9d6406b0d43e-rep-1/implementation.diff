+    return {
+      media: query,
+      onchange: null,
+      get matches() {
+        return window.innerWidth >= min
+      },
+      addEventListener: (_type: string, cb: () => void) => {
+        listeners.push(cb)
+      },
+      removeEventListener: (_type: string, cb: () => void) => {
+        listeners = listeners.filter((l) => l !== cb)
+      },
+      addListener() {},
+      removeListener() {},
+      dispatchEvent: () => false,
+    }
+  }) as unknown as typeof window.matchMedia
+})
+
+afterEach(() => {
