+import type { ComponentType } from 'react'
+
+export type Mode = 'browse' | 'present'
+
+/** Per-step narration and identity (no diagram state). */
+export interface StepMeta {
+  /** Stable identity; never used for numbering. */
+  id: string
+  /** Section/era label; the table of contents lists distinct eras. */
+  era: string
+  /** One-line presenter title. */
+  title: string
+  /** Paragraph browse caption. */
+  caption: string
+}
+
+export interface SceneProps<TPayload = undefined> {
+  /** Diagram state shown while this step is active. */
+  payload: TPayload
+  /**
+   * Payload of the step displayed immediately before this one (undefined on first display).
+   * Newcomers are the entities in `payload` that are absent from `previous`.
+   */
+  previous?: TPayload
+  step: StepMeta
+  /** Zero-based position of the active step. */
+  index: number
+}
+
+export interface Step<TPayload = undefined> extends StepMeta {
+  /** Steps with the same groupKey and Scene share one persistent scene instance. */
+  groupKey?: string
+  Scene: ComponentType<SceneProps<TPayload>>
+  payload: TPayload
+}
+
+export interface Canvas {
+  width: number
+  height: number
+}
+
+export interface FitGeometry {
+  /** Horizontal space reserved on each side of the canvas, in CSS px. */
+  insetX: number
+  /** Space reserved above the canvas (header), in CSS px. */
+  insetTop: number
+  /** Space reserved below the canvas (footer), in CSS px. */
+  insetBottom: number
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2ae7c1a840d93149cd6cc16b2fa38cc4f5fff1e5
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,33 @@
+import { useEffect, useState } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT } from './constants'
+import type { Canvas, Mode } from './types'
+
+export interface Viewport {
+  width: number
+  height: number
+}
+
+/** Uniform scale that fits the design canvas into the viewport minus the mode's insets. */
+export function computeFitScale(
+  viewport: Viewport,
+  mode: Mode,
+  canvas: Canvas = { width: DESIGN_W, height: DESIGN_H },
+): number {
+  const g = STAGE_LAYOUT[mode]
+  const availW = viewport.width - g.insetX * 2
+  const availH = viewport.height - g.insetTop - g.insetBottom
+  return Math.max(MIN_SCALE, Math.min(availW / canvas.width, availH / canvas.height))
+}
+
+const readViewport = (): Viewport => ({ width: window.innerWidth, height: window.innerHeight })
+
+export function useFitScale(mode: Mode, canvas?: Canvas): number {
+  const [viewport, setViewport] = useState<Viewport>(readViewport)
+  useEffect(() => {
+    const onResize = () => setViewport(readViewport())
+    onResize()
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return computeFitScale(viewport, mode, canvas)
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useMediaQuery.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useMediaQuery.ts
new file mode 100644
index 0000000000000000000000000000000000000000..26675bf812d765721968d00d1c9d4b4cd2d7a1b5
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useMediaQuery.ts
@@ -0,0 +1,23 @@
+import { useEffect, useState } from 'react'
+import { WIDE_VIEWPORT_PX } from './constants'
+
+const WIDE_QUERY = `(min-width: ${WIDE_VIEWPORT_PX}px)`
+
+const read = () =>
+  typeof window.matchMedia === 'function'
+    ? window.matchMedia(WIDE_QUERY).matches
+    : window.innerWidth >= WIDE_VIEWPORT_PX
+
+/** True on wide viewports, read through matchMedia so the kit needs no CSS. */
+export function useIsWide(): boolean {
+  const [wide, setWide] = useState(read)
+  useEffect(() => {
+    if (typeof window.matchMedia !== 'function') return
+    const mql = window.matchMedia(WIDE_QUERY)
+    const onChange = () => setWide(mql.matches)
+    onChange()
+    mql.addEventListener('change', onChange)
+    return () => mql.removeEventListener('change', onChange)
+  }, [])
+  return wide
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..116351fbbc33fa2b7a9d53c827ce43e53423c0ee
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,78 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import type { TouchEvent } from 'react'
+import { SWIPE_MIN_PX } from './constants'
+import type { Mode } from './types'
+
+export const clampIndex = (index: number, count: number) =>
+  Math.min(Math.max(index, 0), Math.max(count - 1, 0))
+
+const INTERACTIVE =
+  'button, a[href], input, select, textarea, summary, [contenteditable]:not([contenteditable="false"]), [role="button"], [role="link"], [role="tab"]'
+
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE) !== null
+}
+
+/** +1 for a left swipe, -1 for a right swipe, 0 when the gesture is not a horizontal swipe. */
+export function swipeDelta(dx: number, dy: number): -1 | 0 | 1 {
+  if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) <= Math.abs(dy)) return 0
+  return dx < 0 ? 1 : -1
+}
+
+const KEY_DELTA: Record<string, 1 | -1> = {
+  ArrowRight: 1,
+  ' ': 1,
+  PageDown: 1,
+  ArrowLeft: -1,
+  PageUp: -1,
+}
+
+export function usePresentationNav(count: number, initialMode: Mode = 'browse') {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const touchStart = useRef<{ x: number; y: number } | null>(null)
+
+  const goTo = useCallback(
+    (target: number) => setIndex(clampIndex(target, count)),
+    [count],
+  )
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, count)), [count])
+  const toggleMode = useCallback(
+    () => setMode((m) => (m === 'browse' ? 'present' : 'browse')),
+    [],
+  )
+
+  useEffect(() => {
+    const onKeyDown = (e: KeyboardEvent) => {
+      if (e.ctrlKey || e.metaKey || e.altKey || isInteractiveTarget(e.target)) return
+      if (e.key.toLowerCase() === 'p') {
+        toggleMode()
+        return
+      }
+      const delta = KEY_DELTA[e.key]
+      if (!delta) return
+      e.preventDefault()
+      setIndex((i) => clampIndex(i + delta, count))
+    }
+    window.addEventListener('keydown', onKeyDown)
+    return () => window.removeEventListener('keydown', onKeyDown)
+  }, [count, toggleMode])
+
+  const touchHandlers = {
+    onTouchStart: (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      touchStart.current = t ? { x: t.clientX, y: t.clientY } : null
+    },
+    onTouchEnd: (e: TouchEvent) => {
+      const start = touchStart.current
+      const t = e.changedTouches[0]
+      touchStart.current = null
+      if (!start || !t) return
+      const delta = swipeDelta(t.clientX - start.x, t.clientY - start.y)
+      if (delta) setIndex((i) => clampIndex(i + delta, count))
+    },
+  }
+
+  return { index: clampIndex(index, count), mode, goTo, next, prev, toggleMode, touchHandlers }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePreviousDistinct.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePreviousDistinct.ts
