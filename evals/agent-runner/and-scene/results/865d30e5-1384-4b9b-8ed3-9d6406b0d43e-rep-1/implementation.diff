+import { Suspense, createElement } from 'react'
+import { Landing } from './Landing'
+import type { PresentationEntry } from './presentations/registry'
+import { pageFor, resolveEntry } from './routes'
+
+interface RouterProps {
+  pathname: string
+  registry: readonly PresentationEntry[]
+}
+
+/** "/" and unknown paths render Landing; a known slug lazy-loads its presentation. */
+export function Router({ pathname, registry }: RouterProps) {
+  const entry = resolveEntry(pathname, registry)
+  if (!entry) return <Landing registry={registry} />
+  return (
+    <Suspense fallback={<p data-presentation-loading="">Loading…</p>}>
+      {createElement(pageFor(entry))}
+    </Suspense>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/routes.ts b/skills/presentation/templates/bootstrap/src/routes.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6f4f54ae72797578999737d7594c0f1d3501d12c
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/routes.ts
@@ -0,0 +1,23 @@
+import { lazy } from 'react'
+import type { ComponentType } from 'react'
+import type { PresentationEntry } from './presentations/registry'
+
+export function resolveEntry(
+  pathname: string,
+  registry: readonly PresentationEntry[],
+): PresentationEntry | undefined {
+  const slug = pathname.replace(/^\/+|\/+$/g, '')
+  return slug ? registry.find((e) => e.slug === slug) : undefined
+}
+
+const pages = new WeakMap<PresentationEntry, ComponentType>()
+
+/** One stable lazy component per registry entry, so re-renders never reset it. */
+export function pageFor(entry: PresentationEntry): ComponentType {
+  let page = pages.get(entry)
+  if (!page) {
+    page = lazy(entry.load)
+    pages.set(entry, page)
+  }
+  return page
+}
