@@ -0,0 +1,49 @@
+import type { ComponentType } from 'react'
+
+export type Mode = 'browse' | 'present'
+
+/** Per-step narration and identity (no diagram state). */
+export interface StepMeta {
+  /** Stable identity; never used for numbering. */
+  id: string
+  /** Section/era label; the table of contents lists distinct eras. */
+  era: string
+  /** One-line presenter title. */
+  title: string
+  /** Paragraph browse caption. */
+  caption: string
+}
+
+export interface SceneProps<TPayload = undefined> {
+  /** Diagram state shown while this step is active. */
+  payload: TPayload
+  /**
+   * Payload of the step displayed immediately before this one (undefined on first display).
+   * Newcomers are the entities in `payload` that are absent from `previous`.
+   */
+  previous?: TPayload
+  step: StepMeta
+  /** Zero-based position of the active step. */
+  index: number
+}
+
+export interface Step<TPayload = undefined> extends StepMeta {
+  /** Steps with the same groupKey and Scene share one persistent scene instance. */
+  groupKey?: string
+  Scene: ComponentType<SceneProps<TPayload>>
+  payload: TPayload
+}
+
+export interface Canvas {
+  width: number
+  height: number
+}
+
+export interface FitGeometry {
+  /** Horizontal space reserved on each side of the canvas, in CSS px. */
+  insetX: number
+  /** Space reserved above the canvas (header), in CSS px. */
+  insetTop: number
+  /** Space reserved below the canvas (footer), in CSS px. */
+  insetBottom: number
+}
diff --git a/src/presentation-kit/useFitScale.ts b/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2ae7c1a840d93149cd6cc16b2fa38cc4f5fff1e5
--- /dev/null
+++ b/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,33 @@
+import { useEffect, useState } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT } from './constants'
+import type { Canvas, Mode } from './types'
+
+export interface Viewport {
+  width: number
+  height: number
+}
+
+/** Uniform scale that fits the design canvas into the viewport minus the mode's insets. */
+export function computeFitScale(
+  viewport: Viewport,
+  mode: Mode,
+  canvas: Canvas = { width: DESIGN_W, height: DESIGN_H },
+): number {
+  const g = STAGE_LAYOUT[mode]
+  const availW = viewport.width - g.insetX * 2
+  const availH = viewport.height - g.insetTop - g.insetBottom
+  return Math.max(MIN_SCALE, Math.min(availW / canvas.width, availH / canvas.height))
+}
+
+const readViewport = (): Viewport => ({ width: window.innerWidth, height: window.innerHeight })
+
+export function useFitScale(mode: Mode, canvas?: Canvas): number {
+  const [viewport, setViewport] = useState<Viewport>(readViewport)
+  useEffect(() => {
+    const onResize = () => setViewport(readViewport())
+    onResize()
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return computeFitScale(viewport, mode, canvas)
+}
