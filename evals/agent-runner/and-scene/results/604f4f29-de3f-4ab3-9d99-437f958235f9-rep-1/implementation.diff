+++ b/skills/presentation/templates/presentation/Scene.tsx.tmpl
@@ -0,0 +1,25 @@
+import type { ReactNode } from 'react'
+import { Appear, SceneLayer, type SceneProps } from '../../presentation-kit'
+import { INTRO, type EntityId } from './entities'
+
+export interface ScenePayload {
+  /** 1-based step number whose entities are on screen. */
+  step: number
+}
+
+// One node per entity id. Reusing an id across steps morphs that entity; change its x/y/w/h/label per step as the story needs.
+const NODES: Record<EntityId, ReactNode> = {
+  // 'entity-id': <Box id="entity-id" className="{{slug}}-box" x={40} y={40} w={160} h={64}>label</Box>,
+}
+
+/** One persistent scene; only the payload changes between steps. */
+export function Scene({ payload }: SceneProps<ScenePayload>) {
+  const ids = Object.keys(INTRO) as EntityId[]
+  return (
+    <SceneLayer>
+      {ids.filter((id) => INTRO[id] <= payload.step).map((id) => (
+        <Appear key={id}>{NODES[id]}</Appear>
+      ))}
+    </SceneLayer>
+  )
+}
