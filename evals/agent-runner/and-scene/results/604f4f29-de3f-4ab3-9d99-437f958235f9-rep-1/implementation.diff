@@ -0,0 +1,30 @@
+import type { CSSProperties } from 'react'
+
+/** Absolute placement on the design canvas. Omit to let the node flow normally. */
+export interface Placement {
+  x?: number
+  y?: number
+  w?: number
+  h?: number
+}
+
+export function placementStyle({ x, y, w, h }: Placement): CSSProperties {
+  const absolute = x !== undefined || y !== undefined
+  return {
+    ...(absolute ? { position: 'absolute' as const } : null),
+    ...(x !== undefined ? { left: x } : null),
+    ...(y !== undefined ? { top: y } : null),
+    ...(w !== undefined ? { width: w } : null),
+    ...(h !== undefined ? { height: h } : null),
+  }
+}
+
+export type Point = readonly [number, number]
+
+export function arrowPath(from: Point, to: Point, bend?: Point): string {
+  const [fx, fy] = from
+  const [tx, ty] = to
+  const [cx, cy] = bend ?? [(fx + tx) / 2, (fy + ty) / 2]
+  return `M ${fx} ${fy} Q ${cx} ${cy} ${tx} ${ty}`
+}
+
diff --git a/src/presentation-kit/stepNumber.ts b/src/presentation-kit/stepNumber.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d65d9e4fa4f69d6b0b60ce967d2d6f9f2f172334
--- /dev/null
+++ b/src/presentation-kit/stepNumber.ts
@@ -0,0 +1,22 @@
+/** On-screen step number, derived from position so reordering needs no renumbering. */
+export function stepNumber(index: number): number {
+  return index + 1
+}
+
+export interface EraGroup {
+  era: string
+  /** Index of the first step in this era. */
+  firstIndex: number
+  indices: number[]
+}
+
+/** Groups consecutive steps by era label, in order of first appearance. */
+export function groupByEra(steps: readonly { era: string }[]): EraGroup[] {
+  const groups: EraGroup[] = []
+  steps.forEach((step, i) => {
+    const last = groups[groups.length - 1]
+    if (last && last.era === step.era) last.indices.push(i)
+    else groups.push({ era: step.era, firstIndex: i, indices: [i] })
+  })
+  return groups
+}
