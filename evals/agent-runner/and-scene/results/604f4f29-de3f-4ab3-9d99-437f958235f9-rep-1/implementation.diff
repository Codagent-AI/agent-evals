@@ -0,0 +1,30 @@
+import { describe, expect, expectTypeOf, it } from 'vitest'
+import { render } from '@testing-library/react'
+import { Presentation, type SceneProps, type Step } from '../../src/presentation-kit'
+
+interface Payload {
+  label: string
+}
+
+function Typed({ payload }: SceneProps<Payload>) {
+  return <p data-testid="typed">{payload.label}</p>
+}
+
+const steps: Step<Payload>[] = [
+  { id: 'a', era: 'e', title: 'A', caption: 'a', Scene: Typed, payload: { label: 'first' }, groupKey: 'g' },
+  { id: 'b', era: 'e', title: 'B', caption: 'b', Scene: Typed, payload: { label: 'second' }, groupKey: 'g' },
+]
+
+describe('typed step payloads', () => {
+  it('flow through the Presentation boundary without casts', () => {
+    expectTypeOf(steps[0].payload).toEqualTypeOf<Payload>()
+    const { getByTestId } = render(<Presentation steps={steps} title="T" />)
+    expect(getByTestId('typed').textContent).toBe('first')
+  })
+
+  it('rejects a scene whose payload type does not match the step payload', () => {
+    // @ts-expect-error payload must match the Scene's payload type
+    const bad: Step<Payload> = { ...steps[0], payload: { label: 1 } }
+    expect(bad).toBeDefined()
+  })
+})
diff --git a/tests/unit/usePresentationNav.test.tsx b/tests/unit/usePresentationNav.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..eeba195ac27de27f40b5aba5a898954ad2d1e977
--- /dev/null
+++ b/tests/unit/usePresentationNav.test.tsx
@@ -0,0 +1,80 @@
+import { describe, expect, it } from 'vitest'
+import { act, renderHook } from '@testing-library/react'
+import { usePresentationNav } from '../../src/presentation-kit'
+
+const press = (key: string, target: EventTarget = window) =>
+  act(() => {
+    target.dispatchEvent(new KeyboardEvent('keydown', { key, bubbles: true, cancelable: true }))
+  })
+
+const touch = (type: 'touchstart' | 'touchend', x: number, y = 0) =>
+  act(() => {
+    const t = { clientX: x, clientY: y } as Touch
+    const ev = new Event(type, { bubbles: true }) as TouchEvent
+    Object.defineProperty(ev, type === 'touchstart' ? 'touches' : 'changedTouches', { value: [t] })
+    window.dispatchEvent(ev)
+  })
+
+describe('usePresentationNav', () => {
+  it('advances with Right, Space and PageDown and goes back with Left and PageUp', () => {
+    const { result } = renderHook(() => usePresentationNav(5))
+    press('ArrowRight')
+    press(' ')
+    press('PageDown')
+    expect(result.current.index).toBe(3)
+    press('ArrowLeft')
+    press('PageUp')
+    expect(result.current.index).toBe(1)
+  })
+
+  it('clamps at the start and at the end', () => {
+    const { result } = renderHook(() => usePresentationNav(3))
+    press('ArrowLeft')
+    expect(result.current.index).toBe(0)
+    press('ArrowRight')
+    press('ArrowRight')
+    press('ArrowRight')
+    press('PageDown')
+    expect(result.current.index).toBe(2)
+  })
+
+  it('swipes left to advance and right to go back', () => {
+    const { result } = renderHook(() => usePresentationNav(4))
+    touch('touchstart', 300)
+    touch('touchend', 100)
+    expect(result.current.index).toBe(1)
+    touch('touchstart', 100)
+    touch('touchend', 300)
+    expect(result.current.index).toBe(0)
+  })
+
+  it('toggles mode with P while keeping the step, and honors the initial mode', () => {
+    const { result } = renderHook(() => usePresentationNav(4, 'present'))
+    expect(result.current.mode).toBe('present')
+    press('ArrowRight')
+    press('p')
+    expect(result.current.mode).toBe('browse')
+    expect(result.current.index).toBe(1)
+    press('P')
+    expect(result.current.mode).toBe('present')
+    expect(result.current.index).toBe(1)
+  })
+
+  it('does not hijack keys while a control is focused', () => {
+    const { result } = renderHook(() => usePresentationNav(4))
+    const button = document.createElement('button')
+    document.body.appendChild(button)
+    press(' ', button)
+    press('ArrowRight', button)
+    expect(result.current.index).toBe(0)
+    button.remove()
+  })
+
+  it('jumps directly to a step and clamps out-of-range jumps', () => {
+    const { result } = renderHook(() => usePresentationNav(4))
+    act(() => result.current.goTo(2))
+    expect(result.current.index).toBe(2)
+    act(() => result.current.goTo(99))
+    expect(result.current.index).toBe(3)
+  })
+})
