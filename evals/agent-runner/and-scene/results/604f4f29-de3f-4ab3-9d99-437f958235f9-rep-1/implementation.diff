diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..246a7d108a4f721836135eff4d5e17ea97d63a9a
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,60 @@
+import { DESIGN_H, DESIGN_W, WIDE_VIEWPORT } from './constants'
+import { Stage } from './Stage'
+import { usePresentationNav } from './usePresentationNav'
+import { useMinWidth } from './useMinWidth'
+import { Header } from './chrome/Header'
+import { Footer } from './chrome/Footer'
+import { Toc } from './chrome/Toc'
+import { Attribution } from './chrome/Attribution'
+import type { PresentationProps } from './types'
+
+/** One evolving scene driven through ordered steps, with present/browse chrome. */
+export function Presentation<TPayload = undefined>({
+  steps,
+  title,
+  initialMode = 'browse',
+  className,
+  brand,
+  attribution,
+  canvas = { width: DESIGN_W, height: DESIGN_H },
+}: PresentationProps<TPayload>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const wide = useMinWidth(WIDE_VIEWPORT)
+  const step = steps[nav.index]
+  const showToc = nav.mode === 'browse' && wide
+
+  return (
+    <div
+      className={className}
+      data-presentation-root=""
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      data-step-id={step?.id}
+      style={{ display: 'flex', flexDirection: 'column', height: '100dvh', minHeight: 0 }}
+    >
+      <Header
+        title={title}
+        mode={nav.mode}
+        index={nav.index}
+        count={steps.length}
+        era={step?.era ?? ''}
+        brand={brand}
+        onToggleMode={nav.toggleMode}
+      />
+      <div style={{ display: 'flex', flex: 1, minHeight: 0 }}>
+        {showToc && <Toc steps={steps} index={nav.index} onJump={nav.goTo} />}
+        <Stage steps={steps} index={nav.index} mode={nav.mode} canvas={canvas} />
+      </div>
+      <Footer
+        steps={steps}
+        index={nav.index}
+        mode={nav.mode}
+        onPrev={nav.prev}
+        onNext={nav.next}
+        onJump={nav.goTo}
+      />
+      {attribution !== false && <Attribution {...attribution} />}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..49225bac62bfb32e2454875e76bc564823c23f51
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,61 @@
+import { useRef } from 'react'
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { useFitScale } from './useFitScale'
+import { EASE, ENTER_T } from './constants'
+import { hostKey } from './hostKey'
+import type { Mode, Step } from './types'
+
+export interface StageProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  index: number
+  mode: Mode
+  canvas: { width: number; height: number }
+}
+
+/** Fixed design canvas, scaled to fit, hosting the active step's scene. */
+export function Stage<TPayload>({ steps, index, mode, canvas }: StageProps<TPayload>) {
+  const areaRef = useRef<HTMLDivElement>(null)
+  const scale = useFitScale(areaRef, canvas, mode)
+  const step = steps[index]
+
+  return (
+    <div
+      ref={areaRef}
+      data-presentation-stage-area=""
+      style={{ position: 'relative', flex: 1, minWidth: 0, minHeight: 0, overflow: 'hidden' }}
+    >
+      <div
+        data-presentation-canvas=""
+        data-presentation-scale={scale.toFixed(4)}
+        style={{
+          position: 'absolute',
+          left: '50%',
+          top: '50%',
+          width: canvas.width,
+          height: canvas.height,
+          transform: `translate(-50%, -50%) scale(${scale})`,
+          transformOrigin: 'center center',
+        }}
+      >
+        <LayoutGroup>
+          <AnimatePresence initial={false}>
+            {step && (
+              <motion.div
+                key={hostKey(step)}
+                data-presentation-scene=""
+                data-presentation-group={step.groupKey}
+                style={{ position: 'absolute', inset: 0 }}
+                initial={{ opacity: 0 }}
+                animate={{ opacity: 1 }}
+                exit={{ opacity: 0 }}
+                transition={{ duration: ENTER_T, ease: EASE }}
+              >
+                <step.Scene payload={step.payload} stepIndex={index} />
+              </motion.div>
+            )}
+          </AnimatePresence>
+        </LayoutGroup>
+      </div>
+    </div>
+  )
+}
