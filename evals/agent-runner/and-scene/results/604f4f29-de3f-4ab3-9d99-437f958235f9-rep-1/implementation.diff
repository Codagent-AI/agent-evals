@@ -0,0 +1,48 @@
+import { describe, expect, it } from 'vitest'
+import { clampIndex, isInteractiveTarget, keyAction, swipeAction } from '../../src/presentation-kit'
+
+const key = (k: string, mods: Partial<KeyboardEvent> = {}) => keyAction({ key: k, altKey: false, ctrlKey: false, metaKey: false, ...mods })
+
+describe('keyAction', () => {
+  it('maps Right, Space and PageDown to next', () => {
+    expect(['ArrowRight', ' ', 'PageDown'].map((k) => key(k))).toEqual(['next', 'next', 'next'])
+  })
+  it('maps Left and PageUp to prev', () => {
+    expect(['ArrowLeft', 'PageUp'].map((k) => key(k))).toEqual(['prev', 'prev'])
+  })
+  it('maps P to mode toggle and ignores other keys and modified keys', () => {
+    expect(key('p')).toBe('toggle-mode')
+    expect(key('x')).toBeNull()
+    expect(key('ArrowRight', { metaKey: true })).toBeNull()
+  })
+})
+
+describe('swipeAction', () => {
+  it('swiping left advances and swiping right goes back', () => {
+    expect(swipeAction(-120, 5)).toBe('next')
+    expect(swipeAction(120, -5)).toBe('prev')
+  })
+  it('ignores short or mostly vertical gestures', () => {
+    expect(swipeAction(-20, 0)).toBeNull()
+    expect(swipeAction(-80, 200)).toBeNull()
+  })
+})
+
+describe('clampIndex', () => {
+  it('clamps at both ends without wrapping', () => {
+    expect(clampIndex(-1, 5)).toBe(0)
+    expect(clampIndex(5, 5)).toBe(4)
+    expect(clampIndex(2, 5)).toBe(2)
+    expect(clampIndex(3, 0)).toBe(0)
+  })
+})
+
+describe('isInteractiveTarget', () => {
+  it('treats controls and their descendants as interactive', () => {
+    document.body.innerHTML = '<button><span id="in">x</span></button><div id="plain"></div><a href="/x" id="a">l</a>'
+    expect(isInteractiveTarget(document.getElementById('in'))).toBe(true)
+    expect(isInteractiveTarget(document.getElementById('a'))).toBe(true)
+    expect(isInteractiveTarget(document.getElementById('plain'))).toBe(false)
+    expect(isInteractiveTarget(null)).toBe(false)
+  })
+})
diff --git a/tests/unit/nodes-motion.test.tsx b/tests/unit/nodes-motion.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..26a6f0952fdefd9d57b1b362e5382364c86a4e34
--- /dev/null
+++ b/tests/unit/nodes-motion.test.tsx
@@ -0,0 +1,54 @@
+import { describe, expect, it, vi } from 'vitest'
+import { createElement } from 'react'
+import { render } from '@testing-library/react'
+
+type Props = Record<string, unknown>
+const seen: Props[] = []
+const MOTION_ONLY = new Set(['layoutId', 'initial', 'animate', 'exit', 'transition'])
+
+// Capture the props the kit hands to motion so morph and sequencing behavior can be asserted
+// without relying on jsdom layout measurement.
+vi.mock('motion/react', async () => {
+  const actual = await vi.importActual<typeof import('motion/react')>('motion/react')
+  const motion = new Proxy({}, {
+    get: (_t, tag: string) => (props: Props) => {
+      seen.push({ tag, ...props })
+      const dom = Object.fromEntries(Object.entries(props).filter(([k]) => !MOTION_ONLY.has(k)))
+      return createElement(tag, dom as never)
+    },
+  })
+  return { ...actual, motion }
+})
+
+import { Appear, Box, ENTER_DELAY, LAYOUT_T } from '../../src/presentation-kit'
+
+describe('morph and sequencing configuration', () => {
+  it('shares one layoutId per entity and animates layout changes over LAYOUT_T', () => {
+    seen.length = 0
+    const { rerender } = render(<Box id="card" x={10} y={10}>a</Box>)
+    rerender(<Box id="card" x={200} y={90}>a</Box>)
+    const boxes = seen.filter((p) => p.layoutId === 'card')
+    expect(boxes.length).toBeGreaterThanOrEqual(2)
+    const transition = boxes[0].transition as { layout: { duration: number } }
+    expect(transition.layout.duration).toBe(LAYOUT_T)
+    expect((boxes[boxes.length - 1].style as { left: number }).left).toBe(200)
+  })
+
+  it('does not give a persisting primitive an enter animation', () => {
+    seen.length = 0
+    render(<Box id="x">a</Box>)
+    expect(seen[0].initial).toBeUndefined()
+    expect(seen[0].animate).toBeUndefined()
+  })
+
+  it('delays newcomers until the layout morph has finished', () => {
+    seen.length = 0
+    render(<Appear><Box id="n">n</Box></Appear>)
+    const appear = seen.find((p) => 'data-presentation-appear' in p)!
+    expect(appear.initial).toEqual({ opacity: 0 })
+    const animate = appear.animate as { opacity: number; transition: { delay: number } }
+    expect(animate.opacity).toBe(1)
+    expect(animate.transition.delay).toBe(ENTER_DELAY)
+    expect(animate.transition.delay).toBeGreaterThanOrEqual(LAYOUT_T)
+  })
+})
diff --git a/tests/unit/nodes.test.tsx b/tests/unit/nodes.test.tsx
