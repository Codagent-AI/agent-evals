index 0000000000000000000000000000000000000000..e410385171b7b72f3b74f60ff00cc627a1ff49ea
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/routes.ts
@@ -0,0 +1,10 @@
+import type { PresentationEntry } from './presentations'
+
+/** Maps a pathname to a registry entry, or null for the landing page. */
+export function resolveRoute(
+  pathname: string,
+  registry: readonly PresentationEntry[],
+): PresentationEntry | null {
+  const slug = pathname.replace(/^\/+|\/+$/g, '')
+  return registry.find((entry) => entry.slug === slug) ?? null
+}
