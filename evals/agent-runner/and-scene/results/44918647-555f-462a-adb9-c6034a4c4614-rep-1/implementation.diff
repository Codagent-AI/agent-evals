diff --git a/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..79c43d4ef4db27c9b4b1eb6f98918350b4ee4df3
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
@@ -0,0 +1,214 @@
+#!/usr/bin/env node
+// Capture one settled screenshot per step from a production preview and print
+// advisory visual warnings. Usage:
+//   npm run inspect -- <slug> [--out dir] [--settle ms] [--viewport WxH] [--mode present|browse] [--skip-build]
+// Screenshots and report.json are inspection artifacts, not pass/fail evidence.
+import { mkdirSync, writeFileSync } from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { chromium } from 'playwright'
+import { Fail, readRegistry, runBuild, startPreview } from './lib/preview.mjs'
+
+const DEFAULTS = { settle: 1000, viewport: '1440x900' }
+
+function parseArgs(argv) {
+  const options = {
+    slug: null,
+    skipBuild: false,
+    settle: DEFAULTS.settle,
+    viewport: DEFAULTS.viewport,
+    mode: null,
+    out: null,
+    root: path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..'),
+  }
+  for (let i = 0; i < argv.length; i++) {
+    const arg = argv[i]
+    if (arg === '--skip-build') options.skipBuild = true
+    else if (arg === '--settle') options.settle = Number(argv[++i])
+    else if (arg === '--viewport') options.viewport = argv[++i]
+    else if (arg === '--mode') options.mode = argv[++i]
+    else if (arg === '--out') options.out = path.resolve(argv[++i])
+    else if (arg === '--root') options.root = path.resolve(argv[++i])
+    else if (!arg.startsWith('--')) options.slug = arg
+  }
+  return options
+}
+
+/** Runs in the page: returns advisory warnings for the current step. */
+function diagnose() {
+  const warnings = []
+  const describe = (el) => {
+    const hook = [...el.attributes].find((a) => a.name.startsWith('data-presentation-'))
+    const text = (el.textContent ?? '').trim().replace(/\s+/g, ' ').slice(0, 30)
+    return `<${el.tagName.toLowerCase()}${hook ? ` ${hook.name}` : ''}>${text ? ` "${text}"` : ''}`
+  }
+  const visible = (el) =>
+    el.checkVisibility({ opacityProperty: true, visibilityProperty: true, contentVisibilityAuto: true })
+
+  // 1. Unmarked overlap between visible text / chrome elements.
+  const items = []
+  const chromeSelector =
+    '[data-presentation-prev], [data-presentation-next], [data-presentation-progress-item], [data-presentation-mode-toggle], [data-presentation-attribution]'
+  const all = document.querySelectorAll('body *')
+  for (const el of all) {
+    if (!visible(el) || el.closest('svg')) continue
+    if (el.closest('[data-presentation-allow-overlap]')) continue
+    let rect = null
+    const hasText = [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim() !== '')
+    if (hasText) {
+      const range = document.createRange()
+      range.selectNodeContents(el)
+      rect = range.getBoundingClientRect()
+    } else if (el.matches(chromeSelector)) {
+      rect = el.getBoundingClientRect()
+    }
+    if (rect && rect.width > 1 && rect.height > 1) items.push({ el, rect })
+  }
+  for (let i = 0; i < items.length; i++) {
+    for (let j = i + 1; j < items.length; j++) {
+      const a = items[i]
+      const b = items[j]
+      if (a.el.contains(b.el) || b.el.contains(a.el)) continue
+      const w = Math.min(a.rect.right, b.rect.right) - Math.max(a.rect.left, b.rect.left)
+      const h = Math.min(a.rect.bottom, b.rect.bottom) - Math.max(a.rect.top, b.rect.top)
+      if (w > 2 && h > 2) {
+        warnings.push({ kind: 'overlap', message: `${describe(a.el)} overlaps ${describe(b.el)}` })
+      }
+    }
+  }
+
+  // 2. Active navigation indistinguishable from inactive siblings.
+  // Size only counts for indicators whose size is not driven by their text (the progress dots).
+  const signature = (el, withSize) => {
+    const s = getComputedStyle(el)
+    const r = el.getBoundingClientRect()
+    return [
+      s.color, s.backgroundColor, s.borderTopColor, s.borderTopWidth, s.opacity, s.fontWeight,
+      s.textDecorationLine, s.boxShadow, s.outlineStyle, s.transform, s.borderRadius,
+      ...(withSize ? [Math.round(r.width), Math.round(r.height)] : []),
+    ].join('|')
+  }
+  for (const [label, itemSelector, withSize] of [
+    ['progress indicator', '[data-presentation-progress-item]', true],
+    ['table-of-contents entry', '[data-presentation-toc-item]', false],
+  ]) {
+    const nodes = [...document.querySelectorAll(itemSelector)].filter(visible)
+    const active = nodes.find((n) => n.getAttribute('aria-current') === 'step')
+    const inactive = nodes.filter((n) => n !== active)
+    if (active && inactive.length > 0 && inactive.every((n) => signature(n, withSize) === signature(active, withSize))) {
+      warnings.push({
+        kind: 'active-chrome',
+        message: `active ${label} is visually indistinguishable from inactive ones (style it with [data-presentation-active])`,
+      })
+    }
+  }
+
+  // 3. Unpolished attribution.
+  const link = document.querySelector('[data-presentation-attribution]')
+  if (!link) {
+    warnings.push({ kind: 'attribution', message: 'no [data-presentation-attribution] link is rendered' })
+  } else {
+    const style = getComputedStyle(link)
+    const frame = document.createElement('iframe')
+    document.body.append(frame)
+    const probe = frame.contentDocument.createElement('a')
+    probe.href = '#'
+    probe.textContent = link.textContent
+    frame.contentDocument.body.append(probe)
+    const base = frame.contentWindow.getComputedStyle(probe)
+    const same = ['color', 'textDecorationLine', 'backgroundColor'].every(
+      (p) => style[p] === base[p],
+    )
+    frame.remove()
+    if (parseFloat(style.fontSize) < 11) {
+      warnings.push({
+        kind: 'attribution',
+        message: `attribution link is too small (${style.fontSize}); style [data-presentation-attribution]`,
+      })
+    }
+    if (same) {
+      warnings.push({
+        kind: 'attribution',
+        message: 'attribution link uses browser-default link styling; style [data-presentation-attribution]',
+      })
+    }
+  }
+  return warnings
+}
+
+async function main() {
+  const options = parseArgs(process.argv.slice(2))
+  const { root } = options
+  const registry = readRegistry(root)
+  const slug = options.slug ?? registry[0]?.slug
+  if (!slug || !registry.some((entry) => entry.slug === slug)) {
+    throw new Fail('inspect', `unknown presentation "${slug}"; registered: ${registry.map((e) => e.slug).join(', ') || 'none'}`)
+  }
+  const [width, height] = options.viewport.split('x').map(Number)
+  const out = options.out ?? path.join(root, 'inspection', slug)
+  mkdirSync(out, { recursive: true })
+
+  if (!options.skipBuild) {
+    const build = await runBuild(root)
+    if (build.code !== 0) throw new Fail('build', `npm run build exited ${build.code}\n${build.output.trim()}`)
+  }
+
+  const preview = await startPreview(root)
+  let browser
+  try {
+    browser = await chromium.launch()
+  } catch (error) {
+    await preview.stop()
+    throw new Fail('browser', `could not launch Chromium (run "npx playwright install chromium"): ${error.message}`)
+  }
+  try {
+    const page = await browser.newPage({ viewport: { width, height } })
+    const pageErrors = []
+    page.on('pageerror', (error) => pageErrors.push(error.message))
+    await page.goto(`${preview.url}/${slug}`)
+    await page.waitForSelector('[data-step-count]', { timeout: 10000 })
+    if (options.mode) {
+      const current = await page.getAttribute('[data-presentation-root]', 'data-presentation-mode')
+      if (current !== options.mode) await page.keyboard.press('p')
+    }
+    const count = Number(await page.getAttribute('[data-step-count]', 'data-step-count'))
+    const report = { slug, viewport: { width, height }, settleMs: options.settle, steps: [] }
+    let warningCount = 0
+    for (let i = 0; i < count; i++) {
+      let advancedAt = Date.now()
+      if (i > 0) {
+        advancedAt = Date.now()
+        await page.keyboard.press('ArrowRight')
+        await page.waitForFunction(
+          (expected) => document.querySelector('[data-step-index]')?.getAttribute('data-step-index') === String(expected),
+          i,
+        )
+      }
+      await page.waitForTimeout(options.settle)
+      const file = path.join(out, `step-${String(i + 1).padStart(2, '0')}.png`)
+      const capturedAt = Date.now()
+      await page.screenshot({ path: file })
+      const warnings = await page.evaluate(diagnose)
+      warningCount += warnings.length
+      for (const warning of warnings) console.log(`WARN step ${i + 1} [${warning.kind}] ${warning.message}`)
+      report.steps.push({
+        index: i + 1,
+        file: path.relative(root, file),
+        settledMs: capturedAt - advancedAt,
+        warnings,
+      })
+    }
+    report.pageErrors = pageErrors
+    writeFileSync(path.join(out, 'report.json'), JSON.stringify(report, null, 2) + '\n')
+    console.log(`inspect: ${count} screenshots in ${path.relative(root, out) || out}; ${warningCount} advisory warning(s)`)
+  } finally {
+    await browser.close()
+    await preview.stop()
+  }
+}
+
+main().catch((error) => {
+  if (error instanceof Fail) console.error(`FAIL inspect [${error.phase}]: ${error.message}`)
+  else console.error(`FAIL inspect [internal]: ${error?.stack ?? error}`)
+  process.exit(1)
+})
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/preview.mjs b/skills/presentation/templates/bootstrap/scripts/lib/preview.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7cf18bb5eeb87a65348bcfbf77bb80892f9c88fb
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/preview.mjs
@@ -0,0 +1,109 @@
+import { spawn } from 'node:child_process'
+import { readFileSync } from 'node:fs'
+import { createRequire } from 'node:module'
+import net from 'node:net'
+import path from 'node:path'
+
+/** Always the IPv4 loopback address, so results never depend on name resolution. */
+export const HOST = '127.0.0.1'
+
+export class Fail extends Error {
+  constructor(phase, message) {
+    super(message)
+    this.phase = phase
+  }
+}
+
+export function freePort() {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer()
+    server.once('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+}
+
+/** Slugs and titles from the explicit registry in src/presentations/index.ts. */
+export function readRegistry(root) {
+  const source = readFileSync(path.join(root, 'src/presentations/index.ts'), 'utf8')
+  const string = String.raw`(?:"((?:[^"\\]|\\.)*)"|'((?:[^'\\]|\\.)*)')`
+  const pattern = new RegExp(String.raw`slug:\s*${string}\s*,\s*title:\s*${string}`, 'gs')
+  const unquote = (double, single) =>
+    double !== undefined ? JSON.parse(`"${double}"`) : single.replace(/\\(.)/g, '$1')
+  const entries = [...source.matchAll(pattern)].map((m) => ({
+    slug: unquote(m[1], m[2]),
+    title: unquote(m[3], m[4]),
+  }))
+  // A registry line the parser cannot read must fail loudly rather than skip a presentation.
+  const declared = (source.match(/\bslug\s*:\s*['"]/g) ?? []).length
+  if (declared !== entries.length) {
+    throw new Fail(
+      'registry',
+      `src/presentations/index.ts has ${declared} slug entries but ${entries.length} could be read; write each entry as { slug: '...', title: '...', load: ... }`,
+    )
+  }
+  return entries
+}
+
+export function runBuild(root) {
+  return new Promise((resolve) => {
+    const child = spawn('npm', ['run', 'build'], { cwd: root, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (chunk) => (output += chunk))
+    child.stderr.on('data', (chunk) => (output += chunk))
+    child.on('error', (error) => resolve({ code: 1, output: String(error) }))
+    child.on('close', (code) => resolve({ code, output }))
+  })
+}
+
+/**
+ * Vite's CLI entry as Node resolves it from the app, so a copy hoisted to a workspace root
+ * (or any parent node_modules) is found as well as an app-local install.
+ */
+export function resolveViteBin(root) {
+  let manifest
+  try {
+    manifest = createRequire(path.join(root, 'package.json')).resolve('vite/package.json')
+  } catch {
+    throw new Fail('preview', `vite is not installed for ${root}; run npm install in the app first`)
+  }
+  const { bin } = JSON.parse(readFileSync(manifest, 'utf8'))
+  return path.join(path.dirname(manifest), typeof bin === 'string' ? bin : bin.vite)
+}
+
+/** Starts `vite preview` on 127.0.0.1 and resolves once it answers; `stop()` kills it. */
+export async function startPreview(root, { timeoutMs = 30000 } = {}) {
+  const port = await freePort()
+  const vite = resolveViteBin(root)
+  const child = spawn(
+    process.execPath,
+    [vite, 'preview', '--host', HOST, '--port', String(port), '--strictPort'],
+    { cwd: root, stdio: ['ignore', 'pipe', 'pipe'] },
+  )
+  let log = ''
+  child.stdout.on('data', (chunk) => (log += chunk))
+  child.stderr.on('data', (chunk) => (log += chunk))
+  const exited = new Promise((resolve) => child.once('exit', resolve))
+  const stop = async () => {
+    if (child.exitCode === null && child.signalCode === null) child.kill('SIGTERM')
+    await exited
+  }
+  const url = `http://${HOST}:${port}`
+  const deadline = Date.now() + timeoutMs
+  for (;;) {
+    if (child.exitCode !== null) throw new Fail('preview', `vite preview exited early:\n${log}`)
+    try {
+      const response = await fetch(`${url}/`)
+      if (response.ok) return { url, port, stop }
+    } catch {
+      /* not listening yet */
+    }
+    if (Date.now() > deadline) {
+      await stop()
+      throw new Fail('preview', `preview did not answer at ${url} within ${timeoutMs}ms\n${log}`)
+    }
+    await new Promise((resolve) => setTimeout(resolve, 150))
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/verify.mjs b/skills/presentation/templates/bootstrap/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0c3a9fab553b04fe619842a5e6afc71ec82ee6a1
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/verify.mjs
@@ -0,0 +1,136 @@
+#!/usr/bin/env node
+// Build the whole app, then render every registered presentation step by step in
+// Chromium against a production preview on 127.0.0.1. Exit 0 = pass, 1 = fail.
+import { existsSync, readFileSync } from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { chromium } from 'playwright'
+import { Fail, readRegistry, runBuild, startPreview } from './lib/preview.mjs'
+
+const STEP_TIMEOUT_MS = 4000
+const SETTLE_MS = 150
+
+function parseArgs(argv) {
+  const options = { skipBuild: false, root: path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..') }
+  for (let i = 0; i < argv.length; i++) {
+    if (argv[i] === '--skip-build') options.skipBuild = true
+    else if (argv[i] === '--root') options.root = path.resolve(argv[++i])
+  }
+  return options
+}
+
+function readOutline(root) {
+  const file = path.join(root, 'scripts/reference-outline.json')
+  return existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : null
+}
+
+async function verifyPresentation(browser, baseUrl, slug, outline) {
+  const context = await browser.newContext({ viewport: { width: 1280, height: 800 } })
+  const page = await context.newPage()
+  const errors = []
+  page.on('console', (message) => {
+    if (message.type() === 'error') errors.push(`console error: ${message.text()}`)
+  })
+  page.on('pageerror', (error) => errors.push(`uncaught page error: ${error.message}`))
+  const fail = (index, message) => {
+    throw new Fail('render', `/${slug} step ${index + 1}: ${message}`)
+  }
+  const failOnErrors = (index) => {
+    if (errors.length > 0) fail(index, errors.join(' | '))
+  }
+  try {
+    await page.goto(`${baseUrl}/${slug}`)
+    try {
+      await page.waitForSelector('[data-step-count]', { timeout: 10000 })
+    } catch {
+      failOnErrors(0)
+      throw new Fail('render', `/${slug} did not render a presentation (no data-step-count hook)`)
+    }
+    const count = Number(await page.getAttribute('[data-step-count]', 'data-step-count'))
+    if (outline && count !== outline.steps.length) {
+      throw new Fail('sample', `/${slug} has ${count} steps, expected ${outline.steps.length}`)
+    }
+    if ((await page.getAttribute('[data-presentation-root]', 'data-presentation-mode')) === 'present') {
+      await page.keyboard.press('p')
+    }
+    for (let i = 0; i < count; i++) {
+      if (i > 0) {
+        await page.keyboard.press('ArrowRight')
+        try {
+          await page.waitForFunction(
+            (expected) =>
+              document.querySelector('[data-step-index]')?.getAttribute('data-step-index') === String(expected),
+            i,
+            { timeout: STEP_TIMEOUT_MS },
+          )
+        } catch {
+          fail(i, `transition did not advance data-step-index to ${i}`)
+        }
+      }
+      await page.waitForTimeout(SETTLE_MS)
+      failOnErrors(i)
+      if (outline) {
+        const expected = outline.steps[i]
+        const actual = {
+          era: await page.textContent('[data-presentation-era]'),
+          title: await page.textContent('[data-presentation-title]'),
+          caption: await page.textContent('[data-presentation-caption]'),
+        }
+        for (const field of ['era', 'title', 'caption']) {
+          if (actual[field] !== expected[field]) {
+            throw new Fail(
+              'sample',
+              `/${slug} step ${i + 1} ${field} is ${JSON.stringify(actual[field])}, expected ${JSON.stringify(expected[field])}`,
+            )
+          }
+        }
+      }
+    }
+    return count
+  } finally {
+    await context.close()
+  }
+}
+
+async function main() {
+  const { skipBuild, root } = parseArgs(process.argv.slice(2))
+  if (!skipBuild) {
+    console.log('verify: building (npm run build)')
+    const build = await runBuild(root)
+    if (build.code !== 0) throw new Fail('build', `npm run build exited ${build.code}\n${build.output.trim()}`)
+  }
+
+  const registry = readRegistry(root)
+  const outline = readOutline(root)
+  if (outline && !registry.some((entry) => entry.slug === outline.slug)) {
+    throw new Fail('sample', `reference sample "${outline.slug}" is not registered`)
+  }
+  if (registry.length === 0) throw new Fail('registry', 'no presentations are registered in src/presentations/index.ts')
+
+  const preview = await startPreview(root)
+  console.log(`verify: preview at ${preview.url}`)
+  let browser
+  try {
+    try {
+      browser = await chromium.launch()
+    } catch (error) {
+      throw new Fail('browser', `could not launch Chromium (run "npx playwright install chromium"): ${error.message}`)
+    }
+    let total = 0
+    for (const { slug } of registry) {
+      const steps = await verifyPresentation(browser, preview.url, slug, outline?.slug === slug ? outline : null)
+      console.log(`verify: /${slug} rendered ${steps} steps without errors`)
+      total += steps
+    }
+    console.log(`PASS verify: build ok, ${registry.length} presentation(s), ${total} step(s) rendered`)
+  } finally {
+    await browser?.close()
+    await preview.stop()
+  }
+}
+
+main().catch((error) => {
+  if (error instanceof Fail) console.error(`FAIL verify [${error.phase}]: ${error.message}`)
+  else console.error(`FAIL verify [internal]: ${error?.stack ?? error}`)
+  process.exit(1)
+})
