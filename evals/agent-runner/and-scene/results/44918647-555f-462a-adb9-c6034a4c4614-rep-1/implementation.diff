@@ -0,0 +1,147 @@
+import type { LucideIcon } from 'lucide-react'
+import {
+  Check,
+  CircleHelp,
+  MessageSquare,
+  Pencil,
+  ShieldCheck,
+  SlidersHorizontal,
+  Sparkles,
+  User,
+} from 'lucide-react'
+
+/** The layoutId namespace of this presentation: every entity keeps one id for the whole talk. */
+export const ID = {
+  you: 'htp-you',
+  prompt: 'htp-prompt',
+  skill: 'htp-skill',
+  talk: 'htp-talk-arrow',
+  question: 'htp-question',
+  tray: 'htp-tray',
+  card1: 'htp-card-1',
+  card2: 'htp-card-2',
+  card3: 'htp-card-3',
+  ghost: 'htp-ghost',
+  link12: 'htp-link-1-2',
+  link12Label: 'htp-link-1-2-label',
+  link23: 'htp-link-2-3',
+  link23Label: 'htp-link-2-3-label',
+  depth: 'htp-depth',
+  kit: 'htp-scene-kit',
+  kitPlug: 'htp-scene-kit-plug',
+  verifyLink: 'htp-verify-link',
+  verify: 'htp-verify',
+  verifyLabel: 'htp-verify-label',
+  pass: 'htp-pass',
+  route: 'htp-route',
+  modify: 'htp-modify-arc',
+  modifyChip: 'htp-modify-chip',
+  edited: 'htp-edited-flag',
+  editedRing: 'htp-edited-ring',
+  frame: 'htp-frame',
+  frameLabel: 'htp-frame-label',
+} as const
+
+export interface EntitySpec {
+  id: string
+  kind: 'box' | 'label' | 'chip' | 'arrow' | 'frame' | 'emphasis'
+  className: string
+  x?: number
+  y?: number
+  width?: number
+  height?: number
+  text?: string
+  /** Sub-lines shown inside a card (title, caption, visual). */
+  parts?: readonly string[]
+  Icon?: LucideIcon
+  from?: readonly [number, number]
+  to?: readonly [number, number]
+  via?: readonly [number, number]
+  both?: boolean
+}
+
+const CARD_Y = 190
