+++ b/src/presentation-kit/chrome/Toc.tsx
@@ -0,0 +1,35 @@
+import type { StepMeta } from '../types'
+import { buildToc } from './helpers'
+
+export interface TocProps {
+  steps: readonly StepMeta[]
+  index: number
+  onJump: (index: number) => void
+}
+
+export function Toc({ steps, index, onJump }: TocProps) {
+  const entries = buildToc(steps)
+  const activeEntry = entries.filter((e) => e.firstIndex <= index).pop()
+  return (
+    <nav data-presentation-toc="" aria-label="Table of contents">
+      <ol>
+        {entries.map((entry) => {
+          const isActive = entry === activeEntry
+          return (
+            <li key={entry.firstIndex}>
+              <button
+                type="button"
+                data-presentation-toc-item=""
+                data-presentation-active={isActive ? 'true' : undefined}
+                aria-current={isActive ? 'step' : undefined}
+                onClick={() => onJump(entry.firstIndex)}
+              >
+                {entry.era}
+              </button>
+            </li>
+          )
+        })}
+      </ol>
+    </nav>
+  )
+}
diff --git a/src/presentation-kit/chrome/helpers.ts b/src/presentation-kit/chrome/helpers.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f6dcffe8307f7731b5bac412c9c2ef5e027aae52
--- /dev/null
+++ b/src/presentation-kit/chrome/helpers.ts
@@ -0,0 +1,23 @@
+import type { StepMeta } from '../types'
+
+export function stepMarker(index: number, count: number): string {
+  const width = Math.max(String(count).length, 2)
+  return String(index + 1).padStart(width, '0')
+}
+
+export interface TocEntry {
+  era: string
+  /** Index of the first step in this era. */
+  firstIndex: number
+}
+
+/** One entry per run of consecutive steps that share an era label. */
+export function buildToc(steps: readonly StepMeta[]): TocEntry[] {
+  const entries: TocEntry[] = []
+  steps.forEach((step, i) => {
+    if (entries.length === 0 || entries[entries.length - 1].era !== step.era) {
+      entries.push({ era: step.era, firstIndex: i })
+    }
+  })
+  return entries
+}
