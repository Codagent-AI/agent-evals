+  height: 12px;
+  padding: 0;
+  border-radius: 50%;
+  border: 1px solid #1d1d1f;
+  background: transparent;
+}
+.__NAME__ [data-presentation-progress-item][data-presentation-active] {
+  width: 28px;
+  border-radius: 6px;
+  background: #1d1d1f;
