+import type { ComponentType } from 'react'
+
+export type PresentationMode = 'present' | 'browse'
+
+/** Narration and identity shared by every step. */
+export interface StepMeta {
+  /** Stable identity; survives reordering. */
+  id: string
+  /** Section/era label used by the table of contents. */
+  era: string
+  /** One-line presenter title. */
+  title: string
+  /** Paragraph shown in browse mode. */
+  caption: string
+  /** Adjacent steps with the same key keep one mounted scene instance. */
+  groupKey?: string
+}
+
+export interface SceneProps<TPayload = undefined> {
+  payload: TPayload
+  step: StepMeta
+  index: number
+}
+
+export type Step<TPayload = undefined> = StepMeta & {
+  /** The diagram component; reused across steps that share a group key. */
+  Scene: ComponentType<SceneProps<TPayload>>
+} & (undefined extends TPayload ? { payload?: TPayload } : { payload: TPayload })
+
+// Any typed step array is accepted at the presentation boundary without casts.
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export type AnyStep = Step<any>
+
+export interface CanvasSize {
+  width: number
+  height: number
+}
+
+export interface AttributionOptions {
+  label?: string
+  href?: string
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..407a0fbf1772b0f1a4a52aa329f39e4eb6291991
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,55 @@
+import { useEffect, useLayoutEffect, useState, type RefObject } from 'react'
+import { MIN_SCALE, STAGE_LAYOUT } from './constants'
+import type { CanvasSize, PresentationMode } from './types'
+
+/** Uniform scale that fits the canvas into the available box, never below MIN_SCALE. */
+export function computeFitScale(
+  availableWidth: number,
+  availableHeight: number,
+  mode: PresentationMode,
+  canvas: CanvasSize,
+): number {
+  const { insetX, insetY } = STAGE_LAYOUT[mode]
+  const w = Math.max(availableWidth - insetX * 2, 0)
+  const h = Math.max(availableHeight - insetY * 2, 0)
+  return Math.max(Math.min(w / canvas.width, h / canvas.height), MIN_SCALE)
+}
+
+export function useFitScale(
+  ref: RefObject<HTMLElement | null>,
+  mode: PresentationMode,
+  canvas: CanvasSize,
+): number {
+  const [scale, setScale] = useState(1)
+
+  useLayoutEffect(() => {
+    const el = ref.current
+    if (!el) return
+    const measure = () => {
+      const rect = el.getBoundingClientRect()
+      setScale(computeFitScale(rect.width, rect.height, mode, canvas))
+    }
+    measure()
+    window.addEventListener('resize', measure)
+    const observer = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(measure)
+    observer?.observe(el)
+    return () => {
+      window.removeEventListener('resize', measure)
+      observer?.disconnect()
+    }
+  }, [ref, mode, canvas])
+
+  return scale
+}
+
+/** True while the viewport is at least `minWidth` px wide. */
+export function useMinWidth(minWidth: number): boolean {
+  const [wide, setWide] = useState(() => window.innerWidth >= minWidth)
+  useEffect(() => {
+    const update = () => setWide(window.innerWidth >= minWidth)
+    update()
+    window.addEventListener('resize', update)
+    return () => window.removeEventListener('resize', update)
+  }, [minWidth])
+  return wide
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0062aa6a048407615018942f9b8990d85d03e954
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,106 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { SWIPE_MIN_DISTANCE } from './constants'
+import type { PresentationMode } from './types'
+
+export function clampIndex(index: number, count: number): number {
+  return Math.max(0, Math.min(index, Math.max(count - 1, 0)))
+}
+
+export type NavAction = 'next' | 'prev' | 'toggle-mode'
+
+export function actionForKey(key: string): NavAction | null {
+  switch (key) {
+    case 'ArrowRight':
+    case ' ':
+    case 'PageDown':
+      return 'next'
+    case 'ArrowLeft':
+    case 'PageUp':
+      return 'prev'
+    case 'p':
+    case 'P':
+      return 'toggle-mode'
+    default:
+      return null
+  }
+}
+
+/** Swipe left advances, swipe right goes back; mostly-vertical drags are ignored. */
+export function actionForSwipe(dx: number, dy: number): NavAction | null {
+  if (Math.abs(dx) < SWIPE_MIN_DISTANCE || Math.abs(dx) <= Math.abs(dy)) return null
+  return dx < 0 ? 'next' : 'prev'
+}
+
+const INTERACTIVE =
+  'button, a[href], input, select, textarea, summary, [contenteditable=""], [contenteditable="true"], [role="button"], [role="link"], [role="tab"], [role="slider"]'
+
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE) !== null
+}
+
+export interface PresentationNav {
+  index: number
+  mode: PresentationMode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  setMode: (mode: PresentationMode) => void
+  toggleMode: () => void
+}
+
+export function usePresentationNav(count: number, initialMode: PresentationMode): PresentationNav {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState<PresentationMode>(initialMode)
+
+  const goTo = useCallback((i: number) => setIndex(clampIndex(i, count)), [count])
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, count)), [count])
+  const toggleMode = useCallback(
+    () => setMode((m) => (m === 'present' ? 'browse' : 'present')),
+    [],
+  )
+
+  const run = useCallback(
+    (action: NavAction) => {
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else toggleMode()
+    },
+    [next, prev, toggleMode],
+  )
+
+  const touchStart = useRef<{ x: number; y: number } | null>(null)
+
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      if (event.ctrlKey || event.metaKey || event.altKey) return
+      if (isInteractiveTarget(event.target)) return
+      const action = actionForKey(event.key)
+      if (!action) return
+      event.preventDefault()
+      run(action)
+    }
+    const onTouchStart = (event: TouchEvent) => {
+      const t = event.touches[0]
+      touchStart.current = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onTouchEnd = (event: TouchEvent) => {
+      const start = touchStart.current
+      const t = event.changedTouches[0]
+      touchStart.current = null
+      if (!start || !t) return
+      const action = actionForSwipe(t.clientX - start.x, t.clientY - start.y)
+      if (action) run(action)
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart, { passive: true })
+    window.addEventListener('touchend', onTouchEnd, { passive: true })
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [run])
+
