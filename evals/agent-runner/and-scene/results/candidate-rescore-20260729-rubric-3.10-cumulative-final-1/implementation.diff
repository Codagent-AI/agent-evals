+    ).toBeInTheDocument()
+
+    await waitFor(() => {
+      expect(screen.queryByText('departing entity')).not.toBeInTheDocument()
+    })
+  })
+
+  it('exposes a stable hook and no visual defaults', () => {
+    render(
