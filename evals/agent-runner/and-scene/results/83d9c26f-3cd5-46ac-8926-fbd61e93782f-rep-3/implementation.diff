+import { act, fireEvent, render, waitFor } from '@testing-library/react'
+import { describe, expect, it } from 'vitest'
+import { Presentation } from '../../src/presentation-kit'
+import { CARD_COUNT, ID } from '../../src/presentations/how-to-make-a-presentation/entities'
+import { Scene } from '../../src/presentations/how-to-make-a-presentation/steps/Scene'
+import { STEPS } from '../../src/presentations/how-to-make-a-presentation/steps/steps'
+
+const EXPECTED = [
+  ['the ask', 'You have a topic', 'It starts with you, a topic, and mild overconfidence.'],
+  ['the ask', 'The skill interviews you', 'One question at a time: the topic, the look, then each beat of the story.'],
+  ['the gathering', 'Answers become steps', 'Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next.'],
+  ['the gathering', 'The deck grows', 'Same shapes, new beats. Every answer extends the story without redrawing it.'],
+  ['the gathering', 'You set the depth', 'Spell out every step, or sketch a few and see how it looks. You hold the gate.'],
+  ['the build', 'It assembles the scene', 'Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph.'],
+  ['the build', 'It checks its own work', 'Before saying done, it builds and renders every step — and fixes what breaks.'],
+  ['the loop', 'Changed your mind? Loop it.', 'Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch.'],
+  ['the reveal', "You're looking at one", 'This presentation was built exactly this way. Thanks for watching.'],
+] as const
+
+const idsAt = (beat: number) => {
+  const { container, unmount } = render(<Scene payload={{ beat }} stepIndex={beat - 1} />)
+  const ids = new Set([...container.querySelectorAll('[data-presentation-id]')].map((e) => e.getAttribute('data-presentation-id')!))
+  unmount()
+  return ids
+}
+
+describe('reference sample outline', () => {
+  it('implements the nine normative steps in order', () => {
+    expect(STEPS.map((s) => [s.era, s.title, s.caption])).toEqual(EXPECTED)
+  })
+
+  it('gives every step a unique stable id and shares one persistent scene', () => {
+    expect(new Set(STEPS.map((s) => s.id)).size).toBe(9)
+    expect(new Set(STEPS.map((s) => s.Scene)).size).toBe(1)
+    expect(new Set(STEPS.map((s) => s.groupKey)).size).toBe(1)
+  })
+})
+
+describe('reference sample scene content', () => {
+  it('introduces the intended entities at each beat', () => {
+    const intro: Array<[number, string[]]> = [
+      [1, [ID.you, ID.prompt]],
+      [2, [ID.skill, ID.convo, ID.question]],
+      [3, [ID.card(0)]],
+      [4, [ID.card(1), ID.card(CARD_COUNT - 1), ID.cardLink(1)]],
+      [5, [ID.ghost, ID.depth]],
+      [6, [ID.socket, ID.socketLink]],
+      [7, [ID.verify, ID.build, ID.render, ID.verifyLink]],
+      [8, [ID.modify, ID.flag, ID.flagRing]],
+      [9, [ID.frame]],
+    ]
+    for (const [beat, ids] of intro) {
+      const now = idsAt(beat)
+      const before = idsAt(beat - 1)
+      for (const id of ids) {
+        expect(now.has(id), `beat ${beat} has ${id}`).toBe(true)
+        if (beat > 1) expect(before.has(id), `beat ${beat - 1} lacks ${id}`).toBe(false)
+      }
+    }
+  })
+
+  it('accumulates entities: nothing leaves or is renamed between beats', () => {
+    for (let beat = 2; beat <= 9; beat++) {
+      const before = idsAt(beat - 1)
+      const now = idsAt(beat)
+      for (const id of before) expect(now.has(id), `${id} survives into beat ${beat}`).toBe(true)
+    }
+  })
+
+  it('draws a frame only in the final reveal beat (the tray is never framed)', () => {
+    for (let beat = 1; beat <= 9; beat++) {
+      const { container, unmount } = render(<Scene payload={{ beat }} stepIndex={beat - 1} />)
+      const frames = [...container.querySelectorAll('[data-presentation-node="frame"]')]
+      expect(frames.map((f) => f.getAttribute('data-presentation-id'))).toEqual(beat === 9 ? [ID.frame] : [])
+      unmount()
+    }
+  })
+
+  it('keeps continuing entities mounted (same DOM node) while navigating', () => {
+    const { container } = render(<Presentation steps={STEPS} title="t" />)
+    const you = container.querySelector(`[data-presentation-id="${ID.you}"]`)
+    expect(you).not.toBeNull()
+    for (let i = 0; i < 8; i++) act(() => void fireEvent.keyDown(window, { key: 'ArrowRight' }))
+    expect(container.querySelector(`[data-presentation-id="${ID.you}"]`)).toBe(you)
+    expect(container.querySelector(`[data-presentation-id="${ID.frame}"]`)).not.toBeNull()
+  })
+
+  it('wraps only newcomers in Appear: persisting entities are never re-wrapped', () => {
+    const { container, rerender } = render(<Scene payload={{ beat: 3 }} stepIndex={2} />)
+    const card = container.querySelector(`[data-presentation-id="${ID.card(0)}"]`)
+    rerender(<Scene payload={{ beat: 4 }} stepIndex={3} />)
+    expect(container.querySelector(`[data-presentation-id="${ID.card(0)}"]`)).toBe(card)
+  })
+})
+
+describe('departing entities exit', () => {
+  it('keeps a dropped entity mounted while it animates out, then removes it', async () => {
+    const { container, rerender } = render(<Scene payload={{ beat: 4 }} stepIndex={3} />)
+    const card = () => container.querySelector(`[data-presentation-id="${ID.card(3)}"]`)
+    expect(card()).not.toBeNull()
+    rerender(<Scene payload={{ beat: 3 }} stepIndex={2} />)
+    // Not removed synchronously: AnimatePresence holds it until its exit animation completes.
+    expect(card()).not.toBeNull()
+    await waitFor(() => expect(card()).toBeNull())
+    expect(container.querySelector(`[data-presentation-id="${ID.card(0)}"]`)).not.toBeNull()
+  })
+})
diff --git a/tests/unit/scaffold.test.ts b/tests/unit/scaffold.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0ad88aa2442c8a96baff0bbac4cb8599c4a8ac22
--- /dev/null
+++ b/tests/unit/scaffold.test.ts
@@ -0,0 +1,101 @@
+import { cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { detectTarget } from '../../skills/presentation/scripts/detect-target.mjs'
+import { BOOTSTRAP, scaffold } from '../../skills/presentation/scripts/scaffold.mjs'
+
+const dirs: string[] = []
+const tmp = () => {
+  const d = mkdtempSync(join(tmpdir(), 'scaffold-'))
+  dirs.push(d)
+  return d
+}
+afterEach(() => dirs.splice(0).forEach((d) => rmSync(d, { recursive: true, force: true })))
+
+const HOST_VITE = "import { defineConfig } from 'vite'\nexport default defineConfig({ /* host config */ })"
+const HOST_TSCONFIG = '{ "compilerOptions": { "strict": true } }'
+
+const read = (dir: string, file: string) => readFileSync(join(dir, file), 'utf8')
+
+describe('scaffold', () => {
+  it('does nothing when no anchor is missing', () => {
+    const dir = tmp()
+    expect(scaffold(dir, [])).toMatchObject({ copied: [], skipped: [] })
+    expect(existsSync(join(dir, 'package.json'))).toBe(false)
+  })
+
+  it('scaffolds an empty directory into a complete app', () => {
+    const dir = tmp()
+    const report = scaffold(dir, detectTarget(dir).missing)
+    expect(report.copied).toContain('package.json')
+    expect(detectTarget(dir)).toMatchObject({ scaffold: 'none', anchors: { build: true, kit: true, index: true } })
+    expect(read(dir, 'src/main.tsx')).toBe(readFileSync(join(BOOTSTRAP, 'src/main.tsx'), 'utf8'))
+  })
+
+  it('adds only the missing anchors of a partial app, merging dependencies without disturbing existing files', () => {
+    const dir = tmp()
+    // A host with its own build setup, its own scene-kit-less src, and an unrelated main.tsx.
+    writeFileSync(
+      join(dir, 'package.json'),
+      JSON.stringify({
+        name: 'host',
+        scripts: { build: 'vite build --mode host', lint: 'my-lint' },
+        dependencies: { react: '^18.0.0' },
+        devDependencies: { vite: '^5.0.0', typescript: '^5.0.0' },
+      }),
+    )
+    writeFileSync(join(dir, 'vite.config.ts'), HOST_VITE)
+    writeFileSync(join(dir, 'tsconfig.json'), HOST_TSCONFIG)
+    mkdirSync(join(dir, 'src'), { recursive: true })
+    writeFileSync(join(dir, 'src/main.tsx'), "console.log('host app')")
+    cpSync(join(BOOTSTRAP, 'src/presentation-kit'), join(dir, 'src/presentation-kit'), { recursive: true })
+    writeFileSync(join(dir, 'src/presentation-kit/Stage.tsx'), 'export function Stage() { return "customised" + typeof Scene }')
+
+    const before = detectTarget(dir)
+    expect(before.missing).toEqual(['index'])
+    const report = scaffold(dir, before.missing)
+
+    // Index anchor installed; everything that existed is untouched.
+    expect(detectTarget(dir).scaffold).toBe('none')
+    expect(report.copied).toEqual(expect.arrayContaining(['src/presentations/index.ts', 'src/router.ts', 'src/Landing.tsx']))
+    expect(read(dir, 'vite.config.ts')).toBe(HOST_VITE)
+    expect(read(dir, 'tsconfig.json')).toBe(HOST_TSCONFIG)
+    expect(read(dir, 'src/main.tsx')).toBe("console.log('host app')")
+    expect(read(dir, 'src/presentation-kit/Stage.tsx')).toContain('customised')
+
+    // Dependencies and scripts the infrastructure needs are declared, existing ones kept.
+    const pkg = JSON.parse(read(dir, 'package.json'))
+    expect(pkg.dependencies.react).toBe('^18.0.0')
+    expect(pkg.devDependencies.vite).toBe('^5.0.0')
+    expect(pkg.scripts.build).toBe('vite build --mode host')
+    expect(pkg.type).toBeUndefined()
+    expect(pkg.dependencies).toHaveProperty('motion')
+    expect(pkg.dependencies).toHaveProperty('lucide-react')
+    expect(pkg.devDependencies).toHaveProperty('playwright')
+    expect(pkg.scripts).toMatchObject({ verify: expect.any(String), inspect: expect.any(String) })
+    expect(report.addedDependencies).toEqual(expect.arrayContaining(['motion', 'lucide-react', 'playwright', 'react-dom']))
+
+    // The unrelated entry point cannot be rewritten safely: it is reported for a scoped edit.
+    expect(report.wiring).toHaveLength(2)
+    expect(report.wiring).toEqual(expect.arrayContaining([expect.stringContaining('src/main.tsx'), expect.stringContaining('"type"')]))
+    expect(existsSync(join(dir, 'scripts/verify.mjs'))).toBe(true)
+  })
+
+  it('does not request wiring when main.tsx already routes through the registry', () => {
+    const dir = tmp()
+    scaffold(dir, detectTarget(dir).missing)
+    rmSync(join(dir, 'src/presentations/index.ts'))
+    const report = scaffold(dir, ['index'])
+    expect(report.wiring).toEqual([])
+  })
+
+  it('never overwrites existing kit files when re-adding the kit', () => {
+    const dir = tmp()
+    scaffold(dir, detectTarget(dir).missing)
+    writeFileSync(join(dir, 'src/presentation-kit/constants.ts'), '// mine')
+    const report = scaffold(dir, ['kit'])
+    expect(read(dir, 'src/presentation-kit/constants.ts')).toBe('// mine')
+    expect(report.skipped).toContain(join('src/presentation-kit', 'constants.ts'))
+  })
+})
