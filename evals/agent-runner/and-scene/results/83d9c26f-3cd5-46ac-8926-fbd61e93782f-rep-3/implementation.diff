--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,43 @@
+import { useLayoutEffect, useRef, useState } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT, type Mode } from './constants'
+
+/** Uniform scale that fits the design canvas into the available box for a mode. */
+export function computeFitScale(
+  width: number,
+  height: number,
+  mode: Mode,
+  design: { width: number; height: number } = { width: DESIGN_W, height: DESIGN_H },
+): number {
+  const { insetX, insetY, maxScale } = STAGE_LAYOUT[mode]
+  const fit = Math.min((width - insetX * 2) / design.width, (height - insetY * 2) / design.height)
+  return Math.min(maxScale, Math.max(MIN_SCALE, fit))
+}
+
+/** Measures the stage box and returns the uniform scale for the active mode. */
+export function useFitScale(mode: Mode, design?: { width: number; height: number }) {
+  const ref = useRef<HTMLDivElement>(null)
+  const [scale, setScale] = useState(1)
+  const designW = design?.width ?? DESIGN_W
+  const designH = design?.height ?? DESIGN_H
+
+  useLayoutEffect(() => {
+    const el = ref.current
+    if (!el) return
+    const measure = () => {
+      const { width, height } = el.getBoundingClientRect()
+      if (width > 0 && height > 0) {
+        setScale(computeFitScale(width, height, mode, { width: designW, height: designH }))
+      }
+    }
+    measure()
+    window.addEventListener('resize', measure)
+    const observer = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(measure)
+    observer?.observe(el)
+    return () => {
+      window.removeEventListener('resize', measure)
+      observer?.disconnect()
+    }
+  }, [mode, designW, designH])
+
+  return { ref, scale }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e3e92af3ac9d0226a82e4af5b3c6a1678ccfc22b
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,95 @@
+import { useCallback, useEffect, useState } from 'react'
+import type { Mode } from './constants'
+
+export type NavAction = 'next' | 'prev' | 'toggle-mode'
+
+export const SWIPE_MIN_DISTANCE = 50
+
+export function clampIndex(index: number, count: number): number {
+  return Math.min(count - 1, Math.max(0, index))
+}
+
+export function keyToAction(key: string): NavAction | null {
+  switch (key) {
+    case 'ArrowRight':
+    case ' ':
+    case 'PageDown':
+      return 'next'
+    case 'ArrowLeft':
+    case 'PageUp':
+      return 'prev'
+    case 'p':
+    case 'P':
+      return 'toggle-mode'
+    default:
+      return null
+  }
+}
+
+/** Horizontal swipe: left advances, right goes back; vertical drags are ignored. */
+export function swipeToAction(dx: number, dy: number): NavAction | null {
+  if (Math.abs(dx) < SWIPE_MIN_DISTANCE || Math.abs(dx) < Math.abs(dy)) return null
+  return dx < 0 ? 'next' : 'prev'
+}
+
+const INTERACTIVE =
+  'a[href], button, input, select, textarea, summary, [contenteditable=""], [contenteditable="true"], [role="button"], [role="link"], [role="tab"], [tabindex]:not([tabindex="-1"])'
+
+function isInteractive(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE) !== null
+}
+
+export interface PresentationNav {
+  index: number
+  mode: Mode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  toggleMode: () => void
+}
+
+export function usePresentationNav(count: number, initialMode: Mode): PresentationNav {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+
+  const goTo = useCallback((i: number) => setIndex(clampIndex(i, count)), [count])
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, count)), [count])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'browse' ? 'present' : 'browse')), [])
+
+  useEffect(() => {
+    const run = (action: NavAction | null) => {
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else if (action === 'toggle-mode') toggleMode()
+    }
+    const onKey = (e: KeyboardEvent) => {
+      if (e.ctrlKey || e.metaKey || e.altKey || isInteractive(e.target)) return
+      const action = keyToAction(e.key)
+      if (!action) return
+      e.preventDefault()
+      run(action)
+    }
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      start = t && !isInteractive(e.target) ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onTouchEnd = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      if (!start || !t) return
+      run(swipeToAction(t.clientX - start.x, t.clientY - start.y))
+      start = null
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart, { passive: true })
+    window.addEventListener('touchend', onTouchEnd, { passive: true })
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, next, prev, goTo, toggleMode }
+}
