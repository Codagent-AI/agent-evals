@@ -0,0 +1,51 @@
+import { readFile } from 'node:fs/promises'
+import { fileURLToPath } from 'node:url'
+import { resolve } from 'node:path'
+import { parseOptions, readStepCount, run, visitSteps, watchErrors, withPreview } from './browser-runtime.mjs'
+export function validateReference(actual, expected) {
+  if (actual.length !== expected.length) throw new Error(`Reference sample needs ${expected.length} steps, received ${actual.length}`)
+  for (let i = 0; i < expected.length; i++) {
+    for (const key of ['id', 'era', 'title', 'caption']) {
+      if (actual[i][key] !== expected[i][key]) throw new Error(`Reference step ${i}: ${key} differs from canonical outline`)
+    }
+  }
+}
+export const phaseFailure = (phase, error) => `FAIL ${phase}: ${error.message}`
+export async function verify(options, cwd = process.cwd()) {
+  let phase = 'build'
+  try {
+    if (options.build) await run('npm', ['run', 'build'], cwd)
+    phase = 'reference'
+    const canonical = options.slug === 'how-to-make-a-presentation'
+    const expected = canonical ? JSON.parse(await readFile(new URL('./reference-outline.json', import.meta.url), 'utf8')) : null
+    if (canonical) {
+      const actual = JSON.parse(await readFile(resolve(cwd, 'src/presentations/how-to-make-a-presentation/outline.json'), 'utf8'))
+      validateReference(actual, expected)
+    }
+    phase = 'render'
+    await withPreview(cwd, async (browser, url) => {
+      const page = await browser.newPage({ viewport: { width: 1440, height: 900 } })
+      const errors = watchErrors(page)
+      await page.goto(`${url}/${options.slug}`)
+      let count
+      try { count = await readStepCount(page) } catch (error) { throw new Error(`step 0: registered presentation ${options.slug} unavailable: ${error.message}`) }
+      if (expected && count !== expected.length) throw new Error(`step 0: Reference count ${count}, expected ${expected.length}`)
+      await visitSteps(page, count, async index => {
+        if (errors.length) throw new Error(errors.join('; '))
+        if (expected) {
+          const title = await page.locator('[data-presentation-title]').textContent()
+          const caption = await page.locator('[data-presentation-caption]').textContent()
+          const marker = await page.locator('[data-presentation-marker]').textContent()
+          if (title !== expected[index].title || caption !== expected[index].caption || !marker.endsWith(expected[index].era)) throw new Error('Reference rendered narration differs from canonical outline')
+        }
+        console.log(`STEP ${index} PASS`)
+      }, options)
+      await page.waitForTimeout(100)
+      if (errors.length) throw new Error(`step ${count - 1}: ${errors.join('; ')}`)
+    })
+    console.log(`PASS verification: ${options.slug}`)
+  } catch (error) { throw new Error(phaseFailure(phase, error), { cause: error }) }
+}
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  try { await verify(parseOptions(process.argv.slice(2))) } catch (error) { console.error(error.message); process.exitCode = 1 }
+}
diff --git a/scripts/visual-diagnostics.mjs b/scripts/visual-diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..424d7e9879a5f61731b3e97d31d3935d5b6d06fd
--- /dev/null
+++ b/scripts/visual-diagnostics.mjs
@@ -0,0 +1,64 @@
+// Only this function executes in Chromium; all decisions below use plain data.
+export function readVisualSnapshot() {
+  const visible = element => {
+    const rect = element.getBoundingClientRect()
+    if (rect.width <= 0 || rect.height <= 0) return false
+    for (let current = element; current; current = current.parentElement) {
+      const css = getComputedStyle(current)
+      if (css.visibility === 'hidden' || css.display === 'none' || Number(css.opacity) === 0) return false
+    }
+    return true
+  }
+  const describe = element => element.closest('[data-entity-id]')?.getAttribute('data-entity-id') || element.getAttribute('aria-label') || element.getAttributeNames().filter(name => name.startsWith('data-presentation-')).join(',') || element.textContent.trim().slice(0, 60) || element.tagName
+  const texts = []
+  const elements = new Map()
+  const identify = element => {
+    if (!elements.has(element)) elements.set(element, elements.size)
+    return elements.get(element)
+  }
+  const participant = (element, rect) => ({
+    element: identify(element), label: describe(element),
+    ancestors: [...(function* () { for (let parent = element.parentElement; parent; parent = parent.parentElement) yield identify(parent) })()],
+    allowOverlap: !!element.closest('[data-presentation-allow-overlap]'),
+    rect: { left: rect.left, top: rect.top, right: rect.right, bottom: rect.bottom },
+  })
+  const walker = document.createTreeWalker(document.querySelector('[data-presentation]') || document.body, NodeFilter.SHOW_TEXT)
+  while (walker.nextNode()) {
+    const node = walker.currentNode, parent = node.parentElement
+    if (!node.textContent.trim() || !visible(parent)) continue
+    const range = document.createRange()
+    range.selectNodeContents(node)
+    for (const rect of range.getClientRects()) if (rect.width && rect.height) texts.push(participant(parent, rect))
+  }
+  // Only leaf chrome participates: structural containers legitimately contain
+  // their own controls, and decorative scene boxes are outside this diagnostic.
+  const leafHooks = ['brand', 'marker', 'title', 'caption', 'toc-item', 'progress-item', 'prev', 'next', 'mode-toggle', 'attribution']
+  const chromeBoxes = [...document.querySelectorAll(leafHooks.map(hook => `[data-presentation-${hook}]`).join(','))]
+    .filter(visible).map(element => participant(element, element.getBoundingClientRect()))
+  const chrome = ['progress-item', 'toc-item'].map(hook => ({ hook, controls: [...document.querySelectorAll(`[data-presentation-${hook}]`)].filter(visible).map(node => {
+    const s = getComputedStyle(node)
+    return { active: node.getAttribute('data-presentation-active') === 'true', signature: [s.color, s.backgroundColor, s.borderColor, s.fontWeight, s.textDecorationLine, s.boxShadow, s.outlineStyle, s.opacity].join('|') }
+  }) }))
+  const link = document.querySelector('[data-presentation-attribution]')
+  const css = link && getComputedStyle(link)
+  const attribution = link ? { visible: visible(link), fontSize: parseFloat(css.fontSize), browserDefault: ['rgb(0, 0, 238)', 'rgb(85, 26, 139)'].includes(css.color) && css.textDecorationLine.includes('underline') } : null
+  return { texts, chromeBoxes, chrome, attribution }
+}
+export function diagnoseVisualSnapshot({ texts, chromeBoxes = [], chrome, attribution }) {
+  const warnings = []
+  const participants = [...texts, ...chromeBoxes]
+  for (let a = 0; a < participants.length; a++) for (let b = a + 1; b < participants.length; b++) {
+    const x = participants[a], y = participants[b]
+    if (x.element === y.element || x.ancestors?.includes(y.element) || y.ancestors?.includes(x.element) || x.allowOverlap || y.allowOverlap) continue
+    const width = Math.min(x.rect.right, y.rect.right) - Math.max(x.rect.left, y.rect.left)
+    const height = Math.min(x.rect.bottom, y.rect.bottom) - Math.max(x.rect.top, y.rect.top)
+    if (width > 1 && height > 1) warnings.push(`overlap: ${x.label} <> ${y.label}`)
+  }
+  for (const { hook, controls } of chrome) {
+    const active = controls.find(node => node.active), inactive = controls.find(node => !node.active)
+    if (active && inactive && active.signature === inactive.signature) warnings.push(`indistinct active chrome: data-presentation-${hook}`)
+  }
+  if (!attribution || !attribution.visible) warnings.push('missing attribution: style [data-presentation-attribution]')
+  else if (attribution.fontSize < 11 || attribution.browserDefault) warnings.push('unpolished attribution: style [data-presentation-attribution]')
+  return [...new Set(warnings)]
+}
diff --git a/skills/presentation/SKILL.md b/skills/presentation/SKILL.md
new file mode 100644
index 0000000000000000000000000000000000000000..1461d58fd97275c8ad7cd57577c931e7b130abff
--- /dev/null
+++ b/skills/presentation/SKILL.md
@@ -0,0 +1,119 @@
+---
+name: presentation
+description: Create or modify browser presentations as one evolving diagram; bootstrap the scene kit when needed.
+---
+
+# Presentation
+
+A presentation is one evolving diagram with stable entities, not independent slides.
+Resolve `templates/bootstrap/`, `templates/presentation/`, and `scaffold.mjs`
+relative to **this SKILL.md's absolute directory**, never the caller's cwd.
+
+## Gather
+
+Distinguish create from modify. For an unspecified/ambiguous modify target, read
+the registry, list existing presentations, and ask which before any edit. Once
+identified, ask only about requested steps, entities, or style; skip the create
+interview and edit only that presentation and necessary registration/verification.
+
+For create, use details already supplied. Ask for missing topic, visual style,
+and each step's content and visual description **one question at a time**. Include
+title, caption, visual, and what persists/morphs on the link to the next beat. Do
+not assume details the user can still provide. The human controls depth: accept
+an explicit choice to build with partial detail and iterate without a hard
+completeness gate. Complete prompts need no questions. Optionally show an ASCII
+mockup for key/complex layouts, without requiring one for every step.
+
+## Resolve target and scaffold
+
+Detect three **contracts**, not exact paths or byte-identical files:
+1. Vite + React + TypeScript build setup with working npm run build.
+2. Topic-agnostic scene kit: typed Step/Scene, stage/morphs, present/browse
+   navigation/chrome, captions/ToC, fixed-canvas fit scaling.
+3. Explicit presentation registry with individual routes.
+
+Cosmetic differences, filenames, formatting, or extra dependencies do not mean
+an anchor is missing. All present: reuse them. None present: full scaffold.
+Partial: add only missing anchors/dependencies without disturbing existing ones.
+Already inside a presentation app: reuse its target. Otherwise monorepo signals
+(package.json workspaces, pnpm-workspace.yaml, or packages/apps layout) select a
+self-contained `presentations/` app; empty/standalone projects select root.
+Preserve monorepo root build setup and unrelated files. Judge anchors for the
+resolved target app, not the monorepo root: a new `presentations/` app must be
+self-contained, so it needs its own build setup even when the root already builds.
+In **any non-empty project
+lacking kit or index**, state the resolved target and wait for user confirmation
+before scaffold writes, including partial monorepos.
+
+Copy missing infrastructure from the skill-relative bootstrap. The optional helper
+accepts an already resolved target and only the missing anchors:
+
+```
+node /absolute/skill/directory/scaffold.mjs --target /resolved/app --anchors build,kit,index
+```
+
+It refuses nonidentical existing files. For adapted host paths, integrate missing
+contracts deliberately instead of overwriting existing ones. Ensure all runtime
+dependencies (React, React DOM, Motion, Lucide) and dev dependencies (Vite, React
+plugin, TypeScript, React/React DOM/Node typings, ESLint/TypeScript/hooks/refresh
+stack, Playwright). Never assume dependencies or browsers exist. Use npm ci with
+the unchanged bootstrap lock; npm install when merging host dependencies. Install
+Chromium with npx playwright install chromium if needed.
+
+The scaffold/kit have **zero visual defaults**: no palette, typography, spacing
+scale, borders, shadows, theme tokens, card/button treatments, or styling-framework
+dependency. Plain presentation-owned CSS is default. Add Tailwind or another
+framework only if already hosted or explicitly requested, never as a kit dependency.
+
+## Generate or modify
+
+Copy templates/presentation into src/presentations/<unique-slug>/. Author its own
+entities.ts, steps, Talk.tsx, and local CSS; register one explicit lazy import in
+src/presentations/index.ts. Preserve all prior files, entries, and routes. Modify
+only the selected presentation and necessary registration/verification artifacts.
+
+Each ordered typed Step has id, era, title, caption, Scene, payload, and optional
+groupKey; on-screen numbering derives from array order. Namespace stable layoutIds
+in entities.ts. Group adjacent states with the same Scene/groupKey so the mounted
+instance persists and receives new payload. Continuing identities morph their
+position/size/label/emphasis; use AnimatePresence for departures, and Appear for
+new entities after layout motion settles. Stable keyed entry wrappers must never
+replay a newcomer fade on continuing entities. SceneLayer prevents reflow between
+layers. Raw motion elements with stable layoutIds and literal coordinates are valid
+when a generic primitive does not fit. Preserve readable intentional stacking and
+overlap rather than flattening compositions for an implementation pattern.
+
+Render Presentation with steps, title, and optional initialMode. Canvas defaults
+to 880x380, uniformly fit without internal reflow. The kit provides keyboard,
+swipe, progress/era jumps, clamped boundaries, and present/browse modes. Style
+stable data-presentation-* hooks locally: visibly distinguish active progress/ToC
+in addition to semantic current state; make the bottom-right
+[data-presentation-attribution] link legible and intentional. Top-left branding is
+host opt-in. Keep all visual decisions out of the reusable kit.
+
+## Verify, repair, and review composition
+
+Before reporting completion run the whole-app build and at least first-step clean
+browser render of the created/modified route. Prefer
+`node scripts/verify.mjs --slug <slug>` for build + every-step production render;
+run npm run verify as the canonical reference gate when completing this repository.
+Fix type/build/render failures and rerun affected checks rather than calling broken
+output successful. Every step needs a browse caption and next/previous navigation.
+
+Prefer the **project-local** `npm run inspect -- <slug>` helper: it resolves local
+Playwright, waits for settled transitions, captures each step, and prints advisory
+collision/active-state/attribution warnings. If absent, put any temporary Playwright
+helper under project root, never elsewhere. Review first, last, and dense/key
+screenshots or equivalent browser views; responsive-sensitive scenes also need a
+narrow view, e.g. `npm run inspect -- <slug> --width 390 --height 844`. In this repo
+use chrome-devtools-axi for interactive browser inspection, snapshot before
+screenshots, without substituting it for deterministic verification. Honor caller
+restrictions reserving interactive acceptance for a separate tester.
+
+Review every warning's cited step. Fix accidental text/chrome collisions,
+indistinct active chrome and unpolished attribution. Mark only intentional readable
+overlap subtrees with data-presentation-allow-overlap. Re-run inspection after
+fixes. Ensure important content fits canvas, overlaps remain readable, and captions,
+progress, ToC and navigation don't collide with content. Screenshots and warnings
+are review artifacts, not automated proof of taste. Repair functional/composition
+failures before success and report remaining advisory status accurately.
diff --git a/skills/presentation/scaffold.mjs b/skills/presentation/scaffold.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d18b8e7530042368e43c1b58991328e290fbfd92
--- /dev/null
+++ b/skills/presentation/scaffold.mjs
@@ -0,0 +1,57 @@
+import { cp, mkdir, readFile, readdir, rm, writeFile } from 'node:fs/promises'
+import { dirname, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+const bootstrap = fileURLToPath(new URL('./templates/bootstrap/', import.meta.url))
+async function files(dir, prefix = '') {
+  const entries = await readdir(dir, { withFileTypes: true })
+  return (await Promise.all(entries.map(entry => entry.isDirectory() ? files(resolve(dir, entry.name), prefix + entry.name + '/') : prefix + entry.name))).flat()
+}
+export async function scaffold(target, requested = ['build', 'kit', 'index']) {
+  if (requested.some(anchor => !['build', 'kit', 'index'].includes(anchor))) throw new Error('Unknown scaffold anchor')
+  // A target without its own package.json cannot have a build anchor, so a new self-contained app always receives one.
+  const hasPackage = await readFile(resolve(target, 'package.json')).then(() => true, error => { if (error.code !== 'ENOENT') throw error; return false })
+  const anchors = hasPackage ? requested : [...new Set([...requested, 'build'])]
+  const selected = (await files(bootstrap)).filter(path => {
+    if (path.startsWith('src/presentation-kit/')) return anchors.includes('kit')
+    if (path.startsWith('src/')) return anchors.includes('index')
+    return anchors.includes('build') || path.startsWith('scripts/')
+  }).filter(path => !['package.json', 'package-lock.json'].includes(path))
+  const plan = []
+  for (const path of selected) {
+    const source = resolve(bootstrap, path), destination = resolve(target, path)
+    let existing
+    try { existing = await readFile(destination) } catch (error) { if (error.code !== 'ENOENT') throw error }
+    if (existing) {
+      if (!existing.equals(await readFile(source))) throw new Error(`Refusing to overwrite existing file: ${destination}`)
+    } else plan.push({ source, destination })
+  }
+  const packagePath = resolve(target, 'package.json')
+  let original
+  try { original = await readFile(packagePath, 'utf8') } catch (error) { if (error.code !== 'ENOENT') throw error }
+  const template = JSON.parse(await readFile(resolve(bootstrap, 'package.json'), 'utf8'))
+  const host = original ? JSON.parse(original) : template
+  const combined = { ...host, scripts: { ...template.scripts, ...host.scripts }, dependencies: { ...template.dependencies, ...host.dependencies }, devDependencies: { ...template.devDependencies, ...host.devDependencies } }
+  const written = []
+  let wrotePackage = false
+  try {
+    for (const { source, destination } of plan) { await mkdir(dirname(destination), { recursive: true }); await cp(source, destination); written.push(destination) }
+    await mkdir(target, { recursive: true })
+    await writeFile(packagePath, JSON.stringify(combined, null, 2) + '\n'); wrotePackage = true
+    if (!original) { const lock = resolve(target, 'package-lock.json'); await cp(resolve(bootstrap, 'package-lock.json'), lock, { errorOnExist: true, force: false }); written.push(lock) }
+  } catch (error) {
+    for (const path of written.reverse()) await rm(path, { force: true })
+    if (wrotePackage) { if (original) await writeFile(packagePath, original); else await rm(packagePath, { force: true }) }
+    throw error
+  }
+  return written
+}
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const args = process.argv.slice(2)
+  const target = args[args.indexOf('--target') + 1]
+  const anchorArg = args.indexOf('--anchors')
+  try {
+    if (!args.includes('--target') || !target) throw new Error('Specify --target after contract detection and required confirmation')
+    await scaffold(resolve(target), anchorArg >= 0 ? args[anchorArg + 1].split(',') : undefined)
+    console.log(`Scaffold copied to ${resolve(target)}. Install dependencies before use.`)
+  } catch (error) { console.error(error.message); process.exitCode = 1 }
+}
