+}
+
+.talk-sample .tray {
+  border-radius: 14px;
+  background: rgba(255, 255, 255, 0.05);
+}
+
+.talk-sample .card {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: 8px;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  background: var(--panel);
+}
+
+.talk-sample .card-title {
+  color: var(--gold);
+  font-weight: 700;
+}
+
+.talk-sample .card.ghost {
+  border-style: dashed;
+  color: var(--muted);
+  justify-content: center;
+  text-align: center;
+}
+
+.talk-sample .card.verify {
+  border-color: var(--green);
+}
+
+.talk-sample .socket {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid var(--gold);
+  border-radius: 0 0 10px 10px;
+  background: #2a251e;
+  white-space: nowrap;
+}
+
+.talk-sample .morph-label {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: var(--muted);
+  font-size: 18px;
+}
+
+.talk-sample .edge path {
