+import { snapshotPage } from './lib/page-snapshot.mjs'
+import { withPreview } from './lib/preview.mjs'
+import { readRegistry } from './lib/registry.mjs'
+
+const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..')
+const DEFAULT_VIEWPORT = '1440x900'
+
+async function main() {
+  const opts = parseInspectArgs(process.argv.slice(2))
+  if (!existsSync(join(ROOT, 'dist', 'index.html'))) throw new Error('no production build found; run `npm run build` first')
+  if (!readRegistry(ROOT).some((e) => e.slug === opts.slug)) throw new Error(`"${opts.slug}" is not registered in src/presentations/index.ts`)
+
+  const base = join(ROOT, '.inspection', opts.slug)
+  const outDir = opts.viewport === DEFAULT_VIEWPORT ? base : join(base, opts.viewport)
+  mkdirSync(outDir, { recursive: true })
+  for (const f of readdirSync(outDir)) if (/^step-\d+\.png$/.test(f)) rmSync(join(outDir, f))
+
+  const warnings = await withPreview(ROOT, async (baseUrl) => {
+    const browser = await chromium.launch()
+    try {
+      const page = await browser.newPage({ viewport: { width: opts.width, height: opts.height } })
+      await page.goto(`${baseUrl}/${opts.slug}`, { waitUntil: 'load' })
+      await page.waitForSelector('[data-step-count]', { timeout: 10000 })
+      const count = Number(await page.getAttribute('[data-step-count]', 'data-step-count'))
+      const read = async () => Number(await page.getAttribute('[data-step-index]', 'data-step-index'))
+      return await captureSteps(page, {
+        count,
+        settleMs: opts.settleMs,
+        shotPath: (n) => join(outDir, stepFileName(n)),
+        snapshot: snapshotPage,
+        waitForStep: (i) => waitForIndex(read, i, { from: i - 1 }),
+        log: console.log,
+      })
+    } finally {
+      await browser.close()
+    }
+  })
+  console.log(`Inspected ${opts.slug} at ${opts.viewport}: screenshots in ${relative(ROOT, outDir)}, ${warnings.length} warning(s)`)
+}
+
+main().catch((err) => {
+  console.error(`ERROR inspect: ${err instanceof Error ? err.message : err}`)
+  process.exit(1)
+})
diff --git a/scripts/lib/checks.mjs b/scripts/lib/checks.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..64ef9bb82df5a1071b13861387232e7b75b8c587
--- /dev/null
+++ b/scripts/lib/checks.mjs
@@ -0,0 +1,84 @@
+/** A verification failure that names its phase (build, sample, render) and, when known, the step index. */
+export class VerifyError extends Error {
+  /**
+   * @param {string} phase
+   * @param {string} message
+   * @param {number | null} [step]
+   */
+  constructor(phase, message, step = null) {
+    super(message)
+    this.phase = phase
+    this.step = step
+  }
+}
+
+export function formatFailure(err) {
+  if (err instanceof VerifyError) {
+    const where = err.step === null ? '' : ` (step index ${err.step})`
+    return `FAIL ${err.phase}${where}: ${err.message}`
+  }
+  return `FAIL verify: ${err instanceof Error ? err.message : String(err)}`
+}
+
+/** Sample phase: the reference sample is registered, titled correctly and loadable. */
+export function validateRegistry(entries, { slug, title }, loaderOk = () => true) {
+  const entry = entries.find((e) => e.slug === slug)
+  if (!entry) throw new VerifyError('sample', `reference sample "${slug}" is not registered in src/presentations/index.ts`)
+  if (entry.title !== title) throw new VerifyError('sample', `registry title "${entry.title}" does not match "${title}"`)
+  if (!loaderOk(entry.loader)) throw new VerifyError('sample', `loader "${entry.loader}" for "${slug}" does not resolve to a file`)
+  return entry
+}
+
+/** Sample phase: the rendered step matches the normative outline at that position. */
+export function validateSampleStep(index, rendered, outline) {
+  const expected = outline[index]
+  if (!expected) throw new VerifyError('sample', `unexpected step ${index}; the sample has ${outline.length} steps`, index)
+  for (const field of ['title', 'caption', 'presentTitle']) {
+    const want = field === 'presentTitle' ? expected.title : expected[field]
+    if (rendered[field] !== want) {
+      throw new VerifyError('sample', `${field} is ${JSON.stringify(rendered[field])}, expected ${JSON.stringify(want)}`, index)
+    }
+  }
+}
+
+export function validateStepCount(count, outline) {
+  if (count !== outline.length) throw new VerifyError('sample', `sample renders ${count} steps, expected ${outline.length}`)
+}
+
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
+
+/**
+ * Render phase: waits for the public step index to become `expected`; anything else fails at `from`.
+ * `check` runs before each poll so a recorded browser error surfaces ahead of a generic timeout.
+ */
+export async function waitForIndex(read, expected, { from = expected, timeoutMs = 5000, pollMs = 50, check = () => {} } = {}) {
+  const deadline = Date.now() + timeoutMs
+  for (;;) {
+    check()
+    const value = await read()
+    if (value === expected) return
+    if (value !== null && value !== from) {
+      throw new VerifyError('render', `step index became ${value}, expected ${expected}`, expected)
+    }
+    if (Date.now() >= deadline) {
+      throw new VerifyError('render', `step index stayed ${value} for ${timeoutMs}ms, expected ${expected}`, expected)
+    }
+    await sleep(pollMs)
+  }
+}
+
+/** Records console errors and uncaught page errors against the step being rendered. */
+export function collectBrowserErrors(page, getStep) {
+  const errors = []
+  page.on('console', (msg) => {
+    if (msg.type() === 'error') errors.push({ step: getStep(), text: `console.error: ${msg.text()}` })
+  })
+  page.on('pageerror', (err) => errors.push({ step: getStep(), text: `uncaught page error: ${err.message ?? err}` }))
+  return {
+    errors,
+    check() {
+      const first = errors[0]
+      if (first) throw new VerifyError('render', first.text, first.step)
+    },
+  }
+}
diff --git a/scripts/lib/inspect-checks.mjs b/scripts/lib/inspect-checks.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4e7b899030ea4603cb81f905f201eb7d2e8f4720
--- /dev/null
+++ b/scripts/lib/inspect-checks.mjs
@@ -0,0 +1,116 @@
+// Pure diagnostics over page snapshots; every finding is advisory.
+const MIN_OVERLAP_PX = 2
+const MIN_OVERLAP_RATIO = 0.1
+const MIN_ATTRIBUTION_PX = 11
+const DEFAULT_LINK_COLORS = ['rgb(0, 0, 238)', 'rgb(85, 26, 139)', 'rgb(158, 158, 255)']
+
+export function intersection(a, b) {
+  const w = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x)
+  const h = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y)
+  return w > 0 && h > 0 ? { w, h } : null
+}
+
+/** Pairs of visible text/chrome items that collide, unless either sits in an allow-overlap subtree. */
+export function findOverlaps(items) {
+  const found = []
+  for (let i = 0; i < items.length; i++) {
+    for (let j = i + 1; j < items.length; j++) {
+      const a = items[i]
+      const b = items[j]
+      if (a.allowed || b.allowed) continue
+      if (a.ancestors.includes(j) || b.ancestors.includes(i)) continue
+      const overlap = intersection(a.rect, b.rect)
+      if (!overlap || overlap.w < MIN_OVERLAP_PX || overlap.h < MIN_OVERLAP_PX) continue
+      const smaller = Math.min(a.rect.w * a.rect.h, b.rect.w * b.rect.h)
+      if ((overlap.w * overlap.h) / smaller < MIN_OVERLAP_RATIO) continue
+      found.push([a.label, b.label])
+    }
+  }
+  return found
+}
+
+/** True when the active and inactive entries differ in at least one visible computed style. */
+export function isDistinct(active, inactive) {
+  return Object.keys(active).some((k) => active[k] !== inactive[k])
+}
+
+export function attributionIssues(attribution) {
+  if (!attribution) return ['is missing']
+  const issues = []
+  if (attribution.fontSize < MIN_ATTRIBUTION_PX) issues.push(`is too small (${attribution.fontSize}px)`)
+  if (DEFAULT_LINK_COLORS.includes(attribution.color)) issues.push('uses the browser-default link color')
+  return issues
+}
+
+/** Text drawn smaller than this is not readable; the fixed canvas shrinks it on narrow viewports. */
+export const MIN_TEXT_PX = 7
+
+/** Labels of visible text drawn below `MIN_TEXT_PX`, smallest first. Items without a size are skipped. */
+export function smallText(items) {
+  return items
+    .filter((i) => typeof i.fontPx === 'number' && i.fontPx < MIN_TEXT_PX)
+    .sort((a, b) => a.fontPx - b.fontPx)
+    .map((i) => ({ label: i.label, px: i.fontPx }))
+}
+
+/** Advisory warnings for one captured step (`stepNumber` is one-based). */
+export function diagnose(snapshot, stepNumber) {
+  const warnings = []
+  const warn = (msg) => warnings.push(`WARN step ${stepNumber}: ${msg}`)
+  for (const [a, b] of findOverlaps(snapshot.overlapItems)) {
+    warn(`${a} overlaps ${b}; fix the collision or mark an intentional readable overlap with data-presentation-allow-overlap`)
+  }
+  for (const [name, pair] of [['progress indicator', snapshot.progress], ['table-of-contents entry', snapshot.toc]]) {
+    if (pair && !isDistinct(pair.active, pair.inactive)) {
+      warn(`active ${name} is visually indistinct from inactive ones; style [data-presentation-active="true"] in presentation CSS`)
+    }
+  }
+  const small = smallText(snapshot.overlapItems)
+  if (small.length) {
+    const sample = small.slice(0, 3).map((t) => `${t.label} (${t.px.toFixed(1)}px)`).join(', ')
+    warn(
+      `${small.length} text element(s) render below ${MIN_TEXT_PX}px and are hard to read, e.g. ${sample}; ` +
+        'size diagram text in canvas units in presentation CSS, since the canvas is scaled to fit the viewport',
+    )
+  }
+  const issues = attributionIssues(snapshot.attribution)
+  if (issues.length) warn(`attribution ${issues.join(' and ')}; style [data-presentation-attribution] in presentation CSS`)
+  return warnings
+}
+
+export function parseInspectArgs(argv, defaults = { viewport: '1440x900', settleMs: 1200 }) {
+  const opts = { slug: null, viewport: defaults.viewport, settleMs: defaults.settleMs }
+  for (let i = 0; i < argv.length; i++) {
+    const arg = argv[i]
+    if (arg === '--viewport') opts.viewport = argv[++i]
+    else if (arg === '--settle-ms') opts.settleMs = Number(argv[++i])
+    else if (arg.startsWith('--')) throw new Error(`unknown option ${arg}`)
+    else if (opts.slug === null) opts.slug = arg
+    else throw new Error(`unexpected argument ${arg}`)
+  }
+  if (!opts.slug) throw new Error('usage: inspect-presentation <slug> [--viewport WxH] [--settle-ms N]')
+  const m = /^(\d+)x(\d+)$/.exec(opts.viewport ?? '')
+  if (!m) throw new Error(`invalid --viewport "${opts.viewport}"; expected WxH`)
+  if (!Number.isFinite(opts.settleMs) || opts.settleMs < 0) throw new Error('invalid --settle-ms')
+  return { ...opts, width: Number(m[1]), height: Number(m[2]) }
+}
+
+export const stepFileName = (stepNumber) => `step-${String(stepNumber).padStart(2, '0')}.png`
+
+/** Steps through the presentation, capturing a settled screenshot and diagnostics per step. */
+export async function captureSteps(page, { count, settleMs, shotPath, snapshot, waitForStep, log = () => {} }) {
+  const warnings = []
+  for (let i = 0; i < count; i++) {
+    if (i > 0) {
+      await page.keyboard.press('ArrowRight')
+      await waitForStep(i)
+    }
+    await page.waitForTimeout(settleMs)
+    await page.screenshot({ path: shotPath(i + 1) })
+    for (const w of diagnose(await page.evaluate(snapshot), i + 1)) {
+      warnings.push(w)
+      log(w)
+    }
+  }
+  return warnings
+}
