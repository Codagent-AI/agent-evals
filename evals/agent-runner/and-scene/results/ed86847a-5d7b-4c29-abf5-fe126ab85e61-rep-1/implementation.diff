diff --git a/skills/presentation/templates/bootstrap/scripts/lib/page-snapshot.mjs b/skills/presentation/templates/bootstrap/scripts/lib/page-snapshot.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c0af95f3384fd5f507d12e894bae4b7dbc0ad250
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/page-snapshot.mjs
@@ -0,0 +1,79 @@
+// Runs inside the page (serialized by Playwright): must stay self-contained.
+export function snapshotPage() {
+  const STYLE_KEYS = [
+    'color', 'backgroundColor', 'borderTopColor', 'borderTopWidth', 'opacity', 'fontWeight',
+    'textDecorationLine', 'boxShadow', 'outlineStyle', 'transform',
+  ]
+  const styleOf = (el) => {
+    const cs = getComputedStyle(el)
+    return Object.fromEntries(STYLE_KEYS.map((k) => [k, cs[k]]))
+  }
+  const CHROME = 'button, a[href], [data-presentation-progress-item]'
+  const visible = (el) => {
+    const r = el.getBoundingClientRect()
+    return r.width > 0 && r.height > 0 && el.checkVisibility({ opacityProperty: true, visibilityProperty: true })
+  }
+  const textRect = (el) => {
+    const range = document.createRange()
+    let union = null
+    for (const node of el.childNodes) {
+      if (node.nodeType !== Node.TEXT_NODE || !node.textContent.trim()) continue
+      range.selectNodeContents(node)
+      const r = range.getBoundingClientRect()
+      if (r.width === 0 || r.height === 0) continue
+      union = union
+        ? { l: Math.min(union.l, r.left), t: Math.min(union.t, r.top), r: Math.max(union.r, r.right), b: Math.max(union.b, r.bottom) }
+        : { l: r.left, t: r.top, r: r.right, b: r.bottom }
+    }
+    return union && { x: union.l, y: union.t, w: union.r - union.l, h: union.b - union.t }
+  }
+  // Font size as drawn: the fixed canvas is scaled by a transform, which computed style ignores.
+  const renderedFontPx = (el) => {
+    const size = parseFloat(getComputedStyle(el).fontSize)
+    const drawn = el instanceof HTMLElement && el.offsetWidth > 0 ? el.getBoundingClientRect().width / el.offsetWidth : 1
+    return size * drawn
+  }
+  const describe = (el) => {
+    const owner = el.closest('[data-presentation-entity]')
+    const hook = [...el.attributes].find((a) => a.name.startsWith('data-presentation-') && a.name !== 'data-presentation-active')
+    const label = (el.textContent || '').trim().slice(0, 24)
+    return `<${el.tagName.toLowerCase()}${hook ? ` ${hook.name}` : ''}>${owner && owner !== el ? ` in [${owner.getAttribute('data-presentation-entity')}]` : ''} "${label}"`
+  }
+
+  const els = [...document.body.querySelectorAll('*')].filter((el) => !['SCRIPT', 'STYLE', 'defs', 'marker'].includes(el.tagName))
+  const items = []
+  const index = new Map()
+  for (const el of els) {
+    if (!visible(el)) continue
+    const chrome = el.matches(CHROME)
+    const r = chrome ? el.getBoundingClientRect() : textRect(el)
+    if (!r) continue
+    const rect = chrome ? { x: r.x, y: r.y, w: r.width, h: r.height } : r
+    index.set(el, items.length)
+    items.push({ el, rect, chrome })
+  }
+  const overlapItems = items.map(({ el, rect, chrome }) => {
+    const ancestors = []
+    for (let p = el.parentElement; p; p = p.parentElement) if (index.has(p)) ancestors.push(index.get(p))
+    return { label: describe(el), rect, chrome, fontPx: renderedFontPx(el), allowed: el.closest('[data-presentation-allow-overlap]') !== null, ancestors }
+  })
+
+  const pair = (container) => {
+    const entries = [...document.querySelectorAll(container)].filter(visible)
+    const active = entries.find((e) => e.getAttribute('data-presentation-active') === 'true')
+    const inactive = entries.find((e) => e.getAttribute('data-presentation-active') !== 'true')
+    return active && inactive ? { active: styleOf(active), inactive: styleOf(inactive) } : null
+  }
+  const attr = document.querySelector('[data-presentation-attribution]')
+  const attrStyle = attr && getComputedStyle(attr)
+  return {
+    overlapItems,
+    progress: pair('[data-presentation-progress-item]'),
+    toc: pair('[data-presentation-toc-entry]'),
+    attribution: attr && {
+      fontSize: parseFloat(attrStyle.fontSize),
+      color: attrStyle.color,
+      textDecorationLine: attrStyle.textDecorationLine,
+    },
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/preview.mjs b/skills/presentation/templates/bootstrap/scripts/lib/preview.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8c26ab08549d0b593dae7a62a740d857abc735fd
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/preview.mjs
@@ -0,0 +1,93 @@
+import { spawn } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import http from 'node:http'
+import net from 'node:net'
+import { createRequire } from 'node:module'
+import { dirname, join } from 'node:path'
+
+/** Every server bind, readiness probe and browser URL uses this IPv4 loopback address. */
+export const HOST = '127.0.0.1'
+
+export function pickFreePort() {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer()
+    server.once('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+}
+
+export const urlFor = (port, path = '/') => `http://${HOST}:${port}${path}`
+
+function probe(url) {
+  return new Promise((resolve) => {
+    const req = http.get(url, (res) => {
+      res.resume()
+      resolve(res.statusCode === 200)
+    })
+    req.on('error', () => resolve(false))
+    req.setTimeout(1000, () => req.destroy())
+  })
+}
+
+/**
+ * @param {string} url
+ * @param {{ timeoutMs?: number, pollMs?: number, probeFn?: (url: string) => Promise<boolean>, failed?: () => string | null }} [options]
+ */
+export async function waitForReady(url, { timeoutMs = 30000, pollMs = 100, probeFn = probe, failed = () => null } = {}) {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    const reason = failed()
+    if (reason) throw new Error(`preview server exited early: ${reason}`)
+    if (await probeFn(url)) return
+    await new Promise((r) => setTimeout(r, pollMs))
+  }
+  throw new Error(`preview server did not become ready at ${url} within ${timeoutMs}ms`)
+}
+
+/** Starts `vite preview` (production build) bound to the loopback host. */
+export function startPreview(root, port) {
+  const viteBin = join(dirname(createRequire(join(root, 'package.json')).resolve('vite/package.json')), 'bin', 'vite.js')
+  if (!existsSync(viteBin)) throw new Error(`vite not found at ${viteBin}`)
+  const child = spawn(process.execPath, [viteBin, 'preview', '--host', HOST, '--port', String(port), '--strictPort'], {
+    cwd: root,
+    stdio: ['ignore', 'pipe', 'pipe'],
+  })
+  let output = ''
+  child.stdout.on('data', (d) => (output += d))
+  child.stderr.on('data', (d) => (output += d))
+  const exited = new Promise((resolve) => child.once('exit', resolve))
+  return {
+    port,
+    failed: () => (child.exitCode !== null ? `code ${child.exitCode}\n${output}` : null),
+    async stop() {
+      if (child.exitCode !== null) return
+      child.kill('SIGTERM')
+      const timer = setTimeout(() => child.kill('SIGKILL'), 3000)
+      await exited
+      clearTimeout(timer)
+    },
+  }
+}
+
+/**
+ * Runs `fn(baseUrl, port)` against a ready preview and always stops the preview afterwards.
+ * @template T
+ * @param {string} root
+ * @param {(baseUrl: string, port: number) => Promise<T>} fn
+ * @param {{ pick?: () => Promise<number>, start?: (root: string, port: number) => any, ready?: (url: string, options: any) => Promise<void> }} [deps]
+ * @returns {Promise<T>}
+ */
+export async function withPreview(root, fn, deps = {}) {
+  const { pick = pickFreePort, start = startPreview, ready = waitForReady } = deps
+  const port = await pick()
+  const preview = start(root, port)
+  try {
+    await ready(urlFor(port), { failed: preview.failed })
+    return await fn(urlFor(port, ''), port)
+  } finally {
+    await preview.stop()
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/registry.mjs b/skills/presentation/templates/bootstrap/scripts/lib/registry.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7049c6b7a6f1337b14a1d9306017d0685e7f4952
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/registry.mjs
@@ -0,0 +1,20 @@
+import { existsSync, readFileSync } from 'node:fs'
+import { join } from 'node:path'
+
+const ENTRY = /slug:\s*(['"])(.*?)\1\s*,\s*title:\s*(['"])(.*?)\3\s*,\s*load:\s*\(\)\s*=>\s*import\(\s*(['"])(.*?)\5\s*\)/gs
+
+/** Reads `{ slug, title, load: () => import('...') }` entries from the registry source. */
+export function parseRegistry(source) {
+  return [...source.matchAll(ENTRY)].map((m) => ({ slug: m[2], title: m[4], loader: m[6] }))
+}
+
+export function readRegistry(root) {
+  const file = join(root, 'src', 'presentations', 'index.ts')
+  if (!existsSync(file)) return []
+  return parseRegistry(readFileSync(file, 'utf8'))
+}
+
+export function loaderExists(root, loader) {
+  const base = join(root, 'src', 'presentations', loader)
+  return ['.tsx', '.ts', '.jsx', '.js', '/index.tsx', '/index.ts'].some((ext) => existsSync(base + ext))
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/verify.mjs b/skills/presentation/templates/bootstrap/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..044e5be497e862fb24baeacea232a5068187a6d2
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/verify.mjs
@@ -0,0 +1,117 @@
+// Deterministic verification: build, sample check, and a real-browser render of every step.
+import { spawn } from 'node:child_process'
+import { existsSync, readFileSync } from 'node:fs'
+import { dirname, join, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { chromium } from 'playwright'
+import {
+  VerifyError, collectBrowserErrors, formatFailure, validateRegistry, validateSampleStep, validateStepCount, waitForIndex,
+} from './lib/checks.mjs'
+import { SAMPLE_OUTLINE, SAMPLE_SLUG, SAMPLE_TITLE } from './lib/outline.mjs'
+import { withPreview } from './lib/preview.mjs'
+import { loaderExists, readRegistry } from './lib/registry.mjs'
+
+const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..')
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
+// Entrances (layout delay + fade) take about 0.9s; errors raised while a step is still settling
+// must be seen, and attributed to that step, before the next transition starts.
+const SETTLE_MS = 1100
+
+function readConfig() {
+  const file = join(ROOT, 'verify.config.json')
+  return existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : {}
+}
+
+function build() {
+  return new Promise((resolveBuild, reject) => {
+    const child = spawn('npm', ['run', 'build'], { cwd: ROOT, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (d) => (output += d))
+    child.stderr.on('data', (d) => (output += d))
+    child.on('error', (e) => reject(new VerifyError('build', e.message)))
+    child.on('exit', (code) => {
+      if (code === 0) return resolveBuild()
+      reject(new VerifyError('build', `npm run build exited with code ${code}\n${output.split('\n').slice(-25).join('\n')}`))
+    })
+  })
+}
+
+const readText = (page, selector) => page.locator(selector).first().textContent()
+
+async function renderSteps(page, baseUrl, slug, outline) {
+  let current = 0
+  const visited = []
+  const collector = collectBrowserErrors(page, () => current)
+  const url = `${baseUrl}/${slug}`
+  await page.goto(url, { waitUntil: 'load' })
+  await page.waitForSelector('[data-step-count]', { timeout: 10000 }).catch(() => {
+    collector.check()
+    throw new VerifyError('render', `/${slug} did not render the step-count hook`)
+  })
+  const read = async () => {
+    const value = await page.evaluate(() => document.querySelector('[data-step-index]')?.getAttribute('data-step-index') ?? null)
+    return value === null ? null : Number(value)
+  }
+  const options = (from) => ({ from, check: () => collector.check() })
+  const count = Number(await page.getAttribute('[data-step-count]', 'data-step-count', { timeout: 5000 }))
+  if (outline) validateStepCount(count, outline)
+  if (!(count > 0)) throw new VerifyError('render', `/${slug} reports ${count} steps`)
+  for (let i = 0; i < count; i++) {
+    current = i
+    await waitForIndex(read, i, options(i === 0 ? 0 : i - 1))
+    visited.push(i)
+    await sleep(SETTLE_MS)
+    collector.check()
+    if (outline) {
+      const rendered = { title: await readText(page, '[data-presentation-title]'), caption: await readText(page, '[data-presentation-caption]') }
+      await page.keyboard.press('p')
+      rendered.presentTitle = await readText(page, '[data-presentation-title]')
+      await page.keyboard.press('p')
+      validateSampleStep(i, rendered, outline)
+    }
+    if (i < count - 1) {
+      current = i + 1
+      await page.keyboard.press('ArrowRight')
+      await waitForIndex(read, i + 1, options(i))
+    }
+  }
+  await sleep(SETTLE_MS)
+  collector.check()
+  return { count, visited, url }
+}
+
+async function main() {
+  const config = readConfig()
+  const required = config.requiredSample ?? null
+  await build()
+  console.log('ok build')
+
+  const registry = readRegistry(ROOT)
+  if (required) validateRegistry(registry, { slug: required, title: SAMPLE_TITLE }, (l) => loaderExists(ROOT, l))
+  const targets = required ? [required] : registry.map((e) => e.slug)
+  if (targets.length === 0) throw new VerifyError('sample', 'no presentations are registered')
+  console.log(`ok sample (${targets.join(', ')})`)
+
+  let total = 0
+  await withPreview(ROOT, async (baseUrl) => {
+    console.log(`ok preview ${baseUrl}`)
+    const browser = await chromium.launch()
+    try {
+      for (const slug of targets) {
+        const page = await browser.newPage()
+        const { count, visited, url } = await renderSteps(page, baseUrl, slug, slug === SAMPLE_SLUG ? SAMPLE_OUTLINE : null)
+        total += count
+        console.log(`ok render ${url} steps ${visited.join(',')}`)
+        await page.close()
+      }
+    } finally {
+      await browser.close()
+    }
+  })
+  console.log(`PASS verify: build, sample, render (${targets.length} presentation(s), ${total} steps)`)
+}
+
+main().catch((err) => {
+  console.error(formatFailure(err))
+  process.exit(1)
+})
diff --git a/skills/presentation/templates/bootstrap/src/App.tsx b/skills/presentation/templates/bootstrap/src/App.tsx
