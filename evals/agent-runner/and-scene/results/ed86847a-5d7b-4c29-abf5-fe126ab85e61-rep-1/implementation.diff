diff --git a/src/presentation-kit/useFitScale.ts b/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..326cee96a098ca48b2589c59815994ed2bd67e95
--- /dev/null
+++ b/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,37 @@
+import { useEffect, useState } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT, WIDE_VIEWPORT_MIN, type Mode } from './constants'
+import type { Canvas } from './types'
+
+export interface Viewport {
+  width: number
+  height: number
+}
+
+const DEFAULT_CANVAS: Canvas = { width: DESIGN_W, height: DESIGN_H }
+
+/** Uniform scale that fits the canvas in the space left by the mode's chrome. */
+export function fitScale(viewport: Viewport, mode: Mode, canvas: Canvas = DEFAULT_CANVAS): number {
+  const { top, bottom, side } = STAGE_LAYOUT[mode]
+  const availW = viewport.width - side * 2
+  const availH = viewport.height - top - bottom
+  return Math.max(MIN_SCALE, Math.min(availW / canvas.width, availH / canvas.height))
+}
+
+export function useViewport(): Viewport {
+  const read = (): Viewport => ({ width: window.innerWidth, height: window.innerHeight })
+  const [viewport, setViewport] = useState(read)
+  useEffect(() => {
+    const onResize = () => setViewport(read())
+    window.addEventListener('resize', onResize)
+    return () => window.removeEventListener('resize', onResize)
+  }, [])
+  return viewport
+}
+
+export function useFitScale(mode: Mode, canvas: Canvas = DEFAULT_CANVAS): number {
+  return fitScale(useViewport(), mode, canvas)
+}
+
+export function useIsWide(): boolean {
+  return useViewport().width >= WIDE_VIEWPORT_MIN
+}
diff --git a/src/presentation-kit/usePresentationNav.ts b/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0378249d7771dd3dfff537fb5073488a4b61ef40
--- /dev/null
+++ b/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,73 @@
+import { useCallback, useEffect, useState } from 'react'
+import { SWIPE_MIN, type Mode } from './constants'
+
+const INTERACTIVE =
+  'button, a[href], input, select, textarea, summary, [contenteditable]:not([contenteditable="false"])'
+
+const NEXT_KEYS = new Set(['ArrowRight', ' ', 'PageDown'])
+const PREV_KEYS = new Set(['ArrowLeft', 'PageUp'])
+
+function isInteractive(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE) !== null
+}
+
+export interface PresentationNav {
+  index: number
+  mode: Mode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  toggleMode: () => void
+}
+
+/** Keyboard, touch and mode state for a presentation. Navigation clamps at both ends. */
+export function usePresentationNav(count: number, initialMode: Mode = 'browse'): PresentationNav {
+  const [rawIndex, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const last = Math.max(0, count - 1)
+  const index = Math.min(rawIndex, last)
+
+  const next = useCallback(() => setIndex((i) => Math.min(last, i + 1)), [last])
+  const prev = useCallback(() => setIndex((i) => Math.max(0, Math.min(last, i) - 1)), [last])
+  const goTo = useCallback((i: number) => setIndex(Math.max(0, Math.min(last, i))), [last])
+  const toggleMode = useCallback(
+    () => setMode((m) => (m === 'browse' ? 'present' : 'browse')),
+    [],
+  )
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.ctrlKey || e.metaKey || e.altKey || isInteractive(e.target)) return
+      if (NEXT_KEYS.has(e.key)) next()
+      else if (PREV_KEYS.has(e.key)) prev()
+      else if (e.key === 'p' || e.key === 'P') toggleMode()
+      else return
+      e.preventDefault()
+    }
+    let start: { x: number; y: number } | null = null
+    const onStart = (e: TouchEvent) => {
+      const t = e.touches[0]
+      start = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onEnd = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      if (!start || !t) return
+      const dx = t.clientX - start.x
+      const dy = t.clientY - start.y
+      start = null
+      if (Math.abs(dx) < SWIPE_MIN || Math.abs(dx) <= Math.abs(dy)) return
+      if (dx < 0) next()
+      else prev()
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onStart)
+    window.addEventListener('touchend', onEnd)
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onStart)
+      window.removeEventListener('touchend', onEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, next, prev, goTo, toggleMode }
+}
diff --git a/src/presentation-kit/usePrevious.ts b/src/presentation-kit/usePrevious.ts
