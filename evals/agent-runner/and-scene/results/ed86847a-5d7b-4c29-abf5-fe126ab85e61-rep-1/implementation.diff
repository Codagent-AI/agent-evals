@@ -0,0 +1,15 @@
+import { presentations, type PresentationEntry } from './presentations'
+
+export type Route =
+  | { kind: 'landing' }
+  | { kind: 'presentation'; entry: PresentationEntry }
+
+/** "/" and unknown paths show the landing page; "/<slug>" opens that presentation. */
+export function resolveRoute(
+  pathname: string,
+  registry: readonly PresentationEntry[] = presentations,
+): Route {
+  const slug = pathname.replace(/^\/+|\/+$/g, '')
+  const entry = registry.find((p) => p.slug === slug)
+  return entry ? { kind: 'presentation', entry } : { kind: 'landing' }
+}
