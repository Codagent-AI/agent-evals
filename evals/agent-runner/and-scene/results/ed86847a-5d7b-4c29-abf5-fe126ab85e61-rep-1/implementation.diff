diff --git a/scripts/lib/page-snapshot.mjs b/scripts/lib/page-snapshot.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c0af95f3384fd5f507d12e894bae4b7dbc0ad250
--- /dev/null
+++ b/scripts/lib/page-snapshot.mjs
@@ -0,0 +1,79 @@
+// Runs inside the page (serialized by Playwright): must stay self-contained.
+export function snapshotPage() {
+  const STYLE_KEYS = [
+    'color', 'backgroundColor', 'borderTopColor', 'borderTopWidth', 'opacity', 'fontWeight',
+    'textDecorationLine', 'boxShadow', 'outlineStyle', 'transform',
+  ]
+  const styleOf = (el) => {
+    const cs = getComputedStyle(el)
+    return Object.fromEntries(STYLE_KEYS.map((k) => [k, cs[k]]))
+  }
+  const CHROME = 'button, a[href], [data-presentation-progress-item]'
+  const visible = (el) => {
+    const r = el.getBoundingClientRect()
+    return r.width > 0 && r.height > 0 && el.checkVisibility({ opacityProperty: true, visibilityProperty: true })
+  }
+  const textRect = (el) => {
+    const range = document.createRange()
+    let union = null
+    for (const node of el.childNodes) {
+      if (node.nodeType !== Node.TEXT_NODE || !node.textContent.trim()) continue
+      range.selectNodeContents(node)
+      const r = range.getBoundingClientRect()
+      if (r.width === 0 || r.height === 0) continue
+      union = union
+        ? { l: Math.min(union.l, r.left), t: Math.min(union.t, r.top), r: Math.max(union.r, r.right), b: Math.max(union.b, r.bottom) }
+        : { l: r.left, t: r.top, r: r.right, b: r.bottom }
+    }
+    return union && { x: union.l, y: union.t, w: union.r - union.l, h: union.b - union.t }
+  }
+  // Font size as drawn: the fixed canvas is scaled by a transform, which computed style ignores.
+  const renderedFontPx = (el) => {
+    const size = parseFloat(getComputedStyle(el).fontSize)
+    const drawn = el instanceof HTMLElement && el.offsetWidth > 0 ? el.getBoundingClientRect().width / el.offsetWidth : 1
+    return size * drawn
+  }
+  const describe = (el) => {
+    const owner = el.closest('[data-presentation-entity]')
+    const hook = [...el.attributes].find((a) => a.name.startsWith('data-presentation-') && a.name !== 'data-presentation-active')
+    const label = (el.textContent || '').trim().slice(0, 24)
+    return `<${el.tagName.toLowerCase()}${hook ? ` ${hook.name}` : ''}>${owner && owner !== el ? ` in [${owner.getAttribute('data-presentation-entity')}]` : ''} "${label}"`
+  }
+
+  const els = [...document.body.querySelectorAll('*')].filter((el) => !['SCRIPT', 'STYLE', 'defs', 'marker'].includes(el.tagName))
+  const items = []
+  const index = new Map()
+  for (const el of els) {
+    if (!visible(el)) continue
+    const chrome = el.matches(CHROME)
+    const r = chrome ? el.getBoundingClientRect() : textRect(el)
+    if (!r) continue
+    const rect = chrome ? { x: r.x, y: r.y, w: r.width, h: r.height } : r
+    index.set(el, items.length)
+    items.push({ el, rect, chrome })
+  }
+  const overlapItems = items.map(({ el, rect, chrome }) => {
+    const ancestors = []
+    for (let p = el.parentElement; p; p = p.parentElement) if (index.has(p)) ancestors.push(index.get(p))
+    return { label: describe(el), rect, chrome, fontPx: renderedFontPx(el), allowed: el.closest('[data-presentation-allow-overlap]') !== null, ancestors }
+  })
+
+  const pair = (container) => {
+    const entries = [...document.querySelectorAll(container)].filter(visible)
+    const active = entries.find((e) => e.getAttribute('data-presentation-active') === 'true')
+    const inactive = entries.find((e) => e.getAttribute('data-presentation-active') !== 'true')
+    return active && inactive ? { active: styleOf(active), inactive: styleOf(inactive) } : null
+  }
+  const attr = document.querySelector('[data-presentation-attribution]')
+  const attrStyle = attr && getComputedStyle(attr)
+  return {
+    overlapItems,
+    progress: pair('[data-presentation-progress-item]'),
+    toc: pair('[data-presentation-toc-entry]'),
+    attribution: attr && {
+      fontSize: parseFloat(attrStyle.fontSize),
+      color: attrStyle.color,
+      textDecorationLine: attrStyle.textDecorationLine,
+    },
+  }
+}
diff --git a/scripts/lib/preview.mjs b/scripts/lib/preview.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8c26ab08549d0b593dae7a62a740d857abc735fd
--- /dev/null
+++ b/scripts/lib/preview.mjs
@@ -0,0 +1,93 @@
+import { spawn } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import http from 'node:http'
+import net from 'node:net'
+import { createRequire } from 'node:module'
+import { dirname, join } from 'node:path'
+
+/** Every server bind, readiness probe and browser URL uses this IPv4 loopback address. */
+export const HOST = '127.0.0.1'
+
+export function pickFreePort() {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer()
+    server.once('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+}
+
+export const urlFor = (port, path = '/') => `http://${HOST}:${port}${path}`
+
+function probe(url) {
+  return new Promise((resolve) => {
+    const req = http.get(url, (res) => {
+      res.resume()
+      resolve(res.statusCode === 200)
+    })
+    req.on('error', () => resolve(false))
+    req.setTimeout(1000, () => req.destroy())
+  })
+}
+
+/**
+ * @param {string} url
+ * @param {{ timeoutMs?: number, pollMs?: number, probeFn?: (url: string) => Promise<boolean>, failed?: () => string | null }} [options]
+ */
+export async function waitForReady(url, { timeoutMs = 30000, pollMs = 100, probeFn = probe, failed = () => null } = {}) {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    const reason = failed()
+    if (reason) throw new Error(`preview server exited early: ${reason}`)
+    if (await probeFn(url)) return
+    await new Promise((r) => setTimeout(r, pollMs))
+  }
+  throw new Error(`preview server did not become ready at ${url} within ${timeoutMs}ms`)
+}
+
+/** Starts `vite preview` (production build) bound to the loopback host. */
+export function startPreview(root, port) {
+  const viteBin = join(dirname(createRequire(join(root, 'package.json')).resolve('vite/package.json')), 'bin', 'vite.js')
+  if (!existsSync(viteBin)) throw new Error(`vite not found at ${viteBin}`)
+  const child = spawn(process.execPath, [viteBin, 'preview', '--host', HOST, '--port', String(port), '--strictPort'], {
+    cwd: root,
+    stdio: ['ignore', 'pipe', 'pipe'],
+  })
+  let output = ''
+  child.stdout.on('data', (d) => (output += d))
+  child.stderr.on('data', (d) => (output += d))
+  const exited = new Promise((resolve) => child.once('exit', resolve))
+  return {
+    port,
+    failed: () => (child.exitCode !== null ? `code ${child.exitCode}\n${output}` : null),
+    async stop() {
+      if (child.exitCode !== null) return
+      child.kill('SIGTERM')
+      const timer = setTimeout(() => child.kill('SIGKILL'), 3000)
+      await exited
+      clearTimeout(timer)
+    },
+  }
+}
+
+/**
+ * Runs `fn(baseUrl, port)` against a ready preview and always stops the preview afterwards.
+ * @template T
+ * @param {string} root
+ * @param {(baseUrl: string, port: number) => Promise<T>} fn
+ * @param {{ pick?: () => Promise<number>, start?: (root: string, port: number) => any, ready?: (url: string, options: any) => Promise<void> }} [deps]
+ * @returns {Promise<T>}
+ */
+export async function withPreview(root, fn, deps = {}) {
+  const { pick = pickFreePort, start = startPreview, ready = waitForReady } = deps
+  const port = await pick()
+  const preview = start(root, port)
+  try {
+    await ready(urlFor(port), { failed: preview.failed })
+    return await fn(urlFor(port, ''), port)
+  } finally {
+    await preview.stop()
+  }
+}
diff --git a/scripts/lib/registry.mjs b/scripts/lib/registry.mjs
