+  color: var(--gold);
+  font-size: 20px;
+  font-weight: 600;
+  white-space: nowrap;
+}
+
+@media (max-width: 600px) {
+  .talk-sample [data-presentation-caption] {
+    font-size: 13px;
+  }
+
+  .talk-sample [data-presentation-title] {
+    font-size: 15px;
+  }
+
+  .talk-sample [data-presentation-marker] {
+    font-size: 10px;
+  }
+}
