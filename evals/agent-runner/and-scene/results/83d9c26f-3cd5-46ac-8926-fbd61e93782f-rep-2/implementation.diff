@@ -0,0 +1,35 @@
+import type { PresentationStep } from '../types'
+import { activation } from './activation'
+import { eraEntries } from './eras'
+
+interface TocProps {
+  steps: readonly PresentationStep[]
+  index: number
+  onGoTo: (index: number) => void
+}
+
+export function Toc({ steps, index, onGoTo }: TocProps) {
+  const activeEra = steps[index].era
+  return (
+    <nav data-presentation-toc="" aria-label="Table of contents">
+      <ol>
+        {eraEntries(steps).map(({ era, first }) => {
+          const active = era === activeEra
+          return (
+            <li key={era}>
+              <button
+                type="button"
+                data-presentation-toc-entry=""
+                data-presentation-active={active ? 'true' : 'false'}
+                aria-current={active ? 'step' : undefined}
+                onClick={activation(() => onGoTo(first))}
+              >
+                {era}
+              </button>
+            </li>
+          )
+        })}
+      </ol>
+    </nav>
+  )
+}
diff --git a/src/presentation-kit/chrome/activation.ts b/src/presentation-kit/chrome/activation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d0576dadeed40cb6ab817e73f0582d94adbd411f
--- /dev/null
+++ b/src/presentation-kit/chrome/activation.ts
@@ -0,0 +1,9 @@
+import type { MouseEvent } from 'react'
+
+/** Mouse activation releases focus so navigation keys keep working; keyboard activation keeps it. */
+export function activation(run: () => void) {
+  return (e: MouseEvent<HTMLElement>) => {
+    run()
+    if (e.detail > 0) e.currentTarget.blur()
+  }
+}
