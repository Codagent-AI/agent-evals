diff --git a/src/presentation-kit/nodes/arrowPath.ts b/src/presentation-kit/nodes/arrowPath.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ace5409e6b20421c66009f763edfc1581879b017
--- /dev/null
+++ b/src/presentation-kit/nodes/arrowPath.ts
@@ -0,0 +1,31 @@
+export interface Point {
+  x: number
+  y: number
+}
+
+/** Room around the line for arrow heads and stroke. */
+export const ARROW_PAD = 12
+
+function controlPoint(from: Point, to: Point, curve: number): Point {
+  const dx = to.x - from.x
+  const dy = to.y - from.y
+  const len = Math.hypot(dx, dy) || 1
+  return { x: (from.x + to.x) / 2 + (-dy / len) * curve, y: (from.y + to.y) / 2 + (dx / len) * curve }
+}
+
+/** Quadratic path whose control point sits `curve` px off the midpoint. */
+export function arrowPath(from: Point, to: Point, curve = 0): string {
+  const c = controlPoint(from, to, curve)
+  return `M ${from.x} ${from.y} Q ${c.x} ${c.y} ${to.x} ${to.y}`
+}
+
+/** Canvas-space box around an arrow, so the arrow can morph as a positioned entity. */
+export function arrowBox(from: Point, to: Point, curve = 0) {
+  const c = controlPoint(from, to, curve)
+  // A quadratic stays inside the hull of its three points; the control point over-reaches slightly, which is safe.
+  const xs = [from.x, to.x, c.x]
+  const ys = [from.y, to.y, c.y]
+  const x = Math.min(...xs) - ARROW_PAD
+  const y = Math.min(...ys) - ARROW_PAD
+  return { x, y, width: Math.max(...xs) + ARROW_PAD - x, height: Math.max(...ys) + ARROW_PAD - y }
+}
diff --git a/src/presentation-kit/nodes/useContinuesFromPrevious.ts b/src/presentation-kit/nodes/useContinuesFromPrevious.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9139b1d3b32c16f322611fccaed385ceca3428af
--- /dev/null
+++ b/src/presentation-kit/nodes/useContinuesFromPrevious.ts
@@ -0,0 +1,22 @@
+import { useEffect, useState } from 'react'
+
+/** Mounted entity instances per id, counting scenes that are still animating out. */
+const mounted = new Map<string, number>()
+
+/**
+ * True when an entity with this id was already mounted before this instance first rendered, which
+ * means the previous scene still holds it while it exits. Such an entity is a continuing one: it
+ * should morph out of the old geometry, not wait hidden for persisting entities to settle.
+ */
+export function useContinuesFromPrevious(id: string): boolean {
+  const [continues] = useState(() => (mounted.get(id) ?? 0) > 0)
+  useEffect(() => {
+    mounted.set(id, (mounted.get(id) ?? 0) + 1)
+    return () => {
+      const left = (mounted.get(id) ?? 1) - 1
+      if (left > 0) mounted.set(id, left)
+      else mounted.delete(id)
+    }
+  }, [id])
+  return continues
+}
