+import { createElement } from 'react'
+import type { ComponentType, ReactElement } from 'react'
+
+/** Narration and identity carried by every step. */
+export interface StepMeta {
+  /** Stable step identity. */
+  id: string
+  /** Section / era label used by the table of contents. */
+  era: string
+  /** Presenter title (one-liner). */
+  title: string
+  /** Browse caption (paragraph). */
+  caption: string
+}
+
+export interface SceneProps<TPayload = undefined> {
+  payload: TPayload
+}
+
+/** Authoring shape: a scene component plus the payload for this step. */
+export interface Step<TPayload = undefined> extends StepMeta {
+  /** Steps sharing a groupKey (and Scene) keep one mounted scene instance. */
+  groupKey?: string
+  Scene: ComponentType<SceneProps<TPayload>>
+  payload: TPayload
+}
+
+/** Payload-erased step accepted by `<Presentation>`. */
+export interface PresentationStep extends StepMeta {
+  groupKey?: string
+  render: () => ReactElement
+}
+
+/** Erase the payload type while keeping the Scene/payload pairing checked. */
+export function defineStep<TPayload>(step: Step<TPayload>): PresentationStep {
+  const { Scene, payload, ...rest } = step
+  return { ...rest, render: () => createElement(Scene, { payload }) }
+}
+
+export interface Attribution {
+  label: string
+  href: string
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c1567e1725c70754d0acbced65a186383f1bd608
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,36 @@
+import { useLayoutEffect, useState } from 'react'
+import type { RefObject } from 'react'
+import { MIN_SCALE, STAGE_LAYOUT } from './constants'
+import type { Canvas, Mode } from './constants'
+
+export function computeFitScale(
+  available: { width: number; height: number },
+  canvas: Canvas,
+  inset: number,
+): number {
+  const w = (available.width - inset * 2) / canvas.width
+  const h = (available.height - inset * 2) / canvas.height
+  const scale = Math.min(w, h)
+  return Number.isFinite(scale) ? Math.max(MIN_SCALE, scale) : MIN_SCALE
+}
+
+/** Uniform fit scale of `canvas` into the element behind `ref`. */
+export function useFitScale(ref: RefObject<HTMLElement | null>, canvas: Canvas, mode: Mode): number {
+  const [size, setSize] = useState({ width: 0, height: 0 })
+
+  useLayoutEffect(() => {
+    const el = ref.current
+    if (!el) return
+    const measure = () => setSize({ width: el.clientWidth, height: el.clientHeight })
+    measure()
+    if (typeof ResizeObserver === 'undefined') {
+      window.addEventListener('resize', measure)
+      return () => window.removeEventListener('resize', measure)
+    }
+    const observer = new ResizeObserver(measure)
+    observer.observe(el)
+    return () => observer.disconnect()
+  }, [ref])
+
+  return computeFitScale(size, canvas, STAGE_LAYOUT[mode].inset)
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6bffeebaabeb534c53a03027fb2c00281eaf9738
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,93 @@
+import { useCallback, useEffect, useState } from 'react'
+import { SWIPE_THRESHOLD } from './constants'
+import type { Mode } from './constants'
+
+export type NavAction = 'next' | 'prev' | 'toggle-mode'
+
+export function clampIndex(index: number, count: number): number {
+  return Math.min(Math.max(index, 0), Math.max(count - 1, 0))
+}
+
+export function actionForKey(key: string): NavAction | null {
+  switch (key) {
+    case 'ArrowRight':
+    case ' ':
+    case 'PageDown':
+      return 'next'
+    case 'ArrowLeft':
+    case 'PageUp':
+      return 'prev'
+    case 'p':
+    case 'P':
+      return 'toggle-mode'
+    default:
+      return null
+  }
+}
+
+export function swipeAction(dx: number, dy: number): 'next' | 'prev' | null {
+  if (Math.abs(dx) < SWIPE_THRESHOLD || Math.abs(dx) <= Math.abs(dy)) return null
+  return dx < 0 ? 'next' : 'prev'
+}
+
+const INTERACTIVE = 'button, a[href], input, select, textarea, summary, [contenteditable=""], [contenteditable="true"], [role="button"], [role="link"], [role="tab"], [role="slider"]'
+
+/** Focused controls keep their own keys. */
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE) !== null
+}
+
+export interface PresentationNav {
+  index: number
+  mode: Mode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  toggleMode: () => void
+}
+
+export function usePresentationNav(count: number, initialMode: Mode = 'browse'): PresentationNav {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+
+  const goTo = useCallback((i: number) => setIndex(clampIndex(i, count)), [count])
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, count)), [count])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'browse' ? 'present' : 'browse')), [])
+
+  useEffect(() => {
+    const run = (action: NavAction | null) => {
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else if (action === 'toggle-mode') toggleMode()
+    }
+    const onKey = (e: KeyboardEvent) => {
+      if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey) return
+      if (isInteractiveTarget(e.target)) return
+      const action = actionForKey(e.key)
+      if (!action) return
+      e.preventDefault()
+      run(action)
+    }
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      start = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onTouchEnd = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      if (start && t) run(swipeAction(t.clientX - start.x, t.clientY - start.y))
+      start = null
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart)
+    window.addEventListener('touchend', onTouchEnd)
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, next, prev, goTo, toggleMode }
+}
