diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f3b71d7aaa86960dc18da316fa1dcf073ae0ff88
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,78 @@
+import { useEffect, useState } from 'react'
+import type { ReactNode } from 'react'
+import { ATTRIBUTION, DEFAULT_CANVAS, WIDE_VIEWPORT } from './constants'
+import type { Canvas, Mode } from './constants'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { Toc } from './chrome/Toc'
+import { Stage } from './Stage'
+import type { Attribution, PresentationStep } from './types'
+import { usePresentationNav } from './usePresentationNav'
+
+export interface PresentationProps {
+  steps: readonly PresentationStep[]
+  title: string
+  initialMode?: Mode
+  /** Host-provided top-left branding; nothing is rendered by default. */
+  brand?: ReactNode
+  /** Override the default attribution, or pass false to hide it. */
+  attribution?: Attribution | false
+  canvas?: Canvas
+}
+
+function useIsWide(): boolean {
+  const [wide, setWide] = useState(() => window.innerWidth >= WIDE_VIEWPORT)
+  useEffect(() => {
+    const update = () => setWide(window.innerWidth >= WIDE_VIEWPORT)
+    window.addEventListener('resize', update)
+    return () => window.removeEventListener('resize', update)
+  }, [])
+  return wide
+}
+
+export function Presentation({
+  steps,
+  title,
+  initialMode = 'browse',
+  brand,
+  attribution = ATTRIBUTION,
+  canvas = DEFAULT_CANVAS,
+}: PresentationProps) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const wide = useIsWide()
+  const step = steps[nav.index]
+  if (!step) return null
+
+  return (
+    <div
+      data-presentation-root=""
+      aria-label={title}
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      data-step-id={step.id}
+      style={{
+        position: 'relative',
+        display: 'grid',
+        gridTemplateRows: 'auto minmax(0, 1fr) auto',
+        width: '100%',
+        height: '100dvh',
+        overflow: 'hidden',
+      }}
+    >
+      <Header
+        mode={nav.mode}
+        index={nav.index}
+        count={steps.length}
+        title={step.title}
+        brand={brand}
+        onToggleMode={nav.toggleMode}
+      />
+      <div data-presentation-main="" style={{ display: 'flex', minHeight: 0, minWidth: 0 }}>
+        {nav.mode === 'browse' && wide ? <Toc steps={steps} index={nav.index} onGoTo={nav.goTo} /> : null}
+        <Stage step={step} mode={nav.mode} canvas={canvas} />
+      </div>
+      <Footer mode={nav.mode} steps={steps} index={nav.index} attribution={attribution} onGoTo={nav.goTo} />
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..37db10fd1f10410ed38d9cfb00e9fcd0c8d5cfef
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,59 @@
+import { useRef } from 'react'
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { ENTER_T } from './constants'
+import type { Canvas, Mode } from './constants'
+import type { PresentationStep } from './types'
+import { useFitScale } from './useFitScale'
+
+interface StageProps {
+  step: PresentationStep
+  mode: Mode
+  canvas: Canvas
+}
+
+/**
+ * Hosts the active step's scene on a fixed design canvas scaled to fit.
+ * Steps with the same groupKey share one wrapper key, so the Scene instance
+ * persists and only its payload changes; otherwise scenes cross-fade.
+ */
+export function Stage({ step, mode, canvas }: StageProps) {
+  const areaRef = useRef<HTMLDivElement>(null)
+  const scale = useFitScale(areaRef, canvas, mode)
+
+  return (
+    <div
+      ref={areaRef}
+      data-presentation-stage=""
+      style={{ position: 'relative', flex: 1, minWidth: 0, minHeight: 0, overflow: 'hidden' }}
+    >
+      <div
+        data-presentation-canvas=""
+        data-presentation-scale={scale.toFixed(3)}
+        style={{
+          position: 'absolute',
+          left: '50%',
+          top: '50%',
+          width: canvas.width,
+          height: canvas.height,
+          transform: `translate(-50%, -50%) scale(${scale})`,
+        }}
+      >
+        <LayoutGroup>
+          <AnimatePresence>
+            <motion.div
+              key={step.groupKey ?? step.id}
+              data-presentation-scene={step.groupKey ?? step.id}
+              initial={{ opacity: 0 }}
+              animate={{ opacity: 1 }}
+              exit={{ opacity: 0 }}
+              transition={{ duration: ENTER_T }}
+              style={{ position: 'absolute', inset: 0 }}
+            >
+              {step.render()}
+            </motion.div>
+          </AnimatePresence>
+        </LayoutGroup>
+      </div>
+    </div>
+  )
+}
diff --git a/src/presentation-kit/chrome/Footer.tsx b/src/presentation-kit/chrome/Footer.tsx
