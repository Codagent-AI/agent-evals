+/* Presentation-owned look: palette, type, spacing and chrome treatments live here, never in the kit. */
+[data-presentation-root] {
+  --ink: #f4efe3;
+  --muted: #a89f8d;
+  --paper: #14110f;
+  --panel: #1f1a16;
+  --line: #5a4f43;
+  --accent: #f2b441;
+  --ok: #6fcf97;
+  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
+  color: var(--ink);
+  background: var(--paper);
+}
+
+[data-presentation-root] button {
+  font: inherit;
+  color: inherit;
+  background: transparent;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  cursor: pointer;
+}
+[data-presentation-root] button:focus-visible,
+[data-presentation-attribution]:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+/* Header */
+[data-presentation-header] {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  padding: 14px 24px 6px;
+}
+[data-presentation-marker] {
+  font-variant-numeric: tabular-nums;
+  color: var(--accent);
+  font-size: 0.9rem;
+  letter-spacing: 0.08em;
+}
+[data-presentation-header] [data-presentation-title] {
+  flex: 1;
+  margin: 0;
+  font-size: 1.35rem;
+  font-weight: 650;
+}
+[data-presentation-mode-toggle] {
+  margin-left: auto;
+  padding: 4px 12px;
+  font-size: 0.8rem;
+}
+
+/* Footer */
+[data-presentation-footer] {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 10px 20px;
+  padding: 8px 24px 14px;
+}
+[data-presentation-footer] [data-presentation-title] {
+  flex: 1;
+  margin: 0;
+  font-size: 2rem;
+  font-weight: 700;
+}
+[data-presentation-caption] {
+  flex: 1 1 100%;
+  max-width: 70ch;
+  margin: 0;
+  min-height: 3em;
+  color: var(--ink);
+  line-height: 1.5;
+}
+[data-presentation-controls] {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+[data-presentation-prev],
+[data-presentation-next] {
+  display: grid;
+  place-items: center;
+  width: 36px;
+  height: 36px;
+  padding: 0;
+}
+[data-presentation-progress] {
+  display: flex;
+  gap: 8px;
+}
+[data-presentation-dot] {
+  width: 12px;
+  height: 12px;
+  padding: 0;
+  border-radius: 50%;
+}
+[data-presentation-dot][data-presentation-active='true'] {
+  background: var(--accent);
+  border-color: var(--accent);
+  transform: scale(1.35);
+}
+[data-presentation-attribution] {
+  margin-left: auto;
+  padding: 4px 10px;
+  color: var(--ink);
+  font-size: 0.85rem;
+  text-decoration: none;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+}
+[data-presentation-attribution]:hover {
+  border-color: var(--accent);
+  color: var(--accent);
+}
+
+/* Table of contents */
+[data-presentation-toc] {
+  flex: 0 0 180px;
+  padding: 16px 12px 16px 24px;
+}
+[data-presentation-toc] ol {
+  display: grid;
+  gap: 8px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+[data-presentation-toc-entry] {
+  width: 100%;
+  padding: 8px 12px;
+  text-align: left;
+  color: var(--muted);
+}
+[data-presentation-toc-entry][data-presentation-active='true'] {
+  color: var(--paper);
+  background: var(--accent);
+  border-color: var(--accent);
+  font-weight: 650;
+}
+
+/* Scene entities (design-canvas units) */
+[data-presentation-canvas] {
+  font-size: 18px;
+  color: var(--ink);
+}
+[data-presentation-entity] {
+  box-sizing: border-box;
+}
+[data-presentation-kind='box'],
+[data-presentation-kind='chip'] {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  background: var(--panel);
+  border: 1.5px solid var(--line);
+  border-radius: 10px;
+}
+[data-presentation-kind='chip'] {
+  border-radius: 999px;
+  border-color: var(--accent);
+  color: var(--accent);
+}
+[data-presentation-glyph] {
+  width: 18px;
+  height: 18px;
+  flex: none;
+}
+[data-presentation-kind='label'] {
+  color: var(--muted);
