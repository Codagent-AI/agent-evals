+      apply: (dir) =>
+        edit(path.join(dir, SAMPLE, 'steps/SampleScene.tsx'), (t) =>
+          t.replace('const s = payload.step\n', "const s = payload.step\n  if (s === 5) throw new Error('render failure at step 6')\n"),
+        ),
+    },
+    {
