+  white-space: nowrap;
+}
+[data-presentation-entity^='how-to/card-'][data-presentation-kind='label'] {
+  font-size: 15px;
+}
+[data-presentation-kind='arrow'] {
+  color: var(--muted);
+}
+[data-presentation-kind='arrow'] path {
+  stroke-width: 1.75;
+}
+[data-presentation-kind='frame'] {
+  border: 2px dashed var(--accent);
+  border-radius: 20px;
+}
+[data-presentation-kind='emphasis'] {
+  border: 2px solid var(--accent);
+  border-radius: 14px;
+  color: var(--accent);
+}
+[data-presentation-kind='emphasis'] svg {
+  position: absolute;
+  top: -10px;
+  right: -10px;
+  width: 20px;
+  height: 20px;
+  padding: 2px;
+  background: var(--paper);
+  border-radius: 50%;
+}
+[data-presentation-entity='how-to/ghost-card'] {
+  border-style: dashed;
+  color: var(--muted);
+  font-size: 28px;
+}
+[data-presentation-entity='how-to/verify-pass'] {
+  color: var(--ok);
+  border-color: var(--ok);
+}
+[data-presentation-entity='how-to/depth-control'] {
+  font-size: 14px;
+  border-color: var(--accent);
+}
+[data-presentation-entity='how-to/scene-kit'] {
+  border-style: dashed;
+}
