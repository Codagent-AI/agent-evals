+.presentation-attribution { position: absolute; right: 2rem; bottom: .75rem; color: inherit; font: 600 .7rem/1.2 system-ui, sans-serif; }
+.scene-layer { color: inherit; }
+.subject { position: absolute; inset: 125px auto auto 300px; padding: 1.5rem; border: 1px solid currentColor; }
