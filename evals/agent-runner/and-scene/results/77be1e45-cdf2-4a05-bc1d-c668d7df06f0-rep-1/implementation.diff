+.howto-kit { width: 190px; height: 64px; display: grid; gap: 2px; padding: 8px 12px; border: 1px solid #84b4a6; border-radius: 10px; background: #e7f4ee; }
+.howto-kit span, .howto-verify span { font-size: 10px; color: #52776b; }
+.howto-verify { width: 120px; height: 78px; display: grid; gap: 4px; padding: 9px; border: 1px solid #8ebc83; border-radius: 12px; background: #eff8e9; }
+.howto-verify span { color: #318144; font-weight: 700; }
+.howto-edited { border-color: #de9d51; background: #fff7e9; }
+.howto-edited-flag { position: absolute; top: -10px; right: -8px; padding: 3px 6px; color: white; background: #bb6d35; border-radius: 8px; font-size: 8px; }
+.howto-modify-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
+.howto-modify-path { fill: none; stroke: #cb8b58; stroke-width: 2; stroke-dasharray: 5 5; }
+.howto-modify { position: absolute; color: #a56334; font-size: 11px; }
+.howto-reveal { position: absolute; border: 2px solid #d38e51; border-radius: 24px; pointer-events: none; }
+.howto-reveal-label { position: absolute; padding: 4px 10px; background: #fffaf1; color: #a56334; font-size: 11px; }
