+
+    fireEvent.keyDown(window, { key: 'p', ctrlKey: true })
+
+    expect(screen.getByTestId('presentation-root')).toHaveAttribute('data-presentation-mode', 'browse')
+  })
+
+  it('does not navigate while focus is in any enabled editable element', () => {
