+
+    const stage = document.querySelector('[data-presentation-stage="true"]')!
+    fireEvent.touchStart(stage, { touches: [{ clientX: 200 }] })
+    fireEvent.touchEnd(stage, { changedTouches: [{ clientX: 80 }] })
