diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/Toc.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/Toc.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d0b4ccd7aa1de768f4786cf6d6d0b364ecb987ad
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/Toc.tsx
@@ -0,0 +1,34 @@
+import type { Step } from '../types'
+
+interface TocProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  activeIndex: number
+  goTo: (index: number) => void
+}
+
+export function Toc<TPayload>({ steps, activeIndex, goTo }: TocProps<TPayload>) {
+  const eras = steps.reduce<Array<{ era: string; index: number }>>((items, step, index) => {
+    if (!items.some((item) => item.era === step.era)) items.push({ era: step.era, index })
+    return items
+  }, [])
+  const activeEra = steps[activeIndex]?.era
+
+  return (
+    <nav aria-label="Presentation sections" data-presentation-toc="true">
+      {eras.map(({ era, index }) => {
+        const active = era === activeEra
+        return (
+          <button
+            type="button"
+            key={era}
+            onClick={() => goTo(index)}
+            aria-current={active ? 'step' : undefined}
+            data-presentation-toc-active={active ? 'true' : 'false'}
+          >
+            {era}
+          </button>
+        )
+      })}
+    </nav>
+  )
+}
