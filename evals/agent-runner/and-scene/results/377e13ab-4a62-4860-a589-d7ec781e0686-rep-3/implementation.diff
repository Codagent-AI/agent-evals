diff --git a/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..48e93a7fd09354e534fc169942ef31cb31a466d8
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
@@ -0,0 +1,88 @@
+#!/usr/bin/env node
+// Project-local screenshot helper. Captures one settled screenshot per step from a production
+// preview and prints advisory visual warnings. Warnings never change the exit code; only a
+// crash or setup error exits non-zero.
+import { spawnSync } from 'node:child_process'
+import { mkdirSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { chromium } from 'playwright'
+import { stepWarnings } from './lib/diagnostics.mjs'
+import { collectPageDiagnostics } from './lib/collect.mjs'
+import { inspectionDirectory, stepFileName } from './lib/paths.mjs'
+import { startPreview } from './lib/preview.mjs'
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..')
+export const VIEWPORTS = {
+  desktop: { width: 1440, height: 900 },
+  narrow: { width: 390, height: 844 },
+}
+/** Longest layout morph plus entry delay and entry duration (seconds in constants.ts), with margin. */
+export const DEFAULT_SETTLE_MS = 1800
+
+export function parseArguments(argv) {
+  const options = { slug: undefined, viewport: 'desktop', settleMs: DEFAULT_SETTLE_MS }
+  for (let i = 0; i < argv.length; i += 1) {
+    const arg = argv[i]
+    if (arg === '--narrow') options.viewport = 'narrow'
+    else if (arg === '--settle') options.settleMs = Number(argv[++i])
+    else if (!arg.startsWith('--')) options.slug = arg
+    else throw new Error(`unknown option ${arg}`)
+  }
+  if (!options.slug) throw new Error('usage: npm run inspect -- <slug> [--narrow] [--settle <ms>]')
+  // The slug names a directory and a URL path, so it must stay a plain route segment.
+  if (!/^[a-z0-9][a-z0-9-]*$/.test(options.slug)) throw new Error(`invalid slug: ${options.slug}`)
+  if (!Number.isFinite(options.settleMs) || options.settleMs < 0) throw new Error('--settle must be a non-negative number')
+  return options
+}
+
+/** Builds first so the screenshots always come from the current source. */
+function buildOrThrow(root) {
+  const result = spawnSync('npm', ['run', 'build'], { cwd: root, encoding: 'utf8' })
+  if (result.status !== 0) throw new Error(`npm run build failed before inspection:\n${result.stdout}${result.stderr}`)
+}
+
+export async function inspect(argv, { root = ROOT, log = console.log } = {}) {
+  const options = parseArguments(argv)
+  const outDir = inspectionDirectory(root, options.slug, options.viewport)
+  buildOrThrow(root)
+  mkdirSync(outDir, { recursive: true })
+  const preview = await startPreview(root)
+  let browser
+  const warnings = []
+  try {
+    browser = await chromium.launch({ headless: true })
+    const page = await browser.newPage({ viewport: VIEWPORTS[options.viewport] })
+    await page.goto(`${preview.url}/${options.slug}`)
+    await page.waitForSelector('[data-step-count]', { timeout: 15_000 })
+    const count = Number(await page.getAttribute('[data-presentation-root]', 'data-step-count'))
+    log(`inspecting ${options.slug}: ${count} steps at ${options.viewport} viewport -> ${outDir}`)
+    for (let index = 0; index < count; index += 1) {
+      if (index > 0) await page.keyboard.press('ArrowRight')
+      await page.waitForFunction(
+        (expected) => document.querySelector('[data-presentation-root]')?.getAttribute('data-step-index') === String(expected),
+        index,
+        { timeout: 5000 },
+      )
+      await page.waitForTimeout(options.settleMs)
+      const diagnostics = await page.evaluate(collectPageDiagnostics)
+      await page.screenshot({ path: join(outDir, stepFileName(index)), fullPage: false })
+      // Timestamped so a check can confirm each capture waited for the settle interval.
+      log(`captured ${stepFileName(index)} at ${Date.now()} ms`)
+      warnings.push(...stepWarnings(index + 1, diagnostics))
+    }
+  } finally {
+    if (browser) await browser.close()
+    await preview.stop()
+  }
+  for (const warning of warnings) log(`WARNING ${warning.message}`)
+  log(`inspection complete: ${warnings.length} advisory warning(s)`)
+  return { warnings, outDir }
+}
+
+if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
+  inspect(process.argv.slice(2)).catch((error) => {
+    console.error(`INSPECTION ERROR: ${error.message}`)
+    process.exitCode = 2
+  })
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/collect.mjs b/skills/presentation/templates/bootstrap/scripts/lib/collect.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..562aba3b487b1674f68c6dbbcc3f39810fba233b
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/collect.mjs
@@ -0,0 +1,66 @@
+/**
+ * Runs inside the page through `page.evaluate`, so it must stay self-contained:
+ * it cannot reference imports or module-level names. It gathers the geometry and
+ * computed styles that the pure rules in diagnostics.mjs judge.
+ */
+export function collectPageDiagnostics() {
+  const root = document.querySelector('[data-presentation-root]')
+  if (!root) return null
+
+  const styleSnapshot = (el) => {
+    const cs = getComputedStyle(el)
+    return {
+      color: cs.color,
+      backgroundColor: cs.backgroundColor,
+      borderColor: cs.borderTopColor,
+      borderWidth: cs.borderTopWidth,
+      fontWeight: cs.fontWeight,
+      transform: cs.transform,
+      textDecorationLine: cs.textDecorationLine,
+      boxShadow: cs.boxShadow,
+    }
+  }
+  const isVisible = (el) => {
+    const rect = el.getBoundingClientRect()
+    const cs = getComputedStyle(el)
+    return rect.width > 0 && rect.height > 0 && cs.visibility !== 'hidden' && cs.display !== 'none'
+  }
+  const ownText = (el) =>
+    Array.from(el.childNodes).some((node) => node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '')
+
+  // Chrome controls count even without text (an empty progress dot is still a target).
+  const chrome = '[data-presentation-progress], [data-presentation-control], [data-presentation-toc-entry], [data-presentation-attribution], [data-presentation-marker]'
+  const elements = Array.from(root.querySelectorAll('*')).filter(
+    (el) => (ownText(el) || el.matches(chrome)) && isVisible(el) && el.closest('[data-presentation-allow-overlap]') === null,
+  )
+  const items = elements.map((el, idx) => {
+    const rect = el.getBoundingClientRect()
+    const text = (el.textContent.trim() || el.getAttribute('aria-label') || '').replace(/\s+/g, ' ').slice(0, 24)
+    return {
+      idx,
+      label: el.getAttribute('data-presentation-entity') || `${el.tagName.toLowerCase()} "${text}"`,
+      rect: { x: rect.x, y: rect.y, width: rect.width, height: rect.height },
+      ancestors: [],
+    }
+  })
+  items.forEach((item, i) => {
+    items.forEach((other, j) => {
+      if (i !== j && elements[j].contains(elements[i])) item.ancestors.push(other.idx)
+    })
+  })
+
+  const activeDot = root.querySelector('[data-presentation-progress][data-presentation-active="true"]')
+  const inactiveDot = root.querySelector('[data-presentation-progress]:not([data-presentation-active])')
+  const activeEntry = root.querySelector('[data-presentation-toc-entry][data-presentation-active="true"]')
+  const inactiveEntry = root.querySelector('[data-presentation-toc-entry]:not([data-presentation-active])')
+  const attribution = root.querySelector('[data-presentation-attribution]')
+
+  return {
+    items,
+    progress: activeDot && inactiveDot ? { active: styleSnapshot(activeDot), inactive: styleSnapshot(inactiveDot) } : null,
+    toc: activeEntry && inactiveEntry ? { active: styleSnapshot(activeEntry), inactive: styleSnapshot(inactiveEntry) } : null,
+    attribution: attribution
+      ? { present: true, fontSizePx: parseFloat(getComputedStyle(attribution).fontSize), color: getComputedStyle(attribution).color }
+      : { present: false, fontSizePx: 0, color: '' },
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/diagnostics.mjs b/skills/presentation/templates/bootstrap/scripts/lib/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..84cd2f3500bc66e41f58b544744e89d316108afb
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/diagnostics.mjs
@@ -0,0 +1,88 @@
+/**
+ * Pure visual-diagnostic rules used by the inspection helper. Browser-side data
+ * is gathered separately; these functions decide what is worth a warning.
+ */
+
+export function rectsIntersect(a, b) {
+  const width = Math.min(a.x + a.width, b.x + b.width) - Math.max(a.x, b.x)
+  const height = Math.min(a.y + a.height, b.y + b.height) - Math.max(a.y, b.y)
+  return width > 1 && height > 1
+}
+
+/**
+ * Reports overlaps between visible text or chrome items. Items are
+ * `{ idx, label, rect, ancestors }`, where `ancestors` lists the idx of every
+ * other item that contains this one. Containers and children are not collisions.
+ */
+export function overlapWarnings(step, items) {
+  const warnings = []
+  for (let i = 0; i < items.length; i += 1) {
+    for (let j = i + 1; j < items.length; j += 1) {
+      const a = items[i]
+      const b = items[j]
+      if (a.ancestors.includes(b.idx) || b.ancestors.includes(a.idx)) continue
+      if (!rectsIntersect(a.rect, b.rect)) continue
+      warnings.push({
+        step,
+        kind: 'overlap',
+        message: `step ${step}: "${a.label}" overlaps "${b.label}"`,
+        elements: [a.label, b.label],
+      })
+    }
+  }
+  return warnings
+}
+
+/** True when the active item looks the same as an inactive one. */
+export function indistinctActive(activeStyle, inactiveStyle) {
+  const keys = ['color', 'backgroundColor', 'borderColor', 'borderWidth', 'fontWeight', 'transform', 'textDecorationLine', 'boxShadow']
+  return keys.every((key) => activeStyle[key] === inactiveStyle[key])
+}
+
+export const DEFAULT_LINK_COLOR = 'rgb(0, 0, 238)'
+export const MIN_ATTRIBUTION_FONT_PX = 12
+
+/** Returns an advisory message for a missing, undersized, or browser-default attribution link. */
+export function attributionWarning(step, info) {
+  if (!info.present) {
+    return {
+      step,
+      kind: 'attribution',
+      message: `step ${step}: attribution link [data-presentation-attribution] is missing; style it through its hook`,
+      elements: ['data-presentation-attribution'],
+    }
+  }
+  if (info.color === DEFAULT_LINK_COLOR || info.fontSizePx < MIN_ATTRIBUTION_FONT_PX) {
+    return {
+      step,
+      kind: 'attribution',
+      message: `step ${step}: attribution link is too small or browser-default; style [data-presentation-attribution]`,
+      elements: ['data-presentation-attribution'],
+    }
+  }
+  return null
+}
+
+export function chromeWarning(step, label) {
+  return {
+    step,
+    kind: 'chrome',
+    message: `step ${step}: active ${label} is visually indistinct from inactive ones; style [data-presentation-active="true"]`,
+    elements: [label],
+  }
+}
+
+/** All advisory warnings for one settled step, from the page's collected diagnostics. */
+export function stepWarnings(step, diagnostics) {
+  if (!diagnostics) return []
+  const warnings = overlapWarnings(step, diagnostics.items)
+  if (diagnostics.progress && indistinctActive(diagnostics.progress.active, diagnostics.progress.inactive)) {
+    warnings.push(chromeWarning(step, 'progress indicator'))
+  }
+  if (diagnostics.toc && indistinctActive(diagnostics.toc.active, diagnostics.toc.inactive)) {
+    warnings.push(chromeWarning(step, 'table-of-contents entry'))
+  }
+  const attribution = attributionWarning(step, diagnostics.attribution)
+  if (attribution) warnings.push(attribution)
+  return warnings
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/outline.mjs b/skills/presentation/templates/bootstrap/scripts/lib/outline.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..38b6c9fd9f91c4ba8affe1d564dda8439940f6e2
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/outline.mjs
@@ -0,0 +1,46 @@
+/**
+ * Pure outline assertions. The verifier compares what the browser observed for each
+ * step with the reference outline. Both sides are plain data, so this module is unit-testable.
+ */
+
+/** Returns a list of problems. An empty list means the observed steps match the outline exactly. */
+export function checkOutline(observed, expected) {
+  const problems = []
+  if (observed.length !== expected.length) {
+    problems.push({ step: null, message: `expected ${expected.length} steps, observed ${observed.length}` })
+  }
+  const shared = Math.min(observed.length, expected.length)
+  for (let index = 0; index < shared; index += 1) {
+    const want = expected[index]
+    const got = observed[index]
+    for (const field of ['era', 'title', 'caption']) {
+      if (got[field] !== want[field]) {
+        problems.push({
+          step: index,
+          message: `step ${index + 1} ${field} is ${JSON.stringify(got[field])}, expected ${JSON.stringify(want[field])}`,
+        })
+      }
+    }
+  }
+  return problems
+}
+
+/** Validates the shape of a reference outline before it is used. */
+export function validateReference(reference) {
+  const problems = []
+  if (!reference || typeof reference.slug !== 'string' || reference.slug === '') {
+    problems.push('reference slug must be a non-empty string')
+  }
+  if (!Array.isArray(reference?.steps) || reference.steps.length === 0) {
+    problems.push('reference must list at least one step')
+    return problems
+  }
+  reference.steps.forEach((step, index) => {
+    for (const field of ['era', 'title', 'caption']) {
+      if (typeof step?.[field] !== 'string' || step[field] === '') {
+        problems.push(`reference step ${index + 1} is missing ${field}`)
+      }
+    }
+  })
+  return problems
+}
