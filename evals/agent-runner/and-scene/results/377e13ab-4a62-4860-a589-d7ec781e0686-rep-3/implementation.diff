index 0000000000000000000000000000000000000000..d5784ef00313d9f79cc0f94ff8c9d51b5062e4b9
--- /dev/null
+++ b/src/presentation-kit/useWideViewport.ts
@@ -0,0 +1,13 @@
+import { useEffect, useState } from 'react'
+import { WIDE_VIEWPORT_MIN } from './constants'
+
+/** True at or above the wide-viewport breakpoint. Follows window resizes. */
+export function useWideViewport(): boolean {
+  const [wide, setWide] = useState(() => window.innerWidth >= WIDE_VIEWPORT_MIN)
+  useEffect(() => {
+    const update = () => setWide(window.innerWidth >= WIDE_VIEWPORT_MIN)
+    window.addEventListener('resize', update)
+    return () => window.removeEventListener('resize', update)
+  }, [])
+  return wide
+}
diff --git a/src/presentations/how-to-make-a-presentation/SampleScene.tsx b/src/presentations/how-to-make-a-presentation/SampleScene.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a02e47b6adb6999b58fad714b6651cd235388a3d
--- /dev/null
+++ b/src/presentations/how-to-make-a-presentation/SampleScene.tsx
@@ -0,0 +1,165 @@
+import { CircleCheck, CircleHelp, Image as ImageIcon, Bot, User } from 'lucide-react'
+import { useState, type ReactElement } from 'react'
+import { Arrow, Box, Frame, Label, SceneLayer, SymbolChip, type SceneProps } from '../../presentation-kit'
+import { ARROWS, FRAME_STACK_ORDER, layoutIdFor, rectStyle, type ArrowId, type EntityId } from './entities'
+import type { SampleEntity, SampleState } from './payload'
+
+/** Entry is a prop on the node, so one element with one key carries the entity across steps. */
+function entryAttributes(id: EntityId, entering: boolean) {
+  return { entering, 'data-presentation-entity': id, 'data-presentation-entering': entering ? id : undefined }
+}
+
+/** Positions a child inside a parent box, in the parent's own coordinates. */
+const inside = (left: number, top: number, width: number, height: number) => ({ left, top, width, height })
+
+function card(id: 'card1' | 'card2' | 'card3', entity: SampleEntity, entering: boolean): ReactElement {
+  return (
+    <Box
+      key={id}
+      layoutId={layoutIdFor(id)}
+      {...entryAttributes(id, entering)}
+      data-presentation-state={entity.state}
+      style={rectStyle(id)}
+    >
+      <Label style={inside(8, 8, 94, 20)} data-presentation-part="title">Title</Label>
+      <Label style={inside(8, 34, 94, 50)} data-presentation-part="caption">Caption</Label>
+      <SymbolChip style={inside(8, 92, 94, 20)} symbol="visual" Icon={ImageIcon} data-presentation-part="visual">
+        Visual
+      </SymbolChip>
+    </Box>
+  )
+}
+
+function renderEntity(entity: SampleEntity, entering: boolean): ReactElement {
+  const { id } = entity
+  const shared = { layoutId: layoutIdFor(id), ...entryAttributes(id, entering) }
+  switch (id) {
+    case 'you':
+      return <Box key={id} {...shared} Icon={User} style={rectStyle('you')}>you</Box>
+    case 'skill':
+      return <Box key={id} {...shared} Icon={Bot} style={rectStyle('skill')}>skill</Box>
+    case 'prompt':
+      return <Label key={id} {...shared} style={rectStyle('prompt')}>Make a talk about my topic</Label>
+    case 'question':
+      return (
+        <SymbolChip key={id} {...shared} symbol="question" Icon={CircleHelp} style={rectStyle('question')}>
+          Which topic?
+        </SymbolChip>
+      )
+    case 'card1':
+    case 'card2':
+    case 'card3':
+      return card(id, entity, entering)
+    case 'ghost':
+      return (
+        <Box key={id} {...shared} style={rectStyle('ghost')} data-presentation-state="unspecified">
+          Unspecified step
+        </Box>
+      )
+    case 'partial':
+      return (
+        <Box key={id} {...shared} style={rectStyle('partial')}>
+          partial ↔ full
+        </Box>
+      )
+    case 'socket':
+      return (
+        <Box key={id} {...shared} style={rectStyle('socket')} data-presentation-socket="">
+          Shared scene kit
+        </Box>
+      )
+    case 'verify':
+      return (
+        <Box key={id} {...shared} style={rectStyle('verify')} data-presentation-state={entity.state}>
+          <Label style={inside(8, 8, 94, 20)}>verify</Label>
+          {entity.state === 'pass' ? (
+            <SymbolChip style={inside(8, 40, 94, 24)} symbol="pass" Icon={CircleCheck} data-presentation-state="pass">
+              build + render
+            </SymbolChip>
+          ) : null}
+        </Box>
+      )
+    case 'flag':
+      return (
+        <Label key={id} {...shared} style={rectStyle('flag')} data-presentation-flag="">
+          edited
+        </Label>
+      )
+    case 'tray':
+      return <Box key={id} {...shared} style={rectStyle('tray')} data-presentation-tray="" />
+    case 'morphLabel':
+      return (
+        <Label key={id} {...shared} style={rectStyle('morphLabel')}>
+          what morphs
+        </Label>
+      )
+    case 'modifyLabel':
+      return (
+        <Label key={id} {...shared} style={rectStyle('modifyLabel')}>
+          modify
+        </Label>
+      )
+    case 'route':
+      return (
+        <Box key={id} {...shared} style={rectStyle('route')}>
+          /how-to-make-a-presentation
+        </Box>
+      )
+    case 'frame':
+      return (
+        <Frame
+          key={id}
+          {...shared}
+          style={{ ...rectStyle('frame'), zIndex: FRAME_STACK_ORDER, overflow: 'visible' }}
+          data-presentation-allow-overlap=""
+        >
+          <Label style={inside(552, 2, 300, 20)}>made exactly this way</Label>
+        </Frame>
+      )
+    default:
+      return renderArrow(id, entering)
+  }
+}
+
+function renderArrow(id: ArrowId, entering: boolean): ReactElement {
+  const { from, to, bidirectional } = ARROWS[id]
+  return (
+    <Arrow
+      key={id}
+      layoutId={layoutIdFor(id)}
+      {...entryAttributes(id, entering)}
+      from={from}
+      to={to}
+      bidirectional={bidirectional}
+    />
+  )
+}
+
+interface Shown {
+  ids: readonly EntityId[]
+  entering: ReadonlySet<EntityId>
+}
+
+function sameIds(a: readonly EntityId[], b: readonly EntityId[]): boolean {
+  return a.length === b.length && a.every((id, index) => id === b[index])
+}
+
+/**
+ * The one scene every sample step shares; only its payload changes between steps. An entity
+ * enters when it was not on screen in the previous step, whichever direction the viewer moved.
+ */
+export function SampleScene({ payload }: SceneProps<SampleState>) {
+  const ids = payload.entities.map((entity) => entity.id)
+  const [shown, setShown] = useState<Shown>({ ids: [], entering: new Set() })
+  let entering = shown.entering
+  if (!sameIds(ids, shown.ids)) {
+    const previous = new Set(shown.ids)
+    entering = new Set(ids.filter((id) => !previous.has(id)))
+    setShown({ ids, entering })
+  }
+  return (
+    <SceneLayer name="diagram">
+      {payload.entities.map((entity) => renderEntity(entity, entering.has(entity.id)))}
+    </SceneLayer>
+  )
+}
