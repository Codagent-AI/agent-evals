@@ -0,0 +1,37 @@
+import { describe, expect, it } from 'vitest'
+import { DEFAULT_SETTLE_MS, VIEWPORTS, parseArguments } from '../../scripts/inspect-presentation.mjs'
+import { inspectionDirectory, stepFileName } from '../../scripts/lib/paths.mjs'
+import { ENTER_DELAY, ENTER_T, LAYOUT_T } from '../../src/presentation-kit/constants.ts'
+
+describe('inspection options', () => {
+  it('defaults to the desktop viewport and a settle interval longer than any entry', () => {
+    const options = parseArguments(['sample'])
+    expect(options).toEqual({ slug: 'sample', viewport: 'desktop', settleMs: DEFAULT_SETTLE_MS })
+    // The constants are in seconds; the settle interval is in milliseconds.
+    expect(DEFAULT_SETTLE_MS).toBeGreaterThanOrEqual((LAYOUT_T + ENTER_DELAY + ENTER_T) * 1000)
+    expect(VIEWPORTS.desktop).toEqual({ width: 1440, height: 900 })
+  })
+
+  it('accepts the narrow viewport and a custom settle interval', () => {
+    expect(parseArguments(['sample', '--narrow', '--settle', '250'])).toEqual({ slug: 'sample', viewport: 'narrow', settleMs: 250 })
+    expect(VIEWPORTS.narrow).toEqual({ width: 390, height: 844 })
+  })
+
+  it('rejects a missing slug, an unknown option, and a bad settle value', () => {
+    expect(() => parseArguments([])).toThrow(/usage/)
+    expect(() => parseArguments(['sample', '--wide'])).toThrow(/unknown option/)
+    expect(() => parseArguments(['../../x'])).toThrow(/invalid slug/)
+    expect(() => parseArguments(['Sample'])).toThrow(/invalid slug/)
+    expect(parseArguments(['how-to-make-a-presentation']).slug).toBe('how-to-make-a-presentation')
+    expect(() => parseArguments(['sample', '--settle', '-5'])).toThrow(/non-negative/)
+  })
+})
+
+describe('artifact paths', () => {
+  it('writes one zero-padded file per step under a predictable project-local directory', () => {
+    expect(inspectionDirectory('/repo', 'deck', 'desktop')).toBe('/repo/inspection/deck')
+    expect(inspectionDirectory('/repo', 'deck', 'narrow')).toBe('/repo/inspection/deck-narrow')
+    expect(stepFileName(0)).toBe('step-01.png')
+    expect(stepFileName(11)).toBe('step-12.png')
+  })
+})
diff --git a/tests/unit/outline.test.mjs b/tests/unit/outline.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..934c881aee5fe3a7f1334237a93cc84296b831c8
--- /dev/null
+++ b/tests/unit/outline.test.mjs
@@ -0,0 +1,60 @@
+import { describe, expect, it } from 'vitest'
+import { checkOutline, validateReference } from '../../scripts/lib/outline.mjs'
+import { REFERENCE } from '../../scripts/reference.mjs'
+
+const observedFrom = (steps) => steps.map((step, index) => ({ index, ...step }))
+
+describe('checkOutline', () => {
+  const expected = REFERENCE.steps
+
+  it('reports no problems when every observed step matches the outline in order', () => {
+    expect(checkOutline(observedFrom(expected), expected)).toEqual([])
+  })
+
+  it('names the first altered title by step', () => {
+    const altered = expected.map((step, index) => (index === 4 ? { ...step, title: 'Wrong' } : step))
+    const problems = checkOutline(observedFrom(altered), expected)
+    expect(problems).toHaveLength(1)
+    expect(problems[0].step).toBe(4)
+    expect(problems[0].message).toContain('step 5 title')
+  })
+
+  it('flags an altered caption', () => {
+    const altered = expected.map((step, index) => (index === 0 ? { ...step, caption: 'Different.' } : step))
+    expect(checkOutline(observedFrom(altered), expected)[0].message).toContain('step 1 caption')
+  })
+
+  it('flags a changed era', () => {
+    const altered = expected.map((step, index) => (index === 8 ? { ...step, era: 'the start' } : step))
+    expect(checkOutline(observedFrom(altered), expected)[0].step).toBe(8)
+  })
+
+  it('flags reordered rows', () => {
+    const reordered = [expected[1], expected[0], ...expected.slice(2)]
+    const problems = checkOutline(observedFrom(reordered), expected)
+    expect([...new Set(problems.map((problem) => problem.step))]).toEqual([0, 1])
+  })
+
+  it('flags a missing or extra step by count', () => {
+    expect(checkOutline(observedFrom(expected.slice(1)), expected)[0].message).toContain('expected 9 steps, observed 8')
+    expect(checkOutline(observedFrom([...expected, expected[0]]), expected)[0].message).toContain('observed 10')
+  })
+
+  it('treats null observed text as a mismatch', () => {
+    const observed = observedFrom(expected).map((step, index) => (index === 2 ? { ...step, caption: null } : step))
+    expect(checkOutline(observed, expected)[0].step).toBe(2)
+  })
+})
+
+describe('validateReference', () => {
+  it('accepts the committed reference outline', () => {
+    expect(validateReference(REFERENCE)).toEqual([])
+  })
+
+  it('rejects a missing slug, empty steps, and a step without a title', () => {
+    expect(validateReference({ steps: REFERENCE.steps })[0]).toMatch(/slug/)
+    expect(validateReference({ slug: 'x', steps: [] })[0]).toMatch(/at least one step/)
+    const broken = { slug: 'x', steps: [{ era: 'a', caption: 'c' }] }
+    expect(validateReference(broken)[0]).toMatch(/step 1 is missing title/)
+  })
+})
diff --git a/tests/unit/parity.test.mjs b/tests/unit/parity.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..34a88ed7fbf5d4bf3c8cca24c3412b70b8e143d9
--- /dev/null
+++ b/tests/unit/parity.test.mjs
@@ -0,0 +1,139 @@
+import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs'
+import { join, relative } from 'node:path'
+import { cwd } from 'node:process'
+import { describe, expect, it } from 'vitest'
+
+const ROOT = cwd()
+const TEMPLATE = join(ROOT, 'skills/presentation/templates/bootstrap')
+
+/** Every file under `dir` that is not a test, as a sorted list of relative paths. */
+function nonTestFiles(dir) {
+  const found = []
+  const walk = (current) => {
+    for (const entry of readdirSync(current)) {
+      const path = join(current, entry)
+      if (statSync(path).isDirectory()) {
+        if (entry !== '__tests__') walk(path)
+      } else if (!/\.test\./.test(entry)) {
+        found.push(relative(dir, path))
+      }
+    }
+  }
+  walk(dir)
+  return found.sort()
+}
+
+describe('canonical kit and bootstrap copy stay byte-aligned', () => {
+  it('has identical non-test file sets, rejecting missing or extra files', () => {
+    const canonical = nonTestFiles(join(ROOT, 'src/presentation-kit'))
+    const copy = nonTestFiles(join(TEMPLATE, 'src/presentation-kit'))
+    expect(copy).toEqual(canonical)
+    expect(canonical.length).toBeGreaterThan(15)
+  })
+
+  it('has identical bytes in every non-test kit file', () => {
+    for (const file of nonTestFiles(join(ROOT, 'src/presentation-kit'))) {
+      const canonical = readFileSync(join(ROOT, 'src/presentation-kit', file))
+      const copy = readFileSync(join(TEMPLATE, 'src/presentation-kit', file))
+      expect(copy.equals(canonical), file).toBe(true)
+    }
+  })
+})
+
+describe('verification and inspection scripts stay aligned with the bootstrap copies', () => {
+  // reference.mjs is the one documented sample-specific script: it names the reference outline.
+  const shared = ['verify.mjs', 'inspect-presentation.mjs', 'lib/outline.mjs', 'lib/preview.mjs', 'lib/diagnostics.mjs', 'lib/collect.mjs', 'lib/paths.mjs']
+
+  it.each(shared)('keeps %s byte-identical', (file) => {
+    expect(readFileSync(join(TEMPLATE, 'scripts', file)).equals(readFileSync(join(ROOT, 'scripts', file)))).toBe(true)
+  })
+
+  it('differs only in the reference outline', () => {
+    const rootReference = readFileSync(join(ROOT, 'scripts/reference.mjs'), 'utf8')
+    const copyReference = readFileSync(join(TEMPLATE, 'scripts/reference.mjs'), 'utf8')
+    expect(copyReference).not.toBe(rootReference)
+    expect(copyReference).toContain("slug: 'starter'")
+    expect(rootReference).toContain("slug: 'how-to-make-a-presentation'")
+  })
+})
+
+describe('bootstrap scaffold contract', () => {
+  const pkg = JSON.parse(readFileSync(join(TEMPLATE, 'package.json'), 'utf8'))
+  const deps = { ...pkg.dependencies, ...pkg.devDependencies }
+
+  it('has the three anchors', () => {
+    expect(existsSync(join(TEMPLATE, 'vite.config.ts'))).toBe(true)
+    expect(existsSync(join(TEMPLATE, 'src/presentation-kit/index.ts'))).toBe(true)
+    expect(existsSync(join(TEMPLATE, 'src/presentations/index.ts'))).toBe(true)
+    expect(existsSync(join(TEMPLATE, 'src/main.tsx'))).toBe(true)
+  })
+
+  it('declares the full required dependency set', () => {
+    const required = [
+      'react',
+      'react-dom',
+      'motion',
+      'lucide-react',
+      'vite',
+      '@vitejs/plugin-react',
+      'typescript',
+      '@types/react',
+      '@types/react-dom',
+      '@types/node',
+      'eslint',
+      '@eslint/js',
+      'typescript-eslint',
+      'eslint-plugin-react-hooks',
+      'eslint-plugin-react-refresh',
+      'globals',
+      'playwright',
+    ]
+    expect(required.filter((name) => !(name in deps))).toEqual([])
+  })
+
+  it('declares no styling framework', () => {
+    expect(Object.keys(deps).filter((name) => /tailwind/i.test(name))).toEqual([])
+    expect(readFileSync(join(TEMPLATE, 'vite.config.ts'), 'utf8')).not.toMatch(/tailwind/i)
+  })
+
+  it('ships a lock file that pins the declared dependencies', () => {
+    const lock = JSON.parse(readFileSync(join(TEMPLATE, 'package-lock.json'), 'utf8'))
+    for (const name of ['playwright', 'motion', 'vite']) {
+      expect(lock.packages[`node_modules/${name}`]?.version, name).toBeTypeOf('string')
+    }
+  })
+
+  it('ships no visual defaults in any bootstrap stylesheet, including the starter presentation', () => {
+    const stylesheets = []
+    const walk = (dir) => {
+      for (const entry of readdirSync(dir)) {
+        const path = join(dir, entry)
+        if (statSync(path).isDirectory()) walk(path)
+        else if (entry.endsWith('.css')) stylesheets.push(path)
+      }
+    }
+    walk(join(TEMPLATE, 'src'))
+    expect(stylesheets.map((path) => relative(TEMPLATE, path))).toEqual(['src/index.css'])
+    for (const path of stylesheets) {
+      expect(readFileSync(path, 'utf8'), relative(TEMPLATE, path)).not.toMatch(/\b(color|background|font|border|box-shadow|outline)\w*\s*:/)
+    }
+  })
+})
+
+describe('skill references resolve inside the distributed skill', () => {
+  const SKILL_DIR = join(ROOT, 'skills/presentation')
+  const skill = readFileSync(join(SKILL_DIR, 'SKILL.md'), 'utf8')
+  const referenced = [...new Set(skill.match(/templates\/[A-Za-z0-9_./-]*[A-Za-z0-9_]/g) ?? [])]
+
+  it('names at least the bootstrap and presentation templates', () => {
+    expect(referenced).toEqual(expect.arrayContaining(['templates/bootstrap', 'templates/presentation']))
+  })
+
+  it.each(referenced)('%s exists relative to the skill file', (reference) => {
+    expect(existsSync(join(SKILL_DIR, reference)), reference).toBe(true)
+  })
+
+  it('has no reference to a path outside the distributed skill', () => {
+    expect(skill).not.toMatch(/\.\.\/|src\/presentations\/how-to-make-a-presentation|scripts\/verify\.mjs/)
+  })
+})
