--- /dev/null
+++ b/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,53 @@
+import { useLayoutEffect, useState, type RefObject } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT } from './constants'
+import type { Mode } from './types'
+
+export interface Size {
+  width: number
+  height: number
+}
+
+/**
+ * Uniform scale that fits a canvas for a mode. `available.width` is the stage's width;
+ * `available.height` is the viewport height, less the mode's fixed chrome budget.
+ */
+export function fitScale(
+  available: Size,
+  mode: Mode,
+  canvasWidth: number = DESIGN_W,
+  canvasHeight: number = DESIGN_H,
+): number {
+  const { padX, padY, reservedHeight } = STAGE_LAYOUT[mode]
+  const byWidth = (available.width - 2 * padX) / canvasWidth
+  const byHeight = (available.height - reservedHeight - 2 * padY) / canvasHeight
+  return Math.max(MIN_SCALE, Math.min(byWidth, byHeight))
+}
+
+/** Tracks the fit scale of the element behind `ref`, recomputing on resize. */
+export function useFitScale(
+  ref: RefObject<HTMLElement | null>,
+  mode: Mode,
+  canvasWidth: number = DESIGN_W,
+  canvasHeight: number = DESIGN_H,
+): number {
+  const [scale, setScale] = useState(MIN_SCALE)
+
+  useLayoutEffect(() => {
+    const element = ref.current
+    if (!element) return
+    // Width comes from the stage; height comes from the viewport. The stage's height would change
+    // with caption wrapping, which would change the scale between steps.
+    const measure = () =>
+      setScale(fitScale({ width: element.clientWidth, height: window.innerHeight }, mode, canvasWidth, canvasHeight))
+    measure()
+    if (typeof ResizeObserver === 'undefined') {
+      window.addEventListener('resize', measure)
+      return () => window.removeEventListener('resize', measure)
+    }
+    const observer = new ResizeObserver(measure)
+    observer.observe(element)
+    return () => observer.disconnect()
+  }, [ref, mode, canvasWidth, canvasHeight])
+
+  return scale
+}
diff --git a/src/presentation-kit/usePresentationNav.ts b/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d677aed7011975229b02b0a161b2524dce738a37
--- /dev/null
+++ b/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,128 @@
+import { useCallback, useEffect, useState } from 'react'
+import { SWIPE_DOMINANCE, SWIPE_MIN_PX } from './constants'
+import type { Mode } from './types'
+
+const INTERACTIVE_SELECTOR = [
+  'button',
+  'a[href]',
+  'input',
+  'select',
+  'textarea',
+  'summary',
+  '[contenteditable]:not([contenteditable="false"])',
+  '[role="button"]',
+  '[role="link"]',
+  '[role="checkbox"]',
+  '[role="combobox"]',
+  '[role="gridcell"]',
+  '[role="listbox"]',
+  '[role="menu"]',
+  '[role="menuitem"]',
+  '[role="menuitemcheckbox"]',
+  '[role="menuitemradio"]',
+  '[role="option"]',
+  '[role="radio"]',
+  '[role="slider"]',
+  '[role="spinbutton"]',
+  '[role="switch"]',
+  '[role="tab"]',
+  '[role="textbox"]',
+  '[role="treeitem"]',
+].join(',')
+
+/** True when focus sits on a control, or inside one, so navigation keys belong to it. */
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE_SELECTOR) !== null
+}
+
+export type KeyAction = 'next' | 'prev' | 'toggle-mode'
+
+export function keyAction(key: string): KeyAction | null {
+  switch (key) {
+    case 'ArrowRight':
+    case ' ':
+    case 'Spacebar':
+    case 'PageDown':
+      return 'next'
+    case 'ArrowLeft':
+    case 'PageUp':
+      return 'prev'
+    case 'p':
+    case 'P':
+      return 'toggle-mode'
+    default:
+      return null
+  }
+}
+
+/** Classifies a touch gesture. Returns null for small or mostly vertical gestures. */
+export function classifySwipe(dx: number, dy: number): 'left' | 'right' | null {
+  if (Math.abs(dx) < SWIPE_MIN_PX) return null
+  if (!(Math.abs(dx) > SWIPE_DOMINANCE * Math.abs(dy))) return null
+  return dx < 0 ? 'left' : 'right'
+}
+
+export interface PresentationNav {
+  index: number
+  mode: Mode
+  last: number
+  go: (index: number) => void
+  next: () => void
+  prev: () => void
+  toggleMode: () => void
+}
+
+/** Step index, mode, keyboard, and touch navigation. Clamps at both ends. */
+export function usePresentationNav(count: number, initialMode: Mode): PresentationNav {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const last = Math.max(0, count - 1)
+
+  const go = useCallback((target: number) => setIndex(Math.min(last, Math.max(0, target))), [last])
+  const next = useCallback(() => setIndex((i) => Math.min(last, i + 1)), [last])
+  const prev = useCallback(() => setIndex((i) => Math.max(0, i - 1)), [])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'browse' ? 'present' : 'browse')), [])
+
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.ctrlKey || event.metaKey || event.altKey) return
+      if (isInteractiveTarget(event.target)) return
+      const action = keyAction(event.key)
+      if (action === null) return
+      event.preventDefault()
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else toggleMode()
+    }
+    window.addEventListener('keydown', onKeyDown)
+    return () => window.removeEventListener('keydown', onKeyDown)
+  }, [next, prev, toggleMode])
+
+  useEffect(() => {
+    // Only a single-finger gesture counts. The gesture is matched by touch identifier, so a second
+    // finger (pinch, or a scroll that lands mid-swipe) cancels it instead of turning the deck.
+    let start: { id: number; x: number; y: number } | null = null
+    const onTouchStart = (event: TouchEvent) => {
+      const touch = event.touches[0]
+      start = event.touches.length === 1 && touch ? { id: touch.identifier, x: touch.clientX, y: touch.clientY } : null
+    }
+    const onTouchEnd = (event: TouchEvent) => {
+      const origin = start
+      start = null
+      if (!origin || event.touches.length !== 0) return
+      const touch = Array.from(event.changedTouches).find((candidate) => candidate.identifier === origin.id)
+      if (!touch) return
+      const swipe = classifySwipe(touch.clientX - origin.x, touch.clientY - origin.y)
+      if (swipe === 'left') next()
+      else if (swipe === 'right') prev()
+    }
+    window.addEventListener('touchstart', onTouchStart, { passive: true })
+    window.addEventListener('touchend', onTouchEnd)
+    return () => {
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [next, prev])
+
+  return { index, mode, last, go, next, prev, toggleMode }
+}
diff --git a/src/presentation-kit/useWideViewport.ts b/src/presentation-kit/useWideViewport.ts
