+})
+
+describe('StrictMode and effects', () => {
+  it('keeps a single scene instance across grouped navigation', () => {
+    const onMount = vi.fn()
+    function Probe() {
+      useEffect(() => {
+        onMount()
+      }, [])
+      return null
+    }
+    const steps = makeSteps().map((s) => ({
+      ...s,
+      Scene: ({ payload }: { payload: { n: number } }) => (
+        <>
+          <Probe />
