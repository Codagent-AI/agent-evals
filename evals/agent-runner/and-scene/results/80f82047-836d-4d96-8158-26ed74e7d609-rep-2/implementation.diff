+    const link = document.querySelector<HTMLAnchorElement>('[data-presentation-attribution]')!
+    expect(link.textContent).toBe(ATTRIBUTION_LABEL)
+    expect(ATTRIBUTION_LABEL).toBe('made by and-scene')
