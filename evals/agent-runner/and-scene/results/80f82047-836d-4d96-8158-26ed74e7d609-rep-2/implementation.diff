@@ -0,0 +1,280 @@
+/* Presentation-owned look for "How to Use This Skill to Make a Presentation". */
+[data-presentation-root] {
+  background: #0f1420;
+  color: #e8ecf4;
+  font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
+}
+
+[data-presentation-header] {
+  padding: 0 24px;
+  font-size: 14px;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: #8fa0bd;
+}
+[data-presentation-marker] {
+  color: #ffb454;
+  font-weight: 600;
+}
+
+/* Footer chrome */
+[data-presentation-footer] {
+  padding-left: 32px;
+  padding-right: 32px;
+  gap: 8px;
+}
+[data-presentation-title] {
+  margin: 0;
+  font-size: 28px;
+  line-height: 1.2;
+}
+[data-presentation-caption] {
+  margin: 0;
+  max-width: 60ch;
+  font-size: 17px;
+  line-height: 1.45;
+  color: #b7c2d6;
+}
+[data-presentation-controls] {
+  gap: 16px;
+  margin-top: auto;
+}
+[data-presentation-footer] button {
+  font: inherit;
+  font-size: 14px;
+  color: #e8ecf4;
+  background: #1b2438;
+  border: 1px solid #33425f;
+  border-radius: 6px;
+  padding: 6px 12px;
+  cursor: pointer;
+}
+[data-presentation-footer] button:disabled {
+  opacity: 0.4;
+  cursor: default;
+}
+[data-presentation-footer] button:focus-visible,
+[data-presentation-attribution]:focus-visible {
+  outline: 2px solid #ffb454;
+  outline-offset: 2px;
+}
+
+/* Progress: the active step is a wide amber pill, the rest are small dim dots.
+   Qualified by the footer so the dots outrank the footer's generic button padding. */
+[data-presentation-progress] {
+  gap: 8px;
+  align-items: center;
+}
+[data-presentation-footer] [data-presentation-progress-item] {
+  width: 12px;
+  height: 12px;
+  padding: 0;
+  border-radius: 999px;
+  background: #33425f;
+  border: 1px solid #33425f;
+}
+[data-presentation-footer] [data-presentation-progress-item][data-presentation-active='true'] {
+  width: 28px;
+  background: #ffb454;
+  border-color: #ffb454;
+}
+
+/* Table of contents: the active era is filled and bold, the rest are outlined. */
+[data-presentation-toc] {
+  display: flex;
+  gap: 8px;
+}
+[data-presentation-footer] [data-presentation-toc-item] {
