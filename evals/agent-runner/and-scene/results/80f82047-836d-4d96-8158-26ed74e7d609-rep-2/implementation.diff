index 0000000000000000000000000000000000000000..58222d2bc69946bb8dc6511e978e16a5db95499a
--- /dev/null
+++ b/src/presentations/how-to-make-a-presentation/talk.css
@@ -0,0 +1,280 @@
+/* Presentation-owned look for "How to Use This Skill to Make a Presentation". */
+[data-presentation-root] {
+  background: #0f1420;
+  color: #e8ecf4;
+  font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
+}
+
+[data-presentation-header] {
+  padding: 0 24px;
+  font-size: 14px;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: #8fa0bd;
+}
+[data-presentation-marker] {
+  color: #ffb454;
+  font-weight: 600;
+}
+
+/* Footer chrome */
+[data-presentation-footer] {
+  padding-left: 32px;
+  padding-right: 32px;
+  gap: 8px;
+}
+[data-presentation-title] {
+  margin: 0;
+  font-size: 28px;
+  line-height: 1.2;
+}
+[data-presentation-caption] {
+  margin: 0;
+  max-width: 60ch;
+  font-size: 17px;
+  line-height: 1.45;
+  color: #b7c2d6;
+}
+[data-presentation-controls] {
+  gap: 16px;
+  margin-top: auto;
+}
+[data-presentation-footer] button {
+  font: inherit;
+  font-size: 14px;
+  color: #e8ecf4;
+  background: #1b2438;
+  border: 1px solid #33425f;
+  border-radius: 6px;
+  padding: 6px 12px;
+  cursor: pointer;
+}
+[data-presentation-footer] button:disabled {
+  opacity: 0.4;
+  cursor: default;
+}
+[data-presentation-footer] button:focus-visible,
+[data-presentation-attribution]:focus-visible {
+  outline: 2px solid #ffb454;
+  outline-offset: 2px;
+}
+
+/* Progress: the active step is a wide amber pill, the rest are small dim dots.
+   Qualified by the footer so the dots outrank the footer's generic button padding. */
+[data-presentation-progress] {
+  gap: 8px;
+  align-items: center;
+}
+[data-presentation-footer] [data-presentation-progress-item] {
+  width: 12px;
+  height: 12px;
+  padding: 0;
+  border-radius: 999px;
+  background: #33425f;
+  border: 1px solid #33425f;
+}
+[data-presentation-footer] [data-presentation-progress-item][data-presentation-active='true'] {
+  width: 28px;
+  background: #ffb454;
+  border-color: #ffb454;
+}
+
+/* Table of contents: the active era is filled and bold, the rest are outlined. */
+[data-presentation-toc] {
+  display: flex;
+  gap: 8px;
+}
+[data-presentation-footer] [data-presentation-toc-item] {
+  color: #8fa0bd;
+  background: transparent;
+}
+[data-presentation-footer] [data-presentation-toc-item][data-presentation-active='true'] {
+  color: #0f1420;
+  background: #ffb454;
+  border-color: #ffb454;
+  font-weight: 700;
+}
+
+/* Attribution: legible, intentional, bottom-right. */
+[data-presentation-attribution] {
+  margin: 0 16px 8px 0;
+  font-size: 13px;
+  color: #b7c2d6;
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+[data-presentation-attribution]:hover {
+  color: #ffb454;
+}
+
+/* Scene entities */
+[data-presentation-scene] {
+  font-size: 15px;
+}
+[data-presentation-box] {
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  background: #1b2438;
+  border: 2px solid #4d6290;
+  border-radius: 10px;
+  color: #e8ecf4;
+}
+[data-role='actor'] {
+  border-color: #6cc2ff;
+  font-size: 20px;
+  font-weight: 600;
+}
+[data-role='depth-control'] {
+  flex-direction: row;
+  border-radius: 999px;
+  font-size: 13px;
+  border-color: #ffb454;
+}
+[data-role='step-card'] {
+  font-size: 13px;
+}
+[data-role='step-card'] [data-part='title'] {
+  font-weight: 700;
+  color: #ffb454;
+}
+[data-role='step-card'] [data-part='caption'] {
+  color: #b7c2d6;
+}
+[data-role='step-card'] [data-part='visual'] {
+  color: #6cc2ff;
+}
+[data-role='ghost-card'] {
+  border-style: dashed;
+  border-color: #6b7a99;
+  background: transparent;
+  color: #8fa0bd;
+  font-size: 13px;
+}
+[data-role='scene-kit'] {
+  border-color: #7ddc9c;
+  background: #15291f;
+  font-weight: 600;
+}
+[data-role='verify'] {
+  border-color: #7ddc9c;
+  font-size: 13px;
+}
+[data-role='verify'] [data-part='verify'] {
+  font-weight: 700;
+  font-size: 16px;
+}
+[data-role='tray'] {
+  box-sizing: border-box;
+  background: #131b2c;
+  border: 1px solid #2a3650;
+  border-radius: 14px;
+}
+[data-presentation-label] {
+  color: #b7c2d6;
+  font-size: 15px;
+}
+[data-presentation-symbol-chip] {
+  box-sizing: border-box;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 100%;
+  height: 100%;
+  background: #0f1420;
+  border: 1px solid #4d6290;
+  border-radius: 999px;
+  font-size: 12px;
+  color: #b7c2d6;
+}
+[data-role='pass'] {
+  background: #7ddc9c;
+  border-color: #7ddc9c;
+  color: #0f1420;
+  font-weight: 700;
+  font-size: 15px;
+}
+[data-role='edited-flag'] {
+  background: #ffb454;
+  border-color: #ffb454;
+  color: #0f1420;
+  font-weight: 700;
+}
+[data-presentation-arrow-line] {
+  stroke: #6cc2ff;
+  stroke-width: 2;
+}
+[data-role='card-link'] [data-presentation-arrow-line],
+[data-role='card-link'] {
+  stroke: #4d6290;
+}
+[data-presentation-arrow-head] {
+  fill: #6cc2ff;
+}
+[data-role='modify-arc'] [data-presentation-arrow-line] {
+  stroke: #ffb454;
+  stroke-dasharray: 6 4;
+}
+[data-role='modify-arc'] [data-presentation-arrow-head] {
+  fill: #ffb454;
+}
+[data-presentation-emphasis] {
+  box-sizing: border-box;
+  border: 3px solid #ffb454;
+  border-radius: 14px;
+}
+[data-presentation-frame] {
+  box-sizing: border-box;
+  border: 2px dashed #7ddc9c;
+  border-radius: 18px;
+}
+[data-role='reveal-label'] {
+  display: block;
+  text-align: center;
+  color: #7ddc9c;
+  font-weight: 600;
+}
+
+@media (max-width: 959px) {
+  [data-presentation-title] {
+    font-size: 22px;
+  }
+  [data-presentation-caption] {
+    font-size: 15px;
+  }
+}
+
+/* Phones: previous, progress, next, and the mode toggle must all fit on one row. */
+@media (max-width: 480px) {
+  [data-presentation-footer] {
+    padding-left: 16px;
+    padding-right: 16px;
+  }
+  [data-presentation-controls] {
+    gap: 8px;
+  }
+  [data-presentation-footer] button {
+    font-size: 13px;
+    padding: 6px 8px;
+  }
+  [data-presentation-progress] {
+    flex: 1 1 0;
+    min-width: 0;
+    justify-content: center;
+    gap: 4px;
+  }
+  [data-presentation-footer] [data-presentation-progress-item] {
+    flex: 0 1 8px;
+    width: 8px;
+    min-width: 4px;
+    height: 8px;
+    padding: 0;
+  }
+  [data-presentation-footer] [data-presentation-progress-item][data-presentation-active='true'] {
+    flex-basis: 20px;
+    width: 20px;
+  }
+}
