+import type { StepMeta } from '../../../presentation-kit/types.ts'
+
+/** Normative step narration, kept free of JSX so verification can load it directly. */
+export const STEP_META: readonly StepMeta[] = [
+  {
+    id: 'ask',
+    era: 'the ask',
+    title: 'You have a topic',
+    caption: 'It starts with you, a topic, and mild overconfidence.',
+  },
+  {
+    id: 'interview',
