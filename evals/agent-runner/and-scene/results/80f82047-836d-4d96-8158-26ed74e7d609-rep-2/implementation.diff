@@ -0,0 +1,265 @@
+// Screenshot capture and advisory visual diagnostics for one registered
+// presentation: `npm run inspect -- <slug> [--viewport WxH] [--settle ms]`.
+// Warnings never change the exit code; operational failures (unknown slug,
+// preview not ready, build failure) exit non-zero.
+import { existsSync, mkdirSync, readFileSync } from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+import { HOST, buildApp, parseRegistrySlugs, previewUrl, withPreview } from './verify.mjs'
+
+export const DEFAULT_VIEWPORT = { width: 1440, height: 900 }
+export const DEFAULT_SETTLE_MS = 800
+export const MIN_ATTRIBUTION_PX = 11
+const DEFAULT_LINK_COLORS = new Set(['rgb(0, 0, 238)', 'rgb(85, 26, 139)', 'rgb(0, 0, 255)'])
+
+export class InspectError extends Error {}
+
+export function parseArgs(argv) {
+  const opts = { slug: undefined, viewport: { ...DEFAULT_VIEWPORT }, settleMs: DEFAULT_SETTLE_MS, build: true }
+  for (let i = 0; i < argv.length; i++) {
+    const a = argv[i]
+    if (a === '--viewport') {
+      const m = /^(\d+)x(\d+)$/.exec(argv[++i] ?? '')
+      if (!m) throw new InspectError('--viewport expects WxH, for example 1440x900')
+      opts.viewport = { width: Number(m[1]), height: Number(m[2]) }
+    } else if (a === '--settle') {
+      const ms = Number(argv[++i])
+      if (!Number.isFinite(ms) || ms < 0) throw new InspectError('--settle expects a number of milliseconds')
+      opts.settleMs = ms
+    } else if (a === '--skip-build') {
+      opts.build = false
+    } else if (a.startsWith('--')) {
+      throw new InspectError(`unknown option ${a}`)
+    } else if (!opts.slug) {
+      opts.slug = a
+    } else {
+      throw new InspectError(`unexpected argument ${a}`)
+    }
+  }
+  if (!opts.slug) throw new InspectError('usage: npm run inspect -- <slug> [--viewport WxH] [--settle ms]')
+  return opts
+}
+
+/** 1-based, zero-padded: inspection/<slug>/step-01.png */
+export function screenshotPath(root, slug, stepIndex) {
+  return path.join(root, 'inspection', slug, `step-${String(stepIndex + 1).padStart(2, '0')}.png`)
+}
+
+const intersects = (a, b) =>
+  Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x) > 1 && Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y) > 1
+
+/**
+ * Pairs of visible text/chrome elements whose painted boxes intersect.
+ * Elements are { id, label, rects, visible, allowOverlap, parts }, where rects
+ * are the boxes of the element's own text (or of the control itself when it
+ * has no text), so a parent's text is compared with a nested child's text too.
+ * `parts` lists the ids of the text a textless chrome control paints as its own
+ * label: a control and its label are one visible element, not a collision. The
+ * only other exemption is an explicit allow-overlap ancestor on either side.
+ */
+export function findOverlaps(elements) {
+  const out = []
+  const live = elements.filter((e) => e.visible && e.rects.some((r) => r.w > 0 && r.h > 0))
+  for (let i = 0; i < live.length; i++) {
+    for (let j = i + 1; j < live.length; j++) {
+      const a = live[i]
+      const b = live[j]
+      if (a.allowOverlap || b.allowOverlap) continue
+      if (a.parts?.includes(b.id) || b.parts?.includes(a.id)) continue
+      if (a.rects.some((ra) => b.rects.some((rb) => intersects(ra, rb)))) out.push([a.label, b.label])
+    }
+  }
+  return out
+}
+
+// Computed styling only: rendered width and height differ with label length even when unstyled.
+const SIGNATURE_KEYS = [
+  'color', 'backgroundColor', 'borderColor', 'borderWidth', 'opacity',
+  'fontWeight', 'textDecorationLine', 'boxShadow', 'outlineStyle',
+]
+const signature = (s) => SIGNATURE_KEYS.map((k) => s[k]).join('|')
+
+/** True when the active control's computed style matches every inactive sibling's. */
+export function isActiveIndistinct(active, inactive) {
+  return inactive.length > 0 && inactive.every((s) => signature(s) === signature(active))
+}
+
+export function isBrowserDefaultLink(style) {
+  return DEFAULT_LINK_COLORS.has(style.color) && style.textDecorationLine.includes('underline')
+}
+
+/** Reason the attribution looks unpolished, or undefined when it is fine. */
+export function attributionIssue(attribution) {
+  if (!attribution) return 'attribution link is missing'
+  if (attribution.fontSize < MIN_ATTRIBUTION_PX) {
+    return `attribution text is ${attribution.fontSize}px, below ${MIN_ATTRIBUTION_PX}px`
+  }
+  if (isBrowserDefaultLink(attribution)) return 'attribution uses the browser-default link style'
+  return undefined
+}
+
+/** Turns one step's page snapshot into advisory warning lines (without the step prefix). */
+export function diagnose(snapshot) {
+  const warnings = findOverlaps(snapshot.elements).map(
+    ([a, b]) => `overlap between ${a} and ${b}; fix the collision or mark an intentional readable overlap with data-presentation-allow-overlap`,
+  )
+  for (const [kind, hook] of [['progress', 'data-presentation-progress-item'], ['table-of-contents', 'data-presentation-toc-item']]) {
+    const group = snapshot.active[kind]
+    if (group && isActiveIndistinct(group.active, group.inactive)) {
+      warnings.push(`active ${kind} entry is indistinct from inactive entries; style [${hook}][data-presentation-active="true"]`)
+    }
+  }
+  const issue = attributionIssue(snapshot.attribution)
+  if (issue) warnings.push(`${issue}; style [data-presentation-attribution]`)
+  return warnings
+}
+
+/** Runs inside the page: collects plain data for diagnose(). */
+function collectSnapshot() {
+  const CHROME = '[data-presentation-progress-item],[data-presentation-toc-item],[data-presentation-prev],[data-presentation-next],[data-presentation-mode-toggle],[data-presentation-attribution]'
+  const root = document.querySelector('[data-presentation-root]') ?? document.body
+  const style = (el) => {
+    const s = getComputedStyle(el)
+    return {
+      color: s.color, backgroundColor: s.backgroundColor, borderColor: s.borderTopColor,
+      borderWidth: s.borderTopWidth, opacity: s.opacity, fontWeight: s.fontWeight, textDecorationLine: s.textDecorationLine,
+      boxShadow: s.boxShadow, outlineStyle: s.outlineStyle, fontSize: parseFloat(s.fontSize),
+    }
+  }
+  const label = (el) => {
+    const hook = [...el.attributes].find((a) => a.name.startsWith('data-presentation-') && a.value === '')
+    const text = (el.textContent ?? '').trim().replace(/\s+/g, ' ').slice(0, 40)
+    return `<${el.tagName.toLowerCase()}${hook ? ` ${hook.name}` : ''}>${text ? ` "${text}"` : ''}`
+  }
+  const hasOwnText = (el) => [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim())
+  const candidates = [...root.querySelectorAll('*')].filter(
+    (el) => !['SCRIPT', 'STYLE', 'SVG', 'PATH', 'LINE', 'POLYGON'].includes(el.tagName.toUpperCase()) &&
+      (hasOwnText(el) || el.matches(CHROME)),
+  )
+  const textRects = (el) => {
+    const rects = []
+    for (const n of el.childNodes) {
+      if (n.nodeType !== 3 || !n.textContent.trim()) continue
+      const range = document.createRange()
+      range.selectNodeContents(n)
+      for (const r of range.getClientRects()) rects.push({ x: r.x, y: r.y, w: r.width, h: r.height })
+    }
+    return rects
+  }
+  // Opacity does not inherit in computed style, but a transparent ancestor hides everything inside it.
+  const effectiveOpacity = (el) => {
+    let o = 1
+    for (let p = el; p; p = p.parentElement) o *= Number(getComputedStyle(p).opacity)
+    return o
+  }
+  const ids = new Map(candidates.map((el, i) => [el, i]))
+  const elements = candidates.map((el) => {
+    const s = getComputedStyle(el)
+    const box = el.getBoundingClientRect()
+    const own = hasOwnText(el)
+    return {
+      id: ids.get(el),
+      label: label(el),
+      rects: own ? textRects(el) : [{ x: box.x, y: box.y, w: box.width, h: box.height }],
+      visible: s.display !== 'none' && s.visibility !== 'hidden' && effectiveOpacity(el) > 0,
+      allowOverlap: el.closest('[data-presentation-allow-overlap]') !== null,
+      parts: own ? [] : candidates.filter((c) => c !== el && el.contains(c)).map((c) => ids.get(c)),
+    }
+  })
+  const group = (selector) => {
+    const items = [...document.querySelectorAll(selector)]
+    const active = items.find((el) => el.getAttribute('data-presentation-active') === 'true')
+    if (!active) return undefined
+    return { active: style(active), inactive: items.filter((el) => el !== active).map(style) }
+  }
+  const attr = document.querySelector('[data-presentation-attribution]')
+  return {
+    elements,
+    active: {
+      progress: group('[data-presentation-progress-item]'),
+      'table-of-contents': group('[data-presentation-toc-item]'),
+    },
+    attribution: attr ? style(attr) : null,
+  }
+}
+
+const delay = (ms) => new Promise((r) => setTimeout(r, ms))
+
+export async function inspect(root, argv, log = console.log) {
+  const opts = parseArgs(argv)
+  const registryFile = path.join(root, 'src/presentations/index.ts')
+  const slugs = existsSync(registryFile) ? parseRegistrySlugs(readFileSync(registryFile, 'utf8')) : []
+  if (!slugs.includes(opts.slug)) {
+    throw new InspectError(`unknown presentation "${opts.slug}"; registered: ${slugs.join(', ') || 'none'}`)
+  }
+  if (opts.build) await buildApp(root)
+  const { chromium } = await import('playwright')
+  let warnings = 0
+  await withPreview(
+    root,
+    async (port) => {
+      const browser = await chromium.launch()
+      try {
+        const page = await browser.newPage({ viewport: opts.viewport })
+        const url = previewUrl(port, `/${opts.slug}`)
+        const runtimeErrors = []
+        page.on('console', (m) => m.type() === 'error' && runtimeErrors.push(`console error: ${m.text()}`))
+        page.on('pageerror', (e) => runtimeErrors.push(`page error: ${e.message}`))
+        const reportRuntimeErrors = (step) => {
+          for (const e of runtimeErrors.splice(0)) {
+            warnings++
+            log(`WARN step ${step}: runtime error (${e}); this capture may be blank`)
+          }
+        }
+        await page.goto(url, { waitUntil: 'load' })
+        const chrome = page.locator('[data-step-count]')
+        try {
+          await chrome.waitFor({ timeout: 10_000 })
+        } catch {
+          throw new InspectError(`no [data-step-count] chrome at ${url}; the presentation did not render${runtimeErrors.length ? `: ${runtimeErrors[0]}` : ''}`)
+        }
+        const count = Number(await chrome.getAttribute('data-step-count'))
+        for (let i = 0; i < count; i++) {
+          const started = Date.now()
+          await delay(opts.settleMs)
+          const file = screenshotPath(root, opts.slug, i)
+          mkdirSync(path.dirname(file), { recursive: true })
+          await page.screenshot({ path: file })
+          log(`[inspect] step ${i + 1}/${count} captured ${path.relative(root, file)} (settled ${Date.now() - started}ms)`)
+          reportRuntimeErrors(i + 1)
+          for (const w of diagnose(await page.evaluate(collectSnapshot))) {
+            warnings++
+            log(`WARN step ${i + 1}: ${w}`)
+          }
+          if (i < count - 1) {
+            await page.keyboard.press('ArrowRight')
+            try {
+              await page.waitForFunction(
+                (n) => document.querySelector('[data-step-count]')?.getAttribute('data-step-index') === String(n),
+                i + 1,
+                { timeout: 3000 },
+              )
+            } catch {
+              throw new InspectError(`step ${i + 2} did not render${runtimeErrors.length ? `: ${runtimeErrors[0]}` : ''}`)
+            }
+          }
+        }
+      } finally {
+        await browser.close()
+      }
+    },
+    log,
+  )
+  log(`[inspect] done: ${warnings} advisory warning(s) at ${HOST}; screenshots are inspection artifacts, not pass/fail evidence`)
+  return { warnings }
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+  try {
+    await inspect(root, process.argv.slice(2))
+  } catch (err) {
+    console.error(`[inspect] ERROR: ${err.message}`)
+    process.exit(1)
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/verify.mjs b/skills/presentation/templates/bootstrap/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6f54cc2499d04286566428239d096141bd18cab4
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/verify.mjs
@@ -0,0 +1,338 @@
+// Deterministic verification: build the whole app, check the reference sample,
+// then render every registered presentation through all of its steps in
+// Chromium against a production preview on the IPv4 loopback address.
+import { spawn } from 'node:child_process'
+import { existsSync, readFileSync } from 'node:fs'
+import net from 'node:net'
+import path from 'node:path'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+
+export const HOST = '127.0.0.1'
+export const SETTLE_MS = 900
+export const SAMPLE_SLUG = 'how-to-make-a-presentation'
+const SAMPLE_META = 'src/presentations/how-to-make-a-presentation/steps/meta.ts'
+const REGISTRY = 'src/presentations/index.ts'
+
+/** Normative sample outline, transcribed from the presentation-verification spec. */
+export const EXPECTED_SAMPLE = [
+  { era: 'the ask', title: 'You have a topic', caption: 'It starts with you, a topic, and mild overconfidence.' },
+  { era: 'the ask', title: 'The skill interviews you', caption: 'One question at a time: the topic, the look, then each beat of the story.' },
+  { era: 'the gathering', title: 'Answers become steps', caption: 'Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next.' },
+  { era: 'the gathering', title: 'The deck grows', caption: 'Same shapes, new beats. Every answer extends the story without redrawing it.' },
+  { era: 'the gathering', title: 'You set the depth', caption: 'Spell out every step, or sketch a few and see how it looks. You hold the gate.' },
+  { era: 'the build', title: 'It assembles the scene', caption: 'Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph.' },
+  { era: 'the build', title: 'It checks its own work', caption: 'Before saying done, it builds and renders every step — and fixes what breaks.' },
+  { era: 'the loop', title: 'Changed your mind? Loop it.', caption: 'Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch.' },
+  { era: 'the reveal', title: "You're looking at one", caption: 'This presentation was built exactly this way. Thanks for watching.' },
+]
+
+/** A verification failure that names its phase and, for browser faults, the 0-based step. */
+export class VerifyError extends Error {
+  constructor(phase, message, step) {
+    super(message)
+    this.phase = phase
+    this.step = step
+  }
+}
+
+export const previewUrl = (port, route = '/') => `http://${HOST}:${port}${route}`
+
+/** The source with comments replaced by spaces, so an example entry in a comment is not a route. */
+function blankComments(src) {
+  let out = ''
+  let i = 0
+  while (i < src.length) {
+    const c = src[i]
+    const next = src[i + 1]
+    let stop = i + 1
+    if (c === '/' && next === '/') {
+      const eol = src.indexOf('\n', i)
+      stop = eol === -1 ? src.length : eol
+      out += ' '.repeat(stop - i)
+    } else if (c === '/' && next === '*') {
+      const end = src.indexOf('*/', i + 2)
+      stop = end === -1 ? src.length : end + 2
+      out += src.slice(i, stop).replace(/[^\n]/g, ' ')
+    } else if (c === '"' || c === "'" || c === '`') {
+      // Only template literals span lines; an unterminated quote ends at its line.
+      while (stop < src.length && src[stop] !== c && (c === '`' || src[stop] !== '\n')) stop += src[stop] === '\\' ? 2 : 1
+      stop = Math.min(stop + (src[stop] === c ? 1 : 0), src.length)
+      out += src.slice(i, stop)
+    } else {
+      out += c
+    }
+    i = stop
+  }
+  return out
+}
+
+export function parseRegistrySlugs(source) {
+  return [...blankComments(source).matchAll(/(?:\bslug\b|"slug"|'slug')\s*:\s*['"]([^'"]+)['"]/g)].map((m) => m[1])
+}
+
+/** Throws a `sample` VerifyError unless the registry and step data match the outline exactly. */
+export function checkSample({ slugs, steps }) {
+  if (!slugs.includes(SAMPLE_SLUG)) {
+    throw new VerifyError('sample', `reference sample "${SAMPLE_SLUG}" is not registered in ${REGISTRY}`)
+  }
+  if (!Array.isArray(steps)) throw new VerifyError('sample', 'sample step data is missing or malformed')
+  if (steps.length !== EXPECTED_SAMPLE.length) {
+    throw new VerifyError('sample', `sample has ${steps.length} steps, expected ${EXPECTED_SAMPLE.length}`)
+  }
+  EXPECTED_SAMPLE.forEach((want, i) => {
+    const got = steps[i]
+    if (!got || typeof got !== 'object') throw new VerifyError('sample', `sample step ${i} is malformed`, i)
+    for (const field of ['era', 'title', 'caption']) {
+      if (got[field] !== want[field]) {
+        throw new VerifyError(
+          'sample',
+          `sample step ${i} ${field} is ${JSON.stringify(got[field])}, expected ${JSON.stringify(want[field])}`,
+          i,
+        )
+      }
+    }
+  })
+}
+
+/** Runs phases in order; stops at the first failure and returns a structured outcome. */
+export async function runPhases(phases, log = console.log) {
+  for (const { name, run } of phases) {
+    log(`[verify] phase ${name}: start`)
+    try {
+      await run()
+    } catch (err) {
+      const phase = err instanceof VerifyError ? err.phase : name
+      const step = err instanceof VerifyError ? err.step : undefined
+      return { ok: false, phase, step, message: err instanceof Error ? err.message : String(err) }
+    }
+    log(`[verify] phase ${name}: PASS`)
+  }
+  return { ok: true }
+}
+
+export function formatOutcome(outcome) {
+  if (outcome.ok) return 'VERIFY PASSED'
+  const step = outcome.step === undefined ? '' : ` step=${outcome.step}`
+  return `VERIFY FAILED phase=${outcome.phase}${step}: ${outcome.message}`
+}
+
+function run(cmd, args, cwd) {
+  return new Promise((resolve) => {
+    const child = spawn(cmd, args, { cwd, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (d) => (output += d))
+    child.stderr.on('data', (d) => (output += d))
+    child.on('error', (e) => resolve({ code: 1, output: String(e) }))
+    child.on('close', (code) => resolve({ code, output }))
+  })
+}
+
+export async function buildApp(root) {
+  const { code, output } = await run('npm', ['run', 'build'], root)
+  if (code !== 0) {
+    throw new VerifyError('build', `npm run build failed (exit ${code})\n${output.split('\n').slice(-30).join('\n')}`)
+  }
+}
+
+export async function loadSample(root) {
+  const registryFile = path.join(root, REGISTRY)
+  const slugs = existsSync(registryFile) ? parseRegistrySlugs(readFileSync(registryFile, 'utf8')) : []
+  const metaFile = path.join(root, SAMPLE_META)
+  let steps
+  if (existsSync(metaFile)) {
+    try {
+      steps = (await import(pathToFileURL(metaFile).href)).STEP_META
+    } catch (err) {
+      throw new VerifyError('sample', `cannot load sample step data: ${err.message}`)
+    }
+  }
+  return { slugs, steps }
+}
+
+const freePort = () =>
+  new Promise((resolve, reject) => {
+    const server = net.createServer()
+    server.once('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+
+/** A child killed by a signal has exitCode null and signalCode set. */
+const hasExited = (child) => child.exitCode !== null || child.signalCode !== null
+
+const stderrOf = (child) => {
+  const text = (child.stderrText ?? '').trim()
+  return text ? `\n${text.split('\n').slice(-15).join('\n')}` : ''
+}
+
+async function waitReady(url, child, timeoutMs) {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    if (hasExited(child)) {
+      throw new VerifyError('render', `preview server exited before it was ready${stderrOf(child)}`)
+    }
+    try {
+      if ((await fetch(url)).ok) return
+    } catch {
+      /* not listening yet */
+    }
+    await new Promise((r) => setTimeout(r, 200))
+  }
+  throw new VerifyError('render', `preview server was not ready at ${url}${stderrOf(child)}`)
+}
+
+const stopProcess = (child) =>
+  new Promise((resolve) => {
+    if (hasExited(child)) return resolve()
+    const timer = setTimeout(() => child.kill('SIGKILL'), 3000)
+    child.once('exit', () => {
+      clearTimeout(timer)
+      resolve()
+    })
+    // It may have exited between the first check and the listener; do not wait for an event that already fired.
+    if (hasExited(child)) {
+      clearTimeout(timer)
+      return resolve()
+    }
+    child.kill('SIGTERM')
+  })
+
+/** Serves the production build on the IPv4 loopback and always stops the server. */
+export async function withPreview(root, fn, log = console.log, { readyTimeoutMs = 30_000 } = {}) {
+  const port = await freePort()
+  const vite = path.join(root, 'node_modules', 'vite', 'bin', 'vite.js')
+  const child = spawn(
+    process.execPath,
+    [vite, 'preview', '--host', HOST, '--port', String(port), '--strictPort'],
+    { cwd: root, stdio: ['ignore', 'ignore', 'pipe'] },
+  )
+  child.stderrText = ''
+  child.stderr.on('data', (d) => (child.stderrText += d))
+  try {
+    log(`[verify] preview ${previewUrl(port)} (pid ${child.pid})`)
+    await waitReady(previewUrl(port), child, readyTimeoutMs)
+    return await fn(port)
+  } finally {
+    await stopProcess(child)
+  }
+}
+
+const delay = (ms) => new Promise((r) => setTimeout(r, ms))
+
+/**
+ * Steps through one presentation route with ArrowRight. Listeners attach
+ * before navigation; any console error, page error, or non-advancing step
+ * fails with the 0-based index of the step being shown.
+ */
+export async function checkRoute(page, url, { expected, settleMs = SETTLE_MS, log = () => {} } = {}) {
+  let current = 0
+  const faults = []
+  page.on('console', (m) => m.type() === 'error' && faults.push({ step: current, text: `console error: ${m.text()}` }))
+  page.on('pageerror', (e) => faults.push({ step: current, text: `page error: ${e.message}` }))
+  const assertClean = () => {
+    if (faults.length) throw new VerifyError('render', faults[0].text, faults[0].step)
+  }
+
+  await page.goto(url, { waitUntil: 'load' })
+  const chrome = page.locator('[data-step-count]')
+  try {
+    await chrome.waitFor({ timeout: 10_000 })
+  } catch {
+    assertClean()
+    throw new VerifyError('render', `no [data-step-count] chrome at ${url}`, 0)
+  }
+  const count = Number(await chrome.getAttribute('data-step-count'))
+  if (!(count > 0)) throw new VerifyError('render', 'step count hook is not a positive number', 0)
+  if (expected && count !== expected.length) {
+    throw new VerifyError('render', `rendered ${count} steps, expected ${expected.length}`, 0)
+  }
+  const indexNow = async () => Number(await chrome.getAttribute('data-step-index'))
+
+  for (let i = 0; i < count; i++) {
+    current = i
+    if ((await indexNow()) !== i) throw new VerifyError('render', `step index is not ${i}`, i)
+    if (expected) {
+      const title = await page.locator('[data-presentation-title]').first().textContent()
+      const caption = await page.locator('[data-presentation-caption]').first().textContent()
+      if (title !== expected[i].title) {
+        throw new VerifyError('render', `title is ${JSON.stringify(title)}, expected ${JSON.stringify(expected[i].title)}`, i)
+      }
+      if (caption !== expected[i].caption) {
+        throw new VerifyError('render', `caption is ${JSON.stringify(caption)}, expected ${JSON.stringify(expected[i].caption)}`, i)
+      }
+    }
+    await delay(settleMs)
+    assertClean()
+    log(`[verify] step ${i} of ${count - 1} ok`)
+    if (i === count - 1) break
+    current = i + 1 // the next step renders as soon as the key is handled
+    await page.keyboard.press('ArrowRight')
+    try {
+      await page.waitForFunction(
+        ([n]) => document.querySelector('[data-step-count]')?.getAttribute('data-step-index') === String(n),
+        [i + 1],
+        { timeout: 3000 },
+      )
+    } catch {
+      assertClean()
+      throw new VerifyError('render', `ArrowRight did not advance from step ${i} to ${i + 1}`, i)
+    }
+  }
+  assertClean()
+}
+
+export async function renderAll(root, slugs, log = console.log, { launch } = {}) {
+  const launchBrowser = launch ?? (async () => (await import('playwright')).chromium.launch())
+  await withPreview(
+    root,
+    async (port) => {
+      let browser
+      try {
+        browser = await launchBrowser()
+      } catch (err) {
+        throw new VerifyError('render', `cannot launch Chromium: ${err.message}`)
+      }
+      try {
+        for (const slug of slugs) {
+          const url = previewUrl(port, `/${slug}`)
+          log(`[verify] render ${url}`)
+          const page = await browser.newPage()
+          try {
+            await checkRoute(page, url, { expected: slug === SAMPLE_SLUG ? EXPECTED_SAMPLE : undefined, log })
+          } finally {
+            await page.close()
+          }
+        }
+      } finally {
+        await browser.close()
+      }
+    },
+    log,
+  )
+}
+
+export async function verify(root, log = console.log) {
+  let sample
+  const phases = [
+    { name: 'build', run: () => buildApp(root) },
+    {
+      name: 'sample',
+      run: async () => {
+        sample = await loadSample(root)
+        checkSample(sample)
+      },
+    },
+    { name: 'render', run: () => renderAll(root, sample.slugs, log) },
+  ]
+  const outcome = await runPhases(phases, log)
+  log(`[verify] ${formatOutcome(outcome)}`)
+  return outcome
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+  const outcome = await verify(root)
+  process.exit(outcome.ok ? 0 : 1)
+}
