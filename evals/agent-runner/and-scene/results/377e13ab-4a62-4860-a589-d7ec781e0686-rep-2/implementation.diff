diff --git a/src/presentation-kit/Appear.tsx b/src/presentation-kit/Appear.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d3b2c4b9f5676fc9ad024004823beca999db8bff
--- /dev/null
+++ b/src/presentation-kit/Appear.tsx
@@ -0,0 +1,34 @@
+import { motion } from 'motion/react'
+import type { CSSProperties, ReactNode } from 'react'
+import { EASE, ENTER_DELAY, ENTER_T } from './constants'
+
+export interface AppearProps {
+  /** Identity of the wrapped entity, exposed as data-presentation-appear-id. */
+  id?: string
+  className?: string
+  style?: CSSProperties
+  /**
+   * False for continuing entities: they keep the same wrapper and skip the entry
+   * animation, so they morph instead of fading.
+   */
+  entering?: boolean
+  children: ReactNode
+}
+
+/** Wraps an entity so newcomers fade in after persisting entities have finished morphing. */
+export function Appear({ id, className, style, entering = true, children }: AppearProps) {
+  return (
+    <motion.div
+      data-presentation-appear={entering ? 'entering' : 'continuing'}
+      data-presentation-appear-id={id}
+      className={className}
+      style={{ position: 'absolute', inset: 0, pointerEvents: 'none', ...style }}
+      initial={entering ? { opacity: 0 } : false}
+      animate={{ opacity: 1 }}
+      exit={{ opacity: 0 }}
+      transition={entering ? { delay: ENTER_DELAY, duration: ENTER_T, ease: EASE } : { duration: 0 }}
+    >
+      {children}
+    </motion.div>
+  )
+}
diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..2de66c3191b77bac40c31b1fb752dc7fb26d0739
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,66 @@
+import { useMemo } from 'react'
+import { Header } from './chrome/Header'
+import { Footer } from './chrome/Footer'
+import { Toc } from './chrome/Toc'
+import { Attribution } from './chrome/Attribution'
+import { Stage } from './Stage'
+import { TOC_MIN_WIDTH, DESIGN_H, DESIGN_W } from './constants'
+import { bodyStyle, rootStyle } from './layout'
+import { usePresentationNav } from './usePresentationNav'
+import { useViewportWidth } from './useViewportWidth'
+import type { PresentationProps } from './types'
+
+/**
+ * A presentation: one scene walked through ordered steps, with present/browse
+ * chrome, keyboard/touch/on-screen navigation, and the attribution link.
+ */
+export function Presentation<P>({
+  steps,
+  title,
+  initialMode = 'present',
+  attribution = true,
+  brand,
+  designWidth = DESIGN_W,
+  designHeight = DESIGN_H,
+}: PresentationProps<P>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const viewportWidth = useViewportWidth()
+  const eras = useMemo(() => [...new Set(steps.map((s) => s.era))], [steps])
+  const step = steps[nav.index]
+  const showToc = nav.mode === 'browse' && viewportWidth >= TOC_MIN_WIDTH
+
+  if (!step) return null
+
+  return (
+    <div
+      data-presentation-root=""
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      style={rootStyle}
+    >
+      <Header
+        brand={brand}
+        number={nav.index + 1}
+        total={steps.length}
+        era={step.era}
+        title={title}
+        mode={nav.mode}
+        onToggleMode={nav.toggleMode}
+      />
+      <div style={bodyStyle}>
+        {showToc ? <Toc steps={steps} eras={eras} index={nav.index} onGoTo={nav.goTo} /> : null}
+        <Stage steps={steps} index={nav.index} mode={nav.mode} designWidth={designWidth} designHeight={designHeight} />
+      </div>
+      <Footer
+        steps={steps}
+        index={nav.index}
+        mode={nav.mode}
+        onGoTo={nav.goTo}
+        onPrev={nav.prev}
+        onNext={nav.next}
+      />
+      {attribution ? <Attribution /> : null}
+    </div>
+  )
+}
