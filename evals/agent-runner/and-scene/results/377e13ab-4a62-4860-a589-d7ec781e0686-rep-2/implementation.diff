--- /dev/null
+++ b/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,38 @@
+import { useCallback, useSyncExternalStore } from 'react'
+import { fitScale } from './fit'
+import { DESIGN_H, DESIGN_W } from './constants'
+import type { Mode } from './types'
+
+/**
+ * Uniform fit scale for `mode`. The width is the stage's own width, so a side column
+ * such as the table of contents is excluded. The height is the window height less the
+ * mode's fixed chrome reservation, so the scale never follows a step's caption length.
+ * `stage` is the element itself (held in state by a callback ref), so the observer is
+ * attached whenever the element mounts. Falls back to the window width until measured.
+ */
+export function useFitScale(
+  stage: HTMLElement | null,
+  mode: Mode,
+  designWidth: number = DESIGN_W,
+  designHeight: number = DESIGN_H,
+): number {
+  const subscribe = useCallback(
+    (notify: () => void) => {
+      const observer = stage && typeof ResizeObserver !== 'undefined' ? new ResizeObserver(notify) : null
+      if (stage) observer?.observe(stage)
+      window.addEventListener('resize', notify)
+      return () => {
+        observer?.disconnect()
+        window.removeEventListener('resize', notify)
+      }
+    },
+    [stage],
+  )
+  const size = useSyncExternalStore(
+    subscribe,
+    () => `${stage?.getBoundingClientRect().width || window.innerWidth}x${window.innerHeight}`,
+    () => '0x0',
+  )
+  const [width, height] = size.split('x').map(Number)
+  return fitScale({ width, height }, mode, designWidth, designHeight)
+}
diff --git a/src/presentation-kit/usePresentationNav.ts b/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e81beec34e2d69f2c5c44ca247d42cce3a48f2ed
--- /dev/null
+++ b/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,84 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { SWIPE_MIN_PX } from './constants'
+import { isInteractive } from './interactive'
+import type { Mode } from './types'
+
+const clamp = (value: number, last: number) => Math.min(Math.max(value, 0), last)
+
+/**
+ * Step index, mode, and input handling for a presentation of `count` steps.
+ * Keys and swipes move one step at a time and clamp at both ends.
+ */
+export function usePresentationNav(count: number, initialMode: Mode = 'present') {
+  const last = Math.max(count - 1, 0)
+  const [raw, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const index = Math.min(raw, last)
+
+  const goTo = useCallback((target: number) => setIndex(clamp(target, last)), [last])
+  const next = useCallback(() => setIndex((i) => clamp(i + 1, last)), [last])
+  const prev = useCallback(() => setIndex((i) => clamp(i - 1, last)), [last])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'present' ? 'browse' : 'present')), [])
+
+  const handlers = useRef({ next, prev, toggleMode })
+  useEffect(() => {
+    handlers.current = { next, prev, toggleMode }
+  }, [next, prev, toggleMode])
+
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) return
+      if (isInteractive(event.target)) return
+      // Named keys (ArrowRight, PageDown...) ignore Shift; letter keys such as P do not.
+      if (event.shiftKey && event.key.length > 1) return
+      const { next: forward, prev: back, toggleMode: toggle } = handlers.current
+      let handled = true
+      switch (event.key) {
+        case 'ArrowRight':
+        case 'PageDown':
+        case ' ':
+          forward()
+          break
+        case 'ArrowLeft':
+        case 'PageUp':
+          back()
+          break
+        case 'p':
+        case 'P':
+          toggle()
+          break
+        default:
+          handled = false
+      }
+      if (handled) event.preventDefault()
+    }
+    window.addEventListener('keydown', onKeyDown)
+    return () => window.removeEventListener('keydown', onKeyDown)
+  }, [])
+
+  useEffect(() => {
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (event: TouchEvent) => {
+      const touch = event.touches[0]
+      start = touch ? { x: touch.clientX, y: touch.clientY } : null
+    }
+    const onTouchEnd = (event: TouchEvent) => {
+      const touch = event.changedTouches[0]
+      if (!start || !touch) return
+      const dx = touch.clientX - start.x
+      const dy = touch.clientY - start.y
+      start = null
+      if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) <= Math.abs(dy)) return
+      if (dx < 0) handlers.current.next()
+      else handlers.current.prev()
+    }
+    window.addEventListener('touchstart', onTouchStart, { passive: true })
+    window.addEventListener('touchend', onTouchEnd, { passive: true })
+    return () => {
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [])
+
+  return { index, goTo, next, prev, mode, setMode, toggleMode }
+}
