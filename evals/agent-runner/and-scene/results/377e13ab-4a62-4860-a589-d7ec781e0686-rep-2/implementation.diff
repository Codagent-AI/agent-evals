+/* Presentation-owned styling for the reference sample. The scene kit ships none of this. */
+
+:root {
+  --paper: #f6f1e7;
+  --ink: #1d1b16;
+  --muted: #6b6558;
+  --accent: #2f6fd6;
+  --card: #fffdf8;
+  --pass: #2f8f5b;
+  --ghost: #a39b8a;
+}
+
+[data-presentation-root] {
+  background: var(--paper);
+  color: var(--ink);
+  font-family: ui-sans-serif, system-ui, sans-serif;
+  padding: 16px 24px 0;
+  box-sizing: border-box;
+}
+
+[data-presentation-header] {
+  padding-bottom: 8px;
+}
+
+/* On phone widths the scene is width-limited, so give it every spare pixel. */
+@media (max-width: 640px) {
+  [data-presentation-root] {
+    padding: 12px 8px 0;
+  }
+}
+
+[data-presentation-marker] {
+  margin: 0;
+  white-space: nowrap;
+  font-size: 13px;
+  color: var(--muted);
+}
+
+[data-presentation-marker-era] {
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+}
+
+[data-presentation-deck-title] {
+  margin: 0 0 0 auto;
+  min-width: 0;
+  padding-left: 12px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: 14px;
+  font-weight: 600;
+}
+
+[data-presentation-mode-toggle],
+[data-presentation-prev],
+[data-presentation-next] {
+  font: inherit;
+  font-size: 13px;
+  color: var(--ink);
+  background: var(--card);
+  border: 1px solid var(--ink);
+  border-radius: 999px;
+  padding: 4px 12px;
+  cursor: pointer;
+}
+
+[data-presentation-prev]:disabled,
+[data-presentation-next]:disabled {
+  opacity: 0.35;
+  cursor: default;
+}
+
+[data-presentation-toc-entry] {
+  font: inherit;
+  font-size: 12px;
+  color: var(--muted);
+  background: none;
+  border: none;
+  padding: 4px 0;
+  cursor: pointer;
+  text-align: left;
+}
+
+[data-presentation-toc] {
+  width: 170px;
+  flex: none;
+  padding-right: 16px;
+}
+
+[data-presentation-toc-entry][data-presentation-active='true'] {
