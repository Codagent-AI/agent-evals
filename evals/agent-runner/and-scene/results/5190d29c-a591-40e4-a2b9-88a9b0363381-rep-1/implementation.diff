+.landing h1 em { color: #c6d282; font-style: normal; }
+.landing-copy { max-width: 490px; color: #c2c5ba; font-size: 18px; line-height: 1.6; }
+.presentation-list { max-width: 700px; }
+.presentation-list .eyebrow { padding-bottom: 12px; border-bottom: 1px solid #434840; }
+.presentation-link { display: flex; align-items: center; justify-content: space-between; padding: 22px 0; border-bottom: 1px solid #434840; color: #f5f0e6; text-decoration: none; font-size: 18px; }
+.presentation-link svg { color: #c6d282; transition: transform .2s ease; }
+.presentation-link:hover svg { transform: translate(3px, -3px); }
+.landing-footer { margin-top: auto; padding-top: 60px; color: #858b7e; font: 11px 'DM Mono', monospace; }
