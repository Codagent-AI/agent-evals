diff --git a/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f64e30b9759df14de11cd6467220d66c3d0da3ae
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
@@ -0,0 +1,203 @@
+import { spawn } from 'node:child_process'
+import { createServer } from 'node:net'
+import { fileURLToPath } from 'node:url'
+import path from 'node:path'
+import fs from 'node:fs/promises'
+import process from 'node:process'
+import { chromium } from 'playwright'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const sleep = ms => new Promise(resolve => setTimeout(resolve, ms))
+
+export function parseArgs(args) {
+  const options = { out: '.presentation-inspection', settle: 1200, width: 1440, height: 900, skipBuild: false }
+  let slug
+  for (let i = 0; i < args.length; i += 1) {
+    const arg = args[i]
+    if (arg === '--skip-build') options.skipBuild = true
+    else if (['--out', '--settle', '--width', '--height'].includes(arg)) {
+      const value = args[++i]
+      if (!value) throw new Error(`Missing value for ${arg}`)
+      const key = { '--out': 'out', '--settle': 'settle', '--width': 'width', '--height': 'height' }[arg]
+      options[key] = key === 'out' ? value : Number(value)
+      if (key !== 'out' && (!Number.isFinite(options[key]) || options[key] <= 0)) throw new Error(`${arg} must be a positive number`)
+    } else if (arg.startsWith('-')) throw new Error(`Unknown option: ${arg}`)
+    else if (!slug) slug = arg
+    else throw new Error(`Unexpected argument: ${arg}`)
+  }
+  if (!slug) throw new Error('Usage: npm run inspect -- <slug> [--out dir] [--settle ms] [--width W --height H] [--skip-build]')
+  return { ...options, slug }
+}
+
+export function inspectPage() {
+  const visible = element => {
+    for (let current = element; current; current = current.parentElement) {
+      const style = getComputedStyle(current)
+      if (style.display === 'none' || style.visibility === 'hidden' || Number(style.opacity) === 0) return false
+    }
+    const style = getComputedStyle(element)
+    const rect = element.getBoundingClientRect()
+    return style.display !== 'none' && style.visibility !== 'hidden' && Number(style.opacity) !== 0 && rect.width > 0 && rect.height > 0
+  }
+  const description = element => {
+    const selector = element.getAttribute('data-presentation-title') ? '[data-presentation-title]' : element.tagName.toLowerCase()
+    const text = (element.innerText || element.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 48)
+    return `${selector}${text ? ` “${text}”` : ''}`
+  }
+  const allowed = (a, b) => Boolean(a.closest('[data-presentation-allow-overlap]') || b.closest('[data-presentation-allow-overlap]'))
+  const controls = 'button, a, [role="button"], [data-presentation-dot]'
+  const chromeRegions = '[data-presentation-header], [data-presentation-footer], [data-presentation-progress], [data-presentation-toc], [data-presentation-nav]'
+  const candidates = [...document.querySelectorAll('body *')].flatMap(element => {
+    if (!visible(element) || element.closest('[data-presentation-allow-overlap]')) return []
+    const isControl = element.matches(controls)
+    const isTextHook = element.matches('[data-presentation-caption], [data-presentation-title], [data-presentation-attribution]')
+    if (!isControl && !isTextHook && element.matches(chromeRegions)) return []
+    if (isControl) {
+      const rect = element.getBoundingClientRect()
+      return [{ element, rects: [rect] }]
+    }
+    const rects = []
+    for (const node of element.childNodes) {
+      if (node.nodeType !== Node.TEXT_NODE || !node.textContent?.trim()) continue
+      const range = document.createRange()
+      range.selectNodeContents(node)
+      rects.push(...range.getClientRects())
+    }
+    return rects.length ? [{ element, rects }] : []
+  })
+  const overlap = []
+  for (let i = 0; i < candidates.length; i += 1) for (let j = i + 1; j < candidates.length; j += 1) {
+    const { element: a, rects: aRects } = candidates[i]; const { element: b, rects: bRects } = candidates[j]
+    if (a.contains(b) || b.contains(a) || allowed(a, b)) continue
+    const intersects = aRects.some(x => x.width > 0 && x.height > 0 && bRects.some(y => y.width > 0 && y.height > 0 && x.left < y.right && x.right > y.left && x.top < y.bottom && x.bottom > y.top))
+    if (intersects) overlap.push([description(a), description(b)])
+  }
+  const sameStyle = (a, b) => {
+    const keys = ['color', 'backgroundColor', 'borderColor', 'opacity', 'fontWeight', 'boxShadow', 'width', 'height', 'transform']
+    const left = getComputedStyle(a); const right = getComputedStyle(b)
+    return keys.every(key => left[key] === right[key])
+  }
+  const activeWarnings = []
+  for (const active of document.querySelectorAll('[data-active="true"], [aria-current]:not([aria-current="false"])')) {
+    const parent = active.parentElement
+    const siblings = [...(parent?.children || [])].filter(item => item !== active && visible(item))
+    if (siblings.some(item => sameStyle(active, item))) activeWarnings.push(description(active))
+  }
+  const attribution = document.querySelector('[data-presentation-attribution]')
+  let attributionWarning = null
+  if (!attribution) attributionWarning = 'missing [data-presentation-attribution]'
+  else {
+    const style = getComputedStyle(attribution)
+    const isDefault = style.color === 'rgb(0, 0, 238)' || (style.textDecorationLine.includes('underline') && style.color === 'rgb(0, 0, 238)')
+    if (parseFloat(style.fontSize) < 12 || isDefault) attributionWarning = `style [data-presentation-attribution] (font-size ${style.fontSize}, color ${style.color})`
+  }
+  return { overlap, activeWarnings, attributionWarning }
+}
+
+async function freePort() {
+  const server = createServer()
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve))
+  const port = server.address().port
+  await new Promise(resolve => server.close(resolve))
+  return port
+}
+
+async function run(command, args, onChild) {
+  return new Promise((resolve, reject) => {
+    const child = spawn(command, args, { cwd: root, detached: true, stdio: 'inherit' })
+    onChild?.(child)
+    child.on('error', reject)
+    child.on('close', code => code === 0 ? resolve() : reject(new Error(`${command} exited ${code}`)))
+  })
+}
+
+export async function main(args = process.argv.slice(2)) {
+  let server
+  let browser
+  let buildChild
+  let interrupted = false
+  const terminate = child => {
+    if (child?.pid) try { process.kill(-child.pid, 'SIGTERM') } catch { /* already exited */ }
+  }
+  const stop = signal => {
+    interrupted = true
+    process.exitCode = signal === 'SIGINT' ? 130 : 143
+    terminate(buildChild)
+    if (server?.pid) try { process.kill(-server.pid, 'SIGTERM') } catch { /* already exited */ }
+    if (browser) void browser.close().catch(() => {})
+  }
+  const onInterrupt = () => stop('SIGINT')
+  const onTerminate = () => stop('SIGTERM')
+  const ensureRunning = () => { if (interrupted) throw new Error('Inspection interrupted') }
+  process.once('SIGINT', onInterrupt)
+  process.once('SIGTERM', onTerminate)
+  try {
+    const options = parseArgs(args)
+    const registry = await fs.readFile(path.join(root, 'src/presentations/index.ts'), 'utf8')
+    ensureRunning()
+    if (!registry.includes(`"${options.slug}"`) && !registry.includes(`'${options.slug}'`)) throw new Error(`Presentation slug is not registered: ${options.slug}`)
+    if (!options.skipBuild) {
+      console.log('[inspect] build: running npm run build')
+      const buildPromise = run('npm', ['run', 'build'], child => { buildChild = child })
+      await buildPromise
+      ensureRunning()
+    }
+    const port = await freePort()
+    ensureRunning()
+    server = spawn('npm', ['exec', '--', 'vite', 'preview', '--host', '127.0.0.1', '--port', String(port), '--strictPort'], { cwd: root, detached: true, stdio: 'ignore' })
+    const base = `http://127.0.0.1:${port}/`
+    let ready = false
+    for (let i = 0; i < 100; i += 1) {
+      ensureRunning()
+      if (server.exitCode !== null) break
+      try { if ((await fetch(base)).ok) { ready = true; break } } catch { /* preview is not listening yet */ }
+      await sleep(100)
+    }
+    if (!ready) throw new Error(`Preview failed to start at ${base}`)
+    const browserOptions = {}
+    const executablePath = process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH || process.env.CHROME_PATH
+    if (executablePath) browserOptions.executablePath = executablePath
+    try { browser = await chromium.launch({ headless: true, ...browserOptions }) }
+    catch (error) { throw new Error(`Could not launch Chromium. Install it with "npx playwright install chromium" or set PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH/CHROME_PATH. ${error.message}`, { cause: error }) }
+    const page = await browser.newPage({ viewport: { width: options.width, height: options.height } })
+    await page.goto(`${base}${options.slug}`, { waitUntil: 'networkidle' })
+    ensureRunning()
+    const count = Number(await page.locator('[data-step-count]').first().getAttribute('data-step-count'))
+    ensureRunning()
+    if (!Number.isInteger(count) || count < 1) throw new Error(`Route ${options.slug} has no valid [data-step-count] hook`)
+    const output = path.resolve(root, options.out, options.slug)
+    await fs.mkdir(output, { recursive: true })
+    let warnings = 0
+    for (let step = 1; step <= count; step += 1) {
+      ensureRunning()
+      if (step > 1) await page.keyboard.press('ArrowRight')
+      await page.waitForFunction(index => Number(document.querySelector('[data-step-index]')?.getAttribute('data-step-index')) === index - 1, step, { timeout: 5000 })
+      ensureRunning()
+      await page.waitForTimeout(options.settle)
+      ensureRunning()
+      const marker = await page.locator('[data-inspect-settle-marker]').first().getAttribute('data-inspect-settle-marker').catch(() => null)
+      const diagnostics = await page.evaluate(inspectPage)
+      const file = path.join(output, `step-${String(step).padStart(2, '0')}.png`)
+      await page.screenshot({ path: file, fullPage: true })
+      console.log(`[inspect] captured step ${step}/${count}: ${file}${marker === null ? '' : ` marker=${marker}`}`)
+      for (const [left, right] of diagnostics.overlap) { warnings += 1; console.warn(`[inspect] WARN step=${step} overlap: ${left} intersects ${right}`) }
+      for (const active of diagnostics.activeWarnings) { warnings += 1; console.warn(`[inspect] WARN step=${step} active-nav: ${active} matches inactive sibling styling`) }
+      if (diagnostics.attributionWarning) { warnings += 1; console.warn(`[inspect] WARN step=${step} attribution: ${diagnostics.attributionWarning}; style the data-presentation-attribution hook`) }
+    }
+    console.log(`[inspect] done: ${count} screenshots, ${warnings} warnings`)
+  } catch (error) {
+    if (!interrupted) {
+      console.error(`[inspect] FAIL ${error.stack || error.message}`)
+      process.exitCode = 1
+    }
+  } finally {
+    process.removeListener('SIGINT', onInterrupt)
+    process.removeListener('SIGTERM', onTerminate)
+    if (browser) await browser.close().catch(() => {})
+    terminate(buildChild)
+    terminate(server)
+  }
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) await main()
+/* global document, getComputedStyle, Node */
diff --git a/skills/presentation/templates/bootstrap/scripts/verify.mjs b/skills/presentation/templates/bootstrap/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f9ff96b89f37318948e9958dbd7e350759782ff1
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/verify.mjs
@@ -0,0 +1,165 @@
+/* global document */
+import { spawn } from 'node:child_process'
+import { createServer } from 'node:net'
+import { fileURLToPath } from 'node:url'
+import path from 'node:path'
+import fs from 'node:fs/promises'
+import process from 'node:process'
+import { chromium } from 'playwright'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms))
+const tail = (value) => value.split('\n').slice(-18).join('\n')
+const fail = (phase, message) => {
+  console.error(`[verify] FAIL phase=${phase} ${message}`)
+  process.exitCode = 1
+}
+
+async function freePort() {
+  const server = createServer()
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve))
+  const port = server.address().port
+  await new Promise((resolve) => server.close(resolve))
+  return port
+}
+
+async function browserInstance() {
+  const executablePath = process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH || process.env.CHROME_PATH
+  try {
+    return await chromium.launch({ headless: true, ...(executablePath ? { executablePath } : {}) })
+  } catch (error) {
+    throw new Error(`Could not launch Chromium. Install it with "npx playwright install chromium" or set PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH/CHROME_PATH. ${error.message}`, { cause: error })
+  }
+}
+
+async function registeredSlugs() {
+  const registry = await fs.readFile(path.join(root, 'src/presentations/index.ts'), 'utf8').catch(() => '')
+  return [...registry.matchAll(/slug\s*:\s*["']([^"']+)["']/g)].map((match) => match[1])
+}
+
+async function verifyReference(config) {
+  const { slug, stepSource, steps } = config.reference
+  const registry = await fs.readFile(path.join(root, 'src/presentations/index.ts'), 'utf8').catch(() => '')
+  const folder = path.join(root, 'src/presentations', slug)
+  if (!new RegExp(`slug\\s*:\\s*["']${slug}["']`).test(registry) || !(await fs.stat(folder).catch(() => false))) {
+    throw Object.assign(new Error(`reference sample is missing or not registered: ${slug}`), { phase: 'sample' })
+  }
+  const source = await fs.readFile(path.join(root, stepSource), 'utf8').catch(() => '')
+  const rows = [...source.matchAll(/\[\s*"[^"]*"\s*,\s*"([^"]+)"\s*,\s*"([^"]+)"\s*\]/g)]
+  if (rows.length !== steps.length) {
+    throw Object.assign(new Error(`found ${rows.length} complete step rows; expected ${steps.length}`), { phase: 'sample' })
+  }
+  for (let index = 0; index < steps.length; index += 1) {
+    const { title, caption } = steps[index]
+    if (rows[index][1] !== title || rows[index][2] !== caption) {
+      throw Object.assign(new Error(`step ${index + 1} is missing or out of order: expected "${title}"`), { phase: 'sample' })
+    }
+  }
+  console.log(`[verify] sample: ${slug} has ${steps.length} ordered steps`)
+  return [slug]
+}
+
+async function verifyRoutes(slugs, children, ensureRunning, onBrowser) {
+  if (slugs.length === 0) throw Object.assign(new Error('No presentations are registered. Add one before running verify.'), { phase: 'routes' })
+  console.log('[verify] render: starting production preview at 127.0.0.1')
+  const port = await freePort()
+  const server = spawn('npm', ['exec', '--', 'vite', 'preview', '--host', '127.0.0.1', '--port', String(port), '--strictPort'], { cwd: root, detached: true, stdio: ['ignore', 'ignore', 'pipe'] })
+  children.add(server)
+  let serverErrors = ''
+  server.stderr.on('data', (chunk) => { serverErrors += chunk })
+  const url = `http://127.0.0.1:${port}/`
+  let ready = false
+  for (let attempt = 0; attempt < 100; attempt += 1) {
+    ensureRunning()
+    if (server.exitCode !== null) break
+    try {
+      if ((await fetch(url)).ok) { ready = true; break }
+    } catch { /* preview is starting */ }
+    await sleep(100)
+  }
+  if (!ready) throw Object.assign(new Error(`preview did not become ready at ${url}. ${serverErrors}`), { phase: 'render' })
+  console.log(`[verify] render: preview ready at ${url}`)
+  const browser = await browserInstance()
+  onBrowser(browser)
+  try {
+    for (const slug of slugs) {
+      const page = await browser.newPage()
+      let errors = []
+      let currentStep = 1
+      page.on('console', (message) => { if (message.type() === 'error') errors.push(message.text()) })
+      page.on('pageerror', (error) => errors.push(error.message))
+      await page.goto(`${url}${slug}`, { waitUntil: 'networkidle' })
+      ensureRunning()
+      const chrome = page.locator('[data-step-count]').first()
+      const count = Number(await chrome.getAttribute('data-step-count'))
+      if (!Number.isInteger(count) || count < 1) throw Object.assign(new Error(`${slug}: first step has no valid data-step-count`), { phase: 'render' })
+      if (errors.length) throw Object.assign(new Error(`${slug} step 1: ${errors.join('; ')}`), { phase: 'render' })
+      console.log(`[verify] render: ${slug} route reports ${count} steps`)
+      for (let index = 1; index < count; index += 1) {
+        errors = []
+        currentStep = index + 1
+        await page.keyboard.press('ArrowRight')
+        ensureRunning()
+        try {
+          await page.waitForFunction((expectedIndex) => Number(document.querySelector('[data-step-index]')?.getAttribute('data-step-index')) === expectedIndex, currentStep - 1, { timeout: 5000 })
+        } catch {
+          throw Object.assign(new Error(`${slug} step ${currentStep}: data-step-index did not advance`), { phase: 'render' })
+        }
+        if (errors.length) throw Object.assign(new Error(`${slug} step ${currentStep}: ${errors.join('; ')}`), { phase: 'render' })
+        console.log(`[verify] render: ${slug} step ${currentStep}/${count}`)
+      }
+      await page.close()
+    }
+    console.log('[verify] render: all registered route steps rendered without browser errors')
+    console.log('[verify] PASS')
+  } finally {
+    await browser.close().catch(() => {})
+    onBrowser(null)
+    if (server.pid) try { process.kill(-server.pid, 'SIGTERM') } catch { /* already exited */ }
+    children.delete(server)
+  }
+}
+
+async function main() {
+  let browser
+  const children = new Set()
+  let interrupted = false
+  const stop = (signal) => {
+    interrupted = true
+    process.exitCode = signal === 'SIGINT' ? 130 : 143
+    for (const child of children) if (child.pid) try { process.kill(-child.pid, 'SIGTERM') } catch { /* already exited */ }
+    if (browser) void browser.close().catch(() => {})
+  }
+  const onInterrupt = () => stop('SIGINT')
+  const onTerminate = () => stop('SIGTERM')
+  const ensureRunning = () => { if (interrupted) throw new Error('Verification interrupted') }
+  process.once('SIGINT', onInterrupt)
+  process.once('SIGTERM', onTerminate)
+  try {
+    console.log('[verify] build: running npm run build')
+    const build = spawn('npm', ['run', 'build'], { cwd: root, detached: true, stdio: ['ignore', 'pipe', 'pipe'] })
+    children.add(build)
+    let output = ''
+    build.stdout.on('data', (chunk) => { output += chunk })
+    build.stderr.on('data', (chunk) => { output += chunk })
+    const buildCode = await new Promise((resolve) => build.on('close', resolve))
+    children.delete(build)
+    ensureRunning()
+    if (buildCode !== 0) return fail('build', `npm run build exited ${buildCode}\n${tail(output)}`)
+    console.log('[verify] build: passed')
+
+    const configFile = path.join(root, 'verify.config.json')
+    const config = await fs.readFile(configFile, 'utf8').then(JSON.parse).catch((error) => error.code === 'ENOENT' ? null : Promise.reject(error))
+    const slugs = config?.reference ? await verifyReference(config) : await registeredSlugs()
+    await verifyRoutes(slugs, children, ensureRunning, (instance) => { browser = instance })
+  } catch (error) {
+    if (!interrupted) fail(error.phase || 'render', error.stack || error.message)
+  } finally {
+    process.removeListener('SIGINT', onInterrupt)
+    process.removeListener('SIGTERM', onTerminate)
+    if (browser) await browser.close().catch(() => {})
+    for (const child of children) if (child.pid) try { process.kill(-child.pid, 'SIGTERM') } catch { /* already exited */ }
+  }
+}
+
+await main()
