diff --git a/src/presentation-kit/Attribution.tsx b/src/presentation-kit/Attribution.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..bda6c08ed2155626036fe1f3c4135ecc49b1bb5b
--- /dev/null
+++ b/src/presentation-kit/Attribution.tsx
@@ -0,0 +1,22 @@
+import type { ReactNode } from "react";
+export type AttributionOptions =
+  | false
+  | { label?: string; href?: string; render?: () => ReactNode };
+export function Attribution({
+  options = {},
+}: {
+  options?: AttributionOptions;
+}) {
+  if (options === false) return null;
+  if (options.render)
+    return <div data-presentation-attribution>{options.render()}</div>;
+  return (
+    <a
+      data-presentation-attribution
+      href={options.href ?? "https://github.com/Codagent-AI/and-scene"}
+      style={{ position: "absolute", right: 0, bottom: 0 }}
+    >
+      {options.label ?? "made by and-scene"}
+    </a>
+  );
+}
