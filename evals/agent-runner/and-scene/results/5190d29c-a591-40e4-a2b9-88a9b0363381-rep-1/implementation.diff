diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/Presentation.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4739ab1d20303a557142701c124371d7233d5827
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,81 @@
+import { useEffect, useState, type ReactNode } from "react";
+import { usePresentationNav } from "./usePresentationNav";
+import { Stage } from "./Stage";
+import { Header } from "./chrome/Header";
+import { Footer } from "./chrome/Footer";
+import { Toc } from "./chrome/Toc";
+import { Attribution, type AttributionOptions } from "./Attribution";
+import type { PresentationMode, Step } from "./types";
+export interface PresentationProps<T> {
+  steps: readonly Step<T>[];
+  title: string;
+  initialMode?: PresentationMode;
+  attribution?: AttributionOptions;
+  brand?: ReactNode;
+}
+export function Presentation<T>({
+  steps,
+  title,
+  initialMode = "present",
+  attribution,
+  brand,
+}: PresentationProps<T>) {
+  const nav = usePresentationNav(steps.length, initialMode);
+  // `steps` can shrink after the index was set (hot reload, filtered list).
+  const stepIndex = Math.min(nav.stepIndex, steps.length - 1);
+  const step = steps[stepIndex];
+  const [isWide, setIsWide] = useState(() => window.innerWidth >= 900);
+  useEffect(() => {
+    const resize = () => setIsWide(window.innerWidth >= 900);
+    window.addEventListener("resize", resize);
+    return () => window.removeEventListener("resize", resize);
+  }, []);
+  if (!step) return null;
+  return (
+    <main
+      aria-label={title}
+      data-presentation-root
+      data-step-count={steps.length}
+      data-step-index={stepIndex}
+      data-presentation-mode={nav.mode}
+      onTouchStart={nav.onTouchStart}
+      onTouchEnd={nav.onTouchEnd}
+      style={{
+        position: "relative",
+        width: "100vw",
+        height: "100vh",
+        overflow: "hidden",
+      }}
+    >
+      <Header
+        title={step.title}
+        mode={nav.mode}
+        stepNumber={stepIndex + 1}
+        brand={brand}
+      />
+      <Stage steps={steps} index={stepIndex} mode={nav.mode} />
+      {nav.mode === "browse" && isWide && (
+        <Toc steps={steps} index={stepIndex} onJump={nav.jumpTo} />
+      )}
+      <Footer
+        mode={nav.mode}
+        caption={step.caption}
+        index={stepIndex}
+        count={steps.length}
+        onJump={nav.jumpTo}
+        onPrev={nav.prev}
+        onNext={nav.next}
+      />
+      <Attribution options={attribution} />
+      <button
+        type="button"
+        aria-label="Toggle presentation mode"
+        onClick={nav.toggleMode}
+        data-presentation-mode-toggle
+        style={{ position: "absolute", right: 0, top: 0 }}
+      >
+        Mode
+      </button>
+    </main>
+  );
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/README.md b/skills/presentation/templates/bootstrap/src/presentation-kit/README.md
new file mode 100644
