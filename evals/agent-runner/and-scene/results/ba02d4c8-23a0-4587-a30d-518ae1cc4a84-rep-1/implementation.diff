+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,74 @@
+import { type ReactNode, useMemo, useSyncExternalStore } from 'react'
+import { WIDE_QUERY } from './constants.ts'
+import { Attribution } from './chrome/Attribution.tsx'
+import { Footer } from './chrome/Footer.tsx'
+import { Header } from './chrome/Header.tsx'
+import { Narration } from './chrome/Narration.tsx'
+import { Toc } from './chrome/Toc.tsx'
+import { buildSections } from './sections.ts'
+import { Stage } from './Stage.tsx'
+import type { AttributionOptions, Mode, Step } from './types.ts'
+import { usePresentationNav } from './usePresentationNav.ts'
+
+export interface PresentationProps<TPayload> {
+  steps: ReadonlyArray<Step<TPayload>>
+  title?: string
+  initialMode?: Mode
+  className?: string
+  /** Optional host branding for the top-left slot; empty by default. */
+  brand?: ReactNode
+  /** Override the default bottom-right attribution, or pass `false` to omit it. */
+  attribution?: AttributionOptions | false
+}
+
+function subscribeWide(callback: () => void) {
+  const query = window.matchMedia?.(WIDE_QUERY)
+  query?.addEventListener('change', callback)
+  return () => query?.removeEventListener('change', callback)
+}
+
+function useIsWide(): boolean {
+  return useSyncExternalStore(
+    subscribeWide,
+    () => window.matchMedia?.(WIDE_QUERY).matches ?? true,
+    () => true,
+  )
+}
+
+export function Presentation<TPayload>({
+  steps,
+  title,
+  initialMode = 'browse',
+  className,
+  brand,
+  attribution,
+}: PresentationProps<TPayload>) {
+  const { index, mode, goTo, next, prev } = usePresentationNav(steps.length, initialMode)
+  const sections = useMemo(() => buildSections(steps), [steps])
+  const wide = useIsWide()
+  const step = steps[index]
+  if (!step) return null
+
+  const browse = mode === 'browse'
+  return (
+    <div
+      className={className}
+      data-presentation-root=""
+      data-presentation-mode={mode}
+      data-presentation-step-count={steps.length}
+      data-presentation-step-index={index}
+      data-step-count={steps.length}
+      data-step-index={index}
+      style={{ display: 'flex', flexDirection: 'column', height: '100dvh', width: '100%', overflow: 'hidden' }}
+    >
+      <Header title={title} mode={mode} brand={brand} />
+      <div style={{ display: 'flex', flex: '1 1 0', minHeight: 0 }}>
+        {browse && wide ? <Toc sections={sections} index={index} onGoTo={goTo} /> : null}
+        <Stage step={step} index={index} mode={mode} />
+      </div>
+      <Narration steps={steps} index={index} mode={mode} />
+      {browse ? <Footer steps={steps} index={index} onGoTo={goTo} onPrev={prev} onNext={next} /> : null}
+      {attribution === false ? null : <Attribution {...attribution} />}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5ada6294f52b6f86c7c7773199c183dda4335e20
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,60 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, ENTER_T } from './constants.ts'
+import { sceneKey } from './sections.ts'
+import type { Mode, Step } from './types.ts'
+import { useFitScale } from './useFitScale.ts'
+
+interface StageProps<TPayload> {
+  step: Step<TPayload>
+  index: number
+  mode: Mode
+}
+
+export function Stage<TPayload>({ step, index, mode }: StageProps<TPayload>) {
+  const { ref, scale } = useFitScale(mode)
+  const key = sceneKey(step)
+  const { Scene } = step
+
+  return (
+    <div
+      ref={ref}
+      data-presentation-stage=""
+      style={{ flex: '1 1 0', minWidth: 0, minHeight: 0, position: 'relative', overflow: 'hidden' }}
+    >
+      <motion.div
+        layout
+        transition={{ layout: { duration: 0 } }}
+        data-presentation-canvas=""
+        data-presentation-scale={scale.toFixed(4)}
+        style={{
+          position: 'absolute',
+          left: '50%',
+          top: '50%',
+          width: DESIGN_W,
+          height: DESIGN_H,
+          x: '-50%',
+          y: '-50%',
+          scale,
+          originX: 0.5,
+          originY: 0.5,
+        }}
+      >
+        <LayoutGroup>
+          <AnimatePresence>
+            <motion.div
+              key={key}
+              data-presentation-scene={key}
+              style={{ position: 'absolute', inset: 0 }}
+              initial={{ opacity: 0 }}
+              animate={{ opacity: 1 }}
+              exit={{ opacity: 0 }}
+              transition={{ duration: ENTER_T }}
+            >
+              <Scene payload={step.payload as TPayload} step={step} index={index} />
+            </motion.div>
+          </AnimatePresence>
+        </LayoutGroup>
+      </motion.div>
+    </div>
+  )
+}
diff --git a/src/presentation-kit/__tests__/layout.test.ts b/src/presentation-kit/__tests__/layout.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7ad4e265040cf2e20fd03dec0709d8642c099b94
