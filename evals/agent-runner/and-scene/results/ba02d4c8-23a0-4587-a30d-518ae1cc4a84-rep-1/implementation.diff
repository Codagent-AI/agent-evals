+import { cp, mkdtemp, readdir, readFile, rm } from 'node:fs/promises'
+import os from 'node:os'
+import path from 'node:path'
+import { afterAll, describe, expect, it } from 'vitest'
+import { apply, createPresentation, detect, detectAnchors } from '../../skills/presentation/scripts/scaffold.mjs'
+import { leftoverProcesses, repoRoot, run } from './helpers.ts'
+
+const BOOTSTRAP = path.join(repoRoot, 'skills/presentation/templates/bootstrap')
+const dirs: string[] = []
+const tmp = async () => {
+  const dir = await mkdtemp(path.join(os.tmpdir(), 'and-scene-boot-'))
+  dirs.push(dir)
+  return dir
+}
+
+afterAll(() => Promise.all(dirs.map((d) => rm(d, { recursive: true, force: true }))))
+
+describe('INT-001: the materialized bootstrap is complete and style-neutral', () => {
+  it('installs from the lock file, lints, builds and renders its registered route outside the repository', async () => {
+    const app = await tmp()
+    await cp(BOOTSTRAP, app, { recursive: true, filter: (s) => !s.includes('node_modules') })
+    const caller = await tmp() // run from an unrelated working directory
+    expect(await detectAnchors(app)).toEqual({ build: true, kit: true, index: true })
+
+    const install = await run('npm', ['ci', '--prefix', app], caller)
+    expect(install.code, install.output).toBe(0)
+    const lint = await run('npm', ['run', 'lint', '--prefix', app], caller)
+    expect(lint.code, lint.output).toBe(0)
+    const verify = await run('npm', ['run', 'verify', '--prefix', app], caller)
+    expect(verify.output).toContain('PASS [build]')
+    expect(verify.output).toContain('PASS [render] /starter: 3 steps')
+    expect(verify.output).toMatch(/preview: http:\/\/127\.0\.0\.1:\d+/)
+    expect(verify.code, verify.output).toBe(0)
+    const inspect = await run('npm', ['run', 'inspect', '--prefix', app, '--', 'starter', '--no-build', '--settle', '1500'], caller)
+    expect(inspect.code, inspect.output).toBe(0)
+    expect(inspect.output).toContain('captured 3 screenshots')
+    // the unstyled starter legitimately earns advisory warnings about unstyled active chrome and attribution
+    expect(inspect.output).toContain('WARN step 1 indistinct active chrome')
+
+    const installed = (await readdir(path.join(app, 'node_modules'))).concat(await readdir(path.join(app, 'node_modules/@types')))
+    for (const name of ['react', 'react-dom', 'motion', 'lucide-react', 'vite', 'typescript', 'eslint', 'playwright', 'react', 'node']) {
+      expect(installed, name).toContain(name)
+    }
+    expect(installed.filter((n) => /tailwind/i.test(n))).toEqual([])
+    expect(await leftoverProcesses(app)).toBe('')
+  })
+
+  it('scaffolds an empty directory, installs dependencies and passes verification with a new presentation', async () => {
+    const app = await tmp()
+    const result = await detect(app)
+    expect(result.missing).toEqual(['build', 'kit', 'index'])
+    await apply(result.appDir, result.missing)
+    await createPresentation(app, 'my-first-talk', 'My First Talk')
+    const verify = await run('npm', ['run', 'verify'], app)
+    expect(verify.code, verify.output).toBe(0)
+    expect(verify.output).toContain('PASS [render] /my-first-talk: 3 steps')
+    const css = await readFile(path.join(app, 'src/presentations/my-first-talk/talk.css'), 'utf8')
+    expect(css).toContain('.p-my-first-talk')
+    expect(await leftoverProcesses(app)).toBe('')
+  })
+})
diff --git a/tests/integration/e2e-verify.test.ts b/tests/integration/e2e-verify.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d74437c2c691b498c288ccd9472b99e230e54898
--- /dev/null
+++ b/tests/integration/e2e-verify.test.ts
@@ -0,0 +1,126 @@
+import { afterAll, describe, expect, it } from 'vitest'
+import { addFile, copyApp, editFile, leftoverProcesses, removeApp, repoRoot, run } from './helpers.ts'
+
+const SAMPLE = 'src/presentations/how-to-make-a-presentation'
+const copies: string[] = []
+
+async function faulty(inject: (dir: string) => Promise<void>) {
+  const dir = await copyApp()
+  copies.push(dir)
+  await inject(dir)
+  const result = await run('npm', ['run', 'verify'], dir)
+  return { ...result, dir }
+}
+
+/** Runs in the page: reacts to the step index changing to `index`. */
+const onStep = (index: number, body: string) => `
+new MutationObserver(() => {
+  const root = document.querySelector('[data-presentation-step-index="${index}"]')
+  if (root && !(window as unknown as Record<string, boolean>).__fired${index}) {
+    ;(window as unknown as Record<string, boolean>).__fired${index} = true
+    ${body}
+  }
+}).observe(document.documentElement, { attributes: true, subtree: true, childList: true })
+`
+
+afterAll(async () => {
+  await Promise.all(copies.map(removeApp))
+})
+
+describe('E2E-001: the reference presentation passes production verification', () => {
+  it('builds, renders all nine steps on 127.0.0.1 and exits zero', async () => {
+    const { code, output } = await run('npm', ['run', 'verify'], repoRoot)
+    expect(output).toContain('PASS [build]')
+    expect(output).toMatch(/preview: http:\/\/127\.0\.0\.1:\d+/)
+    expect(output).not.toMatch(/localhost/)
+    for (let step = 1; step <= 9; step++) {
+      expect(output).toContain(`/how-to-make-a-presentation step ${step}/9 rendered`)
+    }
+    expect(output).toContain('PASS [render] /how-to-make-a-presentation: 9 steps')
+    expect(output).toContain('PASS [sample] 9 steps match the reference outline')
+    expect(output).toContain('VERIFY PASSED')
+    expect(code).toBe(0)
+  })
+})
+
+describe('E2E-002: verification failures are actionable', () => {
+  it('fails on a build error and names the build phase', async () => {
+    const { code, output, dir } = await faulty((d) => addFile(d, 'src/broken.ts', "export const broken: number = 'text'\n"))
+    expect(code).not.toBe(0)
+    expect(output).toContain('FAIL [build]')
+    expect(output).toContain('VERIFY FAILED (build)')
+    expect(output).not.toContain('VERIFY PASSED')
+    expect(await leftoverProcesses(dir)).toBe('')
+  })
+
+  it('fails when the reference sample is missing', async () => {
+    const { code, output, dir } = await faulty(async (d) => {
+      await editFile(d, 'src/presentations/index.ts', (t) => t.replace(/\[\n[\s\S]*\n\]/, '[]'))
+      await removeApp(`${d}/${SAMPLE}`)
+    })
+    expect(code).not.toBe(0)
+    expect(output).toContain('FAIL [sample]')
+    expect(output).toContain('is not registered')
+    expect(await leftoverProcesses(dir)).toBe('')
+  })
+
+  it('fails when the sample steps are out of order and names the first mismatching step', async () => {
+    const { code, output, dir } = await faulty((d) =>
+      editFile(d, `${SAMPLE}/steps.ts`, (t) =>
+        t.replace("'You have a topic'", "'TMP'").replace("'The skill interviews you'", "'You have a topic'").replace("'TMP'", "'The skill interviews you'"),
+      ),
+    )
+    expect(code).not.toBe(0)
+    expect(output).toMatch(/FAIL \[sample\] \/how-to-make-a-presentation step 1: title\/caption mismatch/)
+    expect(await leftoverProcesses(dir)).toBe('')
+  })
+
+  it('fails on a console error and names the step', async () => {
+    const { code, output, dir } = await faulty((d) =>
+      editFile(d, 'src/main.tsx', (t) => `${t}\n${onStep(2, "console.error('injected console failure')")}`),
+    )
+    expect(code).not.toBe(0)
+    expect(output).toMatch(/FAIL \[render\] \/how-to-make-a-presentation step 3: console error: injected console failure/)
+    expect(await leftoverProcesses(dir)).toBe('')
+  })
+
+  it('fails on an uncaught page error and names the step', async () => {
+    const { code, output, dir } = await faulty((d) =>
+      editFile(d, 'src/main.tsx', (t) => `${t}\n${onStep(3, "setTimeout(() => { throw new Error('injected page failure') })")}`),
+    )
+    expect(code).not.toBe(0)
+    expect(output).toMatch(/FAIL \[render\] \/how-to-make-a-presentation step 4: uncaught page error: injected page failure/)
+    expect(await leftoverProcesses(dir)).toBe('')
+  })
+
+  it('attributes an error raised during a step delayed entry animation to that step', async () => {
+    const { code, output, dir } = await faulty((d) =>
+      editFile(d, 'src/main.tsx', (t) => `${t}\n${onStep(4, "setTimeout(() => console.error('late entry failure'), 900)")}`),
+    )
+    expect(code).not.toBe(0)
+    expect(output).toMatch(/FAIL \[render\] \/how-to-make-a-presentation step 5: console error: late entry failure/)
+    expect(await leftoverProcesses(dir)).toBe('')
+  })
+
+  it('stops the preview when Chromium cannot launch', async () => {
+    const dir = await copyApp()
+    copies.push(dir)
+    const { code, output } = await run('npm', ['run', 'verify'], dir, { PLAYWRIGHT_BROWSERS_PATH: '/nonexistent' })
+    expect(code).not.toBe(0)
+    expect(output).toContain('FAIL [render]')
+    expect(await leftoverProcesses(dir)).toBe('')
+  })
+
+  it('fails when a transition does not advance the step index and names the step', async () => {
+    const { code, output, dir } = await faulty((d) =>
+      editFile(
+        d,
+        'src/main.tsx',
+        (t) => `${t}\nwindow.addEventListener('keydown', (e) => { if (document.querySelector('[data-presentation-step-index="3"]')) e.stopImmediatePropagation() }, true)\n`,
+      ),
+    )
+    expect(code).not.toBe(0)
+    expect(output).toMatch(/FAIL \[render\] \/how-to-make-a-presentation step 5: transition did not advance the step index \(still 3\)/)
+    expect(await leftoverProcesses(dir)).toBe('')
+  })
+})
