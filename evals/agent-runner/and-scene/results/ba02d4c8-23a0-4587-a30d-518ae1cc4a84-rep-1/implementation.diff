@@ -0,0 +1,34 @@
+import { AnimatePresence, motion } from 'motion/react'
+import type { CSSProperties, ReactNode } from 'react'
+import { EASE, ENTER_DELAY, ENTER_T, EXIT_T } from '../constants.ts'
+
+export interface AppearProps {
+  /** Entity presence: entering waits for persisting entities to settle; leaving animates out. */
+  when?: boolean
+  id?: string
+  className?: string
+  style?: CSSProperties
+  children?: ReactNode
+}
+
+/** Sequences a newcomer after continuing motion and animates it out when `when` turns false. */
+export function Appear({ when = true, id, className, style, children }: AppearProps) {
+  return (
+    <AnimatePresence>
+      {when ? (
+        <motion.div
+          key="appear"
+          data-presentation-appear=""
+          data-presentation-id={id}
+          className={className}
+          style={style}
+          initial={{ opacity: 0 }}
+          animate={{ opacity: 1, transition: { delay: ENTER_DELAY, duration: ENTER_T, ease: EASE } }}
+          exit={{ opacity: 0, transition: { duration: EXIT_T } }}
+        >
+          {children}
+        </motion.div>
+      ) : null}
+    </AnimatePresence>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/nodes/Arrow.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/nodes/Arrow.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5b37c409a83239b4c7c455c9d08f446e11e85f94
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/nodes/Arrow.tsx
@@ -0,0 +1,65 @@
+import { AnimatePresence, motion } from 'motion/react'
+import { useEffect, useId, useState } from 'react'
+import { arrowPath, type Point } from './geometry.ts'
+import { DESIGN_H, DESIGN_W, EASE, ENTER_DELAY, ENTER_T, EXIT_T, LAYOUT_T } from '../constants.ts'
+
+export interface ArrowProps {
+  id: string
+  from: Point
+  to: Point
+  /** Control point for a quadratic curve; straight when omitted. */
+  curve?: Point
+  /** Arrowhead at the start as well. */
+  bidirectional?: boolean
+  when?: boolean
+  className?: string
+}
+
+/** Last drawn path per arrow id, so an arrow in a newly mounted scene morphs from where its predecessor was. */
+const lastPaths = new Map<string, string>()
+
+/** Line or curve between canvas points, drawn in an SVG layer; stroke follows `currentColor`. */
+export function Arrow({ id, from, to, curve, bidirectional = false, when = true, className }: ArrowProps) {
+  const uid = useId()
+  const d = arrowPath(from, to, curve)
+  const [previous] = useState(() => lastPaths.get(id))
+  useEffect(() => {
+    lastPaths.set(id, d)
+  }, [id, d])
+  const headId = `${uid}-head`
+  return (
+    <AnimatePresence>
+      {when ? (
+        <motion.svg
+          key="arrow"
+          data-presentation-node="arrow"
+          data-presentation-id={id}
+          className={className}
+          width={DESIGN_W}
+          height={DESIGN_H}
+          viewBox={`0 0 ${DESIGN_W} ${DESIGN_H}`}
+          style={{ position: 'absolute', left: 0, top: 0, overflow: 'visible', pointerEvents: 'none' }}
+          initial={{ opacity: previous ? 1 : 0 }}
+          animate={{ opacity: 1, transition: { delay: previous ? 0 : ENTER_DELAY, duration: ENTER_T } }}
+          exit={{ opacity: 0, transition: { duration: EXIT_T } }}
+        >
+          <defs>
+            <marker id={headId} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
+              <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
+            </marker>
+          </defs>
+          <motion.path
+            data-presentation-arrow-line=""
+            fill="none"
+            stroke="currentColor"
+            markerEnd={`url(#${headId})`}
+            markerStart={bidirectional ? `url(#${headId})` : undefined}
+            initial={{ d: previous ?? d }}
+            animate={{ d }}
+            transition={{ duration: LAYOUT_T, ease: EASE }}
+          />
+        </motion.svg>
+      ) : null}
+    </AnimatePresence>
+  )
+}
