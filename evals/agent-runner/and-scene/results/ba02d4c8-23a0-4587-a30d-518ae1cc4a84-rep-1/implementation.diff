+}
+
+interface StepBase<TPayload> {
+  /** Stable identity of the step. */
+  id: string
+  /** Section / era label; consecutive steps sharing a label form one table-of-contents entry. */
+  era: string
+  /** One-line presenter title. */
+  title: string
+  /** Paragraph shown in browse mode. */
+  caption: string
+  /** Scene component showing the diagram state of this step. */
+  Scene: ComponentType<SceneProps<TPayload>>
+  /** Adjacent steps sharing a groupKey (and Scene) update one mounted scene in place. */
+  groupKey?: string
+}
+
+export type Step<TPayload = undefined> = StepBase<TPayload> &
+  (undefined extends TPayload ? { payload?: TPayload } : { payload: TPayload })
+
+export interface Section {
+  era: string
+  firstIndex: number
+  lastIndex: number
+}
+
+export interface AttributionOptions {
+  label?: string
+  href?: string
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b0fd957e60a60b090a3b1f35e8aac71f927123ea
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,28 @@
+import { useLayoutEffect, useRef, useState } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT } from './constants.ts'
+import type { Mode } from './types.ts'
+
+/** Uniform scale that fits the design canvas into an area, for the given mode. */
+export function computeScale(width: number, height: number, mode: Mode): number {
+  const { padX, padY } = STAGE_LAYOUT[mode]
+  const fit = Math.min((width - 2 * padX) / DESIGN_W, (height - 2 * padY) / DESIGN_H)
+  return Math.max(MIN_SCALE, fit)
+}
+
+export function useFitScale(mode: Mode) {
+  const ref = useRef<HTMLDivElement>(null)
+  const [scale, setScale] = useState(1)
+
+  useLayoutEffect(() => {
+    const el = ref.current
+    if (!el) return
+    const measure = () => setScale(computeScale(el.clientWidth, el.clientHeight, mode))
+    measure()
+    if (typeof ResizeObserver === 'undefined') return
+    const observer = new ResizeObserver(measure)
+    observer.observe(el)
+    return () => observer.disconnect()
+  }, [mode])
+
+  return { ref, scale }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5bba42dbfdf1326c05f6208c4d9625e7fef77e45
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,89 @@
+import { useCallback, useEffect, useState } from 'react'
+import { SWIPE_MIN_PX } from './constants.ts'
+import type { Mode } from './types.ts'
+
+export type NavAction = 'next' | 'prev' | 'toggle'
+
+const NEXT_KEYS = new Set(['ArrowRight', ' ', 'PageDown'])
+const PREV_KEYS = new Set(['ArrowLeft', 'PageUp'])
+const INTERACTIVE =
+  'button, a[href], input, select, textarea, summary, [contenteditable=""], [contenteditable="true"], ' +
+  '[role="button"], [role="link"], [role="textbox"], [role="slider"], [role="tab"]'
+
+export function clampIndex(index: number, count: number): number {
+  return Math.max(0, Math.min(index, Math.max(0, count - 1)))
+}
+
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE) !== null
+}
+
+export interface KeyLike {
+  key: string
+  ctrlKey?: boolean
+  metaKey?: boolean
+  altKey?: boolean
+  target?: EventTarget | null
+}
+
+export function actionForKey(event: KeyLike): NavAction | null {
+  if (event.ctrlKey || event.metaKey || event.altKey) return null
+  if (isInteractiveTarget(event.target ?? null)) return null
+  if (NEXT_KEYS.has(event.key)) return 'next'
+  if (PREV_KEYS.has(event.key)) return 'prev'
+  if (event.key === 'p' || event.key === 'P') return 'toggle'
+  return null
+}
+
+export function swipeAction(dx: number, dy: number): 'next' | 'prev' | null {
+  if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) <= Math.abs(dy)) return null
+  return dx < 0 ? 'next' : 'prev'
+}
+
+export function usePresentationNav(count: number, initialMode: Mode = 'browse') {
+  const [rawIndex, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const index = clampIndex(rawIndex, count)
+
+  const goTo = useCallback((i: number) => setIndex(clampIndex(i, count)), [count])
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, count)), [count])
+  const toggleMode = useCallback(
+    () => setMode((m) => (m === 'browse' ? 'present' : 'browse')),
+    [],
+  )
+
+  useEffect(() => {
+    const run = (action: NavAction | null) => {
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else if (action === 'toggle') toggleMode()
+    }
+    const onKey = (event: KeyboardEvent) => {
+      const action = actionForKey(event)
+      if (action && action !== 'toggle') event.preventDefault()
+      run(action)
+    }
+    let start: { x: number; y: number } | null = null
+    const onStart = (event: TouchEvent) => {
+      const t = event.changedTouches[0]
+      start = t ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onEnd = (event: TouchEvent) => {
+      const t = event.changedTouches[0]
+      if (!start || !t) return
+      run(swipeAction(t.clientX - start.x, t.clientY - start.y))
+      start = null
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onStart, { passive: true })
+    window.addEventListener('touchend', onEnd, { passive: true })
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onStart)
+      window.removeEventListener('touchend', onEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, goTo, next, prev, toggleMode }
+}
