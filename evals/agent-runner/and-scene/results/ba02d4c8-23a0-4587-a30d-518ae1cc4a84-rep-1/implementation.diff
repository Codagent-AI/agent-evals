+++ b/src/presentation-kit/__tests__/layout.test.ts
@@ -0,0 +1,68 @@
+import { describe, expect, it } from 'vitest'
+import {
+  DESIGN_H,
+  DESIGN_W,
+  ENTER_DELAY,
+  LAYOUT_T,
+  MIN_SCALE,
+  SETTLE_MS,
+  STAGE_LAYOUT,
+} from '../constants.ts'
+import { computeScale } from '../useFitScale.ts'
+import { buildSections, formatMarker, sceneKey } from '../sections.ts'
+
+describe('fixed canvas', () => {
+  it('defaults to 880 × 380 with browse and present geometry', () => {
+    expect(DESIGN_W).toBe(880)
+    expect(DESIGN_H).toBe(380)
+    expect(Object.keys(STAGE_LAYOUT).sort()).toEqual(['browse', 'present'])
+  })
+
+  it('lets newcomers wait for layout morphs and settles after every transition', () => {
+    expect(ENTER_DELAY).toBeGreaterThanOrEqual(LAYOUT_T)
+    expect(SETTLE_MS).toBeGreaterThan((ENTER_DELAY + 0.5) * 1000)
+  })
+})
+
+describe('computeScale', () => {
+  it('fits the canvas uniformly in both modes', () => {
+    for (const mode of ['browse', 'present'] as const) {
+      const { padX, padY } = STAGE_LAYOUT[mode]
+      const wide = computeScale(1760 + 2 * padX, 2000, mode)
+      expect(wide).toBeCloseTo(2)
+      expect(wide * DESIGN_W).toBeLessThanOrEqual(1760 + 0.001)
+      const tall = computeScale(4000, 190 + 2 * padY, mode)
+      expect(tall).toBeCloseTo(0.5)
+      expect(tall * DESIGN_H).toBeLessThanOrEqual(190 + 0.001)
+    }
+  })
+
+  it('never drops below MIN_SCALE and has no upper cap', () => {
+    expect(computeScale(0, 0, 'browse')).toBe(MIN_SCALE)
+    expect(computeScale(10000, 10000, 'present')).toBeGreaterThan(5)
+  })
+})
+
+describe('sections and identity', () => {
+  it('groups consecutive steps sharing an era into one section', () => {
+    const steps = [{ era: 'a' }, { era: 'a' }, { era: 'b' }, { era: 'a' }]
+    expect(buildSections(steps)).toEqual([
+      { era: 'a', firstIndex: 0, lastIndex: 1 },
+      { era: 'b', firstIndex: 2, lastIndex: 2 },
+      { era: 'a', firstIndex: 3, lastIndex: 3 },
+    ])
+  })
+
+  it('derives markers from position', () => {
+    expect(formatMarker(0)).toBe('01')
+    expect(formatMarker(11)).toBe('12')
+  })
+
+  it('shares a scene key across a group with one Scene and separates other steps', () => {
+    const A = () => null
+    const B = () => null
+    expect(sceneKey({ id: 'a', groupKey: 'g', Scene: A })).toBe(sceneKey({ id: 'b', groupKey: 'g', Scene: A }))
+    expect(sceneKey({ id: 'a', groupKey: 'g', Scene: A })).not.toBe(sceneKey({ id: 'b', groupKey: 'g', Scene: B }))
+    expect(sceneKey({ id: 'a', Scene: A })).not.toBe(sceneKey({ id: 'b', Scene: A }))
+  })
+})
diff --git a/src/presentation-kit/__tests__/nav.test.tsx b/src/presentation-kit/__tests__/nav.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..7c63bf63cfef9abab3dca9cae057bad662bafd9f
--- /dev/null
+++ b/src/presentation-kit/__tests__/nav.test.tsx
@@ -0,0 +1,110 @@
+import { act, fireEvent, renderHook } from '@testing-library/react'
+import { describe, expect, it } from 'vitest'
+import { actionForKey, clampIndex, swipeAction, usePresentationNav } from '../usePresentationNav.ts'
+
+describe('actionForKey', () => {
+  it.each([
+    ['ArrowRight', 'next'],
+    [' ', 'next'],
+    ['PageDown', 'next'],
+    ['ArrowLeft', 'prev'],
+    ['PageUp', 'prev'],
+    ['p', 'toggle'],
+    ['P', 'toggle'],
+  ])('maps %j to %s', (key, action) => {
+    expect(actionForKey({ key })).toBe(action)
+  })
+
+  it('ignores unrelated keys and modified keys', () => {
+    expect(actionForKey({ key: 'a' })).toBeNull()
+    expect(actionForKey({ key: 'ArrowRight', ctrlKey: true })).toBeNull()
+    expect(actionForKey({ key: 'p', metaKey: true })).toBeNull()
+  })
+
+  it('leaves keys to focused interactive controls', () => {
+    for (const tag of ['button', 'input', 'select', 'textarea']) {
+      const el = document.createElement(tag)
+      expect(actionForKey({ key: ' ', target: el })).toBeNull()
+      expect(actionForKey({ key: 'ArrowRight', target: el })).toBeNull()
+    }
+    const link = document.createElement('a')
+    link.href = '/x'
+    expect(actionForKey({ key: ' ', target: link })).toBeNull()
+    const inner = document.createElement('span')
+    const button = document.createElement('button')
+    button.append(inner)
+    expect(actionForKey({ key: ' ', target: inner })).toBeNull()
+    expect(actionForKey({ key: ' ', target: document.createElement('div') })).toBe('next')
+  })
+})
+
+describe('swipeAction', () => {
+  it('swipes left to advance and right to go back', () => {
+    expect(swipeAction(-80, 5)).toBe('next')
+    expect(swipeAction(80, -5)).toBe('prev')
+  })
+
+  it('ignores short or mostly vertical movement', () => {
+    expect(swipeAction(-20, 0)).toBeNull()
+    expect(swipeAction(-60, 90)).toBeNull()
+  })
+})
+
+describe('clampIndex', () => {
+  it('clamps at both ends without wrapping', () => {
+    expect(clampIndex(-1, 5)).toBe(0)
+    expect(clampIndex(5, 5)).toBe(4)
+    expect(clampIndex(2, 5)).toBe(2)
+    expect(clampIndex(3, 0)).toBe(0)
+  })
+})
+
+describe('usePresentationNav', () => {
+  it('clamps at the first and last step', () => {
+    const { result } = renderHook(() => usePresentationNav(3))
+    act(() => result.current.prev())
+    expect(result.current.index).toBe(0)
+    act(() => result.current.next())
+    act(() => result.current.next())
+    act(() => result.current.next())
+    expect(result.current.index).toBe(2)
+  })
+
+  it('responds to keyboard and touch input, one step at a time', () => {
+    const { result } = renderHook(() => usePresentationNav(5))
+    fireEvent.keyDown(window, { key: 'ArrowRight' })
+    fireEvent.keyDown(window, { key: ' ' })
+    fireEvent.keyDown(window, { key: 'PageDown' })
+    expect(result.current.index).toBe(3)
+    fireEvent.keyDown(window, { key: 'ArrowLeft' })
+    fireEvent.keyDown(window, { key: 'PageUp' })
+    expect(result.current.index).toBe(1)
+    fireEvent.touchStart(window, { changedTouches: [{ clientX: 300, clientY: 100 }] })
+    fireEvent.touchEnd(window, { changedTouches: [{ clientX: 100, clientY: 110 }] })
+    expect(result.current.index).toBe(2)
+    fireEvent.touchStart(window, { changedTouches: [{ clientX: 100, clientY: 100 }] })
+    fireEvent.touchEnd(window, { changedTouches: [{ clientX: 300, clientY: 100 }] })
+    expect(result.current.index).toBe(1)
+  })
+
+  it('does not advance when a focused control receives the key', () => {
+    const { result } = renderHook(() => usePresentationNav(5))
+    const button = document.createElement('button')
+    document.body.append(button)
+    fireEvent.keyDown(button, { key: ' ' })
+    expect(result.current.index).toBe(0)
+    button.remove()
+  })
+
+  it('toggles mode with P while keeping the current step', () => {
+    const { result } = renderHook(() => usePresentationNav(5, 'present'))
+    fireEvent.keyDown(window, { key: 'ArrowRight' })
+    expect(result.current.mode).toBe('present')
+    fireEvent.keyDown(window, { key: 'p' })
+    expect(result.current.mode).toBe('browse')
+    expect(result.current.index).toBe(1)
+    fireEvent.keyDown(window, { key: 'P' })
+    expect(result.current.mode).toBe('present')
+    expect(result.current.index).toBe(1)
+  })
+})
