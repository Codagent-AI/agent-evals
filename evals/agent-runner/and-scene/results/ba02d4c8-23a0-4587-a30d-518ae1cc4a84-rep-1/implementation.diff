diff --git a/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..20773a159a5ec91c8264c9492b7fcd65899183e6
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
@@ -0,0 +1,157 @@
+#!/usr/bin/env node
+// Captures settled per-step screenshots from a production preview and prints advisory visual warnings.
+// Usage: npm run inspect -- <slug> [--narrow] [--settle <ms>] [--out <dir>] [--no-build]
+import { mkdir } from 'node:fs/promises'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { launchChromium, runCommand, startPreview } from './lib/preview.mjs'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const DESKTOP = { width: 1440, height: 900 }
+const NARROW = { width: 390, height: 844 }
+const DEFAULT_SETTLE_MS = 1800
+
+function parseArgs(argv) {
+  const options = { slug: undefined, narrow: false, settle: DEFAULT_SETTLE_MS, out: undefined, build: true }
+  for (let i = 0; i < argv.length; i++) {
+    const arg = argv[i]
+    if (arg === '--narrow') options.narrow = true
+    else if (arg === '--no-build') options.build = false
+    else if (arg === '--settle') options.settle = Number(argv[++i])
+    else if (arg === '--out') options.out = argv[++i]
+    else if (!arg.startsWith('--') && !options.slug) options.slug = arg
+  }
+  return options
+}
+
+/** Runs in the page: returns advisory warnings for the currently shown step. */
+function diagnose() {
+  const warnings = []
+  const visible = (el) => {
+    const style = getComputedStyle(el)
+    const rect = el.getBoundingClientRect()
+    return style.visibility !== 'hidden' && style.display !== 'none' && Number(style.opacity) > 0.05 && rect.width > 0 && rect.height > 0
+  }
+  const describe = (el, text) => {
+    const hook = [...el.attributes].find((a) => a.name.startsWith('data-presentation-') && a.name !== 'data-presentation-chrome')
+    const id = el.getAttribute('data-presentation-id') ?? (hook ? hook.name : el.tagName.toLowerCase())
+    return text ? `"${text.slice(0, 30)}" <${id}>` : `<${id}>`
+  }
+
+  // Candidates: text-bearing elements (tight text rects) and chrome items without text (progress dots).
+  const candidates = []
+  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT)
+  const seen = new Set()
+  for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+    const text = node.textContent.trim()
+    const el = node.parentElement
+    if (!text || !el || seen.has(el) || ['SCRIPT', 'STYLE'].includes(el.tagName) || !visible(el)) continue
+    seen.add(el)
+    const range = document.createRange()
+    range.selectNodeContents(node)
+    const rect = range.getBoundingClientRect()
+    if (rect.width > 0 && rect.height > 0) candidates.push({ el, rect, text })
+  }
+  for (const el of document.querySelectorAll('[data-presentation-chrome-item]')) {
+    if (visible(el) && !seen.has(el)) candidates.push({ el, rect: el.getBoundingClientRect(), text: '' })
+  }
+
+  const exempt = (el) => el.closest('[data-presentation-allow-overlap]') !== null
+  for (let i = 0; i < candidates.length; i++) {
+    for (let j = i + 1; j < candidates.length; j++) {
+      const a = candidates[i]
+      const b = candidates[j]
+      if (a.el.contains(b.el) || b.el.contains(a.el) || exempt(a.el) || exempt(b.el)) continue
+      const w = Math.min(a.rect.right, b.rect.right) - Math.max(a.rect.left, b.rect.left)
+      const h = Math.min(a.rect.bottom, b.rect.bottom) - Math.max(a.rect.top, b.rect.top)
+      if (w > 1 && h > 1) warnings.push(`overlap: ${describe(a.el, a.text)} overlaps ${describe(b.el, b.text)}`)
+    }
+  }
+
+  const props = ['color', 'backgroundColor', 'borderTopColor', 'borderBottomColor', 'opacity', 'fontWeight', 'boxShadow', 'outlineStyle', 'textDecorationLine', 'width', 'height']
+  const chrome = [
+    ['progress indicator', '[data-presentation-progress-item]'],
+    ['table-of-contents entry', '[data-presentation-toc-item]'],
+  ]
+  for (const [label, selector] of chrome) {
+    const items = [...document.querySelectorAll(selector)].filter(visible)
+    const active = items.find((el) => el.hasAttribute('data-presentation-active'))
+    const inactive = items.find((el) => !el.hasAttribute('data-presentation-active'))
+    if (!active || !inactive) continue
+    const a = getComputedStyle(active)
+    const b = getComputedStyle(inactive)
+    if (props.every((p) => a[p] === b[p])) {
+      warnings.push(`indistinct active chrome: the active ${label} looks the same as inactive ones; style [data-presentation-active]`)
+    }
+  }
+
+  const attribution = document.querySelector('[data-presentation-attribution]')
+  if (!attribution) {
+    warnings.push('attribution: no [data-presentation-attribution] link found; keep the default attribution and style that hook')
+  } else {
+    const a = getComputedStyle(attribution)
+    const body = getComputedStyle(document.body)
+    const size = parseFloat(a.fontSize)
+    const browserDefault = a.color === 'rgb(0, 0, 238)' && a.textDecorationLine.includes('underline')
+    const bodyLook = a.fontFamily === body.fontFamily && a.fontSize === body.fontSize
+    if (size < 11 || browserDefault || bodyLook) {
+      warnings.push(
+        `attribution: the link looks too small or browser-default (${a.fontSize}, ${a.color}); style the [data-presentation-attribution] hook`,
+      )
+    }
+  }
+  return warnings
+}
+
+async function main() {
+  const options = parseArgs(process.argv.slice(2))
+  if (!options.slug) {
+    console.error('usage: npm run inspect -- <slug> [--narrow] [--settle <ms>] [--out <dir>] [--no-build]')
+    process.exit(2)
+  }
+  if (options.build) {
+    const { code, output } = await runCommand('npm', ['run', 'build'], root)
+    if (code !== 0) {
+      console.error(output)
+      process.exit(1)
+    }
+  }
+  const outDir = path.resolve(root, options.out ?? path.join('inspection-output', options.narrow ? `${options.slug}-narrow` : options.slug))
+  await mkdir(outDir, { recursive: true })
+
+  const preview = await startPreview(root)
+  let browser
+  let warningCount = 0
+  try {
+    browser = await launchChromium(root)
+    const page = await browser.newPage({ viewport: options.narrow ? NARROW : DESKTOP })
+    await page.goto(`${preview.url}/${options.slug}`, { waitUntil: 'networkidle' })
+    await page.waitForSelector('[data-presentation-step-count]', { timeout: 10000 })
+    const count = Number(await page.getAttribute('[data-presentation-step-count]', 'data-presentation-step-count'))
+    for (let i = 0; i < count; i++) {
+      if (i > 0) {
+        await page.keyboard.press('ArrowRight')
+        await page.waitForFunction(
+          (n) => document.querySelector('[data-presentation-step-index]')?.getAttribute('data-presentation-step-index') === String(n),
+          i,
+        )
+      }
+      await page.waitForTimeout(options.settle)
+      const file = path.join(outDir, `step-${String(i + 1).padStart(2, '0')}.png`)
+      await page.screenshot({ path: file })
+      for (const warning of await page.evaluate(diagnose)) {
+        warningCount++
+        console.log(`WARN step ${i + 1} ${warning}`)
+      }
+    }
+    console.log(`captured ${count} screenshots in ${path.relative(root, outDir)} (${warningCount} advisory warnings)`)
+  } finally {
+    await browser?.close()
+    preview.stop()
+  }
+}
+
+main().catch((error) => {
+  console.error(error)
+  process.exit(1)
+})
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/preview.mjs b/skills/presentation/templates/bootstrap/scripts/lib/preview.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e5e2c16f632cc1b42b56e3f4926e329e0df2a0f2
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/preview.mjs
@@ -0,0 +1,74 @@
+import { spawn } from 'node:child_process'
+import net from 'node:net'
+import { createRequire } from 'node:module'
+import path from 'node:path'
+
+/** Verification and inspection always use the IPv4 loopback address, never a hostname that may resolve to IPv6. */
+export const HOST = '127.0.0.1'
+
+export function freePort() {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer()
+    server.once('error', reject)
+    server.listen(0, HOST, () => {
+      const { port } = server.address()
+      server.close(() => resolve(port))
+    })
+  })
+}
+
+export function runCommand(cmd, args, cwd) {
+  return new Promise((resolve) => {
+    const child = spawn(cmd, args, { cwd, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (d) => (output += d))
+    child.stderr.on('data', (d) => (output += d))
+    child.on('error', (error) => resolve({ code: 1, output: String(error) }))
+    child.on('close', (code) => resolve({ code: code ?? 1, output }))
+  })
+}
+
+async function waitUntilReady(url, timeoutMs) {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    try {
+      const response = await fetch(url)
+      if (response.ok) return
+    } catch {
+      // not listening yet
+    }
+    await new Promise((r) => setTimeout(r, 150))
+  }
+  throw new Error(`preview did not become ready at ${url}`)
+}
+
+/** Starts `vite preview` on 127.0.0.1 in its own process group; `stop()` kills the whole group. */
+export async function startPreview(cwd) {
+  const port = await freePort()
+  const viteBin = path.join(cwd, 'node_modules', 'vite', 'bin', 'vite.js')
+  const child = spawn(
+    process.execPath,
+    [viteBin, 'preview', '--host', HOST, '--port', String(port), '--strictPort'],
+    { cwd, stdio: 'ignore', detached: true },
+  )
+  const url = `http://${HOST}:${port}`
+  const stop = () => {
+    try {
+      process.kill(-child.pid, 'SIGKILL')
+    } catch {
+      // already gone
+    }
+  }
+  try {
+    await waitUntilReady(`${url}/`, 20000)
+  } catch (error) {
+    stop()
+    throw error
+  }
+  return { url, stop }
+}
+
+export async function launchChromium(cwd) {
+  const { chromium } = createRequire(path.join(cwd, 'package.json'))('playwright')
+  return chromium.launch()
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/verify.mjs b/skills/presentation/templates/bootstrap/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..2fd98afdf4706886f35b1d93bbe05471d6dd2f72
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/verify.mjs
@@ -0,0 +1,145 @@
+#!/usr/bin/env node
+// Deterministic gate: whole-app build, then a real-browser render of every step of every registered
+// presentation, plus the reference outline from verify.config.json when one is configured.
+import { readFile } from 'node:fs/promises'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { HOST, launchChromium, runCommand, startPreview } from './lib/preview.mjs'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const STEP_TIMEOUT_MS = 5000
+// Longer than the kit's slowest entry (newcomers start after 0.6 s and fade in over 0.5 s), so errors raised
+// while a step animates in are attributed to that step.
+const SETTLE_MS = 1400
+const failures = []
+let currentSlug
+
+const fail = (phase, message, step) => {
+  failures.push({ phase, message, step })
+  console.error(`FAIL [${phase}]${currentSlug ? ` /${currentSlug}` : ''}${step === undefined ? '' : ` step ${step + 1}`}: ${message}`)
+}
+const normalize = (text) => (text ?? '').replace(/\s+/g, ' ').trim()
+const readIndex = (page) =>
+  page.evaluate(() => {
+    const el = document.querySelector('[data-presentation-step-index]')
+    return el ? Number(el.getAttribute('data-presentation-step-index')) : null
+  })
+
+async function verifyBuild() {
+  console.log('[verify] build: npm run build')
+  const { code, output } = await runCommand('npm', ['run', 'build'], root)
+  if (code !== 0) {
+    console.error(output.trim().split('\n').slice(-25).join('\n'))
+    fail('build', `npm run build exited with code ${code}`)
+    return false
+  }
+  console.log('PASS [build]')
+  return true
+}
+
+/** Steps through one presentation, checking every step renders; compares text when an outline is given. */
+async function tour(page, baseUrl, slug, expected, state) {
+  currentSlug = slug
+  await page.goto(`${baseUrl}/${slug}`, { waitUntil: 'networkidle' })
+  try {
+    await page.waitForSelector('[data-presentation-step-count]', { timeout: STEP_TIMEOUT_MS })
+  } catch {
+    fail('render', `route /${slug} did not render a presentation`, 0)
+    return 0
+  }
+  if ((await page.getAttribute('[data-presentation-root]', 'data-presentation-mode')) !== 'browse') {
+    await page.keyboard.press('p')
+  }
+  const count = Number(await page.getAttribute('[data-presentation-step-count]', 'data-presentation-step-count'))
+  if (expected && count !== expected.length) {
+    fail('sample', `expected ${expected.length} steps, found ${count}`)
+    return count
+  }
+  for (let i = 0; i < count; i++) {
+    state.step = i
+    if (i > 0) {
+      await page.keyboard.press('ArrowRight')
+      try {
+        await page.waitForFunction(
+          (n) => document.querySelector('[data-presentation-step-index]')?.getAttribute('data-presentation-step-index') === String(n),
+          i,
+          { timeout: STEP_TIMEOUT_MS },
+        )
+      } catch {
+        fail('render', `transition did not advance the step index (still ${await readIndex(page)})`, i)
+        return count
+      }
+    }
+    await page.waitForTimeout(SETTLE_MS)
+    console.log(`[verify] /${slug} step ${i + 1}/${count} rendered`)
+    if (expected) {
+      const title = normalize(await page.textContent('[data-presentation-title]'))
+      const caption = normalize(await page.textContent('[data-presentation-caption]').catch(() => null))
+      if (title !== expected[i].title || caption !== expected[i].caption) {
+        fail('sample', `title/caption mismatch: expected "${expected[i].title}" / "${expected[i].caption}", got "${title}" / "${caption}"`, i)
+      }
+    }
+  }
+  return count
+}
+
+async function verifyPresentations(config) {
+  const reference = config.reference
+  const preview = await startPreview(root)
+  let browser
+  try {
+    browser = await launchChromium(root)
+    const page = await browser.newPage()
+    const state = { step: 0 }
+    page.on('console', (message) => {
+      if (message.type() === 'error') fail('render', `console error: ${message.text()}`, state.step)
+    })
+    page.on('pageerror', (error) => fail('render', `uncaught page error: ${error.message}`, state.step))
+
+    console.log(`[verify] preview: ${preview.url}`)
+    await page.goto(`${preview.url}/`, { waitUntil: 'networkidle' })
+    const slugs = await page.$$eval('[data-presentation-link]', (links) => links.map((l) => l.getAttribute('data-presentation-link')))
+    if (reference && !slugs.includes(reference.slug)) {
+      fail('sample', `reference presentation "${reference.slug}" is not registered (no link on the index page)`)
+    }
+    if (!slugs.length) fail('render', 'no presentation is registered')
+    for (const slug of slugs) {
+      currentSlug = undefined
+      const before = failures.length
+      const count = await tour(page, preview.url, slug, slug === reference?.slug ? reference.steps : undefined, state)
+      if (failures.length === before) console.log(`PASS [render] /${slug}: ${count} steps without console or page errors on ${HOST}`)
+    }
+    if (reference && slugs.includes(reference.slug) && !failures.some((f) => f.phase === 'sample')) {
+      console.log(`PASS [sample] ${reference.steps.length} steps match the reference outline`)
+    }
+  } finally {
+    await browser?.close()
+    preview.stop()
+  }
+}
+
+async function main() {
+  let config
+  try {
+    config = JSON.parse(await readFile(path.join(root, 'verify.config.json'), 'utf8'))
+  } catch (error) {
+    fail('config', `cannot read verify.config.json: ${error.message}`)
+    console.error('\nVERIFY FAILED (config)')
+    process.exit(1)
+  }
+  if (await verifyBuild()) {
+    try {
+      await verifyPresentations(config)
+    } catch (error) {
+      fail('render', `verification crashed: ${error.message}`)
+    }
+  }
+  if (failures.length) {
+    const phases = [...new Set(failures.map((f) => f.phase))].join(', ')
+    console.error(`\nVERIFY FAILED (${phases})`)
+    process.exit(1)
+  }
+  console.log('\nVERIFY PASSED')
+}
+
+main()
