+body { min-height: 100vh; }
+.presentation { position: relative; width: 100%; min-height: 100vh; overflow: hidden; }
+.presentation-header { position: absolute; z-index: 2; inset: 0 0 auto; }
+.presentation-header-brand { position: absolute; inset: 1rem auto auto 1rem; }
+.presentation-header-marker { position: absolute; inset: 1rem auto auto 50%; transform: translateX(-50%); }
+.presentation-header-title { position: absolute; inset: 2.75rem 1rem auto; text-align: center; }
+.presentation-stage { position: absolute; inset: 0; display: grid; place-items: center; }
+.presentation-stage-viewport { position: relative; flex: none; }
+.presentation-stage-canvas { position: absolute; inset: 0 auto auto 0; }
+.presentation-scene-host { width: 100%; height: 100%; }
+.presentation-toc { position: absolute; z-index: 2; inset: 50% auto auto 1rem; transform: translateY(-50%); display: flex; flex-direction: column; }
+.presentation-footer { position: absolute; z-index: 2; inset: auto 1rem 1rem; display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
+.presentation-caption { max-width: min(34rem, 45vw); }
+.presentation-caption p { margin: .4rem 0 0; }
+.presentation-progress, .presentation-controls { display: flex; align-items: center; gap: .5rem; }
+.presentation-mode-toggle { position: absolute; z-index: 3; inset: 1rem 1rem auto auto; }
+.scene-layer { pointer-events: none; }
+.scene-layer > * { pointer-events: auto; }
