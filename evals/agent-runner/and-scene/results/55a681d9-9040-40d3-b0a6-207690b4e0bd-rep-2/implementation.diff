@@ -0,0 +1,23 @@
+import type { ReactNode } from 'react'
+import type { PresentationMode } from '../constants'
+import { stepMarker } from '../steps'
+
+export interface HeaderProps {
+  index: number
+  count: number
+  /** Active step's one-line title, shown here in browse mode. */
+  title: string
+  mode: PresentationMode
+  /** Host-provided brand for the top-left slot. The kit adds none by default. */
+  brand?: ReactNode
+}
+
+export function Header({ index, count, title, mode, brand }: HeaderProps) {
+  return (
+    <header data-presentation-header="" style={{ display: 'flex', alignItems: 'center' }}>
+      {brand ? <div data-presentation-brand="">{brand}</div> : null}
+      <span data-presentation-marker="">{stepMarker(index, count)}</span>
+      {mode === 'browse' ? <h1 data-presentation-title="">{title}</h1> : null}
+    </header>
+  )
+}
diff --git a/src/presentation-kit/chrome/Toc.tsx b/src/presentation-kit/chrome/Toc.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d67b6935202628983be069ec8025b46d36d31a55
--- /dev/null
+++ b/src/presentation-kit/chrome/Toc.tsx
@@ -0,0 +1,34 @@
+import { eraGroups } from '../steps'
+import type { StepMeta } from '../types'
+
+export interface TocProps {
+  steps: readonly StepMeta[]
+  index: number
+  onJump: (index: number) => void
+}
+
+/** Era-based table of contents; each entry jumps to the first step of its era. */
+export function Toc({ steps, index, onJump }: TocProps) {
+  return (
+    <nav data-presentation-toc="" aria-label="Table of contents">
+      <ol>
+        {eraGroups(steps).map((group) => {
+          const active = index >= group.firstIndex && index <= group.lastIndex
+          return (
+            <li key={group.firstIndex}>
+              <button
+                type="button"
+                data-presentation-toc-entry=""
+                data-presentation-active={active ? '' : undefined}
+                aria-current={active ? 'step' : undefined}
+                onClick={() => onJump(group.firstIndex)}
+              >
+                {group.era}
+              </button>
+            </li>
+          )
+        })}
+      </ol>
+    </nav>
+  )
+}
