@@ -0,0 +1,78 @@
+/**
+ * Canonical nine-step outline of the committed sample, written out independently of
+ * the sample's own data. Titles and captions are normative.
+ */
+export const SAMPLE_SLUG = 'how-to-make-a-presentation'
+
+export const EXPECTED_OUTLINE = [
+  ['the ask', 'You have a topic', 'It starts with you, a topic, and mild overconfidence.'],
+  [
+    'the ask',
+    'The skill interviews you',
+    'One question at a time: the topic, the look, then each beat of the story.',
+  ],
+  [
+    'the gathering',
+    'Answers become steps',
+    'Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next.',
+  ],
+  [
+    'the gathering',
+    'The deck grows',
+    'Same shapes, new beats. Every answer extends the story without redrawing it.',
+  ],
+  [
+    'the gathering',
+    'You set the depth',
+    'Spell out every step, or sketch a few and see how it looks. You hold the gate.',
+  ],
+  [
+    'the build',
+    'It assembles the scene',
+    'Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph.',
+  ],
+  [
+    'the build',
+    'It checks its own work',
+    'Before saying done, it builds and renders every step — and fixes what breaks.',
+  ],
+  [
+    'the loop',
+    'Changed your mind? Loop it.',
+    'Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch.',
+  ],
+  [
+    'the reveal',
+    "You're looking at one",
+    'This presentation was built exactly this way. Thanks for watching.',
+  ],
+].map(([era, title, caption]) => ({ era, title, caption }))
+
+/**
+ * Compares a registry and an outline against the canonical sample.
+ * Returns a list of problems; an empty list means the sample matches.
+ */
+export function checkSample({ registry, outline, expected = EXPECTED_OUTLINE, slug = SAMPLE_SLUG }) {
+  const problems = []
+  if (!Array.isArray(registry) || !registry.some((entry) => entry?.slug === slug)) {
+    problems.push(`sample "${slug}" is not registered`)
+  }
+  if (!Array.isArray(outline)) {
+    problems.push('sample outline is missing')
+    return problems
+  }
+  if (outline.length !== expected.length) {
+    problems.push(`sample has ${outline.length} steps, expected ${expected.length}`)
+  }
+  expected.forEach((want, index) => {
+    const got = outline[index]
+    for (const field of ['era', 'title', 'caption']) {
+      if (got?.[field] !== want[field]) {
+        problems.push(
+          `step ${index + 1} ${field}: expected ${JSON.stringify(want[field])}, found ${JSON.stringify(got?.[field])}`,
+        )
+      }
+    }
+  })
+  return problems
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/verify.mjs b/skills/presentation/templates/bootstrap/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a68b74c737b50e7b59ba8cb0587f28663d09147e
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/verify.mjs
@@ -0,0 +1,167 @@
+#!/usr/bin/env node
+// Build + browser-render verification. Exit 0 only when every phase passes.
+import { spawn } from 'node:child_process'
+import { existsSync, readFileSync } from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+import { chromium } from 'playwright'
+import { HOST, startPreview } from './preview.mjs'
+import { attachErrorCollectors, VerifyFailure, waitForStepIndex } from './verify-lib.mjs'
+import { checkSample, EXPECTED_OUTLINE } from './verify-outline.mjs'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const STEP_TIMEOUT_MS = Number(process.env.VERIFY_STEP_TIMEOUT_MS ?? 5000)
+const SETTLE_MS = Number(process.env.VERIFY_SETTLE_MS ?? 250)
+
+function run(command, args) {
+  return new Promise((resolve) => {
+    const child = spawn(command, args, { cwd: root, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (chunk) => (output += chunk))
+    child.stderr.on('data', (chunk) => (output += chunk))
+    child.on('error', (error) => resolve({ code: 1, output: String(error) }))
+    child.on('close', (code) => resolve({ code, output }))
+  })
+}
+
+async function buildPhase() {
+  const { code, output } = await run('npm', ['run', 'build'])
+  if (code !== 0) throw new VerifyFailure('build', `npm run build failed\n${output.trim()}`)
+}
+
+function readConfig() {
+  const pkg = JSON.parse(readFileSync(path.join(root, 'package.json'), 'utf8'))
+  return { sample: pkg.andScene?.sample }
+}
+
+async function loadRegistry() {
+  const file = path.join(root, 'src', 'presentations', 'index.ts')
+  if (!existsSync(file)) throw new VerifyFailure('sample', 'src/presentations/index.ts is missing')
+  try {
+    return (await import(pathToFileURL(file).href)).PRESENTATIONS
+  } catch (error) {
+    throw new VerifyFailure('sample', `presentation registry cannot be read: ${error.message}`)
+  }
+}
+
+/** Confirms the registry (and, when a canonical sample is configured, its outline). */
+async function samplePhase(sample) {
+  const registry = await loadRegistry()
+  if (!sample) {
+    if (!Array.isArray(registry) || registry.length === 0) {
+      throw new VerifyFailure('sample', 'no presentations are registered in src/presentations/index.ts')
+    }
+    return registry.map((entry) => entry.slug)
+  }
+  let outline
+  const outlineFile = path.join(root, 'src', 'presentations', sample, 'outline.ts')
+  if (existsSync(outlineFile)) {
+    try {
+      outline = (await import(pathToFileURL(outlineFile).href)).OUTLINE
+    } catch (error) {
+      throw new VerifyFailure('sample', `sample outline cannot be read: ${error.message}`)
+    }
+  }
+  const problems = checkSample({ registry, outline, slug: sample })
+  if (problems.length) throw new VerifyFailure('sample', problems.join('\n'))
+  // The canonical sample is checked against its outline; every other registered presentation still renders.
+  return registry.map((entry) => entry.slug)
+}
+
+async function renderPresentation(browser, origin, slug, expected) {
+  const page = await browser.newPage()
+  const failures = []
+  let current = 0
+  const fail = (message) => failures.push({ step: current, message })
+  attachErrorCollectors(page, { origin, getStep: () => current, record: (step, message) => failures.push({ step, message }) })
+
+  try {
+    await page.goto(`${origin}/${slug}`, { waitUntil: 'load' })
+    try {
+      await page.waitForSelector('[data-step-count]', { timeout: STEP_TIMEOUT_MS })
+    } catch {
+      const detail = failures.map((f) => `\n${f.message}`).join('')
+      throw new VerifyFailure('render', `${slug}: the presentation did not render a step${detail}`, 0)
+    }
+    const count = Number(await page.getAttribute('[data-step-count]', 'data-step-count'))
+    if (expected && count !== expected.length) {
+      throw new VerifyFailure('render', `${slug}: expected ${expected.length} steps, rendered ${count}`, 0)
+    }
+    for (let index = 0; index < count; index += 1) {
+      current = index
+      if (index > 0) await page.keyboard.press('ArrowRight')
+      try {
+        await waitForStepIndex(page, index, STEP_TIMEOUT_MS, slug)
+      } catch (error) {
+        // A stalled step is often caused by an earlier fault; report both.
+        if (error instanceof VerifyFailure && failures.length) {
+          error.message += `\n${failures.map((f) => `step index ${f.step}: ${f.message}`).join('\n')}`
+        }
+        throw error
+      }
+      if (expected) {
+        const title = await page.textContent('[data-presentation-title]')
+        const caption = await page.textContent('[data-presentation-caption]')
+        const era = await page.textContent('[data-presentation-toc-entry][data-presentation-active]')
+        if (era !== expected[index].era) fail(`era is ${JSON.stringify(era)}, expected ${JSON.stringify(expected[index].era)}`)
+        if (title !== expected[index].title) fail(`title is ${JSON.stringify(title)}, expected ${JSON.stringify(expected[index].title)}`)
+        if (caption !== expected[index].caption) fail(`caption is ${JSON.stringify(caption)}, expected ${JSON.stringify(expected[index].caption)}`)
+      }
+      await page.waitForTimeout(SETTLE_MS)
+    }
+    if (failures.length) {
+      const first = failures[0]
+      const detail = failures.map((f) => `step index ${f.step}: ${f.message}`).join('\n')
+      throw new VerifyFailure('render', `${slug}: ${failures.length} error(s)\n${detail}`, first.step)
+    }
+    return count
+  } finally {
+    await page.close()
+  }
+}
+
+async function renderPhase(slugs, sample) {
+  const preview = await startPreview(root)
+  let browser
+  try {
+    browser = await chromium.launch()
+    const counts = []
+    for (const slug of slugs) {
+      counts.push(`${slug}: ${await renderPresentation(browser, preview.origin, slug, slug === sample ? EXPECTED_OUTLINE : null)} steps`)
+    }
+    console.log(`render: ${counts.join(', ')} (${preview.origin})`)
+  } catch (error) {
+    if (error instanceof VerifyFailure) throw error
+    throw new VerifyFailure('render', `browser run failed: ${error.message}`)
+  } finally {
+    await browser?.close()
+    await preview.stop()
+  }
+}
+
+async function main() {
+  const { sample } = readConfig()
+  const phases = []
+  try {
+    console.log('verify: build')
+    await buildPhase()
+    phases.push('build')
+    console.log('verify: sample')
+    const slugs = await samplePhase(sample)
+    phases.push('sample')
+    console.log(`verify: render (${HOST})`)
+    await renderPhase(slugs, sample)
+    phases.push('render')
+  } catch (error) {
+    if (error instanceof VerifyFailure) {
+      const where = error.step === undefined ? '' : ` (step index ${error.step})`
+      console.error(`FAIL verify: ${error.phase} phase failed${where}\n${error.message}`)
+    } else {
+      console.error(`FAIL verify: unexpected error\n${error.stack ?? error}`)
+    }
+    process.exit(1)
+  }
+  console.log(`PASS verify: ${phases.join(', ')}`)
+}
+
+await main()
