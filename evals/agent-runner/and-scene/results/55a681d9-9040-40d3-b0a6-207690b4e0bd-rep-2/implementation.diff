new file mode 100644
index 0000000000000000000000000000000000000000..a47344dfaf6f1fe4720fe2c2c72c5d28f313f30e
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,33 @@
+import { useLayoutEffect, useState } from 'react'
+import type { RefObject } from 'react'
+import { computeFitScale } from './fit'
+import type { PresentationMode } from './constants'
+import { MIN_SCALE } from './constants'
+
+/** Tracks the element's box and returns the uniform canvas scale for the mode. */
+export function useFitScale(
+  ref: RefObject<HTMLElement | null>,
+  mode: PresentationMode,
+): number {
+  const [scale, setScale] = useState(MIN_SCALE)
+
+  useLayoutEffect(() => {
+    const element = ref.current
+    if (!element) return
+    const measure = () => {
+      const { width, height } = element.getBoundingClientRect()
+      setScale(computeFitScale(width, height, mode))
+    }
+    measure()
+    window.addEventListener('resize', measure)
+    const observer =
+      typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(measure)
+    observer?.observe(element)
+    return () => {
+      window.removeEventListener('resize', measure)
+      observer?.disconnect()
+    }
+  }, [ref, mode])
+
+  return scale
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b62769e17656db211a0edc9d3bc9c87d8accf6a6
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,85 @@
+import { useCallback, useEffect, useState } from 'react'
+import { SWIPE_MIN_PX } from './constants'
+import type { PresentationMode } from './constants'
+
+const INTERACTIVE =
+  'button, a, input, select, textarea, summary, [contenteditable]:not([contenteditable="false"]), [role="button"], [role="link"], [role="tab"]'
+
+const NEXT_KEYS = new Set(['ArrowRight', ' ', 'PageDown'])
+const PREV_KEYS = new Set(['ArrowLeft', 'PageUp'])
+
+function isInteractive(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE) !== null
+}
+
+export interface PresentationNav {
+  index: number
+  mode: PresentationMode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  toggleMode: () => void
+}
+
+/** Step index + mode state with keyboard and swipe input. Navigation clamps at both ends. */
+export function usePresentationNav(
+  count: number,
+  initialMode: PresentationMode,
+): PresentationNav {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState(initialMode)
+  const last = Math.max(0, count - 1)
+
+  const goTo = useCallback(
+    (target: number) => setIndex(Math.min(last, Math.max(0, target))),
+    [last],
+  )
+  // Both steps start from the clamped index: the step list can shrink under the stored one.
+  const next = useCallback(() => setIndex((i) => Math.min(last, Math.min(i, last) + 1)), [last])
+  const prev = useCallback(() => setIndex((i) => Math.max(0, Math.min(i, last) - 1)), [last])
+  const toggleMode = useCallback(
+    () => setMode((m) => (m === 'present' ? 'browse' : 'present')),
+    [],
+  )
+
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.ctrlKey || event.metaKey || event.altKey) return
+      if (isInteractive(event.target)) return
+      if (NEXT_KEYS.has(event.key)) next()
+      else if (PREV_KEYS.has(event.key)) prev()
+      else if (event.key === 'p' || event.key === 'P') toggleMode()
+      else return
+      event.preventDefault()
+    }
+
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (event: TouchEvent) => {
+      const touch = event.touches[0]
+      start = touch && !isInteractive(event.target) ? { x: touch.clientX, y: touch.clientY } : null
+    }
+    const onTouchEnd = (event: TouchEvent) => {
+      const touch = event.changedTouches[0]
+      const origin = start
+      start = null
+      if (!origin || !touch) return
+      const dx = touch.clientX - origin.x
+      const dy = touch.clientY - origin.y
+      if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) <= Math.abs(dy)) return
+      if (dx < 0) next()
+      else prev()
+    }
+
+    window.addEventListener('keydown', onKeyDown)
+    window.addEventListener('touchstart', onTouchStart)
+    window.addEventListener('touchend', onTouchEnd)
+    return () => {
+      window.removeEventListener('keydown', onKeyDown)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  // The step list can shrink under a mounted presentation; never report an index past its end.
+  return { index: Math.min(index, last), mode, next, prev, goTo, toggleMode }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useViewportWidth.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useViewportWidth.ts
