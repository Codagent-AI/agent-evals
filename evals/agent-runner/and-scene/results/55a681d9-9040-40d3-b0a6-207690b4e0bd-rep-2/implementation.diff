+import { act, render } from '@testing-library/react'
+import { readFileSync } from 'node:fs'
+import { resolve } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { Presentation, validateSteps } from '../presentation-kit'
+import { ENTITIES } from '../presentations/how-to-make-a-presentation/entities'
+import { OUTLINE } from '../presentations/how-to-make-a-presentation/outline'
+import { STEPS } from '../presentations/how-to-make-a-presentation/steps'
+import { PRESENTATIONS } from '../presentations'
+
+// Normative rows of presentation-verification, "Committed reference sample", typed out separately from the sample.
+const NORMATIVE = [
+  ['the ask', 'You have a topic', 'It starts with you, a topic, and mild overconfidence.'],
+  ['the ask', 'The skill interviews you', 'One question at a time: the topic, the look, then each beat of the story.'],
+  ['the gathering', 'Answers become steps', 'Each answer lands as a step card — title, caption, visual — plus what morphs from one step into the next.'],
+  ['the gathering', 'The deck grows', 'Same shapes, new beats. Every answer extends the story without redrawing it.'],
+  ['the gathering', 'You set the depth', 'Spell out every step, or sketch a few and see how it looks. You hold the gate.'],
+  ['the build', 'It assembles the scene', 'Your steps are wired into one evolving scene, drawn with a shared scene kit — ready-made boxes, arrows, and motion that make entities morph.'],
+  ['the build', 'It checks its own work', 'Before saying done, it builds and renders every step — and fixes what breaks.'],
+  ['the loop', 'Changed your mind? Loop it.', 'Point at a step and ask. The skill edits the scene in place — nothing is redrawn from scratch.'],
+  ['the reveal', "You're looking at one", 'This presentation was built exactly this way. Thanks for watching.'],
+] as const
+
+const css = readFileSync(resolve(process.cwd(), 'src/presentations/how-to-make-a-presentation/styles.css'), 'utf8')
+
+describe('reference sample data', () => {
+  it('has the nine normative steps in order, character for character', () => {
+    expect(STEPS).toHaveLength(9)
+    expect(STEPS.map((s) => [s.era, s.title, s.caption])).toEqual(NORMATIVE.map((row) => [...row]))
+    expect(OUTLINE.map((s) => [s.era, s.title, s.caption])).toEqual(NORMATIVE.map((row) => [...row]))
+  })
+
+  it('has unique ids and puts all steps in one persistent scene group', () => {
+    expect(() => validateSteps(STEPS)).not.toThrow()
+    expect(new Set(STEPS.map((s) => s.groupKey)).size).toBe(1)
+    expect(new Set(STEPS.map((s) => s.Scene)).size).toBe(1)
+    expect(STEPS.map((s) => s.payload.step)).toEqual([1, 2, 3, 4, 5, 6, 7, 8, 9])
+  })
+
+  it('is registered with the full presentation title, lazily loaded', async () => {
+    const entry = PRESENTATIONS.find((p) => p.slug === 'how-to-make-a-presentation')!
+    expect(entry.title).toBe('How to Use This Skill to Make a Presentation')
+    const module = await entry.load()
+    expect(typeof module.default).toBe('function')
+  })
+})
+
+const root = () => document.querySelector('[data-presentation-root]')!
+const press = (key: string) =>
+  act(() => {
+    window.dispatchEvent(new KeyboardEvent('keydown', { key, bubbles: true }))
+  })
+const ids = () => [...document.querySelectorAll('[data-presentation-entity]')].map((e) => e.getAttribute('data-presentation-entity')!)
+const spec = (id: string) => ENTITIES.find((e) => e.id === id)!
+const rectOf = (id: string) => {
+  const s = spec(id)
+  if (!('at' in s)) throw new Error(`${id} has no rect`)
+  return { x: s.at.x, y: s.at.y, w: s.at.w ?? 0, h: s.at.h ?? 0 }
+}
+
+/** Renders the sample once and records the DOM at each of its nine steps. */
+function walkSample() {
+  render(<Presentation steps={STEPS} title="sample" />)
+  const frames: { ids: string[]; nodes: Map<string, HTMLElement>; geometry: Map<string, string>; text: Map<string, string>; flags: Map<string, string | null> }[] = []
+  for (let step = 0; step < 9; step += 1) {
+    if (step > 0) press('ArrowRight')
+    expect(root().getAttribute('data-step-index')).toBe(String(step))
+    const nodes = new Map<string, HTMLElement>()
+    const geometry = new Map<string, string>()
+    const text = new Map<string, string>()
+    const flags = new Map<string, string | null>()
+    document.querySelectorAll<HTMLElement>('[data-presentation-entity]').forEach((node) => {
+      const id = node.getAttribute('data-presentation-entity')!
+      nodes.set(id, node)
+      geometry.set(id, `${node.style.left}|${node.style.top}|${node.style.width}|${node.style.height}`)
+      text.set(id, node.textContent ?? '')
+      flags.set(id, node.getAttribute('data-presentation-flag'))
+    })
+    frames.push({ ids: ids(), nodes, geometry, text, flags })
+  }
+  return frames
+}
+
+describe('reference sample scene', () => {
+  const frames = walkSample()
+  const at = (step: number) => new Set(frames[step - 1].ids)
+  // Nodes recorded while walking: detached after cleanup, but their attributes and children persist.
+  const node = (step: number, id: string) => frames[step - 1].nodes.get(id)!
+
+  it('accumulates: entity sets only grow and continuing entities keep node, position, and size', () => {
+    for (let i = 1; i < 9; i += 1) {
+      const before = frames[i - 1]
+      const after = frames[i]
+      for (const id of before.ids) {
+        expect(after.ids, `${id} survives step ${i + 1}`).toContain(id)
+        expect(after.nodes.get(id), `${id} keeps its DOM node`).toBe(before.nodes.get(id))
+        expect(after.geometry.get(id), `${id} does not move`).toBe(before.geometry.get(id))
+        expect(after.text.get(id), `${id} is not relabeled`).toBe(before.text.get(id))
+      }
+    }
+    expect(frames[8].ids.length).toBeGreaterThan(frames[0].ids.length)
+  })
+
+  it('1: you and a prompt bubble', () => {
+    expect([...at(1)].sort()).toEqual(['prompt', 'you'])
+    expect(frames[0].text.get('you')).toBe('you')
+    expect(frames[0].text.get('prompt')).toBe('prompt')
+  })
+
+  it('2: skill, a two-way you↔skill arrow, and a question chip above it', () => {
+    expect([...at(2)]).toEqual(expect.arrayContaining(['skill', 'conversation', 'question']))
+    const arrow = spec('conversation')
+    if (arrow.kind !== 'arrow') throw new Error('conversation must be an arrow')
+    expect(arrow.bidirectional).toBe(true)
+    expect(node(2, 'conversation').querySelectorAll('path[marker-start], path[marker-end]')).toHaveLength(1)
+    expect(node(2, 'conversation').querySelector('path[marker-start]')).not.toBeNull()
+    expect(arrow.from[0]).toBeGreaterThanOrEqual(rectOf('you').x + rectOf('you').w)
+    expect(arrow.to[0]).toBeLessThanOrEqual(rectOf('skill').x)
+    expect(rectOf('question').y + rectOf('question').h).toBeLessThanOrEqual(arrow.from[1])
+    expect(frames[1].text.get('question')).toContain('question')
+  })
+
+  it('3: a tray under the conversation with one step card showing title, caption, and visual; morph on links, not in cards', () => {
+    for (const id of ['tray', 'card-1']) expect(at(3).has(id)).toBe(true)
+    expect(at(3).has('card-2')).toBe(false)
+    expect(rectOf('tray').y).toBeGreaterThan(rectOf('prompt').y + rectOf('prompt').h)
+    const parts = [...node(3, 'card-1').querySelectorAll('[data-presentation-part]')].map((p) => p.textContent)
+    expect(parts).toEqual(['step 1', 'title', 'caption', 'visual'])
+    for (let i = 1; i <= 4; i += 1) expect(frames[8].text.get(`card-${i}`)).not.toMatch(/morph/)
+  })
+
+  it('4: more cards land with links labeled morph between them; nothing already on screen moves', () => {
+    for (const id of ['card-2', 'card-3', 'card-4', 'link-1-2', 'link-2-3', 'link-3-4']) expect(at(4).has(id)).toBe(true)
+    for (let i = 1; i <= 3; i += 1) {
+      const left = rectOf(`card-${i}`)
+      const right = rectOf(`card-${i + 1}`)
+      const label = rectOf(`link-${i}-${i + 1}-label`)
+      expect(label.x).toBeGreaterThanOrEqual(left.x + left.w)
+      expect(label.x + label.w).toBeLessThanOrEqual(right.x)
+      expect(frames[3].text.get(`link-${i}-${i + 1}-label`)).toBe('morph')
+    }
+  })
+
+  it('5: a dashed ghost card and a partial↔full control docked beside you', () => {
+    expect(at(5).has('ghost')).toBe(true)
+    expect(node(5, 'ghost').className).toContain('ghost')
+    expect(css).toMatch(/\.ghost\s*\{[^}]*border-style:\s*dashed/)
+    expect(frames[4].text.get('depth')).toBe('partial ↔ full')
+    const you = rectOf('you')
+    const depth = rectOf('depth')
+    expect(depth.x - (you.x + you.w)).toBeLessThan(80)
+    expect(Math.abs(depth.y - (you.y + you.h))).toBeLessThan(40)
+  })
+
+  it('6: the scene-kit socket plugs into the bottom edge of an unframed tray, not into one card', () => {
+    expect(at(6).has('scene-kit')).toBe(true)
+    expect(at(5).has('tray-edge')).toBe(false)
+    expect(at(6).has('tray-edge')).toBe(true)
+    expect(frames[5].text.get('scene-kit')).toMatch(/scene kit/)
+    const edge = rectOf('tray-edge')
+    const cards = ['card-1', 'card-2', 'card-3', 'card-4', 'ghost'].map(rectOf)
+    // The edge runs the full width of the assembled row, directly under its bottom.
+    expect(edge.x).toBeLessThanOrEqual(cards[0].x)
+    expect(edge.x + edge.w).toBeGreaterThanOrEqual(cards[4].x + cards[4].w)
+    const rowBottom = Math.max(...cards.map((c) => c.y + c.h))
+    expect(edge.y).toBeGreaterThanOrEqual(rowBottom)
+    expect(edge.y).toBeLessThanOrEqual(rowBottom + 8)
+    const plug = spec('kit-plug')
+    if (plug.kind !== 'arrow') throw new Error('plug must be an arrow')
+    // It lands on the edge, in a gap between cards, so it does not read as attached to one card.
+    expect(plug.to[1]).toBeGreaterThanOrEqual(edge.y)
+    expect(plug.to[1]).toBeLessThanOrEqual(edge.y + edge.h + 4)
+    for (const card of cards) {
+      const inside = plug.to[0] >= card.x && plug.to[0] <= card.x + card.w
+      expect(inside, `plug end x=${plug.to[0]} must not sit under a card`).toBe(false)
+    }
+    expect(plug.to[0]).toBeGreaterThan(edge.x)
+    expect(plug.to[0]).toBeLessThan(edge.x + edge.w)
+    expect(plug.from[1]).toBe(rectOf('scene-kit').y)
+    expect(plug.from[0]).toBeGreaterThanOrEqual(rectOf('scene-kit').x)
+    expect(plug.from[0]).toBeLessThanOrEqual(rectOf('scene-kit').x + rectOf('scene-kit').w)
+    expect(at(6).has('reveal-frame')).toBe(false)
+    expect(ENTITIES.filter((e) => e.kind === 'frame' && e.since <= 8)).toHaveLength(0)
+  })
+
+  it('7: verify is chained after the cards in the same row and resolves to a green pass', () => {
+    const verify = rectOf('verify')
+    const cards = [1, 2, 3, 4].map((i) => rectOf(`card-${i}`))
+    expect(verify.y).toBe(cards[0].y)
+    expect(verify.x).toBeGreaterThan(Math.max(...cards.map((c) => c.x + c.w)))
+    expect(frames[6].text.get('verify')).toMatch(/verify.*build.*render/)
+    expect(node(7, 'verify').getAttribute('data-presentation-state')).toBe('pass')
+    expect(at(6).has('verify')).toBe(false)
+    const pass = rectOf('verify-pass')
+    expect(pass.x).toBeGreaterThanOrEqual(verify.x)
+    expect(pass.x + pass.w).toBeLessThanOrEqual(verify.x + verify.w)
+    expect(frames[6].text.get('verify-pass')).toBe('✓')
+    expect(css).toMatch(/\.pass\s*\{[^}]*background:\s*var\(--pass\)/)
+    expect(css).toMatch(/--pass:\s*#55c38a/)
+  })
+
+  it('8: a modify arc from the conversation down into the route, with the edited card flagged', () => {
+    const arc = spec('modify')
+    if (arc.kind !== 'arrow') throw new Error('modify must be an arrow')
+    expect(arc.via).toBeDefined()
+    expect(arc.from[0]).toBeGreaterThanOrEqual(rectOf('skill').x + rectOf('skill').w - 2)
+    expect(arc.from[1]).toBeLessThanOrEqual(rectOf('skill').y + rectOf('skill').h)
+    const route = rectOf('route')
+    expect(arc.to[1]).toBeGreaterThan(route.y)
+    expect(arc.to[1]).toBeLessThan(route.y + route.h)
+    expect(frames[7].text.get('route')).toBe('route')
+    expect(node(8, 'card-2').getAttribute('data-presentation-flag')).toBe('edited')
+    expect(node(8, 'card-2').getAttribute('data-presentation-emphasis')).toBe('true')
+    expect(frames[7].text.get('edited')).toBe('edited')
+    expect(frames[6].flags.get('card-2')).toBeNull()
+    expect(frames[7].flags.get('card-2')).toBe('edited')
+  })
+
+  it('9: a labeled outer frame encloses the whole diagram', () => {
+    const frame = rectOf('reveal-frame')
+    expect(frames[8].text.get('reveal-label')).toMatch(/example of the skill/)
+    for (const entity of ENTITIES) {
+      if (entity.id === 'reveal-frame') continue
+      const points =
+        'at' in entity
+          ? [[entity.at.x, entity.at.y], [entity.at.x + (entity.at.w ?? 0), entity.at.y + (entity.at.h ?? 0)]]
+          : [entity.from, entity.to, ...(entity.via ? [[(entity.from[0] + 2 * entity.via[0] + entity.to[0]) / 4, (entity.from[1] + 2 * entity.via[1] + entity.to[1]) / 4]] : [])]
+      for (const [x, y] of points) {
+        expect(x, `${entity.id} x`).toBeGreaterThan(frame.x)
+        expect(x, `${entity.id} x`).toBeLessThan(frame.x + frame.w)
+        expect(y, `${entity.id} y`).toBeGreaterThan(frame.y)
+        expect(y, `${entity.id} y`).toBeLessThan(frame.y + frame.h)
+      }
+    }
+  })
+
+  it('keeps every entity inside the 880 x 380 canvas', () => {
+    for (const entity of ENTITIES) {
+      if (!('at' in entity)) continue
+      expect(entity.at.x).toBeGreaterThanOrEqual(0)
+      expect(entity.at.y).toBeGreaterThanOrEqual(0)
+      expect(entity.at.x + (entity.at.w ?? 0)).toBeLessThanOrEqual(880)
+      expect(entity.at.y + (entity.at.h ?? 0)).toBeLessThanOrEqual(380)
+    }
+  })
+})
+
+describe('sample styling', () => {
+  it('owns its look in presentation-local CSS and styles active chrome and attribution', () => {
+    expect(css).toMatch(/\[data-presentation-progress-dot\]\[data-presentation-active\]\s*\{[^}]*background:/)
+    expect(css).toMatch(/\[data-presentation-progress-dot\]\s*\{[^}]*background:\s*transparent/)
+    expect(css).toMatch(/\[data-presentation-toc-entry\]\[data-presentation-active\]\s*\{[^}]*font-weight:\s*700/)
+    expect(css).toMatch(/\[data-presentation-attribution\]\s*\{[^}]*font-size:\s*0\.8125rem/)
+    expect(css).toMatch(/\[data-presentation-attribution\]\s*\{[^}]*font-family:/)
+    expect(css).toMatch(/\[data-presentation-attribution\]\s*\{[^}]*color:\s*var\(--muted\)/)
+    const talk = readFileSync(resolve(process.cwd(), 'src/presentations/how-to-make-a-presentation/Talk.tsx'), 'utf8')
+    expect(talk).toContain("import './styles.css'")
+    expect(talk).not.toMatch(/\bas (any|unknown|Step)/)
+  })
+})
diff --git a/src/tests/scripts/inspect.test.mjs b/src/tests/scripts/inspect.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..03b144fbeb8644e7a2f5f7e69b760d7d83cbd55c
--- /dev/null
+++ b/src/tests/scripts/inspect.test.mjs
@@ -0,0 +1,152 @@
+import { describe, expect, it } from 'vitest'
+import {
+  DEFAULT_SETTLE_MS,
+  DEFAULT_VIEWPORT,
+  attributionProblems,
+  captureSteps,
+  findOverlaps,
+  isIndistinct,
+  parseArgs,
+  screenshotDir,
+  screenshotName,
+  stepWarnings,
+} from '../../../scripts/inspect-lib.mjs'
+
+const item = (key, x, y, w, h, extra = {}) => ({ key, label: `el${key}`, rect: { x, y, width: w, height: h }, ...extra })
+
+describe('screenshot paths and options', () => {
+  it('writes predictable per-step names under a project-local directory', () => {
+    expect(screenshotName(0)).toBe('step-01.png')
+    expect(screenshotName(11)).toBe('step-12.png')
+    expect(screenshotDir('deck')).toBe('.inspection/deck')
+    expect(screenshotDir('deck', { width: 390, height: 844 })).toBe('.inspection/deck/390x844')
+  })
+
+  it('parses the slug, settle interval, and viewport options', () => {
+    expect(parseArgs(['deck'])).toMatchObject({ slug: 'deck', settleMs: DEFAULT_SETTLE_MS, build: true })
+    expect(DEFAULT_VIEWPORT).toEqual({ width: 1440, height: 900 })
+    expect(parseArgs(['deck', '--settle', '50', '--skip-build'])).toMatchObject({ settleMs: 50, build: false })
+    expect(parseArgs(['deck', '--viewport', '800x600']).viewport).toEqual({ width: 800, height: 600 })
+    expect(parseArgs(['deck', '--narrow']).viewport).toEqual({ width: 390, height: 844 })
+    expect(() => parseArgs([])).toThrow(/usage/)
+    expect(() => parseArgs(['deck', '--bogus'])).toThrow(/unknown option/)
+    expect(() => parseArgs(['deck', '--viewport', 'wide'])).toThrow(/invalid viewport/)
+    expect(() => parseArgs(['deck', '--settle', '-1'])).toThrow(/non-negative/)
+  })
+
+  it('has a default settle interval longer than layout, delay, and entrance combined', () => {
+    expect(DEFAULT_SETTLE_MS).toBeGreaterThan((0.5 + 0.1 + 0.35) * 1000)
+  })
+})
+
+describe('captureSteps', () => {
+  it('moves to each step, waits the settle interval, then captures, in that order', async () => {
+    const log = []
+    await captureSteps({
+      count: 3,
+      settleMs: 700,
+      goTo: async (i) => log.push(`go ${i}`),
+      wait: async (ms) => log.push(`wait ${ms}`),
+      capture: async (i) => log.push(`shot ${i}`),
+    })
+    expect(log).toEqual(['go 0', 'wait 700', 'shot 0', 'go 1', 'wait 700', 'shot 1', 'go 2', 'wait 700', 'shot 2'])
+  })
+
+  it('awaits an asynchronous wait before capturing', async () => {
+    let waited = false
+    await captureSteps({
+      count: 1,
+      settleMs: 1,
+      goTo: async () => {},
+      wait: () => new Promise((resolve) => setTimeout(() => ((waited = true), resolve()), 20)),
+      capture: async () => expect(waited).toBe(true),
+    })
+  })
+})
+
+describe('overlap detection', () => {
+  it('reports intersecting boxes only', () => {
+    expect(findOverlaps([item(1, 0, 0, 10, 10), item(2, 5, 5, 10, 10)])).toHaveLength(1)
+    expect(findOverlaps([item(1, 0, 0, 10, 10), item(2, 20, 20, 10, 10)])).toHaveLength(0)
+  })
+
+  it('does not count edge-touching boxes', () => {
+    expect(findOverlaps([item(1, 0, 0, 10, 10), item(2, 10, 0, 10, 10)])).toHaveLength(0)
+    expect(findOverlaps([item(1, 0, 0, 10, 10), item(2, 0, 10, 10, 10)])).toHaveLength(0)
+  })
+
+  it('ignores hidden and zero-size elements', () => {
+    expect(findOverlaps([item(1, 0, 0, 10, 10), item(2, 0, 0, 10, 10, { visible: false })])).toHaveLength(0)
+    expect(findOverlaps([item(1, 0, 0, 10, 10), item(2, 5, 5, 0, 10)])).toHaveLength(0)
+  })
+
+  it('exempts allow-overlap subtrees on either side but still reports other pairs', () => {
+    const allowed = item(1, 0, 0, 10, 10, { allowOverlap: true })
+    expect(findOverlaps([allowed, item(2, 5, 5, 10, 10)])).toHaveLength(0)
+    expect(findOverlaps([item(2, 5, 5, 10, 10), allowed])).toHaveLength(0)
+    const pairs = findOverlaps([allowed, item(2, 5, 5, 10, 10), item(3, 8, 8, 10, 10)])
+    expect(pairs.map(([a, b]) => [a.key, b.key])).toEqual([[2, 3]])
+  })
+
+  it('reports a child element text colliding with its parent text, but not runs of one element', () => {
+    expect(findOverlaps([item(1, 0, 0, 50, 50, { owner: 1 }), item(2, 5, 5, 10, 10, { owner: 2 })])).toHaveLength(1)
+    expect(findOverlaps([item(1, 0, 0, 50, 20, { owner: 7 }), item(2, 10, 10, 50, 20, { owner: 7 })])).toHaveLength(0)
+  })
+})
+
+describe('active chrome and attribution diagnostics', () => {
+  const base = { color: 'rgb(1, 1, 1)', backgroundColor: 'rgba(0, 0, 0, 0)', fontWeight: '400', opacity: '1', borderColor: 'rgb(0, 0, 0)', boxShadow: 'none' }
+
+  it('flags an active item identical to an inactive one', () => {
+    expect(isIndistinct(base, { ...base })).toBe(true)
+  })
+
+  it.each(['color', 'backgroundColor', 'fontWeight', 'opacity', 'borderColor', 'boxShadow'])('treats a %s difference as distinct', (property) => {
+    expect(isIndistinct({ ...base, [property]: 'different' }, base)).toBe(false)
+  })
+
+  it('flags small and browser-default attribution, and accepts a styled one', () => {
+    const ok = { fontSize: 13, color: 'rgb(170, 170, 170)', fontFamily: 'ui-monospace, monospace' }
+    expect(attributionProblems(ok)).toEqual([])
+    expect(attributionProblems({ ...ok, fontSize: 10.9 })).toHaveLength(1)
+    expect(attributionProblems({ ...ok, fontSize: 11 })).toEqual([])
+    const ua = { fontSize: 16, color: 'rgb(0, 0, 238)', fontFamily: '"Times New Roman"' }
+    expect(attributionProblems(ua)[0]).toMatch(/browser-default/)
+    expect(attributionProblems({ ...ua, fontFamily: 'Times' })).toHaveLength(1)
+    expect(attributionProblems({ ...ua, fontFamily: 'Inter, serif' })).toEqual([])
+    expect(attributionProblems({ ...ua, color: 'rgb(200, 0, 0)' })).toEqual([])
+  })
+
+  it('reports a missing attribution link, naming the hook', () => {
+    const warnings = stepWarnings(2, { items: [], progress: null, toc: null, attribution: null })
+    expect(warnings).toHaveLength(1)
+    expect(warnings[0]).toMatch(/step 2: attribution no attribution link/)
+    expect(warnings[0]).toMatch(/data-presentation-attribution/)
+  })
+})
+
+describe('stepWarnings', () => {
+  const styled = { fontSize: 13, color: 'rgb(9, 9, 9)', fontFamily: 'monospace' }
+  const same = { color: 'a', backgroundColor: 'b', fontWeight: '400', opacity: '1', borderColor: 'c', boxShadow: 'none' }
+
+  it('is silent for a clean step', () => {
+    expect(stepWarnings(1, { items: [item(1, 0, 0, 5, 5)], progress: { active: { ...same, color: 'x' }, inactive: same }, toc: null, attribution: styled })).toEqual([])
+  })
+
+  it('names the step and both overlapping elements, and the allow-overlap marker', () => {
+    const warnings = stepWarnings(3, {
+      items: [item(1, 0, 0, 10, 10, { text: 'Hello' }), item(2, 5, 5, 10, 10, { text: 'World' })],
+      progress: null,
+      toc: null,
+      attribution: styled,
+    })
+    expect(warnings).toEqual([expect.stringMatching(/^warning: step 3: el1 "Hello" overlaps el2 "World".*data-presentation-allow-overlap/)])
+  })
+
+  it('reports indistinct progress and ToC chrome separately', () => {
+    const warnings = stepWarnings(4, { items: [], progress: { active: same, inactive: same }, toc: { active: same, inactive: same }, attribution: styled })
+    expect(warnings).toHaveLength(2)
+    expect(warnings[0]).toMatch(/step 4: active progress/)
+    expect(warnings[1]).toMatch(/step 4: active table-of-contents/)
+  })
+})
diff --git a/src/tests/scripts/verify.test.mjs b/src/tests/scripts/verify.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ab5c7759cbddbe2238a83d19841ac6afba82087a
--- /dev/null
+++ b/src/tests/scripts/verify.test.mjs
@@ -0,0 +1,119 @@
+import { EventEmitter } from 'node:events'
+import { describe, expect, it } from 'vitest'
+import { EXPECTED_OUTLINE, checkSample } from '../../../scripts/verify-outline.mjs'
+import {
+  VerifyFailure,
+  attachErrorCollectors,
+  isFatalConsoleType,
+  isFatalResponse,
+  waitForStepIndex,
+} from '../../../scripts/verify-lib.mjs'
+
+const registry = [{ slug: 'how-to-make-a-presentation' }]
+const outline = EXPECTED_OUTLINE.map((row) => ({ ...row }))
+
+describe('checkSample', () => {
+  it('accepts the canonical sample', () => {
+    expect(checkSample({ registry, outline })).toEqual([])
+    expect(EXPECTED_OUTLINE).toHaveLength(9)
+  })
+
+  it('rejects a sample that is not registered', () => {
+    expect(checkSample({ registry: [], outline })[0]).toMatch(/not registered/)
+    expect(checkSample({ registry: undefined, outline })[0]).toMatch(/not registered/)
+    expect(checkSample({ registry: [{ slug: 'other' }], outline })[0]).toMatch(/not registered/)
+  })
+
+  it('rejects a missing outline', () => {
+    expect(checkSample({ registry, outline: undefined })).toEqual([expect.stringMatching(/outline is missing/)])
+  })
+
+  it('rejects a wrong step count', () => {
+    expect(checkSample({ registry, outline: outline.slice(0, 8) }).join('\n')).toMatch(/8 steps, expected 9/)
+    expect(checkSample({ registry, outline: [...outline, outline[0]] }).join('\n')).toMatch(/10 steps, expected 9/)
+  })
+
+  it('rejects reordered steps', () => {
+    const swapped = [...outline]
+    ;[swapped[2], swapped[3]] = [swapped[3], swapped[2]]
+    const problems = checkSample({ registry, outline: swapped })
+    expect(problems.some((p) => p.startsWith('step 3 title'))).toBe(true)
+    expect(problems.some((p) => p.startsWith('step 4 title'))).toBe(true)
+  })
+
+  it.each(['era', 'title', 'caption'])('rejects a changed %s independently', (field) => {
+    const changed = outline.map((row, i) => (i === 5 ? { ...row, [field]: `${row[field]}!` } : row))
+    const problems = checkSample({ registry, outline: changed })
+    expect(problems).toHaveLength(1)
+    expect(problems[0]).toMatch(new RegExp(`^step 6 ${field}:`))
+  })
+
+  it('compares against strings independent of the sample data', async () => {
+    const { OUTLINE } = await import('../../presentations/how-to-make-a-presentation/outline')
+    expect(checkSample({ registry, outline: OUTLINE })).toEqual([])
+  })
+})
+
+describe('fault classification', () => {
+  it('fails on console errors only, not warnings or logs', () => {
+    expect(isFatalConsoleType('error')).toBe(true)
+    for (const type of ['warning', 'log', 'info', 'debug']) expect(isFatalConsoleType(type)).toBe(false)
+  })
+
+  it('fails on same-origin asset errors only', () => {
+    const origin = 'http://127.0.0.1:5000'
+    expect(isFatalResponse(`${origin}/assets/a.js`, 404, origin)).toBe(true)
+    expect(isFatalResponse(`${origin}/assets/a.js`, 200, origin)).toBe(false)
+    expect(isFatalResponse('https://elsewhere.test/x', 500, origin)).toBe(false)
+    expect(isFatalResponse(`${origin}/favicon.ico`, 404, origin)).toBe(false)
+  })
+})
+
+function fakePage() {
+  const page = new EventEmitter()
+  page.timeouts = []
+  page.waitForFunction = async (_fn, index, { timeout }) => {
+    page.timeouts.push(timeout)
+    if (page.stall) throw new Error(`timed out waiting for ${index}`)
+  }
+  return page
+}
+
+describe('attachErrorCollectors', () => {
+  it('records console errors, page errors, and failed same-origin requests against the current step', () => {
+    const page = fakePage()
+    const records = []
+    let step = 0
+    attachErrorCollectors(page, { origin: 'http://127.0.0.1:1', getStep: () => step, record: (s, m) => records.push([s, m]) })
+    page.emit('console', { type: () => 'warning', text: () => 'ignored' })
+    page.emit('console', { type: () => 'error', text: () => 'boom' })
+    step = 3
+    page.emit('pageerror', new Error('kaput'))
+    page.emit('requestfailed', { url: () => 'http://127.0.0.1:1/a.js' })
+    page.emit('requestfailed', { url: () => 'https://other.test/a.js' })
+    page.emit('response', { url: () => 'http://127.0.0.1:1/b.js', status: () => 500 })
+    expect(records).toEqual([
+      [0, 'console.error: boom'],
+      [3, 'uncaught error: kaput'],
+      [3, 'request failed: http://127.0.0.1:1/a.js'],
+      [3, 'HTTP 500: http://127.0.0.1:1/b.js'],
+    ])
+  })
+})
+
+describe('waitForStepIndex', () => {
+  it('waits with a bounded timeout and passes when the index appears', async () => {
+    const page = fakePage()
+    await waitForStepIndex(page, 2, 1234)
+    expect(page.timeouts).toEqual([1234])
+  })
+
+  it('fails with the offending step when a transition stalls', async () => {
+    const page = fakePage()
+    page.stall = true
+    const failure = await waitForStepIndex(page, 4, 50, 'deck').catch((error) => error)
+    expect(failure).toBeInstanceOf(VerifyFailure)
+    expect(failure).toMatchObject({ phase: 'render', step: 4 })
+    expect(failure.message).toMatch(/deck: transition did not advance to step index 4/)
+  })
+})
