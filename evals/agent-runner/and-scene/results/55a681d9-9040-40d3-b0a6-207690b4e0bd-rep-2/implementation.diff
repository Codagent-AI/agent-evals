@@ -0,0 +1,21 @@
+import { ATTRIBUTION_HREF, ATTRIBUTION_LABEL } from '../constants'
+
+export interface AttributionOptions {
+  label?: string
+  href?: string
+}
+
+/** Toolkit disclosure pinned to the bottom-right corner of the presentation root. */
+export function Attribution({ label = ATTRIBUTION_LABEL, href = ATTRIBUTION_HREF }: AttributionOptions) {
+  return (
+    <a
+      data-presentation-attribution=""
+      href={href}
+      target="_blank"
+      rel="noopener noreferrer"
+      style={{ position: 'absolute', right: 0, bottom: 0 }}
+    >
+      {label}
+    </a>
+  )
+}
diff --git a/src/presentation-kit/chrome/Footer.tsx b/src/presentation-kit/chrome/Footer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b519bff97537dbeb9f53e1e9fa8da92ae0610ae7
--- /dev/null
+++ b/src/presentation-kit/chrome/Footer.tsx
@@ -0,0 +1,49 @@
+import type { PresentationMode } from '../constants'
+import type { StepMeta } from '../types'
+
+export interface FooterProps {
+  step: StepMeta
+  index: number
+  count: number
+  mode: PresentationMode
+  onPrev: () => void
+  onNext: () => void
+  onJump: (index: number) => void
+}
+
+export function Footer({ step, index, count, mode, onPrev, onNext, onJump }: FooterProps) {
+  const browse = mode === 'browse'
+  return (
+    <footer data-presentation-footer="" style={{ display: 'flex', alignItems: 'center' }}>
+      {browse ? (
+        <p data-presentation-caption="">{step.caption}</p>
+      ) : (
+        <h1 data-presentation-title="">{step.title}</h1>
+      )}
+      <ol data-presentation-progress="" style={{ display: 'flex' }}>
+        {Array.from({ length: count }, (_, i) => (
+          <li key={i}>
+            <button
+              type="button"
+              data-presentation-progress-dot=""
+              data-presentation-active={i === index ? '' : undefined}
+              aria-current={i === index ? 'step' : undefined}
+              aria-label={`Go to step ${i + 1}`}
+              onClick={() => onJump(i)}
+            />
+          </li>
+        ))}
+      </ol>
+      {browse ? (
+        <div data-presentation-controls="">
+          <button type="button" data-presentation-prev="" disabled={index === 0} onClick={onPrev}>
+            Previous
+          </button>
+          <button type="button" data-presentation-next="" disabled={index === count - 1} onClick={onNext}>
+            Next
+          </button>
+        </div>
+      ) : null}
+    </footer>
+  )
+}
diff --git a/src/presentation-kit/chrome/Header.tsx b/src/presentation-kit/chrome/Header.tsx
