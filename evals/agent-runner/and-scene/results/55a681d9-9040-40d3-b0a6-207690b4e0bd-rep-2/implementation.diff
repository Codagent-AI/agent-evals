diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..8936ac82e6c2f34dab9fd477148b691c91dd47df
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,68 @@
+import { useEffect } from 'react'
+import type { ReactNode } from 'react'
+import { TOC_MIN_WIDTH } from './constants'
+import type { PresentationMode } from './constants'
+import { Stage } from './Stage'
+import { validateSteps } from './steps'
+import type { Step } from './types'
+import { usePresentationNav } from './usePresentationNav'
+import { useViewportWidth } from './useViewportWidth'
+import { Attribution } from './chrome/Attribution'
+import type { AttributionOptions } from './chrome/Attribution'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { Toc } from './chrome/Toc'
+
+export interface PresentationProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  title: string
+  initialMode?: PresentationMode
+  /** Host-provided top-left brand; no default is rendered. */
+  brand?: ReactNode
+  /** Options for the default bottom-right attribution, or `false` to omit it. */
+  attribution?: AttributionOptions | false
+}
+
+export function Presentation<TPayload>({
+  steps,
+  title,
+  initialMode = 'browse',
+  brand,
+  attribution,
+}: PresentationProps<TPayload>) {
+  validateSteps(steps)
+  const nav = usePresentationNav(steps.length, initialMode)
+  const viewportWidth = useViewportWidth()
+  const step = steps[nav.index]
+  useEffect(() => {
+    document.title = title
+  }, [title])
+  const showToc = nav.mode === 'browse' && viewportWidth >= TOC_MIN_WIDTH
+
+  return (
+    <div
+      data-presentation-root=""
+      aria-label={title}
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      style={{ position: 'relative', display: 'flex', flexDirection: 'column', width: '100%', height: '100%' }}
+    >
+      <Header index={nav.index} count={steps.length} title={step.title} mode={nav.mode} brand={brand} />
+      <div style={{ display: 'flex', flex: 1, minHeight: 0 }}>
+        {showToc ? <Toc steps={steps} index={nav.index} onJump={nav.goTo} /> : null}
+        <Stage steps={steps} index={nav.index} mode={nav.mode} />
+      </div>
+      <Footer
+        step={step}
+        index={nav.index}
+        count={steps.length}
+        mode={nav.mode}
+        onPrev={nav.prev}
+        onNext={nav.next}
+        onJump={nav.goTo}
+      />
+      {attribution === false ? null : <Attribution {...attribution} />}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..205a3e4ed1e94f80ccbeb02735ad62a171219678
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,75 @@
+import { useRef, useState } from 'react'
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, ENTER_T } from './constants'
+import type { PresentationMode } from './constants'
+import { StageContext } from './stageContext'
+import { sceneKey } from './steps'
+import type { Step } from './types'
+import { useFitScale } from './useFitScale'
+
+export interface StageProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  index: number
+  mode: PresentationMode
+}
+
+/**
+ * Fixed design canvas scaled to fit. The canvas is keyed by mode so a mode switch
+ * re-renders at the new scale instead of morphing entities between scales.
+ */
+export function Stage<TPayload>({ steps, index, mode }: StageProps<TPayload>) {
+  const viewport = useRef<HTMLDivElement>(null)
+  const scale = useFitScale(viewport, mode)
+  // `instant` holds from a mode switch until the next step change, so the remounted
+  // canvas shows its entities in place instead of replaying their entrances.
+  const [seen, setSeen] = useState({ mode, index, instant: false })
+  if (seen.mode !== mode) setSeen({ mode, index, instant: true })
+  else if (seen.index !== index) setSeen({ mode, index, instant: false })
+
+  const step = steps[index]
+  const { Scene } = step
+
+  return (
+    <div
+      ref={viewport}
+      data-presentation-stage=""
+      style={{ position: 'relative', flex: 1, minWidth: 0, minHeight: 0, overflow: 'hidden' }}
+    >
+      <div
+        data-presentation-canvas=""
+        data-presentation-scale={scale}
+        style={{
+          position: 'absolute',
+          left: '50%',
+          top: '50%',
+          width: DESIGN_W,
+          height: DESIGN_H,
+          transform: `translate(-50%, -50%) scale(${scale})`,
+          transformOrigin: 'center center',
+        }}
+      >
+        <StageContext.Provider value={{ instant: seen.instant }}>
+          <LayoutGroup key={mode}>
+            <AnimatePresence initial={false}>
+              <motion.div
+                key={sceneKey(step)}
+                data-presentation-scene=""
+                style={{ position: 'absolute', left: 0, top: 0, width: '100%', height: '100%' }}
+                initial={{ opacity: 0 }}
+                animate={{ opacity: 1, transition: { duration: ENTER_T } }}
+                exit={{ opacity: 0, transition: { duration: ENTER_T } }}
+              >
+                <Scene
+                  payload={step.payload}
+                  step={step}
+                  stepIndex={index}
+                  stepCount={steps.length}
+                />
+              </motion.div>
+            </AnimatePresence>
+          </LayoutGroup>
+        </StageContext.Provider>
+      </div>
+    </div>
+  )
+}
diff --git a/src/presentation-kit/chrome/Attribution.tsx b/src/presentation-kit/chrome/Attribution.tsx
