index 0000000000000000000000000000000000000000..7fc9e60f8b885fce5bc8e961c7b13394852c2f0a
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/inspect-lib.mjs
@@ -0,0 +1,124 @@
+// Pure helpers for the screenshot helper: output paths, capture ordering, and
+// advisory visual diagnostics. Nothing here touches a browser.
+
+export const DEFAULT_SETTLE_MS = 1200
+export const DEFAULT_VIEWPORT = { width: 1440, height: 900 }
+export const NARROW_VIEWPORT = { width: 390, height: 844 }
+export const MIN_ATTRIBUTION_PX = 11
+const UA_LINK_COLOR = 'rgb(0, 0, 238)'
+const UA_SERIF = /^"?(times new roman|times|serif)"?$/i
+
+export function parseViewport(text) {
+  const match = /^(\d+)x(\d+)$/.exec(text ?? '')
+  if (!match) throw new Error(`invalid viewport "${text}", expected WIDTHxHEIGHT`)
+  return { width: Number(match[1]), height: Number(match[2]) }
+}
+
+export function parseArgs(argv) {
+  const options = { slug: undefined, settleMs: DEFAULT_SETTLE_MS, viewport: undefined, build: true }
+  for (let i = 0; i < argv.length; i += 1) {
+    const arg = argv[i]
+    if (arg === '--settle') options.settleMs = Number(argv[++i])
+    else if (arg === '--viewport') options.viewport = parseViewport(argv[++i])
+    else if (arg === '--narrow') options.viewport = NARROW_VIEWPORT
+    else if (arg === '--skip-build') options.build = false
+    else if (arg.startsWith('--')) throw new Error(`unknown option ${arg}`)
+    else options.slug = arg
+  }
+  if (!options.slug) throw new Error('usage: npm run inspect -- <slug> [--narrow | --viewport WxH] [--settle ms] [--skip-build]')
+  if (!Number.isFinite(options.settleMs) || options.settleMs < 0) throw new Error('--settle needs a non-negative number')
+  return options
+}
+
+/** Wide captures go to `.inspection/<slug>/`, other viewports to `.inspection/<slug>/<WxH>/`. */
+export function screenshotDir(slug, viewport) {
+  const base = `.inspection/${slug}`
+  if (!viewport) return base
+  return `${base}/${viewport.width}x${viewport.height}`
+}
+
+export function screenshotName(index) {
+  return `step-${String(index + 1).padStart(2, '0')}.png`
+}
+
+/** Visits each step, waits out the settle interval, then captures; warnings follow the capture. */
+export async function captureSteps({ count, goTo, wait, settleMs, capture }) {
+  for (let index = 0; index < count; index += 1) {
+    await goTo(index)
+    await wait(settleMs)
+    await capture(index)
+  }
+}
+
+function area(rect) {
+  return Math.max(0, rect.width) * Math.max(0, rect.height)
+}
+
+export function rectsOverlap(a, b) {
+  const width = Math.min(a.x + a.width, b.x + b.width) - Math.max(a.x, b.x)
+  const height = Math.min(a.y + a.height, b.y + b.height) - Math.max(a.y, b.y)
+  return width > 0 && height > 0
+}
+
+/**
+ * Pairs of visible items whose boxes intersect. Items inside an allow-overlap subtree
+ * (`allowOverlap`) are exempt, as are text runs of the same element (`owner`), whose boxes
+ * can intersect when one run wraps. A parent's text and a child's text are distinct owners.
+ */
+export function findOverlaps(items) {
+  const visible = items.filter((item) => item.visible !== false && area(item.rect) > 0)
+  const pairs = []
+  for (let i = 0; i < visible.length; i += 1) {
+    for (let j = i + 1; j < visible.length; j += 1) {
+      const a = visible[i]
+      const b = visible[j]
+      if (a.allowOverlap || b.allowOverlap) continue
+      if (a.owner !== undefined && a.owner === b.owner) continue
+      if (rectsOverlap(a.rect, b.rect)) pairs.push([a, b])
+    }
+  }
+  return pairs
+}
+
+const ACTIVE_STYLE_PROPERTIES = ['color', 'backgroundColor', 'fontWeight', 'opacity', 'borderColor', 'boxShadow']
+
+/** True when no visual property separates the active item from an inactive sibling. */
+export function isIndistinct(active, inactive) {
+  return ACTIVE_STYLE_PROPERTIES.every((property) => active[property] === inactive[property])
+}
+
+/** Advisory problems with an attribution link's computed style, or `[]` when it looks intentional. */
+export function attributionProblems(style) {
+  if (!style) return ['no attribution link with data-presentation-attribution was found']
+  const problems = []
+  if (style.fontSize < MIN_ATTRIBUTION_PX) {
+    problems.push(`font size ${style.fontSize}px is under ${MIN_ATTRIBUTION_PX}px`)
+  }
+  const firstFamily = String(style.fontFamily).split(',')[0].trim()
+  if (style.color === UA_LINK_COLOR && UA_SERIF.test(firstFamily)) {
+    problems.push('still uses the browser-default link color and serif font')
+  }
+  return problems
+}
+
+export function describe(item) {
+  return `${item.label}${item.text ? ` "${item.text}"` : ''}`
+}
+
+/** Turns one step's measurements into printable advisory warnings. */
+export function stepWarnings(step, { items, progress, toc, attribution }) {
+  const warnings = []
+  for (const [a, b] of findOverlaps(items)) {
+    warnings.push(`warning: step ${step}: ${describe(a)} overlaps ${describe(b)} (mark an intentional overlap with data-presentation-allow-overlap)`)
+  }
+  if (progress && isIndistinct(progress.active, progress.inactive)) {
+    warnings.push(`warning: step ${step}: active progress indicator looks the same as inactive ones; style [data-presentation-active]`)
+  }
+  if (toc && isIndistinct(toc.active, toc.inactive)) {
+    warnings.push(`warning: step ${step}: active table-of-contents entry looks the same as inactive ones; style [data-presentation-active]`)
+  }
+  for (const problem of attributionProblems(attribution)) {
+    warnings.push(`warning: step ${step}: attribution ${problem}; style [data-presentation-attribution]`)
+  }
+  return warnings
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..1814f943accdade398e419ddf43153e40db86141
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/inspect-presentation.mjs
@@ -0,0 +1,151 @@
+#!/usr/bin/env node
+// Captures one settled screenshot per step from a production preview and prints
+// advisory visual warnings. Warnings never change the exit code.
+import { spawn } from 'node:child_process'
+import { mkdirSync } from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { chromium } from 'playwright'
+import { startPreview } from './preview.mjs'
+import {
+  captureSteps,
+  DEFAULT_VIEWPORT,
+  parseArgs,
+  screenshotDir,
+  screenshotName,
+  stepWarnings,
+} from './inspect-lib.mjs'
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const STEP_TIMEOUT_MS = 5000
+
+function build() {
+  return new Promise((resolve, reject) => {
+    const child = spawn('npm', ['run', 'build'], { cwd: root, stdio: ['ignore', 'pipe', 'pipe'] })
+    let output = ''
+    child.stdout.on('data', (chunk) => (output += chunk))
+    child.stderr.on('data', (chunk) => (output += chunk))
+    child.on('error', reject)
+    child.on('close', (code) => (code === 0 ? resolve() : reject(new Error(`npm run build failed\n${output.trim()}`))))
+  })
+}
+
+/** Runs in the page: measures text, chrome, active-state styles, and the attribution link. */
+function measure() {
+  const root = document.querySelector('[data-presentation-root]')
+  const visible = (element) => {
+    const style = getComputedStyle(element)
+    return style.display !== 'none' && style.visibility !== 'hidden' && Number(style.opacity) > 0
+  }
+  const label = (element) => {
+    const hook = [...element.attributes].find((a) => a.name.startsWith('data-presentation-') && a.name !== 'data-presentation-active')
+    const id = element.getAttribute('data-presentation-entity')
+    const hookText = id ? `[data-presentation-entity="${id}"]` : hook ? `[${hook.name}]` : ''
+    return `${element.tagName.toLowerCase()}${hookText}`
+  }
+  const items = []
+  const owners = new Map()
+  const add = (element, rect, text) => {
+    if (!owners.has(element)) owners.set(element, owners.size)
+    items.push({
+      key: items.length,
+      owner: owners.get(element),
+      label: label(element),
+      text: text?.trim().slice(0, 40),
+      visible: visible(element),
+      allowOverlap: element.closest('[data-presentation-allow-overlap]') !== null,
+      rect: { x: rect.left, y: rect.top, width: rect.width, height: rect.height },
+    })
+  }
+  // Every text run is its own item, so a parent's text and a positioned child's text are compared.
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
+  for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+    const owner = node.parentElement
+    if (!owner || !node.textContent.trim() || owner.tagName === 'SCRIPT' || owner.tagName === 'STYLE') continue
+    const range = document.createRange()
+    range.selectNodeContents(node)
+    add(owner, range.getBoundingClientRect(), node.textContent)
+  }
+  for (const dot of root.querySelectorAll('[data-presentation-progress-dot]')) {
+    add(dot, dot.getBoundingClientRect(), '')
+  }
+
+  const style = (element) => {
+    const s = getComputedStyle(element)
+    return {
+      color: s.color,
+      backgroundColor: s.backgroundColor,
+      fontWeight: s.fontWeight,
+      opacity: s.opacity,
+      borderColor: s.borderTopColor,
+      boxShadow: s.boxShadow,
+    }
+  }
+  const pair = (selector) => {
+    const active = root.querySelector(`${selector}[data-presentation-active]`)
+    const inactive = root.querySelector(`${selector}:not([data-presentation-active])`)
+    return active && inactive ? { active: style(active), inactive: style(inactive) } : null
+  }
+  const link = root.querySelector('[data-presentation-attribution]')
+  const linkStyle = link && getComputedStyle(link)
+  return {
+    items,
+    progress: pair('[data-presentation-progress-dot]'),
+    toc: pair('[data-presentation-toc-entry]'),
+    attribution: link
+      ? { fontSize: parseFloat(linkStyle.fontSize), color: linkStyle.color, fontFamily: linkStyle.fontFamily }
+      : null,
+  }
+}
+
+async function main() {
+  const options = parseArgs(process.argv.slice(2))
+  const viewport = options.viewport ?? DEFAULT_VIEWPORT
+  const outDir = path.join(root, screenshotDir(options.slug, options.viewport))
+  if (options.build) await build()
+  mkdirSync(outDir, { recursive: true })
+
+  const preview = await startPreview(root)
+  let browser
+  let warningCount = 0
+  try {
+    browser = await chromium.launch()
+    const page = await browser.newPage({ viewport })
+    await page.goto(`${preview.origin}/${options.slug}`, { waitUntil: 'load' })
+    await page.waitForSelector('[data-step-count]', { timeout: STEP_TIMEOUT_MS })
+    const count = Number(await page.getAttribute('[data-step-count]', 'data-step-count'))
+    if (!Number.isInteger(count) || count < 1) throw new Error(`${options.slug} reported no steps (data-step-count is ${count})`)
+    await captureSteps({
+      count,
+      settleMs: options.settleMs,
+      wait: (ms) => page.waitForTimeout(ms),
+      goTo: async (index) => {
+        if (index === 0) return
+        await page.keyboard.press('ArrowRight')
+        await page.waitForFunction(
+          (want) => document.querySelector('[data-step-count]')?.getAttribute('data-step-index') === String(want),
+          index,
+          { timeout: STEP_TIMEOUT_MS },
+        )
+      },
+      capture: async (index) => {
+        const file = path.join(outDir, screenshotName(index))
+        await page.screenshot({ path: file })
+        console.log(`captured step ${index + 1}/${count}: ${path.relative(root, file)}`)
+        for (const warning of stepWarnings(index + 1, await page.evaluate(measure))) {
+          warningCount += 1
+          console.log(warning)
+        }
+      },
+    })
+  } finally {
+    await browser?.close()
+    await preview.stop()
+  }
+  console.log(`inspect: ${warningCount} advisory warning(s); screenshots in ${path.relative(root, outDir)}`)
+}
+
+main().catch((error) => {
+  console.error(`error: ${error.message}`)
+  process.exit(1)
+})
