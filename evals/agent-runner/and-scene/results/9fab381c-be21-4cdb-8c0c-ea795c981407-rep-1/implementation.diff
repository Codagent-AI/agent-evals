@@ -0,0 +1,28 @@
+import type { CSSProperties } from 'react'
+import { EASE, LAYOUT_T } from '../constants.ts'
+
+/** Identity and styling hooks every node primitive accepts. */
+export interface NodeProps {
+  /** Stable entity id; also used as the shared `layoutId` so the entity morphs across steps. */
+  id?: string
+  className?: string
+  style?: CSSProperties
+  [dataAttribute: `data-${string}`]: string | number | boolean | undefined
+}
+
+/** Picks the data-* attributes out of rest props so they reach the DOM. */
+export function dataProps(props: object): Record<string, unknown> {
+  return Object.fromEntries(Object.entries(props).filter(([key]) => key.startsWith('data-')))
+}
+
+export const entityAttrs = (hook: string, id: string | undefined) => ({
+  [`data-presentation-${hook}`]: '',
+  ...(id ? { 'data-presentation-entity': id } : {}),
+})
+
+/** Shared-layout props: the entity morphs in place between steps through its stable id. */
+export const morphProps = (id: string | undefined) => ({
+  layout: true,
+  layoutId: id,
+  transition: { layout: { duration: LAYOUT_T, ease: EASE } },
+})
diff --git a/src/presentation-kit/sceneKey.ts b/src/presentation-kit/sceneKey.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1729df5b9de464ec8dfc6371a15dfd8d46f6706c
--- /dev/null
+++ b/src/presentation-kit/sceneKey.ts
@@ -0,0 +1,13 @@
+const sceneIds = new WeakMap<object, number>()
+let nextSceneId = 0
+
+/**
+ * Steps with the same groupKey and Scene share a key, so the scene instance persists
+ * and only its payload changes. Any other change remounts and cross-fades.
+ */
+export function sceneKey(step: { id: string; groupKey?: string; Scene: object }): string {
+  if (!step.groupKey) return `step:${step.id}`
+  let id = sceneIds.get(step.Scene)
+  if (id === undefined) sceneIds.set(step.Scene, (id = nextSceneId++))
+  return `group:${step.groupKey}:${id}`
+}
