diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..bb36a8bd0599da70b186aa9f34f258f1da23e683
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,85 @@
+import type { ReactNode } from 'react'
+import { Footer } from './chrome/Footer.tsx'
+import { Header } from './chrome/Header.tsx'
+import { Toc } from './chrome/Toc.tsx'
+import { useViewportWidth } from './chrome/useViewportWidth.ts'
+import { TOC_MIN_WIDTH } from './constants.ts'
+import { Stage } from './Stage.tsx'
+import { usePresentationNav } from './usePresentationNav.ts'
+import type { AttributionOptions, Canvas, Mode, Step } from './types.ts'
+
+interface PresentationProps<TPayload> {
+  steps: ReadonlyArray<Step<TPayload>>
+  title: string
+  initialMode?: Mode
+  /** Host-provided top-left brand; none by default. */
+  brand?: ReactNode
+  /** Override the default attribution, or `null` to hide it. */
+  attribution?: AttributionOptions | null
+  canvas?: Canvas
+}
+
+/** One scene moving through named steps, with present/browse chrome and navigation. */
+export function Presentation<TPayload>({
+  steps,
+  title,
+  initialMode = 'browse',
+  brand,
+  attribution,
+  canvas,
+}: PresentationProps<TPayload>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const width = useViewportWidth()
+  const step = steps[nav.index]
+  if (!step) return null
+  const showToc = nav.mode === 'browse' && width >= TOC_MIN_WIDTH
+
+  return (
+    <div
+      role="region"
+      aria-label={title}
+      data-presentation-root=""
+      data-presentation-name={title}
+      data-presentation-mode={nav.mode}
+      data-presentation-step-count={steps.length}
+      data-presentation-step-index={nav.index}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      style={{
+        display: 'grid',
+        gridTemplateRows: 'auto minmax(0, 1fr) auto',
+        width: '100%',
+        height: '100dvh',
+        overflow: 'hidden',
+      }}
+    >
+      <Header
+        brand={brand}
+        mode={nav.mode}
+        title={step.title}
+        era={step.era}
+        index={nav.index}
+        total={steps.length}
+        onToggleMode={nav.toggleMode}
+      />
+      <div
+        data-presentation-main=""
+        style={{ display: 'grid', gridTemplateColumns: showToc ? 'auto minmax(0, 1fr)' : 'minmax(0, 1fr)', minHeight: 0 }}
+      >
+        {showToc ? <Toc eras={steps.map((s) => s.era)} index={nav.index} onGoTo={nav.goTo} /> : null}
+        <Stage step={step} stepIndex={nav.index} mode={nav.mode} canvas={canvas} layoutKey={showToc} />
+      </div>
+      <Footer
+        mode={nav.mode}
+        title={step.title}
+        caption={step.caption}
+        stepTitles={steps.map((s) => s.title)}
+        index={nav.index}
+        attribution={attribution}
+        onGoTo={nav.goTo}
+        onPrev={nav.prev}
+        onNext={nav.next}
+      />
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..68baf731d049b67b3437b2bca8d1c390f7dfbf31
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,60 @@
+import { useRef, type ComponentType } from 'react'
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, EXIT_T } from './constants.ts'
+import { sceneKey } from './sceneKey.ts'
+import { useFitScale } from './useFitScale.ts'
+import type { Canvas, Mode, SceneProps, Step } from './types.ts'
+
+interface StageProps<TPayload> {
+  step: Step<TPayload>
+  stepIndex: number
+  mode: Mode
+  canvas?: Canvas
+  /** Changes when a responsive layout change moves the stage, so the fit scale is measured again. */
+  layoutKey?: unknown
+}
+
+/** Fixed design canvas, scaled to fit, hosting the active step's Scene. */
+export function Stage<TPayload>({ step, stepIndex, mode, canvas, layoutKey }: StageProps<TPayload>) {
+  const areaRef = useRef<HTMLDivElement>(null)
+  const { width, height } = canvas ?? { width: DESIGN_W, height: DESIGN_H }
+  const scale = useFitScale(areaRef, mode, { width, height }, layoutKey)
+  const Scene = step.Scene as ComponentType<SceneProps<TPayload>>
+
+  return (
+    <div
+      ref={areaRef}
+      data-presentation-stage=""
+      style={{ position: 'relative', minWidth: 0, minHeight: 0, overflow: 'hidden' }}
+    >
+      <div
+        data-presentation-canvas=""
+        data-presentation-scale={scale}
+        style={{
+          position: 'absolute',
+          left: '50%',
+          top: '50%',
+          width,
+          height,
+          transform: `translate(-50%, -50%) scale(${scale})`,
+          transformOrigin: 'center',
+        }}
+      >
+        <LayoutGroup>
+          <AnimatePresence initial>
+            <motion.div
+              key={sceneKey(step)}
+              data-presentation-scene=""
+              style={{ position: 'absolute', inset: 0 }}
+              initial={{ opacity: 0 }}
+              animate={{ opacity: 1 }}
+              exit={{ opacity: 0, transition: { duration: EXIT_T } }}
+            >
+              <Scene payload={step.payload as TPayload} stepIndex={stepIndex} />
+            </motion.div>
+          </AnimatePresence>
+        </LayoutGroup>
+      </div>
+    </div>
+  )
+}
diff --git a/src/presentation-kit/chrome/Footer.tsx b/src/presentation-kit/chrome/Footer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1767151f304be31f78a438b158fe319540420f4c
--- /dev/null
+++ b/src/presentation-kit/chrome/Footer.tsx
@@ -0,0 +1,84 @@
+import { ATTRIBUTION_HREF, ATTRIBUTION_TEXT } from '../constants.ts'
+import type { AttributionOptions, Mode } from '../types.ts'
+
+interface FooterProps {
+  mode: Mode
+  title: string
+  caption: string
+  stepTitles: readonly string[]
+  index: number
+  /** `null` hides the attribution; omit for the default "made by and-scene" link. */
+  attribution?: AttributionOptions | null
+  onGoTo: (index: number) => void
+  onPrev: () => void
+  onNext: () => void
+}
+
+const DEFAULT_ATTRIBUTION: AttributionOptions = { text: ATTRIBUTION_TEXT, href: ATTRIBUTION_HREF }
+
+export function Footer({
+  mode,
+  title,
+  caption,
+  stepTitles,
+  index,
+  attribution = DEFAULT_ATTRIBUTION,
+  onGoTo,
+  onPrev,
+  onNext,
+}: FooterProps) {
+  const last = stepTitles.length - 1
+  return (
+    <footer data-presentation-footer="">
+      {mode === 'browse' ? <p data-presentation-caption="">{caption}</p> : null}
+      <div
+        data-presentation-footer-bar=""
+        style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}
+      >
+        {mode === 'present' ? (
+          <p
+            data-presentation-title=""
+            style={{ margin: 0, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}
+          >
+            {title}
+          </p>
+        ) : (
+          <nav
+            aria-label="Progress"
+            data-presentation-progress=""
+            style={{ display: 'flex', alignItems: 'center' }}
+          >
+            <button type="button" data-presentation-prev="" aria-label="Previous step" disabled={index <= 0} onClick={onPrev}>
+              Previous
+            </button>
+            {stepTitles.map((stepTitle, i) => (
+              <button
+                key={i}
+                type="button"
+                data-presentation-dot=""
+                data-presentation-active={i === index ? 'true' : undefined}
+                aria-current={i === index ? 'step' : undefined}
+                aria-label={`Step ${i + 1}: ${stepTitle}`}
+                onClick={() => onGoTo(i)}
+              />
+            ))}
+            <button type="button" data-presentation-next="" aria-label="Next step" disabled={index >= last} onClick={onNext}>
+              Next
+            </button>
+          </nav>
+        )}
+        {attribution ? (
+          <a
+            data-presentation-attribution=""
+            href={attribution.href}
+            target="_blank"
+            rel="noreferrer"
+            style={{ marginLeft: 'auto' }}
+          >
+            {attribution.text}
+          </a>
+        ) : null}
+      </div>
+    </footer>
+  )
+}
diff --git a/src/presentation-kit/chrome/Header.tsx b/src/presentation-kit/chrome/Header.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..429c2e1c39eaeaabb194cd67c5bfadba63cd4b68
--- /dev/null
+++ b/src/presentation-kit/chrome/Header.tsx
@@ -0,0 +1,39 @@
+import type { ReactNode } from 'react'
+import type { Mode } from '../types.ts'
+
+interface HeaderProps {
+  /** Host-provided brand; the kit renders no default brand. */
+  brand?: ReactNode
+  mode: Mode
+  title: string
+  era: string
+  /** Zero-based position of the active step. */
+  index: number
+  total: number
+  onToggleMode: () => void
+}
+
+export function Header({ brand, mode, title, era, index, total, onToggleMode }: HeaderProps) {
+  return (
+    <header
+      data-presentation-header=""
+      style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}
+    >
+      <div data-presentation-brand="">{brand}</div>
+      {mode === 'browse' ? (
+        <h1 data-presentation-title="" style={{ margin: 0 }}>
+          {title}
+        </h1>
+      ) : null}
+      <div data-presentation-header-end="" style={{ display: 'flex', alignItems: 'center' }}>
+        <span data-presentation-marker="">
+          {index + 1} / {total}
+        </span>
+        <span data-presentation-era="">{era}</span>
+        <button type="button" data-presentation-mode-toggle="" onClick={onToggleMode}>
+          {mode === 'browse' ? 'Present' : 'Browse'}
+        </button>
+      </div>
+    </header>
+  )
+}
diff --git a/src/presentation-kit/chrome/Toc.tsx b/src/presentation-kit/chrome/Toc.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4cd0aacc86b0de93c24b2816b1bf9ac86498fae8
--- /dev/null
+++ b/src/presentation-kit/chrome/Toc.tsx
@@ -0,0 +1,34 @@
+import { useMemo } from 'react'
+import { groupEras } from './groupEras.ts'
+
+interface TocProps {
+  eras: readonly string[]
+  index: number
+  onGoTo: (index: number) => void
+}
+
+export function Toc({ eras, index, onGoTo }: TocProps) {
+  const entries = useMemo(() => groupEras(eras), [eras])
+  return (
+    <nav aria-label="Contents" data-presentation-toc="">
+      <ol style={{ listStyle: 'none', margin: 0, padding: 0 }}>
+        {entries.map((entry) => {
+          const active = index >= entry.first && index <= entry.last
+          return (
+            <li key={entry.first}>
+              <button
+                type="button"
+                data-presentation-toc-entry=""
+                data-presentation-active={active ? 'true' : undefined}
+                aria-current={active ? 'step' : undefined}
+                onClick={() => onGoTo(entry.first)}
+              >
+                {entry.era}
+              </button>
+            </li>
+          )
+        })}
+      </ol>
+    </nav>
+  )
+}
