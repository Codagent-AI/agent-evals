+import type { ComponentType } from 'react'
+
+export type Mode = 'browse' | 'present'
+
+export interface SceneProps<TPayload = undefined> {
+  payload: TPayload
+  /** Zero-based position of the active step. */
+  stepIndex: number
+}
+
+interface StepBase<TPayload> {
+  /** Stable identity of the step. */
+  id: string
+  /** Section / era label; consecutive steps sharing a label form one table-of-contents entry. */
+  era: string
+  /** One-line presenter title. */
+  title: string
+  /** Browse-mode caption paragraph. */
+  caption: string
+  /** Diagram component shown while the step is active. */
+  Scene: ComponentType<SceneProps<TPayload>>
+  /**
+   * Adjacent steps with the same groupKey and Scene share one mounted scene instance;
+   * only the payload changes between them.
+   */
+  groupKey?: string
+}
+
+/** A named state of the scene. Numbering is derived from position, never stored. */
+export type Step<TPayload = undefined> = StepBase<TPayload> &
+  (undefined extends TPayload ? { payload?: TPayload } : { payload: TPayload })
+
+export interface Canvas {
+  width: number
+  height: number
+}
+
+export interface AttributionOptions {
+  text: string
+  href: string
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..63ad8dc42312749645751f8a317ee1da37efaeaf
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,63 @@
+import { useLayoutEffect, useState, type RefObject } from 'react'
+import { DESIGN_H, DESIGN_W, MIN_SCALE, STAGE_LAYOUT } from './constants.ts'
+import type { Canvas, Mode } from './types.ts'
+
+const DEFAULT_CANVAS: Canvas = { width: DESIGN_W, height: DESIGN_H }
+
+/** One uniform scale that fits the canvas into the available area for a mode. */
+export function computeFitScale(
+  available: { width: number; height: number },
+  mode: Mode,
+  canvas: Canvas = DEFAULT_CANVAS,
+): number {
+  const { insetX, insetY } = STAGE_LAYOUT[mode]
+  const w = Math.max(0, available.width - insetX * 2)
+  const h = Math.max(0, available.height - insetY * 2)
+  return Math.max(MIN_SCALE, Math.min(w / canvas.width, h / canvas.height))
+}
+
+/**
+ * Measures the stage area and returns the fit scale. It is re-measured when the window or
+ * the viewport-sized presentation root is resized, when the mode or canvas changes, and when
+ * `layoutKey` changes (a responsive layout change that moves the stage, such as the table of
+ * contents appearing). It is never re-measured because navigation made a caption or title
+ * wrap differently, so every step of a viewport and mode shares one scale.
+ */
+export function useFitScale(
+  ref: RefObject<HTMLElement | null>,
+  mode: Mode,
+  canvas: Canvas = DEFAULT_CANVAS,
+  layoutKey?: unknown,
+): number {
+  const [scale, setScale] = useState(1)
+  const { width, height } = canvas
+
+  useLayoutEffect(() => {
+    const el = ref.current
+    if (!el) return
+    const measure = () => {
+      const rect = el.getBoundingClientRect()
+      setScale(computeFitScale({ width: rect.width, height: rect.height }, mode, { width, height }))
+    }
+    measure()
+    let frame = 0
+    // The window event can arrive before the responsive layout has settled: measure again after it.
+    const onResize = () => {
+      measure()
+      cancelAnimationFrame(frame)
+      frame = requestAnimationFrame(measure)
+    }
+    window.addEventListener('resize', onResize)
+    // The root is sized by the viewport alone, so observing it ignores content-driven stage changes.
+    const root = el.closest('[data-presentation-root]')
+    const observer = root && typeof ResizeObserver !== 'undefined' ? new ResizeObserver(measure) : null
+    if (root) observer?.observe(root)
+    return () => {
+      window.removeEventListener('resize', onResize)
+      cancelAnimationFrame(frame)
+      observer?.disconnect()
+    }
+  }, [ref, mode, width, height, layoutKey])
+
+  return scale
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..12de44e80a363d15293560e6cd6f8e14782a7860
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,112 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { SWIPE_MIN } from './constants.ts'
+import type { Mode } from './types.ts'
+
+const INTERACTIVE_SELECTOR = [
+  'a[href]',
+  'button',
+  'input',
+  'select',
+  'textarea',
+  'summary',
+  '[contenteditable]:not([contenteditable="false"])',
+  '[role="button"]',
+  '[role="link"]',
+  '[role="tab"]',
+  '[role="menuitem"]',
+  '[role="checkbox"]',
+  '[role="radio"]',
+  '[role="switch"]',
+  '[role="slider"]',
+  '[role="spinbutton"]',
+  '[role="textbox"]',
+  '[role="combobox"]',
+  '[role="listbox"]',
+  '[role="option"]',
+].join(',')
+
+export function isInteractive(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE_SELECTOR) !== null
+}
+
+export function clamp(index: number, count: number): number {
+  return Math.max(0, Math.min(index, Math.max(0, count - 1)))
+}
+
+type Action = 'next' | 'prev' | 'mode'
+
+const KEY_ACTIONS: Record<string, Action> = {
+  ArrowRight: 'next',
+  ' ': 'next',
+  PageDown: 'next',
+  ArrowLeft: 'prev',
+  PageUp: 'prev',
+  p: 'mode',
+  P: 'mode',
+}
+
+export interface PresentationNav {
+  index: number
+  mode: Mode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  setMode: (mode: Mode) => void
+  toggleMode: () => void
+}
+
+/** Keyboard, touch and programmatic navigation. Clamps at both ends; never wraps. */
+export function usePresentationNav(count: number, initialMode: Mode = 'browse'): PresentationNav {
+  const [rawIndex, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+  const countRef = useRef(count)
+  useEffect(() => {
+    countRef.current = count
+  }, [count])
+
+  const goTo = useCallback((i: number) => setIndex(clamp(i, countRef.current)), [])
+  const next = useCallback(() => setIndex((i) => clamp(i + 1, countRef.current)), [])
+  const prev = useCallback(() => setIndex((i) => clamp(i - 1, countRef.current)), [])
+  const toggleMode = useCallback(() => setMode((m) => (m === 'browse' ? 'present' : 'browse')), [])
+
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey) return
+      const action = KEY_ACTIONS[event.key]
+      if (!action) return
+      if (isInteractive(event.target) || isInteractive(document.activeElement)) return
+      event.preventDefault()
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else toggleMode()
+    }
+
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (event: TouchEvent) => {
+      const touch = event.touches[0]
+      start = touch && !isInteractive(event.target) ? { x: touch.clientX, y: touch.clientY } : null
+    }
+    const onTouchEnd = (event: TouchEvent) => {
+      const touch = event.changedTouches[0]
+      const origin = start
+      start = null
+      if (!origin || !touch) return
+      const dx = touch.clientX - origin.x
+      const dy = touch.clientY - origin.y
+      if (Math.abs(dx) < SWIPE_MIN || Math.abs(dx) <= Math.abs(dy)) return
+      if (dx < 0) next()
+      else prev()
+    }
+
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart, { passive: true })
+    window.addEventListener('touchend', onTouchEnd, { passive: true })
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index: clamp(rawIndex, count), mode, next, prev, goTo, setMode, toggleMode }
+}
