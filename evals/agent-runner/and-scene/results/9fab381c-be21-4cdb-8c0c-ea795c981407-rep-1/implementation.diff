+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/groupEras.ts
@@ -0,0 +1,16 @@
+export interface Entry {
+  era: string
+  first: number
+  last: number
+}
+
+/** Consecutive steps that share an era label form one entry. */
+export function groupEras(eras: readonly string[]): Entry[] {
+  const entries: Entry[] = []
+  eras.forEach((era, i) => {
+    const tail = entries[entries.length - 1]
+    if (tail && tail.era === era) tail.last = i
+    else entries.push({ era, first: i, last: i })
+  })
+  return entries
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/useViewportWidth.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/useViewportWidth.ts
