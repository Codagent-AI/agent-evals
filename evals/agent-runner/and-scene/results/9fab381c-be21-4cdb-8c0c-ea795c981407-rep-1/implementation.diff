+    )
+    edit(path.join(dirCopy, 'src/presentations/index.ts'), (s) => s.replace(/\n\]/, `\n  { slug: 'fx-cross', title: 'cross', load: () => import('./fx-cross/Talk.tsx') },\n]`))
+    const build = run('npm', ['run', 'build'], { cwd: dirCopy })
