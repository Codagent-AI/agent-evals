@@ -0,0 +1,18 @@
+import type { PresentationEntry } from './presentations/index.ts'
+
+export default function Landing({ registry }: { registry: readonly PresentationEntry[] }) {
+  return (
+    <main data-landing="">
+      <h1>and-scene</h1>
