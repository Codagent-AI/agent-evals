+const steps: Step[] = [
+  { id: 'a', era: 'e', title: 'A', caption: 'a', Scene: One, groupKey: 'one' },
+  { id: 'b', era: 'e', title: 'B', caption: 'b', Scene: Two, groupKey: 'two' },
