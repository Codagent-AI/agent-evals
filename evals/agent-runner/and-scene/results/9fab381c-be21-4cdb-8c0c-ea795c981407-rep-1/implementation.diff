diff --git a/skills/presentation/templates/bootstrap/src/resolveRoute.ts b/skills/presentation/templates/bootstrap/src/resolveRoute.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c0a7373c4fda7c1711f2359dee7ce6246669efae
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/resolveRoute.ts
@@ -0,0 +1,10 @@
+import type { PresentationEntry } from './presentations/index.ts'
+
+/** `/` and unknown paths resolve to Landing; `/<slug>` resolves to its registry entry. */
+export function resolveRoute(
+  pathname: string,
+  registry: readonly PresentationEntry[],
+): PresentationEntry | null {
+  const slug = pathname.replace(/^\/+|\/+$/g, '')
+  return registry.find((entry) => entry.slug === slug) ?? null
+}
