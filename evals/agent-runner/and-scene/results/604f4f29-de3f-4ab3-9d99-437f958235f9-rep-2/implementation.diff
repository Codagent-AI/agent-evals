@@ -0,0 +1,55 @@
+import { useEffect, useMemo } from 'react'
+import { Attribution } from './chrome/Attribution'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { Toc } from './chrome/Toc'
+import { Stage } from './Stage'
+import { validateSteps } from './steps'
+import { usePresentationNav } from './usePresentationNav'
+import { useWide } from './useWide'
+import type { PresentationProps } from './types'
+
+/** Composes the stage, chrome, and navigation for an ordered list of steps. */
+export function Presentation<TPayload>({
+  steps,
+  title,
+  initialMode,
+  brand,
+  attribution,
+  className,
+}: PresentationProps<TPayload>) {
+  useMemo(() => validateSteps(steps), [steps])
+  const { index, mode, goTo, next, prev, toggleMode } = usePresentationNav(steps.length, initialMode)
+  const wide = useWide()
+  useEffect(() => {
+    if (title) document.title = title
+  }, [title])
+  const step = steps[index]
+
+  return (
+    <div
+      className={className}
+      data-presentation-root
+      data-presentation-mode={mode}
+      data-step-count={steps.length}
+      data-step-index={index}
+      data-step-id={step.id}
+      style={{ position: 'fixed', inset: 0, display: 'flex', flexDirection: 'column' }}
+    >
+      <Header
+        step={step}
+        index={index}
+        count={steps.length}
+        mode={mode}
+        brand={brand}
+        onToggleMode={toggleMode}
+      />
+      <div data-presentation-main style={{ flex: '1 1 0', minHeight: 0, display: 'flex' }}>
+        {mode === 'browse' && wide && <Toc steps={steps} index={index} onGoTo={goTo} />}
+        <Stage key={mode} steps={steps} index={index} mode={mode} />
+      </div>
+      <Footer steps={steps} index={index} mode={mode} onGoTo={goTo} onPrev={prev} onNext={next} />
+      {attribution !== false && <Attribution {...attribution} />}
+    </div>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..ea7a83e63c98336cd7b5448893eb9431b0e63f34
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
@@ -0,0 +1,79 @@
+import { useRef, useState } from 'react'
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, ENTER_T } from './constants'
+import { sceneKey } from './steps'
+import { StageContext } from './stageContext'
+import { useFitScale } from './useFitScale'
+import type { Mode, Step } from './types'
+
+interface StageProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  index: number
+  mode: Mode
+}
+
+/** Fixed design canvas scaled to fit; hosts the active step's scene and runs entity morphs. */
+export function Stage<TPayload>({ steps, index, mode }: StageProps<TPayload>) {
+  const region = useRef<HTMLDivElement>(null)
+  const scale = useFitScale(region, mode)
+  const step = steps[index]
+  const [firstId] = useState(step.id)
+  const [hasNavigated, setHasNavigated] = useState(false)
+  // Latch during render so newcomers of the very first navigation already see it.
+  if (!hasNavigated && step.id !== firstId) setHasNavigated(true)
+  const { Scene } = step
+
+  return (
+    <div
+      ref={region}
+      data-presentation-stage-region
+      style={{
+        flex: '1 1 0',
+        minWidth: 0,
+        minHeight: 0,
+        display: 'flex',
+        alignItems: 'center',
+        justifyContent: 'center',
+        overflow: 'hidden',
+      }}
+    >
+      <div
+        data-presentation-stage
+        style={{ width: DESIGN_W * scale, height: DESIGN_H * scale, flex: 'none', position: 'relative' }}
+      >
+        <motion.div
+          data-presentation-canvas
+          data-presentation-scale={scale}
+          style={{
+            position: 'absolute',
+            left: 0,
+            top: 0,
+            width: DESIGN_W,
+            height: DESIGN_H,
+            originX: 0,
+            originY: 0,
+            scale,
+          }}
+        >
+          <StageContext.Provider value={{ hasNavigated }}>
+            <LayoutGroup>
+              <AnimatePresence initial={false}>
+                <motion.div
+                  key={sceneKey(step)}
+                  data-presentation-scene
+                  initial={{ opacity: 0 }}
+                  animate={{ opacity: 1 }}
+                  exit={{ opacity: 0 }}
+                  transition={{ duration: ENTER_T }}
+                  style={{ position: 'absolute', inset: 0 }}
+                >
+                  <Scene payload={step.payload} stepId={step.id} stepIndex={index} />
+                </motion.div>
+              </AnimatePresence>
+            </LayoutGroup>
+          </StageContext.Provider>
+        </motion.div>
+      </div>
+    </div>
+  )
+}
