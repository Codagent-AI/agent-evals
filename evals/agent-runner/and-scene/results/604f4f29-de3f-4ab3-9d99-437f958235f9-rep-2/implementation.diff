+
+interface HeaderProps {
+  step: StepMeta
+  index: number
+  count: number
+  mode: Mode
+  brand?: ReactNode
+  onToggleMode: () => void
+}
+
+export function Header({ step, index, count, mode, brand, onToggleMode }: HeaderProps) {
+  return (
+    <header data-presentation-header>
+      <div data-presentation-brand-slot>{brand}</div>
