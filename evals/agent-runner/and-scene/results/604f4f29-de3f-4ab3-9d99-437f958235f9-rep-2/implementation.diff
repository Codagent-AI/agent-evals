diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/fitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/fitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..82a5056aa837a10fd674d32ffddbdc0be0d63b35
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/fitScale.ts
@@ -0,0 +1,19 @@
+import { DESIGN_H, DESIGN_W, MAX_SCALE, MIN_SCALE, STAGE_LAYOUT } from './constants'
+import type { Mode } from './types'
+
+export interface CanvasSize {
+  width: number
+  height: number
+}
+
+/** Uniform scale that fits the design canvas into the stage region for the given mode. */
+export function fitScale(
+  region: CanvasSize,
+  mode: Mode,
+  canvas: CanvasSize = { width: DESIGN_W, height: DESIGN_H },
+): number {
+  const { padX, padY } = STAGE_LAYOUT[mode]
+  const sx = (region.width - padX * 2) / canvas.width
+  const sy = (region.height - padY * 2) / canvas.height
+  return Math.min(MAX_SCALE, Math.max(MIN_SCALE, Math.min(sx, sy)))
+}
