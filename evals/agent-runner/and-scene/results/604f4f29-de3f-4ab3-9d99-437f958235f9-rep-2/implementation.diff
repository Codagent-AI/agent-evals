+++ b/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,28 @@
+import { useLayoutEffect, useState } from 'react'
+import type { RefObject } from 'react'
+import { fitScale } from './fitScale'
+import type { Mode } from './types'
+
+/** Uniform scale fitting the design canvas into the referenced stage region. */
+export function useFitScale(region: RefObject<HTMLElement | null>, mode: Mode): number {
+  const [size, setSize] = useState({ width: 0, height: 0 })
+
+  useLayoutEffect(() => {
+    const el = region.current
+    if (!el) return
+    const measure = () => {
+      const { clientWidth: width, clientHeight: height } = el
+      setSize((s) => (s.width === width && s.height === height ? s : { width, height }))
+    }
+    measure()
+    if (typeof ResizeObserver === 'undefined') {
+      window.addEventListener('resize', measure)
+      return () => window.removeEventListener('resize', measure)
+    }
+    const observer = new ResizeObserver(measure)
+    observer.observe(el)
+    return () => observer.disconnect()
+  }, [region])
+
+  return fitScale(size, mode)
+}
diff --git a/src/presentation-kit/usePresentationNav.ts b/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dd6ee7b5c62bfa606dbbfc2e1a51b827cf78906c
--- /dev/null
+++ b/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,58 @@
+import { useCallback, useEffect, useState } from 'react'
+import { clampIndex, isInteractiveTarget, keyAction, swipeAction } from './nav'
+import type { NavAction } from './nav'
+import type { Mode } from './types'
+
+export function usePresentationNav(count: number, initialMode: Mode = 'browse') {
+  const [index, setIndex] = useState(0)
+  const [mode, setMode] = useState<Mode>(initialMode)
+
+  const goTo = useCallback(
+    (target: number) => setIndex(clampIndex(target, count)),
+    [count],
+  )
+  const next = useCallback(() => setIndex((i) => clampIndex(i + 1, count)), [count])
+  const prev = useCallback(() => setIndex((i) => clampIndex(i - 1, count)), [count])
+  const toggleMode = useCallback(
+    () => setMode((m) => (m === 'browse' ? 'present' : 'browse')),
+    [],
+  )
+
+  useEffect(() => {
+    const run = (action: NavAction) => {
+      if (action === 'next') next()
+      else if (action === 'prev') prev()
+      else toggleMode()
+    }
+    const onKey = (event: KeyboardEvent) => {
+      if (event.ctrlKey || event.metaKey || event.altKey) return
+      if (isInteractiveTarget(event.target)) return
+      const action = keyAction(event.key)
+      if (!action) return
+      event.preventDefault()
+      run(action)
+    }
+    let start: { x: number; y: number } | null = null
+    const onStart = (event: TouchEvent) => {
+      const t = event.touches[0]
+      start = t && !isInteractiveTarget(event.target) ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onEnd = (event: TouchEvent) => {
+      const t = event.changedTouches[0]
+      if (!start || !t) return
+      const action = swipeAction(t.clientX - start.x, t.clientY - start.y)
+      start = null
+      if (action) run(action)
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onStart, { passive: true })
+    window.addEventListener('touchend', onEnd, { passive: true })
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onStart)
+      window.removeEventListener('touchend', onEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, goTo, next, prev, toggleMode }
+}
diff --git a/src/presentation-kit/useWide.ts b/src/presentation-kit/useWide.ts
