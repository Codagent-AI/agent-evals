--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/settle.mjs
@@ -0,0 +1,11 @@
+/**
+ * Waits for step transitions to settle, then runs `capture`. Returns the
+ * milliseconds that elapsed between the call and the capture.
+ */
+export async function settleThenCapture({ settleMs, sleep, now = Date.now, capture }) {
+  const start = now()
+  await sleep(settleMs)
+  const elapsed = now() - start
+  await capture()
+  return elapsed
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/lib/snapshot.mjs b/skills/presentation/templates/bootstrap/scripts/lib/snapshot.mjs
