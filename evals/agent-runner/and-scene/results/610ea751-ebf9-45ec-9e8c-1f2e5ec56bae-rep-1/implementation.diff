diff --git a/scripts/inspect-presentation.mjs b/scripts/inspect-presentation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..236705bdb64591feadcd557e0e8b1374c439c8cb
--- /dev/null
+++ b/scripts/inspect-presentation.mjs
@@ -0,0 +1,114 @@
+// Captures settled per-step screenshots of a presentation from a production
+// preview and prints advisory visual warnings. Warnings never change the exit
+// code: this is an inspection aid, not a gate.
+//
+//   npm run inspect -- <slug> [--out <dir>] [--settle <ms>] [--viewport WxH] [--no-build]
+import { spawnSync } from 'node:child_process'
+import fs from 'node:fs'
+import path from 'node:path'
+import { ATTRIBUTION_HINT, findAttributionIssues, findClippedChrome, findIndistinctActive, findOverlaps, findSmallText, SMALL_TEXT_MIN_PX } from './lib/diagnostics.mjs'
+import { launchBrowser, sleep, startPreview, waitForStepIndex } from './lib/preview.mjs'
+import { settleThenCapture } from './lib/settle.mjs'
+import { collectSnapshot } from './lib/snapshot.mjs'
+
+const root = path.resolve(import.meta.dirname, '..')
+
+function parseArgs(argv) {
+  const opts = { slug: null, out: null, settle: 1300, viewport: '1280x720', build: true }
+  for (let i = 0; i < argv.length; i++) {
+    const a = argv[i]
+    if (a === '--out') opts.out = argv[++i]
+    else if (a === '--settle') opts.settle = Number(argv[++i])
+    else if (a === '--viewport') opts.viewport = argv[++i]
+    else if (a === '--no-build') opts.build = false
+    else if (!a.startsWith('--') && !opts.slug) opts.slug = a
+    else throw new Error(`unknown argument: ${a}`)
+  }
+  if (!opts.slug) throw new Error('usage: inspect-presentation <slug> [--out dir] [--settle ms] [--viewport WxH] [--no-build]')
+  if (!/^\d+x\d+$/.test(opts.viewport)) throw new Error(`invalid viewport: ${opts.viewport}`)
+  return opts
+}
+
+async function main() {
+  const opts = parseArgs(process.argv.slice(2))
+  const [width, height] = opts.viewport.split('x').map(Number)
+  const outDir = path.resolve(root, opts.out ?? path.join('.inspection', opts.slug, opts.viewport))
+  fs.mkdirSync(outDir, { recursive: true })
+
+  if (opts.build) {
+    const res = spawnSync('npm', ['run', 'build'], { cwd: root, encoding: 'utf8' })
+    if (res.status !== 0) {
+      process.stderr.write(`${res.stdout}${res.stderr}`)
+      throw new Error('build failed')
+    }
+  }
+
+  const server = await startPreview(root)
+  let browser
+  const report = { slug: opts.slug, viewport: opts.viewport, settleMs: opts.settle, steps: [], warnings: [] }
+  const warn = (step, text) => {
+    report.warnings.push({ step, text })
+    console.log(`WARN step ${step}: ${text}`)
+  }
+  try {
+    browser = await launchBrowser()
+    const page = await browser.newPage({ viewport: { width, height } })
+    const res = await page.goto(`${server.url}/${opts.slug}`, { waitUntil: 'load' })
+    if (!res?.ok()) throw new Error(`/${opts.slug} responded ${res?.status()}`)
+    await page.waitForSelector('[data-presentation-root]')
+    const count = Number(await page.getAttribute('[data-presentation-root]', 'data-step-count'))
+
+    for (let i = 0; i < count; i++) {
+      const navigatedAt = Date.now()
+      if (i > 0) {
+        await page.keyboard.press('ArrowRight')
+        await waitForStepIndex(page, i, 10000)
+      }
+      const file = path.join(outDir, `step-${String(i + 1).padStart(2, '0')}.png`)
+      let capturedAfterMs = 0
+      await settleThenCapture({
+        settleMs: opts.settle,
+        sleep,
+        capture: async () => {
+          capturedAfterMs = Date.now() - navigatedAt
+          await page.screenshot({ path: file })
+        },
+      })
+      report.steps.push({ step: i + 1, file: path.relative(root, file), capturedAfterMs })
+
+      const snap = await page.evaluate(collectSnapshot)
+      for (const o of findOverlaps(snap.elements)) {
+        warn(i + 1, `overlap between ${o.a} and ${o.b}; fix it or mark the subtree data-presentation-allow-overlap if intentional`)
+      }
+      for (const g of findIndistinctActive(snap.groups)) {
+        warn(i + 1, `active ${g.chrome} is visually indistinct from inactive ones; style [data-presentation-active="true"] / [aria-current]`)
+      }
+      for (const hook of findClippedChrome(snap.clipped)) {
+        warn(i + 1, `content of ${hook} is clipped by its reserved space; shorten it, restyle it, or reduce its padding`)
+      }
+      const small = findSmallText(snap.smallText)
+      if (small.length) {
+        const smallest = small.reduce((a, b) => (a.px <= b.px ? a : b))
+        warn(
+          i + 1,
+          `${small.length} diagram text element(s) render below ${SMALL_TEXT_MIN_PX}px at this viewport (smallest ${smallest.px.toFixed(1)}px: ${smallest.label}); raise the font size or simplify the diagram`,
+        )
+      }
+      if (i === 0) {
+        for (const issue of findAttributionIssues(snap.attribution)) warn(1, `${issue}; ${ATTRIBUTION_HINT}`)
+      }
+    }
+  } finally {
+    await browser?.close()
+    await server.close()
+  }
+
+  fs.writeFileSync(path.join(outDir, 'report.json'), `${JSON.stringify(report, null, 2)}\n`)
+  console.log(`[inspect] ${report.steps.length} screenshots in ${path.relative(root, outDir)}`)
+  console.log(`[inspect] ${report.warnings.length} advisory warning(s)`)
+}
+
+main().catch((err) => {
+  console.error(`[inspect] ${err instanceof Error ? err.message : err}`)
+  process.exitCode = 1
+})
diff --git a/scripts/lib/diagnostics.mjs b/scripts/lib/diagnostics.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..432f6bfdd7f5593eda9bc32bb26cb0fe92fdda5f
--- /dev/null
+++ b/scripts/lib/diagnostics.mjs
@@ -0,0 +1,85 @@
+// Pure analysers for the advisory visual diagnostics. They consume the
+// snapshot produced by `collectSnapshot` (snapshot.mjs) and return warnings.
+
+const OVERLAP_MIN_PX = 2
+const MIN_ATTRIBUTION_FONT_PX = 12
+const MIN_RENDERED_TEXT_PX = 8
+const BROWSER_DEFAULT_LINK_COLORS = new Set(['rgb(0, 0, 238)', 'rgb(158, 158, 255)'])
+
+function intersects(a, b) {
+  const w = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x)
+  const h = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y)
+  return w > OVERLAP_MIN_PX && h > OVERLAP_MIN_PX
+}
+
+/**
+ * Visible text/chrome elements that overlap without an allow-overlap marker.
+ * Elements: `{ id, label, rect, ancestors: id[], allowed }`.
+ */
+export function findOverlaps(elements) {
+  const warnings = []
+  for (let i = 0; i < elements.length; i++) {
+    for (let j = i + 1; j < elements.length; j++) {
+      const a = elements[i]
+      const b = elements[j]
+      if (a.allowed || b.allowed) continue
+      // An element's own text and its box never collide with each other.
+      if (a.id === b.id) continue
+      if (a.ancestors.includes(b.id) || b.ancestors.includes(a.id)) continue
+      if (intersects(a.rect, b.rect)) warnings.push({ a: a.label, b: b.label })
+    }
+  }
+  return warnings
+}
+
+function signature(style) {
+  return JSON.stringify(style)
+}
+
+/**
+ * Groups (`progress`, `toc`) whose active item looks identical to every
+ * inactive item. Groups: `{ name, items: [{ active, style }] }`.
+ */
+export function findIndistinctActive(groups) {
+  const warnings = []
+  for (const group of groups) {
+    const active = group.items.filter((i) => i.active)
+    const inactive = group.items.filter((i) => !i.active)
+    if (active.length === 0 || inactive.length === 0) continue
+    const same = inactive.every((i) => signature(i.style) === signature(active[0].style))
+    if (same) warnings.push({ chrome: group.name })
+  }
+  return warnings
+}
+
+/**
+ * Attribution problems: missing, too small, or browser-default.
+ * `attribution` is `null` or `{ fontSize, color, height }`.
+ */
+export function findAttributionIssues(attribution) {
+  if (!attribution) return ['attribution link is missing']
+  const issues = []
+  if (attribution.fontSize < MIN_ATTRIBUTION_FONT_PX || attribution.height < 16) {
+    issues.push(`attribution link is too small (${attribution.fontSize}px)`)
+  }
+  if (BROWSER_DEFAULT_LINK_COLORS.has(attribution.color)) {
+    issues.push('attribution link uses the browser-default link colour')
+  }
+  return issues
+}
+
+/** Chrome containers whose content overflows (and is hidden by) their box. */
+export function findClippedChrome(clipped) {
+  return [...new Set(clipped)]
+}
+
+/**
+ * Diagram text that renders too small to read once the canvas is scaled to the
+ * viewport. Items: `{ label, px }`, `px` being the rendered font size.
+ */
+export function findSmallText(items) {
+  return items.filter((i) => i.px < MIN_RENDERED_TEXT_PX)
+}
+
+export const SMALL_TEXT_MIN_PX = MIN_RENDERED_TEXT_PX
+export const ATTRIBUTION_HINT = 'style it via the [data-presentation-attribution] hook'
diff --git a/scripts/lib/preview.mjs b/scripts/lib/preview.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3a774952cdff4a45de298ef2e0bac89a8588e125
--- /dev/null
+++ b/scripts/lib/preview.mjs
@@ -0,0 +1,64 @@
+import net from 'node:net'
+import { chromium } from 'playwright'
+import { preview } from 'vite'
+
+export const LOOPBACK = '127.0.0.1'
+
+function freePort() {
+  return new Promise((resolve, reject) => {
+    const srv = net.createServer()
+    srv.once('error', reject)
+    srv.listen(0, LOOPBACK, () => {
+      const { port } = srv.address()
+      srv.close(() => resolve(port))
+    })
+  })
+}
+
+async function waitReady(url, timeoutMs = 15000) {
+  const deadline = Date.now() + timeoutMs
+  for (;;) {
+    try {
+      const res = await fetch(url)
+      if (res.ok) return
+    } catch {
+      // not listening yet
+    }
+    if (Date.now() > deadline) throw new Error(`preview did not become ready at ${url}`)
+    await new Promise((r) => setTimeout(r, 100))
+  }
+}
+
+/** Starts `vite preview` in-process on the IPv4 loopback address. */
+export async function startPreview(root) {
+  const port = await freePort()
+  const server = await preview({
+    root,
+    logLevel: 'error',
+    preview: { host: LOOPBACK, port, strictPort: true, open: false },
+  })
+  const url = `http://${LOOPBACK}:${port}`
+  try {
+    await waitReady(`${url}/`)
+  } catch (err) {
+    await server.close()
+    throw err
+  }
+  return { url, close: () => server.close() }
+}
+
+export function launchBrowser() {
+  const args = process.getuid?.() === 0 ? ['--no-sandbox'] : []
+  return chromium.launch({ headless: true, args })
+}
+
+export const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
+
+/** Resolves once the presentation chrome reports `index` as the active step. */
+export function waitForStepIndex(page, index, timeout) {
+  return page.waitForFunction(
+    (n) => document.querySelector('[data-presentation-root]')?.getAttribute('data-step-index') === String(n),
+    index,
+    { timeout },
+  )
+}
