+/* Visual style for the "How to Use This Skill" presentation. Plain CSS owned by
+   this presentation; the reusable kit supplies hooks only. */
+.htmp {
+  --ink: #f8f3e6;
+  --muted: #b9b09b;
+  --gold: #c7a755;
+  --line: rgba(248, 243, 230, 0.34);
+  --panel: rgba(248, 243, 230, 0.06);
+  --ok: #6fcf97;
+  position: fixed;
+  inset: 0;
+  color: var(--ink);
+  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
+}
+
+/* ---- chrome ---- */
+.htmp [data-presentation-header] {
+  padding: 0 32px;
+  font-size: 14px;
+  color: var(--muted);
+}
+.htmp [data-presentation-marker] {
+  font-variant-numeric: tabular-nums;
+  color: var(--gold);
+  font-weight: 600;
+}
+.htmp [data-presentation-era] {
+  margin-left: 16px;
+  text-transform: uppercase;
+  letter-spacing: 0.12em;
+  font-size: 12px;
+}
+.htmp [data-presentation-deck-title] {
+  margin-left: 16px;
+  color: var(--ink);
+}
+.htmp button {
+  font: inherit;
+  color: var(--ink);
+  background: transparent;
+  cursor: pointer;
+}
+.htmp button:focus-visible,
+.htmp a:focus-visible {
+  outline: 2px solid var(--gold);
+  outline-offset: 2px;
+}
+.htmp [data-presentation-mode-toggle],
