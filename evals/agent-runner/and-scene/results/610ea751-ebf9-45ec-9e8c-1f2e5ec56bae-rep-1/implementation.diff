index 0000000000000000000000000000000000000000..e9b61b0dfe9a2ed1959edebf242f6305342e6c09
--- /dev/null
+++ b/src/Landing.tsx
@@ -0,0 +1,17 @@
+import { PRESENTATIONS } from './presentations'
+
+export default function Landing() {
+  return (
+    <main className="landing">
+      <h1>and-scene</h1>
+      <p>Presentations that evolve as one diagrammatic scene.</p>
+      <ul>
+        {PRESENTATIONS.map((p) => (
+          <li key={p.slug}>
+            <a href={`/${p.slug}`}>{p.title}</a>
+          </li>
+        ))}
+      </ul>
+    </main>
+  )
+}
