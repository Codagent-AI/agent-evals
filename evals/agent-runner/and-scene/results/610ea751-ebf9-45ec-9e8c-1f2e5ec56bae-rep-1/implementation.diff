--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/lib/snapshot.mjs
@@ -0,0 +1,159 @@
+// Runs inside the page (serialised by Playwright), so it must be
+// self-contained: no imports and no references to module scope.
+export function collectSnapshot() {
+  const CHROME_SELECTORS = [
+    '[data-presentation-mode-toggle]',
+    '[data-presentation-prev]',
+    '[data-presentation-next]',
+    '[data-presentation-progress-item]',
+    '[data-presentation-toc-item]',
+    '[data-presentation-attribution]',
+  ]
+  const STYLE_KEYS = [
+    'color',
+    'backgroundColor',
+    'borderTopColor',
+    'borderTopWidth',
+    'borderTopStyle',
+    'borderRadius',
+    'fontWeight',
+    'fontSize',
+    'opacity',
+    'boxShadow',
+    'textDecorationLine',
+    'transform',
+  ]
+
+  function visible(el) {
+    for (let n = el; n && n.nodeType === 1; n = n.parentElement) {
+      const cs = getComputedStyle(n)
+      if (cs.display === 'none' || cs.visibility === 'hidden' || Number(cs.opacity) < 0.05) {
+        return false
+      }
+    }
+    return true
+  }
+
+  function textRect(el) {
+    const range = document.createRange()
+    let rect = null
+    for (const node of el.childNodes) {
+      if (node.nodeType !== 3 || !node.textContent.trim()) continue
+      range.selectNodeContents(node)
+      const r = range.getBoundingClientRect()
+      if (!r.width || !r.height) continue
+      rect = rect
+        ? {
+            x: Math.min(rect.x, r.left),
+            y: Math.min(rect.y, r.top),
+            r: Math.max(rect.r, r.right),
+            b: Math.max(rect.b, r.bottom),
+          }
+        : { x: r.left, y: r.top, r: r.right, b: r.bottom }
+    }
+    return rect && { x: rect.x, y: rect.y, w: rect.r - rect.x, h: rect.b - rect.y }
+  }
+
+  function describe(el) {
+    const id = el.getAttribute('data-presentation-id')
+    const hook = el.getAttributeNames().find((a) => a.startsWith('data-presentation-'))
+    const text = (el.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 40)
+    return `${el.tagName.toLowerCase()}${hook ? `[${hook}${id ? `=${id}` : ''}]` : ''}${text ? ` "${text}"` : ''}`
+  }
+
+  const all = [...document.querySelectorAll('body *')]
+  const ids = new Map(all.map((el, i) => [el, i]))
+  const elements = []
+
+  function add(el, rect) {
+    if (!rect || !visible(el)) return
+    const ancestors = []
+    for (let p = el.parentElement; p; p = p.parentElement) {
+      if (ids.has(p)) ancestors.push(ids.get(p))
+    }
+    elements.push({
+      id: ids.get(el),
+      label: describe(el),
+      rect,
+      ancestors,
+      allowed: el.closest('[data-presentation-allow-overlap]') !== null,
+    })
+  }
+
+  for (const el of all) {
+    if (el.closest('svg')) continue
+    add(el, textRect(el))
+  }
+  for (const el of document.querySelectorAll(CHROME_SELECTORS.join(','))) {
+    const r = el.getBoundingClientRect()
+    add(el, { x: r.left, y: r.top, w: r.width, h: r.height })
+  }
+
+  function styleOf(el) {
+    const cs = getComputedStyle(el)
+    const style = Object.fromEntries(STYLE_KEYS.map((k) => [k, cs[k]]))
+    // Text items differ in intrinsic size; only compare size for glyph-only items.
+    if (!el.textContent.trim()) {
+      style.width = cs.width
+      style.height = cs.height
+    }
+    return style
+  }
+  function group(name, selector) {
+    return {
+      name,
+      items: [...document.querySelectorAll(selector)].map((el) => ({
+        active:
+          el.getAttribute('aria-current') === 'step' ||
+          el.getAttribute('data-presentation-active') === 'true',
+        style: styleOf(el),
+      })),
+    }
+  }
+
+  const attr = document.querySelector('[data-presentation-attribution]')
+  const attribution = attr
+    ? (() => {
+        const cs = getComputedStyle(attr)
+        return {
+          fontSize: parseFloat(cs.fontSize),
+          color: cs.color,
+          height: attr.getBoundingClientRect().height,
+        }
+      })()
+    : null
+
+  const clipped = [
+    '[data-presentation-header]',
+    '[data-presentation-footer]',
+    '[data-presentation-toc]',
+  ].flatMap((sel) =>
+    [...document.querySelectorAll(sel)]
+      .filter((el) => el.scrollHeight > el.clientHeight + 1 || el.scrollWidth > el.clientWidth + 1)
+      .map(() => sel.slice(1, -1)),
+  )
+
+  // Diagram text is drawn on the scaled canvas: its rendered size is the
+  // computed size times the canvas scale.
+  const smallText = []
+  for (const canvas of document.querySelectorAll('[data-presentation-canvas]')) {
+    const scale = Number(canvas.getAttribute('data-presentation-scale')) || 1
+    for (const el of canvas.querySelectorAll('*')) {
+      if (el.closest('svg') || !textRect(el) || !visible(el)) continue
+      smallText.push({ label: describe(el), px: parseFloat(getComputedStyle(el).fontSize) * scale })
+    }
+  }
+
+  const root = document.querySelector('[data-presentation-root]')
+  return {
+    clipped,
+    smallText,
+    stepIndex: root ? Number(root.getAttribute('data-step-index')) : -1,
+    elements,
+    groups: [
+      group('progress indicator', '[data-presentation-progress-item]'),
+      group('table of contents', '[data-presentation-toc-item]'),
+    ],
+    attribution,
+  }
+}
diff --git a/skills/presentation/templates/bootstrap/scripts/verify.mjs b/skills/presentation/templates/bootstrap/scripts/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ea724ebaddae25fa1ddbe5b5c0e49444b62c620c
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/scripts/verify.mjs
@@ -0,0 +1,136 @@
+// Deterministic verification: production build, then a real-browser render of
+// every registered presentation through every step. Exits non-zero on failure.
+import { spawnSync } from 'node:child_process'
+import fs from 'node:fs'
+import path from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { readRegisteredSlugs } from './lib/registry.mjs'
+import { launchBrowser, sleep, startPreview, waitForStepIndex } from './lib/preview.mjs'
+
+const root = path.resolve(import.meta.dirname, '..')
+const SETTLE_MS = Number(process.env.VERIFY_SETTLE_MS ?? 400)
+const STEP_TIMEOUT_MS = 4000
+
+class VerifyError extends Error {
+  constructor(phase, message, step) {
+    super(message)
+    this.phase = phase
+    this.step = step
+  }
+}
+
+const log = (msg) => console.log(`[verify] ${msg}`)
+
+function phaseBuild() {
+  const res = spawnSync('npm', ['run', 'build'], { cwd: root, encoding: 'utf8' })
+  if (res.status !== 0) {
+    process.stderr.write(`${res.stdout ?? ''}${res.stderr ?? ''}`)
+    throw new VerifyError('build', `npm run build exited with status ${res.status}`)
+  }
+  log('build: ok')
+}
+
+async function loadOutline() {
+  const file = path.join(root, 'scripts', 'reference-outline.mjs')
+  return fs.existsSync(file) ? import(pathToFileURL(file).href) : null
+}
+
+function phaseRegistry(slugs, reference) {
+  if (!reference) return
+  if (!slugs.includes(reference.REFERENCE_SLUG)) {
+    throw new VerifyError(
+      'registry',
+      `reference presentation "${reference.REFERENCE_SLUG}" is not registered in src/presentations/index.ts`,
+    )
+  }
+  log(`registry: reference presentation "${reference.REFERENCE_SLUG}" registered`)
+}
+
+async function stepThrough(page, url, slug, outline) {
+  const errors = []
+  let current = 0
+  const record = (text) => errors.push({ step: current, text })
+  page.on('console', (msg) => msg.type() === 'error' && record(`console.error: ${msg.text()}`))
+  page.on('pageerror', (err) => record(`uncaught error: ${err.message}`))
+
+  const res = await page.goto(`${url}/${slug}`, { waitUntil: 'load' })
+  if (!res?.ok()) throw new VerifyError('render', `/${slug} responded ${res?.status()}`, 0)
+  try {
+    await page.waitForSelector('[data-presentation-root]', { timeout: STEP_TIMEOUT_MS })
+  } catch {
+    throw new VerifyError('render', `/${slug} rendered no presentation`, 0)
+  }
+  const count = Number(await page.getAttribute('[data-presentation-root]', 'data-step-count'))
+  if (outline && count !== outline.length) {
+    throw new VerifyError('outline', `expected ${outline.length} steps, found ${count}`)
+  }
+
+  for (let i = 0; i < count; i++) {
+    if (i > 0) {
+      current = i
+      await page.keyboard.press('ArrowRight')
+      try {
+        await waitForStepIndex(page, i, STEP_TIMEOUT_MS)
+      } catch {
+        throw new VerifyError('render', `step ${i + 1} transition did not advance the step index`, i)
+      }
+    }
+    await sleep(SETTLE_MS)
+    if (outline) {
+      const title = await page.textContent('[data-presentation-title]')
+      const caption = await page.textContent('[data-presentation-caption]')
+      const want = outline[i]
+      if (title !== want.title || caption !== want.caption) {
+        throw new VerifyError(
+          'outline',
+          `step ${i + 1} does not match the reference outline (expected "${want.title}", found "${title}")`,
+          i,
+        )
+      }
+    }
+    const failure = errors.find((e) => e.step <= i)
+    if (failure) {
+      throw new VerifyError('render', `step ${failure.step + 1} emitted ${failure.text}`, failure.step)
+    }
+  }
+  log(`render: /${slug} ok (${count} steps)`)
+}
+
+async function phaseRender(slugs, reference) {
+  if (slugs.length === 0) throw new VerifyError('registry', 'no presentations are registered')
+  const server = await startPreview(root)
+  log(`preview: ${server.url}`)
+  let browser
+  try {
+    browser = await launchBrowser()
+    for (const slug of slugs) {
+      const outline = reference && slug === reference.REFERENCE_SLUG ? reference.REFERENCE_OUTLINE : null
+      const page = await browser.newPage()
+      try {
+        await stepThrough(page, server.url, slug, outline)
+      } finally {
+        await page.close()
+      }
+    }
+  } finally {
+    await browser?.close()
+    await server.close()
+  }
+}
+
+try {
+  phaseBuild()
+  const reference = await loadOutline()
+  const slugs = readRegisteredSlugs(root)
+  phaseRegistry(slugs, reference)
+  await phaseRender(slugs, reference)
+  log('PASS')
+} catch (err) {
+  if (err instanceof VerifyError) {
+    const where = err.step === undefined ? '' : ` (step ${err.step + 1})`
+    console.error(`[verify] FAIL ${err.phase}${where}: ${err.message}`)
+  } else {
+    console.error(`[verify] FAIL render: ${err instanceof Error ? err.message : err}`)
+  }
+  process.exitCode = 1
+}
