+import { ATTRIBUTION_HREF, ATTRIBUTION_LABEL, type AttributionOption } from './attribution'
+
+export function Attribution({ option }: { option?: AttributionOption }) {
+  if (option === false) return null
+  return (
+    <a
+      data-presentation-attribution=""
+      href={option?.href ?? ATTRIBUTION_HREF}
+      target="_blank"
+      rel="noreferrer noopener"
+      style={{ position: 'absolute', right: 0, bottom: 0 }}
+    >
+      {option?.label ?? ATTRIBUTION_LABEL}
+    </a>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/Footer.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/Footer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a86b4ba8350769dabea3886fde9ee280bff3ac0f
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/Footer.tsx
@@ -0,0 +1,80 @@
+import type { PresentationMode, Step } from '../types'
+
+interface FooterProps<T> {
+  height: number
+  steps: Step<T>[]
+  index: number
+  mode: PresentationMode
+  onPrev: () => void
+  onNext: () => void
+  onJump: (index: number) => void
+}
+
+export function Footer<T>({ height, steps, index, mode, onPrev, onNext, onJump }: FooterProps<T>) {
+  const step = steps[index]
+  const browse = mode === 'browse'
+  return (
+    <footer
+      data-presentation-footer=""
+      style={{
+        position: 'absolute',
+        bottom: 0,
+        left: 0,
+        right: 0,
+        height,
+        display: 'flex',
+        flexDirection: 'column',
+        justifyContent: 'center',
+        overflow: 'hidden',
+      }}
+    >
+      <h2 data-presentation-title="">
+        {step.title}
+      </h2>
+      {browse ? (
+        <>
+          <p data-presentation-caption="">
+            {step.caption}
+          </p>
+          <div style={{ display: 'flex', alignItems: 'center' }}>
+            <button
+              type="button"
+              data-presentation-prev=""
+              aria-label="Previous step"
+              disabled={index === 0}
+              onClick={onPrev}
+            >
+              Prev
+            </button>
+            <nav
+              data-presentation-progress=""
+              aria-label="Step progress"
+              style={{ display: 'flex', alignItems: 'center' }}
+            >
+              {steps.map((s, i) => (
+                <button
+                  key={s.id}
+                  type="button"
+                  data-presentation-progress-item=""
+                  data-presentation-active={i === index ? 'true' : 'false'}
+                  aria-current={i === index ? 'step' : undefined}
+                  aria-label={`Step ${i + 1}: ${s.title}`}
+                  onClick={() => onJump(i)}
+                />
+              ))}
+            </nav>
+            <button
+              type="button"
+              data-presentation-next=""
+              aria-label="Next step"
+              disabled={index === steps.length - 1}
+              onClick={onNext}
+            >
+              Next
+            </button>
+          </div>
+        </>
+      ) : null}
+    </footer>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/Header.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/Header.tsx
new file mode 100644
