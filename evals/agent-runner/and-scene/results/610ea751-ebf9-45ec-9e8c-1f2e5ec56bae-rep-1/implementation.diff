+import { lazy, StrictMode, Suspense } from 'react'
+import { createRoot } from 'react-dom/client'
+import './index.css'
+import Landing from './Landing.tsx'
+import { findPresentation, slugFromPath } from './presentations'
+
+// Pathname routing: each page load resolves exactly one route.
+const entry = findPresentation(slugFromPath(window.location.pathname))
+const Talk = entry ? lazy(entry.load) : null
+
+createRoot(document.getElementById('root')!).render(
+  <StrictMode>
+    {Talk ? (
+      <Suspense fallback={null}>
+        <Talk />
+      </Suspense>
+    ) : (
+      <Landing />
+    )}
+  </StrictMode>,
+)
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/Presentation.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..228a41b2ee8d256ee3ea2695f22d8d269e4ef8e8
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,91 @@
+import type { ReactNode } from 'react'
+import { STAGE_LAYOUT } from './constants'
+import { Attribution } from './chrome/Attribution'
+import type { AttributionOption } from './chrome/attribution'
+import { Footer } from './chrome/Footer'
+import { Header } from './chrome/Header'
+import { Toc } from './chrome/Toc'
+import { Stage } from './Stage'
+import { tocVisible, useViewport } from './useFitScale'
+import { usePresentationNav } from './usePresentationNav'
+import type { CanvasSize, PresentationMode, Step } from './types'
+
+export interface PresentationProps<T> {
+  steps: Step<T>[]
+  title?: string
+  initialMode?: PresentationMode
+  canvas?: CanvasSize
+  /** Host-provided header brand. Nothing is rendered when omitted. */
+  brand?: ReactNode
+  attribution?: AttributionOption
+}
+
+export function Presentation<T>({
+  steps,
+  title,
+  initialMode = 'present',
+  canvas,
+  brand,
+  attribution,
+}: PresentationProps<T>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const { width: viewportWidth } = useViewport()
+  const geometry = STAGE_LAYOUT[nav.mode]
+  const showToc = tocVisible(nav.mode, viewportWidth)
+  const tocWidth = showToc ? geometry.tocWidth : 0
+  const step = steps[nav.index]
+
+  return (
+    <div
+      data-presentation-root=""
+      data-presentation-mode={nav.mode}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      data-step-id={step.id}
+      style={{ position: 'fixed', inset: 0, overflow: 'hidden' }}
+    >
+      <Header
+        height={geometry.top}
+        stepNumber={nav.index + 1}
+        stepCount={steps.length}
+        era={step.era}
+        mode={nav.mode}
+        onToggleMode={nav.toggleMode}
+        brand={brand}
+        title={title}
+      />
+      {showToc ? (
+        <Toc
+          steps={steps}
+          index={nav.index}
+          top={geometry.top}
+          bottom={geometry.bottom}
+          width={tocWidth}
+          onJump={nav.goTo}
+        />
+      ) : null}
+      <Stage
+        step={step}
+        stepIndex={nav.index}
+        mode={nav.mode}
+        canvas={canvas}
+        inset={{
+          top: geometry.top,
+          bottom: geometry.bottom,
+          left: tocWidth + geometry.side,
+          right: geometry.side,
+        }}
+      />
+      <Footer
+        height={geometry.bottom}
+        steps={steps}
+        index={nav.index}
+        mode={nav.mode}
+        onPrev={nav.prev}
+        onNext={nav.next}
+        onJump={nav.goTo}
+      />
+      <Attribution option={attribution} />
+    </div>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d8c8d636100c4a940bc1bf155ca8cb128578a294
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/Stage.tsx
@@ -0,0 +1,66 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, EXIT_T } from './constants'
+import { sceneKey } from './sceneKey'
+import { useFitScale } from './useFitScale'
+import type { CanvasSize, PresentationMode, Step } from './types'
+
+interface StageProps<T> {
+  step: Step<T>
+  stepIndex: number
+  mode: PresentationMode
+  canvas?: CanvasSize
+  /** Inset, in px, between the viewport edges and the stage area. */
+  inset: { top: number; bottom: number; left: number; right: number }
+}
+
+/** Mounts the active step's scene inside the fixed, uniformly scaled canvas. */
+export function Stage<T>({ step, stepIndex, mode, canvas, inset }: StageProps<T>) {
+  const scale = useFitScale(mode, canvas)
+  const width = canvas?.width ?? DESIGN_W
+  const height = canvas?.height ?? DESIGN_H
+  const { Scene, payload } = step
+  return (
+    <div
+      data-presentation-stage=""
+      style={{
+        position: 'absolute',
+        ...inset,
+        display: 'flex',
+        alignItems: 'center',
+        justifyContent: 'center',
+        overflow: 'hidden',
+      }}
+    >
+      <div style={{ width: width * scale, height: height * scale, position: 'relative' }}>
+        <div
+          data-presentation-canvas=""
+          data-presentation-scale={scale.toFixed(4)}
+          style={{
+            position: 'absolute',
+            left: 0,
+            top: 0,
+            width,
+            height,
+            transform: `scale(${scale})`,
+            transformOrigin: 'top left',
+          }}
+        >
+          <LayoutGroup>
+            <AnimatePresence initial={false}>
+              <motion.div
+                key={sceneKey(step)}
+                data-presentation-scene=""
+                initial={{ opacity: 0 }}
+                animate={{ opacity: 1 }}
+                exit={{ opacity: 0, transition: { duration: EXIT_T } }}
+                style={{ position: 'absolute', inset: 0 }}
+              >
+                <Scene payload={payload} stepIndex={stepIndex} />
+              </motion.div>
+            </AnimatePresence>
+          </LayoutGroup>
+        </div>
+      </div>
+    </div>
+  )
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/Attribution.tsx b/skills/presentation/templates/bootstrap/src/presentation-kit/chrome/Attribution.tsx
