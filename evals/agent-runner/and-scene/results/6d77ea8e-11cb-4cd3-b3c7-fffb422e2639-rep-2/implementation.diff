+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
@@ -0,0 +1,15 @@
+import type { AnyStep } from './types'
+
+const sceneIds = new WeakMap<object, number>()
+let nextId = 0
+
+/**
+ * Key for the Stage's presence child. Steps sharing `groupKey` and the same
+ * Scene component share a key (instance persists); all others get their own.
+ */
+export function stageKey(step: AnyStep): string {
+  if (step.groupKey === undefined) return `step:${step.id}`
+  let id = sceneIds.get(step.Scene)
+  if (id === undefined) sceneIds.set(step.Scene, (id = nextId++))
+  return `group:${step.groupKey}:${id}`
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/types.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/types.ts
new file mode 100644
index 0000000000000000000000000000000000000000..99ba77851f0113f9eee8664806d01991b45cf156
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/types.ts
@@ -0,0 +1,40 @@
+import type { ComponentType } from 'react'
+
+/** Narration and identity shared by every step. */
+export interface StepMeta {
+  /** Stable id; never derived from position. */
+  id: string
+  /** Section / era label; consecutive steps with the same label form one TOC entry. */
+  era: string
+  /** Presenter title (one-liner). */
+  title: string
+  /** Browse caption (paragraph). */
+  caption: string
+}
+
+/** Props every Scene component receives. */
+export interface SceneProps<TPayload = undefined> {
+  step: StepMeta
+  /** Zero-based position of the active step. */
+  index: number
+  payload: TPayload
+}
+
+export type Scene<TPayload = undefined> = ComponentType<SceneProps<TPayload>>
+
+type PayloadField<TPayload> = undefined extends TPayload
+  ? { payload?: TPayload }
+  : { payload: TPayload }
+
+/**
+ * One step of a presentation. Adjacent steps sharing `groupKey` and the same
+ * `Scene` keep a single scene instance; only `payload` changes.
+ */
+export type Step<TPayload = undefined> = StepMeta & {
+  Scene: Scene<TPayload>
+  groupKey?: string
+} & PayloadField<TPayload>
+
+/** Escape hatch for decks that mix scenes with different payload types. */
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export type AnyStep = Step<any>
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b37c9d9fc9090423f41866536e425f8b6672bc86
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/useFitScale.ts
@@ -0,0 +1,42 @@
+import { useLayoutEffect, useState, type RefObject } from 'react'
+import { DESIGN_H, DESIGN_W, STAGE_LAYOUT, type PresentationMode } from './constants'
+import { computeFitScale } from './fitScale'
+
+/**
+ * Scale for the fixed canvas given the stage region (between header and
+ * footer). Constant within a mode; switching mode is just a re-render.
+ */
+export function useFitScale(
+  regionRef: RefObject<HTMLElement | null>,
+  mode: PresentationMode,
+  designW: number = DESIGN_W,
+  designH: number = DESIGN_H,
+  /** Re-attach measurement when the region element mounts later (e.g. steps load async). */
+  enabled = true,
+): number {
+  const geometry = STAGE_LAYOUT[mode]
+  const [size, setSize] = useState<{ w: number; h: number }>(() => ({
+    w: typeof window === 'undefined' ? designW : window.innerWidth,
+    h: typeof window === 'undefined' ? designH : window.innerHeight,
+  }))
+
+  useLayoutEffect(() => {
+    const el = regionRef.current
+    if (!el) return
+    const measure = () => {
+      const r = el.getBoundingClientRect()
+      if (r.width === 0 && r.height === 0) return
+      setSize((s) => (s.w === r.width && s.h === r.height ? s : { w: r.width, h: r.height }))
+    }
+    measure()
+    if (typeof ResizeObserver === 'undefined') {
+      window.addEventListener('resize', measure)
+      return () => window.removeEventListener('resize', measure)
+    }
+    const ro = new ResizeObserver(measure)
+    ro.observe(el)
+    return () => ro.disconnect()
+  }, [regionRef, enabled])
+
+  return computeFitScale(size.w, size.h, geometry, designW, designH)
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b7e29a2bf1465ffdb28310da5097f58d5ce7bb4c
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/usePresentationNav.ts
@@ -0,0 +1,95 @@
+import { useCallback, useEffect, useState } from 'react'
+import type { PresentationMode } from './constants'
+
+const INTERACTIVE =
+  'button, a[href], input, select, textarea, summary, [contenteditable]:not([contenteditable="false"]), [role="button"], [role="link"], [role="tab"], [role="menuitem"], [role="slider"], [role="textbox"]'
+
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+  return target instanceof Element && target.closest(INTERACTIVE) !== null
+}
+
+export const SWIPE_MIN_DISTANCE = 40
+
+/** Horizontal swipe resolution: -1 = next (swipe left), 1 = prev (swipe right), 0 = none. */
+export function resolveSwipe(dx: number, dy: number): -1 | 0 | 1 {
+  if (Math.abs(dx) < SWIPE_MIN_DISTANCE || Math.abs(dx) < Math.abs(dy) * 1.5) return 0
+  return dx < 0 ? -1 : 1
+}
+
+export interface PresentationNav {
+  index: number
+  mode: PresentationMode
+  next: () => void
+  prev: () => void
+  goTo: (index: number) => void
+  toggleMode: () => void
+  setMode: (mode: PresentationMode) => void
+}
+
+export function usePresentationNav(
+  count: number,
+  initialMode: PresentationMode = 'present',
+): PresentationNav {
+  const last = Math.max(0, count - 1)
+  const [rawIndex, setIndex] = useState(0)
+  const [mode, setMode] = useState<PresentationMode>(initialMode)
+  const index = Math.min(rawIndex, last)
+
+  const goTo = useCallback(
+    (i: number) => setIndex(Math.min(last, Math.max(0, Math.trunc(i)))),
+    [last],
+  )
+  const next = useCallback(() => setIndex((i) => Math.min(last, Math.min(i, last) + 1)), [last])
+  const prev = useCallback(() => setIndex((i) => Math.max(0, Math.min(i, last) - 1)), [last])
+  const toggleMode = useCallback(
+    () => setMode((m) => (m === 'present' ? 'browse' : 'present')),
+    [],
+  )
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey) return
+      if (isInteractiveTarget(e.target)) return
+      switch (e.key) {
+        case 'ArrowRight':
+        case 'PageDown':
+        case ' ':
+          e.preventDefault()
+          next()
+          break
+        case 'ArrowLeft':
+        case 'PageUp':
+          e.preventDefault()
+          prev()
+          break
+        case 'p':
+        case 'P':
+          toggleMode()
+          break
+      }
+    }
+    let start: { x: number; y: number } | null = null
+    const onTouchStart = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      start = t && !isInteractiveTarget(e.target) ? { x: t.clientX, y: t.clientY } : null
+    }
+    const onTouchEnd = (e: TouchEvent) => {
+      const t = e.changedTouches[0]
+      if (!start || !t) return
+      const dir = resolveSwipe(t.clientX - start.x, t.clientY - start.y)
+      start = null
+      if (dir < 0) next()
+      else if (dir > 0) prev()
+    }
+    window.addEventListener('keydown', onKey)
+    window.addEventListener('touchstart', onTouchStart, { passive: true })
+    window.addEventListener('touchend', onTouchEnd, { passive: true })
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      window.removeEventListener('touchstart', onTouchStart)
+      window.removeEventListener('touchend', onTouchEnd)
+    }
+  }, [next, prev, toggleMode])
+
+  return { index, mode, next, prev, goTo, toggleMode, setMode }
+}
diff --git a/skills/presentation/templates/bootstrap/src/presentations/index.ts b/skills/presentation/templates/bootstrap/src/presentations/index.ts
