+*, *::before, *::after { box-sizing: border-box; }
+html, body, #root { min-width: 320px; min-height: 100%; margin: 0; }
+button, input, textarea, select { font: inherit; }
+.presentation { position: relative; width: 100vw; height: 100dvh; overflow: hidden; }
+.presentation-header { position: absolute; inset: 0 0 auto; display: flex; justify-content: space-between; align-items: start; padding: 1rem; }
+.presentation-heading { width: 100%; display: flex; justify-content: space-between; align-items: center; }
+.presentation-mode-tools { display: flex; gap: .75rem; align-items: center; }
+.presentation-toc { position: absolute; z-index: 1; inset: 50% auto auto 1rem; display: flex; flex-direction: column; transform: translateY(-50%); }
+.presentation-viewport { position: absolute; inset: 0; display: grid; place-items: center; touch-action: pan-y; }
+.presentation--browse .presentation-viewport { top: 92px; bottom: 170px; }
+.presentation--present .presentation-viewport { top: 72px; bottom: 112px; }
+.presentation-stage { position: relative; }
+.presentation-canvas { position: absolute; inset: 0 auto auto 0; }
+.presentation-scene { position: absolute; inset: 0; }
+.presentation-footer { position: absolute; inset: auto 0 1rem; display: flex; justify-content: space-between; align-items: end; gap: 1rem; padding: 1rem; }
+.presentation-narration { max-width: min(42rem, 65vw); }
+.presentation-navigation, .presentation-progress { display: flex; align-items: center; gap: .5rem; }
+.presentation-attribution { position: absolute; right: 1rem; bottom: .25rem; }
+.presentation-visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
+.presentation--present .presentation-footer { justify-content: center; }
+@media (max-width: 700px) { .presentation-toc { display: none; } .presentation-footer { flex-direction: column; align-items: stretch; } .presentation-navigation { justify-content: space-between; } }
