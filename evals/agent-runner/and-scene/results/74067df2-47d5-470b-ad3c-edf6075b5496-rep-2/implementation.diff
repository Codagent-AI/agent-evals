+
+export interface HeaderProps extends Omit<HTMLAttributes<HTMLElement>, 'title'> {
+  /** Host-provided branding for the top-left slot; empty by default. */
+  brand?: ReactNode
+  marker: string
+  /** Shown in browse mode only. */
