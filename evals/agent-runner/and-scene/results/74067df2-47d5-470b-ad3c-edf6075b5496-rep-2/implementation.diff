+}
+
+export interface Step<TPayload = undefined> extends StepMeta {
+  /** Adjacent steps sharing a groupKey and Scene keep one scene instance. */
+  groupKey?: string
+  Scene: ComponentType<SceneProps<TPayload>>
+  payload: TPayload
+}
+
+export interface Canvas {
