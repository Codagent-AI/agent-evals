+  mode: Mode
+  onToggleMode: () => void
+  height: number
+}
+
+export function Header({ brand, marker, title, mode, onToggleMode, height, style, ...rest }: HeaderProps) {
+  const target = mode === 'browse' ? 'present' : 'browse'
+  return (
+    <header
+      data-presentation-header=""
+      {...rest}
