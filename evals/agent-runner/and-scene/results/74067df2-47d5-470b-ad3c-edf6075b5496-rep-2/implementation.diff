+      <span data-presentation-marker="">{marker}</span>
+      {title !== undefined && <h2 data-presentation-title="">{title}</h2>}
+      <button type="button" data-presentation-mode-toggle={mode} aria-label={`Switch to ${target} mode`} onClick={onToggleMode}>
+        {target}
+      </button>
+    </header>
+  )
+}
