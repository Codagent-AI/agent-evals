+export function Footer<T>({ step, title, mode, steps, index, goTo, prev, next }: { step: Step<T>; title: string; mode: 'browse' | 'present'; steps: readonly Step<T>[]; index: number; goTo: (i: number) => void; prev: () => void; next: () => void }) {
+  return <footer className={`presentation-footer ${mode}`} data-presentation-footer><div className="footer-copy">{mode === 'browse' ? <><span className="presentation-era">{step.era}</span><h1>{step.title}</h1><p>{step.caption}</p></> : <><span className="presentation-era">{step.era}</span><h1>{step.title || title}</h1></>}</div>{mode === 'browse' && <div className="presentation-controls"><nav className="presentation-progress" aria-label="Step progress">{steps.map((item, i) => <button key={item.id} type="button" aria-label={`Go to step ${i + 1}: ${item.title}`} aria-current={index === i ? 'step' : undefined} data-presentation-progress data-presentation-active={index === i || undefined} onClick={() => goTo(i)} />)}</nav><button type="button" onClick={prev} aria-label="Previous step">←</button><button type="button" onClick={next} aria-label="Next step">→</button></div>}<a className="presentation-attribution" data-presentation-attribution href="https://github.com/Codagent-AI/and-scene" target="_blank" rel="noreferrer">made by and-scene</a></footer>
+}
