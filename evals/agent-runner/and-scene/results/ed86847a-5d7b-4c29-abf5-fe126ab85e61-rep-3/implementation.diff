+  'borderRadius', 'boxShadow', 'textShadow', 'filter', 'backdropFilter', 'fontFamily', 'fontSize', 'fontWeight',
+  'fontStyle', 'letterSpacing', 'lineHeight', 'textDecoration', 'textTransform', 'outline', 'padding', 'margin',
