+              ))}
+            </nav>
+            <button
+              type="button"
+              data-presentation-next=""
+              onClick={onNext}
+              disabled={index === steps.length - 1}
+            >
+              Next
+            </button>
+          </div>
+        </>
+      )}
+    </footer>
+  )
+}
