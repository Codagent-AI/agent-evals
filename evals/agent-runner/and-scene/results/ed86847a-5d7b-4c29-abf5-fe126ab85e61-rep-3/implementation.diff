@@ -0,0 +1,36 @@
+import type { CSSProperties, HTMLAttributes } from 'react'
+
+/** Position of a node on the design canvas (layout geometry, not visual style). */
+export interface Placement {
+  x?: number
+  y?: number
+  w?: number
+  h?: number
+}
+
+export interface NodeProps {
+  /** Stable entity identity: used as the `layoutId` so the node morphs across steps. */
+  id: string
+  className?: string
+  style?: CSSProperties
+}
+
+export type DomPassthrough = Omit<
+  HTMLAttributes<HTMLElement>,
+  'id' | 'className' | 'style' | 'onDrag' | 'onDragStart' | 'onDragEnd' | 'onAnimationStart' | 'onAnimationEnd'
+>
+
+/** Absolute placement inline style; caller `style` wins. */
+export function placementStyle(p: Placement, style?: CSSProperties): CSSProperties {
+  return {
+    position: 'absolute',
+    ...(p.x !== undefined && { left: p.x }),
+    ...(p.y !== undefined && { top: p.y }),
+    ...(p.w !== undefined && { width: p.w }),
+    ...(p.h !== undefined && { height: p.h }),
+    ...style,
+  }
+}
+
+/** Any `data-*` attribute, so authors can add their own styling/test hooks. */
+export type DataAttrs = { [K in `data-${string}`]?: string | number | boolean }
diff --git a/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b76b51be9e1f096b1693f5cae870f3d0e8658224
--- /dev/null
+++ b/skills/presentation/templates/bootstrap/src/presentation-kit/sceneKey.ts
@@ -0,0 +1,18 @@
+import type { Step } from './types.ts'
+
+let nextSceneId = 0
+const sceneIds = new WeakMap<object, number>()
+
+/**
+ * Identity of the mounted scene instance. Steps persist only when they share
+ * both a group key and the same Scene component; anything else remounts.
+ */
+export function sceneKey(step: Pick<Step<never>, 'id' | 'groupKey'> & { Scene: object }): string {
+  if (!step.groupKey) return `step:${step.id}`
+  let id = sceneIds.get(step.Scene)
+  if (id === undefined) {
+    id = nextSceneId++
+    sceneIds.set(step.Scene, id)
+  }
+  return `group:${step.groupKey}:${id}`
+}
