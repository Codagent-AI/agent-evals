+                data-presentation-toc-item=""
+                onClick={() => onGoTo(first)}
+                {...activeProps(era === steps[index].era, 'true')}
+              >
+                {era}
+              </button>
+            </li>
+          )
+        })}
+      </ol>
+    </nav>
+  )
+}
