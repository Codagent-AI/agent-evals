diff --git a/src/presentation-kit/Presentation.tsx b/src/presentation-kit/Presentation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..17490139c4aba91cac81d78af2849620081593a0
--- /dev/null
+++ b/src/presentation-kit/Presentation.tsx
@@ -0,0 +1,68 @@
+import type { ReactNode } from 'react'
+import { Attribution } from './chrome/Attribution.tsx'
+import { Footer } from './chrome/Footer.tsx'
+import { Header } from './chrome/Header.tsx'
+import { Toc } from './chrome/Toc.tsx'
+import { Stage } from './Stage.tsx'
+import type { Canvas, Mode, Step } from './types.ts'
+import { useFitScale, useIsWide } from './useFitScale.ts'
+import { usePresentationNav } from './usePresentationNav.ts'
+
+export interface PresentationProps<TPayload> {
+  steps: readonly Step<TPayload>[]
+  title: string
+  initialMode?: Mode
+  /** Host-provided top-left branding. */
+  brand?: ReactNode
+  /** Set false to omit the default bottom-right attribution. */
+  attribution?: boolean
+  canvas?: Canvas
+  className?: string
+}
+
+export function Presentation<TPayload>({
+  steps,
+  title,
+  initialMode = 'browse',
+  brand,
+  attribution = true,
+  canvas,
+  className,
+}: PresentationProps<TPayload>) {
+  const nav = usePresentationNav(steps.length, initialMode)
+  const wide = useIsWide()
+  const showToc = nav.mode === 'browse' && wide
+  const scale = useFitScale(nav.mode, showToc, canvas)
+  const step = steps[nav.index]
+  return (
+    <div
+      className={className}
+      data-presentation-root=""
+      data-presentation-mode={nav.mode}
+      data-presentation-step-count={steps.length}
+      data-presentation-step-index={nav.index}
+      data-step-count={steps.length}
+      data-step-index={nav.index}
+      style={{ position: 'fixed', inset: 0, overflow: 'hidden' }}
+    >
+      <Header
+        mode={nav.mode}
+        deckTitle={title}
+        marker={nav.index + 1}
+        count={steps.length}
+        brand={brand}
+      />
+      {showToc && <Toc steps={steps} index={nav.index} onGoTo={nav.goTo} />}
+      <Stage step={step} mode={nav.mode} scale={scale} showSide={showToc} canvas={canvas} />
+      <Footer
+        mode={nav.mode}
+        steps={steps}
+        index={nav.index}
+        onGoTo={nav.goTo}
+        onPrev={nav.prev}
+        onNext={nav.next}
+      />
+      {attribution && <Attribution />}
+    </div>
+  )
+}
diff --git a/src/presentation-kit/Stage.tsx b/src/presentation-kit/Stage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0c9ba010b3eff4c2bccf573f56c2a9b883ac55b1
--- /dev/null
+++ b/src/presentation-kit/Stage.tsx
@@ -0,0 +1,77 @@
+import { AnimatePresence, LayoutGroup, motion } from 'motion/react'
+import { DESIGN_H, DESIGN_W, EASE, EXIT_T, ENTER_T, STAGE_LAYOUT } from './constants.ts'
+import { sceneKey } from './sceneKey.ts'
+import type { Canvas, Mode, Step } from './types.ts'
+
+interface StageProps<TPayload> {
+  step: Step<TPayload>
+  mode: Mode
+  scale: number
+  showSide: boolean
+  canvas?: Canvas
+}
+
+export function Stage<TPayload>({
+  step,
+  mode,
+  scale,
+  showSide,
+  canvas = { width: DESIGN_W, height: DESIGN_H },
+}: StageProps<TPayload>) {
+  const g = STAGE_LAYOUT[mode]
+  const Scene = step.Scene
+  return (
+    <div
+      data-presentation-stage=""
+      style={{
+        position: 'absolute',
+        top: g.top,
+        bottom: g.bottom,
+        left: showSide ? g.side : 0,
+        right: 0,
+        display: 'flex',
+        alignItems: 'center',
+        justifyContent: 'center',
+      }}
+    >
+      <div
+        style={{
+          position: 'relative',
+          width: canvas.width * scale,
+          height: canvas.height * scale,
+        }}
+      >
+        <motion.div
+          data-presentation-canvas=""
+          data-presentation-scale={scale}
+          style={{
+            position: 'absolute',
+            top: 0,
+            left: 0,
+            width: canvas.width,
+            height: canvas.height,
+            originX: 0,
+            originY: 0,
+            scale,
+          }}
+        >
+          <LayoutGroup>
+            <AnimatePresence initial={false}>
+              <motion.div
+                key={sceneKey(step)}
+                data-presentation-scene=""
+                data-presentation-step-id={step.id}
+                style={{ position: 'absolute', inset: 0 }}
+                initial={{ opacity: 0 }}
+                animate={{ opacity: 1, transition: { duration: ENTER_T, ease: EASE } }}
+                exit={{ opacity: 0, transition: { duration: EXIT_T, ease: EASE } }}
+              >
+                <Scene payload={step.payload} />
+              </motion.div>
+            </AnimatePresence>
+          </LayoutGroup>
+        </motion.div>
+      </div>
+    </div>
+  )
+}
