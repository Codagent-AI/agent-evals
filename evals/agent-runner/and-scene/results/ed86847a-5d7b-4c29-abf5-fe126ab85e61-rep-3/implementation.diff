+// @vitest-environment node
+import path from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { ENTER_DELAY, ENTER_T } from '../../src/presentation-kit/constants.ts'
+import {
+  DEFAULT_SETTLE_MS,
+  DESKTOP_VIEWPORT,
+  MIN_ATTRIBUTION_PX,
+  artifactDir,
+  captureSteps,
+  classifyAttribution,
+  describeWarnings,
+  findOverlaps,
+  isIndistinctActive,
+  screenshotPath,
+} from '../../scripts/inspect-presentation.mjs'
+
+const item = (id: number, label: string, x: number, y: number, w = 100, h = 20, extra = {}) => ({
+  id,
+  label,
+  rect: { x, y, w, h },
+  allowed: false,
+  contains: [] as number[],
+  ...extra,
+})
+
+const clean = {
+  items: [],
+  progress: { active: { backgroundColor: 'gold' }, inactive: [{ backgroundColor: 'gray' }] },
+  toc: { active: { backgroundColor: 'gold' }, inactive: [{ backgroundColor: 'gray' }] },
+  attribution: { fontSize: 13, color: 'rgb(1, 2, 3)', fontFamily: 'Inter' },
+}
+
+describe('artifact paths and viewport', () => {
+  it('writes predictable project-local paths, one per step', () => {
+    expect(artifactDir('/p', 'talk')).toBe(path.join('/p', 'inspection', 'talk'))
+    expect(screenshotPath('/p', 'talk', 0)).toBe(path.join('/p', 'inspection', 'talk', 'step-01.png'))
+    expect(screenshotPath('/p', 'talk', 11)).toBe(path.join('/p', 'inspection', 'talk', 'step-12.png'))
+    expect(screenshotPath('/p', 'talk', 2, 'narrow')).toBe(path.join('/p', 'inspection', 'talk', 'step-03-narrow.png'))
+  })
+  it('captures at a standard desktop viewport', () => {
+    expect(DESKTOP_VIEWPORT).toEqual({ width: 1280, height: 720 })
+    // must outlast the kit's newcomer entry: delay + fade
+    expect(DEFAULT_SETTLE_MS).toBeGreaterThan((ENTER_DELAY + ENTER_T) * 1000)
+  })
+})
+
+describe('findOverlaps', () => {
+  it('reports text/text and text/chrome collisions with both identities', () => {
+    const pairs = findOverlaps([item(0, 'text "A"', 0, 0), item(1, 'text "B"', 50, 5), item(2, 'chrome <footer>', 60, 10), item(3, 'text "far"', 500, 500)])
+    expect(pairs).toEqual([
+      ['text "A"', 'text "B"'],
+      ['text "A"', 'chrome <footer>'],
+      ['text "B"', 'chrome <footer>'],
+    ])
+  })
+  it('ignores touching, non-overlapping, and sliver overlaps', () => {
+    expect(findOverlaps([item(0, 'a', 0, 0), item(1, 'b', 100, 0)])).toEqual([])
+    expect(findOverlaps([item(0, 'a', 0, 0), item(1, 'b', 0, 20)])).toEqual([])
+    expect(findOverlaps([item(0, 'a', 0, 0), item(1, 'b', 99.5, 0)])).toEqual([])
+    expect(findOverlaps([item(0, 'a', 0, 0, 100, 100), item(1, 'b', 99, 99, 100, 100)])).toEqual([])
+  })
+  it('reports distinct text ranges stacked on each other even when their elements are nested', () => {
+    const pairs = findOverlaps([
+      item(0, 'outer text "A"', 0, 0, 200, 100, { contains: [1] }),
+      item(1, 'inner text "B"', 10, 10),
+    ])
+    expect(pairs).toEqual([['outer text "A"', 'inner text "B"']])
+  })
+  it('exempts pairs touching an allow-overlap subtree but still reports unrelated collisions', () => {
+    const pairs = findOverlaps([
+      item(0, 'allowed-1', 0, 0, 100, 20, { allowed: true }),
+      item(1, 'allowed-2', 10, 5, 100, 20, { allowed: true }),
+      item(2, 'plain', 20, 5),
+      item(3, 'other', 30, 8),
+    ])
+    expect(pairs).toEqual([['plain', 'other']])
+  })
+})
+
+describe('active chrome and attribution classification', () => {
+  const style = { backgroundColor: 'red', color: 'white', width: '10px', opacity: '1' }
+  it('flags an active control identical to every inactive one', () => {
+    expect(isIndistinctActive(style, [{ ...style }, { ...style }])).toBe(true)
+  })
+  it('flags the active control when it matches any single inactive sibling', () => {
+    expect(isIndistinctActive(style, [{ ...style, color: 'other' }, { ...style }])).toBe(true)
+    expect(isIndistinctActive(style, [{ ...style }, { ...style, color: 'other' }])).toBe(true)
+  })
+  it('accepts an active control that differs in any signature property', () => {
+    for (const key of ['backgroundColor', 'color', 'width', 'opacity']) {
+      expect(isIndistinctActive({ ...style, [key]: 'other' }, [{ ...style }, { ...style }]), key).toBe(false)
+    }
+  })
+  it('does not flag when there is no active control or nothing to compare against', () => {
+    expect(isIndistinctActive(null, [style])).toBe(false)
+    expect(isIndistinctActive(style, [])).toBe(false)
+  })
+  it('classifies attribution: missing, undersized, browser-default, polished', () => {
+    const ok = { fontSize: 13, color: 'rgb(180, 170, 140)', fontFamily: 'Inter, sans-serif' }
+    expect(classifyAttribution(null)).toMatch(/missing/)
+    expect(classifyAttribution({ ...ok, fontSize: MIN_ATTRIBUTION_PX - 1 })).toMatch(/undersized \(10px\)/)
+    expect(classifyAttribution({ ...ok, color: 'rgb(0, 0, 238)' })).toMatch(/browser-default/)
+    expect(classifyAttribution({ ...ok, fontFamily: '"Times New Roman"' })).toMatch(/browser-default/)
+    expect(classifyAttribution(ok)).toBeNull()
+  })
+})
+
+describe('describeWarnings', () => {
+  it('is silent for a polished step', () => {
+    expect(describeWarnings(0, clean)).toEqual([])
+  })
+  it('names the step, the elements, and the hook to fix for each defect', () => {
+    const w = describeWarnings(2, {
+      items: [item(0, 'text "A"', 0, 0), item(1, 'text "B"', 5, 0)],
+      progress: { active: { backgroundColor: 'gray' }, inactive: [{ backgroundColor: 'gray' }] },
+      toc: { active: { backgroundColor: 'gray' }, inactive: [{ backgroundColor: 'gray' }] },
+      attribution: { fontSize: 8, color: 'rgb(1, 2, 3)', fontFamily: 'Inter' },
+    })
+    expect(w).toHaveLength(4)
+    expect(w.every((x) => x.includes('step 3 (index 2)'))).toBe(true)
+    expect(w[0]).toMatch(/\[overlap\].*text "A".*text "B".*data-presentation-allow-overlap/)
+    expect(w[1]).toMatch(/\[active-progress\].*data-presentation-active/)
+    expect(w[2]).toMatch(/\[active-toc\].*data-presentation-toc-item/)
+    expect(w[3]).toMatch(/\[attribution\].*data-presentation-attribution/)
+  })
+})
+
+describe('captureSteps sequencing', () => {
+  it('settles before every capture, including the first, and only after the step index advanced', async () => {
+    const log: string[] = []
+    const page = {
+      keyboard: { press: async (k: string) => void log.push(`press ${k}`) },
+      waitForFunction: async (_f: unknown, n: number) => void log.push(`index ${n}`),
+      waitForTimeout: async (ms: number) => void log.push(`settle ${ms}`),
+      screenshot: async ({ path: p }: { path: string }) => void log.push(`shot ${p}`),
+    }
+    const steps = await captureSteps({
+      page,
+      count: 3,
+      settleMs: 7,
+      shotPath: (i: number) => `s${i}.png`,
+      analyze: async () => clean,
+    })
+    expect(log).toEqual([
+      'settle 7',
+      'shot s0.png',
+      'press ArrowRight',
+      'index 1',
+      'settle 7',
+      'shot s1.png',
+      'press ArrowRight',
+      'index 2',
+      'settle 7',
+      'shot s2.png',
+    ])
+    expect(steps.map((s: { file: string }) => s.file)).toEqual(['s0.png', 's1.png', 's2.png'])
+    expect(steps.every((s: { warnings: string[] }) => s.warnings.length === 0)).toBe(true)
+  })
+})
diff --git a/tests/unit/kit-nav.test.tsx b/tests/unit/kit-nav.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..ccd236441bdbbb7fc0940a3d3690b8161cefe510
--- /dev/null
+++ b/tests/unit/kit-nav.test.tsx
@@ -0,0 +1,207 @@
+import { act, fireEvent, render, renderHook } from '@testing-library/react'
+import { StrictMode } from 'react'
+import { describe, expect, it } from 'vitest'
+import { classifySwipe, clampIndex, firstIndexOfEra, isInteractiveTarget } from '../../src/presentation-kit/nav.ts'
+import { usePresentationNav } from '../../src/presentation-kit/usePresentationNav.ts'
+
+const key = (k: string, target: Element | Window | Document = window) =>
+  act(() => {
+    fireEvent.keyDown(target, { key: k })
+  })
+
+const swipe = (dx: number, dy: number) => {
+  act(() => {
+    fireEvent.touchStart(window, { changedTouches: [{ clientX: 200, clientY: 200 }] })
+    fireEvent.touchEnd(window, { changedTouches: [{ clientX: 200 + dx, clientY: 200 + dy }] })
+  })
+}
+
+describe('usePresentationNav', () => {
+  it('advances one step on Right, Space and PageDown, and goes back on Left and PageUp', () => {
+    const { result } = renderHook(() => usePresentationNav(6))
+    for (const k of ['ArrowRight', ' ', 'PageDown']) {
+      const before = result.current.index
+      key(k)
+      expect(result.current.index).toBe(before + 1)
+    }
+    expect(result.current.index).toBe(3)
+    key('ArrowLeft')
+    expect(result.current.index).toBe(2)
+    key('PageUp')
+    expect(result.current.index).toBe(1)
+  })
+
+  it('toggles the mode with P in both directions and keeps the step', () => {
+    const { result } = renderHook(() => usePresentationNav(6, 'browse'))
+    key('ArrowRight')
+    key('ArrowRight')
+    key('p')
+    expect(result.current.mode).toBe('present')
+    expect(result.current.index).toBe(2)
+    key('P')
+    expect(result.current.mode).toBe('browse')
+    expect(result.current.index).toBe(2)
+  })
+
+  it('opens in the declared initial mode', () => {
+    expect(renderHook(() => usePresentationNav(3, 'present')).result.current.mode).toBe('present')
+    expect(renderHook(() => usePresentationNav(3, 'browse')).result.current.mode).toBe('browse')
+  })
+
+  it('swipes left to advance and right to go back, one step per gesture', () => {
+    const { result } = renderHook(() => usePresentationNav(6))
+    swipe(-120, 5)
+    expect(result.current.index).toBe(1)
+    swipe(-120, 5)
+    expect(result.current.index).toBe(2)
+    swipe(120, 5)
+    expect(result.current.index).toBe(1)
+  })
+
+  it('ignores short swipes, vertical-dominant swipes, and a touchend without a start', () => {
+    const { result } = renderHook(() => usePresentationNav(6))
+    swipe(-49, 0)
+    swipe(-80, 120)
+    swipe(-60, 60)
+    act(() => {
+      fireEvent.touchEnd(window, { changedTouches: [{ clientX: 0, clientY: 0 }] })
+    })
+    expect(result.current.index).toBe(0)
+    swipe(-50, 10)
+    expect(result.current.index).toBe(1)
+  })
+
+  it('clamps at both ends for keys, swipes, next/prev and out-of-range jumps', () => {
+    const { result } = renderHook(() => usePresentationNav(3))
+    key('ArrowLeft')
+    swipe(120, 0)
+    act(() => result.current.prev())
+    act(() => result.current.goTo(-5))
+    expect(result.current.index).toBe(0)
+    act(() => result.current.goTo(99))
+    expect(result.current.index).toBe(2)
+    key('ArrowRight')
+    key('PageDown')
+    swipe(-120, 0)
+    act(() => result.current.next())
+    expect(result.current.index).toBe(2)
+    act(() => result.current.goTo(1))
+    expect(result.current.index).toBe(1)
+  })
+
+  it('leaves navigation keys to focused interactive controls', () => {
+    const { result } = renderHook(() => usePresentationNav(6))
+    const controls = [
+      document.createElement('button'),
+      Object.assign(document.createElement('a'), { href: '/x' }),
+      document.createElement('input'),
+      document.createElement('select'),
+      document.createElement('textarea'),
+      (() => {
+        const d = document.createElement('div')
+        d.setAttribute('contenteditable', 'true')
+        return d
+      })(),
+    ]
+    const nested = document.createElement('button')
+    const inner = document.createElement('span')
+    nested.append(inner)
+    for (const el of [...controls, nested]) document.body.append(el)
+    for (const el of [...controls, inner]) {
+      for (const k of ['ArrowRight', ' ', 'PageDown', 'ArrowLeft', 'p']) {
+        const ev = new KeyboardEvent('keydown', { key: k, bubbles: true, cancelable: true })
+        act(() => {
+          el.dispatchEvent(ev)
+        })
+        expect(ev.defaultPrevented).toBe(false)
+      }
+    }
+    expect(result.current.index).toBe(0)
+    expect(result.current.mode).toBe('browse')
+    // a non-interactive target still navigates
+    key('ArrowRight', document.body)
+    expect(result.current.index).toBe(1)
+  })
+
+  it('ignores modified keys', () => {
+    const { result } = renderHook(() => usePresentationNav(6))
+    act(() => {
+      fireEvent.keyDown(window, { key: 'ArrowRight', ctrlKey: true })
+    })
+    expect(result.current.index).toBe(0)
+  })
+
+  it('registers each listener once, even under StrictMode, and removes them on unmount', () => {
+    const added: string[] = []
+    const removed: string[] = []
+    const add = window.addEventListener.bind(window)
+    const rem = window.removeEventListener.bind(window)
+    window.addEventListener = ((t: string, ...a: unknown[]) => {
+      added.push(t)
+      return (add as (...x: unknown[]) => void)(t, ...a)
+    }) as typeof window.addEventListener
+    window.removeEventListener = ((t: string, ...a: unknown[]) => {
+      removed.push(t)
+      return (rem as (...x: unknown[]) => void)(t, ...a)
+    }) as typeof window.removeEventListener
+    try {
+      const { result, unmount } = renderHook(() => usePresentationNav(6), { wrapper: StrictMode })
+      key('ArrowRight')
+      expect(result.current.index).toBe(1) // one press, one step: no double handling
+      unmount()
+      for (const t of ['keydown', 'touchstart', 'touchend']) {
+        expect(removed.filter((x) => x === t).length).toBe(added.filter((x) => x === t).length)
+      }
+      const before = result.current.index
+      key('ArrowRight')
+      expect(result.current.index).toBe(before)
+    } finally {
+      window.addEventListener = add
+      window.removeEventListener = rem
+    }
+  })
+
+  it('does not re-register listeners when the component re-renders', () => {
+    let adds = 0
+    const add = window.addEventListener.bind(window)
+    window.addEventListener = ((t: string, ...a: unknown[]) => {
+      if (t === 'keydown') adds++
+      return (add as (...x: unknown[]) => void)(t, ...a)
+    }) as typeof window.addEventListener
+    try {
+      const { rerender } = render(<Probe />)
+      const first = adds
+      rerender(<Probe />)
+      expect(adds).toBe(first)
+    } finally {
+      window.addEventListener = add
+    }
+  })
+})
+
+function Probe() {
+  usePresentationNav(4)
+  return null
+}
+
+describe('nav helpers', () => {
+  it('clampIndex bounds to [0, count-1] and tolerates an empty list', () => {
+    expect(clampIndex(-1, 4)).toBe(0)
+    expect(clampIndex(9, 4)).toBe(3)
+    expect(clampIndex(2, 4)).toBe(2)
+    expect(clampIndex(3, 0)).toBe(0)
+  })
+  it('classifySwipe respects the threshold and horizontal dominance', () => {
+    expect(classifySwipe(-50, 0, 50)).toBe('next')
+    expect(classifySwipe(50, 0, 50)).toBe('prev')
+    expect(classifySwipe(-49, 0, 50)).toBeNull()
+    expect(classifySwipe(60, 60, 50)).toBeNull()
+  })
+  it('firstIndexOfEra returns the first occurrence, not the current step', () => {
+    expect(firstIndexOfEra(['a', 'a', 'b', 'b'], 'b')).toBe(2)
+  })
+  it('isInteractiveTarget is false for non-elements', () => {
+    expect(isInteractiveTarget(null)).toBe(false)
+    expect(isInteractiveTarget(window)).toBe(false)
+  })
+})
