+import type { ComponentType } from 'react'
+
+export type PresentationMode = 'browse' | 'present'
+
+export interface SceneProps<TPayload> {
+  payload: TPayload
+  step: Step<TPayload>
+  stepIndex: number
+}
+
+export interface Step<TPayload> {
+  id: string
+  era: string
+  title: string
+  caption: string
+  Scene: ComponentType<SceneProps<TPayload>>
